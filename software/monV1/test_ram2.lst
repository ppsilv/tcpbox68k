                            	   527: ; 3. Carrega programa via serial
                            	   528: LoadProgram:
00:00000350 41F9000001C1    	   529:     LEA     LoadPrompt,A0
00:00000356 4EB80134        	   530:     JSR     UART_WriteString
00:0000035A 4EB803E0        	   531:     JSR     UART_ReadHex        ; Lê endereço de destino
00:0000035E 2240            	   532:     MOVE.L  D0,A1               ; A1 = ponteiro para RAM
                            	   533: 
00:00000360 4EB8017A        	   534:     JSR     new_line
00:00000364 4EB802C2        	   535:     JSR     PrintHexAddress
00:00000368 4EB8017A        	   536:     JSR     new_line
                            	   537: 
                            	   538:     ; Protocolo: [Tamanho(4B)][Dados...]
00:0000036C 4EB80438        	   539:     JSR     UART_ReadLong       ; Lê tamanho (32 bits)
                            	   540: 
00:00000370 41F9000001EC    	   541:     LEA     LoadPromptReady,A0
00:00000376 4EB80134        	   542:     JSR     UART_WriteString
00:0000037A 4EB8017A        	   543:     JSR     new_line
00:0000037E 2200            	   544:     MOVE.L  D0,D1               ; D1 = contador de bytes
                            	   545: 
                            	   546: .LoadLoop:
00:00000380 4EB8044A        	   547:     JSR     UART_ReadByte       ; Lê byte
00:00000384 12C0            	   548:     MOVE.B  D0,(A1)+            ; Armazena na RAM
00:00000386 5381            	   549:     SUBQ.L  #1,D1               ; Decrementa contador
00:00000388 66F6            	   550:     BNE     .LoadLoop           ; Continua até terminar
                            	   551: 
00:0000038A 41F900000206    	   552:     LEA     LoadDoneMsg,A0
00:00000390 4EB80134        	   553:     JSR     UART_WriteString
00:00000394 4E75            	   554:     RTS
                            	   555: 
                            	   556: ; 4. Grava programa manualmente (hex)
                            	   557: WriteProgram:
00:00000396 41F900000225    	   558:     LEA     WritePrompt,A0
00:0000039C 4EB80134        	   559:     JSR     UART_WriteString
00:000003A0 4EB803E0        	   560:     JSR     UART_ReadHex        ; Lê endereço
00:000003A4 2240            	   561:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   562: 
00:000003A6 41F900000235    	   563:     LEA     WriteSizePrompt,A0
00:000003AC 4EB80134        	   564:     JSR     UART_WriteString
00:000003B0 4EB803E0        	   565:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:000003B4 2200            	   566:     MOVE.L  D0,D1               ; D1 = contador
                            	   567: 
                            	   568: .WriteLoop:
00:000003B6 4EB8044A        	   569:     JSR     UART_ReadByte       ; Lê byte
00:000003BA 12C0            	   570:     MOVE.B  D0,(A1)+            ; Armazena
00:000003BC 5381            	   571:     SUBQ.L  #1,D1
00:000003BE 66F6            	   572:     BNE     .WriteLoop
                            	   573: 
00:000003C0 41F900000247    	   574:     LEA     WriteDoneMsg,A0
00:000003C6 4EB80134        	   575:     JSR     UART_WriteString
00:000003CA 4E75            	   576:     RTS
                            	   577: 
                            	   578: ; 5. Executa programa na RAM
                            	   579: RunProgram:
00:000003CC 41F900000261    	   580:     LEA     RunPrompt,A0
00:000003D2 4EB80134        	   581:     JSR     UART_WriteString
00:000003D6 4EB803E0        	   582:     JSR     UART_ReadHex        ; Lê endereço
00:000003DA 2040            	   583:     MOVE.L  D0,A0
00:000003DC 4E90            	   584:     JSR     (A0)                ; Chama subrotina
00:000003DE 4E75            	   585:     RTS
