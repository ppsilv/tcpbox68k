                            	   520:     ;LEA     BaudPrompt,A0
                            	   521:     ;JSR     UART_WriteString
                            	   522:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   523:     ;MOVE.L  CurrentUART,A0
                            	   524:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
