                            	   191: ; ----------------------------------------------------------------------
                            	   192: ; Constantes
                            	   193: ; ----------------------------------------------------------------------
                            	   194: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   195: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   196:                               ; BAUD_DIV_L em $70000
                            	   197:                               ; BAUD_DIV_U em $70001
                            	   198: 
                            	   199: ; ----------------------------------------------------------------------
                            	   200: ; Rotina: Calcula e armazena divisor de baud rate
                            	   201: ; Entrada:
                            	   202: ;   D0.W - BAUD rate desejado (ex: 9600)
                            	   203: ; Saída:
                            	   204: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   205: ; ----------------------------------------------------------------------
                            	   206: CalcBaudDiv:
00:00000148 4E56FFFC        	   207:     LINK    A6,#-4            ; Cria frame de stack (4 bytes locais)
                            	   208: 
                            	   209:     ; 1. Calcula BAUD_DIV = (((F_CPU*10)/(16*BAUD))+5)/10
00:0000014C 223C00F42400    	   210:     MOVE.L  #F_CPU,D1         ; D1 = F_CPU
00:00000152 C2FC000A        	   211:     MULU.W  #10,D1            ; D1 = F_CPU*10
                            	   212: 
00:00000156 3400            	   213:     MOVE.W  D0,D2             ; D2 = BAUD
00:00000158 E94A            	   214:     LSL.W   #4,D2             ; D2 = 16*BAUD (shift left 4 bits)
                            	   215: 
00:0000015A 82C2            	   216:     DIVU.W  D2,D1             ; D1 = (F_CPU*10)/(16*BAUD)
00:0000015C 5A41            	   217:     ADD.W   #5,D1             ; +5 para arredondar
00:0000015E 82FC000A        	   218:     DIVU.W  #10,D1            ; /10
                            	   219: 
                            	   220:     ; 2. Separa em parte alta e baixa
00:00000162 3001            	   221:     MOVE.W  D1,D0             ; D0 = BAUD_DIV completo
00:00000164 024000FF        	   222:     ANDI.W  #$FF,D0           ; D0 = BAUD_DIV_L (parte baixa)
00:00000168 3401            	   223:     MOVE.W  D1,D2
00:0000016A E04A            	   224:     LSR.W   #8,D2             ; D2 = BAUD_DIV_U (parte alta)
                            	   225: 
                            	   226:     ; 3. Armazena na RAM
00:0000016C 41F900081004    	   227:     LEA     BAUD_TABLE,A0
00:00000172 10C0            	   228:     MOVE.B  D0,(A0)+          ; Armazena BAUD_DIV_L
00:00000174 1082            	   229:     MOVE.B  D2,(A0)           ; Armazena BAUD_DIV_U
                            	   230: 
00:00000176 4E5E            	   231:     UNLK    A6                ; Restaura frame de stack
00:00000178 4E75            	   232:     RTS
                            	   233: 
                            	   234: new_line:
00:0000017A 103C000A        	   235:         MOVE.B  #10,D0
00:0000017E 4EB80106        	   236:         JSR     UART_WriteChar
00:00000182 103C000D        	   237:         MOVE.B  #13,D0
00:00000186 4EB80106        	   238:         JSR     UART_WriteChar
00:0000018A 4E75            	   239:         RTS
                            	   240: 
                            	   241: ; Versão compacta sem stack frame
                            	   242: PrintHexFast:
00:0000018C 2F02            	   243:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000018E 2F00            	   244:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000190 7407            	   245:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   246: 
                            	   247: .Loop:
00:00000192 2017            	   248:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000194 E998            	   249:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000196 2E80            	   250:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000198 0200000F        	   251:     ANDI.B  #$F,D0            ; Isola nibble
                            	   252: 
00:0000019C B03C0009        	   253:     CMP.B   #9,D0
00:000001A0 6302            	   254:     BLS     .Digit
00:000001A2 5E00            	   255:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   256: .Digit:
00:000001A4 D03C0030        	   257:     ADD.B   #'0',D0           ; Converte para ASCII
00:000001A8 4EB80106        	   258:     JSR     UART_WriteChar    ; Envia caractere
                            	   259: 
00:000001AC 51CAFFE4        	   260:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   261: 
00:000001B0 588F            	   262:     ADDQ.L  #4,SP             ; Remove valor salvo
00:000001B2 241F            	   263:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000001B4 4E75            	   264:     RTS
                            	   265: 
                            	   266: ; ----------------------------------------------------------------------
                            	   267: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   268: ; Entrada:
                            	   269: ;   D0.L = Valor a ser impresso (32 bits)
                            	   270: ;   D1.W = Número de dígitos (1-8)
                            	   271: ; ----------------------------------------------------------------------
                            	   272: PrintHexPRECISA_DE_REVISAO:
00:000001B6 4E56FFF8        	   273:     LINK    A6,#-8            ; Reserva espaço na pilha
00:000001BA 2F02            	   274:     MOVE.L  D2,-(SP)          ; Salva D2
00:000001BC 2D40FFFC        	   275:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000001C0 3D41FFFA        	   276:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   277: 
00:000001C4 323C0008        	   278:     MOVE.W  #$0008,D1
                            	   279: 
                            	   280:     ; Ajusta para começar pelo dígito mais significativo
00:000001C8 E549            	   281:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000001CA 5941            	   282:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   283: 
                            	   284: .PrintLoop:
00:000001CC 202EFFFC        	   285:     MOVE.L  -4(A6),D0         ; Recupera valor
00:000001D0 3401            	   286:     MOVE.W  D1,D2             ; Posição do nibble
00:000001D2 E5B8            	   287:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:000001D4 02800000000F    	   288:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   289: 
                            	   290:     ; Converte para ASCII
00:000001DA B03C0009        	   291:     CMP.B   #9,D0
00:000001DE 6302            	   292:     BLS     .Decimal
00:000001E0 5E00            	   293:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   294: .Decimal:
00:000001E2 D03C0030        	   295:     ADD.B   #'0',D0           ; Converte para caractere
                            	   296: 
                            	   297:     ; Imprime caractere
00:000001E6 4EB80106        	   298:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   299: 
00:000001EA 5941            	   300:     SUBQ.W  #4,D1             ; Próximo nibble
00:000001EC 6ADE            	   301:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   302: 
                            	   303:     ; Espaço final para separação
00:000001EE 103C0020        	   304:     MOVE.B  #' ',D0
00:000001F2 4EB80106        	   305:     JSR     UART_WriteChar
                            	   306: 
00:000001F6 241F            	   307:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000001F8 4E5E            	   308:     UNLK    A6                ; Restaura frame
00:000001FA 4E75            	   309:     RTS
                            	   310: ; ----------------------------------------------------------------------
                            	   311: ; Exemplo de uso:
                            	   312: ; ----------------------------------------------------------------------
                            	   313: SetupDivisor:
00:000001FC 303C2580        	   314:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:00000200 6100FF46        	   315:     BSR     CalcBaudDiv
                            	   316: 
                            	   317:     ; Agora pode acessar os valores na RAM:
00:00000204 41F900081004    	   318:     LEA     BAUD_TABLE,A0
00:0000020A 1018            	   319:     MOVE.B  (A0)+,D0          ; D0 = BAUD_DIV_L
00:0000020C 1210            	   320:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   321: 
                            	   322:     ; (Aqui você configuraria os registradores da UART)
00:0000020E 4E75            	   323:     RTS
                            	   324: ; ----------------------------------------------------------------------
                            	   325: ; MemDump - Imprime dump de memória formatado
                            	   326: ; Entrada:
                            	   327: ;   A0 = Endereço inicial (ex: $80000)
                            	   328: ;   D0 = Quantidade de bytes (ex: 256)
                            	   329: ; ----------------------------------------------------------------------
                            	   330: MemDump:
00:00000210 41F900081000    	   331:     LEA.L   $81000,A0
00:00000216 303C0100        	   332:     MOVE.W  #256,D0
00:0000021A 2F08            	   333:     MOVE.L  A0,-(SP)
                            	   334:     ; Cabeçalho
00:0000021C 41F900000036    	   335:     LEA     DumpHeader,A0
00:00000222 4EB80134        	   336:     JSR     UART_WriteString
                            	   337: 
                            	   338:     ; Calcula endereço final
00:00000226 205F            	   339:     MOVE.L  (SP)+,A0
00:00000228 2208            	   340:     MOVE.L  A0,D1
00:0000022A D280            	   341:     ADD.L   D0,D1             ; D1 = endereço final
00:0000022C 5381            	   342:     SUBQ.L  #1,D1
00:0000022E 223C000810FF    	   343:     MOVE.L  #$810FF,D1
                            	   344: DumpLoop:
                            	   345:     ; Nova linha a cada 16 bytes
00:00000234 2008            	   346:     MOVE.L  A0,D0
00:00000236 02800000000F    	   347:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000023C 6616            	   348:     BNE     NoNewLine
                            	   349: 
                            	   350:     ; Imprime endereço
00:0000023E 2008            	   351:     MOVE.L  A0,D0
00:00000240 4EB802C2        	   352:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   353: 
00:00000244 103C003A        	   354:     MOVE.B  #':',D0
00:00000248 4EB80106        	   355:     JSR     UART_WriteChar
00:0000024C 103C0020        	   356:     MOVE.B  #' ',D0
00:00000250 4EB80106        	   357:     JSR     UART_WriteChar
                            	   358: 
                            	   359: NoNewLine:
                            	   360:     ; Imprime byte em hex
00:00000254 1018            	   361:     MOVE.B  (A0)+,D0
00:00000256 4EB802D2        	   362:     JSR     PrintByteHex
                            	   363: 
00:0000025A 103C0020        	   364:     MOVE.B  #' ',D0
00:0000025E 4EB80106        	   365:     JSR     UART_WriteChar
                            	   366: 
                            	   367:     ; Verifica fim da linha (16 bytes)
00:00000262 2008            	   368:     MOVE.L  A0,D0
00:00000264 02800000000F    	   369:     ANDI.L  #$0000000F,D0
00:0000026A 664E            	   370:     BNE     NoEndLine
                            	   371: 
                            	   372:     ; Imprime caracteres ASCII
00:0000026C 103C0020        	   373:     MOVE.B  #' ',D0
