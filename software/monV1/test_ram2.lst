00:000000DE 227900081000    	   138:     move.l   UART_CURRENT,a1
00:000000E4 137C000D0004    	   139:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:000000EA 137C00830006    	   140:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:000000F0 12BC0068        	   141:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:000000F4 137C00000002    	   142:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:000000FA 08A900070006    	   143:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000100 4229000E        	   144:     clr.b   SCR(a1)                 ; clear the scratch register
