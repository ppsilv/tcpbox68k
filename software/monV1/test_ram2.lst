00:000000AC 6100009A        	   123:     BSR     CalcBaudDiv
00:000000B0 227900081000    	   124:     move.l  UART_CURRENT,a1
00:000000B6 137C000D0004    	   125:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:000000BC 137C00830006    	   126:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:000000C2 41F900081004    	   127:     LEA     BAUD_TABLE,A0
00:000000C8 1018            	   128:     MOVE.B  (A0)+,D0
00:000000CA 1280            	   129:     move.b  D0,DLL(a1)     ; set divisor latch low byte
00:000000CC 1010            	   130:     MOVE.B  (A0),D0
00:000000CE 13400002        	   131:     move.b  D0,DLM(a1)     ; set divisor latch high byte
00:000000D2 08A900070006    	   132:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:000000D8 4229000E        	   133:     clr.b   SCR(a1)                 ; clear the scratch register
00:000000DC 4E75            	   134:     RTS
