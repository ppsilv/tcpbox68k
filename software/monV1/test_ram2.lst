                            	   509:     ;LEA     UARTPrompt,A0
                            	   510:     ;JSR     UART_WriteString
                            	   511:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   512:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   513:     ;JSR     UART_Init           ; Reinicializa UART
00:00000342 4E75            	   514:     RTS
