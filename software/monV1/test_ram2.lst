                            	   587: ; ----------------------------------------------------------------------
                            	   588: ; Rotinas Auxiliares
                            	   589: ; ----------------------------------------------------------------------
                            	   590: 
                            	   591: ; Lê número hexadecimal (retorna em D0)
                            	   592: UART_ReadHex:
00:000003E0 2F01            	   593:         MOVE.L  D1,-(SP)
00:000003E2 2F02            	   594:         MOVE.L  D2,-(SP)
                            	   595: 
00:000003E4 4EB804E8        	   596:         JSR  ClearBufferPointers
                            	   597: 
00:000003E8 7000            	   598:         MOVEQ   #0,D0
00:000003EA 7200            	   599:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000003EC 7400            	   600:         MOVEQ   #0,D2            ; Resultado em D2
                            	   601: 
                            	   602: .Loop:
00:000003EE 4EB80120        	   603:         JSR     UART_ReadChar
00:000003F2 B03C000D        	   604:         CMP.B   #13,D0
00:000003F6 6730            	   605:         BEQ     .Done
00:000003F8 B03C000A        	   606:         CMP.B   #10,D0
00:000003FC 672A            	   607:         BEQ     .Done
                            	   608:         ;Tratando os numeros
00:000003FE B03C0030        	   609:         CMP.B   #'0',D0
00:00000402 6C14            	   610:         BGE     .isdigit
00:00000404 B03C0039        	   611:         CMP.B   #'9',D0
00:00000408 6F0E            	   612:         BLE     .isdigit
                            	   613:         ;Tratando as letras
00:0000040A B03C0041        	   614:         CMP.B   #'A',D0
00:0000040E 6C10            	   615:         BGE     .isletter
00:00000410 B03C0046        	   616:         CMP.B   #'F',D0
00:00000414 6F0A            	   617:         BLE     .isletter
00:00000416 60D6            	   618:         BRA     .Loop
                            	   619: 
                            	   620: .isdigit:
00:00000418 903C0030        	   621:         SUB.B   #'0',D0
00:0000041C 6156            	   622:         BSR     BufferPut
00:0000041E 60CE            	   623:         BRA     .Loop
                            	   624: .isletter:
00:00000420 903C0037        	   625:         SUB.B   #'A'-$0A,D0
00:00000424 614E            	   626:         BSR     BufferPut
00:00000426 60C6            	   627:         BRA     .Loop
                            	   628: 
                            	   629: .Done:
00:00000428 2002            	   630:     MOVE.L  D2,D0
00:0000042A 241F            	   631:     MOVE.L  (SP)+,D2
00:0000042C 221F            	   632:     MOVE.L  (SP)+,D1
                            	   633: 
00:0000042E 4EB80506        	   634:     JSR MontaAddress
00:00000432 4EB802C2        	   635:     JSR PrintHexAddress
00:00000436 4E75            	   636:     RTS
                            	   637: 
                            	   638: ; Lê 4 bytes (32 bits) via UART
                            	   639: UART_ReadLong:
00:00000438 7000            	   640:     MOVEQ   #0,D0
00:0000043A 7203            	   641:     MOVEQ   #3,D1            ; 4 bytes a ler
                            	   642: .Loop:
00:0000043C E188            	   643:     LSL.L   #8,D0            ; Desloca resultado atual
00:0000043E 4EB8044A        	   644:     JSR     UART_ReadByte
00:00000442 8000            	   645:     OR.B    D0,D0            ; Combina com novo byte
00:00000444 51C9FFF6        	   646:     DBF     D1,.Loop
00:00000448 4E75            	   647:     RTS
                            	   648: 
                            	   649: ; Lê byte hexadecimal (2 caracteres ASCII)
                            	   650: UART_ReadByte:
00:0000044A 2F00            	   651:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000044C 4EB8045E        	   652:     JSR     UART_ReadHexNibble
00:00000450 E908            	   653:     LSL.B   #4,D0
00:00000452 1200            	   654:     MOVE.B  D0,D1
00:00000454 4EB8045E        	   655:     JSR     UART_ReadHexNibble
00:00000458 8001            	   656:     OR.B    D1,D0
00:0000045A 201F            	   657:     MOVE.L  (SP)+,D0        ; Recupera D0
00:0000045C 4E75            	   658:     RTS
                            	   659: 
                            	   660: ; Lê meio-byte hexadecimal
                            	   661: UART_ReadHexNibble:
00:0000045E 4EB80120        	   662:     JSR     UART_ReadChar
00:00000462 B03C0041        	   663:     CMP.B   #'A',D0
00:00000466 6D02            	   664:     BLT     .Digit
00:00000468 5F00            	   665:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   666: .Digit:
00:0000046A 903C0030        	   667:     SUB.B   #'0',D0
00:0000046E C03C000F        	   668:     AND.B   #$0F,D0
00:00000472 4E75            	   669:     RTS
                            	   670: 
                            	   671: ;--------------------------------------------------
                            	   672: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   673: ;--------------------------------------------------
                            	   674: ; Exemplo: insere 'A' no buffer
                            	   675: ;          MOVE.B  #'A',D0
                            	   676: ;          BSR     UART_BufferPut
                            	   677: 
                            	   678: BufferPut:
00:00000474 2F01            	   679:     MOVE.L  D1,-(SP)           ; Salva D1 (contador)
00:00000476 2F08            	   680:     MOVE.L  A0,-(SP)           ; Salva A0 (ponteiro)
                            	   681: 
00:00000478 41F900081016    	   682:     LEA     RX_BUFFER,A0  ; A0 = base do buffer
00:0000047E 323900000108    	   683:     MOVE.W  BUFFER_COUNT,D1 ; D1 = contador atual
                            	   684: 
                            	   685:     ; Verifica se o buffer está cheio (COUNT >= 256)
00:00000484 B27C0100        	   686:     CMP.W   #256,D1
00:00000488 6C1E            	   687:     BGE     .BufferFull        ; Se cheio, ignora o byte
                            	   688: 
                            	   689:     ; Insere o byte no buffer (em HEAD)
00:0000048A 223900000100    	   690:     MOVE.L  BUFFER_HEAD,D1
00:00000490 11801800        	   691:     MOVE.B  D0,(A0,D1.L)       ; Buffer[HEAD] = D0.B
                            	   692: 
                            	   693:     ; Atualiza HEAD (HEAD = (HEAD + 1) % 256)
00:00000494 5281            	   694:     ADDQ.L  #1,D1
00:00000496 0281000000FF    	   695:     ANDI.L  #255,D1            ; Mantém no range 0-255
00:0000049C 23C100000100    	   696:     MOVE.L  D1,BUFFER_HEAD
                            	   697: 
                            	   698:     ; Incrementa COUNT
00:000004A2 527900000108    	   699:     ADDQ.W  #1,BUFFER_COUNT
                            	   700: 
                            	   701: .BufferFull:
00:000004A8 205F            	   702:     MOVE.L  (SP)+,A0           ; Restaura A0
00:000004AA 221F            	   703:     MOVE.L  (SP)+,D1           ; Restaura D1
00:000004AC 4E75            	   704:     RTS
                            	   705: 
                            	   706: ;--------------------------------------------------
                            	   707: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   708: ;--------------------------------------------------
                            	   709: ;Exemplo: Lendo byte do buffer
                            	   710: ;         BSR     UART_BufferGet
                            	   711: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   712: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   713: ;         Senão, D0 contém o byte lido!
                            	   714: BufferGet:
00:000004AE 2F01            	   715:     MOVE.L  D1,-(SP)           ; Salva D1 (contador)
00:000004B0 2F08            	   716:     MOVE.L  A0,-(SP)           ; Salva A0 (ponteiro)
                            	   717: 
                            	   718:     ; Verifica se o buffer está vazio (COUNT == 0)
00:000004B2 323900000108    	   719:     MOVE.W  BUFFER_COUNT,D1
00:000004B8 6726            	   720:     BEQ     .BufferEmpty       ; Se vazio, retorna -1
                            	   721: 
00:000004BA 41F900081016    	   722:     LEA     RX_BUFFER,A0  ; A0 = base do buffer
                            	   723: 
                            	   724:     ; Pega o byte do buffer (em TAIL)
00:000004C0 223900000104    	   725:     MOVE.L  BUFFER_TAIL,D1
00:000004C6 10301800        	   726:     MOVE.B  (A0,D1.L),D0       ; D0.B = Buffer[TAIL]
                            	   727: 
                            	   728:     ; Atualiza TAIL (TAIL = (TAIL + 1) % 256)
00:000004CA 5281            	   729:     ADDQ.L  #1,D1
00:000004CC 0281000000FF    	   730:     ANDI.L  #255,D1            ; Mantém no range 0-255
00:000004D2 23C100000104    	   731:     MOVE.L  D1,BUFFER_TAIL
                            	   732: 
                            	   733:     ; Decrementa COUNT
00:000004D8 537900000108    	   734:     SUBQ.W  #1,BUFFER_COUNT
                            	   735: 
                            	   736:     ; Retorna sucesso (D0 = byte lido)
00:000004DE 6002            	   737:     BRA     .Exit
                            	   738: 
                            	   739: .BufferEmpty:
00:000004E0 70FF            	   740:     MOVEQ   #-1,D0            ; Retorna -1 (buffer vazio)
                            	   741: 
                            	   742: .Exit:
00:000004E2 205F            	   743:     MOVE.L  (SP)+,A0          ; Restaura A0
00:000004E4 221F            	   744:     MOVE.L  (SP)+,D1          ; Restaura D1
00:000004E6 4E75            	   745:     RTS
                            	   746: 
                            	   747: ;---------------------------------------------------------------------
                            	   748: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   749: ;---------------------------------------------------------------------
                            	   750: ClearBufferPointers:
00:000004E8 23FC000000000000	   751:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000004F0 0100
00:000004F2 23FC000000000000	   752:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000004FA 0104
00:000004FC 33FC000000000108	   753:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000504 4E75            	   754:     RTS
                            	   755: ;---------------------------------------------------------------------
                            	   756: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   757: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   758: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   759: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   760: ;---------------------------------------------------------------------
                            	   761: MontaAddress:
00:00000506 48E73C80        	   762:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   763: 
                            	   764:     ; Verifica se há pelo menos 8 bytes no buffer
00:0000050A 323900000108    	   765:     MOVE.W  BUFFER_COUNT,D1
00:00000510 B27C0008        	   766:     CMP.W   #8,D1
00:00000514 6D38            	   767:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   768: 
00:00000516 41F900081016    	   769:     LEA     RX_BUFFER,A0 ; A0 = base do buffer
00:0000051C 243900000104    	   770:     MOVE.L  BUFFER_TAIL,D2 ; D2 = tail (ponteiro de leitura)
00:00000522 7000            	   771:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000524 7607            	   772:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   773: 
                            	   774: .ReadLoop:
00:00000526 18302800        	   775:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:0000052A 0204000F        	   776:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   777: 
                            	   778:     ; Desloca e insere os 4 bits em D0
00:0000052E E988            	   779:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000530 8004            	   780:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   781: 
                            	   782:     ; Atualiza tail (circular)
00:00000532 5282            	   783:     ADDQ.L  #1,D2
00:00000534 0282000000FF    	   784:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   785: 
00:0000053A 51CBFFEA        	   786:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   787: 
                            	   788:     ; Atualiza ponteiros globais
00:0000053E 23C200000104    	   789:     MOVE.L  D2,BUFFER_TAIL
00:00000544 517900000108    	   790:     SUB.W   #8,BUFFER_COUNT
                            	   791: 
00:0000054A 7200            	   792:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:0000054C 6004            	   793:     BRA     .Exit
                            	   794: 
                            	   795: .BufferUnderrun:
00:0000054E 72FF            	   796:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:00000550 7000            	   797:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   798: 
                            	   799: .Exit:
00:00000552 4CDF013C        	   800:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:00000556 4E75            	   801:     RTS
