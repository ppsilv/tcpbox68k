                            	   412: ; ----------------------------------------------------------------------
                            	   413: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   414: ; Entrada: D0 = endereço
                            	   415: ; ----------------------------------------------------------------------
                            	   416: PrintHexAddress:
00:000002C2 4840            	   417:     SWAP    D0                ; Imprime parte alta primeiro
00:000002C4 4EB802CA        	   418:     JSR     PrintWordHex
00:000002C8 4840            	   419:     SWAP    D0                ; Parte baixa
                            	   420:     ; Continua para PrintWordHex
                            	   421: 
                            	   422: ; ----------------------------------------------------------------------
                            	   423: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   424: ; Entrada: D0.w = valor
                            	   425: ; ----------------------------------------------------------------------
                            	   426: PrintWordHex:
00:000002CA E158            	   427:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000002CC 4EB802D2        	   428:     JSR     PrintByteHex
00:000002D0 E058            	   429:     ROR.W   #8,D0             ; Byte menos significativo
                            	   430:     ; Continua para PrintByteHex
                            	   431: 
                            	   432: ; ----------------------------------------------------------------------
                            	   433: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   434: ; Entrada: D0.b = valor
                            	   435: ; ----------------------------------------------------------------------
                            	   436: PrintByteHex:
00:000002D2 1F00            	   437:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000002D4 E808            	   438:     LSR.B   #4,D0             ; Nibble alto
00:000002D6 6106            	   439:     BSR     PrintNibble
00:000002D8 101F            	   440:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000002DA 0200000F        	   441:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   442:     ; Continua para PrintNibble
                            	   443: 
                            	   444: ; ----------------------------------------------------------------------
                            	   445: ; PrintNibble - Imprime um nibble em hex
                            	   446: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   447: ; ----------------------------------------------------------------------
                            	   448: PrintNibble:
00:000002DE B03C0009        	   449:     CMP.B   #9,D0
00:000002E2 6302            	   450:     BLS     .Decimal
00:000002E4 5E00            	   451:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   452: .Decimal:
00:000002E6 D03C0030        	   453:     ADD.B   #'0',D0
00:000002EA 4EF80106        	   454:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   455: 
                            	   456: ClearRAM:
00:000002EE 41F900081000    	   457:     LEA     $81000,A0
00:000002F4 43F9000820FF    	   458:     LEA     $820FF,A1
00:000002FA 7000            	   459:     MOVEQ   #0,D0
                            	   460: .ClearLoop:
00:000002FC 20C0            	   461:     MOVE.L  D0,(A0)+
00:000002FE B3C8            	   462:     CMPA.L  A0,A1
00:00000300 62FA            	   463:     BHI     .ClearLoop
00:00000302 4E75            	   464:     RTS
                            	   465: ; ----------------------------------------------------------------------
                            	   466: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   467: ; ----------------------------------------------------------------------
                            	   468: ClearRAM1:
00:00000304 41F900080000    	   469:     LEA     $80000,A0        ; Endereço inicial da RAM
00:0000030A 43F900100000    	   470:     LEA     $100000,A1       ; Endereço final + 1
00:00000310 7000            	   471:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   472: 
                            	   473:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000312 2209            	   474:     MOVE.L  A1,D1
00:00000314 9288            	   475:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   476: 
                            	   477:     ; Otimização: escreve longs (32 bits) quando possível
00:00000316 2401            	   478:     MOVE.L  D1,D2
00:00000318 028200000003    	   479:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:0000031E 670C            	   480:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   481: 
                            	   482:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000320 5382            	   483:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   484: .ResidualLoop:
00:00000322 10C0            	   485:     MOVE.B  D0,(A0)+
00:00000324 51CAFFFC        	   486:     DBRA    D2,.ResidualLoop
                            	   487: 
                            	   488:     ; Atualiza tamanho restante
00:00000328 9282            	   489:     SUB.L   D2,D1
00:0000032A 5381            	   490:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   491: 
                            	   492: .ClearLongs:
00:0000032C E489            	   493:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:0000032E 5381            	   494:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   495: 
                            	   496: .LongLoop:
00:00000330 20C0            	   497:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000332 51C9FFFC        	   498:     DBRA    D1,.LongLoop
00:00000336 4E75            	   499:     RTS
