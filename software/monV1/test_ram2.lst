00:00000274 103C007C        	   375:     MOVE.B  #'|',D0
00:00000278 4EB80106        	   376:     JSR     UART_WriteChar
                            	   377: 
00:0000027C 43E8FFF0        	   378:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000280 740F            	   379:     MOVEQ   #15,D2            ; 16 caracteres
                            	   380: 
                            	   381: AsciiLoop:
00:00000282 1019            	   382:     MOVE.B  (A1)+,D0
00:00000284 B03C0020        	   383:     CMP.B   #32,D0            ; Verifica se é imprimível
00:00000288 6D0C            	   384:     BLT     NonPrintable
00:0000028A B03C007E        	   385:     CMP.B   #126,D0
00:0000028E 6E06            	   386:     BGT     NonPrintable
                            	   387: 
00:00000290 4EB80106        	   388:     JSR     UART_WriteChar
00:00000294 6008            	   389:     BRA     NextAscii
                            	   390: 
                            	   391: NonPrintable:
00:00000296 103C002E        	   392:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000029A 4EB80106        	   393:     JSR     UART_WriteChar
                            	   394: 
                            	   395: NextAscii:
00:0000029E 51CAFFE2        	   396:     DBRA    D2,AsciiLoop
                            	   397: 
00:000002A2 103C007C        	   398:     MOVE.B  #'|',D0
00:000002A6 4EB80106        	   399:     JSR     UART_WriteChar
00:000002AA 103C000D        	   400:     MOVE.B  #13,D0            ; CR
00:000002AE 4EB80106        	   401:     JSR     UART_WriteChar
00:000002B2 103C000A        	   402:     MOVE.B  #10,D0            ; LF
00:000002B6 4EB80106        	   403:     JSR     UART_WriteChar
                            	   404: 
                            	   405: NoEndLine:
                            	   406:     ; Verifica fim do dump
00:000002BA B1C1            	   407:     CMP.L   D1,A0
00:000002BC 6300FF76        	   408:     BLS     DumpLoop
                            	   409: 
00:000002C0 4E75            	   410:     RTS
