02:00001CAC 4E73            	  1684:         RTE
                            	  1685: 
                            	  1686: ; --------------------------------
                            	  1687: ; Handler do TRAP #1
                            	  1688: ; Entrada:
                            	  1689: ;   D0.W - Número da função
                            	  1690: ;   D1.L - Parâmetro (para escrita)
                            	  1691: ; Saída:
                            	  1692: ;   D0.L - Resultado (para leitura)
                            	  1693: ; --------------------------------
                            	  1694: TRAP1_HANDLER:
02:00001CAE B07C0001        	  1695:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001CB2 6714            	  1696:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001CB4 B07C0002        	  1697:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001CB8 671A            	  1698:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001CBA B07C0003        	  1699:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001CBE 6722            	  1700:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001CC0 4A40            	  1701:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001CC2 672C            	  1702:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001CC4 70FF            	  1703:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001CC6 4E73            	  1704:     RTE                   ; Retorna da exceção
                            	  1705: 
                            	  1706: 
                            	  1707: 
                            	  1708: ; --------------------------------
                            	  1709: ; TRAP_CCONIN - Ler caractere do console
                            	  1710: ; Saída: D0.L - Caractere lido
                            	  1711: ; --------------------------------
                            	  1712: trap_cconin:
02:00001CC8 4EB81308        	  1713:     JSR         UART_ReadCharNonEcho
02:00001CCC 0280000000FF    	  1714:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001CD2 4E73            	  1715:     RTE                   ; Retorna da exceção
                            	  1716: 
                            	  1717: ; --------------------------------
                            	  1718: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1719: ; Entrada: D1.L - Caractere a escrever
                            	  1720: ; --------------------------------
                            	  1721: trap_cconout:
02:00001CD4 0281000000FF    	  1722:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001CDA 1001            	  1723:     MOVE.B      D1,D0
02:00001CDC 4EB812CE        	  1724:     JSR         UART_WriteChar
02:00001CE0 4E73            	  1725:     RTE                   ; Retorna da exceção
                            	  1726: 
                            	  1727: trap_strout:
02:00001CE2 1018            	  1728:     MOVE.B      (A0)+,D0
02:00001CE4 4A00            	  1729:     CMP.B       #0,D0
02:00001CE6 6706            	  1730:     BEQ         .fim
02:00001CE8 4EB812CE        	  1731:     JSR         UART_WriteChar
02:00001CEC 60F4            	  1732:     BRA         trap_strout
                            	  1733: .fim:
02:00001CEE 4E73            	  1734:     RTE
                            	  1735: 
                            	  1736: ; --------------------------------
                            	  1737: ; TRAP_PTERM0 - Terminar programa
                            	  1738: ; --------------------------------
                            	  1739: trap_pterm0:
02:00001CF0 303C0000        	  1740:     move.w  #0,d0         ; Código de saída 0
02:00001CF4 6102            	  1741:     bsr     hardware_exit ; Chama rotina de término
02:00001CF6 4E73            	  1742:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1743: 
                            	  1744: ; --------------------------------
                            	  1745: ; hardware_exit - Terminar execução
                            	  1746: ; Entrada: D0.W - Código de saída
                            	  1747: ; --------------------------------
                            	  1748: hardware_exit:
                            	  1749:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1750:     ; Exemplo: parar o processador
