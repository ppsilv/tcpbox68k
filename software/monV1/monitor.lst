                            	    59:             SECTION .text
                            	    60:             ORG $00001000
                            	    61: 
                            	    62: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    63: USER_SP     EQU     $0009F000
                            	    64: ;Clock frequency in Hz
                            	    65: F_CPU       equ 16000000
                            	    66: RAMBASE     equ $80000
                            	    67: ;Uart register offsets
                            	    68: RHR         equ     0   ; receive holding register (read)
                            	    69: THR         equ     0   ; transmit holding register (write)
                            	    70: IER         equ     2   ; interrupt enable register
                            	    71: ISR         equ     4   ; interrupt status register (read)
                            	    72: FCR         equ     4   ; FIFO control register (write)
                            	    73: LCR         equ     6   ; line control register
                            	    74: MCR         equ     8   ; modem control register
                            	    75: LSR         equ     10  ; line status register
                            	    76: MSR         equ     12  ; modem status register
                            	    77: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	    78: DLL         equ     0   ; divisor latch LSB
                            	    79: DLM         equ     2   ; divisor latch MSB
                            	    80: ; aliases for register names (used by different manufacturers)cd ..
                            	    81: RBR         equ     RHR ; receive buffer register
                            	    82: IIR         equ     ISR ; interrupt identification register
                            	    83: SCR         equ     SPR ; scratch register
                            	    84: 
                            	    85: LED_ADDRESS equ     $4400
                            	    86: UART_BASE   equ     $4000
                            	    87: TIMER_BASE  equ     $4600
                            	    88: BAUD_RATE   equ     9600
                            	    89: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    90: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	    91: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	    92: 
                            	    93: ;=== Uart receiver ================= CONSTANTES =================
                            	    94: SOH         EQU     $01        ; Start Of Header
                            	    95: EOT         EQU     $04        ; End Of Transmission
                            	    96: ACK         EQU     $06        ; Acknowledge
                            	    97: NAK         EQU     $15        ; Negative Acknowledge
                            	    98: CAN         EQU     $18        ; Cancel
                            	    99: 
                            	   100: ; --- Macro para Setar Flag ---
                            	   101: SET_FLAG   MACRO
                            	   102:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   103:     ENDM
                            	   104: ; --- Macro para Setar Flag ---
                            	   105: CLR_FLAG   MACRO
                            	   106:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   107:     ENDM
                            	   108: ; --- Macro TEST_FLAG corrigida ---
                            	   109: TEST_FLAG  MACRO
                            	   110:     BTST    #\1,minhas_flags
                            	   111:     ENDM
                            	   112: ; --- Macro para testar flag (com salto se setado) ---
                            	   113: TST_FLAG_SET MACRO
                            	   114:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	   115:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	   116:     ENDM
                            	   117: 
