                            	  1797: TRAP2_HANDLER:
                            	  1798: TRAP3_HANDLER:
                            	  1799: TRAP4_HANDLER:
                            	  1800: TRAP5_HANDLER:
                            	  1801: TRAP6_HANDLER:
                            	  1802: TRAP7_HANDLER:
                            	  1803: TRAP8_HANDLER:
                            	  1804: TRAP9_HANDLER:
                            	  1805: TRAPA_HANDLER:
                            	  1806: TRAPB_HANDLER:
                            	  1807: TRAPC_HANDLER:
                            	  1808: TRAPD_HANDLER:
                            	  1809: TRAPE_HANDLER:
                            	  1810: TRAPF_HANDLER:
02:00001D9A 4E73            	  1811:         RTE
                            	  1812: 
                            	  1813: ; --------------------------------
                            	  1814: ; Handler do TRAP #1
                            	  1815: ; Entrada:
                            	  1816: ;   D0.W - Número da função
                            	  1817: ;   D1.L - Parâmetro (para escrita)
                            	  1818: ; Saída:
                            	  1819: ;   D0.L - Resultado (para leitura)
                            	  1820: ; --------------------------------
                            	  1821: TRAP1_HANDLER:
02:00001D9C B07C0001        	  1822:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001DA0 6714            	  1823:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001DA2 B07C0002        	  1824:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001DA6 671A            	  1825:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001DA8 B07C0003        	  1826:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001DAC 6722            	  1827:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001DAE 4A40            	  1828:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001DB0 672C            	  1829:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001DB2 70FF            	  1830:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001DB4 4E73            	  1831:     RTE                   ; Retorna da exceção
                            	  1832: 
                            	  1833: 
                            	  1834: 
                            	  1835: ; --------------------------------
                            	  1836: ; TRAP_CCONIN - Ler caractere do console
                            	  1837: ; Saída: D0.L - Caractere lido
                            	  1838: ; --------------------------------
                            	  1839: trap_cconin:
02:00001DB6 4EB8137C        	  1840:     JSR         UART_ReadCharNonEcho
02:00001DBA 0280000000FF    	  1841:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001DC0 4E73            	  1842:     RTE                   ; Retorna da exceção
                            	  1843: 
                            	  1844: ; --------------------------------
                            	  1845: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1846: ; Entrada: D1.L - Caractere a escrever
                            	  1847: ; --------------------------------
                            	  1848: trap_cconout:
02:00001DC2 0281000000FF    	  1849:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001DC8 1001            	  1850:     MOVE.B      D1,D0
02:00001DCA 4EB81342        	  1851:     JSR         UART_WriteChar
02:00001DCE 4E73            	  1852:     RTE                   ; Retorna da exceção
                            	  1853: 
                            	  1854: trap_strout:
02:00001DD0 1018            	  1855:     MOVE.B      (A0)+,D0
02:00001DD2 4A00            	  1856:     CMP.B       #0,D0
02:00001DD4 6706            	  1857:     BEQ         .fim
02:00001DD6 4EB81342        	  1858:     JSR         UART_WriteChar
02:00001DDA 60F4            	  1859:     BRA         trap_strout
                            	  1860: .fim:
02:00001DDC 4E73            	  1861:     RTE
                            	  1862: 
                            	  1863: ; --------------------------------
                            	  1864: ; TRAP_PTERM0 - Terminar programa
                            	  1865: ; --------------------------------
                            	  1866: trap_pterm0:
02:00001DDE 303C0000        	  1867:     move.w  #0,d0         ; Código de saída 0
02:00001DE2 6102            	  1868:     bsr     hardware_exit ; Chama rotina de término
02:00001DE4 4E73            	  1869:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1870: 
                            	  1871: ; --------------------------------
                            	  1872: ; hardware_exit - Terminar execução
                            	  1873: ; Entrada: D0.W - Código de saída
                            	  1874: ; --------------------------------
                            	  1875: hardware_exit:
                            	  1876:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1877:     ; Exemplo: parar o processador
                            	  1878:     ; stop    #$2700
                            	  1879: 
                            	  1880:     ; Exemplo simples: loop infinito
02:00001DE6 60FE            	  1881:     BRA     hardware_exit
02:00001DE8 4E75            	  1882:     RTS
                            	  1883: 
                            	  1884:     ALIGN 2
                            	  1885: ; =====================================================================
                            	  1886: ; END XMODEM RECEIVER ROUTINE
