02:000017E8 4EB813BE        	  1162:         JSR     new_line
02:000017EC 41F9000003A7    	  1163:         LEA     BufferEmpty,A0
02:000017F2 4EB8131E        	  1164:         JSR     UART_WriteString
02:000017F6 4EB813BE        	  1165:         JSR     new_line
02:000017FA 4E75            	  1166:         RTS
                            	  1167: ;---------------------------------------------------------------------
                            	  1168: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1169: ;---------------------------------------------------------------------
                            	  1170: ClearBufferPointers:
02:000017FC 23FC000000000008	  1171:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:00001804 0026
02:00001806 23FC000000000008	  1172:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:0000180E 002A
02:00001810 33FC00000008002E	  1173:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:00001818 4E75            	  1174:         RTS
                            	  1175: ;---------------------------------------------------------------------
                            	  1176: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1177: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1178: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1179: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1180: ;---------------------------------------------------------------------
                            	  1181: MontaAddress:
02:0000181A 48E73C80        	  1182:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1183: 
                            	  1184:         ; Verifica se há pelo menos 8 bytes no buffer
02:0000181E 32390008002E    	  1185:         MOVE.W  BUFFER_COUNT,D1
02:00001824 B27C0008        	  1186:         CMP.W   #8,D1
02:00001828 6D38            	  1187:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1188: 
02:0000182A 41F900080030    	  1189:         LEA     BUFFER,A0      ; A0 = base do buffer
02:00001830 24390008002A    	  1190:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:00001836 7000            	  1191:         CLR.L   D0                ; Zera D0 (resultado final)
02:00001838 7607            	  1192:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1193: 
                            	  1194: .ReadLoop:
02:0000183A 18302800        	  1195:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:0000183E 0204000F        	  1196:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1197: 
                            	  1198:         ; Desloca e insere os 4 bits em D0
02:00001842 E988            	  1199:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:00001844 8004            	  1200:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1201: 
                            	  1202:         ; Atualiza tail (circular)
02:00001846 5282            	  1203:         ADDQ.L  #1,D2
02:00001848 0282000000FF    	  1204:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1205: 
02:0000184E 51CBFFEA        	  1206:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1207: 
                            	  1208:         ; Atualiza ponteiros globais
02:00001852 23C20008002A    	  1209:         MOVE.L  D2,BUFFER_TAIL
02:00001858 51790008002E    	  1210:         SUB.W   #8,BUFFER_COUNT
                            	  1211: 
02:0000185E 7200            	  1212:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:00001860 6004            	  1213:         BRA     .Exit
                            	  1214: 
                            	  1215: .BufferUnderrun:
02:00001862 72FF            	  1216:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:00001864 7000            	  1217:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1218: 
                            	  1219: .Exit:
02:00001866 4CDF013C        	  1220:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:0000186A 4E75            	  1221:         RTS
