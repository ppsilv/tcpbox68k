                            	   215: ; =============================================
                            	   216: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   217: ; Entrada: D0 = tempo em ms (16 bits)
                            	   218: ; Destrói: D0
                            	   219: ; =============================================
                            	   220: ; ==============================================
                            	   221: ; INICIALIZAÇÃO DO 8253 - TICK 10ms
                            	   222: ; ==============================================
                            	   223: INIT_8253:
01:00001148 48E7C080        	   224:     MOVEM.L D0-D1/A0,-(SP)
                            	   225: 
01:0000114C 20790008001E    	   226:     MOVE.L   CurrentTimer,A0
                            	   227:     ;LEA      $4603,A1
                            	   228:     ; --- Configura Canal 0 ---
                            	   229:     ; Modo 3 (Square Wave), Divisor 16-bit
01:00001152 117C00360003    	   230:     MOVE.B  #%00110110,+3(A0) ; CW: Canal 0, Modo 3, MSB+LSB
                            	   231: 
                            	   232:     ; --- Calcula divisor 10000 = $2710 ---
01:00001158 303C2710        	   233:     MOVE.W  #$2710,D0        ; 10000 em hexa
                            	   234: 
                            	   235:     ; --- Envia divisor LSB depois MSB ---
01:0000115C 1080            	   236:     MOVE.B  D0,(A0)         ; LSB
01:0000115E E048            	   237:     LSR.W   #8,D0            ; Pega MSB
01:00001160 1080            	   238:     MOVE.B  D0,(A0)         ; MSB
                            	   239: 
01:00001162 4CDF0103        	   240:     MOVEM.L (SP)+,D0-D1/A0
01:00001166 4E75            	   241:     RTS
                            	   242: 
                            	   243: ; ==============================================
                            	   244: ; ROTINA QUE LÊ CONTADOR (PARA DEBUG)
                            	   245: ; ==============================================
                            	   246: READ_8253:
01:00001168 48E7C080        	   247:     MOVEM.L D0-D1/A0,-(SP)
                            	   248: 
01:0000116C 20790008001E    	   249:     MOVE.L   CurrentTimer,A0
                            	   250:     ; --- LATCH DO CONTADOR ---
01:00001172 117C00000003    	   251:     MOVE.B  #%00000000,+3(A0) ; Latch Count para Canal 0
                            	   252: 
                            	   253:     ; --- LÊ BYTE A BYTE ---
01:00001178 1010            	   254:     MOVE.B  (A0),D0         ; Lê LSB
01:0000117A 0280000000FF    	   255:     ANDI.L  #$FF,D0          ; Isola byte
                            	   256: 
01:00001180 1210            	   257:     MOVE.B  (A0),D1         ; Lê MSB
01:00001182 0281000000FF    	   258:     ANDI.L  #$FF,D1
01:00001188 E149            	   259:     LSL.W   #8,D1            ; MSB para bits 15-8
01:0000118A 8041            	   260:     OR.W    D1,D0            ; Combina bytes (D0 = valor)
                            	   261: 
                            	   262:     ; Mostra valor
01:0000118C 4EB814EA        	   263:     JSR     PrintHexAddress
                            	   264: 
01:00001190 4CDF0103        	   265:     MOVEM.L (SP)+,D0-D1/A0
01:00001194 6000FF2C        	   266:     BRA     MenuLoop
