02:00001D48 6606            	  1758:     BNE     .not_bus_error
02:00001D4A 41F81AF3        	  1759:     LEA     bus_error_msg,A0
02:00001D4E 6028            	  1760:     BRA     .show_msg
                            	  1761: .not_bus_error:
