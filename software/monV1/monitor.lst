02:0000175A E3A8            	  1115:         LSL.L   D1,D0
02:0000175C 5901            	  1116:         SUB.B   #4,D1
02:0000175E 8480            	  1117:         OR.L    D0,D2
02:00001760 41F900080022    	  1118:         LEA     addressInHex,A0
02:00001766 2082            	  1119:         MOVE.L  D2,(A0)
02:00001768 60BC            	  1120:         BRA     .Loop
