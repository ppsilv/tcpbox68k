01:000016DC 6714            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
01:000016DE E908            	   987:         LSL.B   #4,D0
01:000016E0 1200            	   988:         MOVE.B  D0,D1
