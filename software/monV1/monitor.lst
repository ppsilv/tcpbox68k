                            	   429: ; ----------------------------------------------------------------------
                            	   430: ; Rotinas de E/S da UART
                            	   431: ; ----------------------------------------------------------------------
                            	   432: UART_Init:
                            	   433: UART_INIT:
02:000012A6 227900080010    	   434:         move.l   CurrentUART,a1
02:000012AC 137C000D0004    	   435:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:000012B2 137C00830006    	   436:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:000012B8 12BC0068        	   437:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:000012BC 137C00000002    	   438:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:000012C2 08A900070006    	   439:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:000012C8 4229000E        	   440:         clr.b   SCR(a1)                 ; clear the scratch register
02:000012CC 4E75            	   441:         RTS
                            	   442: 
                            	   443:     ; Escreve caractere (D0.B)
                            	   444: UART_WriteChar:
02:000012CE 2F08            	   445:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012D0 2F00            	   446:         MOVE.L  D0,-(SP)        ; Preserva D0
02:000012D2 207900080010    	   447:         move.l   CurrentUART,A0
                            	   448: .WaitTx:
02:000012D8 08280005000A    	   449:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:000012DE 67F8            	   450:         BEQ     .WaitTx
02:000012E0 1080            	   451:         MOVE.B  D0,THR(A0)      ; transmit byte
02:000012E2 201F            	   452:         MOVE.L  (SP)+,D0        ;Restaura D0
02:000012E4 205F            	   453:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012E6 4E75            	   454:         RTS
                            	   455: 
                            	   456: 
                            	   457: ; Lê caractere (retorna em D0)
                            	   458: UART_ReadChar:
02:000012E8 2F08            	   459:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012EA 207900080010    	   460:         MOVE.L   CurrentUART,A0
                            	   461: .WaitRx:
02:000012F0 08280000000A    	   462:         BTST    #0,LSR(A0)        ; RX ready?
02:000012F6 67F8            	   463:         BEQ     .WaitRx
02:000012F8 1010            	   464:         MOVE.B  RHR(A0),D0
02:000012FA 205F            	   465:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012FC B03C001B        	   466:         CMP.B   #$1b,D0
02:00001300 6704            	   467:         BEQ     .fim
02:00001302 4EB812CE        	   468:         JSR     UART_WriteChar
                            	   469: .fim
02:00001306 4E75            	   470:         RTS
                            	   471: 
                            	   472: ; Lê caractere (retorna em D0)
                            	   473: UART_ReadCharNonEcho:
02:00001308 2F08            	   474:         MOVE.L  A0,-(SP)        ; Preserva A0
02:0000130A 207900080010    	   475:         MOVE.L  CurrentUART,A0
                            	   476: .WaitRx:
02:00001310 08280000000A    	   477:         BTST    #0,LSR(A0)        ; RX ready?
02:00001316 67F8            	   478:         BEQ     .WaitRx
                            	   479: 
02:00001318 1010            	   480:         MOVE.B  RHR(A0),D0
02:0000131A 205F            	   481:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   482: 
02:0000131C 4E75            	   483:         RTS
