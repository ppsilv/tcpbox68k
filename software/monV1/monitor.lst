                            	   777: ; ----------------------------------------------------------------------
                            	   778: ; MemDump - Imprime dump de memória formatado
                            	   779: ; Entrada:
                            	   780: ;   A0 = Endereço inicial (ex: $80000)
                            	   781: ;   D0 = Quantidade de bytes (ex: 256)
                            	   782: ; ----------------------------------------------------------------------
                            	   783: MEMDUMP:
02:000014D0 41F90000000D    	   784:         LEA     DumpHeader,A0
02:000014D6 4EB81392        	   785:         JSR     UART_WriteString
02:000014DA 207900080022    	   786:         MOVE.L  (addressInHex),A0
02:000014E0 2008            	   787:         MOVE.L  A0,D0
02:000014E2 4EB815B0        	   788:         JSR     PrintHexAddress
02:000014E6 4EB81432        	   789:         JSR     new_line
                            	   790: 
02:000014EA 41F900000020    	   791:         LEA     DumpHeader1,A0
02:000014F0 4EB81392        	   792:         JSR     UART_WriteString
                            	   793: 
02:000014F4 207900080022    	   794:         MOVE.L  (addressInHex),A0
                            	   795:         ; Calcula endereço final
                            	   796: 
                            	   797: DUMPLOOPMASTER:
02:000014FA 7200            	   798:         CLR.L   D1
02:000014FC 2208            	   799:         MOVE.L  A0,D1
02:000014FE 0681000000FF    	   800:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   801:         ;MOVE.L  D1,D0
                            	   802:         ;JSR     PrintHexAddress
                            	   803:         ;JSR     new_line
                            	   804: 
                            	   805:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   806:         ;JSR     UART_ReadChar
                            	   807: 
                            	   808: 
                            	   809: DumpLoop:
                            	   810:         ; Nova linha a cada 16 bytes
02:00001504 2008            	   811:         MOVE.L  A0,D0
02:00001506 02800000000F    	   812:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
02:0000150C 6616            	   813:         BNE     NoNewLine
                            	   814: 
                            	   815:         ; Imprime endereço
02:0000150E 2008            	   816:         MOVE.L  A0,D0
02:00001510 4EB815B0        	   817:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   818: 
02:00001514 103C003A        	   819:         MOVE.B  #':',D0
02:00001518 4EB81342        	   820:         JSR     UART_WriteChar
02:0000151C 103C0020        	   821:         MOVE.B  #' ',D0
02:00001520 4EB81342        	   822:         JSR     UART_WriteChar
                            	   823: 
                            	   824: NoNewLine:
                            	   825:         ; Imprime byte em hex
02:00001524 1018            	   826:         MOVE.B  (A0)+,D0
02:00001526 4EB815C0        	   827:         JSR     PrintByteHex
                            	   828: 
02:0000152A 103C0020        	   829:         MOVE.B  #' ',D0
02:0000152E 4EB81342        	   830:         JSR     UART_WriteChar
                            	   831: 
                            	   832:         ; Verifica fim da linha (16 bytes)
02:00001532 2008            	   833:         MOVE.L  A0,D0
02:00001534 02800000000F    	   834:         ANDI.L  #$0000000F,D0
02:0000153A 664E            	   835:         BNE     NoEndLine
                            	   836: 
                            	   837:         ; Imprime caracteres ASCII
02:0000153C 103C0020        	   838:         MOVE.B  #' ',D0
02:00001540 4EB81342        	   839:         JSR     UART_WriteChar
02:00001544 103C007C        	   840:         MOVE.B  #'|',D0
02:00001548 4EB81342        	   841:         JSR     UART_WriteChar
                            	   842: 
02:0000154C 43E8FFF0        	   843:         LEA     -16(A0),A1        ; Volta ao início da linha
02:00001550 740F            	   844:         MOVEQ   #15,D2            ; 16 caracteres
                            	   845: 
                            	   846: AsciiLoop:
02:00001552 1019            	   847:         MOVE.B  (A1)+,D0
02:00001554 B03C0020        	   848:         CMP.B   #32,D0            ; Verifica se é imprimível
02:00001558 6D0C            	   849:         BLT     NonPrintable
02:0000155A B03C007E        	   850:         CMP.B   #126,D0
02:0000155E 6E06            	   851:         BGT     NonPrintable
                            	   852: 
02:00001560 4EB81342        	   853:         JSR     UART_WriteChar
02:00001564 6008            	   854:         BRA     NextAscii
                            	   855: 
                            	   856: NonPrintable:
02:00001566 103C002E        	   857:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
02:0000156A 4EB81342        	   858:         JSR     UART_WriteChar
                            	   859: 
                            	   860: NextAscii:
02:0000156E 51CAFFE2        	   861:         DBRA    D2,AsciiLoop
                            	   862: 
02:00001572 103C007C        	   863:         MOVE.B  #'|',D0
02:00001576 4EB81342        	   864:         JSR     UART_WriteChar
02:0000157A 103C000D        	   865:         MOVE.B  #13,D0            ; CR
02:0000157E 4EB81342        	   866:         JSR     UART_WriteChar
02:00001582 103C000A        	   867:         MOVE.B  #10,D0            ; LF
02:00001586 4EB81342        	   868:         JSR     UART_WriteChar
                            	   869: 
                            	   870: NoEndLine:
                            	   871:         ; Verifica fim do dump
02:0000158A B1C1            	   872:         CMP.L   D1,A0
02:0000158C 6300FF76        	   873:         BLS     DumpLoop
                            	   874: 
02:00001590 2F08            	   875:         MOVE.L  A0,-(SP)          ; Salva endereço atual
02:00001592 41F9000004A8    	   876:         LEA     HitAnyKey,A0
02:00001598 4EB81392        	   877:         JSR     UART_WriteString
02:0000159C 4EB8135C        	   878:         JSR     UART_ReadChar
02:000015A0 B03C001B        	   879:         CMP.B   #$1B,D0
02:000015A4 6706            	   880:         BEQ     .fim
                            	   881: 
