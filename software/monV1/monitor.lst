                            	   353: ; ----------------------------------------------------------------------
                            	   354: ; Rotinas de E/S da UART
                            	   355: ; ----------------------------------------------------------------------
                            	   356: UART_Init:
                            	   357: UART_INIT:
01:00001254 227900080010    	   358:         move.l   CurrentUART,a1
01:0000125A 137C000D0004    	   359:         move.b  #%00001101,FCR(a1)      ; enable FIFO
01:00001260 137C00830006    	   360:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
01:00001266 12BC0068        	   361:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
01:0000126A 137C00000002    	   362:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
01:00001270 08A900070006    	   363:         bclr.b  #7,LCR(a1)              ; disable divisor latch
01:00001276 4229000E        	   364:         clr.b   SCR(a1)                 ; clear the scratch register
01:0000127A 4E75            	   365:         RTS
                            	   366: 
                            	   367:     ; Escreve caractere (D0.B)
                            	   368: UART_WriteChar:
01:0000127C 2F08            	   369:         MOVE.L  A0,-(SP)        ; Preserva A0
01:0000127E 2F00            	   370:         MOVE.L  D0,-(SP)        ; Preserva D0
01:00001280 207900080010    	   371:         move.l   CurrentUART,A0
                            	   372: .WaitTx:
01:00001286 08280005000A    	   373:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
01:0000128C 67F8            	   374:         BEQ     .WaitTx
01:0000128E 1080            	   375:         MOVE.B  D0,THR(A0)      ; transmit byte
01:00001290 201F            	   376:         MOVE.L  (SP)+,D0        ;Restaura D0
01:00001292 205F            	   377:         MOVE.L  (SP)+,A0        ;Restaura A0
01:00001294 4E75            	   378:         RTS
                            	   379: 
                            	   380: 
                            	   381: ; Lê caractere (retorna em D0)
                            	   382: UART_ReadChar:
01:00001296 2F08            	   383:         MOVE.L  A0,-(SP)        ; Preserva A0
01:00001298 207900080010    	   384:         MOVE.L   CurrentUART,A0
                            	   385: .WaitRx:
01:0000129E 08280000000A    	   386:         BTST    #0,LSR(A0)        ; RX ready?
01:000012A4 67F8            	   387:         BEQ     .WaitRx
01:000012A6 1010            	   388:         MOVE.B  RHR(A0),D0
01:000012A8 205F            	   389:         MOVE.L  (SP)+,A0        ;Restaura A0
01:000012AA B03C001B        	   390:         CMP.B   #$1b,D0
01:000012AE 6704            	   391:         BEQ     .fim
01:000012B0 4EB8127C        	   392:         JSR     UART_WriteChar
                            	   393: .fim
01:000012B4 4E75            	   394:         RTS
                            	   395: 
                            	   396: ; Lê caractere (retorna em D0)
                            	   397: UART_ReadCharNonEcho:
01:000012B6 2F08            	   398:         MOVE.L  A0,-(SP)        ; Preserva A0
01:000012B8 207900080010    	   399:         MOVE.L  CurrentUART,A0
                            	   400: .WaitRx:
01:000012BE 08280000000A    	   401:         BTST    #0,LSR(A0)        ; RX ready?
01:000012C4 67F8            	   402:         BEQ     .WaitRx
                            	   403: 
01:000012C6 1010            	   404:         MOVE.B  RHR(A0),D0
01:000012C8 205F            	   405:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   406: 
01:000012CA 4E75            	   407:         RTS
