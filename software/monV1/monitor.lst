                            	  1327: ; XMODEM RECEIVER ROUTINE
                            	  1328: ;bloco.append(0x01);        // SOH
                            	  1329: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1330: ;bloco.append(255 - blockNumber); // Complemento
                            	  1331: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1332: ;bloco.append(checksum);    // Checksum calculado
                            	  1333: ; =====================================================================
                            	  1334: XMODEM_Receive:
02:00001920 48E73FFE        	  1335:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1336:        ; Inicializa variáveis
02:00001924 41F900080331    	  1337:        LEA     expected_block,A0
02:0000192A 103C0001        	  1338:        MOVE.B  #1,D0
02:0000192E 1080            	  1339:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:00001930 41F900080130    	  1340:        LEA     xmodem_buffer,A0
                            	  1341: 
02:00001936 41F900080532    	  1342:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000193C 103C0000        	  1343:        MOVE.B  #0,D0
02:00001940 1080            	  1344:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1345: 
                            	  1346:        ; ---- 1. INICIALIZAÇÃO ----
02:00001942 103C0015        	  1347:        MOVE.B  #NAK,D0
02:00001946 4EB81342        	  1348:        JSR     UART_WriteChar      ; Solicita início
                            	  1349: 
                            	  1350:        ;SINALIZA NACK SENT
02:0000194A 303C0800        	  1351:        MOVE.W  #$0800,D0
02:0000194E 4EB812B4        	  1352:        JSR     __write_leds
                            	  1353: 
                            	  1354:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:00001952 45F900082000    	  1355:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1356: 
                            	  1357:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1358: Receive_Loop:
02:00001958 4EB8137C        	  1359:        JSR     UART_ReadCharNonEcho
                            	  1360: 
02:0000195C B03C0004        	  1361:        CMP.B   #EOT,D0
02:00001960 670000B6        	  1362:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1363: 
02:00001964 B03C0001        	  1364:        CMP.B   #SOH,D0
02:00001968 66EE            	  1365:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1366: 
                            	  1367:        ;SINALIZA leds
02:0000196A 303C0100        	  1368:        MOVE.W  #$0100,D0
02:0000196E 4EB812B4        	  1369:        JSR     __write_leds
                            	  1370: 
                            	  1371:        ; ---- 3. RECEBE HEADER ----
02:00001972 4EB81A3A        	  1372:        JSR     UART_ReadCharNonEchoTimeout       ; Block number
02:00001976 13C000080330    	  1373:        MOVE.B  D0,block_number
                            	  1374: 
02:0000197C 4EB8137C        	  1375:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1376: 
                            	  1377:        ;SINALIZA leds
02:00001980 303C0800        	  1378:        MOVE.W  #$0800,D0
02:00001984 4EB812B4        	  1379:        JSR     __write_leds
                            	  1380: 
                            	  1381:        ; ---- 4. RECEBE DADOS ----
02:00001988 7220            	  1382:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:0000198A 43F900080130    	  1383:        LEA     xmodem_buffer,A1
                            	  1384: Read_Loop:
                            	  1385:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:00001990 4EB8137C        	  1386:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:00001994 E188            	  1387:        LSL.L   #8,D0
02:00001996 4EB8137C        	  1388:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:0000199A E188            	  1389:        LSL.L   #8,D0
02:0000199C 4EB8137C        	  1390:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000019A0 E188            	  1391:        LSL.L   #8,D0
02:000019A2 4EB8137C        	  1392:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000019A6 22C0            	  1393:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000019A8 5381            	  1394:        SUBQ.L  #1,D1
02:000019AA 66E4            	  1395:        BNE     Read_Loop
                            	  1396: 
02:000019AC 303C0200        	  1397:        MOVE.W  #$0200,D0
02:000019B0 4EB812B4        	  1398:        JSR     __write_leds
                            	  1399: 
                            	  1400:        ; ---- 5. VERIFICA CHECKSUM ----
02:000019B4 4EB8137C        	  1401:        JSR     UART_ReadCharNonEcho       ; Checksum
02:000019B8 1400            	  1402:        MOVE.B  D0,D2
                            	  1403: 
                            	  1404:         ; Calcula checksum local
02:000019BA 43F900080130    	  1405:         LEA     xmodem_buffer,A1
02:000019C0 323C007F        	  1406:         MOVE.W  #127,D1
02:000019C4 7600            	  1407:         CLR.L   D3
                            	  1408: 
                            	  1409: Calc_Checksum:
02:000019C6 D619            	  1410:         ADD.B   (A1)+,D3
02:000019C8 51C9FFFC        	  1411:         DBF     D1,Calc_Checksum;
                            	  1412: 
02:000019CC B602            	  1413:         CMP.B   D2,D3
02:000019CE 6634            	  1414:         BNE     Send_NAK            ; Erro no checksum
                            	  1415: 
                            	  1416:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1417:         ;MOVE.B  block_number,D0
                            	  1418:         ;CMP.B   expected_block,D0
                            	  1419:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1420: 
                            	  1421:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1422:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1423:         ; Exemplo: copiar do buffer para a RAM
                            	  1424:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:000019D0 43F900080130    	  1425:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:000019D6 7220            	  1426:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1427: Copy_Data:
02:000019D8 24D9            	  1428:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:000019DA 5381            	  1429:         SUBQ.L  #1,D1               ; Decrementa contador
02:000019DC 66FA            	  1430:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1431: 
                            	  1432:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:000019DE 523900080331    	  1433:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:000019E4 103C0006        	  1434:         MOVE.B  #ACK,D0
02:000019E8 4EB81342        	  1435:         JSR     UART_WriteChar
02:000019EC 6000FF6A        	  1436:         BRA     Receive_Loop
                            	  1437: 
                            	  1438: Send_ACK:
                            	  1439:         ;SINALIZA NACK SENT
02:000019F0 303C0400        	  1440:         MOVE.W  #$0400,D0
02:000019F4 4EB812B4        	  1441:         JSR     __write_leds
02:000019F8 103C0006        	  1442:         MOVE.B  #ACK,D0
02:000019FC 4EB81342        	  1443:         JSR     UART_WriteChar
02:00001A00 6000FF56        	  1444:         BRA     Receive_Loop
                            	  1445: 
                            	  1446: Send_NAK:
02:00001A04 303C0800        	  1447:         MOVE.W  #$0800,D0
02:00001A08 4EB812B4        	  1448:         JSR     __write_leds
02:00001A0C 103C0015        	  1449:         MOVE.B  #NAK,D0
02:00001A10 4EB81342        	  1450:         JSR     UART_WriteChar
02:00001A14 6000FF42        	  1451:         BRA     Receive_Loop
                            	  1452: 
                            	  1453: Transfer_Complete:
02:00001A18 303C1000        	  1454:         MOVE.W  #$1000,D0
02:00001A1C 4EB812B4        	  1455:         JSR     __write_leds
02:00001A20 103C0006        	  1456:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001A24 4EB81342        	  1457:         JSR     UART_WriteChar
                            	  1458: 
