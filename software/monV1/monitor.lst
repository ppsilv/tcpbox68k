                            	   455: ; ----------------------------------------------------------------------
                            	   456: ; UART_WriteString - Envia string terminada em null para UART
                            	   457: ; Entrada:
                            	   458: ;   A0 = Ponteiro para a string (endereço da string)
                            	   459: ; ----------------------------------------------------------------------
                            	   460: UART_WriteString:
02:00001312 2F08            	   461:         MOVE.L  A0,-(SP)      ; Preserva D0
02:00001314 2F00            	   462:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   463: .WriteLoop:
02:00001316 1018            	   464:         MOVE.B  (A0)+,D0      ; Pega caractere
02:00001318 6706            	   465:         BEQ     .Done
02:0000131A 4EB812C2        	   466:         JSR     UART_WriteChar ; Use sua rotine existente
02:0000131E 60F6            	   467:         BRA     .WriteLoop
                            	   468: .Done:
02:00001320 201F            	   469:         MOVE.L  (SP)+,D0
02:00001322 205F            	   470:         MOVE.L  (SP)+,A0
02:00001324 4E75            	   471:         RTS
