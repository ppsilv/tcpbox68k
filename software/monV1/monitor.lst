                            	  1125: ;--------------------------------------------------
                            	  1126: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1127: ;--------------------------------------------------
                            	  1128: ;Exemplo: Lendo byte do buffer
                            	  1129: ;         BSR     UART_BufferGet
                            	  1130: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1131: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1132: ;         Senão, D0 contém o byte lido!
                            	  1133: BufferGet:
02:000017AC 2F01            	  1134:         MOVE.L  D1,-(SP)
02:000017AE 2F08            	  1135:         MOVE.L  A0,-(SP)
                            	  1136: 
02:000017B0 32390008002E    	  1137:         MOVE.W  BUFFER_COUNT,D1
02:000017B6 6724            	  1138:         BEQ     .BufferEmpty
                            	  1139: 
02:000017B8 41F900080030    	  1140:         LEA     BUFFER,A0
                            	  1141: 
                            	  1142:         ; Modificado para usar deslocamento de 16 bits
02:000017BE 32390008002A    	  1143:         MOVE.W  BUFFER_TAIL,D1
02:000017C4 10301000        	  1144:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1145: 
02:000017C8 5401            	  1146:         ADDQ.B  #2,D1              ; Incrementa como word
02:000017CA 024100FF        	  1147:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:000017CE 33C10008002A    	  1148:         MOVE.W  D1,BUFFER_TAIL
                            	  1149: 
02:000017D4 53790008002E    	  1150:         SUBQ.W  #1,BUFFER_COUNT
02:000017DA 6006            	  1151:         BRA     .Exit
                            	  1152: 
                            	  1153: .BufferEmpty:
02:000017DC 4EB817E8        	  1154:         JSR     FBufferEmpty
02:000017E0 70FF            	  1155:         MOVEQ   #-1,D0
                            	  1156: .Exit:
02:000017E2 205F            	  1157:         MOVE.L  (SP)+,A0
02:000017E4 221F            	  1158:         MOVE.L  (SP)+,D1
02:000017E6 4E75            	  1159:         RTS
                            	  1160: 
