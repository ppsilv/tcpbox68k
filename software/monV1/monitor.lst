                            	   503: ; ----------------------------------------------------------------------
                            	   504: ; Rotinas de E/S da UART
                            	   505: ; ----------------------------------------------------------------------
                            	   506: UART_Init:
                            	   507: UART_INIT:
02:000012F4 227900080010    	   508:         move.l   CurrentUART,a1
02:000012FA 137C000D0004    	   509:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:00001300 137C00830006    	   510:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:00001306 12BC0008        	   511:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:0000130A 137C00000002    	   512:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:00001310 08A900070006    	   513:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:00001316 4229000E        	   514:         clr.b   SCR(a1)                 ; clear the scratch register
02:0000131A 4E75            	   515:         RTS
                            	   516: 
                            	   517: ; ----------------------------------------------------------------------
                            	   518: ; UART_INIT1:
                            	   519: ; Parametros: D0 tem o byte a ser gravado em DLM e DLL divisor baud rate
                            	   520: ; ----------------------------------------------------------------------
                            	   521: UART_INIT1:
02:0000131C 227900080010    	   522:         move.l   CurrentUART,a1
02:00001322 137C000D0004    	   523:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:00001328 137C00830006    	   524:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:0000132E 1280            	   525:         move.b  D0,DLL(A1)              ; Byte 0 (LSB) -> DLL
02:00001330 E088            	   526:         lsr.l   #8,D0                   ; Shift right 8 bits
02:00001332 13400002        	   527:         move.b  D0,DLM(A1)              ; Byte 1 (agora no LSB) -> DLM
02:00001336 08A900070006    	   528:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:0000133C 4229000E        	   529:         clr.b   SCR(a1)                 ; clear the scratch register
02:00001340 4E75            	   530:         RTS
                            	   531: 
                            	   532:     ; Escreve caractere (D0.B)
                            	   533: UART_WriteChar:
02:00001342 2F08            	   534:         MOVE.L  A0,-(SP)        ; Preserva A0
02:00001344 2F00            	   535:         MOVE.L  D0,-(SP)        ; Preserva D0
02:00001346 207900080010    	   536:         move.l   CurrentUART,A0
                            	   537: .WaitTx:
02:0000134C 08280005000A    	   538:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:00001352 67F8            	   539:         BEQ     .WaitTx
02:00001354 1080            	   540:         MOVE.B  D0,THR(A0)      ; transmit byte
02:00001356 201F            	   541:         MOVE.L  (SP)+,D0        ;Restaura D0
02:00001358 205F            	   542:         MOVE.L  (SP)+,A0        ;Restaura A0
02:0000135A 4E75            	   543:         RTS
                            	   544: 
                            	   545: 
                            	   546: ; Lê caractere (retorna em D0)
                            	   547: UART_ReadChar:
02:0000135C 2F08            	   548:         MOVE.L  A0,-(SP)        ; Preserva A0
02:0000135E 207900080010    	   549:         MOVE.L   CurrentUART,A0
                            	   550: .WaitRx:
02:00001364 08280000000A    	   551:         BTST    #0,LSR(A0)        ; RX ready?
02:0000136A 67F8            	   552:         BEQ     .WaitRx
02:0000136C 1010            	   553:         MOVE.B  RHR(A0),D0
02:0000136E 205F            	   554:         MOVE.L  (SP)+,A0        ;Restaura A0
02:00001370 B03C001B        	   555:         CMP.B   #$1b,D0
02:00001374 6704            	   556:         BEQ     .fim
02:00001376 4EB81342        	   557:         JSR     UART_WriteChar
                            	   558: .fim
02:0000137A 4E75            	   559:         RTS
                            	   560: 
                            	   561: ; Lê caractere (retorna em D0)
                            	   562: UART_ReadCharNonEcho:
02:0000137C 2F08            	   563:         MOVE.L  A0,-(SP)        ; Preserva A0
02:0000137E 207900080010    	   564:         MOVE.L  CurrentUART,A0
                            	   565: .WaitRx:
02:00001384 08280000000A    	   566:         BTST    #0,LSR(A0)        ; RX ready?
02:0000138A 67F8            	   567:         BEQ     .WaitRx
                            	   568: 
02:0000138C 1010            	   569:         MOVE.B  RHR(A0),D0
02:0000138E 205F            	   570:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   571: 
02:00001390 4E75            	   572:         RTS
                            	   573: 
                            	   574: 
                            	   575: ; ----------------------------------------------------------------------
                            	   576: ; UART_WriteString - Envia string terminada em null para UART
                            	   577: ; Entrada:
                            	   578: ;   A0 = Ponteiro para a string (endereço da string)
                            	   579: ; ----------------------------------------------------------------------
                            	   580: UART_WriteString:
02:00001392 2F08            	   581:         MOVE.L  A0,-(SP)      ; Preserva D0
02:00001394 2F00            	   582:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   583: .WriteLoop:
02:00001396 1018            	   584:         MOVE.B  (A0)+,D0      ; Pega caractere
02:00001398 6706            	   585:         BEQ     .Done
02:0000139A 4EB81342        	   586:         JSR     UART_WriteChar ; Use sua rotine existente
02:0000139E 60F6            	   587:         BRA     .WriteLoop
                            	   588: .Done:
02:000013A0 201F            	   589:         MOVE.L  (SP)+,D0
02:000013A2 205F            	   590:         MOVE.L  (SP)+,A0
02:000013A4 4E75            	   591:         RTS
                            	   592: 
                            	   593: ; ----------------------------------------------------------------------
                            	   594: ; Constantes
                            	   595: ; ----------------------------------------------------------------------
                            	   596: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   597: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   598:                               ; BAUD_DIV_L em $70000
                            	   599:                               ; BAUD_DIV_U em $70001
                            	   600: 
                            	   601: ; ----------------------------------------------------------------------
                            	   602: ; Rotina: Calcula e armazena divisor de baud rate
                            	   603: ; Entrada:
                            	   604: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   605: ; Saída:
                            	   606: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   607: ; Formulas:
                            	   608: ;
                            	   609: ;
                            	   610: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   611: ; ----------------------------------------------------------------------
                            	   612: 
                            	   613: CALCBAUDDIV:
                            	   614: ;[ Registrador D0 (32 bits) ]
                            	   615: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   616: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   617:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   618:         ;((F_CPU/16)/10)
                            	   619:         ;F_CPU = 16000000 ou 0xF42400
02:000013A6 203C00F42400    	   620:         MOVE.L  #F_CPU,D0
02:000013AC 323C0010        	   621:         MOVE.W  #16,D1         ; Divisor
02:000013B0 61000096        	   622:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   623: ;1
02:000013B4 2F00            	   624:         move.l  d0,-(SP)
02:000013B6 4EB815B0        	   625:         jsr     PrintHexAddress
02:000013BA 4EB81432        	   626:         jsr     new_line
02:000013BE 201F            	   627:         move.l  (SP)+,d0
                            	   628: 
02:000013C0 323C000A        	   629:         MOVE.W  #10,D1         ; Divisor
02:000013C4 61000082        	   630:         BSR     Div32x16       ; D0 = 0x186A0
                            	   631: ;2
02:000013C8 2F00            	   632:         move.l  d0,-(SP)
02:000013CA 4EB815B0        	   633:         jsr     PrintHexAddress
02:000013CE 4EB81432        	   634:         jsr     new_line
02:000013D2 201F            	   635:         move.l  (SP)+,d0
                            	   636: 
                            	   637:         ;(BAUD/10)
02:000013D4 2F00            	   638:         move.l  d0,-(SP)
                            	   639: ;3
02:000013D6 7000            	   640:         CLR.L   D0
02:000013D8 303900080014    	   641:         MOVE.W  CurrentBaudRate,D0
02:000013DE 2F00            	   642:         move.l  d0,-(SP)
02:000013E0 4EB815B0        	   643:         jsr     PrintHexAddress
02:000013E4 4EB81432        	   644:         jsr     new_line
02:000013E8 201F            	   645:         move.l  (SP)+,d0
                            	   646: 
02:000013EA 123C000A        	   647:         MOVE.B  #10,D1
02:000013EE 6158            	   648:         BSR     Div32x16
                            	   649: 
                            	   650: ;4
02:000013F0 2F00            	   651:         move.l  d0,-(SP)
02:000013F2 4EB815B0        	   652:         jsr     PrintHexAddress
02:000013F6 4EB81432        	   653:         jsr     new_line
02:000013FA 221F            	   654:         move.l  (SP)+,D1
02:000013FC 201F            	   655:         move.l  (SP)+,D0
                            	   656: 
                            	   657: 
                            	   658:         ;(F_CPU/BAUD)
02:000013FE 6148            	   659:         BSR     Div32x16
                            	   660: ;5
02:00001400 2F00            	   661:         move.l  d0,-(SP)
02:00001402 4EB815B0        	   662:         jsr     PrintHexAddress
02:00001406 4EB81432        	   663:         jsr     new_line
02:0000140A 201F            	   664:         move.l  (SP)+,d0
                            	   665: 
                            	   666:         ; 4. Separa parte alta/baixa corretamente
02:0000140C 3200            	   667:         MOVE.W  D0,D1
02:0000140E 024000FF        	   668:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:00001412 E049            	   669:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:00001414 024100FF        	   670:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   671: 
                            	   672:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:00001418 41F90008001A    	   673:         LEA     Baud1DivL,A0
02:0000141E 3080            	   674:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:00001420 41F90008001C    	   675:         LEA     Baud1DivH,A0
02:00001426 3081            	   676:         MOVE.W  D1,(A0)
                            	   677: 
02:00001428 6000FCA0        	   678:         BRA     MenuLoop
02:0000142C 4E75            	   679:         RTS
                            	   680: .BaudError:
02:0000142E 6000FBD0        	   681:         BRA     _start
                            	   682: 
                            	   683: new_line:
02:00001432 2F00            	   684:         MOVE.L  D0,-(SP)          ; Salva D0
02:00001434 103C000A        	   685:         MOVE.B  #10,D0
02:00001438 4EB81342        	   686:         JSR     UART_WriteChar
02:0000143C 103C000D        	   687:         MOVE.B  #13,D0
02:00001440 4EB81342        	   688:         JSR     UART_WriteChar
02:00001444 201F            	   689:         MOVE.L  (SP)+,D0          ; Restaura D0
02:00001446 4E75            	   690:         RTS
                            	   691: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   692: ; Retorna D0 = Quociente, D1 = Resto
                            	   693: Div32x16:
02:00001448 7400            	   694:         MOVEQ   #0,D2       ; D2 = Quociente
02:0000144A 761F            	   695:         MOVEQ   #31,D3      ; 32 iterações
                            	   696: DivLoop:
02:0000144C E388            	   697:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:0000144E E392            	   698:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:00001450 B441            	   699:         CMP.W   D1,D2       ; D2 >= D1?
02:00001452 6D04            	   700:         BLT     .skip
02:00001454 9441            	   701:         SUB.W   D1,D2       ; Sim, subtrai
02:00001456 5280            	   702:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   703: .skip:
02:00001458 51CBFFF2        	   704:         DBRA    D3,DivLoop  ; Repete
02:0000145C 2202            	   705:         MOVE.L  D2,D1       ; Resto em D1
02:0000145E 4E75            	   706:         RTS
                            	   707: ; Versão compacta sem stack frame
                            	   708: PrintHexFast:
02:00001460 2F02            	   709:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001462 2F00            	   710:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:00001464 7407            	   711:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   712: 
                            	   713: .Loop:
02:00001466 2017            	   714:         MOVE.L  (SP),D0           ; Recupera valor original
02:00001468 E998            	   715:         ROL.L   #4,D0             ; Pega próximo nibble
02:0000146A 2E80            	   716:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:0000146C 0200000F        	   717:         ANDI.B  #$F,D0            ; Isola nibble
                            	   718: 
02:00001470 B03C0009        	   719:         CMP.B   #9,D0
02:00001474 6302            	   720:         BLS     .Digit
02:00001476 5E00            	   721:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   722: .Digit:
02:00001478 D03C0030        	   723:         ADD.B   #'0',D0           ; Converte para ASCII
02:0000147C 4EB81342        	   724:         JSR     UART_WriteChar    ; Envia caractere
                            	   725: 
02:00001480 51CAFFE4        	   726:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   727: 
02:00001484 588F            	   728:         ADDQ.L  #4,SP             ; Remove valor salvo
02:00001486 241F            	   729:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001488 4E75            	   730:         RTS
                            	   731: 
                            	   732: ; ----------------------------------------------------------------------
                            	   733: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   734: ; Entrada:
                            	   735: ;   D0.L = Valor a ser impresso (32 bits)
                            	   736: ;   D1.W = Número de dígitos (1-8)
                            	   737: ; ----------------------------------------------------------------------
                            	   738: PrintHexPRECISA_DE_REVISAO:
02:0000148A 4E56FFF8        	   739:         LINK    A6,#-8            ; Reserva espaço na pilha
02:0000148E 2F02            	   740:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001490 2D40FFFC        	   741:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:00001494 3D41FFFA        	   742:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   743: 
02:00001498 323C0008        	   744:         MOVE.W  #$0008,D1
                            	   745: 
                            	   746:         ; Ajusta para começar pelo dígito mais significativo
02:0000149C E549            	   747:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:0000149E 5941            	   748:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   749: 
                            	   750: .PrintLoop:
02:000014A0 202EFFFC        	   751:         MOVE.L  -4(A6),D0         ; Recupera valor
02:000014A4 3401            	   752:         MOVE.W  D1,D2             ; Posição do nibble
02:000014A6 E5B8            	   753:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:000014A8 02800000000F    	   754:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   755: 
                            	   756:         ; Converte para ASCII
02:000014AE B03C0009        	   757:         CMP.B   #9,D0
02:000014B2 6302            	   758:         BLS     .Decimal
02:000014B4 5E00            	   759:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   760: .Decimal:
02:000014B6 D03C0030        	   761:         ADD.B   #'0',D0           ; Converte para caractere
                            	   762: 
                            	   763:         ; Imprime caractere
02:000014BA 4EB81342        	   764:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   765: 
02:000014BE 5941            	   766:         SUBQ.W  #4,D1             ; Próximo nibble
02:000014C0 6ADE            	   767:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   768: 
                            	   769:         ; Espaço final para separação
02:000014C2 103C0020        	   770:         MOVE.B  #' ',D0
02:000014C6 4EB81342        	   771:         JSR     UART_WriteChar
                            	   772: 
02:000014CA 241F            	   773:         MOVE.L  (SP)+,D2          ; Restaura D2
02:000014CC 4E5E            	   774:         UNLK    A6                ; Restaura frame
02:000014CE 4E75            	   775:         RTS
