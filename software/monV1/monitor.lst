02:00001742 B03C0041        	  1074:         CMP.B   #'A',D0
02:00001746 6D02            	  1075:         BLT     .Digit
02:00001748 5F00            	  1076:         SUB.B   #7,D0            ; Ajuste para A-F
                            	  1077: .Digit:
