                            	   261: ; =============================================
                            	   262: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   263: ; Entrada: D0 = tempo em ms (16 bits)
                            	   264: ; Destrói: D0
                            	   265: ; =============================================
                            	   266: ; ==============================================
                            	   267: ; INICIALIZAÇÃO DO 8253 - TICK 10ms
                            	   268: ; ==============================================
                            	   269: INIT_8253:
02:0000118E 48E7C080        	   270:     MOVEM.L D0-D1/A0,-(SP)
                            	   271: 
02:00001192 20790008001E    	   272:     MOVE.L   CurrentTimer,A0
                            	   273:     ;LEA      $4603,A1
                            	   274:     ; --- Configura Canal 0 ---
                            	   275:     ; Modo 3 (Square Wave), Divisor 16-bit
02:00001198 117C00360003    	   276:     MOVE.B  #%00110110,+3(A0) ; CW: Canal 0, Modo 3, MSB+LSB
                            	   277: 
                            	   278:     ; --- Calcula divisor 10000 = $2710 ---
02:0000119E 303C2710        	   279:     MOVE.W  #$2710,D0        ; 10000 em hexa
                            	   280: 
                            	   281:     ; --- Envia divisor LSB depois MSB ---
02:000011A2 1080            	   282:     MOVE.B  D0,(A0)         ; LSB
02:000011A4 E048            	   283:     LSR.W   #8,D0            ; Pega MSB
02:000011A6 1080            	   284:     MOVE.B  D0,(A0)         ; MSB
                            	   285: 
02:000011A8 4CDF0103        	   286:     MOVEM.L (SP)+,D0-D1/A0
02:000011AC 4E75            	   287:     RTS
                            	   288: 
                            	   289: ; ==============================================
                            	   290: ; ROTINA QUE LÊ CONTADOR (PARA DEBUG)
                            	   291: ; ==============================================
                            	   292: READ_8253:
02:000011AE 48E7C080        	   293:     MOVEM.L D0-D1/A0,-(SP)
                            	   294: 
02:000011B2 20790008001E    	   295:     MOVE.L   CurrentTimer,A0
                            	   296:     ; --- LATCH DO CONTADOR ---
02:000011B8 117C00000003    	   297:     MOVE.B  #%00000000,+3(A0) ; Latch Count para Canal 0
                            	   298: 
                            	   299:     ; --- LÊ BYTE A BYTE ---
02:000011BE 1010            	   300:     MOVE.B  (A0),D0         ; Lê LSB
02:000011C0 0280000000FF    	   301:     ANDI.L  #$FF,D0          ; Isola byte
                            	   302: 
02:000011C6 1210            	   303:     MOVE.B  (A0),D1         ; Lê MSB
02:000011C8 0281000000FF    	   304:     ANDI.L  #$FF,D1
02:000011CE E149            	   305:     LSL.W   #8,D1            ; MSB para bits 15-8
02:000011D0 8041            	   306:     OR.W    D1,D0            ; Combina bytes (D0 = valor)
                            	   307: 
                            	   308:     ; Mostra valor
02:000011D2 4EB81530        	   309:     JSR     PrintHexAddress
                            	   310: 
02:000011D6 4CDF0103        	   311:     MOVEM.L (SP)+,D0-D1/A0
02:000011DA 6000FEE6        	   312:     BRA     MenuLoop
