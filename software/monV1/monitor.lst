                            	  1201: XMODEM_Receive:
02:0000186C 48E73FFE        	  1202:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1203:        ; Inicializa variáveis
02:00001870 41F900080331    	  1204:        LEA     expected_block,A0
02:00001876 103C0001        	  1205:        MOVE.B  #1,D0
02:0000187A 1080            	  1206:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:0000187C 41F900080130    	  1207:        LEA     xmodem_buffer,A0
                            	  1208: 
02:00001882 41F900080536    	  1209:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:00001888 103C0000        	  1210:        MOVE.B  #0,D0
02:0000188C 1080            	  1211:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1212: 
                            	  1213:        ; ---- 1. INICIALIZAÇÃO ----
02:0000188E 103C0015        	  1214:        MOVE.B  #NAK,D0
02:00001892 4EB812C2        	  1215:        JSR     UART_WriteChar      ; Solicita início
                            	  1216: 
                            	  1217:        ;SINALIZA NACK SENT
02:00001896 303C0800        	  1218:        MOVE.W  #$0800,D0
02:0000189A 4EB8125A        	  1219:        JSR     __write_leds
                            	  1220: 
                            	  1221:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:0000189E 45F900082000    	  1222:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1223: 
                            	  1224:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1225: Receive_Loop:
02:000018A4 4EB812FC        	  1226:        JSR     UART_ReadCharNonEcho
                            	  1227: 
02:000018A8 B03C0004        	  1228:        CMP.B   #EOT,D0
02:000018AC 670000AE        	  1229:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1230: 
02:000018B0 B03C0001        	  1231:        CMP.B   #SOH,D0
02:000018B4 66EE            	  1232:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1233: 
                            	  1234:        ;SINALIZA leds
02:000018B6 303C0C00        	  1235:        MOVE.W  #$0C00,D0
02:000018BA 4EB8125A        	  1236:        JSR     __write_leds
                            	  1237: 
                            	  1238:        ; ---- 3. RECEBE HEADER ----
02:000018BE 4EB812FC        	  1239:        JSR     UART_ReadCharNonEcho       ; Block number
02:000018C2 13C000080330    	  1240:        MOVE.B  D0,block_number
                            	  1241: 
02:000018C8 4EB812FC        	  1242:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1243: 
                            	  1244:        ;SINALIZA leds
02:000018CC 303C0800        	  1245:        MOVE.W  #$0800,D0
02:000018D0 4EB8125A        	  1246:        JSR     __write_leds
                            	  1247: 
                            	  1248:        ; ---- 4. RECEBE DADOS ----
02:000018D4 7220            	  1249:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:000018D6 43F900080130    	  1250:        LEA     xmodem_buffer,A1
                            	  1251: Read_Loop:
                            	  1252:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:000018DC 4EB812FC        	  1253:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:000018E0 E188            	  1254:        LSL.L   #8,D0
02:000018E2 4EB812FC        	  1255:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:000018E6 E188            	  1256:        LSL.L   #8,D0
02:000018E8 4EB812FC        	  1257:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000018EC E188            	  1258:        LSL.L   #8,D0
02:000018EE 4EB812FC        	  1259:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000018F2 22C0            	  1260:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000018F4 5381            	  1261:        SUBQ.L  #1,D1
02:000018F6 66E4            	  1262:        BNE     Read_Loop
                            	  1263: 
02:000018F8 303C0600        	  1264:        MOVE.W  #$0600,D0
02:000018FC 4EB8125A        	  1265:        JSR     __write_leds
                            	  1266: 
                            	  1267:        ; ---- 5. VERIFICA CHECKSUM ----
02:00001900 4EB812FC        	  1268:        JSR     UART_ReadCharNonEcho       ; Checksum
02:00001904 1400            	  1269:        MOVE.B  D0,D2
                            	  1270: 
                            	  1271: 
                            	  1272: ;******************************************************************************************
                            	  1273:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1274:            ;     BRA     Send_ACK
                            	  1275: ;******************************************************************************************
                            	  1276: 
                            	  1277:         ; Calcula checksum local
02:00001906 43F900080130    	  1278:         LEA     xmodem_buffer,A1
02:0000190C 323C007F        	  1279:         MOVE.W  #127,D1
02:00001910 7600            	  1280:         CLR.L   D3
                            	  1281: 
                            	  1282: Calc_Checksum:
02:00001912 D619            	  1283:         ADD.B   (A1)+,D3
02:00001914 51C9FFFC        	  1284:         DBF     D1,Calc_Checksum;
                            	  1285: 
02:00001918 B602            	  1286:         CMP.B   D2,D3
02:0000191A 6634            	  1287:         BNE     Send_NAK            ; Erro no checksum
                            	  1288: 
                            	  1289:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1290:         ;MOVE.B  block_number,D0
                            	  1291:         ;CMP.B   expected_block,D0
                            	  1292:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1293: 
                            	  1294:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1295:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1296:         ; Exemplo: copiar do buffer para a RAM
                            	  1297:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:0000191C 43F900080130    	  1298:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:00001922 7220            	  1299:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1300: Copy_Data:
02:00001924 24D9            	  1301:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:00001926 5381            	  1302:         SUBQ.L  #1,D1               ; Decrementa contador
02:00001928 66FA            	  1303:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1304: 
                            	  1305:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:0000192A 523900080331    	  1306:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:00001930 103C0006        	  1307:         MOVE.B  #ACK,D0
02:00001934 4EB812C2        	  1308:         JSR     UART_WriteChar
02:00001938 6000FF6A        	  1309:         BRA     Receive_Loop
                            	  1310: 
                            	  1311: Send_ACK:
                            	  1312:         ;SINALIZA NACK SENT
02:0000193C 303C0400        	  1313:         MOVE.W  #$0400,D0
02:00001940 4EB8125A        	  1314:         JSR     __write_leds
02:00001944 103C0006        	  1315:         MOVE.B  #ACK,D0
02:00001948 4EB812C2        	  1316:         JSR     UART_WriteChar
02:0000194C 6000FF56        	  1317:         BRA     Receive_Loop
                            	  1318: 
                            	  1319: Send_NAK:
02:00001950 103C0015        	  1320:         MOVE.B  #NAK,D0
02:00001954 4EB812C2        	  1321:         JSR     UART_WriteChar
02:00001958 6000FF4A        	  1322:         BRA     Receive_Loop
                            	  1323: 
                            	  1324: Transfer_Complete:
02:0000195C 103C0006        	  1325:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001960 4EB812C2        	  1326:         JSR     UART_WriteChar
                            	  1327: 
02:00001964 41F900080536    	  1328:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000196A 103C0001        	  1329:         MOVE.B  #1,D0
02:0000196E 1080            	  1330:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1331: 
02:00001970 4CDF7FFC        	  1332:         MOVEM.L (SP)+,D2-D7/A0-A6
02:00001974 4E75            	  1333:         RTS
                            	  1334: ; ========================================================
                            	  1335: ; Validador de Checksum para ROM (MC68000)
                            	  1336: ; Assume:
                            	  1337: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1338: ;   - Big-endian (padrão 68000)
                            	  1339: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1340: ; ========================================================
                            	  1341: 
                            	  1342: VALIDATE_ROM:
02:00001976 91C8            	  1343:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001978 203C00003FFC    	  1344:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:0000197E 7200            	  1345:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1346: 
                            	  1347:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1348: .CHECKSUM_LOOP:
02:00001980 2418            	  1349:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001982 D282            	  1350:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001984 5980            	  1351:         SUB.L   #4,D0               ; Decrementa contador
02:00001986 6EF8            	  1352:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1353: 
02:00001988 41F900080532    	  1354:         LEA     checksum_calc,A0
02:0000198E 20C1            	  1355:         MOVE.L  D1,(A0)+
                            	  1356:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1357: 
                            	  1358:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001990 24383FFC        	  1359:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:00001994 B481            	  1360:         CMP.L   D1,D2               ; Combina com o calculado?
02:00001996 6706            	  1361:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1362: 
                            	  1363:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:00001998 363CDEAD        	  1364:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:0000199C 6002            	  1365:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1366: .CHECKSUM_OK:
02:0000199E 4E75            	  1367:         RTS                         ; Retorna (ROM válida)
                            	  1368: 
                            	  1369: 
                            	  1370: SYSTEM_HALT:
02:000019A0 46FC2700        	  1371:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1372: .INFINITE_LOOP:
02:000019A4 60FE            	  1373:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1374: 
                            	  1375: 
                            	  1376: 
                            	  1377: ; --- Constantes ---
                            	  1378: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1379: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1380: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1381: 
                            	  1382: SPURIOUS_HANDLER:
02:000019A6 31FCCB004400    	  1383:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
02:000019AC 4E73            	  1384:     RTE
                            	  1385: 
                            	  1386: DEFAULT_HANDLER:
02:000019AE 48E7FFFE        	  1387:     MOVEM.L D0-D7/A0-A6,-(SP)
                            	  1388: 
                            	  1389:     ; --- IDENTIFICA O TIPO DE EXCEÇÃO ---
                            	  1390:     ; --- AGORA lê corretamente da pilha ---
02:000019B2 202F000E        	  1391:     MOVE.L  (14,SP),D0      ; ⭐⭐ PC (14 bytes abaixo por causa dos registradores salvos)
02:000019B6 322F0012        	  1392:     MOVE.W  (18,SP),D1      ; ⭐⭐ SR (18 bytes abaixo)
02:000019BA 342F0014        	  1393:     MOVE.W  (20,SP),D2      ; ⭐⭐ Vector Offset (20 bytes abaixo)
                            	  1394: 
                            	  1395:     ; Mostra informações detalhadas
02:000019BE 41F81A5C        	  1396:     LEA     debug_msg,A0
02:000019C2 4EB81312        	  1397:     JSR     UART_WriteString
                            	  1398: 
02:000019C6 2000            	  1399:     MOVE.L  D0,D0           ; PC
02:000019C8 4EB81530        	  1400:     JSR     PrintHexAddress
02:000019CC 4EB813B2        	  1401:     JSR     new_line
                            	  1402: 
02:000019D0 41F81A6D        	  1403:     LEA     sr_msg,A0
02:000019D4 4EB81312        	  1404:     JSR     UART_WriteString
02:000019D8 3001            	  1405:     MOVE.W  D1,D0           ; SR
02:000019DA 4EB81530        	  1406:     JSR     PrintHexAddress
02:000019DE 4EB813B2        	  1407:     JSR     new_line
                            	  1408: 
02:000019E2 41F81A93        	  1409:     LEA     vector_msg,A0
02:000019E6 4EB81312        	  1410:     JSR     UART_WriteString
02:000019EA 3002            	  1411:     MOVE.W  D2,D0           ; Vector offset
02:000019EC 4EB81530        	  1412:     JSR     PrintHexAddress
02:000019F0 4EB813B2        	  1413:     JSR     new_line
                            	  1414: 
