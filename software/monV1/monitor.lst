                            	   473: ; ----------------------------------------------------------------------
                            	   474: ; Constantes
                            	   475: ; ----------------------------------------------------------------------
                            	   476: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   477: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   478:                               ; BAUD_DIV_L em $70000
                            	   479:                               ; BAUD_DIV_U em $70001
                            	   480: 
                            	   481: ; ----------------------------------------------------------------------
                            	   482: ; Rotina: Calcula e armazena divisor de baud rate
                            	   483: ; Entrada:
                            	   484: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   485: ; Saída:
                            	   486: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   487: ; Formulas:
                            	   488: ;
                            	   489: ;
                            	   490: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   491: ; ----------------------------------------------------------------------
                            	   492: 
                            	   493: CALCBAUDDIV:
                            	   494: ;[ Registrador D0 (32 bits) ]
                            	   495: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   496: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   497:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   498:         ;((F_CPU/16)/10)
                            	   499:         ;F_CPU = 16000000 ou 0xF42400
02:00001326 203C00F42400    	   500:         MOVE.L  #F_CPU,D0
02:0000132C 323C0010        	   501:         MOVE.W  #16,D1         ; Divisor
02:00001330 61000096        	   502:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   503: ;1
02:00001334 2F00            	   504:         move.l  d0,-(SP)
02:00001336 4EB81530        	   505:         jsr     PrintHexAddress
02:0000133A 4EB813B2        	   506:         jsr     new_line
02:0000133E 201F            	   507:         move.l  (SP)+,d0
                            	   508: 
02:00001340 323C000A        	   509:         MOVE.W  #10,D1         ; Divisor
02:00001344 61000082        	   510:         BSR     Div32x16       ; D0 = 0x186A0
                            	   511: ;2
02:00001348 2F00            	   512:         move.l  d0,-(SP)
02:0000134A 4EB81530        	   513:         jsr     PrintHexAddress
02:0000134E 4EB813B2        	   514:         jsr     new_line
02:00001352 201F            	   515:         move.l  (SP)+,d0
                            	   516: 
                            	   517:         ;(BAUD/10)
02:00001354 2F00            	   518:         move.l  d0,-(SP)
                            	   519: ;3
02:00001356 7000            	   520:         CLR.L   D0
02:00001358 303900080014    	   521:         MOVE.W  CurrentBaudRate,D0
02:0000135E 2F00            	   522:         move.l  d0,-(SP)
02:00001360 4EB81530        	   523:         jsr     PrintHexAddress
02:00001364 4EB813B2        	   524:         jsr     new_line
02:00001368 201F            	   525:         move.l  (SP)+,d0
                            	   526: 
02:0000136A 123C000A        	   527:         MOVE.B  #10,D1
02:0000136E 6158            	   528:         BSR     Div32x16
                            	   529: 
                            	   530: ;4
02:00001370 2F00            	   531:         move.l  d0,-(SP)
02:00001372 4EB81530        	   532:         jsr     PrintHexAddress
02:00001376 4EB813B2        	   533:         jsr     new_line
02:0000137A 221F            	   534:         move.l  (SP)+,D1
02:0000137C 201F            	   535:         move.l  (SP)+,D0
                            	   536: 
                            	   537: 
                            	   538:         ;(F_CPU/BAUD)
02:0000137E 6148            	   539:         BSR     Div32x16
                            	   540: ;5
02:00001380 2F00            	   541:         move.l  d0,-(SP)
02:00001382 4EB81530        	   542:         jsr     PrintHexAddress
02:00001386 4EB813B2        	   543:         jsr     new_line
02:0000138A 201F            	   544:         move.l  (SP)+,d0
                            	   545: 
                            	   546:         ; 4. Separa parte alta/baixa corretamente
02:0000138C 3200            	   547:         MOVE.W  D0,D1
02:0000138E 024000FF        	   548:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:00001392 E049            	   549:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:00001394 024100FF        	   550:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   551: 
                            	   552:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:00001398 41F90008001A    	   553:         LEA     Baud1DivL,A0
02:0000139E 3080            	   554:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:000013A0 41F90008001C    	   555:         LEA     Baud1DivH,A0
02:000013A6 3081            	   556:         MOVE.W  D1,(A0)
                            	   557: 
02:000013A8 6000FD18        	   558:         BRA     MenuLoop
02:000013AC 4E75            	   559:         RTS
                            	   560: .BaudError:
02:000013AE 6000FC50        	   561:         BRA     _start
                            	   562: 
                            	   563: new_line:
02:000013B2 2F00            	   564:         MOVE.L  D0,-(SP)          ; Salva D0
02:000013B4 103C000A        	   565:         MOVE.B  #10,D0
02:000013B8 4EB812C2        	   566:         JSR     UART_WriteChar
02:000013BC 103C000D        	   567:         MOVE.B  #13,D0
02:000013C0 4EB812C2        	   568:         JSR     UART_WriteChar
02:000013C4 201F            	   569:         MOVE.L  (SP)+,D0          ; Restaura D0
02:000013C6 4E75            	   570:         RTS
                            	   571: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   572: ; Retorna D0 = Quociente, D1 = Resto
                            	   573: Div32x16:
02:000013C8 7400            	   574:         MOVEQ   #0,D2       ; D2 = Quociente
02:000013CA 761F            	   575:         MOVEQ   #31,D3      ; 32 iterações
                            	   576: DivLoop:
02:000013CC E388            	   577:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:000013CE E392            	   578:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:000013D0 B441            	   579:         CMP.W   D1,D2       ; D2 >= D1?
02:000013D2 6D04            	   580:         BLT     .skip
02:000013D4 9441            	   581:         SUB.W   D1,D2       ; Sim, subtrai
02:000013D6 5280            	   582:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   583: .skip:
02:000013D8 51CBFFF2        	   584:         DBRA    D3,DivLoop  ; Repete
02:000013DC 2202            	   585:         MOVE.L  D2,D1       ; Resto em D1
02:000013DE 4E75            	   586:         RTS
                            	   587: ; Versão compacta sem stack frame
                            	   588: PrintHexFast:
02:000013E0 2F02            	   589:         MOVE.L  D2,-(SP)          ; Salva D2
02:000013E2 2F00            	   590:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:000013E4 7407            	   591:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   592: 
                            	   593: .Loop:
02:000013E6 2017            	   594:         MOVE.L  (SP),D0           ; Recupera valor original
02:000013E8 E998            	   595:         ROL.L   #4,D0             ; Pega próximo nibble
02:000013EA 2E80            	   596:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:000013EC 0200000F        	   597:         ANDI.B  #$F,D0            ; Isola nibble
                            	   598: 
02:000013F0 B03C0009        	   599:         CMP.B   #9,D0
02:000013F4 6302            	   600:         BLS     .Digit
02:000013F6 5E00            	   601:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   602: .Digit:
02:000013F8 D03C0030        	   603:         ADD.B   #'0',D0           ; Converte para ASCII
02:000013FC 4EB812C2        	   604:         JSR     UART_WriteChar    ; Envia caractere
                            	   605: 
02:00001400 51CAFFE4        	   606:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   607: 
02:00001404 588F            	   608:         ADDQ.L  #4,SP             ; Remove valor salvo
02:00001406 241F            	   609:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001408 4E75            	   610:         RTS
                            	   611: 
                            	   612: ; ----------------------------------------------------------------------
                            	   613: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   614: ; Entrada:
                            	   615: ;   D0.L = Valor a ser impresso (32 bits)
                            	   616: ;   D1.W = Número de dígitos (1-8)
                            	   617: ; ----------------------------------------------------------------------
                            	   618: PrintHexPRECISA_DE_REVISAO:
02:0000140A 4E56FFF8        	   619:         LINK    A6,#-8            ; Reserva espaço na pilha
02:0000140E 2F02            	   620:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001410 2D40FFFC        	   621:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:00001414 3D41FFFA        	   622:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   623: 
02:00001418 323C0008        	   624:         MOVE.W  #$0008,D1
                            	   625: 
                            	   626:         ; Ajusta para começar pelo dígito mais significativo
02:0000141C E549            	   627:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:0000141E 5941            	   628:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   629: 
                            	   630: .PrintLoop:
02:00001420 202EFFFC        	   631:         MOVE.L  -4(A6),D0         ; Recupera valor
02:00001424 3401            	   632:         MOVE.W  D1,D2             ; Posição do nibble
02:00001426 E5B8            	   633:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:00001428 02800000000F    	   634:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   635: 
                            	   636:         ; Converte para ASCII
02:0000142E B03C0009        	   637:         CMP.B   #9,D0
02:00001432 6302            	   638:         BLS     .Decimal
02:00001434 5E00            	   639:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   640: .Decimal:
02:00001436 D03C0030        	   641:         ADD.B   #'0',D0           ; Converte para caractere
                            	   642: 
                            	   643:         ; Imprime caractere
02:0000143A 4EB812C2        	   644:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   645: 
02:0000143E 5941            	   646:         SUBQ.W  #4,D1             ; Próximo nibble
02:00001440 6ADE            	   647:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   648: 
                            	   649:         ; Espaço final para separação
02:00001442 103C0020        	   650:         MOVE.B  #' ',D0
02:00001446 4EB812C2        	   651:         JSR     UART_WriteChar
                            	   652: 
02:0000144A 241F            	   653:         MOVE.L  (SP)+,D2          ; Restaura D2
02:0000144C 4E5E            	   654:         UNLK    A6                ; Restaura frame
02:0000144E 4E75            	   655:         RTS
                            	   656: 
                            	   657: ; ----------------------------------------------------------------------
                            	   658: ; MemDump - Imprime dump de memória formatado
                            	   659: ; Entrada:
                            	   660: ;   A0 = Endereço inicial (ex: $80000)
                            	   661: ;   D0 = Quantidade de bytes (ex: 256)
                            	   662: ; ----------------------------------------------------------------------
                            	   663: MEMDUMP:
02:00001450 41F90000000D    	   664:         LEA     DumpHeader,A0
02:00001456 4EB81312        	   665:         JSR     UART_WriteString
02:0000145A 207900080022    	   666:         MOVE.L  (addressInHex),A0
02:00001460 2008            	   667:         MOVE.L  A0,D0
02:00001462 4EB81530        	   668:         JSR     PrintHexAddress
02:00001466 4EB813B2        	   669:         JSR     new_line
                            	   670: 
02:0000146A 41F900000020    	   671:         LEA     DumpHeader1,A0
02:00001470 4EB81312        	   672:         JSR     UART_WriteString
                            	   673: 
02:00001474 207900080022    	   674:         MOVE.L  (addressInHex),A0
                            	   675:         ; Calcula endereço final
                            	   676: 
                            	   677: DUMPLOOPMASTER:
02:0000147A 7200            	   678:         CLR.L   D1
02:0000147C 2208            	   679:         MOVE.L  A0,D1
02:0000147E 0681000000FF    	   680:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   681:         ;MOVE.L  D1,D0
                            	   682:         ;JSR     PrintHexAddress
                            	   683:         ;JSR     new_line
                            	   684: 
                            	   685:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   686:         ;JSR     UART_ReadChar
                            	   687: 
                            	   688: 
                            	   689: DumpLoop:
                            	   690:         ; Nova linha a cada 16 bytes
02:00001484 2008            	   691:         MOVE.L  A0,D0
02:00001486 02800000000F    	   692:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
02:0000148C 6616            	   693:         BNE     NoNewLine
                            	   694: 
                            	   695:         ; Imprime endereço
02:0000148E 2008            	   696:         MOVE.L  A0,D0
02:00001490 4EB81530        	   697:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   698: 
02:00001494 103C003A        	   699:         MOVE.B  #':',D0
02:00001498 4EB812C2        	   700:         JSR     UART_WriteChar
02:0000149C 103C0020        	   701:         MOVE.B  #' ',D0
02:000014A0 4EB812C2        	   702:         JSR     UART_WriteChar
                            	   703: 
                            	   704: NoNewLine:
                            	   705:         ; Imprime byte em hex
02:000014A4 1018            	   706:         MOVE.B  (A0)+,D0
02:000014A6 4EB81540        	   707:         JSR     PrintByteHex
                            	   708: 
02:000014AA 103C0020        	   709:         MOVE.B  #' ',D0
02:000014AE 4EB812C2        	   710:         JSR     UART_WriteChar
                            	   711: 
                            	   712:         ; Verifica fim da linha (16 bytes)
02:000014B2 2008            	   713:         MOVE.L  A0,D0
