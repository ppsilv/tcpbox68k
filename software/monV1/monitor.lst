                            	  1467: UART_ReadCharNonEchoTimeout:
02:00001A3A 2F08            	  1468:         MOVE.L  A0,-(SP)        ; Preserva A0
02:00001A3C 2F01            	  1469:         MOVE.L  D1,-(SP)        ; Preserva A0
02:00001A3E 223C00002710    	  1470:         MOVE.L  #10000,D1
02:00001A44 207900080010    	  1471:         MOVE.L  CurrentUART,A0
                            	  1472: .WaitRx:
02:00001A4A 4A81            	  1473:         CMP.L   #0,D1
02:00001A4C 5341            	  1474:         SUB     #1,D1
02:00001A4E 6710            	  1475:         BEQ     .Fim
02:00001A50 08280000000A    	  1476:         BTST    #0,LSR(A0)        ; RX ready?
02:00001A56 67F2            	  1477:         BEQ     .WaitRx
                            	  1478: 
02:00001A58 1010            	  1479:         MOVE.B  RHR(A0),D0
02:00001A5A 221F            	  1480:         MOVE.L  (SP)+,D1        ;Restaura A0
02:00001A5C 205F            	  1481:         MOVE.L  (SP)+,A0        ;Restaura A0
02:00001A5E 4E75            	  1482:         RTS
                            	  1483: .Fim:
02:00001A60 221F            	  1484:         MOVE.L  (SP)+,D1        ;Restaura A0
02:00001A62 205F            	  1485:         MOVE.L  (SP)+,A0        ;Restaura A0
02:00001A64 4CDF7FFC        	  1486:         MOVEM.L (SP)+,D2-D7/A0-A6
02:00001A68 6000F660        	  1487:         BRA     MenuLoop
                            	  1488: ; ========================================================
                            	  1489: ; Validador de Checksum para ROM (MC68000)
                            	  1490: ; Assume:
                            	  1491: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1492: ;   - Big-endian (padrão 68000)
                            	  1493: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1494: ; ========================================================
                            	  1495: 
                            	  1496: VALIDATE_ROM:
02:00001A6C 91C8            	  1497:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001A6E 203C00003FFC    	  1498:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:00001A74 7200            	  1499:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1500: 
                            	  1501:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1502: .CHECKSUM_LOOP:
02:00001A76 2418            	  1503:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001A78 D282            	  1504:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001A7A 5980            	  1505:         SUB.L   #4,D0               ; Decrementa contador
02:00001A7C 6EF8            	  1506:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1507: 
02:00001A7E 41F900080540    	  1508:         LEA     checksum_calc,A0
02:00001A84 20C1            	  1509:         MOVE.L  D1,(A0)+
                            	  1510:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1511: 
                            	  1512:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001A86 24383FFC        	  1513:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:00001A8A B481            	  1514:         CMP.L   D1,D2               ; Combina com o calculado?
02:00001A8C 6706            	  1515:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1516: 
                            	  1517:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:00001A8E 363CDEAD        	  1518:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:00001A92 6002            	  1519:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1520: .CHECKSUM_OK:
02:00001A94 4E75            	  1521:         RTS                         ; Retorna (ROM válida)
                            	  1522: 
                            	  1523: 
                            	  1524: SYSTEM_HALT:
02:00001A96 46FC2700        	  1525:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1526: .INFINITE_LOOP:
02:00001A9A 60FE            	  1527:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1528: 
                            	  1529: 
                            	  1530: 
                            	  1531: ; --- Constantes ---
                            	  1532: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1533: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1534: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1535: 
