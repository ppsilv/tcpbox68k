02:000019A6 457863657074696F	  1414: debug_msg:      DC.B "Exception - PC: ",0
02:000019AE 6E202D2050433A20
02:000019B6 00
02:000019B7 5374617475732052	  1415: sr_msg:         DC.B "Status Reg: ",0
02:000019BF 65673A20
02:000019C3 00
