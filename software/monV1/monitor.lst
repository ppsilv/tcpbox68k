                            	    79:             SECTION .text
                            	    80:             ORG $00001000
                            	    81: 
                            	    82: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    83: USER_SP     EQU     $0009F000
                            	    84: ;Clock frequency in Hz
                            	    85: F_CPU       equ 16000000
                            	    86: RAMBASE     equ $80000
                            	    87: ;Uart register offsets
                            	    88: RHR         equ     0   ; receive holding register (read)
                            	    89: THR         equ     0   ; transmit holding register (write)
                            	    90: IER         equ     2   ; interrupt enable register
                            	    91: ISR         equ     4   ; interrupt status register (read)
                            	    92: FCR         equ     4   ; FIFO control register (write)
                            	    93: LCR         equ     6   ; line control register
                            	    94: MCR         equ     8   ; modem control register
                            	    95: LSR         equ     10  ; line status register
                            	    96: MSR         equ     12  ; modem status register
                            	    97: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	    98: DLL         equ     0   ; divisor latch LSB
                            	    99: DLM         equ     2   ; divisor latch MSB
                            	   100: ; aliases for register names (used by different manufacturers)cd ..
                            	   101: RBR         equ     RHR ; receive buffer register
                            	   102: IIR         equ     ISR ; interrupt identification register
                            	   103: SCR         equ     SPR ; scratch register
                            	   104: 
                            	   105: LED_ADDRESS equ     $4400
                            	   106: UART_BASE   equ     $4000
                            	   107: TIMER_BASE  equ     $4600
                            	   108: BAUD_RATE   equ     9600
                            	   109: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	   110: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	   111: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	   112: 
                            	   113: ;=== Uart receiver ================= CONSTANTES =================
                            	   114: SOH         EQU     $01        ; Start Of Header
                            	   115: EOT         EQU     $04        ; End Of Transmission
                            	   116: ACK         EQU     $06        ; Acknowledge
                            	   117: NAK         EQU     $15        ; Negative Acknowledge
                            	   118: CAN         EQU     $18        ; Cancel
                            	   119: 
                            	   120: ; --- Macro para Setar Flag ---
                            	   121: SET_FLAG   MACRO
                            	   122:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   123:     ENDM
                            	   124: ; --- Macro para Setar Flag ---
                            	   125: CLR_FLAG   MACRO
                            	   126:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   127:     ENDM
                            	   128: ; --- Macro TEST_FLAG corrigida ---
                            	   129: TEST_FLAG  MACRO
                            	   130:     BTST    #\1,minhas_flags
                            	   131:     ENDM
                            	   132: ; --- Macro para testar flag (com salto se setado) ---
                            	   133: TST_FLAG_SET MACRO
                            	   134:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	   135:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	   136:     ENDM
                            	   137: 
