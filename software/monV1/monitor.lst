                            	   293: ; ******************************************************************
                            	   294: ; * timer_init - Inicializa o timer 8253                           *
                            	   295: ; * Configura canal 0: modo 3, 16-bit, binary                      *
                            	   296: ; * Entrada: Nenhuma                                               *
                            	   297: ; * Saída: Nenhuma                                                 *
                            	   298: ; * Destrói: D0                                                    *
                            	   299: ; ******************************************************************
                            	   300: 
                            	   301: ;------------------------------------------------------------------
                            	   302: ; Função: get_value
                            	   303: ; Entrada: D0 - índice (1 a 8)
                            	   304: ; Saída: D0 - valor correspondente do array
                            	   305: ; Preserva: Todos os registradores exceto D0
                            	   306: ;------------------------------------------------------------------
                            	   307: valores:
02:00001198 0060            	   308:     dc.w    $0060, $0030, $0018, $0010, $0008, $0004, $0002, $0001
02:0000119A 0030
02:0000119C 0018
02:0000119E 0010
02:000011A0 0008
02:000011A2 0004
02:000011A4 0002
02:000011A6 0001
                            	   309: UART_Get_Value:
02:000011A8 B03C0001        	   310:     cmp.b   #1,D0           ; Verifica se índice >= 1
02:000011AC 6D10            	   311:     blt.s   .invalid_index
02:000011AE B03C0008        	   312:     cmp.b   #8,D0           ; Verifica se índice <= 8
02:000011B2 6E0A            	   313:     bgt.s   .invalid_index
                            	   314: 
02:000011B4 5300            	   315:     subq.b  #1,D0           ; Converte índice de 1-8 para 0-7
02:000011B6 D000            	   316:     add.b   D0,D0           ; Multiplica por 2 (cada elemento é word)
02:000011B8 303B00DE        	   317:     move.w  valores(pc,D0.w),D0  ; Pega o valor do array
02:000011BC 4E75            	   318:     rts
                            	   319: 
                            	   320: .invalid_index:
02:000011BE 7000            	   321:     moveq   #0,D0           ; Retorna 0 para índice inválido
02:000011C0 4E75            	   322:     rts
                            	   323: 
                            	   324: ; Exemplo de uso:
                            	   325: ;   moveq   #3,D0           ; Pega o terceiro valor
                            	   326: ;   bsr     get_value       ; D0 agora contém $0018
                            	   327: 
                            	   328: 
                            	   329: 
                            	   330: ; Array de ponteiros para rotinas (endereços de 32 bits)
                            	   331: tabela_rotinas:
02:000011C2 000011EA        	   332:     dc.l    rotina1, rotina2, rotina3
02:000011C6 000011EE
02:000011CA 000011F2
                            	   333: 
                            	   334: ; Função que chama uma rotina baseada no índice em D0
                            	   335: chamar_rotina:
02:000011CE B03C0001        	   336:     cmp.b   #1,D0           ; Verifica se índice >= 1
02:000011D2 6D12            	   337:     blt.s   indice_invalido
02:000011D4 B03C0008        	   338:     cmp.b   #8,D0           ; Verifica se índice <= 8
02:000011D8 6E0C            	   339:     bgt.s   indice_invalido
                            	   340: 
02:000011DA 5300            	   341:     subq.b  #1,D0           ; Converte índice de 1-8 para 0-7
