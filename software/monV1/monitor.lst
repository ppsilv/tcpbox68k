                            	   500: ; ----------------------------------------------------------------------
                            	   501: ; Constantes
                            	   502: ; ----------------------------------------------------------------------
                            	   503: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   504: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   505:                               ; BAUD_DIV_L em $70000
                            	   506:                               ; BAUD_DIV_U em $70001
                            	   507: 
                            	   508: ; ----------------------------------------------------------------------
                            	   509: ; Rotina: Calcula e armazena divisor de baud rate
                            	   510: ; Entrada:
                            	   511: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   512: ; Saída:
                            	   513: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   514: ; Formulas:
                            	   515: ;
                            	   516: ;
                            	   517: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   518: ; ----------------------------------------------------------------------
                            	   519: 
                            	   520: CALCBAUDDIV:
                            	   521: ;[ Registrador D0 (32 bits) ]
                            	   522: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   523: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   524:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   525:         ;((F_CPU/16)/10)
                            	   526:         ;F_CPU = 16000000 ou 0xF42400
02:0000131C 203C00F42400    	   527:         MOVE.L  #F_CPU,D0
02:00001322 323C0010        	   528:         MOVE.W  #16,D1         ; Divisor
02:00001326 61000096        	   529:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   530: ;1
02:0000132A 2F00            	   531:         move.l  d0,-(SP)
02:0000132C 4EB81526        	   532:         jsr     PrintHexAddress
02:00001330 4EB813A8        	   533:         jsr     new_line
02:00001334 201F            	   534:         move.l  (SP)+,d0
                            	   535: 
02:00001336 323C000A        	   536:         MOVE.W  #10,D1         ; Divisor
02:0000133A 61000082        	   537:         BSR     Div32x16       ; D0 = 0x186A0
                            	   538: ;2
02:0000133E 2F00            	   539:         move.l  d0,-(SP)
02:00001340 4EB81526        	   540:         jsr     PrintHexAddress
02:00001344 4EB813A8        	   541:         jsr     new_line
02:00001348 201F            	   542:         move.l  (SP)+,d0
                            	   543: 
                            	   544:         ;(BAUD/10)
02:0000134A 2F00            	   545:         move.l  d0,-(SP)
                            	   546: ;3
02:0000134C 7000            	   547:         CLR.L   D0
02:0000134E 303900080014    	   548:         MOVE.W  CurrentBaudRate,D0
02:00001354 2F00            	   549:         move.l  d0,-(SP)
02:00001356 4EB81526        	   550:         jsr     PrintHexAddress
02:0000135A 4EB813A8        	   551:         jsr     new_line
02:0000135E 201F            	   552:         move.l  (SP)+,d0
                            	   553: 
02:00001360 123C000A        	   554:         MOVE.B  #10,D1
02:00001364 6158            	   555:         BSR     Div32x16
                            	   556: 
                            	   557: ;4
02:00001366 2F00            	   558:         move.l  d0,-(SP)
02:00001368 4EB81526        	   559:         jsr     PrintHexAddress
02:0000136C 4EB813A8        	   560:         jsr     new_line
02:00001370 221F            	   561:         move.l  (SP)+,D1
02:00001372 201F            	   562:         move.l  (SP)+,D0
                            	   563: 
                            	   564: 
                            	   565:         ;(F_CPU/BAUD)
02:00001374 6148            	   566:         BSR     Div32x16
                            	   567: ;5
02:00001376 2F00            	   568:         move.l  d0,-(SP)
02:00001378 4EB81526        	   569:         jsr     PrintHexAddress
02:0000137C 4EB813A8        	   570:         jsr     new_line
02:00001380 201F            	   571:         move.l  (SP)+,d0
                            	   572: 
                            	   573:         ; 4. Separa parte alta/baixa corretamente
02:00001382 3200            	   574:         MOVE.W  D0,D1
02:00001384 024000FF        	   575:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:00001388 E049            	   576:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:0000138A 024100FF        	   577:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   578: 
                            	   579:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:0000138E 41F90008001A    	   580:         LEA     Baud1DivL,A0
02:00001394 3080            	   581:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:00001396 41F90008001C    	   582:         LEA     Baud1DivH,A0
02:0000139C 3081            	   583:         MOVE.W  D1,(A0)
                            	   584: 
02:0000139E 6000FD26        	   585:         BRA     MenuLoop
02:000013A2 4E75            	   586:         RTS
                            	   587: .BaudError:
02:000013A4 6000FC5A        	   588:         BRA     _start
                            	   589: 
                            	   590: new_line:
02:000013A8 2F00            	   591:         MOVE.L  D0,-(SP)          ; Salva D0
02:000013AA 103C000A        	   592:         MOVE.B  #10,D0
02:000013AE 4EB812B8        	   593:         JSR     UART_WriteChar
02:000013B2 103C000D        	   594:         MOVE.B  #13,D0
02:000013B6 4EB812B8        	   595:         JSR     UART_WriteChar
02:000013BA 201F            	   596:         MOVE.L  (SP)+,D0          ; Restaura D0
02:000013BC 4E75            	   597:         RTS
                            	   598: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   599: ; Retorna D0 = Quociente, D1 = Resto
                            	   600: Div32x16:
02:000013BE 7400            	   601:         MOVEQ   #0,D2       ; D2 = Quociente
02:000013C0 761F            	   602:         MOVEQ   #31,D3      ; 32 iterações
                            	   603: DivLoop:
02:000013C2 E388            	   604:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:000013C4 E392            	   605:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:000013C6 B441            	   606:         CMP.W   D1,D2       ; D2 >= D1?
02:000013C8 6D04            	   607:         BLT     .skip
02:000013CA 9441            	   608:         SUB.W   D1,D2       ; Sim, subtrai
02:000013CC 5280            	   609:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   610: .skip:
02:000013CE 51CBFFF2        	   611:         DBRA    D3,DivLoop  ; Repete
02:000013D2 2202            	   612:         MOVE.L  D2,D1       ; Resto em D1
02:000013D4 4E75            	   613:         RTS
                            	   614: ; Versão compacta sem stack frame
                            	   615: PrintHexFast:
02:000013D6 2F02            	   616:         MOVE.L  D2,-(SP)          ; Salva D2
02:000013D8 2F00            	   617:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:000013DA 7407            	   618:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   619: 
                            	   620: .Loop:
02:000013DC 2017            	   621:         MOVE.L  (SP),D0           ; Recupera valor original
02:000013DE E998            	   622:         ROL.L   #4,D0             ; Pega próximo nibble
02:000013E0 2E80            	   623:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:000013E2 0200000F        	   624:         ANDI.B  #$F,D0            ; Isola nibble
                            	   625: 
02:000013E6 B03C0009        	   626:         CMP.B   #9,D0
02:000013EA 6302            	   627:         BLS     .Digit
02:000013EC 5E00            	   628:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   629: .Digit:
02:000013EE D03C0030        	   630:         ADD.B   #'0',D0           ; Converte para ASCII
02:000013F2 4EB812B8        	   631:         JSR     UART_WriteChar    ; Envia caractere
                            	   632: 
02:000013F6 51CAFFE4        	   633:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   634: 
02:000013FA 588F            	   635:         ADDQ.L  #4,SP             ; Remove valor salvo
02:000013FC 241F            	   636:         MOVE.L  (SP)+,D2          ; Restaura D2
02:000013FE 4E75            	   637:         RTS
                            	   638: 
                            	   639: ; ----------------------------------------------------------------------
                            	   640: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   641: ; Entrada:
                            	   642: ;   D0.L = Valor a ser impresso (32 bits)
                            	   643: ;   D1.W = Número de dígitos (1-8)
                            	   644: ; ----------------------------------------------------------------------
                            	   645: PrintHexPRECISA_DE_REVISAO:
02:00001400 4E56FFF8        	   646:         LINK    A6,#-8            ; Reserva espaço na pilha
02:00001404 2F02            	   647:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001406 2D40FFFC        	   648:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:0000140A 3D41FFFA        	   649:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   650: 
02:0000140E 323C0008        	   651:         MOVE.W  #$0008,D1
                            	   652: 
                            	   653:         ; Ajusta para começar pelo dígito mais significativo
02:00001412 E549            	   654:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:00001414 5941            	   655:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   656: 
                            	   657: .PrintLoop:
02:00001416 202EFFFC        	   658:         MOVE.L  -4(A6),D0         ; Recupera valor
02:0000141A 3401            	   659:         MOVE.W  D1,D2             ; Posição do nibble
02:0000141C E5B8            	   660:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:0000141E 02800000000F    	   661:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   662: 
                            	   663:         ; Converte para ASCII
02:00001424 B03C0009        	   664:         CMP.B   #9,D0
02:00001428 6302            	   665:         BLS     .Decimal
02:0000142A 5E00            	   666:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   667: .Decimal:
02:0000142C D03C0030        	   668:         ADD.B   #'0',D0           ; Converte para caractere
                            	   669: 
                            	   670:         ; Imprime caractere
02:00001430 4EB812B8        	   671:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   672: 
02:00001434 5941            	   673:         SUBQ.W  #4,D1             ; Próximo nibble
02:00001436 6ADE            	   674:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   675: 
                            	   676:         ; Espaço final para separação
02:00001438 103C0020        	   677:         MOVE.B  #' ',D0
02:0000143C 4EB812B8        	   678:         JSR     UART_WriteChar
                            	   679: 
02:00001440 241F            	   680:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001442 4E5E            	   681:         UNLK    A6                ; Restaura frame
02:00001444 4E75            	   682:         RTS
                            	   683: 
                            	   684: ; ----------------------------------------------------------------------
                            	   685: ; MemDump - Imprime dump de memória formatado
                            	   686: ; Entrada:
                            	   687: ;   A0 = Endereço inicial (ex: $80000)
                            	   688: ;   D0 = Quantidade de bytes (ex: 256)
                            	   689: ; ----------------------------------------------------------------------
                            	   690: MEMDUMP:
02:00001446 41F90000000D    	   691:         LEA     DumpHeader,A0
02:0000144C 4EB81308        	   692:         JSR     UART_WriteString
02:00001450 207900080022    	   693:         MOVE.L  (addressInHex),A0
02:00001456 2008            	   694:         MOVE.L  A0,D0
02:00001458 4EB81526        	   695:         JSR     PrintHexAddress
02:0000145C 4EB813A8        	   696:         JSR     new_line
                            	   697: 
02:00001460 41F900000020    	   698:         LEA     DumpHeader1,A0
02:00001466 4EB81308        	   699:         JSR     UART_WriteString
                            	   700: 
02:0000146A 207900080022    	   701:         MOVE.L  (addressInHex),A0
                            	   702:         ; Calcula endereço final
                            	   703: 
                            	   704: DUMPLOOPMASTER:
02:00001470 7200            	   705:         CLR.L   D1
02:00001472 2208            	   706:         MOVE.L  A0,D1
02:00001474 0681000000FF    	   707:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   708:         ;MOVE.L  D1,D0
                            	   709:         ;JSR     PrintHexAddress
