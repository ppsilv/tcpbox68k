                            	  1012: ;--------------------------------------------------
                            	  1013: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1014: ;--------------------------------------------------
                            	  1015: ; Exemplo: insere 'A' no buffer
                            	  1016: ;          MOVE.B  #'A',D0
                            	  1017: ;          JSR     UART_BufferPut
                            	  1018: 
                            	  1019: BufferPut:
01:0000171A 2F01            	  1020:         MOVE.L  D1,-(SP)
01:0000171C 2F08            	  1021:         MOVE.L  A0,-(SP)
                            	  1022: 
                            	  1023:         ;ANDI.W    #$FF00,D0
01:0000171E 41F900080030    	  1024:         LEA     BUFFER,A0
01:00001724 32390008002E    	  1025:         MOVE.W  BUFFER_COUNT,D1
                            	  1026: 
01:0000172A B27C0100        	  1027:         CMP.W   #256,D1
01:0000172E 6C1C            	  1028:         BGE     .BufferFull
                            	  1029: 
                            	  1030:         ; Modificado para usar deslocamento de 16 bits
01:00001730 323900080026    	  1031:         MOVE.W  BUFFER_HEAD,D1
01:00001736 D0C1            	  1032:         ADD     D1,A0
01:00001738 1080            	  1033:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1034: 
01:0000173A 5441            	  1035:         ADD     #2,D1              ; Incrementa como word
01:0000173C 024100FF        	  1036:         ANDI.W  #255,D1            ; Mantém no range 0-255
01:00001740 33C100080026    	  1037:         MOVE.W  D1,BUFFER_HEAD
                            	  1038: 
01:00001746 52790008002E    	  1039:         ADDQ.W  #1,BUFFER_COUNT
                            	  1040: 
                            	  1041: .BufferFull:
01:0000174C 205F            	  1042:         MOVE.L  (SP)+,A0
01:0000174E 221F            	  1043:         MOVE.L  (SP)+,D1
                            	  1044: 
01:00001750 4E75            	  1045:         RTS
                            	  1046: 
                            	  1047: ;--------------------------------------------------
                            	  1048: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1049: ;--------------------------------------------------
                            	  1050: ;Exemplo: Lendo byte do buffer
                            	  1051: ;         BSR     UART_BufferGet
                            	  1052: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1053: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1054: ;         Senão, D0 contém o byte lido!
                            	  1055: BufferGet:
01:00001752 2F01            	  1056:         MOVE.L  D1,-(SP)
01:00001754 2F08            	  1057:         MOVE.L  A0,-(SP)
                            	  1058: 
01:00001756 32390008002E    	  1059:         MOVE.W  BUFFER_COUNT,D1
01:0000175C 6724            	  1060:         BEQ     .BufferEmpty
                            	  1061: 
01:0000175E 41F900080030    	  1062:         LEA     BUFFER,A0
                            	  1063: 
                            	  1064:         ; Modificado para usar deslocamento de 16 bits
01:00001764 32390008002A    	  1065:         MOVE.W  BUFFER_TAIL,D1
01:0000176A 10301000        	  1066:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1067: 
01:0000176E 5401            	  1068:         ADDQ.B  #2,D1              ; Incrementa como word
01:00001770 024100FF        	  1069:         ANDI.W  #255,D1            ; Mantém no range 0-255
01:00001774 33C10008002A    	  1070:         MOVE.W  D1,BUFFER_TAIL
                            	  1071: 
01:0000177A 53790008002E    	  1072:         SUBQ.W  #1,BUFFER_COUNT
01:00001780 6006            	  1073:         BRA     .Exit
                            	  1074: 
                            	  1075: .BufferEmpty:
01:00001782 4EB8178E        	  1076:         JSR     FBufferEmpty
01:00001786 70FF            	  1077:         MOVEQ   #-1,D0
                            	  1078: .Exit:
01:00001788 205F            	  1079:         MOVE.L  (SP)+,A0
01:0000178A 221F            	  1080:         MOVE.L  (SP)+,D1
01:0000178C 4E75            	  1081:         RTS
                            	  1082: 
                            	  1083: FBufferEmpty:
