                            	   922: PrintNibble:
02:000015CC B03C0009        	   923:         CMP.B   #9,D0
02:000015D0 6302            	   924:         BLS     .Decimal
02:000015D2 5E00            	   925:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   926: .Decimal:
02:000015D4 D03C0030        	   927:         ADD.B   #'0',D0
02:000015D8 4EF81342        	   928:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   929: 
