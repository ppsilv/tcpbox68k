                            	  1090: ;--------------------------------------------------
                            	  1091: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1092: ;--------------------------------------------------
                            	  1093: ; Exemplo: insere 'A' no buffer
                            	  1094: ;          MOVE.B  #'A',D0
                            	  1095: ;          JSR     UART_BufferPut
                            	  1096: 
                            	  1097: BufferPut:
02:00001774 2F01            	  1098:         MOVE.L  D1,-(SP)
02:00001776 2F08            	  1099:         MOVE.L  A0,-(SP)
                            	  1100: 
                            	  1101:         ;ANDI.W    #$FF00,D0
02:00001778 41F900080030    	  1102:         LEA     BUFFER,A0
02:0000177E 32390008002E    	  1103:         MOVE.W  BUFFER_COUNT,D1
                            	  1104: 
02:00001784 B27C0100        	  1105:         CMP.W   #256,D1
02:00001788 6C1C            	  1106:         BGE     .BufferFull
