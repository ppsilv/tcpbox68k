                            	   887: ; ----------------------------------------------------------------------
                            	   888: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   889: ; Entrada: D0 = endereço
                            	   890: ; ----------------------------------------------------------------------
                            	   891: PrintHexAddress:
02:000015B0 4840            	   892:         SWAP    D0                ; Imprime parte alta primeiro
02:000015B2 4EB815B8        	   893:         JSR     PrintWordHex
02:000015B6 4840            	   894:         SWAP    D0                ; Parte baixa
                            	   895:         ; Continua para PrintWordHex
                            	   896: 
                            	   897: ; ----------------------------------------------------------------------
                            	   898: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   899: ; Entrada: D0.w = valor
                            	   900: ; ----------------------------------------------------------------------
                            	   901: PrintWordHex:
02:000015B8 E158            	   902:         ROL.W   #8,D0             ; Byte mais significativo primeiro
02:000015BA 4EB815C0        	   903:         JSR     PrintByteHex
02:000015BE E058            	   904:         ROR.W   #8,D0             ; Byte menos significativo
                            	   905:         ; Continua para PrintByteHex
                            	   906: 
                            	   907: ; ----------------------------------------------------------------------
                            	   908: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   909: ; Entrada: D0.b = valor
                            	   910: ; ----------------------------------------------------------------------
                            	   911: PrintByteHex:
02:000015C0 1F00            	   912:         MOVE.B  D0,-(SP)          ; Salva byte original
02:000015C2 E808            	   913:         LSR.B   #4,D0             ; Nibble alto
02:000015C4 6106            	   914:         BSR     PrintNibble
02:000015C6 101F            	   915:         MOVE.B  (SP)+,D0          ; Recupera byte
02:000015C8 0200000F        	   916:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   917:         ; Continua para PrintNibble
                            	   918: ; ----------------------------------------------------------------------
                            	   919: ; PrintNibble - Imprime um nibble em hex
                            	   920: ; Entrada: D0.b bits 3-0 = nibble (0-15)
