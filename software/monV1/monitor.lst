                            	   482: ; ----------------------------------------------------------------------
                            	   483: ; UART_WriteString - Envia string terminada em null para UART
                            	   484: ; Entrada:
                            	   485: ;   A0 = Ponteiro para a string (endereço da string)
                            	   486: ; ----------------------------------------------------------------------
                            	   487: UART_WriteString:
02:00001308 2F08            	   488:         MOVE.L  A0,-(SP)      ; Preserva D0
02:0000130A 2F00            	   489:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   490: .WriteLoop:
02:0000130C 1018            	   491:         MOVE.B  (A0)+,D0      ; Pega caractere
02:0000130E 6706            	   492:         BEQ     .Done
02:00001310 4EB812B8        	   493:         JSR     UART_WriteChar ; Use sua rotine existente
02:00001314 60F6            	   494:         BRA     .WriteLoop
                            	   495: .Done:
02:00001316 201F            	   496:         MOVE.L  (SP)+,D0
02:00001318 205F            	   497:         MOVE.L  (SP)+,A0
02:0000131A 4E75            	   498:         RTS
