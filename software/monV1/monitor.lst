02:00001CAE 4E73            	  1682:         RTE
                            	  1683: 
                            	  1684: ; --------------------------------
                            	  1685: ; Handler do TRAP #1
                            	  1686: ; Entrada:
                            	  1687: ;   D0.W - Número da função
                            	  1688: ;   D1.L - Parâmetro (para escrita)
                            	  1689: ; Saída:
                            	  1690: ;   D0.L - Resultado (para leitura)
                            	  1691: ; --------------------------------
                            	  1692: TRAP1_HANDLER:
02:00001CB0 B07C0001        	  1693:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001CB4 6714            	  1694:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001CB6 B07C0002        	  1695:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001CBA 671A            	  1696:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001CBC B07C0003        	  1697:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001CC0 6722            	  1698:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001CC2 4A40            	  1699:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001CC4 672C            	  1700:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001CC6 70FF            	  1701:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001CC8 4E73            	  1702:     RTE                   ; Retorna da exceção
                            	  1703: 
                            	  1704: 
                            	  1705: 
                            	  1706: ; --------------------------------
                            	  1707: ; TRAP_CCONIN - Ler caractere do console
                            	  1708: ; Saída: D0.L - Caractere lido
                            	  1709: ; --------------------------------
                            	  1710: trap_cconin:
02:00001CCA 4EB812F2        	  1711:     JSR         UART_ReadCharNonEcho
02:00001CCE 0280000000FF    	  1712:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001CD4 4E73            	  1713:     RTE                   ; Retorna da exceção
                            	  1714: 
                            	  1715: ; --------------------------------
                            	  1716: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1717: ; Entrada: D1.L - Caractere a escrever
                            	  1718: ; --------------------------------
                            	  1719: trap_cconout:
02:00001CD6 0281000000FF    	  1720:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001CDC 1001            	  1721:     MOVE.B      D1,D0
02:00001CDE 4EB812B8        	  1722:     JSR         UART_WriteChar
02:00001CE2 4E73            	  1723:     RTE                   ; Retorna da exceção
                            	  1724: 
                            	  1725: trap_strout:
02:00001CE4 1018            	  1726:     MOVE.B      (A0)+,D0
02:00001CE6 4A00            	  1727:     CMP.B       #0,D0
02:00001CE8 6706            	  1728:     BEQ         .fim
02:00001CEA 4EB812B8        	  1729:     JSR         UART_WriteChar
02:00001CEE 60F4            	  1730:     BRA         trap_strout
                            	  1731: .fim:
02:00001CF0 4E73            	  1732:     RTE
                            	  1733: 
                            	  1734: ; --------------------------------
                            	  1735: ; TRAP_PTERM0 - Terminar programa
                            	  1736: ; --------------------------------
                            	  1737: trap_pterm0:
02:00001CF2 303C0000        	  1738:     move.w  #0,d0         ; Código de saída 0
02:00001CF6 6102            	  1739:     bsr     hardware_exit ; Chama rotina de término
02:00001CF8 4E73            	  1740:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1741: 
                            	  1742: ; --------------------------------
                            	  1743: ; hardware_exit - Terminar execução
                            	  1744: ; Entrada: D0.W - Código de saída
                            	  1745: ; --------------------------------
                            	  1746: hardware_exit:
                            	  1747:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1748:     ; Exemplo: parar o processador
