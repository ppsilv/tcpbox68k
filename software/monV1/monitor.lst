                            	    82:             SECTION .text
                            	    83:             ORG $00001000
                            	    84: 
                            	    85: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    86: USER_SP     EQU     $0009F000
                            	    87: ;Clock frequency in Hz
                            	    88: F_CPU       equ 16000000
                            	    89: RAMBASE     equ $80000
                            	    90: ;Uart register offsets
                            	    91: RHR         equ     0   ; receive holding register (read)
                            	    92: THR         equ     0   ; transmit holding register (write)
                            	    93: IER         equ     2   ; interrupt enable register
                            	    94: ISR         equ     4   ; interrupt status register (read)
                            	    95: FCR         equ     4   ; FIFO control register (write)
                            	    96: LCR         equ     6   ; line control register
                            	    97: MCR         equ     8   ; modem control register
                            	    98: LSR         equ     10  ; line status register
                            	    99: MSR         equ     12  ; modem status register
                            	   100: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	   101: DLL         equ     0   ; divisor latch LSB
                            	   102: DLM         equ     2   ; divisor latch MSB
                            	   103: ; aliases for register names (used by different manufacturers)cd ..
                            	   104: RBR         equ     RHR ; receive buffer register
                            	   105: IIR         equ     ISR ; interrupt identification register
                            	   106: SCR         equ     SPR ; scratch register
                            	   107: 
                            	   108: LED_ADDRESS equ     $4400
                            	   109: UART_BASE   equ     $4000
                            	   110: TIMER_BASE  equ     $4600
                            	   111: BAUD_RATE   equ     9600
                            	   112: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	   113: BAUD_DIV_L  equ     $08 ;(BAUD_DIV&$FF)
                            	   114: BAUD_DIV_U  equ     $00 ;((BAUD_DIV>>8)&$FF)
                            	   115: 
                            	   116: ;14.745.600hz
                            	   117: ;9600   0060h
                            	   118: ;19.2K  0030h
                            	   119: ;38.4K  0018h
                            	   120: ;57.6K  0010h
                            	   121: ;115.2K 0008h
                            	   122: ;230.4K 0004h
                            	   123: ;460.8K 0002h
                            	   124: ;921.6K 0001h
                            	   125: 
                            	   126: ;=== Uart receiver ================= CONSTANTES =================
                            	   127: SOH         EQU     $01        ; Start Of Header
                            	   128: EOT         EQU     $04        ; End Of Transmission
                            	   129: ACK         EQU     $06        ; Acknowledge
                            	   130: NAK         EQU     $15        ; Negative Acknowledge
                            	   131: CAN         EQU     $18        ; Cancel
                            	   132: ;=== Timer ======================================================
                            	   133: ; Definições de constantes (ajuste conforme seu hardware)
                            	   134: TIMER_CTRL     equ     $4606       ; Endereço do registrador de controle
                            	   135: TIMER0_COUNT   equ     $4600       ; Endereço do contador do canal 0
                            	   136: 
                            	   137: ; Bits de controle do 8253
                            	   138: TIMER_SEL0     equ     $00         ; Select channel 0
                            	   139: TIMER_RW_BOTH  equ     $30         ; Read/Write LSB then MSB
                            	   140: TIMER_MODE3    equ     $06         ; Mode 3: Square wave generator
                            	   141: TIMER_BINARY   equ     $00         ; Binary counting
                            	   142: 
                            	   143: ; Valor de configuração
                            	   144: CONFIG_VALUE   equ     TIMER_SEL0|TIMER_RW_BOTH|TIMER_MODE3|TIMER_BINARY
                            	   145: 
                            	   146: ; Valor do contador para 10ms @ 1MHz
                            	   147: COUNT_VALUE    equ     2000        ; 2000 ticks (você especificou 2000)
                            	   148: ;=== Timer ======================================================
                            	   149: 
                            	   150: 
                            	   151: ; --- Macro para Setar Flag ---
                            	   152: SET_FLAG   MACRO
                            	   153:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   154:     ENDM
                            	   155: ; --- Macro para Setar Flag ---
                            	   156: CLR_FLAG   MACRO
                            	   157:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   158:     ENDM
                            	   159: ; --- Macro TEST_FLAG corrigida ---
                            	   160: TEST_FLAG  MACRO
                            	   161:     BTST    #\1,minhas_flags
                            	   162:     ENDM
                            	   163: ; --- Macro para testar flag (com salto se setado) ---
                            	   164: TST_FLAG_SET MACRO
                            	   165:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	   166:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	   167:     ENDM
                            	   168: 
