                            	   440:     ; Escreve caractere (D0.B)
                            	   441: UART_WriteChar:
02:000012B8 2F08            	   442:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012BA 2F00            	   443:         MOVE.L  D0,-(SP)        ; Preserva D0
02:000012BC 207900080010    	   444:         move.l   CurrentUART,A0
                            	   445: .WaitTx:
02:000012C2 08280005000A    	   446:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:000012C8 67F8            	   447:         BEQ     .WaitTx
02:000012CA 1080            	   448:         MOVE.B  D0,THR(A0)      ; transmit byte
02:000012CC 201F            	   449:         MOVE.L  (SP)+,D0        ;Restaura D0
02:000012CE 205F            	   450:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012D0 4E75            	   451:         RTS
                            	   452: 
                            	   453: 
                            	   454: ; Lê caractere (retorna em D0)
                            	   455: UART_ReadChar:
02:000012D2 2F08            	   456:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012D4 207900080010    	   457:         MOVE.L   CurrentUART,A0
                            	   458: .WaitRx:
02:000012DA 08280000000A    	   459:         BTST    #0,LSR(A0)        ; RX ready?
02:000012E0 67F8            	   460:         BEQ     .WaitRx
02:000012E2 1010            	   461:         MOVE.B  RHR(A0),D0
02:000012E4 205F            	   462:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012E6 B03C001B        	   463:         CMP.B   #$1b,D0
02:000012EA 6704            	   464:         BEQ     .fim
02:000012EC 4EB812B8        	   465:         JSR     UART_WriteChar
                            	   466: .fim
02:000012F0 4E75            	   467:         RTS
                            	   468: 
                            	   469: ; Lê caractere (retorna em D0)
                            	   470: UART_ReadCharNonEcho:
02:000012F2 2F08            	   471:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012F4 207900080010    	   472:         MOVE.L  CurrentUART,A0
                            	   473: .WaitRx:
02:000012FA 08280000000A    	   474:         BTST    #0,LSR(A0)        ; RX ready?
02:00001300 67F8            	   475:         BEQ     .WaitRx
                            	   476: 
02:00001302 1010            	   477:         MOVE.B  RHR(A0),D0
02:00001304 205F            	   478:         MOVE.L  (SP)+,A0        ;Restaura A0
