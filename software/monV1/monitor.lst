                            	  1655: 
                            	  1656: ; --------------------------------
                            	  1657: ; Handler do TRAP #1
                            	  1658: ; Entrada:
                            	  1659: ;   D0.W - Número da função
                            	  1660: ;   D1.L - Parâmetro (para escrita)
                            	  1661: ; Saída:
                            	  1662: ;   D0.L - Resultado (para leitura)
                            	  1663: ; --------------------------------
                            	  1664: TRAP1_HANDLER:
02:00001CAC B07C0001        	  1665:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001CB0 6714            	  1666:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001CB2 B07C0002        	  1667:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001CB6 671A            	  1668:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001CB8 B07C0003        	  1669:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001CBC 6722            	  1670:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001CBE 4A40            	  1671:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001CC0 672C            	  1672:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001CC2 70FF            	  1673:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001CC4 4E73            	  1674:     RTE                   ; Retorna da exceção
                            	  1675: 
                            	  1676: 
                            	  1677: 
                            	  1678: ; --------------------------------
                            	  1679: ; TRAP_CCONIN - Ler caractere do console
                            	  1680: ; Saída: D0.L - Caractere lido
                            	  1681: ; --------------------------------
                            	  1682: trap_cconin:
02:00001CC6 4EB812FC        	  1683:     JSR         UART_ReadCharNonEcho
02:00001CCA 0280000000FF    	  1684:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001CD0 4E73            	  1685:     RTE                   ; Retorna da exceção
                            	  1686: 
                            	  1687: ; --------------------------------
                            	  1688: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1689: ; Entrada: D1.L - Caractere a escrever
                            	  1690: ; --------------------------------
                            	  1691: trap_cconout:
02:00001CD2 0281000000FF    	  1692:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001CD8 1001            	  1693:     MOVE.B      D1,D0
02:00001CDA 4EB812C2        	  1694:     JSR         UART_WriteChar
02:00001CDE 4E73            	  1695:     RTE                   ; Retorna da exceção
                            	  1696: 
                            	  1697: trap_strout:
02:00001CE0 1018            	  1698:     MOVE.B      (A0)+,D0
02:00001CE2 4A00            	  1699:     CMP.B       #0,D0
02:00001CE4 6706            	  1700:     BEQ         .fim
02:00001CE6 4EB812C2        	  1701:     JSR         UART_WriteChar
02:00001CEA 60F4            	  1702:     BRA         trap_strout
                            	  1703: .fim:
02:00001CEC 4E73            	  1704:     RTE
                            	  1705: 
                            	  1706: ; --------------------------------
                            	  1707: ; TRAP_PTERM0 - Terminar programa
                            	  1708: ; --------------------------------
                            	  1709: trap_pterm0:
02:00001CEE 303C0000        	  1710:     move.w  #0,d0         ; Código de saída 0
02:00001CF2 6102            	  1711:     bsr     hardware_exit ; Chama rotina de término
02:00001CF4 4E73            	  1712:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1713: 
                            	  1714: ; --------------------------------
                            	  1715: ; hardware_exit - Terminar execução
                            	  1716: ; Entrada: D0.W - Código de saída
                            	  1717: ; --------------------------------
                            	  1718: hardware_exit:
                            	  1719:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1720:     ; Exemplo: parar o processador
                            	  1721:     ; stop    #$2700
                            	  1722: 
                            	  1723:     ; Exemplo simples: loop infinito
02:00001CF6 60FE            	  1724:     BRA     hardware_exit
02:00001CF8 4E75            	  1725:     RTS
                            	  1726: 
                            	  1727: 
                            	  1728:     ALIGN 2
