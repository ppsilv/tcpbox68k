                            	   735: PrintWordHex:
01:000014F2 E158            	   736:         ROL.W   #8,D0             ; Byte mais significativo primeiro
01:000014F4 4EB814FA        	   737:         JSR     PrintByteHex
01:000014F8 E058            	   738:         ROR.W   #8,D0             ; Byte menos significativo
                            	   739:         ; Continua para PrintByteHex
                            	   740: 
                            	   741: ; ----------------------------------------------------------------------
                            	   742: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   743: ; Entrada: D0.b = valor
                            	   744: ; ----------------------------------------------------------------------
                            	   745: PrintByteHex:
01:000014FA 1F00            	   746:         MOVE.B  D0,-(SP)          ; Salva byte original
01:000014FC E808            	   747:         LSR.B   #4,D0             ; Nibble alto
01:000014FE 6106            	   748:         BSR     PrintNibble
01:00001500 101F            	   749:         MOVE.B  (SP)+,D0          ; Recupera byte
01:00001502 0200000F        	   750:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   751:         ; Continua para PrintNibble
                            	   752: ; ----------------------------------------------------------------------
                            	   753: ; PrintNibble - Imprime um nibble em hex
                            	   754: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   755: ; ----------------------------------------------------------------------
                            	   756: PrintNibble:
01:00001506 B03C0009        	   757:         CMP.B   #9,D0
01:0000150A 6302            	   758:         BLS     .Decimal
01:0000150C 5E00            	   759:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   760: .Decimal:
01:0000150E D03C0030        	   761:         ADD.B   #'0',D0
01:00001512 4EF8127C        	   762:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   763: 
