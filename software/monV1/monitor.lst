                            	    81:             SECTION .text
                            	    82:             ORG $00001000
                            	    83: 
                            	    84: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    85: USER_SP     EQU     $0009F000
                            	    86: ;Clock frequency in Hz
                            	    87: F_CPU       equ 16000000
                            	    88: RAMBASE     equ $80000
                            	    89: ;Uart register offsets
                            	    90: RHR         equ     0   ; receive holding register (read)
                            	    91: THR         equ     0   ; transmit holding register (write)
                            	    92: IER         equ     2   ; interrupt enable register
                            	    93: ISR         equ     4   ; interrupt status register (read)
                            	    94: FCR         equ     4   ; FIFO control register (write)
                            	    95: LCR         equ     6   ; line control register
                            	    96: MCR         equ     8   ; modem control register
                            	    97: LSR         equ     10  ; line status register
                            	    98: MSR         equ     12  ; modem status register
                            	    99: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	   100: DLL         equ     0   ; divisor latch LSB
                            	   101: DLM         equ     2   ; divisor latch MSB
                            	   102: ; aliases for register names (used by different manufacturers)cd ..
                            	   103: RBR         equ     RHR ; receive buffer register
                            	   104: IIR         equ     ISR ; interrupt identification register
                            	   105: SCR         equ     SPR ; scratch register
                            	   106: 
                            	   107: LED_ADDRESS equ     $4400
                            	   108: UART_BASE   equ     $4000
                            	   109: TIMER_BASE  equ     $4600
                            	   110: BAUD_RATE   equ     9600
                            	   111: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	   112: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	   113: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	   114: 
                            	   115: ;=== Uart receiver ================= CONSTANTES =================
                            	   116: SOH         EQU     $01        ; Start Of Header
                            	   117: EOT         EQU     $04        ; End Of Transmission
                            	   118: ACK         EQU     $06        ; Acknowledge
                            	   119: NAK         EQU     $15        ; Negative Acknowledge
                            	   120: CAN         EQU     $18        ; Cancel
                            	   121: ;=== Timer ======================================================
                            	   122: ; Definições de constantes (ajuste conforme seu hardware)
                            	   123: TIMER_CTRL     equ     $4606       ; Endereço do registrador de controle
                            	   124: TIMER0_COUNT   equ     $4600       ; Endereço do contador do canal 0
                            	   125: 
                            	   126: ; Bits de controle do 8253
                            	   127: TIMER_SEL0     equ     $00         ; Select channel 0
                            	   128: TIMER_RW_BOTH  equ     $30         ; Read/Write LSB then MSB
                            	   129: TIMER_MODE3    equ     $06         ; Mode 3: Square wave generator
                            	   130: TIMER_BINARY   equ     $00         ; Binary counting
                            	   131: 
                            	   132: ; Valor de configuração
                            	   133: CONFIG_VALUE   equ     TIMER_SEL0|TIMER_RW_BOTH|TIMER_MODE3|TIMER_BINARY
                            	   134: 
                            	   135: ; Valor do contador para 10ms @ 1MHz
                            	   136: COUNT_VALUE    equ     2000        ; 2000 ticks (você especificou 2000)
                            	   137: ;=== Timer ======================================================
                            	   138: 
                            	   139: 
                            	   140: ; --- Macro para Setar Flag ---
                            	   141: SET_FLAG   MACRO
                            	   142:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   143:     ENDM
                            	   144: ; --- Macro para Setar Flag ---
                            	   145: CLR_FLAG   MACRO
                            	   146:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	   147:     ENDM
                            	   148: ; --- Macro TEST_FLAG corrigida ---
                            	   149: TEST_FLAG  MACRO
                            	   150:     BTST    #\1,minhas_flags
                            	   151:     ENDM
                            	   152: ; --- Macro para testar flag (com salto se setado) ---
                            	   153: TST_FLAG_SET MACRO
                            	   154:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	   155:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	   156:     ENDM
                            	   157: 
