                            	   503: ; ----------------------------------------------------------------------
                            	   504: ; Constantes
                            	   505: ; ----------------------------------------------------------------------
                            	   506: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   507: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   508:                               ; BAUD_DIV_L em $70000
                            	   509:                               ; BAUD_DIV_U em $70001
                            	   510: 
                            	   511: ; ----------------------------------------------------------------------
                            	   512: ; Rotina: Calcula e armazena divisor de baud rate
                            	   513: ; Entrada:
                            	   514: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   515: ; Saída:
                            	   516: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   517: ; Formulas:
                            	   518: ;
                            	   519: ;
                            	   520: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   521: ; ----------------------------------------------------------------------
                            	   522: 
                            	   523: CALCBAUDDIV:
                            	   524: ;[ Registrador D0 (32 bits) ]
                            	   525: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   526: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   527:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   528:         ;((F_CPU/16)/10)
                            	   529:         ;F_CPU = 16000000 ou 0xF42400
02:00001332 203C00F42400    	   530:         MOVE.L  #F_CPU,D0
02:00001338 323C0010        	   531:         MOVE.W  #16,D1         ; Divisor
02:0000133C 61000096        	   532:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   533: ;1
02:00001340 2F00            	   534:         move.l  d0,-(SP)
02:00001342 4EB8153C        	   535:         jsr     PrintHexAddress
02:00001346 4EB813BE        	   536:         jsr     new_line
02:0000134A 201F            	   537:         move.l  (SP)+,d0
                            	   538: 
02:0000134C 323C000A        	   539:         MOVE.W  #10,D1         ; Divisor
02:00001350 61000082        	   540:         BSR     Div32x16       ; D0 = 0x186A0
                            	   541: ;2
02:00001354 2F00            	   542:         move.l  d0,-(SP)
02:00001356 4EB8153C        	   543:         jsr     PrintHexAddress
02:0000135A 4EB813BE        	   544:         jsr     new_line
02:0000135E 201F            	   545:         move.l  (SP)+,d0
                            	   546: 
                            	   547:         ;(BAUD/10)
02:00001360 2F00            	   548:         move.l  d0,-(SP)
                            	   549: ;3
02:00001362 7000            	   550:         CLR.L   D0
02:00001364 303900080014    	   551:         MOVE.W  CurrentBaudRate,D0
02:0000136A 2F00            	   552:         move.l  d0,-(SP)
02:0000136C 4EB8153C        	   553:         jsr     PrintHexAddress
02:00001370 4EB813BE        	   554:         jsr     new_line
02:00001374 201F            	   555:         move.l  (SP)+,d0
                            	   556: 
02:00001376 123C000A        	   557:         MOVE.B  #10,D1
02:0000137A 6158            	   558:         BSR     Div32x16
                            	   559: 
                            	   560: ;4
02:0000137C 2F00            	   561:         move.l  d0,-(SP)
02:0000137E 4EB8153C        	   562:         jsr     PrintHexAddress
02:00001382 4EB813BE        	   563:         jsr     new_line
02:00001386 221F            	   564:         move.l  (SP)+,D1
02:00001388 201F            	   565:         move.l  (SP)+,D0
                            	   566: 
                            	   567: 
                            	   568:         ;(F_CPU/BAUD)
02:0000138A 6148            	   569:         BSR     Div32x16
                            	   570: ;5
02:0000138C 2F00            	   571:         move.l  d0,-(SP)
02:0000138E 4EB8153C        	   572:         jsr     PrintHexAddress
02:00001392 4EB813BE        	   573:         jsr     new_line
02:00001396 201F            	   574:         move.l  (SP)+,d0
                            	   575: 
                            	   576:         ; 4. Separa parte alta/baixa corretamente
02:00001398 3200            	   577:         MOVE.W  D0,D1
02:0000139A 024000FF        	   578:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:0000139E E049            	   579:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:000013A0 024100FF        	   580:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   581: 
                            	   582:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:000013A4 41F90008001A    	   583:         LEA     Baud1DivL,A0
02:000013AA 3080            	   584:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:000013AC 41F90008001C    	   585:         LEA     Baud1DivH,A0
02:000013B2 3081            	   586:         MOVE.W  D1,(A0)
                            	   587: 
02:000013B4 6000FD10        	   588:         BRA     MenuLoop
02:000013B8 4E75            	   589:         RTS
                            	   590: .BaudError:
02:000013BA 6000FC44        	   591:         BRA     _start
                            	   592: 
                            	   593: new_line:
02:000013BE 2F00            	   594:         MOVE.L  D0,-(SP)          ; Salva D0
02:000013C0 103C000A        	   595:         MOVE.B  #10,D0
02:000013C4 4EB812CE        	   596:         JSR     UART_WriteChar
02:000013C8 103C000D        	   597:         MOVE.B  #13,D0
02:000013CC 4EB812CE        	   598:         JSR     UART_WriteChar
02:000013D0 201F            	   599:         MOVE.L  (SP)+,D0          ; Restaura D0
02:000013D2 4E75            	   600:         RTS
                            	   601: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   602: ; Retorna D0 = Quociente, D1 = Resto
                            	   603: Div32x16:
02:000013D4 7400            	   604:         MOVEQ   #0,D2       ; D2 = Quociente
02:000013D6 761F            	   605:         MOVEQ   #31,D3      ; 32 iterações
                            	   606: DivLoop:
02:000013D8 E388            	   607:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:000013DA E392            	   608:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:000013DC B441            	   609:         CMP.W   D1,D2       ; D2 >= D1?
02:000013DE 6D04            	   610:         BLT     .skip
02:000013E0 9441            	   611:         SUB.W   D1,D2       ; Sim, subtrai
02:000013E2 5280            	   612:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   613: .skip:
02:000013E4 51CBFFF2        	   614:         DBRA    D3,DivLoop  ; Repete
02:000013E8 2202            	   615:         MOVE.L  D2,D1       ; Resto em D1
02:000013EA 4E75            	   616:         RTS
                            	   617: ; Versão compacta sem stack frame
                            	   618: PrintHexFast:
02:000013EC 2F02            	   619:         MOVE.L  D2,-(SP)          ; Salva D2
02:000013EE 2F00            	   620:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:000013F0 7407            	   621:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   622: 
                            	   623: .Loop:
02:000013F2 2017            	   624:         MOVE.L  (SP),D0           ; Recupera valor original
02:000013F4 E998            	   625:         ROL.L   #4,D0             ; Pega próximo nibble
02:000013F6 2E80            	   626:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:000013F8 0200000F        	   627:         ANDI.B  #$F,D0            ; Isola nibble
                            	   628: 
02:000013FC B03C0009        	   629:         CMP.B   #9,D0
02:00001400 6302            	   630:         BLS     .Digit
02:00001402 5E00            	   631:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   632: .Digit:
02:00001404 D03C0030        	   633:         ADD.B   #'0',D0           ; Converte para ASCII
02:00001408 4EB812CE        	   634:         JSR     UART_WriteChar    ; Envia caractere
                            	   635: 
02:0000140C 51CAFFE4        	   636:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   637: 
02:00001410 588F            	   638:         ADDQ.L  #4,SP             ; Remove valor salvo
02:00001412 241F            	   639:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001414 4E75            	   640:         RTS
                            	   641: 
                            	   642: ; ----------------------------------------------------------------------
                            	   643: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   644: ; Entrada:
                            	   645: ;   D0.L = Valor a ser impresso (32 bits)
                            	   646: ;   D1.W = Número de dígitos (1-8)
                            	   647: ; ----------------------------------------------------------------------
                            	   648: PrintHexPRECISA_DE_REVISAO:
02:00001416 4E56FFF8        	   649:         LINK    A6,#-8            ; Reserva espaço na pilha
02:0000141A 2F02            	   650:         MOVE.L  D2,-(SP)          ; Salva D2
02:0000141C 2D40FFFC        	   651:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:00001420 3D41FFFA        	   652:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   653: 
02:00001424 323C0008        	   654:         MOVE.W  #$0008,D1
                            	   655: 
                            	   656:         ; Ajusta para começar pelo dígito mais significativo
02:00001428 E549            	   657:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:0000142A 5941            	   658:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   659: 
                            	   660: .PrintLoop:
02:0000142C 202EFFFC        	   661:         MOVE.L  -4(A6),D0         ; Recupera valor
02:00001430 3401            	   662:         MOVE.W  D1,D2             ; Posição do nibble
02:00001432 E5B8            	   663:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:00001434 02800000000F    	   664:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   665: 
                            	   666:         ; Converte para ASCII
02:0000143A B03C0009        	   667:         CMP.B   #9,D0
02:0000143E 6302            	   668:         BLS     .Decimal
02:00001440 5E00            	   669:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   670: .Decimal:
02:00001442 D03C0030        	   671:         ADD.B   #'0',D0           ; Converte para caractere
                            	   672: 
                            	   673:         ; Imprime caractere
02:00001446 4EB812CE        	   674:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   675: 
02:0000144A 5941            	   676:         SUBQ.W  #4,D1             ; Próximo nibble
02:0000144C 6ADE            	   677:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   678: 
                            	   679:         ; Espaço final para separação
02:0000144E 103C0020        	   680:         MOVE.B  #' ',D0
02:00001452 4EB812CE        	   681:         JSR     UART_WriteChar
                            	   682: 
02:00001456 241F            	   683:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001458 4E5E            	   684:         UNLK    A6                ; Restaura frame
02:0000145A 4E75            	   685:         RTS
                            	   686: 
                            	   687: ; ----------------------------------------------------------------------
                            	   688: ; MemDump - Imprime dump de memória formatado
                            	   689: ; Entrada:
                            	   690: ;   A0 = Endereço inicial (ex: $80000)
                            	   691: ;   D0 = Quantidade de bytes (ex: 256)
                            	   692: ; ----------------------------------------------------------------------
                            	   693: MEMDUMP:
02:0000145C 41F90000000D    	   694:         LEA     DumpHeader,A0
02:00001462 4EB8131E        	   695:         JSR     UART_WriteString
02:00001466 207900080022    	   696:         MOVE.L  (addressInHex),A0
02:0000146C 2008            	   697:         MOVE.L  A0,D0
02:0000146E 4EB8153C        	   698:         JSR     PrintHexAddress
02:00001472 4EB813BE        	   699:         JSR     new_line
                            	   700: 
02:00001476 41F900000020    	   701:         LEA     DumpHeader1,A0
02:0000147C 4EB8131E        	   702:         JSR     UART_WriteString
                            	   703: 
02:00001480 207900080022    	   704:         MOVE.L  (addressInHex),A0
                            	   705:         ; Calcula endereço final
                            	   706: 
                            	   707: DUMPLOOPMASTER:
02:00001486 7200            	   708:         CLR.L   D1
02:00001488 2208            	   709:         MOVE.L  A0,D1
