                            	  1687: TRAPF_HANDLER:
02:00001CAC 4E73            	  1688:         RTE
                            	  1689: 
                            	  1690: ; --------------------------------
                            	  1691: ; Handler do TRAP #1
                            	  1692: ; Entrada:
                            	  1693: ;   D0.W - Número da função
                            	  1694: ;   D1.L - Parâmetro (para escrita)
                            	  1695: ; Saída:
                            	  1696: ;   D0.L - Resultado (para leitura)
                            	  1697: ; --------------------------------
                            	  1698: TRAP1_HANDLER:
02:00001CAE B07C0001        	  1699:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001CB2 6714            	  1700:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001CB4 B07C0002        	  1701:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001CB8 671A            	  1702:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001CBA B07C0003        	  1703:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001CBE 6722            	  1704:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001CC0 4A40            	  1705:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001CC2 672C            	  1706:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001CC4 70FF            	  1707:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001CC6 4E73            	  1708:     RTE                   ; Retorna da exceção
                            	  1709: 
                            	  1710: 
                            	  1711: 
                            	  1712: ; --------------------------------
                            	  1713: ; TRAP_CCONIN - Ler caractere do console
                            	  1714: ; Saída: D0.L - Caractere lido
                            	  1715: ; --------------------------------
                            	  1716: trap_cconin:
02:00001CC8 4EB812F2        	  1717:     JSR         UART_ReadCharNonEcho
02:00001CCC 0280000000FF    	  1718:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001CD2 4E73            	  1719:     RTE                   ; Retorna da exceção
                            	  1720: 
                            	  1721: ; --------------------------------
                            	  1722: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1723: ; Entrada: D1.L - Caractere a escrever
                            	  1724: ; --------------------------------
                            	  1725: trap_cconout:
02:00001CD4 0281000000FF    	  1726:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001CDA 1001            	  1727:     MOVE.B      D1,D0
02:00001CDC 4EB812B8        	  1728:     JSR         UART_WriteChar
02:00001CE0 4E73            	  1729:     RTE                   ; Retorna da exceção
                            	  1730: 
                            	  1731: trap_strout:
02:00001CE2 1018            	  1732:     MOVE.B      (A0)+,D0
02:00001CE4 4A00            	  1733:     CMP.B       #0,D0
02:00001CE6 6706            	  1734:     BEQ         .fim
02:00001CE8 4EB812B8        	  1735:     JSR         UART_WriteChar
02:00001CEC 60F4            	  1736:     BRA         trap_strout
                            	  1737: .fim:
02:00001CEE 4E73            	  1738:     RTE
                            	  1739: 
                            	  1740: ; --------------------------------
                            	  1741: ; TRAP_PTERM0 - Terminar programa
                            	  1742: ; --------------------------------
                            	  1743: trap_pterm0:
02:00001CF0 303C0000        	  1744:     move.w  #0,d0         ; Código de saída 0
02:00001CF4 6102            	  1745:     bsr     hardware_exit ; Chama rotina de término
02:00001CF6 4E73            	  1746:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1747: 
                            	  1748: ; --------------------------------
                            	  1749: ; hardware_exit - Terminar execução
                            	  1750: ; Entrada: D0.W - Código de saída
                            	  1751: ; --------------------------------
