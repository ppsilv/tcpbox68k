02:00001D60 6606            	  1768:     BNE     .not_illegal
02:00001D62 41F81B0D        	  1769:     LEA     illegal_msg,A0
02:00001D66 6010            	  1770:     BRA     .show_msg
                            	  1771: .not_illegal:
02:00001D68 B47C0020        	  1772:     CMP.W   #32,D2
02:00001D6C 6506            	  1773:     BLO     .other_exception
02:00001D6E 41F81B22        	  1774:     LEA     trap_msg,A0
02:00001D72 6004            	  1775:     BRA     .show_msg
                            	  1776: .other_exception:
