                            	  1085: ;--------------------------------------------------
                            	  1086: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1087: ;--------------------------------------------------
                            	  1088: ; Exemplo: insere 'A' no buffer
                            	  1089: ;          MOVE.B  #'A',D0
                            	  1090: ;          JSR     UART_BufferPut
                            	  1091: 
                            	  1092: BufferPut:
02:0000175E 2F01            	  1093:         MOVE.L  D1,-(SP)
02:00001760 2F08            	  1094:         MOVE.L  A0,-(SP)
                            	  1095: 
                            	  1096:         ;ANDI.W    #$FF00,D0
02:00001762 41F900080030    	  1097:         LEA     BUFFER,A0
02:00001768 32390008002E    	  1098:         MOVE.W  BUFFER_COUNT,D1
                            	  1099: 
02:0000176E B27C0100        	  1100:         CMP.W   #256,D1
02:00001772 6C1C            	  1101:         BGE     .BufferFull
                            	  1102: 
                            	  1103:         ; Modificado para usar deslocamento de 16 bits
02:00001774 323900080026    	  1104:         MOVE.W  BUFFER_HEAD,D1
02:0000177A D0C1            	  1105:         ADD     D1,A0
02:0000177C 1080            	  1106:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1107: 
02:0000177E 5441            	  1108:         ADD     #2,D1              ; Incrementa como word
02:00001780 024100FF        	  1109:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:00001784 33C100080026    	  1110:         MOVE.W  D1,BUFFER_HEAD
                            	  1111: 
02:0000178A 52790008002E    	  1112:         ADDQ.W  #1,BUFFER_COUNT
                            	  1113: 
                            	  1114: .BufferFull:
02:00001790 205F            	  1115:         MOVE.L  (SP)+,A0
02:00001792 221F            	  1116:         MOVE.L  (SP)+,D1
                            	  1117: 
02:00001794 4E75            	  1118:         RTS
                            	  1119: 
                            	  1120: ;--------------------------------------------------
                            	  1121: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1122: ;--------------------------------------------------
                            	  1123: ;Exemplo: Lendo byte do buffer
                            	  1124: ;         BSR     UART_BufferGet
                            	  1125: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1126: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1127: ;         Senão, D0 contém o byte lido!
                            	  1128: BufferGet:
02:00001796 2F01            	  1129:         MOVE.L  D1,-(SP)
02:00001798 2F08            	  1130:         MOVE.L  A0,-(SP)
                            	  1131: 
02:0000179A 32390008002E    	  1132:         MOVE.W  BUFFER_COUNT,D1
02:000017A0 6724            	  1133:         BEQ     .BufferEmpty
                            	  1134: 
02:000017A2 41F900080030    	  1135:         LEA     BUFFER,A0
                            	  1136: 
                            	  1137:         ; Modificado para usar deslocamento de 16 bits
02:000017A8 32390008002A    	  1138:         MOVE.W  BUFFER_TAIL,D1
02:000017AE 10301000        	  1139:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1140: 
02:000017B2 5401            	  1141:         ADDQ.B  #2,D1              ; Incrementa como word
02:000017B4 024100FF        	  1142:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:000017B8 33C10008002A    	  1143:         MOVE.W  D1,BUFFER_TAIL
                            	  1144: 
02:000017BE 53790008002E    	  1145:         SUBQ.W  #1,BUFFER_COUNT
02:000017C4 6006            	  1146:         BRA     .Exit
                            	  1147: 
                            	  1148: .BufferEmpty:
02:000017C6 4EB817D2        	  1149:         JSR     FBufferEmpty
02:000017CA 70FF            	  1150:         MOVEQ   #-1,D0
                            	  1151: .Exit:
02:000017CC 205F            	  1152:         MOVE.L  (SP)+,A0
02:000017CE 221F            	  1153:         MOVE.L  (SP)+,D1
02:000017D0 4E75            	  1154:         RTS
                            	  1155: 
                            	  1156: FBufferEmpty:
02:000017D2 4EB813A8        	  1157:         JSR     new_line
02:000017D6 41F9000003A7    	  1158:         LEA     BufferEmpty,A0
02:000017DC 4EB81308        	  1159:         JSR     UART_WriteString
02:000017E0 4EB813A8        	  1160:         JSR     new_line
02:000017E4 4E75            	  1161:         RTS
                            	  1162: ;---------------------------------------------------------------------
                            	  1163: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1164: ;---------------------------------------------------------------------
                            	  1165: ClearBufferPointers:
02:000017E6 23FC000000000008	  1166:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000017EE 0026
02:000017F0 23FC000000000008	  1167:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:000017F8 002A
02:000017FA 33FC00000008002E	  1168:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:00001802 4E75            	  1169:         RTS
                            	  1170: ;---------------------------------------------------------------------
                            	  1171: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1172: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1173: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1174: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1175: ;---------------------------------------------------------------------
                            	  1176: MontaAddress:
02:00001804 48E73C80        	  1177:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1178: 
                            	  1179:         ; Verifica se há pelo menos 8 bytes no buffer
02:00001808 32390008002E    	  1180:         MOVE.W  BUFFER_COUNT,D1
02:0000180E B27C0008        	  1181:         CMP.W   #8,D1
02:00001812 6D38            	  1182:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1183: 
02:00001814 41F900080030    	  1184:         LEA     BUFFER,A0      ; A0 = base do buffer
02:0000181A 24390008002A    	  1185:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:00001820 7000            	  1186:         CLR.L   D0                ; Zera D0 (resultado final)
02:00001822 7607            	  1187:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1188: 
                            	  1189: .ReadLoop:
02:00001824 18302800        	  1190:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:00001828 0204000F        	  1191:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1192: 
                            	  1193:         ; Desloca e insere os 4 bits em D0
02:0000182C E988            	  1194:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:0000182E 8004            	  1195:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1196: 
                            	  1197:         ; Atualiza tail (circular)
02:00001830 5282            	  1198:         ADDQ.L  #1,D2
02:00001832 0282000000FF    	  1199:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1200: 
02:00001838 51CBFFEA        	  1201:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1202: 
                            	  1203:         ; Atualiza ponteiros globais
02:0000183C 23C20008002A    	  1204:         MOVE.L  D2,BUFFER_TAIL
02:00001842 51790008002E    	  1205:         SUB.W   #8,BUFFER_COUNT
                            	  1206: 
02:00001848 7200            	  1207:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:0000184A 6004            	  1208:         BRA     .Exit
                            	  1209: 
                            	  1210: .BufferUnderrun:
02:0000184C 72FF            	  1211:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:0000184E 7000            	  1212:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1213: 
                            	  1214: .Exit:
02:00001850 4CDF013C        	  1215:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:00001854 4E75            	  1216:         RTS
                            	  1217: 
02:00001856 706473696C766120	  1218:         DC.B "pdsilva AKA pgordao"
02:0000185E 414B412070676F72
02:00001866 64616F
                            	  1219:         ALIGN 2
