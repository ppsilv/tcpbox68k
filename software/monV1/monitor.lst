                            	  1746:     ; --- ANALISA O VETOR ---
02:00001D2C E44A            	  1747:     LSR.W   #2,D2           ; Divide por 4 para get vector number
02:00001D2E 024200FF        	  1748:     ANDI.W  #$FF,D2         ; Vector number em D2
                            	  1749: 
02:00001D32 41F81AE3        	  1750:     LEA     vector_num_msg,A0
02:00001D36 4EB81392        	  1751:     JSR     UART_WriteString
02:00001D3A 3002            	  1752:     MOVE.W  D2,D0
