                            	   429: UART_Init:
                            	   430: UART_INIT:
02:00001290 227900080010    	   431:         move.l   CurrentUART,a1
02:00001296 137C000D0004    	   432:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:0000129C 137C00830006    	   433:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:000012A2 12BC0068        	   434:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:000012A6 137C00000002    	   435:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:000012AC 08A900070006    	   436:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:000012B2 4229000E        	   437:         clr.b   SCR(a1)                 ; clear the scratch register
02:000012B6 4E75            	   438:         RTS
