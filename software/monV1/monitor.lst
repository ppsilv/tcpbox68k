                            	  1226: ;--------------------------------------------------
                            	  1227: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1228: ;--------------------------------------------------
                            	  1229: ;Exemplo: Lendo byte do buffer
                            	  1230: ;         BSR     UART_BufferGet
                            	  1231: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1232: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1233: ;         Senão, D0 contém o byte lido!
                            	  1234: BufferGet:
02:0000184A 2F01            	  1235:         MOVE.L  D1,-(SP)
02:0000184C 2F08            	  1236:         MOVE.L  A0,-(SP)
                            	  1237: 
02:0000184E 32390008002E    	  1238:         MOVE.W  BUFFER_COUNT,D1
02:00001854 6724            	  1239:         BEQ     .BufferEmpty
                            	  1240: 
02:00001856 41F900080030    	  1241:         LEA     BUFFER,A0
                            	  1242: 
                            	  1243:         ; Modificado para usar deslocamento de 16 bits
02:0000185C 32390008002A    	  1244:         MOVE.W  BUFFER_TAIL,D1
02:00001862 10301000        	  1245:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1246: 
02:00001866 5401            	  1247:         ADDQ.B  #2,D1              ; Incrementa como word
02:00001868 024100FF        	  1248:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:0000186C 33C10008002A    	  1249:         MOVE.W  D1,BUFFER_TAIL
                            	  1250: 
02:00001872 53790008002E    	  1251:         SUBQ.W  #1,BUFFER_COUNT
02:00001878 6006            	  1252:         BRA     .Exit
                            	  1253: 
                            	  1254: .BufferEmpty:
02:0000187A 4EB81886        	  1255:         JSR     FBufferEmpty
02:0000187E 70FF            	  1256:         MOVEQ   #-1,D0
                            	  1257: .Exit:
02:00001880 205F            	  1258:         MOVE.L  (SP)+,A0
02:00001882 221F            	  1259:         MOVE.L  (SP)+,D1
02:00001884 4E75            	  1260:         RTS
                            	  1261: 
                            	  1262: FBufferEmpty:
