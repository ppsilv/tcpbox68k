                            	   424: ; ----------------------------------------------------------------------
                            	   425: ; Rotinas de E/S da UART
                            	   426: ; ----------------------------------------------------------------------
                            	   427: UART_Init:
                            	   428: UART_INIT:
02:00001290 227900080010    	   429:         move.l   CurrentUART,a1
02:00001296 137C000D0004    	   430:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:0000129C 137C00830006    	   431:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:000012A2 12BC0068        	   432:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:000012A6 137C00000002    	   433:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:000012AC 08A900070006    	   434:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:000012B2 4229000E        	   435:         clr.b   SCR(a1)                 ; clear the scratch register
02:000012B6 4E75            	   436:         RTS
                            	   437: 
                            	   438:     ; Escreve caractere (D0.B)
                            	   439: UART_WriteChar:
02:000012B8 2F08            	   440:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012BA 2F00            	   441:         MOVE.L  D0,-(SP)        ; Preserva D0
02:000012BC 207900080010    	   442:         move.l   CurrentUART,A0
                            	   443: .WaitTx:
02:000012C2 08280005000A    	   444:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:000012C8 67F8            	   445:         BEQ     .WaitTx
02:000012CA 1080            	   446:         MOVE.B  D0,THR(A0)      ; transmit byte
02:000012CC 201F            	   447:         MOVE.L  (SP)+,D0        ;Restaura D0
02:000012CE 205F            	   448:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012D0 4E75            	   449:         RTS
                            	   450: 
                            	   451: 
                            	   452: ; Lê caractere (retorna em D0)
                            	   453: UART_ReadChar:
02:000012D2 2F08            	   454:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012D4 207900080010    	   455:         MOVE.L   CurrentUART,A0
                            	   456: .WaitRx:
02:000012DA 08280000000A    	   457:         BTST    #0,LSR(A0)        ; RX ready?
02:000012E0 67F8            	   458:         BEQ     .WaitRx
02:000012E2 1010            	   459:         MOVE.B  RHR(A0),D0
02:000012E4 205F            	   460:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012E6 B03C001B        	   461:         CMP.B   #$1b,D0
02:000012EA 6704            	   462:         BEQ     .fim
02:000012EC 4EB812B8        	   463:         JSR     UART_WriteChar
                            	   464: .fim
02:000012F0 4E75            	   465:         RTS
                            	   466: 
                            	   467: ; Lê caractere (retorna em D0)
                            	   468: UART_ReadCharNonEcho:
02:000012F2 2F08            	   469:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012F4 207900080010    	   470:         MOVE.L  CurrentUART,A0
                            	   471: .WaitRx:
02:000012FA 08280000000A    	   472:         BTST    #0,LSR(A0)        ; RX ready?
02:00001300 67F8            	   473:         BEQ     .WaitRx
                            	   474: 
02:00001302 1010            	   475:         MOVE.B  RHR(A0),D0
02:00001304 205F            	   476:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   477: 
02:00001306 4E75            	   478:         RTS
