02:0000167A 0839000000080544	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
02:00001682 6704            	     2M     BEQ     .fim                ; Se bit = 0 (Z=1), pula para o rótulo .fim
02:00001684 12C0            	  1012:         MOVE.B  D0,(A1)+            ; Armazena
02:00001686 60EE            	  1013:         BRA     .WriteLoop
                            	  1014: 
