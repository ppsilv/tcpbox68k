02:0000153C 101F            	   820:         MOVE.B  (SP)+,D0          ; Recupera byte
02:0000153E 0200000F        	   821:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   822:         ; Continua para PrintNibble
                            	   823: ; ----------------------------------------------------------------------
                            	   824: ; PrintNibble - Imprime um nibble em hex
