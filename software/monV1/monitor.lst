                            	  1221: ; XMODEM RECEIVER ROUTINE
                            	  1222: ;bloco.append(0x01);        // SOH
                            	  1223: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1224: ;bloco.append(255 - blockNumber); // Complemento
                            	  1225: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1226: ;bloco.append(checksum);    // Checksum calculado
                            	  1227: ; =====================================================================
                            	  1228: XMODEM_Receive:
02:0000186C 48E73FFE        	  1229:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1230:        ; Inicializa variáveis
02:00001870 41F900080331    	  1231:        LEA     expected_block,A0
02:00001876 103C0001        	  1232:        MOVE.B  #1,D0
02:0000187A 1080            	  1233:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:0000187C 41F900080130    	  1234:        LEA     xmodem_buffer,A0
                            	  1235: 
02:00001882 41F900080532    	  1236:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:00001888 103C0000        	  1237:        MOVE.B  #0,D0
02:0000188C 1080            	  1238:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1239: 
                            	  1240:        ; ---- 1. INICIALIZAÇÃO ----
02:0000188E 103C0015        	  1241:        MOVE.B  #NAK,D0
02:00001892 4EB812B8        	  1242:        JSR     UART_WriteChar      ; Solicita início
                            	  1243: 
                            	  1244:        ;SINALIZA NACK SENT
02:00001896 303C0800        	  1245:        MOVE.W  #$0800,D0
02:0000189A 4EB81250        	  1246:        JSR     __write_leds
                            	  1247: 
                            	  1248:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:0000189E 45F900082000    	  1249:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1250: 
                            	  1251:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1252: Receive_Loop:
02:000018A4 4EB812F2        	  1253:        JSR     UART_ReadCharNonEcho
                            	  1254: 
02:000018A8 B03C0004        	  1255:        CMP.B   #EOT,D0
02:000018AC 670000AE        	  1256:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1257: 
02:000018B0 B03C0001        	  1258:        CMP.B   #SOH,D0
02:000018B4 66EE            	  1259:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1260: 
                            	  1261:        ;SINALIZA leds
02:000018B6 303C0C00        	  1262:        MOVE.W  #$0C00,D0
02:000018BA 4EB81250        	  1263:        JSR     __write_leds
                            	  1264: 
                            	  1265:        ; ---- 3. RECEBE HEADER ----
02:000018BE 4EB812F2        	  1266:        JSR     UART_ReadCharNonEcho       ; Block number
02:000018C2 13C000080330    	  1267:        MOVE.B  D0,block_number
                            	  1268: 
02:000018C8 4EB812F2        	  1269:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1270: 
                            	  1271:        ;SINALIZA leds
02:000018CC 303C0800        	  1272:        MOVE.W  #$0800,D0
02:000018D0 4EB81250        	  1273:        JSR     __write_leds
                            	  1274: 
                            	  1275:        ; ---- 4. RECEBE DADOS ----
02:000018D4 7220            	  1276:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:000018D6 43F900080130    	  1277:        LEA     xmodem_buffer,A1
                            	  1278: Read_Loop:
                            	  1279:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:000018DC 4EB812F2        	  1280:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:000018E0 E188            	  1281:        LSL.L   #8,D0
02:000018E2 4EB812F2        	  1282:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:000018E6 E188            	  1283:        LSL.L   #8,D0
02:000018E8 4EB812F2        	  1284:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000018EC E188            	  1285:        LSL.L   #8,D0
02:000018EE 4EB812F2        	  1286:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000018F2 22C0            	  1287:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000018F4 5381            	  1288:        SUBQ.L  #1,D1
02:000018F6 66E4            	  1289:        BNE     Read_Loop
                            	  1290: 
02:000018F8 303C0600        	  1291:        MOVE.W  #$0600,D0
02:000018FC 4EB81250        	  1292:        JSR     __write_leds
                            	  1293: 
                            	  1294:        ; ---- 5. VERIFICA CHECKSUM ----
02:00001900 4EB812F2        	  1295:        JSR     UART_ReadCharNonEcho       ; Checksum
02:00001904 1400            	  1296:        MOVE.B  D0,D2
                            	  1297: 
                            	  1298: 
                            	  1299: ;******************************************************************************************
                            	  1300:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1301:            ;     BRA     Send_ACK
                            	  1302: ;******************************************************************************************
                            	  1303: 
                            	  1304:         ; Calcula checksum local
02:00001906 43F900080130    	  1305:         LEA     xmodem_buffer,A1
02:0000190C 323C007F        	  1306:         MOVE.W  #127,D1
02:00001910 7600            	  1307:         CLR.L   D3
                            	  1308: 
                            	  1309: Calc_Checksum:
02:00001912 D619            	  1310:         ADD.B   (A1)+,D3
02:00001914 51C9FFFC        	  1311:         DBF     D1,Calc_Checksum;
                            	  1312: 
02:00001918 B602            	  1313:         CMP.B   D2,D3
02:0000191A 6634            	  1314:         BNE     Send_NAK            ; Erro no checksum
                            	  1315: 
                            	  1316:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1317:         ;MOVE.B  block_number,D0
                            	  1318:         ;CMP.B   expected_block,D0
                            	  1319:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1320: 
                            	  1321:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1322:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1323:         ; Exemplo: copiar do buffer para a RAM
                            	  1324:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:0000191C 43F900080130    	  1325:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:00001922 7220            	  1326:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1327: Copy_Data:
02:00001924 24D9            	  1328:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:00001926 5381            	  1329:         SUBQ.L  #1,D1               ; Decrementa contador
02:00001928 66FA            	  1330:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1331: 
                            	  1332:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:0000192A 523900080331    	  1333:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:00001930 103C0006        	  1334:         MOVE.B  #ACK,D0
02:00001934 4EB812B8        	  1335:         JSR     UART_WriteChar
02:00001938 6000FF6A        	  1336:         BRA     Receive_Loop
                            	  1337: 
                            	  1338: Send_ACK:
                            	  1339:         ;SINALIZA NACK SENT
02:0000193C 303C0400        	  1340:         MOVE.W  #$0400,D0
02:00001940 4EB81250        	  1341:         JSR     __write_leds
02:00001944 103C0006        	  1342:         MOVE.B  #ACK,D0
02:00001948 4EB812B8        	  1343:         JSR     UART_WriteChar
02:0000194C 6000FF56        	  1344:         BRA     Receive_Loop
                            	  1345: 
                            	  1346: Send_NAK:
02:00001950 103C0015        	  1347:         MOVE.B  #NAK,D0
02:00001954 4EB812B8        	  1348:         JSR     UART_WriteChar
02:00001958 6000FF4A        	  1349:         BRA     Receive_Loop
                            	  1350: 
                            	  1351: Transfer_Complete:
02:0000195C 103C0006        	  1352:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001960 4EB812B8        	  1353:         JSR     UART_WriteChar
                            	  1354: 
02:00001964 41F900080532    	  1355:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000196A 103C0001        	  1356:         MOVE.B  #1,D0
02:0000196E 1080            	  1357:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1358: 
02:00001970 4CDF7FFC        	  1359:         MOVEM.L (SP)+,D2-D7/A0-A6
02:00001974 4E75            	  1360:         RTS
                            	  1361: ; ========================================================
                            	  1362: ; Validador de Checksum para ROM (MC68000)
                            	  1363: ; Assume:
                            	  1364: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1365: ;   - Big-endian (padrão 68000)
                            	  1366: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1367: ; ========================================================
                            	  1368: 
                            	  1369: VALIDATE_ROM:
02:00001976 91C8            	  1370:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001978 203C00003FFC    	  1371:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:0000197E 7200            	  1372:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1373: 
                            	  1374:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1375: .CHECKSUM_LOOP:
02:00001980 2418            	  1376:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001982 D282            	  1377:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001984 5980            	  1378:         SUB.L   #4,D0               ; Decrementa contador
02:00001986 6EF8            	  1379:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1380: 
02:00001988 41F900080540    	  1381:         LEA     checksum_calc,A0
02:0000198E 20C1            	  1382:         MOVE.L  D1,(A0)+
                            	  1383:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1384: 
                            	  1385:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001990 24383FFC        	  1386:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:00001994 B481            	  1387:         CMP.L   D1,D2               ; Combina com o calculado?
02:00001996 6706            	  1388:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1389: 
                            	  1390:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:00001998 363CDEAD        	  1391:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:0000199C 6002            	  1392:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1393: .CHECKSUM_OK:
02:0000199E 4E75            	  1394:         RTS                         ; Retorna (ROM válida)
                            	  1395: 
                            	  1396: 
                            	  1397: SYSTEM_HALT:
02:000019A0 46FC2700        	  1398:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1399: .INFINITE_LOOP:
02:000019A4 60FE            	  1400:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1401: 
                            	  1402: 
                            	  1403: 
                            	  1404: ; --- Constantes ---
                            	  1405: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1406: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1407: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1408: 
                            	  1409: SPURIOUS_HANDLER:
02:000019A6 31FCCB004400    	  1410:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
02:000019AC 4E73            	  1411:     RTE
                            	  1412: 
                            	  1413: DEFAULT_HANDLER:
02:000019AE 48E7FFFE        	  1414:     MOVEM.L D0-D7/A0-A6,-(SP)
                            	  1415: 
