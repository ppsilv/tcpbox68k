02:00001738 4EB812D2        	  1073:         JSR     UART_ReadChar
02:0000173C B03C001B        	  1074:         CMP.B   #$1B,D0
02:00001740 6712            	  1075:         BEQ     .Fim
02:00001742 B03C0041        	  1076:         CMP.B   #'A',D0
02:00001746 6D02            	  1077:         BLT     .Digit
02:00001748 5F00            	  1078:         SUB.B   #7,D0            ; Ajuste para A-F
                            	  1079: .Digit:
02:0000174A 903C0030        	  1080:         SUB.B   #'0',D0
02:0000174E C03C000F        	  1081:         AND.B   #$0F,D0
02:00001752 4E75            	  1082:         RTS
                            	  1083: .Fim:
