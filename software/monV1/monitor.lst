02:0000176E E3A8            	  1123:         LSL.L   D1,D0
02:00001770 5901            	  1124:         SUB.B   #4,D1
02:00001772 8480            	  1125:         OR.L    D0,D2
02:00001774 41F900080022    	  1126:         LEA     addressInHex,A0
02:0000177A 2082            	  1127:         MOVE.L  D2,(A0)
