                            	  1226: ; XMODEM RECEIVER ROUTINE
                            	  1227: ;bloco.append(0x01);        // SOH
                            	  1228: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1229: ;bloco.append(255 - blockNumber); // Complemento
                            	  1230: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1231: ;bloco.append(checksum);    // Checksum calculado
                            	  1232: ; =====================================================================
                            	  1233: XMODEM_Receive:
02:00001880 48E73FFE        	  1234:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1235:        ; Inicializa variáveis
02:00001884 41F900080331    	  1236:        LEA     expected_block,A0
02:0000188A 103C0001        	  1237:        MOVE.B  #1,D0
02:0000188E 1080            	  1238:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:00001890 41F900080130    	  1239:        LEA     xmodem_buffer,A0
                            	  1240: 
02:00001896 41F900080532    	  1241:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000189C 103C0000        	  1242:        MOVE.B  #0,D0
02:000018A0 1080            	  1243:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1244: 
                            	  1245:        ; ---- 1. INICIALIZAÇÃO ----
02:000018A2 103C0015        	  1246:        MOVE.B  #NAK,D0
02:000018A6 4EB812CE        	  1247:        JSR     UART_WriteChar      ; Solicita início
                            	  1248: 
                            	  1249:        ;SINALIZA NACK SENT
02:000018AA 303C0800        	  1250:        MOVE.W  #$0800,D0
02:000018AE 4EB81266        	  1251:        JSR     __write_leds
                            	  1252: 
                            	  1253:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:000018B2 45F900082000    	  1254:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1255: 
                            	  1256:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1257: Receive_Loop:
02:000018B8 4EB81308        	  1258:        JSR     UART_ReadCharNonEcho
                            	  1259: 
02:000018BC B03C0004        	  1260:        CMP.B   #EOT,D0
02:000018C0 670000AE        	  1261:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1262: 
02:000018C4 B03C0001        	  1263:        CMP.B   #SOH,D0
02:000018C8 66EE            	  1264:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1265: 
                            	  1266:        ;SINALIZA leds
02:000018CA 303C0C00        	  1267:        MOVE.W  #$0C00,D0
02:000018CE 4EB81266        	  1268:        JSR     __write_leds
                            	  1269: 
                            	  1270:        ; ---- 3. RECEBE HEADER ----
02:000018D2 4EB81308        	  1271:        JSR     UART_ReadCharNonEcho       ; Block number
02:000018D6 13C000080330    	  1272:        MOVE.B  D0,block_number
                            	  1273: 
02:000018DC 4EB81308        	  1274:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1275: 
                            	  1276:        ;SINALIZA leds
02:000018E0 303C0800        	  1277:        MOVE.W  #$0800,D0
02:000018E4 4EB81266        	  1278:        JSR     __write_leds
                            	  1279: 
                            	  1280:        ; ---- 4. RECEBE DADOS ----
02:000018E8 7220            	  1281:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:000018EA 43F900080130    	  1282:        LEA     xmodem_buffer,A1
                            	  1283: Read_Loop:
                            	  1284:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:000018F0 4EB81308        	  1285:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:000018F4 E188            	  1286:        LSL.L   #8,D0
02:000018F6 4EB81308        	  1287:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:000018FA E188            	  1288:        LSL.L   #8,D0
02:000018FC 4EB81308        	  1289:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:00001900 E188            	  1290:        LSL.L   #8,D0
02:00001902 4EB81308        	  1291:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:00001906 22C0            	  1292:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:00001908 5381            	  1293:        SUBQ.L  #1,D1
02:0000190A 66E4            	  1294:        BNE     Read_Loop
                            	  1295: 
02:0000190C 303C0600        	  1296:        MOVE.W  #$0600,D0
02:00001910 4EB81266        	  1297:        JSR     __write_leds
                            	  1298: 
                            	  1299:        ; ---- 5. VERIFICA CHECKSUM ----
02:00001914 4EB81308        	  1300:        JSR     UART_ReadCharNonEcho       ; Checksum
02:00001918 1400            	  1301:        MOVE.B  D0,D2
                            	  1302: 
                            	  1303: 
                            	  1304: ;******************************************************************************************
                            	  1305:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1306:            ;     BRA     Send_ACK
                            	  1307: ;******************************************************************************************
                            	  1308: 
                            	  1309:         ; Calcula checksum local
02:0000191A 43F900080130    	  1310:         LEA     xmodem_buffer,A1
02:00001920 323C007F        	  1311:         MOVE.W  #127,D1
02:00001924 7600            	  1312:         CLR.L   D3
                            	  1313: 
                            	  1314: Calc_Checksum:
02:00001926 D619            	  1315:         ADD.B   (A1)+,D3
02:00001928 51C9FFFC        	  1316:         DBF     D1,Calc_Checksum;
                            	  1317: 
02:0000192C B602            	  1318:         CMP.B   D2,D3
02:0000192E 6634            	  1319:         BNE     Send_NAK            ; Erro no checksum
                            	  1320: 
                            	  1321:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1322:         ;MOVE.B  block_number,D0
                            	  1323:         ;CMP.B   expected_block,D0
                            	  1324:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1325: 
                            	  1326:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1327:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1328:         ; Exemplo: copiar do buffer para a RAM
                            	  1329:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:00001930 43F900080130    	  1330:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:00001936 7220            	  1331:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1332: Copy_Data:
02:00001938 24D9            	  1333:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:0000193A 5381            	  1334:         SUBQ.L  #1,D1               ; Decrementa contador
02:0000193C 66FA            	  1335:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1336: 
                            	  1337:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:0000193E 523900080331    	  1338:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:00001944 103C0006        	  1339:         MOVE.B  #ACK,D0
02:00001948 4EB812CE        	  1340:         JSR     UART_WriteChar
02:0000194C 6000FF6A        	  1341:         BRA     Receive_Loop
                            	  1342: 
                            	  1343: Send_ACK:
                            	  1344:         ;SINALIZA NACK SENT
02:00001950 303C0400        	  1345:         MOVE.W  #$0400,D0
02:00001954 4EB81266        	  1346:         JSR     __write_leds
02:00001958 103C0006        	  1347:         MOVE.B  #ACK,D0
02:0000195C 4EB812CE        	  1348:         JSR     UART_WriteChar
02:00001960 6000FF56        	  1349:         BRA     Receive_Loop
                            	  1350: 
                            	  1351: Send_NAK:
02:00001964 103C0015        	  1352:         MOVE.B  #NAK,D0
02:00001968 4EB812CE        	  1353:         JSR     UART_WriteChar
02:0000196C 6000FF4A        	  1354:         BRA     Receive_Loop
                            	  1355: 
                            	  1356: Transfer_Complete:
02:00001970 103C0006        	  1357:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001974 4EB812CE        	  1358:         JSR     UART_WriteChar
                            	  1359: 
02:00001978 41F900080532    	  1360:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000197E 103C0001        	  1361:         MOVE.B  #1,D0
02:00001982 1080            	  1362:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1363: 
02:00001984 4CDF7FFC        	  1364:         MOVEM.L (SP)+,D2-D7/A0-A6
02:00001988 4E75            	  1365:         RTS
                            	  1366: ; ========================================================
                            	  1367: ; Validador de Checksum para ROM (MC68000)
                            	  1368: ; Assume:
                            	  1369: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1370: ;   - Big-endian (padrão 68000)
                            	  1371: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1372: ; ========================================================
                            	  1373: 
                            	  1374: VALIDATE_ROM:
02:0000198A 91C8            	  1375:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:0000198C 203C00003FFC    	  1376:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:00001992 7200            	  1377:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1378: 
                            	  1379:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1380: .CHECKSUM_LOOP:
02:00001994 2418            	  1381:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001996 D282            	  1382:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001998 5980            	  1383:         SUB.L   #4,D0               ; Decrementa contador
02:0000199A 6EF8            	  1384:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1385: 
02:0000199C 41F900080540    	  1386:         LEA     checksum_calc,A0
02:000019A2 20C1            	  1387:         MOVE.L  D1,(A0)+
                            	  1388:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1389: 
                            	  1390:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:000019A4 24383FFC        	  1391:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:000019A8 B481            	  1392:         CMP.L   D1,D2               ; Combina com o calculado?
02:000019AA 6706            	  1393:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1394: 
                            	  1395:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:000019AC 363CDEAD        	  1396:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:000019B0 6002            	  1397:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1398: .CHECKSUM_OK:
02:000019B2 4E75            	  1399:         RTS                         ; Retorna (ROM válida)
                            	  1400: 
                            	  1401: 
                            	  1402: SYSTEM_HALT:
02:000019B4 46FC2700        	  1403:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1404: .INFINITE_LOOP:
02:000019B8 60FE            	  1405:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1406: 
                            	  1407: 
                            	  1408: 
                            	  1409: ; --- Constantes ---
                            	  1410: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1411: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1412: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1413: 
                            	  1414: SPURIOUS_HANDLER:
02:000019BA 31FCCB004400    	  1415:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
02:000019C0 4E73            	  1416:     RTE
