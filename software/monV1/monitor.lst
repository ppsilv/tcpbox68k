02:000015E2 203900080022    	   944:         MOVE.L  (addressInHex),D0
02:000015E8 D0BC00001000    	   945:         ADD.L   #$1000,D0
02:000015EE 2240            	   946:         MOVE.L  D0,A1
02:000015F0 7000            	   947:         MOVEQ   #0,D0
                            	   948: .ClearLoop:
02:000015F2 20C0            	   949:         MOVE.L  D0,(A0)+
02:000015F4 B3C8            	   950:         CMPA.L  A0,A1
