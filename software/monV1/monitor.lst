                            	   280: ; ******************************************************************
                            	   281: ; * timer_init - Inicializa o timer 8253                           *
                            	   282: ; * Configura canal 0: modo 3, 16-bit, binary                      *
                            	   283: ; * Entrada: Nenhuma                                               *
                            	   284: ; * Saída: Nenhuma                                                 *
                            	   285: ; * Destrói: D0                                                    *
                            	   286: ; ******************************************************************
                            	   287: 
                            	   288: INIT_8253:
                            	   289:     ;MOVEM.L D0-D1/A0,-(SP)
                            	   290:         ; Configurar canal 0: modo 3, 16-bit, binary
02:00001192 11FC00364606    	   291:         MOVE.B  #CONFIG_VALUE,TIMER_CTRL   ; 12 ciclos - escreve no registrador de controle
                            	   292: 
                            	   293:         ; Inicializar contador com valor máximo temporariamente
02:00001198 11FC00FF4600    	   294:         MOVE.B  #$FF,TIMER0_COUNT          ; 12 ciclos - LSB = 0xFF
02:0000119E 11FC00FF4600    	   295:         MOVE.B  #$FF,TIMER0_COUNT          ; 12 ciclos - MSB = 0xFF
                            	   296: 
                            	   297:     ;MOVEM.L (SP)+,D0-D1/A0
02:000011A4 4E75            	   298:     RTS
                            	   299: ; ******************************************************************
                            	   300: ; * timer_set_10ms_tick - Configura timer para tick de 10ms        *
                            	   301: ; * Assume clock de 1MHz: 1000000 * 0.01 = 10000 ticks             *
                            	   302: ; * Entrada: Nenhuma                                               *
                            	   303: ; * Saída: Nenhuma                                                 *
                            	   304: ; * Destrói: D0                                                    *
                            	   305: ; ******************************************************************
                            	   306: ;        xdef _timer_set_10ms_tick
                            	   307: TIMER_SET_10MS_TICK:
                            	   308: 
                            	   309:         ; Configurar canal 0: modo 3, 16-bit, binary
02:000011A6 11FC00364606    	   310:         MOVE.B  #CONFIG_VALUE,TIMER_CTRL   ; 12 ciclos - escreve no registrador de controle
                            	   311: 
                            	   312:         ; Escrever valor do contador (LSB primeiro, depois MSB)
02:000011AC 11FC00D04600    	   313:         move.b  #COUNT_VALUE&$FF,TIMER0_COUNT    ; LSB
02:000011B2 11FC00074600    	   314:         move.b  #(COUNT_VALUE>>8)&$FF,TIMER0_COUNT ; MSB
                            	   315: 
02:000011B8 4E75            	   316:         RTS                                ; 16 ciclos - retorna
                            	   317:                                            ; Total: ~52 ciclos
                            	   318: 
                            	   319: ; ==============================================
                            	   320: ; ROTINA QUE LÊ CONTADOR (PARA DEBUG)
                            	   321: ; ==============================================
                            	   322: READ_8253:
02:000011BA 48E7C080        	   323:     MOVEM.L D0-D1/A0,-(SP)
                            	   324: 
02:000011BE 20790008001E    	   325:     MOVE.L   CurrentTimer,A0
                            	   326:     ; --- LATCH DO CONTADOR ---
02:000011C4 117C00000003    	   327:     MOVE.B  #%00000000,+3(A0) ; Latch Count para Canal 0
                            	   328: 
                            	   329:     ; --- LÊ BYTE A BYTE ---
02:000011CA 1010            	   330:     MOVE.B  (A0),D0         ; Lê LSB
02:000011CC 0280000000FF    	   331:     ANDI.L  #$FF,D0          ; Isola byte
                            	   332: 
02:000011D2 1210            	   333:     MOVE.B  (A0),D1         ; Lê MSB
02:000011D4 0281000000FF    	   334:     ANDI.L  #$FF,D1
02:000011DA E149            	   335:     LSL.W   #8,D1            ; MSB para bits 15-8
02:000011DC 8041            	   336:     OR.W    D1,D0            ; Combina bytes (D0 = valor)
                            	   337: 
                            	   338:     ; Mostra valor
02:000011DE 4EB81526        	   339:     JSR     PrintHexAddress
                            	   340: 
02:000011E2 4CDF0103        	   341:     MOVEM.L (SP)+,D0-D1/A0
02:000011E6 6000FEDE        	   342:     BRA     MenuLoop
