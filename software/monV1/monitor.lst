                            	   498: ; ----------------------------------------------------------------------
                            	   499: ; Constantes
                            	   500: ; ----------------------------------------------------------------------
                            	   501: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   502: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   503:                               ; BAUD_DIV_L em $70000
                            	   504:                               ; BAUD_DIV_U em $70001
                            	   505: 
                            	   506: ; ----------------------------------------------------------------------
                            	   507: ; Rotina: Calcula e armazena divisor de baud rate
                            	   508: ; Entrada:
                            	   509: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   510: ; Saída:
                            	   511: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   512: ; Formulas:
                            	   513: ;
                            	   514: ;
                            	   515: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   516: ; ----------------------------------------------------------------------
                            	   517: 
                            	   518: CALCBAUDDIV:
                            	   519: ;[ Registrador D0 (32 bits) ]
                            	   520: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   521: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   522:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   523:         ;((F_CPU/16)/10)
                            	   524:         ;F_CPU = 16000000 ou 0xF42400
02:0000131C 203C00F42400    	   525:         MOVE.L  #F_CPU,D0
02:00001322 323C0010        	   526:         MOVE.W  #16,D1         ; Divisor
02:00001326 61000096        	   527:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   528: ;1
02:0000132A 2F00            	   529:         move.l  d0,-(SP)
02:0000132C 4EB81526        	   530:         jsr     PrintHexAddress
02:00001330 4EB813A8        	   531:         jsr     new_line
02:00001334 201F            	   532:         move.l  (SP)+,d0
                            	   533: 
02:00001336 323C000A        	   534:         MOVE.W  #10,D1         ; Divisor
02:0000133A 61000082        	   535:         BSR     Div32x16       ; D0 = 0x186A0
                            	   536: ;2
02:0000133E 2F00            	   537:         move.l  d0,-(SP)
02:00001340 4EB81526        	   538:         jsr     PrintHexAddress
02:00001344 4EB813A8        	   539:         jsr     new_line
02:00001348 201F            	   540:         move.l  (SP)+,d0
                            	   541: 
                            	   542:         ;(BAUD/10)
02:0000134A 2F00            	   543:         move.l  d0,-(SP)
                            	   544: ;3
02:0000134C 7000            	   545:         CLR.L   D0
02:0000134E 303900080014    	   546:         MOVE.W  CurrentBaudRate,D0
02:00001354 2F00            	   547:         move.l  d0,-(SP)
02:00001356 4EB81526        	   548:         jsr     PrintHexAddress
02:0000135A 4EB813A8        	   549:         jsr     new_line
02:0000135E 201F            	   550:         move.l  (SP)+,d0
                            	   551: 
02:00001360 123C000A        	   552:         MOVE.B  #10,D1
02:00001364 6158            	   553:         BSR     Div32x16
                            	   554: 
                            	   555: ;4
02:00001366 2F00            	   556:         move.l  d0,-(SP)
02:00001368 4EB81526        	   557:         jsr     PrintHexAddress
02:0000136C 4EB813A8        	   558:         jsr     new_line
02:00001370 221F            	   559:         move.l  (SP)+,D1
02:00001372 201F            	   560:         move.l  (SP)+,D0
                            	   561: 
                            	   562: 
                            	   563:         ;(F_CPU/BAUD)
02:00001374 6148            	   564:         BSR     Div32x16
                            	   565: ;5
02:00001376 2F00            	   566:         move.l  d0,-(SP)
02:00001378 4EB81526        	   567:         jsr     PrintHexAddress
02:0000137C 4EB813A8        	   568:         jsr     new_line
02:00001380 201F            	   569:         move.l  (SP)+,d0
                            	   570: 
                            	   571:         ; 4. Separa parte alta/baixa corretamente
02:00001382 3200            	   572:         MOVE.W  D0,D1
02:00001384 024000FF        	   573:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:00001388 E049            	   574:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:0000138A 024100FF        	   575:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   576: 
                            	   577:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:0000138E 41F90008001A    	   578:         LEA     Baud1DivL,A0
02:00001394 3080            	   579:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:00001396 41F90008001C    	   580:         LEA     Baud1DivH,A0
02:0000139C 3081            	   581:         MOVE.W  D1,(A0)
                            	   582: 
02:0000139E 6000FD26        	   583:         BRA     MenuLoop
02:000013A2 4E75            	   584:         RTS
                            	   585: .BaudError:
02:000013A4 6000FC5A        	   586:         BRA     _start
                            	   587: 
                            	   588: new_line:
02:000013A8 2F00            	   589:         MOVE.L  D0,-(SP)          ; Salva D0
02:000013AA 103C000A        	   590:         MOVE.B  #10,D0
02:000013AE 4EB812B8        	   591:         JSR     UART_WriteChar
02:000013B2 103C000D        	   592:         MOVE.B  #13,D0
02:000013B6 4EB812B8        	   593:         JSR     UART_WriteChar
02:000013BA 201F            	   594:         MOVE.L  (SP)+,D0          ; Restaura D0
02:000013BC 4E75            	   595:         RTS
                            	   596: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   597: ; Retorna D0 = Quociente, D1 = Resto
                            	   598: Div32x16:
02:000013BE 7400            	   599:         MOVEQ   #0,D2       ; D2 = Quociente
02:000013C0 761F            	   600:         MOVEQ   #31,D3      ; 32 iterações
                            	   601: DivLoop:
02:000013C2 E388            	   602:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:000013C4 E392            	   603:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:000013C6 B441            	   604:         CMP.W   D1,D2       ; D2 >= D1?
02:000013C8 6D04            	   605:         BLT     .skip
02:000013CA 9441            	   606:         SUB.W   D1,D2       ; Sim, subtrai
02:000013CC 5280            	   607:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   608: .skip:
02:000013CE 51CBFFF2        	   609:         DBRA    D3,DivLoop  ; Repete
02:000013D2 2202            	   610:         MOVE.L  D2,D1       ; Resto em D1
02:000013D4 4E75            	   611:         RTS
                            	   612: ; Versão compacta sem stack frame
                            	   613: PrintHexFast:
02:000013D6 2F02            	   614:         MOVE.L  D2,-(SP)          ; Salva D2
02:000013D8 2F00            	   615:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:000013DA 7407            	   616:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   617: 
                            	   618: .Loop:
02:000013DC 2017            	   619:         MOVE.L  (SP),D0           ; Recupera valor original
02:000013DE E998            	   620:         ROL.L   #4,D0             ; Pega próximo nibble
02:000013E0 2E80            	   621:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:000013E2 0200000F        	   622:         ANDI.B  #$F,D0            ; Isola nibble
                            	   623: 
02:000013E6 B03C0009        	   624:         CMP.B   #9,D0
02:000013EA 6302            	   625:         BLS     .Digit
02:000013EC 5E00            	   626:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   627: .Digit:
02:000013EE D03C0030        	   628:         ADD.B   #'0',D0           ; Converte para ASCII
02:000013F2 4EB812B8        	   629:         JSR     UART_WriteChar    ; Envia caractere
                            	   630: 
02:000013F6 51CAFFE4        	   631:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   632: 
02:000013FA 588F            	   633:         ADDQ.L  #4,SP             ; Remove valor salvo
02:000013FC 241F            	   634:         MOVE.L  (SP)+,D2          ; Restaura D2
02:000013FE 4E75            	   635:         RTS
                            	   636: 
                            	   637: ; ----------------------------------------------------------------------
                            	   638: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   639: ; Entrada:
                            	   640: ;   D0.L = Valor a ser impresso (32 bits)
                            	   641: ;   D1.W = Número de dígitos (1-8)
                            	   642: ; ----------------------------------------------------------------------
                            	   643: PrintHexPRECISA_DE_REVISAO:
02:00001400 4E56FFF8        	   644:         LINK    A6,#-8            ; Reserva espaço na pilha
02:00001404 2F02            	   645:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001406 2D40FFFC        	   646:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:0000140A 3D41FFFA        	   647:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   648: 
02:0000140E 323C0008        	   649:         MOVE.W  #$0008,D1
                            	   650: 
                            	   651:         ; Ajusta para começar pelo dígito mais significativo
02:00001412 E549            	   652:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:00001414 5941            	   653:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   654: 
                            	   655: .PrintLoop:
02:00001416 202EFFFC        	   656:         MOVE.L  -4(A6),D0         ; Recupera valor
02:0000141A 3401            	   657:         MOVE.W  D1,D2             ; Posição do nibble
02:0000141C E5B8            	   658:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:0000141E 02800000000F    	   659:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   660: 
                            	   661:         ; Converte para ASCII
02:00001424 B03C0009        	   662:         CMP.B   #9,D0
02:00001428 6302            	   663:         BLS     .Decimal
02:0000142A 5E00            	   664:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   665: .Decimal:
02:0000142C D03C0030        	   666:         ADD.B   #'0',D0           ; Converte para caractere
                            	   667: 
                            	   668:         ; Imprime caractere
02:00001430 4EB812B8        	   669:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   670: 
02:00001434 5941            	   671:         SUBQ.W  #4,D1             ; Próximo nibble
02:00001436 6ADE            	   672:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   673: 
                            	   674:         ; Espaço final para separação
02:00001438 103C0020        	   675:         MOVE.B  #' ',D0
02:0000143C 4EB812B8        	   676:         JSR     UART_WriteChar
                            	   677: 
02:00001440 241F            	   678:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001442 4E5E            	   679:         UNLK    A6                ; Restaura frame
02:00001444 4E75            	   680:         RTS
                            	   681: 
                            	   682: ; ----------------------------------------------------------------------
                            	   683: ; MemDump - Imprime dump de memória formatado
                            	   684: ; Entrada:
                            	   685: ;   A0 = Endereço inicial (ex: $80000)
                            	   686: ;   D0 = Quantidade de bytes (ex: 256)
                            	   687: ; ----------------------------------------------------------------------
                            	   688: MEMDUMP:
02:00001446 41F90000000D    	   689:         LEA     DumpHeader,A0
02:0000144C 4EB81308        	   690:         JSR     UART_WriteString
02:00001450 207900080022    	   691:         MOVE.L  (addressInHex),A0
02:00001456 2008            	   692:         MOVE.L  A0,D0
02:00001458 4EB81526        	   693:         JSR     PrintHexAddress
02:0000145C 4EB813A8        	   694:         JSR     new_line
                            	   695: 
02:00001460 41F900000020    	   696:         LEA     DumpHeader1,A0
02:00001466 4EB81308        	   697:         JSR     UART_WriteString
                            	   698: 
02:0000146A 207900080022    	   699:         MOVE.L  (addressInHex),A0
                            	   700:         ; Calcula endereço final
                            	   701: 
                            	   702: DUMPLOOPMASTER:
02:00001470 7200            	   703:         CLR.L   D1
02:00001472 2208            	   704:         MOVE.L  A0,D1
02:00001474 0681000000FF    	   705:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   706:         ;MOVE.L  D1,D0
                            	   707:         ;JSR     PrintHexAddress
