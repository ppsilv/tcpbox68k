                            	   885: ; ----------------------------------------------------------------------
                            	   886: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   887: ; Entrada: D0 = endereço
                            	   888: ; ----------------------------------------------------------------------
                            	   889: PrintHexAddress:
02:000015B0 4840            	   890:         SWAP    D0                ; Imprime parte alta primeiro
02:000015B2 4EB815B8        	   891:         JSR     PrintWordHex
02:000015B6 4840            	   892:         SWAP    D0                ; Parte baixa
                            	   893:         ; Continua para PrintWordHex
                            	   894: 
                            	   895: ; ----------------------------------------------------------------------
                            	   896: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   897: ; Entrada: D0.w = valor
                            	   898: ; ----------------------------------------------------------------------
                            	   899: PrintWordHex:
02:000015B8 E158            	   900:         ROL.W   #8,D0             ; Byte mais significativo primeiro
02:000015BA 4EB815C0        	   901:         JSR     PrintByteHex
02:000015BE E058            	   902:         ROR.W   #8,D0             ; Byte menos significativo
                            	   903:         ; Continua para PrintByteHex
                            	   904: 
                            	   905: ; ----------------------------------------------------------------------
                            	   906: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   907: ; Entrada: D0.b = valor
                            	   908: ; ----------------------------------------------------------------------
                            	   909: PrintByteHex:
02:000015C0 1F00            	   910:         MOVE.B  D0,-(SP)          ; Salva byte original
02:000015C2 E808            	   911:         LSR.B   #4,D0             ; Nibble alto
02:000015C4 6106            	   912:         BSR     PrintNibble
02:000015C6 101F            	   913:         MOVE.B  (SP)+,D0          ; Recupera byte
02:000015C8 0200000F        	   914:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   915:         ; Continua para PrintNibble
                            	   916: ; ----------------------------------------------------------------------
                            	   917: ; PrintNibble - Imprime um nibble em hex
                            	   918: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   919: ; ----------------------------------------------------------------------
                            	   920: PrintNibble:
02:000015CC B03C0009        	   921:         CMP.B   #9,D0
02:000015D0 6302            	   922:         BLS     .Decimal
02:000015D2 5E00            	   923:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   924: .Decimal:
02:000015D4 D03C0030        	   925:         ADD.B   #'0',D0
02:000015D8 4EF81342        	   926:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   927: 
                            	   928: ;CLEARRAM:
                            	   929: ;        LEA     $80000,A0
                            	   930: ;        LEA     $9FFFF,A1
                            	   931: ;        ;LEA     $BFFFF,A1
                            	   932: ;        MOVEQ   #0,D0
                            	   933: ;.ClearLoop:
                            	   934: ;        MOVE.L  D0,(A0)+
                            	   935: ;        CMPA.L  A0,A1
                            	   936: ;        BHI     .ClearLoop
                            	   937: ;        RTS
                            	   938: 
                            	   939: 
                            	   940: CLEARRAM3:
02:000015DC 207900080022    	   941:         MOVE.L  (addressInHex),A0
02:000015E2 203900080022    	   942:         MOVE.L  (addressInHex),D0
02:000015E8 D0BC00001000    	   943:         ADD.L   #$1000,D0
02:000015EE 2240            	   944:         MOVE.L  D0,A1
02:000015F0 7000            	   945:         MOVEQ   #0,D0
                            	   946: .ClearLoop:
02:000015F2 20C0            	   947:         MOVE.L  D0,(A0)+
02:000015F4 B3C8            	   948:         CMPA.L  A0,A1
02:000015F6 62FA            	   949:         BHI     .ClearLoop
02:000015F8 6000FAD0        	   950:         BRA     MenuLoop
