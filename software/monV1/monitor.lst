                            	  1189: ;--------------------------------------------------
                            	  1190: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1191: ;--------------------------------------------------
                            	  1192: ; Exemplo: insere 'A' no buffer
                            	  1193: ;          MOVE.B  #'A',D0
                            	  1194: ;          JSR     UART_BufferPut
                            	  1195: 
                            	  1196: BufferPut:
02:00001812 2F01            	  1197:         MOVE.L  D1,-(SP)
02:00001814 2F08            	  1198:         MOVE.L  A0,-(SP)
                            	  1199: 
                            	  1200:         ;ANDI.W    #$FF00,D0
02:00001816 41F900080030    	  1201:         LEA     BUFFER,A0
02:0000181C 32390008002E    	  1202:         MOVE.W  BUFFER_COUNT,D1
                            	  1203: 
02:00001822 B27C0100        	  1204:         CMP.W   #256,D1
02:00001826 6C1C            	  1205:         BGE     .BufferFull
                            	  1206: 
                            	  1207:         ; Modificado para usar deslocamento de 16 bits
02:00001828 323900080026    	  1208:         MOVE.W  BUFFER_HEAD,D1
02:0000182E D0C1            	  1209:         ADD     D1,A0
02:00001830 1080            	  1210:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1211: 
02:00001832 5441            	  1212:         ADD     #2,D1              ; Incrementa como word
02:00001834 024100FF        	  1213:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:00001838 33C100080026    	  1214:         MOVE.W  D1,BUFFER_HEAD
                            	  1215: 
02:0000183E 52790008002E    	  1216:         ADDQ.W  #1,BUFFER_COUNT
                            	  1217: 
                            	  1218: .BufferFull:
02:00001844 205F            	  1219:         MOVE.L  (SP)+,A0
02:00001846 221F            	  1220:         MOVE.L  (SP)+,D1
                            	  1221: 
02:00001848 4E75            	  1222:         RTS
                            	  1223: 
                            	  1224: ;--------------------------------------------------
                            	  1225: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1226: ;--------------------------------------------------
                            	  1227: ;Exemplo: Lendo byte do buffer
                            	  1228: ;         BSR     UART_BufferGet
                            	  1229: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1230: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1231: ;         Senão, D0 contém o byte lido!
                            	  1232: BufferGet:
02:0000184A 2F01            	  1233:         MOVE.L  D1,-(SP)
02:0000184C 2F08            	  1234:         MOVE.L  A0,-(SP)
                            	  1235: 
02:0000184E 32390008002E    	  1236:         MOVE.W  BUFFER_COUNT,D1
02:00001854 6724            	  1237:         BEQ     .BufferEmpty
                            	  1238: 
02:00001856 41F900080030    	  1239:         LEA     BUFFER,A0
                            	  1240: 
                            	  1241:         ; Modificado para usar deslocamento de 16 bits
02:0000185C 32390008002A    	  1242:         MOVE.W  BUFFER_TAIL,D1
02:00001862 10301000        	  1243:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1244: 
02:00001866 5401            	  1245:         ADDQ.B  #2,D1              ; Incrementa como word
02:00001868 024100FF        	  1246:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:0000186C 33C10008002A    	  1247:         MOVE.W  D1,BUFFER_TAIL
                            	  1248: 
02:00001872 53790008002E    	  1249:         SUBQ.W  #1,BUFFER_COUNT
02:00001878 6006            	  1250:         BRA     .Exit
                            	  1251: 
                            	  1252: .BufferEmpty:
02:0000187A 4EB81886        	  1253:         JSR     FBufferEmpty
02:0000187E 70FF            	  1254:         MOVEQ   #-1,D0
                            	  1255: .Exit:
02:00001880 205F            	  1256:         MOVE.L  (SP)+,A0
02:00001882 221F            	  1257:         MOVE.L  (SP)+,D1
02:00001884 4E75            	  1258:         RTS
                            	  1259: 
                            	  1260: FBufferEmpty:
02:00001886 4EB81432        	  1261:         JSR     new_line
02:0000188A 41F900000427    	  1262:         LEA     BufferEmpty,A0
02:00001890 4EB81392        	  1263:         JSR     UART_WriteString
02:00001894 4EB81432        	  1264:         JSR     new_line
02:00001898 4E75            	  1265:         RTS
                            	  1266: ;---------------------------------------------------------------------
                            	  1267: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1268: ;---------------------------------------------------------------------
                            	  1269: ClearBufferPointers:
02:0000189A 23FC000000000008	  1270:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000018A2 0026
02:000018A4 23FC000000000008	  1271:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:000018AC 002A
02:000018AE 33FC00000008002E	  1272:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:000018B6 4E75            	  1273:         RTS
                            	  1274: ;---------------------------------------------------------------------
                            	  1275: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1276: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1277: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1278: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1279: ;---------------------------------------------------------------------
                            	  1280: MontaAddress:
02:000018B8 48E73C80        	  1281:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1282: 
                            	  1283:         ; Verifica se há pelo menos 8 bytes no buffer
02:000018BC 32390008002E    	  1284:         MOVE.W  BUFFER_COUNT,D1
02:000018C2 B27C0008        	  1285:         CMP.W   #8,D1
02:000018C6 6D38            	  1286:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1287: 
02:000018C8 41F900080030    	  1288:         LEA     BUFFER,A0      ; A0 = base do buffer
02:000018CE 24390008002A    	  1289:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:000018D4 7000            	  1290:         CLR.L   D0                ; Zera D0 (resultado final)
02:000018D6 7607            	  1291:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1292: 
                            	  1293: .ReadLoop:
02:000018D8 18302800        	  1294:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:000018DC 0204000F        	  1295:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1296: 
                            	  1297:         ; Desloca e insere os 4 bits em D0
02:000018E0 E988            	  1298:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:000018E2 8004            	  1299:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1300: 
                            	  1301:         ; Atualiza tail (circular)
02:000018E4 5282            	  1302:         ADDQ.L  #1,D2
02:000018E6 0282000000FF    	  1303:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1304: 
02:000018EC 51CBFFEA        	  1305:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1306: 
                            	  1307:         ; Atualiza ponteiros globais
02:000018F0 23C20008002A    	  1308:         MOVE.L  D2,BUFFER_TAIL
02:000018F6 51790008002E    	  1309:         SUB.W   #8,BUFFER_COUNT
                            	  1310: 
02:000018FC 7200            	  1311:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:000018FE 6004            	  1312:         BRA     .Exit
                            	  1313: 
                            	  1314: .BufferUnderrun:
02:00001900 72FF            	  1315:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:00001902 7000            	  1316:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1317: 
                            	  1318: .Exit:
02:00001904 4CDF013C        	  1319:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:00001908 4E75            	  1320:         RTS
                            	  1321: 
02:0000190A 706473696C766120	  1322:         DC.B "pdsilva AKA pgordao"
02:00001912 414B412070676F72
02:0000191A 64616F
                            	  1323:         ALIGN 2
                            	  1324: ; =====================================================================
                            	  1325: ; XMODEM RECEIVER ROUTINE
                            	  1326: ;bloco.append(0x01);        // SOH
                            	  1327: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1328: ;bloco.append(255 - blockNumber); // Complemento
                            	  1329: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1330: ;bloco.append(checksum);    // Checksum calculado
                            	  1331: ; =====================================================================
                            	  1332: XMODEM_Receive:
02:00001920 48E73FFE        	  1333:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1334:        ; Inicializa variáveis
02:00001924 41F900080331    	  1335:        LEA     expected_block,A0
02:0000192A 103C0001        	  1336:        MOVE.B  #1,D0
02:0000192E 1080            	  1337:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:00001930 41F900080130    	  1338:        LEA     xmodem_buffer,A0
                            	  1339: 
02:00001936 41F900080532    	  1340:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000193C 103C0000        	  1341:        MOVE.B  #0,D0
02:00001940 1080            	  1342:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1343: 
                            	  1344:        ; ---- 1. INICIALIZAÇÃO ----
02:00001942 103C0015        	  1345:        MOVE.B  #NAK,D0
02:00001946 4EB81342        	  1346:        JSR     UART_WriteChar      ; Solicita início
                            	  1347: 
                            	  1348:        ;SINALIZA NACK SENT
02:0000194A 303C0800        	  1349:        MOVE.W  #$0800,D0
02:0000194E 4EB812B4        	  1350:        JSR     __write_leds
                            	  1351: 
                            	  1352:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:00001952 45F900082000    	  1353:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1354: 
                            	  1355:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1356: Receive_Loop:
02:00001958 4EB8137C        	  1357:        JSR     UART_ReadCharNonEcho
                            	  1358: 
02:0000195C B03C0004        	  1359:        CMP.B   #EOT,D0
02:00001960 670000B6        	  1360:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1361: 
02:00001964 B03C0001        	  1362:        CMP.B   #SOH,D0
02:00001968 66EE            	  1363:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1364: 
                            	  1365:        ;SINALIZA leds
02:0000196A 303C0100        	  1366:        MOVE.W  #$0100,D0
02:0000196E 4EB812B4        	  1367:        JSR     __write_leds
                            	  1368: 
                            	  1369:        ; ---- 3. RECEBE HEADER ----
02:00001972 4EB81A3A        	  1370:        JSR     UART_ReadCharNonEchoTimeout       ; Block number
02:00001976 13C000080330    	  1371:        MOVE.B  D0,block_number
                            	  1372: 
02:0000197C 4EB8137C        	  1373:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1374: 
                            	  1375:        ;SINALIZA leds
02:00001980 303C0800        	  1376:        MOVE.W  #$0800,D0
02:00001984 4EB812B4        	  1377:        JSR     __write_leds
                            	  1378: 
                            	  1379:        ; ---- 4. RECEBE DADOS ----
02:00001988 7220            	  1380:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:0000198A 43F900080130    	  1381:        LEA     xmodem_buffer,A1
                            	  1382: Read_Loop:
                            	  1383:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:00001990 4EB8137C        	  1384:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:00001994 E188            	  1385:        LSL.L   #8,D0
02:00001996 4EB8137C        	  1386:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:0000199A E188            	  1387:        LSL.L   #8,D0
02:0000199C 4EB8137C        	  1388:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000019A0 E188            	  1389:        LSL.L   #8,D0
02:000019A2 4EB8137C        	  1390:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000019A6 22C0            	  1391:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000019A8 5381            	  1392:        SUBQ.L  #1,D1
02:000019AA 66E4            	  1393:        BNE     Read_Loop
                            	  1394: 
02:000019AC 303C0200        	  1395:        MOVE.W  #$0200,D0
02:000019B0 4EB812B4        	  1396:        JSR     __write_leds
                            	  1397: 
                            	  1398:        ; ---- 5. VERIFICA CHECKSUM ----
02:000019B4 4EB8137C        	  1399:        JSR     UART_ReadCharNonEcho       ; Checksum
02:000019B8 1400            	  1400:        MOVE.B  D0,D2
                            	  1401: 
                            	  1402:         ; Calcula checksum local
02:000019BA 43F900080130    	  1403:         LEA     xmodem_buffer,A1
02:000019C0 323C007F        	  1404:         MOVE.W  #127,D1
02:000019C4 7600            	  1405:         CLR.L   D3
                            	  1406: 
                            	  1407: Calc_Checksum:
02:000019C6 D619            	  1408:         ADD.B   (A1)+,D3
02:000019C8 51C9FFFC        	  1409:         DBF     D1,Calc_Checksum;
                            	  1410: 
02:000019CC B602            	  1411:         CMP.B   D2,D3
02:000019CE 6634            	  1412:         BNE     Send_NAK            ; Erro no checksum
                            	  1413: 
                            	  1414:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1415:         ;MOVE.B  block_number,D0
                            	  1416:         ;CMP.B   expected_block,D0
                            	  1417:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1418: 
                            	  1419:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1420:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1421:         ; Exemplo: copiar do buffer para a RAM
                            	  1422:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:000019D0 43F900080130    	  1423:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:000019D6 7220            	  1424:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1425: Copy_Data:
02:000019D8 24D9            	  1426:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:000019DA 5381            	  1427:         SUBQ.L  #1,D1               ; Decrementa contador
02:000019DC 66FA            	  1428:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1429: 
                            	  1430:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:000019DE 523900080331    	  1431:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:000019E4 103C0006        	  1432:         MOVE.B  #ACK,D0
02:000019E8 4EB81342        	  1433:         JSR     UART_WriteChar
02:000019EC 6000FF6A        	  1434:         BRA     Receive_Loop
                            	  1435: 
                            	  1436: Send_ACK:
                            	  1437:         ;SINALIZA NACK SENT
02:000019F0 303C0400        	  1438:         MOVE.W  #$0400,D0
02:000019F4 4EB812B4        	  1439:         JSR     __write_leds
02:000019F8 103C0006        	  1440:         MOVE.B  #ACK,D0
02:000019FC 4EB81342        	  1441:         JSR     UART_WriteChar
02:00001A00 6000FF56        	  1442:         BRA     Receive_Loop
                            	  1443: 
