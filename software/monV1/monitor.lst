02:0000177E 323900080026    	  1079:         MOVE.W  BUFFER_HEAD,D1
02:00001784 D0C1            	  1080:         ADD     D1,A0
02:00001786 1080            	  1081:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1082: 
02:00001788 5441            	  1083:         ADD     #2,D1              ; Incrementa como word
02:0000178A 024100FF        	  1084:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:0000178E 33C100080026    	  1085:         MOVE.W  D1,BUFFER_HEAD
                            	  1086: 
02:00001794 52790008002E    	  1087:         ADDQ.W  #1,BUFFER_COUNT
                            	  1088: 
