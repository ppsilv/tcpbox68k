01:00001522 D0BC00001000    	   779:         ADD.L   #$1000,D0
01:00001528 2240            	   780:         MOVE.L  D0,A1
01:0000152A 7000            	   781:         MOVEQ   #0,D0
                            	   782: .ClearLoop:
