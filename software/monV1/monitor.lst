01:000016FE B03C0041        	  1001:         CMP.B   #'A',D0
01:00001702 6D02            	  1002:         BLT     .Digit
01:00001704 5F00            	  1003:         SUB.B   #7,D0            ; Ajuste para A-F
                            	  1004: .Digit:
