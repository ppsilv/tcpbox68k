                            	  1191: ;--------------------------------------------------
                            	  1192: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1193: ;--------------------------------------------------
                            	  1194: ; Exemplo: insere 'A' no buffer
                            	  1195: ;          MOVE.B  #'A',D0
                            	  1196: ;          JSR     UART_BufferPut
                            	  1197: 
                            	  1198: BufferPut:
02:00001812 2F01            	  1199:         MOVE.L  D1,-(SP)
02:00001814 2F08            	  1200:         MOVE.L  A0,-(SP)
                            	  1201: 
                            	  1202:         ;ANDI.W    #$FF00,D0
02:00001816 41F900080030    	  1203:         LEA     BUFFER,A0
02:0000181C 32390008002E    	  1204:         MOVE.W  BUFFER_COUNT,D1
                            	  1205: 
02:00001822 B27C0100        	  1206:         CMP.W   #256,D1
02:00001826 6C1C            	  1207:         BGE     .BufferFull
                            	  1208: 
                            	  1209:         ; Modificado para usar deslocamento de 16 bits
02:00001828 323900080026    	  1210:         MOVE.W  BUFFER_HEAD,D1
02:0000182E D0C1            	  1211:         ADD     D1,A0
02:00001830 1080            	  1212:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1213: 
02:00001832 5441            	  1214:         ADD     #2,D1              ; Incrementa como word
02:00001834 024100FF        	  1215:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:00001838 33C100080026    	  1216:         MOVE.W  D1,BUFFER_HEAD
                            	  1217: 
02:0000183E 52790008002E    	  1218:         ADDQ.W  #1,BUFFER_COUNT
                            	  1219: 
                            	  1220: .BufferFull:
02:00001844 205F            	  1221:         MOVE.L  (SP)+,A0
02:00001846 221F            	  1222:         MOVE.L  (SP)+,D1
                            	  1223: 
02:00001848 4E75            	  1224:         RTS
