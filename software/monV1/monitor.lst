02:00001894 4EB81432        	  1266:         JSR     new_line
02:00001898 4E75            	  1267:         RTS
                            	  1268: ;---------------------------------------------------------------------
                            	  1269: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1270: ;---------------------------------------------------------------------
                            	  1271: ClearBufferPointers:
02:0000189A 23FC000000000008	  1272:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000018A2 0026
02:000018A4 23FC000000000008	  1273:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:000018AC 002A
02:000018AE 33FC00000008002E	  1274:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:000018B6 4E75            	  1275:         RTS
                            	  1276: ;---------------------------------------------------------------------
                            	  1277: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1278: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1279: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1280: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1281: ;---------------------------------------------------------------------
                            	  1282: MontaAddress:
02:000018B8 48E73C80        	  1283:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1284: 
                            	  1285:         ; Verifica se há pelo menos 8 bytes no buffer
02:000018BC 32390008002E    	  1286:         MOVE.W  BUFFER_COUNT,D1
02:000018C2 B27C0008        	  1287:         CMP.W   #8,D1
02:000018C6 6D38            	  1288:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1289: 
02:000018C8 41F900080030    	  1290:         LEA     BUFFER,A0      ; A0 = base do buffer
02:000018CE 24390008002A    	  1291:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:000018D4 7000            	  1292:         CLR.L   D0                ; Zera D0 (resultado final)
02:000018D6 7607            	  1293:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1294: 
                            	  1295: .ReadLoop:
02:000018D8 18302800        	  1296:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:000018DC 0204000F        	  1297:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1298: 
                            	  1299:         ; Desloca e insere os 4 bits em D0
02:000018E0 E988            	  1300:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:000018E2 8004            	  1301:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1302: 
                            	  1303:         ; Atualiza tail (circular)
02:000018E4 5282            	  1304:         ADDQ.L  #1,D2
02:000018E6 0282000000FF    	  1305:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1306: 
02:000018EC 51CBFFEA        	  1307:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1308: 
                            	  1309:         ; Atualiza ponteiros globais
02:000018F0 23C20008002A    	  1310:         MOVE.L  D2,BUFFER_TAIL
02:000018F6 51790008002E    	  1311:         SUB.W   #8,BUFFER_COUNT
                            	  1312: 
02:000018FC 7200            	  1313:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:000018FE 6004            	  1314:         BRA     .Exit
                            	  1315: 
                            	  1316: .BufferUnderrun:
02:00001900 72FF            	  1317:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:00001902 7000            	  1318:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1319: 
                            	  1320: .Exit:
02:00001904 4CDF013C        	  1321:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:00001908 4E75            	  1322:         RTS
