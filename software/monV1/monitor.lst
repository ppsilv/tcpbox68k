02:00001540 1F00            	   792:         MOVE.B  D0,-(SP)          ; Salva byte original
02:00001542 E808            	   793:         LSR.B   #4,D0             ; Nibble alto
02:00001544 6106            	   794:         BSR     PrintNibble
02:00001546 101F            	   795:         MOVE.B  (SP)+,D0          ; Recupera byte
02:00001548 0200000F        	   796:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   797:         ; Continua para PrintNibble
                            	   798: ; ----------------------------------------------------------------------
