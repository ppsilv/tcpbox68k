                            	   990:         TST_FLAG_SET FL_ESC,.Fim            ; Testa o bit 0 (Z=0 se setado)
01:000016E6 0839000000080939	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
01:000016EE 6702            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
01:000016F0 8001            	   991:         OR.B    D1,D0
                            	   992: .Fim:
                            	   993:         ;MOVE.L  (SP)+,D0        ; Recupera D0
