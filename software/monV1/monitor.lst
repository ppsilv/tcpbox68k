02:000017CC 0839000000080544	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
02:000017D4 6714            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
02:000017D6 E908            	  1164:         LSL.B   #4,D0
02:000017D8 1200            	  1165:         MOVE.B  D0,D1
02:000017DA 4EB817EC        	  1166:         JSR     UART_ReadHexNibble
                            	  1167:         TST_FLAG_SET FL_ESC,.Fim            ; Testa o bit 0 (Z=0 se setado)
02:000017DE 0839000000080544	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
02:000017E6 6702            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
02:000017E8 8001            	  1168:         OR.B    D1,D0
                            	  1169: .Fim:
