                            	   427: ; Lê caractere (retorna em D0)
                            	   428: UART_ReadChar:
02:000012DC 2F08            	   429:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012DE 207900080010    	   430:         MOVE.L   CurrentUART,A0
                            	   431: .WaitRx:
02:000012E4 08280000000A    	   432:         BTST    #0,LSR(A0)        ; RX ready?
02:000012EA 67F8            	   433:         BEQ     .WaitRx
02:000012EC 1010            	   434:         MOVE.B  RHR(A0),D0
02:000012EE 205F            	   435:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012F0 B03C001B        	   436:         CMP.B   #$1b,D0
02:000012F4 6704            	   437:         BEQ     .fim
02:000012F6 4EB812C2        	   438:         JSR     UART_WriteChar
                            	   439: .fim
02:000012FA 4E75            	   440:         RTS
                            	   441: 
                            	   442: ; Lê caractere (retorna em D0)
                            	   443: UART_ReadCharNonEcho:
02:000012FC 2F08            	   444:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012FE 207900080010    	   445:         MOVE.L  CurrentUART,A0
                            	   446: .WaitRx:
02:00001304 08280000000A    	   447:         BTST    #0,LSR(A0)        ; RX ready?
02:0000130A 67F8            	   448:         BEQ     .WaitRx
                            	   449: 
02:0000130C 1010            	   450:         MOVE.B  RHR(A0),D0
02:0000130E 205F            	   451:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   452: 
02:00001310 4E75            	   453:         RTS
