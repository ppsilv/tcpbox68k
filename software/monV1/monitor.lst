02:0000153A 6106            	   821:         BSR     PrintNibble
02:0000153C 101F            	   822:         MOVE.B  (SP)+,D0          ; Recupera byte
02:0000153E 0200000F        	   823:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   824:         ; Continua para PrintNibble
                            	   825: ; ----------------------------------------------------------------------
                            	   826: ; PrintNibble - Imprime um nibble em hex
