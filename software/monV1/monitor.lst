01:0000179C 4EB8136C        	  1087:         JSR     new_line
01:000017A0 4E75            	  1088:         RTS
                            	  1089: ;---------------------------------------------------------------------
                            	  1090: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1091: ;---------------------------------------------------------------------
                            	  1092: ClearBufferPointers:
01:000017A2 23FC000000000008	  1093:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
01:000017AA 0026
01:000017AC 23FC000000000008	  1094:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
01:000017B4 002A
01:000017B6 33FC00000008002E	  1095:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
01:000017BE 4E75            	  1096:         RTS
                            	  1097: ;---------------------------------------------------------------------
                            	  1098: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1099: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1100: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1101: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1102: ;---------------------------------------------------------------------
                            	  1103: MontaAddress:
01:000017C0 48E73C80        	  1104:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1105: 
                            	  1106:         ; Verifica se há pelo menos 8 bytes no buffer
01:000017C4 32390008002E    	  1107:         MOVE.W  BUFFER_COUNT,D1
01:000017CA B27C0008        	  1108:         CMP.W   #8,D1
01:000017CE 6D38            	  1109:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1110: 
01:000017D0 41F900080030    	  1111:         LEA     BUFFER,A0      ; A0 = base do buffer
01:000017D6 24390008002A    	  1112:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
01:000017DC 7000            	  1113:         CLR.L   D0                ; Zera D0 (resultado final)
01:000017DE 7607            	  1114:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1115: 
                            	  1116: .ReadLoop:
01:000017E0 18302800        	  1117:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
01:000017E4 0204000F        	  1118:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1119: 
                            	  1120:         ; Desloca e insere os 4 bits em D0
01:000017E8 E988            	  1121:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
01:000017EA 8004            	  1122:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1123: 
                            	  1124:         ; Atualiza tail (circular)
01:000017EC 5282            	  1125:         ADDQ.L  #1,D2
01:000017EE 0282000000FF    	  1126:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1127: 
01:000017F4 51CBFFEA        	  1128:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1129: 
                            	  1130:         ; Atualiza ponteiros globais
01:000017F8 23C20008002A    	  1131:         MOVE.L  D2,BUFFER_TAIL
01:000017FE 51790008002E    	  1132:         SUB.W   #8,BUFFER_COUNT
                            	  1133: 
01:00001804 7200            	  1134:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
01:00001806 6004            	  1135:         BRA     .Exit
                            	  1136: 
                            	  1137: .BufferUnderrun:
01:00001808 72FF            	  1138:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
01:0000180A 7000            	  1139:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1140: 
                            	  1141: .Exit:
01:0000180C 4CDF013C        	  1142:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
01:00001810 4E75            	  1143:         RTS
                            	  1144: 
01:00001812 706473696C766120	  1145:         DC.B "pdsilva AKA pgordao"
01:0000181A 414B412070676F72
01:00001822 64616F
                            	  1146:         ALIGN 2
                            	  1147: ; =====================================================================
                            	  1148: ; XMODEM RECEIVER ROUTINE
                            	  1149: ;bloco.append(0x01);        // SOH
                            	  1150: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1151: ;bloco.append(255 - blockNumber); // Complemento
                            	  1152: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1153: ;bloco.append(checksum);    // Checksum calculado
                            	  1154: ; =====================================================================
                            	  1155: XMODEM_Receive:
01:00001828 48E73FFE        	  1156:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1157:        ; Inicializa variáveis
01:0000182C 41F900080331    	  1158:        LEA     expected_block,A0
01:00001832 103C0001        	  1159:        MOVE.B  #1,D0
01:00001836 1080            	  1160:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
01:00001838 41F900080130    	  1161:        LEA     xmodem_buffer,A0
                            	  1162: 
01:0000183E 41F900080938    	  1163:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
01:00001844 103C0000        	  1164:        MOVE.B  #0,D0
01:00001848 1080            	  1165:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1166: 
                            	  1167:        ; ---- 1. INICIALIZAÇÃO ----
01:0000184A 103C0015        	  1168:        MOVE.B  #NAK,D0
01:0000184E 4EB8127C        	  1169:        JSR     UART_WriteChar      ; Solicita início
                            	  1170: 
                            	  1171:        ;SINALIZA NACK SENT
01:00001852 303C0800        	  1172:        MOVE.W  #$0800,D0
01:00001856 4EB81214        	  1173:        JSR     __write_leds
                            	  1174: 
                            	  1175:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1176: Receive_Loop:
01:0000185A 4EB812B6        	  1177:        JSR     UART_ReadCharNonEcho
                            	  1178: 
01:0000185E B03C0004        	  1179:        CMP.B   #EOT,D0
01:00001862 670000B0        	  1180:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1181: 
01:00001866 B03C0001        	  1182:        CMP.B   #SOH,D0
01:0000186A 66EE            	  1183:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1184: 
                            	  1185:        ;SINALIZA leds
01:0000186C 303C0C00        	  1186:        MOVE.W  #$0C00,D0
01:00001870 4EB81214        	  1187:        JSR     __write_leds
                            	  1188: 
                            	  1189:        ; ---- 3. RECEBE HEADER ----
01:00001874 4EB812B6        	  1190:        JSR     UART_ReadCharNonEcho       ; Block number
01:00001878 13C000080330    	  1191:        MOVE.B  D0,block_number
                            	  1192: 
01:0000187E 4EB812B6        	  1193:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1194: 
                            	  1195:        ;SINALIZA leds
01:00001882 303C0800        	  1196:        MOVE.W  #$0800,D0
01:00001886 4EB81214        	  1197:        JSR     __write_leds
                            	  1198: 
                            	  1199:        ; ---- 4. RECEBE DADOS ----
01:0000188A 7220            	  1200:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
01:0000188C 43F900080130    	  1201:        LEA     xmodem_buffer,A1
                            	  1202: Read_Loop:
                            	  1203:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
01:00001892 4EB812B6        	  1204:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
01:00001896 E188            	  1205:        LSL.L   #8,D0
01:00001898 4EB812B6        	  1206:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
01:0000189C E188            	  1207:        LSL.L   #8,D0
01:0000189E 4EB812B6        	  1208:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
01:000018A2 E188            	  1209:        LSL.L   #8,D0
01:000018A4 4EB812B6        	  1210:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
01:000018A8 22C0            	  1211:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
01:000018AA 5381            	  1212:        SUBQ.L  #1,D1
01:000018AC 66E4            	  1213:        BNE     Read_Loop
                            	  1214: 
01:000018AE 303C0600        	  1215:        MOVE.W  #$0600,D0
01:000018B2 4EB81214        	  1216:        JSR     __write_leds
                            	  1217: 
                            	  1218:        ; ---- 5. VERIFICA CHECKSUM ----
01:000018B6 4EB812B6        	  1219:        JSR     UART_ReadCharNonEcho       ; Checksum
01:000018BA 1400            	  1220:        MOVE.B  D0,D2
                            	  1221: 
                            	  1222: 
                            	  1223: ;******************************************************************************************
                            	  1224:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1225:            ;     BRA     Send_ACK
                            	  1226: ;******************************************************************************************
                            	  1227: 
                            	  1228:         ; Calcula checksum local
                            	  1229:         ;LEA     xmodem_buffer,A1
                            	  1230:         ;MOVE.W  #127,D1
                            	  1231:         ;CLR.B   D3
                            	  1232: 
                            	  1233: Calc_Checksum:
                            	  1234:         ;ADD.B   (A1)+,D3
                            	  1235:         ;DBF     D1,Calc_Checksum;
                            	  1236: 
                            	  1237:         ;CMP.B   D2,D3
                            	  1238:         ;BNE     Send_NAK            ; Erro no checksum
                            	  1239: 
                            	  1240:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1241:         ;MOVE.B  block_number,D0
                            	  1242:         ;CMP.B   expected_block,D0
                            	  1243:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1244: 
                            	  1245:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1246:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1247:         ; Exemplo: copiar do buffer para a RAM
                            	  1248:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
01:000018BC 43F900080130    	  1249:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
01:000018C2 247900080332    	  1250:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
01:000018C8 7220            	  1251:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1252: Copy_Data:
01:000018CA 24D9            	  1253:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
01:000018CC 5381            	  1254:         SUBQ.L  #1,D1               ; Decrementa contador
01:000018CE 66FA            	  1255:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1256:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
01:000018D0 203900080332    	  1257:         MOVE.L  usr_buffer_addr,D0
01:000018D6 068000000080    	  1258:         ADDI.L  #128,D0
01:000018DC 23C000080332    	  1259:         MOVE.L  D0,usr_buffer_addr
                            	  1260: 
                            	  1261: 
                            	  1262: 
                            	  1263:         ; ---- 8. CONFIMA RECEPÇÃO ----
01:000018E2 523900080331    	  1264:         ADDQ.B  #1,expected_block   ; Próximo bloco
01:000018E8 103C0006        	  1265:         MOVE.B  #ACK,D0
01:000018EC 4EB8127C        	  1266:         JSR     UART_WriteChar
01:000018F0 6000FF68        	  1267:         BRA     Receive_Loop
                            	  1268: 
                            	  1269: Send_ACK:
                            	  1270:         ;SINALIZA NACK SENT
01:000018F4 303C0400        	  1271:         MOVE.W  #$0400,D0
01:000018F8 4EB81214        	  1272:         JSR     __write_leds
01:000018FC 103C0006        	  1273:         MOVE.B  #ACK,D0
01:00001900 4EB8127C        	  1274:         JSR     UART_WriteChar
01:00001904 6000FF54        	  1275:         BRA     Receive_Loop
                            	  1276: 
                            	  1277: Send_NAK:
01:00001908 103C0015        	  1278:         MOVE.B  #NAK,D0
01:0000190C 4EB8127C        	  1279:         JSR     UART_WriteChar
01:00001910 6000FF48        	  1280:         BRA     Receive_Loop
                            	  1281: 
                            	  1282: Transfer_Complete:
01:00001914 103C0006        	  1283:         MOVE.B  #ACK,D0             ; Confirma EOT
01:00001918 4EB8127C        	  1284:         JSR     UART_WriteChar
                            	  1285: 
01:0000191C 41F900080938    	  1286:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
01:00001922 103C0001        	  1287:         MOVE.B  #1,D0
01:00001926 1080            	  1288:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1289: 
01:00001928 4CDF7FFC        	  1290:         MOVEM.L (SP)+,D2-D7/A0-A6
01:0000192C 4E75            	  1291:         RTS
                            	  1292: ; ========================================================
                            	  1293: ; Validador de Checksum para ROM (MC68000)
                            	  1294: ; Assume:
                            	  1295: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1296: ;   - Big-endian (padrão 68000)
                            	  1297: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1298: ; ========================================================
                            	  1299: 
                            	  1300: VALIDATE_ROM:
01:0000192E 91C8            	  1301:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
01:00001930 203C00003FFC    	  1302:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
01:00001936 7200            	  1303:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1304: 
                            	  1305:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1306: .CHECKSUM_LOOP:
01:00001938 2418            	  1307:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
01:0000193A D282            	  1308:         ADD.L   D2,D1               ; Soma ao acumulador
01:0000193C 5980            	  1309:         SUB.L   #4,D0               ; Decrementa contador
01:0000193E 6EF8            	  1310:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1311: 
01:00001940 41F900080934    	  1312:         LEA     checksum_calc,A0
01:00001946 20C1            	  1313:         MOVE.L  D1,(A0)+
                            	  1314:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1315: 
                            	  1316:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
01:00001948 24383FFC        	  1317:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
01:0000194C B481            	  1318:         CMP.L   D1,D2               ; Combina com o calculado?
01:0000194E 6706            	  1319:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1320: 
                            	  1321:         ; --- Checksum inválido: travar o sistema ou notificar ---
01:00001950 363CDEAD        	  1322:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
01:00001954 6002            	  1323:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1324: .CHECKSUM_OK:
01:00001956 4E75            	  1325:         RTS                         ; Retorna (ROM válida)
                            	  1326: 
                            	  1327: SYSTEM_HALT:
01:00001958 46FC2700        	  1328:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1329: .INFINITE_LOOP:
01:0000195C 60FE            	  1330:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1331: 
                            	  1332: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1333: VALIDATE_ROM_CRC32:
01:0000195E 91C8            	  1334:         LEA     ROM_START,A0        ; Endereço inicial
01:00001960 203C00003FFC    	  1335:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
01:00001966 72FF            	  1336:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1337: 
                            	  1338: CRC_LOOP:
01:00001968 1418            	  1339:         MOVE.B  (A0)+,D2            ; Lê 1 byte
01:0000196A B501            	  1340:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1341: 
                            	  1342:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1343:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1344: 
01:0000196C 5380            	  1345:         SUBQ.L  #1,D0
01:0000196E 6EF8            	  1346:         BGT     CRC_LOOP
                            	  1347: 
01:00001970 4681            	  1348:         NOT.L   D1                  ; Inverte os bits no final
                            	  1349: 
                            	  1350:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
01:00001972 24383FFB        	  1351:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
01:00001976 B481            	  1352:         CMP.L   D1,D2               ; Combina com o calculado?
01:00001978 6706            	  1353:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1354: 
                            	  1355:         ; --- Checksum inválido: travar o sistema ou notificar ---
01:0000197A 363CDEAD        	  1356:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
01:0000197E 60D8            	  1357:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1358: .CHECKSUM_OK:
01:00001980 4E75            	  1359:         RTS
                            	  1360: 
                            	  1361: ; --- Constantes ---
                            	  1362: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1363: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1364: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1365: 
                            	  1366: SPURIOUS_HANDLER:
01:00001982 31FCCB004400    	  1367:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
01:00001988 4E73            	  1368:     RTE
                            	  1369: 
                            	  1370: DEFAULT_HANDLER:
01:0000198A 48E7FFFE        	  1371:     MOVEM.L D0-D7/A0-A6,-(SP)
                            	  1372: 
                            	  1373:     ; --- IDENTIFICA O TIPO DE EXCEÇÃO ---
                            	  1374:     ; --- AGORA lê corretamente da pilha ---
01:0000198E 202F000E        	  1375:     MOVE.L  (14,SP),D0      ; ⭐⭐ PC (14 bytes abaixo por causa dos registradores salvos)
01:00001992 322F0012        	  1376:     MOVE.W  (18,SP),D1      ; ⭐⭐ SR (18 bytes abaixo)
01:00001996 342F0014        	  1377:     MOVE.W  (20,SP),D2      ; ⭐⭐ Vector Offset (20 bytes abaixo)
                            	  1378: 
                            	  1379: 
                            	  1380:     ; Mostra informações detalhadas
01:0000199A 41F81A38        	  1381:     LEA     debug_msg,A0
01:0000199E 4EB812CC        	  1382:     JSR     UART_WriteString
                            	  1383: 
01:000019A2 2000            	  1384:     MOVE.L  D0,D0           ; PC
01:000019A4 4EB814EA        	  1385:     JSR     PrintHexAddress
01:000019A8 4EB8136C        	  1386:     JSR     new_line
                            	  1387: 
01:000019AC 41F81A49        	  1388:     LEA     sr_msg,A0
01:000019B0 4EB812CC        	  1389:     JSR     UART_WriteString
01:000019B4 3001            	  1390:     MOVE.W  D1,D0           ; SR
01:000019B6 4EB814EA        	  1391:     JSR     PrintHexAddress
01:000019BA 4EB8136C        	  1392:     JSR     new_line
                            	  1393: 
01:000019BE 41F81A6F        	  1394:     LEA     vector_msg,A0
01:000019C2 4EB812CC        	  1395:     JSR     UART_WriteString
01:000019C6 3002            	  1396:     MOVE.W  D2,D0           ; Vector offset
01:000019C8 4EB814EA        	  1397:     JSR     PrintHexAddress
01:000019CC 4EB8136C        	  1398:     JSR     new_line
                            	  1399: 
                            	  1400:     ; --- ANALISA O VETOR ---
01:000019D0 E44A            	  1401:     LSR.W   #2,D2           ; Divide por 4 para get vector number
01:000019D2 024200FF        	  1402:     ANDI.W  #$FF,D2         ; Vector number em D2
                            	  1403: 
01:000019D6 41F81A7F        	  1404:     LEA     vector_num_msg,A0
01:000019DA 4EB812CC        	  1405:     JSR     UART_WriteString
01:000019DE 3002            	  1406:     MOVE.W  D2,D0
01:000019E0 4EB814EA        	  1407:     JSR     PrintHexAddress
01:000019E4 4EB8136C        	  1408:     JSR     new_line
                            	  1409: 
                            	  1410:     ; --- MOSTRA QUAL EXCEÇÃO É ---
01:000019E8 B47C0008        	  1411:     CMP.W   #8,D2
01:000019EC 6606            	  1412:     BNE     .not_bus_error
01:000019EE 41F81A8F        	  1413:     LEA     bus_error_msg,A0
01:000019F2 6028            	  1414:     BRA     .show_msg
                            	  1415: .not_bus_error:
01:000019F4 B47C0009        	  1416:     CMP.W   #9,D2
01:000019F8 6606            	  1417:     BNE     .not_address_error
01:000019FA 41F81A9A        	  1418:     LEA     address_error_msg,A0
01:000019FE 601C            	  1419:     BRA     .show_msg
                            	  1420: .not_address_error:
01:00001A00 B47C000A        	  1421:     CMP.W   #10,D2
01:00001A04 6606            	  1422:     BNE     .not_illegal
01:00001A06 41F81AA9        	  1423:     LEA     illegal_msg,A0
01:00001A0A 6010            	  1424:     BRA     .show_msg
                            	  1425: .not_illegal:
