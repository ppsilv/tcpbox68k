                            	  1095: ;--------------------------------------------------
                            	  1096: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1097: ;--------------------------------------------------
                            	  1098: ;Exemplo: Lendo byte do buffer
                            	  1099: ;         BSR     UART_BufferGet
                            	  1100: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1101: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1102: ;         Senão, D0 contém o byte lido!
                            	  1103: BufferGet:
02:000017A0 2F01            	  1104:         MOVE.L  D1,-(SP)
02:000017A2 2F08            	  1105:         MOVE.L  A0,-(SP)
                            	  1106: 
02:000017A4 32390008002E    	  1107:         MOVE.W  BUFFER_COUNT,D1
02:000017AA 6724            	  1108:         BEQ     .BufferEmpty
                            	  1109: 
02:000017AC 41F900080030    	  1110:         LEA     BUFFER,A0
                            	  1111: 
                            	  1112:         ; Modificado para usar deslocamento de 16 bits
02:000017B2 32390008002A    	  1113:         MOVE.W  BUFFER_TAIL,D1
02:000017B8 10301000        	  1114:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1115: 
02:000017BC 5401            	  1116:         ADDQ.B  #2,D1              ; Incrementa como word
02:000017BE 024100FF        	  1117:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:000017C2 33C10008002A    	  1118:         MOVE.W  D1,BUFFER_TAIL
                            	  1119: 
02:000017C8 53790008002E    	  1120:         SUBQ.W  #1,BUFFER_COUNT
02:000017CE 6006            	  1121:         BRA     .Exit
                            	  1122: 
                            	  1123: .BufferEmpty:
02:000017D0 4EB817DC        	  1124:         JSR     FBufferEmpty
02:000017D4 70FF            	  1125:         MOVEQ   #-1,D0
                            	  1126: .Exit:
02:000017D6 205F            	  1127:         MOVE.L  (SP)+,A0
02:000017D8 221F            	  1128:         MOVE.L  (SP)+,D1
02:000017DA 4E75            	  1129:         RTS
                            	  1130: 
                            	  1131: FBufferEmpty:
02:000017DC 4EB813B2        	  1132:         JSR     new_line
02:000017E0 41F9000003A7    	  1133:         LEA     BufferEmpty,A0
02:000017E6 4EB81312        	  1134:         JSR     UART_WriteString
02:000017EA 4EB813B2        	  1135:         JSR     new_line
02:000017EE 4E75            	  1136:         RTS
                            	  1137: ;---------------------------------------------------------------------
                            	  1138: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1139: ;---------------------------------------------------------------------
                            	  1140: ClearBufferPointers:
02:000017F0 23FC000000000008	  1141:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000017F8 0026
02:000017FA 23FC000000000008	  1142:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:00001802 002A
02:00001804 33FC00000008002E	  1143:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:0000180C 4E75            	  1144:         RTS
                            	  1145: ;---------------------------------------------------------------------
                            	  1146: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1147: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1148: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1149: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1150: ;---------------------------------------------------------------------
                            	  1151: MontaAddress:
02:0000180E 48E73C80        	  1152:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1153: 
                            	  1154:         ; Verifica se há pelo menos 8 bytes no buffer
02:00001812 32390008002E    	  1155:         MOVE.W  BUFFER_COUNT,D1
02:00001818 B27C0008        	  1156:         CMP.W   #8,D1
02:0000181C 6D38            	  1157:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1158: 
02:0000181E 41F900080030    	  1159:         LEA     BUFFER,A0      ; A0 = base do buffer
02:00001824 24390008002A    	  1160:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:0000182A 7000            	  1161:         CLR.L   D0                ; Zera D0 (resultado final)
02:0000182C 7607            	  1162:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1163: 
                            	  1164: .ReadLoop:
02:0000182E 18302800        	  1165:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:00001832 0204000F        	  1166:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1167: 
                            	  1168:         ; Desloca e insere os 4 bits em D0
02:00001836 E988            	  1169:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:00001838 8004            	  1170:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1171: 
                            	  1172:         ; Atualiza tail (circular)
02:0000183A 5282            	  1173:         ADDQ.L  #1,D2
02:0000183C 0282000000FF    	  1174:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1175: 
02:00001842 51CBFFEA        	  1176:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1177: 
                            	  1178:         ; Atualiza ponteiros globais
02:00001846 23C20008002A    	  1179:         MOVE.L  D2,BUFFER_TAIL
02:0000184C 51790008002E    	  1180:         SUB.W   #8,BUFFER_COUNT
                            	  1181: 
02:00001852 7200            	  1182:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:00001854 6004            	  1183:         BRA     .Exit
                            	  1184: 
                            	  1185: .BufferUnderrun:
02:00001856 72FF            	  1186:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:00001858 7000            	  1187:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1188: 
                            	  1189: .Exit:
02:0000185A 4CDF013C        	  1190:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:0000185E 4E75            	  1191:         RTS
                            	  1192: 
02:00001860 706473696C766120	  1193:         DC.B "pdsilva AKA pgordao"
02:00001868 414B412070676F72
02:00001870 64616F
                            	  1194:         ALIGN 2
                            	  1195: ; =====================================================================
                            	  1196: ; XMODEM RECEIVER ROUTINE
                            	  1197: ;bloco.append(0x01);        // SOH
                            	  1198: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1199: ;bloco.append(255 - blockNumber); // Complemento
                            	  1200: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1201: ;bloco.append(checksum);    // Checksum calculado
                            	  1202: ; =====================================================================
                            	  1203: XMODEM_Receive:
02:00001874 48E73FFE        	  1204:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1205:        ; Inicializa variáveis
02:00001878 41F900080331    	  1206:        LEA     expected_block,A0
02:0000187E 103C0001        	  1207:        MOVE.B  #1,D0
02:00001882 1080            	  1208:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:00001884 41F900080130    	  1209:        LEA     xmodem_buffer,A0
                            	  1210: 
02:0000188A 41F900080532    	  1211:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:00001890 103C0000        	  1212:        MOVE.B  #0,D0
02:00001894 1080            	  1213:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1214: 
                            	  1215:        ; ---- 1. INICIALIZAÇÃO ----
02:00001896 103C0015        	  1216:        MOVE.B  #NAK,D0
02:0000189A 4EB812C2        	  1217:        JSR     UART_WriteChar      ; Solicita início
                            	  1218: 
                            	  1219:        ;SINALIZA NACK SENT
02:0000189E 303C0800        	  1220:        MOVE.W  #$0800,D0
02:000018A2 4EB8125A        	  1221:        JSR     __write_leds
                            	  1222: 
                            	  1223:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:000018A6 45F900082000    	  1224:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1225: 
                            	  1226:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1227: Receive_Loop:
02:000018AC 4EB812FC        	  1228:        JSR     UART_ReadCharNonEcho
                            	  1229: 
02:000018B0 B03C0004        	  1230:        CMP.B   #EOT,D0
02:000018B4 670000AE        	  1231:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1232: 
02:000018B8 B03C0001        	  1233:        CMP.B   #SOH,D0
02:000018BC 66EE            	  1234:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1235: 
                            	  1236:        ;SINALIZA leds
02:000018BE 303C0C00        	  1237:        MOVE.W  #$0C00,D0
02:000018C2 4EB8125A        	  1238:        JSR     __write_leds
                            	  1239: 
                            	  1240:        ; ---- 3. RECEBE HEADER ----
02:000018C6 4EB812FC        	  1241:        JSR     UART_ReadCharNonEcho       ; Block number
02:000018CA 13C000080330    	  1242:        MOVE.B  D0,block_number
                            	  1243: 
02:000018D0 4EB812FC        	  1244:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1245: 
                            	  1246:        ;SINALIZA leds
02:000018D4 303C0800        	  1247:        MOVE.W  #$0800,D0
02:000018D8 4EB8125A        	  1248:        JSR     __write_leds
                            	  1249: 
                            	  1250:        ; ---- 4. RECEBE DADOS ----
02:000018DC 7220            	  1251:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:000018DE 43F900080130    	  1252:        LEA     xmodem_buffer,A1
                            	  1253: Read_Loop:
                            	  1254:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:000018E4 4EB812FC        	  1255:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:000018E8 E188            	  1256:        LSL.L   #8,D0
02:000018EA 4EB812FC        	  1257:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:000018EE E188            	  1258:        LSL.L   #8,D0
02:000018F0 4EB812FC        	  1259:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000018F4 E188            	  1260:        LSL.L   #8,D0
02:000018F6 4EB812FC        	  1261:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000018FA 22C0            	  1262:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000018FC 5381            	  1263:        SUBQ.L  #1,D1
02:000018FE 66E4            	  1264:        BNE     Read_Loop
                            	  1265: 
02:00001900 303C0600        	  1266:        MOVE.W  #$0600,D0
02:00001904 4EB8125A        	  1267:        JSR     __write_leds
                            	  1268: 
                            	  1269:        ; ---- 5. VERIFICA CHECKSUM ----
02:00001908 4EB812FC        	  1270:        JSR     UART_ReadCharNonEcho       ; Checksum
02:0000190C 1400            	  1271:        MOVE.B  D0,D2
                            	  1272: 
                            	  1273: 
                            	  1274: ;******************************************************************************************
                            	  1275:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1276:            ;     BRA     Send_ACK
                            	  1277: ;******************************************************************************************
                            	  1278: 
                            	  1279:         ; Calcula checksum local
02:0000190E 43F900080130    	  1280:         LEA     xmodem_buffer,A1
02:00001914 323C007F        	  1281:         MOVE.W  #127,D1
02:00001918 7600            	  1282:         CLR.L   D3
                            	  1283: 
                            	  1284: Calc_Checksum:
02:0000191A D619            	  1285:         ADD.B   (A1)+,D3
02:0000191C 51C9FFFC        	  1286:         DBF     D1,Calc_Checksum;
                            	  1287: 
02:00001920 B602            	  1288:         CMP.B   D2,D3
02:00001922 6634            	  1289:         BNE     Send_NAK            ; Erro no checksum
                            	  1290: 
                            	  1291:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1292:         ;MOVE.B  block_number,D0
                            	  1293:         ;CMP.B   expected_block,D0
                            	  1294:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1295: 
                            	  1296:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1297:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1298:         ; Exemplo: copiar do buffer para a RAM
                            	  1299:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:00001924 43F900080130    	  1300:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:0000192A 7220            	  1301:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1302: Copy_Data:
02:0000192C 24D9            	  1303:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:0000192E 5381            	  1304:         SUBQ.L  #1,D1               ; Decrementa contador
02:00001930 66FA            	  1305:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1306: 
                            	  1307:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:00001932 523900080331    	  1308:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:00001938 103C0006        	  1309:         MOVE.B  #ACK,D0
02:0000193C 4EB812C2        	  1310:         JSR     UART_WriteChar
02:00001940 6000FF6A        	  1311:         BRA     Receive_Loop
                            	  1312: 
                            	  1313: Send_ACK:
                            	  1314:         ;SINALIZA NACK SENT
02:00001944 303C0400        	  1315:         MOVE.W  #$0400,D0
02:00001948 4EB8125A        	  1316:         JSR     __write_leds
02:0000194C 103C0006        	  1317:         MOVE.B  #ACK,D0
02:00001950 4EB812C2        	  1318:         JSR     UART_WriteChar
02:00001954 6000FF56        	  1319:         BRA     Receive_Loop
                            	  1320: 
                            	  1321: Send_NAK:
02:00001958 103C0015        	  1322:         MOVE.B  #NAK,D0
02:0000195C 4EB812C2        	  1323:         JSR     UART_WriteChar
02:00001960 6000FF4A        	  1324:         BRA     Receive_Loop
                            	  1325: 
                            	  1326: Transfer_Complete:
02:00001964 103C0006        	  1327:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001968 4EB812C2        	  1328:         JSR     UART_WriteChar
                            	  1329: 
02:0000196C 41F900080532    	  1330:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:00001972 103C0001        	  1331:         MOVE.B  #1,D0
02:00001976 1080            	  1332:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1333: 
02:00001978 4CDF7FFC        	  1334:         MOVEM.L (SP)+,D2-D7/A0-A6
02:0000197C 4E75            	  1335:         RTS
                            	  1336: ; ========================================================
                            	  1337: ; Validador de Checksum para ROM (MC68000)
                            	  1338: ; Assume:
                            	  1339: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1340: ;   - Big-endian (padrão 68000)
                            	  1341: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1342: ; ========================================================
                            	  1343: 
                            	  1344: VALIDATE_ROM:
02:0000197E 91C8            	  1345:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001980 203C00003FFC    	  1346:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:00001986 7200            	  1347:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1348: 
                            	  1349:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1350: .CHECKSUM_LOOP:
02:00001988 2418            	  1351:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:0000198A D282            	  1352:         ADD.L   D2,D1               ; Soma ao acumulador
02:0000198C 5980            	  1353:         SUB.L   #4,D0               ; Decrementa contador
02:0000198E 6EF8            	  1354:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1355: 
02:00001990 41F900080540    	  1356:         LEA     checksum_calc,A0
02:00001996 20C1            	  1357:         MOVE.L  D1,(A0)+
                            	  1358:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1359: 
                            	  1360:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001998 24383FFC        	  1361:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:0000199C B481            	  1362:         CMP.L   D1,D2               ; Combina com o calculado?
02:0000199E 6706            	  1363:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1364: 
                            	  1365:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:000019A0 363CDEAD        	  1366:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:000019A4 6002            	  1367:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1368: .CHECKSUM_OK:
02:000019A6 4E75            	  1369:         RTS                         ; Retorna (ROM válida)
                            	  1370: 
                            	  1371: 
                            	  1372: SYSTEM_HALT:
02:000019A8 46FC2700        	  1373:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1374: .INFINITE_LOOP:
02:000019AC 60FE            	  1375:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1376: 
                            	  1377: 
                            	  1378: 
                            	  1379: ; --- Constantes ---
                            	  1380: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1381: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1382: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1383: 
                            	  1384: SPURIOUS_HANDLER:
02:000019AE 31FCCB004400    	  1385:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
02:000019B4 4E73            	  1386:     RTE
                            	  1387: 
                            	  1388: DEFAULT_HANDLER:
02:000019B6 48E7FFFE        	  1389:     MOVEM.L D0-D7/A0-A6,-(SP)
                            	  1390: 
                            	  1391:     ; --- IDENTIFICA O TIPO DE EXCEÇÃO ---
                            	  1392:     ; --- AGORA lê corretamente da pilha ---
02:000019BA 202F000E        	  1393:     MOVE.L  (14,SP),D0      ; ⭐⭐ PC (14 bytes abaixo por causa dos registradores salvos)
02:000019BE 322F0012        	  1394:     MOVE.W  (18,SP),D1      ; ⭐⭐ SR (18 bytes abaixo)
02:000019C2 342F0014        	  1395:     MOVE.W  (20,SP),D2      ; ⭐⭐ Vector Offset (20 bytes abaixo)
                            	  1396: 
                            	  1397:     ; Mostra informações detalhadas
02:000019C6 41F81A64        	  1398:     LEA     debug_msg,A0
02:000019CA 4EB81312        	  1399:     JSR     UART_WriteString
                            	  1400: 
02:000019CE 2000            	  1401:     MOVE.L  D0,D0           ; PC
02:000019D0 4EB81530        	  1402:     JSR     PrintHexAddress
02:000019D4 4EB813B2        	  1403:     JSR     new_line
                            	  1404: 
02:000019D8 41F81A75        	  1405:     LEA     sr_msg,A0
02:000019DC 4EB81312        	  1406:     JSR     UART_WriteString
02:000019E0 3001            	  1407:     MOVE.W  D1,D0           ; SR
02:000019E2 4EB81530        	  1408:     JSR     PrintHexAddress
02:000019E6 4EB813B2        	  1409:     JSR     new_line
                            	  1410: 
02:000019EA 41F81A9B        	  1411:     LEA     vector_msg,A0
02:000019EE 4EB81312        	  1412:     JSR     UART_WriteString
02:000019F2 3002            	  1413:     MOVE.W  D2,D0           ; Vector offset
02:000019F4 4EB81530        	  1414:     JSR     PrintHexAddress
