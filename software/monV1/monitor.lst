                            	   380: ; * Saída: Nenhuma                                                 *
                            	   381: ; * Destrói: D0                                                    *
                            	   382: ; ******************************************************************
                            	   383: ;        xdef _timer_set_10ms_tick
                            	   384: TIMER_SET_10MS_TICK:
                            	   385: 
