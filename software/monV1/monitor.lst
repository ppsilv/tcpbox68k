                            	   485: ; ----------------------------------------------------------------------
                            	   486: ; UART_WriteString - Envia string terminada em null para UART
                            	   487: ; Entrada:
                            	   488: ;   A0 = Ponteiro para a string (endereço da string)
                            	   489: ; ----------------------------------------------------------------------
                            	   490: UART_WriteString:
02:0000131E 2F08            	   491:         MOVE.L  A0,-(SP)      ; Preserva D0
02:00001320 2F00            	   492:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   493: .WriteLoop:
02:00001322 1018            	   494:         MOVE.B  (A0)+,D0      ; Pega caractere
02:00001324 6706            	   495:         BEQ     .Done
02:00001326 4EB812CE        	   496:         JSR     UART_WriteChar ; Use sua rotine existente
02:0000132A 60F6            	   497:         BRA     .WriteLoop
                            	   498: .Done:
02:0000132C 201F            	   499:         MOVE.L  (SP)+,D0
02:0000132E 205F            	   500:         MOVE.L  (SP)+,A0
02:00001330 4E75            	   501:         RTS
