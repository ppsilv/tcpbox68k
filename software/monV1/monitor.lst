01:000011A8 4EB814EA        	   275:         JSR     PrintHexAddress  ; Deve mostrar endereço válido
01:000011AC 4EB8136C        	   276:         JSR     new_line
                            	   277: 
01:000011B0 41F81A49        	   278:         LEA     sr_msg,A0
01:000011B4 4EB812CC        	   279:         JSR     UART_WriteString
01:000011B8 7000            	   280:         CLR.L   D0
01:000011BA 40C0            	   281:         MOVE.W  SR,D0
01:000011BC 4EB814EA        	   282:         JSR     PrintHexAddress  ; Deve mostrar endereço válido
01:000011C0 4EB8136C        	   283:         JSR     new_line
