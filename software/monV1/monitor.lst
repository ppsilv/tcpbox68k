02:00001A5C 205F            	  1479:         MOVE.L  (SP)+,A0        ;Restaura A0
02:00001A5E 4E75            	  1480:         RTS
                            	  1481: .Fim:
02:00001A60 221F            	  1482:         MOVE.L  (SP)+,D1        ;Restaura A0
02:00001A62 205F            	  1483:         MOVE.L  (SP)+,A0        ;Restaura A0
