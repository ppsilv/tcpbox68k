                            	   480: ; ----------------------------------------------------------------------
                            	   481: ; UART_WriteString - Envia string terminada em null para UART
                            	   482: ; Entrada:
                            	   483: ;   A0 = Ponteiro para a string (endereço da string)
                            	   484: ; ----------------------------------------------------------------------
                            	   485: UART_WriteString:
02:00001308 2F08            	   486:         MOVE.L  A0,-(SP)      ; Preserva D0
02:0000130A 2F00            	   487:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   488: .WriteLoop:
02:0000130C 1018            	   489:         MOVE.B  (A0)+,D0      ; Pega caractere
02:0000130E 6706            	   490:         BEQ     .Done
02:00001310 4EB812B8        	   491:         JSR     UART_WriteChar ; Use sua rotine existente
02:00001314 60F6            	   492:         BRA     .WriteLoop
                            	   493: .Done:
02:00001316 201F            	   494:         MOVE.L  (SP)+,D0
02:00001318 205F            	   495:         MOVE.L  (SP)+,A0
02:0000131A 4E75            	   496:         RTS
