                            	  1093: ;--------------------------------------------------
                            	  1094: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1095: ;--------------------------------------------------
                            	  1096: ;Exemplo: Lendo byte do buffer
                            	  1097: ;         BSR     UART_BufferGet
                            	  1098: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1099: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1100: ;         Senão, D0 contém o byte lido!
                            	  1101: BufferGet:
02:00001798 2F01            	  1102:         MOVE.L  D1,-(SP)
02:0000179A 2F08            	  1103:         MOVE.L  A0,-(SP)
                            	  1104: 
02:0000179C 32390008002E    	  1105:         MOVE.W  BUFFER_COUNT,D1
02:000017A2 6724            	  1106:         BEQ     .BufferEmpty
                            	  1107: 
02:000017A4 41F900080030    	  1108:         LEA     BUFFER,A0
                            	  1109: 
                            	  1110:         ; Modificado para usar deslocamento de 16 bits
02:000017AA 32390008002A    	  1111:         MOVE.W  BUFFER_TAIL,D1
02:000017B0 10301000        	  1112:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1113: 
02:000017B4 5401            	  1114:         ADDQ.B  #2,D1              ; Incrementa como word
02:000017B6 024100FF        	  1115:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:000017BA 33C10008002A    	  1116:         MOVE.W  D1,BUFFER_TAIL
                            	  1117: 
02:000017C0 53790008002E    	  1118:         SUBQ.W  #1,BUFFER_COUNT
02:000017C6 6006            	  1119:         BRA     .Exit
                            	  1120: 
                            	  1121: .BufferEmpty:
02:000017C8 4EB817D4        	  1122:         JSR     FBufferEmpty
02:000017CC 70FF            	  1123:         MOVEQ   #-1,D0
                            	  1124: .Exit:
02:000017CE 205F            	  1125:         MOVE.L  (SP)+,A0
02:000017D0 221F            	  1126:         MOVE.L  (SP)+,D1
02:000017D2 4E75            	  1127:         RTS
                            	  1128: 
                            	  1129: FBufferEmpty:
02:000017D4 4EB813B2        	  1130:         JSR     new_line
02:000017D8 41F9000003A7    	  1131:         LEA     BufferEmpty,A0
02:000017DE 4EB81312        	  1132:         JSR     UART_WriteString
02:000017E2 4EB813B2        	  1133:         JSR     new_line
02:000017E6 4E75            	  1134:         RTS
                            	  1135: ;---------------------------------------------------------------------
                            	  1136: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1137: ;---------------------------------------------------------------------
                            	  1138: ClearBufferPointers:
02:000017E8 23FC000000000008	  1139:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000017F0 0026
02:000017F2 23FC000000000008	  1140:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:000017FA 002A
02:000017FC 33FC00000008002E	  1141:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:00001804 4E75            	  1142:         RTS
                            	  1143: ;---------------------------------------------------------------------
                            	  1144: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1145: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1146: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1147: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1148: ;---------------------------------------------------------------------
                            	  1149: MontaAddress:
02:00001806 48E73C80        	  1150:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1151: 
                            	  1152:         ; Verifica se há pelo menos 8 bytes no buffer
02:0000180A 32390008002E    	  1153:         MOVE.W  BUFFER_COUNT,D1
02:00001810 B27C0008        	  1154:         CMP.W   #8,D1
02:00001814 6D38            	  1155:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1156: 
02:00001816 41F900080030    	  1157:         LEA     BUFFER,A0      ; A0 = base do buffer
02:0000181C 24390008002A    	  1158:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:00001822 7000            	  1159:         CLR.L   D0                ; Zera D0 (resultado final)
02:00001824 7607            	  1160:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1161: 
                            	  1162: .ReadLoop:
02:00001826 18302800        	  1163:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:0000182A 0204000F        	  1164:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1165: 
                            	  1166:         ; Desloca e insere os 4 bits em D0
02:0000182E E988            	  1167:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:00001830 8004            	  1168:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1169: 
                            	  1170:         ; Atualiza tail (circular)
02:00001832 5282            	  1171:         ADDQ.L  #1,D2
02:00001834 0282000000FF    	  1172:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1173: 
02:0000183A 51CBFFEA        	  1174:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1175: 
                            	  1176:         ; Atualiza ponteiros globais
02:0000183E 23C20008002A    	  1177:         MOVE.L  D2,BUFFER_TAIL
02:00001844 51790008002E    	  1178:         SUB.W   #8,BUFFER_COUNT
                            	  1179: 
02:0000184A 7200            	  1180:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:0000184C 6004            	  1181:         BRA     .Exit
                            	  1182: 
                            	  1183: .BufferUnderrun:
02:0000184E 72FF            	  1184:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:00001850 7000            	  1185:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1186: 
                            	  1187: .Exit:
02:00001852 4CDF013C        	  1188:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:00001856 4E75            	  1189:         RTS
