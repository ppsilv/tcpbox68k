02:00001D54 6606            	  1763:     BNE     .not_address_error
02:00001D56 41F81AFE        	  1764:     LEA     address_error_msg,A0
02:00001D5A 601C            	  1765:     BRA     .show_msg
                            	  1766: .not_address_error:
