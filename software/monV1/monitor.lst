02:00001528 4EB8152E        	   800:         JSR     PrintWordHex
02:0000152C 4840            	   801:         SWAP    D0                ; Parte baixa
                            	   802:         ; Continua para PrintWordHex
                            	   803: 
                            	   804: ; ----------------------------------------------------------------------
                            	   805: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   806: ; Entrada: D0.w = valor
                            	   807: ; ----------------------------------------------------------------------
