                            	  1647: 
                            	  1648: ; --------------------------------
                            	  1649: ; Handler do TRAP #1
                            	  1650: ; Entrada:
                            	  1651: ;   D0.W - Número da função
                            	  1652: ;   D1.L - Parâmetro (para escrita)
                            	  1653: ; Saída:
                            	  1654: ;   D0.L - Resultado (para leitura)
                            	  1655: ; --------------------------------
                            	  1656: TRAP1_HANDLER:
02:00001C92 B07C0001        	  1657:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001C96 6714            	  1658:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001C98 B07C0002        	  1659:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001C9C 671A            	  1660:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001C9E B07C0003        	  1661:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001CA2 6722            	  1662:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001CA4 4A40            	  1663:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001CA6 672C            	  1664:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001CA8 70FF            	  1665:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001CAA 4E73            	  1666:     RTE                   ; Retorna da exceção
                            	  1667: 
                            	  1668: 
                            	  1669: 
                            	  1670: ; --------------------------------
                            	  1671: ; TRAP_CCONIN - Ler caractere do console
                            	  1672: ; Saída: D0.L - Caractere lido
                            	  1673: ; --------------------------------
                            	  1674: trap_cconin:
02:00001CAC 4EB812FC        	  1675:     JSR         UART_ReadCharNonEcho
02:00001CB0 0280000000FF    	  1676:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001CB6 4E73            	  1677:     RTE                   ; Retorna da exceção
                            	  1678: 
                            	  1679: ; --------------------------------
                            	  1680: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1681: ; Entrada: D1.L - Caractere a escrever
                            	  1682: ; --------------------------------
                            	  1683: trap_cconout:
02:00001CB8 0281000000FF    	  1684:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001CBE 1001            	  1685:     MOVE.B      D1,D0
02:00001CC0 4EB812C2        	  1686:     JSR         UART_WriteChar
02:00001CC4 4E73            	  1687:     RTE                   ; Retorna da exceção
                            	  1688: 
                            	  1689: trap_strout:
02:00001CC6 1018            	  1690:     MOVE.B      (A0)+,D0
02:00001CC8 4A00            	  1691:     CMP.B       #0,D0
02:00001CCA 6706            	  1692:     BEQ         .fim
02:00001CCC 4EB812C2        	  1693:     JSR         UART_WriteChar
02:00001CD0 60F4            	  1694:     BRA         trap_strout
                            	  1695: .fim:
02:00001CD2 4E73            	  1696:     RTE
                            	  1697: 
                            	  1698: ; --------------------------------
                            	  1699: ; TRAP_PTERM0 - Terminar programa
                            	  1700: ; --------------------------------
                            	  1701: trap_pterm0:
02:00001CD4 303C0000        	  1702:     move.w  #0,d0         ; Código de saída 0
02:00001CD8 6102            	  1703:     bsr     hardware_exit ; Chama rotina de término
02:00001CDA 4E73            	  1704:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1705: 
                            	  1706: ; --------------------------------
                            	  1707: ; hardware_exit - Terminar execução
                            	  1708: ; Entrada: D0.W - Código de saída
                            	  1709: ; --------------------------------
                            	  1710: hardware_exit:
                            	  1711:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1712:     ; Exemplo: parar o processador
                            	  1713:     ; stop    #$2700
                            	  1714: 
                            	  1715:     ; Exemplo simples: loop infinito
02:00001CDC 60FE            	  1716:     BRA     hardware_exit
02:00001CDE 4E75            	  1717:     RTS
                            	  1718: 
                            	  1719: 
                            	  1720:     ALIGN 2
