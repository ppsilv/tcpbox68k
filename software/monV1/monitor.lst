                            	   409: ; ----------------------------------------------------------------------
                            	   410: ; UART_WriteString - Envia string terminada em null para UART
                            	   411: ; Entrada:
                            	   412: ;   A0 = Ponteiro para a string (endereço da string)
                            	   413: ; ----------------------------------------------------------------------
                            	   414: UART_WriteString:
01:000012CC 2F08            	   415:         MOVE.L  A0,-(SP)      ; Preserva D0
01:000012CE 2F00            	   416:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   417: .WriteLoop:
01:000012D0 1018            	   418:         MOVE.B  (A0)+,D0      ; Pega caractere
01:000012D2 6706            	   419:         BEQ     .Done
01:000012D4 4EB8127C        	   420:         JSR     UART_WriteChar ; Use sua rotine existente
01:000012D8 60F6            	   421:         BRA     .WriteLoop
                            	   422: .Done:
01:000012DA 201F            	   423:         MOVE.L  (SP)+,D0
01:000012DC 205F            	   424:         MOVE.L  (SP)+,A0
01:000012DE 4E75            	   425:         RTS
                            	   426: 
                            	   427: ; ----------------------------------------------------------------------
                            	   428: ; Constantes
                            	   429: ; ----------------------------------------------------------------------
                            	   430: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   431: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   432:                               ; BAUD_DIV_L em $70000
                            	   433:                               ; BAUD_DIV_U em $70001
                            	   434: 
                            	   435: ; ----------------------------------------------------------------------
                            	   436: ; Rotina: Calcula e armazena divisor de baud rate
                            	   437: ; Entrada:
                            	   438: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   439: ; Saída:
                            	   440: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   441: ; Formulas:
                            	   442: ;
                            	   443: ;
                            	   444: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   445: ; ----------------------------------------------------------------------
                            	   446: 
                            	   447: CALCBAUDDIV:
                            	   448: ;[ Registrador D0 (32 bits) ]
                            	   449: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   450: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   451:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   452:         ;((F_CPU/16)/10)
                            	   453:         ;F_CPU = 16000000 ou 0xF42400
01:000012E0 203C00F42400    	   454:         MOVE.L  #F_CPU,D0
01:000012E6 323C0010        	   455:         MOVE.W  #16,D1         ; Divisor
01:000012EA 61000096        	   456:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   457: ;1
01:000012EE 2F00            	   458:         move.l  d0,-(SP)
01:000012F0 4EB814EA        	   459:         jsr     PrintHexAddress
01:000012F4 4EB8136C        	   460:         jsr     new_line
01:000012F8 201F            	   461:         move.l  (SP)+,d0
                            	   462: 
01:000012FA 323C000A        	   463:         MOVE.W  #10,D1         ; Divisor
01:000012FE 61000082        	   464:         BSR     Div32x16       ; D0 = 0x186A0
                            	   465: ;2
01:00001302 2F00            	   466:         move.l  d0,-(SP)
01:00001304 4EB814EA        	   467:         jsr     PrintHexAddress
01:00001308 4EB8136C        	   468:         jsr     new_line
01:0000130C 201F            	   469:         move.l  (SP)+,d0
                            	   470: 
                            	   471:         ;(BAUD/10)
01:0000130E 2F00            	   472:         move.l  d0,-(SP)
                            	   473: ;3
01:00001310 7000            	   474:         CLR.L   D0
01:00001312 303900080014    	   475:         MOVE.W  CurrentBaudRate,D0
01:00001318 2F00            	   476:         move.l  d0,-(SP)
01:0000131A 4EB814EA        	   477:         jsr     PrintHexAddress
01:0000131E 4EB8136C        	   478:         jsr     new_line
01:00001322 201F            	   479:         move.l  (SP)+,d0
                            	   480: 
01:00001324 123C000A        	   481:         MOVE.B  #10,D1
01:00001328 6158            	   482:         BSR     Div32x16
                            	   483: 
                            	   484: ;4
01:0000132A 2F00            	   485:         move.l  d0,-(SP)
01:0000132C 4EB814EA        	   486:         jsr     PrintHexAddress
01:00001330 4EB8136C        	   487:         jsr     new_line
01:00001334 221F            	   488:         move.l  (SP)+,D1
01:00001336 201F            	   489:         move.l  (SP)+,D0
                            	   490: 
                            	   491: 
                            	   492:         ;(F_CPU/BAUD)
01:00001338 6148            	   493:         BSR     Div32x16
                            	   494: ;5
01:0000133A 2F00            	   495:         move.l  d0,-(SP)
01:0000133C 4EB814EA        	   496:         jsr     PrintHexAddress
01:00001340 4EB8136C        	   497:         jsr     new_line
01:00001344 201F            	   498:         move.l  (SP)+,d0
                            	   499: 
                            	   500:         ; 4. Separa parte alta/baixa corretamente
01:00001346 3200            	   501:         MOVE.W  D0,D1
01:00001348 024000FF        	   502:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
01:0000134C E049            	   503:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
01:0000134E 024100FF        	   504:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   505: 
                            	   506:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
01:00001352 41F90008001A    	   507:         LEA     Baud1DivL,A0
01:00001358 3080            	   508:         MOVE.W  D0,(A0)        ; 16 bits suficientes
01:0000135A 41F90008001C    	   509:         LEA     Baud1DivH,A0
01:00001360 3081            	   510:         MOVE.W  D1,(A0)
                            	   511: 
01:00001362 6000FD5E        	   512:         BRA     MenuLoop
01:00001366 4E75            	   513:         RTS
                            	   514: .BaudError:
01:00001368 6000FC96        	   515:         BRA     _start
                            	   516: 
                            	   517: new_line:
01:0000136C 2F00            	   518:         MOVE.L  D0,-(SP)          ; Salva D0
01:0000136E 103C000A        	   519:         MOVE.B  #10,D0
01:00001372 4EB8127C        	   520:         JSR     UART_WriteChar
01:00001376 103C000D        	   521:         MOVE.B  #13,D0
01:0000137A 4EB8127C        	   522:         JSR     UART_WriteChar
01:0000137E 201F            	   523:         MOVE.L  (SP)+,D0          ; Restaura D0
01:00001380 4E75            	   524:         RTS
                            	   525: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   526: ; Retorna D0 = Quociente, D1 = Resto
                            	   527: Div32x16:
01:00001382 7400            	   528:         MOVEQ   #0,D2       ; D2 = Quociente
01:00001384 761F            	   529:         MOVEQ   #31,D3      ; 32 iterações
                            	   530: DivLoop:
01:00001386 E388            	   531:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
01:00001388 E392            	   532:         ROXL.L  #1,D2       ; Desloca D2 com Carry
01:0000138A B441            	   533:         CMP.W   D1,D2       ; D2 >= D1?
01:0000138C 6D04            	   534:         BLT     .skip
01:0000138E 9441            	   535:         SUB.W   D1,D2       ; Sim, subtrai
01:00001390 5280            	   536:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   537: .skip:
01:00001392 51CBFFF2        	   538:         DBRA    D3,DivLoop  ; Repete
01:00001396 2202            	   539:         MOVE.L  D2,D1       ; Resto em D1
01:00001398 4E75            	   540:         RTS
                            	   541: ; Versão compacta sem stack frame
                            	   542: PrintHexFast:
01:0000139A 2F02            	   543:         MOVE.L  D2,-(SP)          ; Salva D2
01:0000139C 2F00            	   544:         MOVE.L  D0,-(SP)          ; Salva D0 original
01:0000139E 7407            	   545:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   546: 
                            	   547: .Loop:
01:000013A0 2017            	   548:         MOVE.L  (SP),D0           ; Recupera valor original
01:000013A2 E998            	   549:         ROL.L   #4,D0             ; Pega próximo nibble
01:000013A4 2E80            	   550:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
01:000013A6 0200000F        	   551:         ANDI.B  #$F,D0            ; Isola nibble
                            	   552: 
01:000013AA B03C0009        	   553:         CMP.B   #9,D0
01:000013AE 6302            	   554:         BLS     .Digit
01:000013B0 5E00            	   555:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   556: .Digit:
01:000013B2 D03C0030        	   557:         ADD.B   #'0',D0           ; Converte para ASCII
01:000013B6 4EB8127C        	   558:         JSR     UART_WriteChar    ; Envia caractere
                            	   559: 
01:000013BA 51CAFFE4        	   560:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   561: 
01:000013BE 588F            	   562:         ADDQ.L  #4,SP             ; Remove valor salvo
01:000013C0 241F            	   563:         MOVE.L  (SP)+,D2          ; Restaura D2
01:000013C2 4E75            	   564:         RTS
                            	   565: 
                            	   566: ; ----------------------------------------------------------------------
                            	   567: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   568: ; Entrada:
                            	   569: ;   D0.L = Valor a ser impresso (32 bits)
                            	   570: ;   D1.W = Número de dígitos (1-8)
                            	   571: ; ----------------------------------------------------------------------
                            	   572: PrintHexPRECISA_DE_REVISAO:
01:000013C4 4E56FFF8        	   573:         LINK    A6,#-8            ; Reserva espaço na pilha
01:000013C8 2F02            	   574:         MOVE.L  D2,-(SP)          ; Salva D2
01:000013CA 2D40FFFC        	   575:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
01:000013CE 3D41FFFA        	   576:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   577: 
01:000013D2 323C0008        	   578:         MOVE.W  #$0008,D1
                            	   579: 
                            	   580:         ; Ajusta para começar pelo dígito mais significativo
01:000013D6 E549            	   581:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
01:000013D8 5941            	   582:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   583: 
                            	   584: .PrintLoop:
01:000013DA 202EFFFC        	   585:         MOVE.L  -4(A6),D0         ; Recupera valor
01:000013DE 3401            	   586:         MOVE.W  D1,D2             ; Posição do nibble
01:000013E0 E5B8            	   587:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
01:000013E2 02800000000F    	   588:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   589: 
                            	   590:         ; Converte para ASCII
01:000013E8 B03C0009        	   591:         CMP.B   #9,D0
01:000013EC 6302            	   592:         BLS     .Decimal
01:000013EE 5E00            	   593:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   594: .Decimal:
01:000013F0 D03C0030        	   595:         ADD.B   #'0',D0           ; Converte para caractere
                            	   596: 
                            	   597:         ; Imprime caractere
01:000013F4 4EB8127C        	   598:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   599: 
01:000013F8 5941            	   600:         SUBQ.W  #4,D1             ; Próximo nibble
01:000013FA 6ADE            	   601:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   602: 
                            	   603:         ; Espaço final para separação
01:000013FC 103C0020        	   604:         MOVE.B  #' ',D0
01:00001400 4EB8127C        	   605:         JSR     UART_WriteChar
                            	   606: 
01:00001404 241F            	   607:         MOVE.L  (SP)+,D2          ; Restaura D2
01:00001406 4E5E            	   608:         UNLK    A6                ; Restaura frame
01:00001408 4E75            	   609:         RTS
                            	   610: 
                            	   611: ; ----------------------------------------------------------------------
                            	   612: ; MemDump - Imprime dump de memória formatado
                            	   613: ; Entrada:
                            	   614: ;   A0 = Endereço inicial (ex: $80000)
                            	   615: ;   D0 = Quantidade de bytes (ex: 256)
                            	   616: ; ----------------------------------------------------------------------
                            	   617: MEMDUMP:
01:0000140A 41F90000000D    	   618:         LEA     DumpHeader,A0
01:00001410 4EB812CC        	   619:         JSR     UART_WriteString
01:00001414 207900080022    	   620:         MOVE.L  (addressInHex),A0
01:0000141A 2008            	   621:         MOVE.L  A0,D0
01:0000141C 4EB814EA        	   622:         JSR     PrintHexAddress
01:00001420 4EB8136C        	   623:         JSR     new_line
                            	   624: 
01:00001424 41F900000020    	   625:         LEA     DumpHeader1,A0
01:0000142A 4EB812CC        	   626:         JSR     UART_WriteString
                            	   627: 
01:0000142E 207900080022    	   628:         MOVE.L  (addressInHex),A0
                            	   629:         ; Calcula endereço final
                            	   630: 
                            	   631: DUMPLOOPMASTER:
01:00001434 7200            	   632:         CLR.L   D1
01:00001436 2208            	   633:         MOVE.L  A0,D1
01:00001438 0681000000FF    	   634:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   635:         ;MOVE.L  D1,D0
                            	   636:         ;JSR     PrintHexAddress
                            	   637:         ;JSR     new_line
                            	   638: 
                            	   639:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   640:         ;JSR     UART_ReadChar
                            	   641: 
                            	   642: 
                            	   643: DumpLoop:
                            	   644:         ; Nova linha a cada 16 bytes
01:0000143E 2008            	   645:         MOVE.L  A0,D0
01:00001440 02800000000F    	   646:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
01:00001446 6616            	   647:         BNE     NoNewLine
                            	   648: 
                            	   649:         ; Imprime endereço
01:00001448 2008            	   650:         MOVE.L  A0,D0
01:0000144A 4EB814EA        	   651:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   652: 
01:0000144E 103C003A        	   653:         MOVE.B  #':',D0
01:00001452 4EB8127C        	   654:         JSR     UART_WriteChar
01:00001456 103C0020        	   655:         MOVE.B  #' ',D0
01:0000145A 4EB8127C        	   656:         JSR     UART_WriteChar
                            	   657: 
                            	   658: NoNewLine:
                            	   659:         ; Imprime byte em hex
01:0000145E 1018            	   660:         MOVE.B  (A0)+,D0
01:00001460 4EB814FA        	   661:         JSR     PrintByteHex
                            	   662: 
01:00001464 103C0020        	   663:         MOVE.B  #' ',D0
01:00001468 4EB8127C        	   664:         JSR     UART_WriteChar
                            	   665: 
                            	   666:         ; Verifica fim da linha (16 bytes)
01:0000146C 2008            	   667:         MOVE.L  A0,D0
01:0000146E 02800000000F    	   668:         ANDI.L  #$0000000F,D0
01:00001474 664E            	   669:         BNE     NoEndLine
                            	   670: 
                            	   671:         ; Imprime caracteres ASCII
01:00001476 103C0020        	   672:         MOVE.B  #' ',D0
01:0000147A 4EB8127C        	   673:         JSR     UART_WriteChar
01:0000147E 103C007C        	   674:         MOVE.B  #'|',D0
01:00001482 4EB8127C        	   675:         JSR     UART_WriteChar
                            	   676: 
01:00001486 43E8FFF0        	   677:         LEA     -16(A0),A1        ; Volta ao início da linha
01:0000148A 740F            	   678:         MOVEQ   #15,D2            ; 16 caracteres
                            	   679: 
                            	   680: AsciiLoop:
01:0000148C 1019            	   681:         MOVE.B  (A1)+,D0
01:0000148E B03C0020        	   682:         CMP.B   #32,D0            ; Verifica se é imprimível
01:00001492 6D0C            	   683:         BLT     NonPrintable
01:00001494 B03C007E        	   684:         CMP.B   #126,D0
01:00001498 6E06            	   685:         BGT     NonPrintable
                            	   686: 
01:0000149A 4EB8127C        	   687:         JSR     UART_WriteChar
01:0000149E 6008            	   688:         BRA     NextAscii
                            	   689: 
                            	   690: NonPrintable:
01:000014A0 103C002E        	   691:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
01:000014A4 4EB8127C        	   692:         JSR     UART_WriteChar
                            	   693: 
                            	   694: NextAscii:
01:000014A8 51CAFFE2        	   695:         DBRA    D2,AsciiLoop
                            	   696: 
01:000014AC 103C007C        	   697:         MOVE.B  #'|',D0
01:000014B0 4EB8127C        	   698:         JSR     UART_WriteChar
01:000014B4 103C000D        	   699:         MOVE.B  #13,D0            ; CR
01:000014B8 4EB8127C        	   700:         JSR     UART_WriteChar
01:000014BC 103C000A        	   701:         MOVE.B  #10,D0            ; LF
01:000014C0 4EB8127C        	   702:         JSR     UART_WriteChar
                            	   703: 
                            	   704: NoEndLine:
                            	   705:         ; Verifica fim do dump
01:000014C4 B1C1            	   706:         CMP.L   D1,A0
01:000014C6 6300FF76        	   707:         BLS     DumpLoop
                            	   708: 
01:000014CA 2F08            	   709:         MOVE.L  A0,-(SP)          ; Salva endereço atual
01:000014CC 41F900000425    	   710:         LEA     HitAnyKey,A0
01:000014D2 4EB812CC        	   711:         JSR     UART_WriteString
01:000014D6 4EB81296        	   712:         JSR     UART_ReadChar
01:000014DA B03C001B        	   713:         CMP.B   #$1B,D0
01:000014DE 6706            	   714:         BEQ     .fim
                            	   715: 
01:000014E0 205F            	   716:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
01:000014E2 6000FF50        	   717:         BRA     DUMPLOOPMASTER
                            	   718: .fim
01:000014E6 6000FBDA        	   719:         BRA     MenuLoop
                            	   720: 
                            	   721: ; ----------------------------------------------------------------------
                            	   722: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   723: ; Entrada: D0 = endereço
                            	   724: ; ----------------------------------------------------------------------
                            	   725: PrintHexAddress:
01:000014EA 4840            	   726:         SWAP    D0                ; Imprime parte alta primeiro
01:000014EC 4EB814F2        	   727:         JSR     PrintWordHex
01:000014F0 4840            	   728:         SWAP    D0                ; Parte baixa
                            	   729:         ; Continua para PrintWordHex
                            	   730: 
                            	   731: ; ----------------------------------------------------------------------
                            	   732: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   733: ; Entrada: D0.w = valor
