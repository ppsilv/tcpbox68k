                            	   501: ; ----------------------------------------------------------------------
                            	   502: ; Rotinas de E/S da UART
                            	   503: ; ----------------------------------------------------------------------
                            	   504: UART_Init:
                            	   505: UART_INIT:
02:000012F4 227900080010    	   506:         move.l   CurrentUART,a1
02:000012FA 137C000D0004    	   507:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:00001300 137C00830006    	   508:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:00001306 12BC0008        	   509:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:0000130A 137C00000002    	   510:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:00001310 08A900070006    	   511:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:00001316 4229000E        	   512:         clr.b   SCR(a1)                 ; clear the scratch register
02:0000131A 4E75            	   513:         RTS
                            	   514: 
                            	   515: ; ----------------------------------------------------------------------
                            	   516: ; UART_INIT1:
                            	   517: ; Parametros: D0 tem o byte a ser gravado em DLM e DLL divisor baud rate
                            	   518: ; ----------------------------------------------------------------------
                            	   519: UART_INIT1:
02:0000131C 227900080010    	   520:         move.l   CurrentUART,a1
02:00001322 137C000D0004    	   521:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:00001328 137C00830006    	   522:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:0000132E 1280            	   523:         move.b  D0,DLL(A1)              ; Byte 0 (LSB) -> DLL
02:00001330 E088            	   524:         lsr.l   #8,D0                   ; Shift right 8 bits
02:00001332 13400002        	   525:         move.b  D0,DLM(A1)              ; Byte 1 (agora no LSB) -> DLM
02:00001336 08A900070006    	   526:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:0000133C 4229000E        	   527:         clr.b   SCR(a1)                 ; clear the scratch register
02:00001340 4E75            	   528:         RTS
                            	   529: 
                            	   530:     ; Escreve caractere (D0.B)
                            	   531: UART_WriteChar:
02:00001342 2F08            	   532:         MOVE.L  A0,-(SP)        ; Preserva A0
02:00001344 2F00            	   533:         MOVE.L  D0,-(SP)        ; Preserva D0
02:00001346 207900080010    	   534:         move.l   CurrentUART,A0
                            	   535: .WaitTx:
02:0000134C 08280005000A    	   536:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:00001352 67F8            	   537:         BEQ     .WaitTx
02:00001354 1080            	   538:         MOVE.B  D0,THR(A0)      ; transmit byte
02:00001356 201F            	   539:         MOVE.L  (SP)+,D0        ;Restaura D0
02:00001358 205F            	   540:         MOVE.L  (SP)+,A0        ;Restaura A0
02:0000135A 4E75            	   541:         RTS
                            	   542: 
                            	   543: 
                            	   544: ; Lê caractere (retorna em D0)
                            	   545: UART_ReadChar:
02:0000135C 2F08            	   546:         MOVE.L  A0,-(SP)        ; Preserva A0
02:0000135E 207900080010    	   547:         MOVE.L   CurrentUART,A0
                            	   548: .WaitRx:
02:00001364 08280000000A    	   549:         BTST    #0,LSR(A0)        ; RX ready?
02:0000136A 67F8            	   550:         BEQ     .WaitRx
02:0000136C 1010            	   551:         MOVE.B  RHR(A0),D0
02:0000136E 205F            	   552:         MOVE.L  (SP)+,A0        ;Restaura A0
02:00001370 B03C001B        	   553:         CMP.B   #$1b,D0
02:00001374 6704            	   554:         BEQ     .fim
02:00001376 4EB81342        	   555:         JSR     UART_WriteChar
                            	   556: .fim
02:0000137A 4E75            	   557:         RTS
                            	   558: 
                            	   559: ; Lê caractere (retorna em D0)
                            	   560: UART_ReadCharNonEcho:
02:0000137C 2F08            	   561:         MOVE.L  A0,-(SP)        ; Preserva A0
02:0000137E 207900080010    	   562:         MOVE.L  CurrentUART,A0
                            	   563: .WaitRx:
02:00001384 08280000000A    	   564:         BTST    #0,LSR(A0)        ; RX ready?
02:0000138A 67F8            	   565:         BEQ     .WaitRx
                            	   566: 
02:0000138C 1010            	   567:         MOVE.B  RHR(A0),D0
02:0000138E 205F            	   568:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   569: 
02:00001390 4E75            	   570:         RTS
                            	   571: 
                            	   572: 
                            	   573: ; ----------------------------------------------------------------------
                            	   574: ; UART_WriteString - Envia string terminada em null para UART
                            	   575: ; Entrada:
                            	   576: ;   A0 = Ponteiro para a string (endereço da string)
                            	   577: ; ----------------------------------------------------------------------
                            	   578: UART_WriteString:
02:00001392 2F08            	   579:         MOVE.L  A0,-(SP)      ; Preserva D0
02:00001394 2F00            	   580:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   581: .WriteLoop:
02:00001396 1018            	   582:         MOVE.B  (A0)+,D0      ; Pega caractere
02:00001398 6706            	   583:         BEQ     .Done
02:0000139A 4EB81342        	   584:         JSR     UART_WriteChar ; Use sua rotine existente
02:0000139E 60F6            	   585:         BRA     .WriteLoop
                            	   586: .Done:
02:000013A0 201F            	   587:         MOVE.L  (SP)+,D0
02:000013A2 205F            	   588:         MOVE.L  (SP)+,A0
02:000013A4 4E75            	   589:         RTS
                            	   590: 
                            	   591: ; ----------------------------------------------------------------------
                            	   592: ; Constantes
                            	   593: ; ----------------------------------------------------------------------
                            	   594: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   595: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   596:                               ; BAUD_DIV_L em $70000
                            	   597:                               ; BAUD_DIV_U em $70001
                            	   598: 
                            	   599: ; ----------------------------------------------------------------------
                            	   600: ; Rotina: Calcula e armazena divisor de baud rate
                            	   601: ; Entrada:
                            	   602: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   603: ; Saída:
                            	   604: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   605: ; Formulas:
                            	   606: ;
                            	   607: ;
                            	   608: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   609: ; ----------------------------------------------------------------------
                            	   610: 
                            	   611: CALCBAUDDIV:
                            	   612: ;[ Registrador D0 (32 bits) ]
                            	   613: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   614: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   615:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   616:         ;((F_CPU/16)/10)
                            	   617:         ;F_CPU = 16000000 ou 0xF42400
02:000013A6 203C00F42400    	   618:         MOVE.L  #F_CPU,D0
02:000013AC 323C0010        	   619:         MOVE.W  #16,D1         ; Divisor
02:000013B0 61000096        	   620:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   621: ;1
02:000013B4 2F00            	   622:         move.l  d0,-(SP)
02:000013B6 4EB815B0        	   623:         jsr     PrintHexAddress
02:000013BA 4EB81432        	   624:         jsr     new_line
02:000013BE 201F            	   625:         move.l  (SP)+,d0
                            	   626: 
02:000013C0 323C000A        	   627:         MOVE.W  #10,D1         ; Divisor
02:000013C4 61000082        	   628:         BSR     Div32x16       ; D0 = 0x186A0
                            	   629: ;2
02:000013C8 2F00            	   630:         move.l  d0,-(SP)
02:000013CA 4EB815B0        	   631:         jsr     PrintHexAddress
02:000013CE 4EB81432        	   632:         jsr     new_line
02:000013D2 201F            	   633:         move.l  (SP)+,d0
                            	   634: 
                            	   635:         ;(BAUD/10)
02:000013D4 2F00            	   636:         move.l  d0,-(SP)
                            	   637: ;3
02:000013D6 7000            	   638:         CLR.L   D0
02:000013D8 303900080014    	   639:         MOVE.W  CurrentBaudRate,D0
02:000013DE 2F00            	   640:         move.l  d0,-(SP)
02:000013E0 4EB815B0        	   641:         jsr     PrintHexAddress
02:000013E4 4EB81432        	   642:         jsr     new_line
02:000013E8 201F            	   643:         move.l  (SP)+,d0
                            	   644: 
02:000013EA 123C000A        	   645:         MOVE.B  #10,D1
02:000013EE 6158            	   646:         BSR     Div32x16
                            	   647: 
                            	   648: ;4
02:000013F0 2F00            	   649:         move.l  d0,-(SP)
02:000013F2 4EB815B0        	   650:         jsr     PrintHexAddress
02:000013F6 4EB81432        	   651:         jsr     new_line
02:000013FA 221F            	   652:         move.l  (SP)+,D1
02:000013FC 201F            	   653:         move.l  (SP)+,D0
                            	   654: 
                            	   655: 
                            	   656:         ;(F_CPU/BAUD)
02:000013FE 6148            	   657:         BSR     Div32x16
                            	   658: ;5
02:00001400 2F00            	   659:         move.l  d0,-(SP)
02:00001402 4EB815B0        	   660:         jsr     PrintHexAddress
02:00001406 4EB81432        	   661:         jsr     new_line
02:0000140A 201F            	   662:         move.l  (SP)+,d0
                            	   663: 
                            	   664:         ; 4. Separa parte alta/baixa corretamente
02:0000140C 3200            	   665:         MOVE.W  D0,D1
02:0000140E 024000FF        	   666:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
02:00001412 E049            	   667:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
02:00001414 024100FF        	   668:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   669: 
                            	   670:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
02:00001418 41F90008001A    	   671:         LEA     Baud1DivL,A0
02:0000141E 3080            	   672:         MOVE.W  D0,(A0)        ; 16 bits suficientes
02:00001420 41F90008001C    	   673:         LEA     Baud1DivH,A0
02:00001426 3081            	   674:         MOVE.W  D1,(A0)
                            	   675: 
02:00001428 6000FCA0        	   676:         BRA     MenuLoop
02:0000142C 4E75            	   677:         RTS
                            	   678: .BaudError:
02:0000142E 6000FBD0        	   679:         BRA     _start
                            	   680: 
                            	   681: new_line:
02:00001432 2F00            	   682:         MOVE.L  D0,-(SP)          ; Salva D0
02:00001434 103C000A        	   683:         MOVE.B  #10,D0
02:00001438 4EB81342        	   684:         JSR     UART_WriteChar
02:0000143C 103C000D        	   685:         MOVE.B  #13,D0
02:00001440 4EB81342        	   686:         JSR     UART_WriteChar
02:00001444 201F            	   687:         MOVE.L  (SP)+,D0          ; Restaura D0
02:00001446 4E75            	   688:         RTS
                            	   689: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   690: ; Retorna D0 = Quociente, D1 = Resto
                            	   691: Div32x16:
02:00001448 7400            	   692:         MOVEQ   #0,D2       ; D2 = Quociente
02:0000144A 761F            	   693:         MOVEQ   #31,D3      ; 32 iterações
                            	   694: DivLoop:
02:0000144C E388            	   695:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
02:0000144E E392            	   696:         ROXL.L  #1,D2       ; Desloca D2 com Carry
02:00001450 B441            	   697:         CMP.W   D1,D2       ; D2 >= D1?
02:00001452 6D04            	   698:         BLT     .skip
02:00001454 9441            	   699:         SUB.W   D1,D2       ; Sim, subtrai
02:00001456 5280            	   700:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   701: .skip:
02:00001458 51CBFFF2        	   702:         DBRA    D3,DivLoop  ; Repete
02:0000145C 2202            	   703:         MOVE.L  D2,D1       ; Resto em D1
02:0000145E 4E75            	   704:         RTS
                            	   705: ; Versão compacta sem stack frame
                            	   706: PrintHexFast:
02:00001460 2F02            	   707:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001462 2F00            	   708:         MOVE.L  D0,-(SP)          ; Salva D0 original
02:00001464 7407            	   709:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   710: 
                            	   711: .Loop:
02:00001466 2017            	   712:         MOVE.L  (SP),D0           ; Recupera valor original
02:00001468 E998            	   713:         ROL.L   #4,D0             ; Pega próximo nibble
02:0000146A 2E80            	   714:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
02:0000146C 0200000F        	   715:         ANDI.B  #$F,D0            ; Isola nibble
                            	   716: 
02:00001470 B03C0009        	   717:         CMP.B   #9,D0
02:00001474 6302            	   718:         BLS     .Digit
02:00001476 5E00            	   719:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   720: .Digit:
02:00001478 D03C0030        	   721:         ADD.B   #'0',D0           ; Converte para ASCII
02:0000147C 4EB81342        	   722:         JSR     UART_WriteChar    ; Envia caractere
                            	   723: 
02:00001480 51CAFFE4        	   724:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   725: 
02:00001484 588F            	   726:         ADDQ.L  #4,SP             ; Remove valor salvo
02:00001486 241F            	   727:         MOVE.L  (SP)+,D2          ; Restaura D2
02:00001488 4E75            	   728:         RTS
                            	   729: 
                            	   730: ; ----------------------------------------------------------------------
                            	   731: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   732: ; Entrada:
                            	   733: ;   D0.L = Valor a ser impresso (32 bits)
                            	   734: ;   D1.W = Número de dígitos (1-8)
                            	   735: ; ----------------------------------------------------------------------
                            	   736: PrintHexPRECISA_DE_REVISAO:
02:0000148A 4E56FFF8        	   737:         LINK    A6,#-8            ; Reserva espaço na pilha
02:0000148E 2F02            	   738:         MOVE.L  D2,-(SP)          ; Salva D2
02:00001490 2D40FFFC        	   739:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
02:00001494 3D41FFFA        	   740:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   741: 
02:00001498 323C0008        	   742:         MOVE.W  #$0008,D1
                            	   743: 
                            	   744:         ; Ajusta para começar pelo dígito mais significativo
02:0000149C E549            	   745:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
02:0000149E 5941            	   746:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   747: 
                            	   748: .PrintLoop:
02:000014A0 202EFFFC        	   749:         MOVE.L  -4(A6),D0         ; Recupera valor
02:000014A4 3401            	   750:         MOVE.W  D1,D2             ; Posição do nibble
02:000014A6 E5B8            	   751:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
02:000014A8 02800000000F    	   752:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   753: 
                            	   754:         ; Converte para ASCII
02:000014AE B03C0009        	   755:         CMP.B   #9,D0
02:000014B2 6302            	   756:         BLS     .Decimal
02:000014B4 5E00            	   757:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   758: .Decimal:
02:000014B6 D03C0030        	   759:         ADD.B   #'0',D0           ; Converte para caractere
                            	   760: 
                            	   761:         ; Imprime caractere
02:000014BA 4EB81342        	   762:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   763: 
02:000014BE 5941            	   764:         SUBQ.W  #4,D1             ; Próximo nibble
02:000014C0 6ADE            	   765:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   766: 
                            	   767:         ; Espaço final para separação
02:000014C2 103C0020        	   768:         MOVE.B  #' ',D0
02:000014C6 4EB81342        	   769:         JSR     UART_WriteChar
                            	   770: 
02:000014CA 241F            	   771:         MOVE.L  (SP)+,D2          ; Restaura D2
02:000014CC 4E5E            	   772:         UNLK    A6                ; Restaura frame
02:000014CE 4E75            	   773:         RTS
                            	   774: 
                            	   775: ; ----------------------------------------------------------------------
                            	   776: ; MemDump - Imprime dump de memória formatado
                            	   777: ; Entrada:
                            	   778: ;   A0 = Endereço inicial (ex: $80000)
                            	   779: ;   D0 = Quantidade de bytes (ex: 256)
                            	   780: ; ----------------------------------------------------------------------
                            	   781: MEMDUMP:
02:000014D0 41F90000000D    	   782:         LEA     DumpHeader,A0
02:000014D6 4EB81392        	   783:         JSR     UART_WriteString
02:000014DA 207900080022    	   784:         MOVE.L  (addressInHex),A0
02:000014E0 2008            	   785:         MOVE.L  A0,D0
02:000014E2 4EB815B0        	   786:         JSR     PrintHexAddress
02:000014E6 4EB81432        	   787:         JSR     new_line
                            	   788: 
02:000014EA 41F900000020    	   789:         LEA     DumpHeader1,A0
02:000014F0 4EB81392        	   790:         JSR     UART_WriteString
                            	   791: 
02:000014F4 207900080022    	   792:         MOVE.L  (addressInHex),A0
                            	   793:         ; Calcula endereço final
                            	   794: 
                            	   795: DUMPLOOPMASTER:
02:000014FA 7200            	   796:         CLR.L   D1
02:000014FC 2208            	   797:         MOVE.L  A0,D1
02:000014FE 0681000000FF    	   798:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   799:         ;MOVE.L  D1,D0
                            	   800:         ;JSR     PrintHexAddress
                            	   801:         ;JSR     new_line
                            	   802: 
                            	   803:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   804:         ;JSR     UART_ReadChar
                            	   805: 
                            	   806: 
                            	   807: DumpLoop:
                            	   808:         ; Nova linha a cada 16 bytes
02:00001504 2008            	   809:         MOVE.L  A0,D0
02:00001506 02800000000F    	   810:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
02:0000150C 6616            	   811:         BNE     NoNewLine
                            	   812: 
                            	   813:         ; Imprime endereço
02:0000150E 2008            	   814:         MOVE.L  A0,D0
02:00001510 4EB815B0        	   815:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   816: 
02:00001514 103C003A        	   817:         MOVE.B  #':',D0
02:00001518 4EB81342        	   818:         JSR     UART_WriteChar
02:0000151C 103C0020        	   819:         MOVE.B  #' ',D0
02:00001520 4EB81342        	   820:         JSR     UART_WriteChar
                            	   821: 
                            	   822: NoNewLine:
                            	   823:         ; Imprime byte em hex
02:00001524 1018            	   824:         MOVE.B  (A0)+,D0
02:00001526 4EB815C0        	   825:         JSR     PrintByteHex
                            	   826: 
02:0000152A 103C0020        	   827:         MOVE.B  #' ',D0
02:0000152E 4EB81342        	   828:         JSR     UART_WriteChar
                            	   829: 
                            	   830:         ; Verifica fim da linha (16 bytes)
02:00001532 2008            	   831:         MOVE.L  A0,D0
02:00001534 02800000000F    	   832:         ANDI.L  #$0000000F,D0
02:0000153A 664E            	   833:         BNE     NoEndLine
                            	   834: 
                            	   835:         ; Imprime caracteres ASCII
02:0000153C 103C0020        	   836:         MOVE.B  #' ',D0
02:00001540 4EB81342        	   837:         JSR     UART_WriteChar
02:00001544 103C007C        	   838:         MOVE.B  #'|',D0
02:00001548 4EB81342        	   839:         JSR     UART_WriteChar
                            	   840: 
02:0000154C 43E8FFF0        	   841:         LEA     -16(A0),A1        ; Volta ao início da linha
02:00001550 740F            	   842:         MOVEQ   #15,D2            ; 16 caracteres
                            	   843: 
                            	   844: AsciiLoop:
02:00001552 1019            	   845:         MOVE.B  (A1)+,D0
02:00001554 B03C0020        	   846:         CMP.B   #32,D0            ; Verifica se é imprimível
02:00001558 6D0C            	   847:         BLT     NonPrintable
02:0000155A B03C007E        	   848:         CMP.B   #126,D0
02:0000155E 6E06            	   849:         BGT     NonPrintable
                            	   850: 
02:00001560 4EB81342        	   851:         JSR     UART_WriteChar
02:00001564 6008            	   852:         BRA     NextAscii
                            	   853: 
                            	   854: NonPrintable:
02:00001566 103C002E        	   855:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
02:0000156A 4EB81342        	   856:         JSR     UART_WriteChar
                            	   857: 
                            	   858: NextAscii:
02:0000156E 51CAFFE2        	   859:         DBRA    D2,AsciiLoop
                            	   860: 
02:00001572 103C007C        	   861:         MOVE.B  #'|',D0
02:00001576 4EB81342        	   862:         JSR     UART_WriteChar
02:0000157A 103C000D        	   863:         MOVE.B  #13,D0            ; CR
02:0000157E 4EB81342        	   864:         JSR     UART_WriteChar
02:00001582 103C000A        	   865:         MOVE.B  #10,D0            ; LF
02:00001586 4EB81342        	   866:         JSR     UART_WriteChar
                            	   867: 
                            	   868: NoEndLine:
                            	   869:         ; Verifica fim do dump
02:0000158A B1C1            	   870:         CMP.L   D1,A0
02:0000158C 6300FF76        	   871:         BLS     DumpLoop
                            	   872: 
02:00001590 2F08            	   873:         MOVE.L  A0,-(SP)          ; Salva endereço atual
02:00001592 41F9000004A5    	   874:         LEA     HitAnyKey,A0
02:00001598 4EB81392        	   875:         JSR     UART_WriteString
02:0000159C 4EB8135C        	   876:         JSR     UART_ReadChar
02:000015A0 B03C001B        	   877:         CMP.B   #$1B,D0
02:000015A4 6706            	   878:         BEQ     .fim
                            	   879: 
02:000015A6 205F            	   880:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
02:000015A8 6000FF50        	   881:         BRA     DUMPLOOPMASTER
                            	   882: .fim
02:000015AC 6000FB1C        	   883:         BRA     MenuLoop
