                            	  1087: ;--------------------------------------------------
                            	  1088: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	  1089: ;--------------------------------------------------
                            	  1090: ; Exemplo: insere 'A' no buffer
                            	  1091: ;          MOVE.B  #'A',D0
                            	  1092: ;          JSR     UART_BufferPut
                            	  1093: 
                            	  1094: BufferPut:
02:0000175E 2F01            	  1095:         MOVE.L  D1,-(SP)
02:00001760 2F08            	  1096:         MOVE.L  A0,-(SP)
                            	  1097: 
                            	  1098:         ;ANDI.W    #$FF00,D0
02:00001762 41F900080030    	  1099:         LEA     BUFFER,A0
02:00001768 32390008002E    	  1100:         MOVE.W  BUFFER_COUNT,D1
                            	  1101: 
02:0000176E B27C0100        	  1102:         CMP.W   #256,D1
02:00001772 6C1C            	  1103:         BGE     .BufferFull
                            	  1104: 
                            	  1105:         ; Modificado para usar deslocamento de 16 bits
02:00001774 323900080026    	  1106:         MOVE.W  BUFFER_HEAD,D1
02:0000177A D0C1            	  1107:         ADD     D1,A0
02:0000177C 1080            	  1108:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1109: 
02:0000177E 5441            	  1110:         ADD     #2,D1              ; Incrementa como word
02:00001780 024100FF        	  1111:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:00001784 33C100080026    	  1112:         MOVE.W  D1,BUFFER_HEAD
                            	  1113: 
02:0000178A 52790008002E    	  1114:         ADDQ.W  #1,BUFFER_COUNT
                            	  1115: 
                            	  1116: .BufferFull:
02:00001790 205F            	  1117:         MOVE.L  (SP)+,A0
02:00001792 221F            	  1118:         MOVE.L  (SP)+,D1
                            	  1119: 
02:00001794 4E75            	  1120:         RTS
                            	  1121: 
                            	  1122: ;--------------------------------------------------
                            	  1123: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	  1124: ;--------------------------------------------------
                            	  1125: ;Exemplo: Lendo byte do buffer
                            	  1126: ;         BSR     UART_BufferGet
                            	  1127: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	  1128: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	  1129: ;         Senão, D0 contém o byte lido!
                            	  1130: BufferGet:
02:00001796 2F01            	  1131:         MOVE.L  D1,-(SP)
02:00001798 2F08            	  1132:         MOVE.L  A0,-(SP)
                            	  1133: 
02:0000179A 32390008002E    	  1134:         MOVE.W  BUFFER_COUNT,D1
02:000017A0 6724            	  1135:         BEQ     .BufferEmpty
                            	  1136: 
02:000017A2 41F900080030    	  1137:         LEA     BUFFER,A0
                            	  1138: 
                            	  1139:         ; Modificado para usar deslocamento de 16 bits
02:000017A8 32390008002A    	  1140:         MOVE.W  BUFFER_TAIL,D1
02:000017AE 10301000        	  1141:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1142: 
02:000017B2 5401            	  1143:         ADDQ.B  #2,D1              ; Incrementa como word
02:000017B4 024100FF        	  1144:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:000017B8 33C10008002A    	  1145:         MOVE.W  D1,BUFFER_TAIL
                            	  1146: 
02:000017BE 53790008002E    	  1147:         SUBQ.W  #1,BUFFER_COUNT
02:000017C4 6006            	  1148:         BRA     .Exit
                            	  1149: 
                            	  1150: .BufferEmpty:
02:000017C6 4EB817D2        	  1151:         JSR     FBufferEmpty
02:000017CA 70FF            	  1152:         MOVEQ   #-1,D0
                            	  1153: .Exit:
02:000017CC 205F            	  1154:         MOVE.L  (SP)+,A0
02:000017CE 221F            	  1155:         MOVE.L  (SP)+,D1
02:000017D0 4E75            	  1156:         RTS
                            	  1157: 
                            	  1158: FBufferEmpty:
02:000017D2 4EB813A8        	  1159:         JSR     new_line
02:000017D6 41F9000003A7    	  1160:         LEA     BufferEmpty,A0
02:000017DC 4EB81308        	  1161:         JSR     UART_WriteString
02:000017E0 4EB813A8        	  1162:         JSR     new_line
02:000017E4 4E75            	  1163:         RTS
                            	  1164: ;---------------------------------------------------------------------
                            	  1165: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1166: ;---------------------------------------------------------------------
                            	  1167: ClearBufferPointers:
02:000017E6 23FC000000000008	  1168:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
02:000017EE 0026
02:000017F0 23FC000000000008	  1169:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
02:000017F8 002A
02:000017FA 33FC00000008002E	  1170:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
02:00001802 4E75            	  1171:         RTS
                            	  1172: ;---------------------------------------------------------------------
                            	  1173: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1174: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1175: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1176: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1177: ;---------------------------------------------------------------------
                            	  1178: MontaAddress:
02:00001804 48E73C80        	  1179:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1180: 
                            	  1181:         ; Verifica se há pelo menos 8 bytes no buffer
02:00001808 32390008002E    	  1182:         MOVE.W  BUFFER_COUNT,D1
02:0000180E B27C0008        	  1183:         CMP.W   #8,D1
02:00001812 6D38            	  1184:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1185: 
02:00001814 41F900080030    	  1186:         LEA     BUFFER,A0      ; A0 = base do buffer
02:0000181A 24390008002A    	  1187:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
02:00001820 7000            	  1188:         CLR.L   D0                ; Zera D0 (resultado final)
02:00001822 7607            	  1189:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1190: 
                            	  1191: .ReadLoop:
02:00001824 18302800        	  1192:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
02:00001828 0204000F        	  1193:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1194: 
                            	  1195:         ; Desloca e insere os 4 bits em D0
02:0000182C E988            	  1196:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
02:0000182E 8004            	  1197:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1198: 
                            	  1199:         ; Atualiza tail (circular)
02:00001830 5282            	  1200:         ADDQ.L  #1,D2
02:00001832 0282000000FF    	  1201:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1202: 
02:00001838 51CBFFEA        	  1203:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1204: 
                            	  1205:         ; Atualiza ponteiros globais
02:0000183C 23C20008002A    	  1206:         MOVE.L  D2,BUFFER_TAIL
02:00001842 51790008002E    	  1207:         SUB.W   #8,BUFFER_COUNT
                            	  1208: 
02:00001848 7200            	  1209:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
02:0000184A 6004            	  1210:         BRA     .Exit
                            	  1211: 
                            	  1212: .BufferUnderrun:
02:0000184C 72FF            	  1213:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
02:0000184E 7000            	  1214:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1215: 
                            	  1216: .Exit:
02:00001850 4CDF013C        	  1217:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
02:00001854 4E75            	  1218:         RTS
                            	  1219: 
02:00001856 706473696C766120	  1220:         DC.B "pdsilva AKA pgordao"
02:0000185E 414B412070676F72
02:00001866 64616F
                            	  1221:         ALIGN 2
                            	  1222: ; =====================================================================
                            	  1223: ; XMODEM RECEIVER ROUTINE
                            	  1224: ;bloco.append(0x01);        // SOH
                            	  1225: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1226: ;bloco.append(255 - blockNumber); // Complemento
                            	  1227: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1228: ;bloco.append(checksum);    // Checksum calculado
                            	  1229: ; =====================================================================
                            	  1230: XMODEM_Receive:
02:0000186C 48E73FFE        	  1231:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1232:        ; Inicializa variáveis
02:00001870 41F900080331    	  1233:        LEA     expected_block,A0
02:00001876 103C0001        	  1234:        MOVE.B  #1,D0
02:0000187A 1080            	  1235:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
02:0000187C 41F900080130    	  1236:        LEA     xmodem_buffer,A0
                            	  1237: 
02:00001882 41F900080532    	  1238:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:00001888 103C0000        	  1239:        MOVE.B  #0,D0
02:0000188C 1080            	  1240:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1241: 
                            	  1242:        ; ---- 1. INICIALIZAÇÃO ----
02:0000188E 103C0015        	  1243:        MOVE.B  #NAK,D0
02:00001892 4EB812B8        	  1244:        JSR     UART_WriteChar      ; Solicita início
                            	  1245: 
                            	  1246:        ;SINALIZA NACK SENT
02:00001896 303C0800        	  1247:        MOVE.W  #$0800,D0
02:0000189A 4EB81250        	  1248:        JSR     __write_leds
                            	  1249: 
                            	  1250:        ;LEA   pgm_buffer,A2   ; Destino (garanta alinhamento em 4 bytes)
02:0000189E 45F900082000    	  1251:        LEA   $00082000,A2   ; Destino (garanta alinhamento em 4 bytes)
                            	  1252: 
                            	  1253:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1254: Receive_Loop:
02:000018A4 4EB812F2        	  1255:        JSR     UART_ReadCharNonEcho
                            	  1256: 
02:000018A8 B03C0004        	  1257:        CMP.B   #EOT,D0
02:000018AC 670000AE        	  1258:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1259: 
02:000018B0 B03C0001        	  1260:        CMP.B   #SOH,D0
02:000018B4 66EE            	  1261:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1262: 
                            	  1263:        ;SINALIZA leds
02:000018B6 303C0C00        	  1264:        MOVE.W  #$0C00,D0
02:000018BA 4EB81250        	  1265:        JSR     __write_leds
                            	  1266: 
                            	  1267:        ; ---- 3. RECEBE HEADER ----
02:000018BE 4EB812F2        	  1268:        JSR     UART_ReadCharNonEcho       ; Block number
02:000018C2 13C000080330    	  1269:        MOVE.B  D0,block_number
                            	  1270: 
02:000018C8 4EB812F2        	  1271:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1272: 
                            	  1273:        ;SINALIZA leds
02:000018CC 303C0800        	  1274:        MOVE.W  #$0800,D0
02:000018D0 4EB81250        	  1275:        JSR     __write_leds
                            	  1276: 
                            	  1277:        ; ---- 4. RECEBE DADOS ----
02:000018D4 7220            	  1278:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
02:000018D6 43F900080130    	  1279:        LEA     xmodem_buffer,A1
                            	  1280: Read_Loop:
                            	  1281:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
02:000018DC 4EB812F2        	  1282:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
02:000018E0 E188            	  1283:        LSL.L   #8,D0
02:000018E2 4EB812F2        	  1284:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
02:000018E6 E188            	  1285:        LSL.L   #8,D0
02:000018E8 4EB812F2        	  1286:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
02:000018EC E188            	  1287:        LSL.L   #8,D0
02:000018EE 4EB812F2        	  1288:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
02:000018F2 22C0            	  1289:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
02:000018F4 5381            	  1290:        SUBQ.L  #1,D1
02:000018F6 66E4            	  1291:        BNE     Read_Loop
                            	  1292: 
02:000018F8 303C0600        	  1293:        MOVE.W  #$0600,D0
02:000018FC 4EB81250        	  1294:        JSR     __write_leds
                            	  1295: 
                            	  1296:        ; ---- 5. VERIFICA CHECKSUM ----
02:00001900 4EB812F2        	  1297:        JSR     UART_ReadCharNonEcho       ; Checksum
02:00001904 1400            	  1298:        MOVE.B  D0,D2
                            	  1299: 
                            	  1300: 
                            	  1301: ;******************************************************************************************
                            	  1302:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1303:            ;     BRA     Send_ACK
                            	  1304: ;******************************************************************************************
                            	  1305: 
                            	  1306:         ; Calcula checksum local
02:00001906 43F900080130    	  1307:         LEA     xmodem_buffer,A1
02:0000190C 323C007F        	  1308:         MOVE.W  #127,D1
02:00001910 7600            	  1309:         CLR.L   D3
                            	  1310: 
                            	  1311: Calc_Checksum:
02:00001912 D619            	  1312:         ADD.B   (A1)+,D3
02:00001914 51C9FFFC        	  1313:         DBF     D1,Calc_Checksum;
                            	  1314: 
02:00001918 B602            	  1315:         CMP.B   D2,D3
02:0000191A 6634            	  1316:         BNE     Send_NAK            ; Erro no checksum
                            	  1317: 
                            	  1318:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1319:         ;MOVE.B  block_number,D0
                            	  1320:         ;CMP.B   expected_block,D0
                            	  1321:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1322: 
                            	  1323:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1324:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1325:         ; Exemplo: copiar do buffer para a RAM
                            	  1326:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
02:0000191C 43F900080130    	  1327:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
02:00001922 7220            	  1328:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1329: Copy_Data:
02:00001924 24D9            	  1330:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
02:00001926 5381            	  1331:         SUBQ.L  #1,D1               ; Decrementa contador
02:00001928 66FA            	  1332:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1333: 
                            	  1334:         ; ---- 8. CONFIMA RECEPÇÃO ----
02:0000192A 523900080331    	  1335:         ADDQ.B  #1,expected_block   ; Próximo bloco
02:00001930 103C0006        	  1336:         MOVE.B  #ACK,D0
02:00001934 4EB812B8        	  1337:         JSR     UART_WriteChar
02:00001938 6000FF6A        	  1338:         BRA     Receive_Loop
                            	  1339: 
                            	  1340: Send_ACK:
                            	  1341:         ;SINALIZA NACK SENT
02:0000193C 303C0400        	  1342:         MOVE.W  #$0400,D0
02:00001940 4EB81250        	  1343:         JSR     __write_leds
02:00001944 103C0006        	  1344:         MOVE.B  #ACK,D0
02:00001948 4EB812B8        	  1345:         JSR     UART_WriteChar
02:0000194C 6000FF56        	  1346:         BRA     Receive_Loop
                            	  1347: 
                            	  1348: Send_NAK:
02:00001950 103C0015        	  1349:         MOVE.B  #NAK,D0
02:00001954 4EB812B8        	  1350:         JSR     UART_WriteChar
02:00001958 6000FF4A        	  1351:         BRA     Receive_Loop
                            	  1352: 
                            	  1353: Transfer_Complete:
02:0000195C 103C0006        	  1354:         MOVE.B  #ACK,D0             ; Confirma EOT
02:00001960 4EB812B8        	  1355:         JSR     UART_WriteChar
                            	  1356: 
02:00001964 41F900080532    	  1357:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
02:0000196A 103C0001        	  1358:         MOVE.B  #1,D0
02:0000196E 1080            	  1359:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1360: 
02:00001970 4CDF7FFC        	  1361:         MOVEM.L (SP)+,D2-D7/A0-A6
02:00001974 4E75            	  1362:         RTS
                            	  1363: ; ========================================================
                            	  1364: ; Validador de Checksum para ROM (MC68000)
                            	  1365: ; Assume:
                            	  1366: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1367: ;   - Big-endian (padrão 68000)
                            	  1368: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1369: ; ========================================================
                            	  1370: 
                            	  1371: VALIDATE_ROM:
02:00001976 91C8            	  1372:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001978 203C00003FFC    	  1373:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:0000197E 7200            	  1374:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1375: 
                            	  1376:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1377: .CHECKSUM_LOOP:
02:00001980 2418            	  1378:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001982 D282            	  1379:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001984 5980            	  1380:         SUB.L   #4,D0               ; Decrementa contador
02:00001986 6EF8            	  1381:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1382: 
02:00001988 41F900080540    	  1383:         LEA     checksum_calc,A0
02:0000198E 20C1            	  1384:         MOVE.L  D1,(A0)+
                            	  1385:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1386: 
                            	  1387:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001990 24383FFC        	  1388:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:00001994 B481            	  1389:         CMP.L   D1,D2               ; Combina com o calculado?
02:00001996 6706            	  1390:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1391: 
                            	  1392:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:00001998 363CDEAD        	  1393:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:0000199C 6002            	  1394:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1395: .CHECKSUM_OK:
02:0000199E 4E75            	  1396:         RTS                         ; Retorna (ROM válida)
                            	  1397: 
                            	  1398: 
                            	  1399: SYSTEM_HALT:
02:000019A0 46FC2700        	  1400:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1401: .INFINITE_LOOP:
02:000019A4 60FE            	  1402:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1403: 
                            	  1404: 
                            	  1405: 
                            	  1406: ; --- Constantes ---
                            	  1407: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1408: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1409: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1410: 
                            	  1411: ;;;EXCEPTIONS**********************************************************
                            	  1412: ;**********************************************************************
