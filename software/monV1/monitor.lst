                            	  1108:         ; Modificado para usar deslocamento de 16 bits
02:0000178A 323900080026    	  1109:         MOVE.W  BUFFER_HEAD,D1
02:00001790 D0C1            	  1110:         ADD     D1,A0
02:00001792 1080            	  1111:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	  1112: 
02:00001794 5441            	  1113:         ADD     #2,D1              ; Incrementa como word
02:00001796 024100FF        	  1114:         ANDI.W  #255,D1            ; Mantém no range 0-255
02:0000179A 33C100080026    	  1115:         MOVE.W  D1,BUFFER_HEAD
                            	  1116: 
02:000017A0 52790008002E    	  1117:         ADDQ.W  #1,BUFFER_COUNT
                            	  1118: 
                            	  1119: .BufferFull:
02:000017A6 205F            	  1120:         MOVE.L  (SP)+,A0
02:000017A8 221F            	  1121:         MOVE.L  (SP)+,D1
                            	  1122: 
02:000017AA 4E75            	  1123:         RTS
