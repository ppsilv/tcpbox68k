                            	   282: ; ******************************************************************
                            	   283: ; * timer_init - Inicializa o timer 8253                           *
                            	   284: ; * Configura canal 0: modo 3, 16-bit, binary                      *
                            	   285: ; * Entrada: Nenhuma                                               *
                            	   286: ; * Saída: Nenhuma                                                 *
                            	   287: ; * Destrói: D0                                                    *
                            	   288: ; ******************************************************************
                            	   289: 
                            	   290: INIT_8253:
                            	   291:     ;MOVEM.L D0-D1/A0,-(SP)
                            	   292:         ; Configurar canal 0: modo 3, 16-bit, binary
02:00001192 11FC00364606    	   293:         MOVE.B  #CONFIG_VALUE,TIMER_CTRL   ; 12 ciclos - escreve no registrador de controle
                            	   294: 
                            	   295:         ; Inicializar contador com valor máximo temporariamente
02:00001198 11FC00FF4600    	   296:         MOVE.B  #$FF,TIMER0_COUNT          ; 12 ciclos - LSB = 0xFF
02:0000119E 11FC00FF4600    	   297:         MOVE.B  #$FF,TIMER0_COUNT          ; 12 ciclos - MSB = 0xFF
                            	   298: 
                            	   299:     ;MOVEM.L (SP)+,D0-D1/A0
02:000011A4 4E75            	   300:     RTS
                            	   301: ; ******************************************************************
                            	   302: ; * timer_set_10ms_tick - Configura timer para tick de 10ms        *
                            	   303: ; * Assume clock de 1MHz: 1000000 * 0.01 = 10000 ticks             *
                            	   304: ; * Entrada: Nenhuma                                               *
                            	   305: ; * Saída: Nenhuma                                                 *
                            	   306: ; * Destrói: D0                                                    *
                            	   307: ; ******************************************************************
                            	   308: ;        xdef _timer_set_10ms_tick
                            	   309: TIMER_SET_10MS_TICK:
                            	   310: 
                            	   311:         ; Configurar canal 0: modo 3, 16-bit, binary
02:000011A6 11FC00364606    	   312:         MOVE.B  #CONFIG_VALUE,TIMER_CTRL   ; 12 ciclos - escreve no registrador de controle
                            	   313: 
                            	   314:         ; Escrever valor do contador (LSB primeiro, depois MSB)
02:000011AC 11FC00D04600    	   315:         move.b  #COUNT_VALUE&$FF,TIMER0_COUNT    ; LSB
02:000011B2 11FC00074600    	   316:         move.b  #(COUNT_VALUE>>8)&$FF,TIMER0_COUNT ; MSB
                            	   317: 
02:000011B8 4E75            	   318:         RTS                                ; 16 ciclos - retorna
                            	   319:                                            ; Total: ~52 ciclos
                            	   320: 
                            	   321: ; ==============================================
                            	   322: ; ROTINA QUE LÊ CONTADOR (PARA DEBUG)
                            	   323: ; ==============================================
                            	   324: READ_8253:
02:000011BA 48E7C080        	   325:     MOVEM.L D0-D1/A0,-(SP)
                            	   326: 
02:000011BE 20790008001E    	   327:     MOVE.L   CurrentTimer,A0
                            	   328:     ; --- LATCH DO CONTADOR ---
02:000011C4 117C00000003    	   329:     MOVE.B  #%00000000,+3(A0) ; Latch Count para Canal 0
                            	   330: 
                            	   331:     ; --- LÊ BYTE A BYTE ---
02:000011CA 1010            	   332:     MOVE.B  (A0),D0         ; Lê LSB
02:000011CC 0280000000FF    	   333:     ANDI.L  #$FF,D0          ; Isola byte
                            	   334: 
02:000011D2 1210            	   335:     MOVE.B  (A0),D1         ; Lê MSB
02:000011D4 0281000000FF    	   336:     ANDI.L  #$FF,D1
02:000011DA E149            	   337:     LSL.W   #8,D1            ; MSB para bits 15-8
02:000011DC 8041            	   338:     OR.W    D1,D0            ; Combina bytes (D0 = valor)
                            	   339: 
                            	   340:     ; Mostra valor
02:000011DE 4EB81526        	   341:     JSR     PrintHexAddress
                            	   342: 
02:000011E2 4CDF0103        	   343:     MOVEM.L (SP)+,D0-D1/A0
02:000011E6 6000FEDE        	   344:     BRA     MenuLoop
