                            	  1486: ; ========================================================
                            	  1487: ; Validador de Checksum para ROM (MC68000)
                            	  1488: ; Assume:
                            	  1489: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1490: ;   - Big-endian (padrão 68000)
                            	  1491: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1492: ; ========================================================
                            	  1493: 
                            	  1494: VALIDATE_ROM:
02:00001A6C 91C8            	  1495:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
02:00001A6E 203C00003FFC    	  1496:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
02:00001A74 7200            	  1497:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1498: 
                            	  1499:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1500: .CHECKSUM_LOOP:
02:00001A76 2418            	  1501:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
02:00001A78 D282            	  1502:         ADD.L   D2,D1               ; Soma ao acumulador
02:00001A7A 5980            	  1503:         SUB.L   #4,D0               ; Decrementa contador
02:00001A7C 6EF8            	  1504:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1505: 
02:00001A7E 41F900080540    	  1506:         LEA     checksum_calc,A0
02:00001A84 20C1            	  1507:         MOVE.L  D1,(A0)+
                            	  1508:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1509: 
                            	  1510:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
02:00001A86 24383FFC        	  1511:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
02:00001A8A B481            	  1512:         CMP.L   D1,D2               ; Combina com o calculado?
02:00001A8C 6706            	  1513:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1514: 
                            	  1515:         ; --- Checksum inválido: travar o sistema ou notificar ---
02:00001A8E 363CDEAD        	  1516:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
02:00001A92 6002            	  1517:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1518: .CHECKSUM_OK:
02:00001A94 4E75            	  1519:         RTS                         ; Retorna (ROM válida)
                            	  1520: 
                            	  1521: 
                            	  1522: SYSTEM_HALT:
02:00001A96 46FC2700        	  1523:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1524: .INFINITE_LOOP:
02:00001A9A 60FE            	  1525:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1526: 
                            	  1527: 
                            	  1528: 
                            	  1529: ; --- Constantes ---
                            	  1530: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1531: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1532: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1533: 
