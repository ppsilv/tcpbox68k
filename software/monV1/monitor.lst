                            	   399: ; ----------------------------------------------------------------------
                            	   400: ; Rotinas de E/S da UART
                            	   401: ; ----------------------------------------------------------------------
                            	   402: UART_Init:
                            	   403: UART_INIT:
02:0000129A 227900080010    	   404:         move.l   CurrentUART,a1
02:000012A0 137C000D0004    	   405:         move.b  #%00001101,FCR(a1)      ; enable FIFO
02:000012A6 137C00830006    	   406:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
02:000012AC 12BC0068        	   407:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
02:000012B0 137C00000002    	   408:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
02:000012B6 08A900070006    	   409:         bclr.b  #7,LCR(a1)              ; disable divisor latch
02:000012BC 4229000E        	   410:         clr.b   SCR(a1)                 ; clear the scratch register
02:000012C0 4E75            	   411:         RTS
                            	   412: 
                            	   413:     ; Escreve caractere (D0.B)
                            	   414: UART_WriteChar:
02:000012C2 2F08            	   415:         MOVE.L  A0,-(SP)        ; Preserva A0
02:000012C4 2F00            	   416:         MOVE.L  D0,-(SP)        ; Preserva D0
02:000012C6 207900080010    	   417:         move.l   CurrentUART,A0
                            	   418: .WaitTx:
02:000012CC 08280005000A    	   419:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
02:000012D2 67F8            	   420:         BEQ     .WaitTx
02:000012D4 1080            	   421:         MOVE.B  D0,THR(A0)      ; transmit byte
02:000012D6 201F            	   422:         MOVE.L  (SP)+,D0        ;Restaura D0
02:000012D8 205F            	   423:         MOVE.L  (SP)+,A0        ;Restaura A0
02:000012DA 4E75            	   424:         RTS
