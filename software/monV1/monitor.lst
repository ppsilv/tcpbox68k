                            	  1795: TRAP2_HANDLER:
                            	  1796: TRAP3_HANDLER:
                            	  1797: TRAP4_HANDLER:
                            	  1798: TRAP5_HANDLER:
                            	  1799: TRAP6_HANDLER:
                            	  1800: TRAP7_HANDLER:
                            	  1801: TRAP8_HANDLER:
                            	  1802: TRAP9_HANDLER:
                            	  1803: TRAPA_HANDLER:
                            	  1804: TRAPB_HANDLER:
                            	  1805: TRAPC_HANDLER:
                            	  1806: TRAPD_HANDLER:
                            	  1807: TRAPE_HANDLER:
                            	  1808: TRAPF_HANDLER:
02:00001D9A 4E73            	  1809:         RTE
                            	  1810: 
                            	  1811: ; --------------------------------
                            	  1812: ; Handler do TRAP #1
                            	  1813: ; Entrada:
                            	  1814: ;   D0.W - Número da função
                            	  1815: ;   D1.L - Parâmetro (para escrita)
                            	  1816: ; Saída:
                            	  1817: ;   D0.L - Resultado (para leitura)
                            	  1818: ; --------------------------------
                            	  1819: TRAP1_HANDLER:
02:00001D9C B07C0001        	  1820:     cmp.w   #1,d0         ; Compara com CCONIN (ler caractere)
02:00001DA0 6714            	  1821:     BEQ     trap_cconin    ; Se for 1, vai para leitura
02:00001DA2 B07C0002        	  1822:     cmp.w   #2,d0         ; Compara com CCONOUT (escrever caractere)
02:00001DA6 671A            	  1823:     BEQ     trap_cconout   ; Se for 2, vai para escrita
02:00001DA8 B07C0003        	  1824:     cmp.w   #3,d0         ; Compara com CCONOUT (escrever string)
02:00001DAC 6722            	  1825:     BEQ     trap_strout   ; Se for 2, vai para escrita
02:00001DAE 4A40            	  1826:     cmp.w   #0,d0         ; Compara com PTERM0 (terminar)
02:00001DB0 672C            	  1827:     BEQ     trap_pterm0    ; Se for 0, vai para terminar
02:00001DB2 70FF            	  1828:     move.l  #-1,d0        ; Retorna erro se função não reconhecida
02:00001DB4 4E73            	  1829:     RTE                   ; Retorna da exceção
                            	  1830: 
                            	  1831: 
                            	  1832: 
                            	  1833: ; --------------------------------
                            	  1834: ; TRAP_CCONIN - Ler caractere do console
                            	  1835: ; Saída: D0.L - Caractere lido
                            	  1836: ; --------------------------------
                            	  1837: trap_cconin:
02:00001DB6 4EB8137C        	  1838:     JSR         UART_ReadCharNonEcho
02:00001DBA 0280000000FF    	  1839:     ANDI.L      #$FF,D0       ; Mantém apenas o byte inferior
02:00001DC0 4E73            	  1840:     RTE                   ; Retorna da exceção
                            	  1841: 
                            	  1842: ; --------------------------------
                            	  1843: ; TRAP_CCONOUT - Escrever caractere no console
                            	  1844: ; Entrada: D1.L - Caractere a escrever
                            	  1845: ; --------------------------------
                            	  1846: trap_cconout:
02:00001DC2 0281000000FF    	  1847:     ANDI.L      #$FF,D1         ; Mantém apenas o byte inferior
02:00001DC8 1001            	  1848:     MOVE.B      D1,D0
02:00001DCA 4EB81342        	  1849:     JSR         UART_WriteChar
02:00001DCE 4E73            	  1850:     RTE                   ; Retorna da exceção
                            	  1851: 
                            	  1852: trap_strout:
02:00001DD0 1018            	  1853:     MOVE.B      (A0)+,D0
02:00001DD2 4A00            	  1854:     CMP.B       #0,D0
02:00001DD4 6706            	  1855:     BEQ         .fim
02:00001DD6 4EB81342        	  1856:     JSR         UART_WriteChar
02:00001DDA 60F4            	  1857:     BRA         trap_strout
                            	  1858: .fim:
02:00001DDC 4E73            	  1859:     RTE
                            	  1860: 
                            	  1861: ; --------------------------------
                            	  1862: ; TRAP_PTERM0 - Terminar programa
                            	  1863: ; --------------------------------
                            	  1864: trap_pterm0:
02:00001DDE 303C0000        	  1865:     move.w  #0,d0         ; Código de saída 0
02:00001DE2 6102            	  1866:     bsr     hardware_exit ; Chama rotina de término
02:00001DE4 4E73            	  1867:     RTE                   ; Retorna da exceção (nunca executado)
                            	  1868: 
                            	  1869: ; --------------------------------
                            	  1870: ; hardware_exit - Terminar execução
                            	  1871: ; Entrada: D0.W - Código de saída
                            	  1872: ; --------------------------------
                            	  1873: hardware_exit:
                            	  1874:     ; >>> ADAPTE PARA SUA PLACA <<<
                            	  1875:     ; Exemplo: parar o processador
                            	  1876:     ; stop    #$2700
                            	  1877: 
                            	  1878:     ; Exemplo simples: loop infinito
02:00001DE6 60FE            	  1879:     BRA     hardware_exit
02:00001DE8 4E75            	  1880:     RTS
                            	  1881: 
                            	  1882:     ALIGN 2
                            	  1883: ; =====================================================================
                            	  1884: ; END XMODEM RECEIVER ROUTINE
