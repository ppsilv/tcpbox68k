                            	  1194: ; XMODEM RECEIVER ROUTINE
                            	  1195: ;bloco.append(0x01);        // SOH
                            	  1196: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1197: ;bloco.append(255 - blockNumber); // Complemento
                            	  1198: ;bloco.append(dados);       // Seus 128 bytes de dados
