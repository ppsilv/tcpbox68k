                            	   309: DELAY_MS:
01:000011FC 2F01            	   310:         MOVE.L  d1,-(sp)          ; Salva D1
01:000011FE 3200            	   311:         MOVE.W  d0,d1             ; Contador de ms
01:00001200 670E            	   312:         BEQ.S   .end              ; Se D0=0, sai
                            	   313: .loop_ms:
01:00001202 203C00003E80    	   314:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   315: .inner_loop:
01:00001208 5380            	   316:         SUBQ.L  #1,d0             ; 4 ciclos
01:0000120A 66FC            	   317:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
01:0000120C 5341            	   318:         SUBQ.W  #1,d1             ; 1 ms
01:0000120E 66F2            	   319:         BNE.S   .loop_ms
                            	   320: .end:
01:00001210 221F            	   321:         MOVE.L  (sp)+,d1          ; Restaura D1
01:00001212 4E75            	   322:         rts
                            	   323: 
                            	   324: __write_leds:
01:00001214 31C04400        	   325:         MOVE.W  D0,LED_ADDRESS
01:00001218 4E75            	   326:         RTS
                            	   327: 
                            	   328: PISCA_LED:
01:0000121A 303CFF00        	   329:         MOVE.W  #$FF00,D0
01:0000121E 31C04400        	   330:         MOVE.W  D0,LED_ADDRESS
01:00001222 263C0007A120    	   331:         MOVE.L  #500000,D3
                            	   332: .DELAY1:
01:00001228 5383            	   333:         SUBQ.L  #1,D3
01:0000122A 66FC            	   334:         BNE     .DELAY1
01:0000122C 303C0000        	   335:         MOVE.W  #$0000,D0
01:00001230 31C04400        	   336:         MOVE.W  D0,LED_ADDRESS
01:00001234 6000FE8C        	   337:         BRA     MenuLoop
                            	   338: 
                            	   339: 
                            	   340: LED_INIT:
01:00001238 2F00            	   341:         MOVE.L  D0,-(SP)        ; Preserva D0
01:0000123A 31FCAA004400    	   342:         MOVE.W  #$AA00,LED_ADDRESS
                            	   343:         ;MOVE.W  D0,LED_ADDRESS
01:00001240 263C0003D090    	   344:         move.l  #250000,D3
                            	   345: .DELAY1:
01:00001246 5383            	   346:         SUBQ.L  #1,D3
01:00001248 66FC            	   347:         BNE     .DELAY1
01:0000124A 31FC00004400    	   348:         MOVE.W  #$0000,LED_ADDRESS
                            	   349:         ;MOVE.W  D0,LED_ADDRESS
01:00001250 201F            	   350:         MOVE.L  (SP)+,D0        ;Restaura D0
01:00001252 4E75            	   351:         RTS
