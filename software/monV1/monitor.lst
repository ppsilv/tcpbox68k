                            	   293: ; ******************************************************************
                            	   294: ; * timer_init - Inicializa o timer 8253                           *
                            	   295: ; * Configura canal 0: modo 3, 16-bit, binary                      *
                            	   296: ; * Entrada: Nenhuma                                               *
                            	   297: ; * Saída: Nenhuma                                                 *
                            	   298: ; * Destrói: D0                                                    *
                            	   299: ; ******************************************************************
                            	   300: 
                            	   301: ;------------------------------------------------------------------
                            	   302: ; Função: get_value
                            	   303: ; Entrada: D0 - índice (1 a 8)
                            	   304: ; Saída: D0 - valor correspondente do array
                            	   305: ; Preserva: Todos os registradores exceto D0
                            	   306: ; Para 230400 baud:
                            	   307: ; Divisor = 14745600 / (16 × 230400) = 4 (Formula correta)
                            	   308: ;------------------------------------------------------------------
                            	   309: valores:
02:00001198 0060            	   310:     dc.w    $0060, $0030, $0018, $0010, $0008, $0004, $0002, $0001
02:0000119A 0030
02:0000119C 0018
02:0000119E 0010
02:000011A0 0008
02:000011A2 0004
02:000011A4 0002
02:000011A6 0001
                            	   311: UART_Get_Value:
02:000011A8 B03C0001        	   312:     cmp.b   #1,D0           ; Verifica se índice >= 1
02:000011AC 6D10            	   313:     blt.s   .invalid_index
02:000011AE B03C0008        	   314:     cmp.b   #8,D0           ; Verifica se índice <= 8
02:000011B2 6E0A            	   315:     bgt.s   .invalid_index
                            	   316: 
02:000011B4 5300            	   317:     subq.b  #1,D0           ; Converte índice de 1-8 para 0-7
02:000011B6 D000            	   318:     add.b   D0,D0           ; Multiplica por 2 (cada elemento é word)
02:000011B8 303B00DE        	   319:     move.w  valores(pc,D0.w),D0  ; Pega o valor do array
02:000011BC 4E75            	   320:     rts
                            	   321: 
                            	   322: .invalid_index:
02:000011BE 7000            	   323:     moveq   #0,D0           ; Retorna 0 para índice inválido
02:000011C0 4E75            	   324:     rts
                            	   325: 
                            	   326: ; Exemplo de uso:
                            	   327: ;   moveq   #3,D0           ; Pega o terceiro valor
                            	   328: ;   bsr     get_value       ; D0 agora contém $0018
                            	   329: 
                            	   330: 
                            	   331: 
                            	   332: ; Array de ponteiros para rotinas (endereços de 32 bits)
                            	   333: tabela_rotinas:
02:000011C2 000011EA        	   334:     dc.l    rotina1, rotina2, rotina3
02:000011C6 000011EE
02:000011CA 000011F2
                            	   335: 
                            	   336: ; Função que chama uma rotina baseada no índice em D0
                            	   337: chamar_rotina:
02:000011CE B03C0001        	   338:     cmp.b   #1,D0           ; Verifica se índice >= 1
02:000011D2 6D12            	   339:     blt.s   indice_invalido
02:000011D4 B03C0008        	   340:     cmp.b   #8,D0           ; Verifica se índice <= 8
02:000011D8 6E0C            	   341:     bgt.s   indice_invalido
                            	   342: 
