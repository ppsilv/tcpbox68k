02:00001532 4EB81538        	   773:         JSR     PrintWordHex
02:00001536 4840            	   774:         SWAP    D0                ; Parte baixa
                            	   775:         ; Continua para PrintWordHex
                            	   776: 
                            	   777: ; ----------------------------------------------------------------------
                            	   778: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   779: ; Entrada: D0.w = valor
                            	   780: ; ----------------------------------------------------------------------
