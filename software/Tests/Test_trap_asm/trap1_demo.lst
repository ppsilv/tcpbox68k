Source: "trap1_demo.s"
                            	     1: ; ==================================================
                            	     2: ; Programa demonstração do TRAP #1 para vasmm68k_mot
                            	     3: ; Funcões: CCONIN (ler char) e CCONOUT (escrever char)
                            	     4: ; ==================================================
                            	     5: 
                            	     6:     section code
                            	     7:     BRA     start
                            	     8: 
                            	     9:     include "rom_routines.inc"

Source: "rom_routines.inc"
                            	     1: ; ================================================
                            	     2: ; ARQUIVO DE INCLUSÃO PARA ROTINAS DA ROM
                            	     3: ; Compilado para RAM, mas acessa funções na ROM
                            	     4: ; ================================================
                            	     5: 
                            	     6: ; --- Endereços absolutos das rotinas na ROM ---
                            	     7: ; (Substitua pelos endereços reais do seu hardware)
                            	     8: 
                            	     9: cold_start              EQU $00000000
                            	    10: UART_Init               EQU $00000400
                            	    11: UART_WriteChar          EQU $00000404
                            	    12: UART_ReadChar           EQU $00000408
                            	    13: UART_Select             EQU $0000040C
                            	    14: UART_Setbaudrate        EQU $00000410
                            	    15: DELAY_MS                EQU $00000414
                            	    16: MEMDUMP                 EQU $00000418
                            	    17: UART_ReadCharNonEcho    EQU $0000041C
                            	    18: _start                  EQU $00000420
                            	    19: warm_start              EQU $00000424
                            	    20: MenuLoop                EQU $00000428
                            	    21: 
                            	    22: ; --- Macros para chamar as rotinas ---
                            	    23: ; (Facilitam o uso sem precisar lembrar dos endereços)
                            	    24: 
                            	    25: WRITE_CHAR      MACRO
                            	    26:                 move.l  \1,-(sp)    ; Empilha argumento
                            	    27:                 jsr     UART_WriteChar
                            	    28:                 addq.l  #4,sp       ; Limpa stack
                            	    29:                 ENDM
                            	    30: 
                            	    31: READ_CHAR       MACRO
                            	    32:                 jsr     UART_ReadChar
                            	    33:                 ENDM
                            	    34: 
                            	    35: DELAY_MS        MACRO
                            	    36:                 move.l  \1,-(sp)    ; Argumento: tempo em ms
                            	    37:                 jsr     Delay_ms
                            	    38:                 addq.l  #4,sp
                            	    39:                 ENDM
                            	    40: ;USO
                            	    41: ; ================================================
                            	    42: ; PROGRAMA PRINCIPAL (COMPILADO PARA RAM)
                            	    43: ; ================================================
                            	    44: ;    INCLUDE "rom_routines.inc"   ; Inclui as definições
                            	    45: ;
                            	    46: ;    ORG     $00082000            ; Endereço de carga na RAM
                            	    47: ;
                            	    48: ;Start:
                            	    49: ;    MOVE.L  #'A',D0             ; Caractere para enviar
                            	    50: ;    WRITE_CHAR D0               ; Usa a macro para UART_WriteChar
                            	    51: ;
                            	    52: ;    READ_CHAR                   ; Macro para UART_ReadChar (resultado em D0)
                            	    53: ;
                            	    54: ;    DELAY_MS #500               ; Delay de 500ms
                            	    55: ;
                            	    56: ;    BRA     Start
                            	    57: ;
                            	    58: ;    END
                            	    59: ;
                            	    60: 

Source: "trap1_demo.s"
                            	    10: ; ==================================================
                            	    11: ; Programa principal
                            	    12: ; ==================================================
                            	    13: start:
00:00000000 41F900000000    	    14:     LEA     mensagem,A0    ; Coloca endereço da mensagem na pilha
00:00000006 6130            	    15:     BSR     imprimir_string    ; Chama rotina de impressão
                            	    16: 
00:00000008 41F90000003C    	    17:     LEA     pergunta,A0    ; Pergunta para usuário
00:0000000E 6128            	    18:     BSR     imprimir_string
                            	    19: 
                            	    20: ; Lê caractere do teclado
                            	    21: ler_caractere:
00:00000010 303C0001        	    22:     MOVE.W  #1,D0              ; Função CCONIN (ler caractere)
00:00000014 4E41            	    23:     TRAP    #1                 ; Chama TRAP #1
00:00000016 B03C001B        	    24:     CMP.B   #27,D0             ; Verifica se é ESC (ASCII 27)
00:0000001A 6718            	    25:     BEQ     fim_programa       ; Se for ESC, termina
                            	    26: 
                            	    27: ; Mostra o caractere lido
00:0000001C 2F00            	    28:     MOVE.L  D0,-(SP)
00:0000001E 41F900000062    	    29:     LEA     eco,A0             ; Mensagem "Você digitou: "
00:00000024 6112            	    30:     BSR     imprimir_string
00:00000026 201F            	    31:     MOVE.L  (SP)+,D0
00:00000028 6122            	    32:     BSR     imprimir_caractere ; Imprime o caractere
00:0000002A 41F900000071    	    33:     LEA     nova_linha,A0  ; Nova linha
00:00000030 6106            	    34:     BSR     imprimir_string
00:00000032 60DC            	    35:     BRA     ler_caractere      ; Repete
                            	    36: 
                            	    37: ; Finaliza programa
                            	    38: fim_programa:
00:00000034 4EF80428        	    39:     JMP     MenuLoop
                            	    40: 
                            	    41: ; ==================================================
                            	    42: ; Rotinas de apoio
                            	    43: ; ==================================================
                            	    44: 
                            	    45: ; Imprimir string (endereço em pilha)
                            	    46: imprimir_string:
00:00000038 2F08            	    47:     MOVE.L  A0,-(SP)           ; Salva A0 na Pinha
                            	    48: imprimir_loop:
00:0000003A 1218            	    49:     MOVE.B  (A0)+,D1           ; Pega próximo caractere
00:0000003C 4A01            	    50:     CMP.B   #0,D1
00:0000003E 6708            	    51:     BEQ     imprimir_fim       ; Se for zero, termina
00:00000040 303C0002        	    52:     MOVE.W  #2,D0              ; Função CCONOUT
00:00000044 4E41            	    53:     TRAP    #1                 ; Chama TRAP #1
00:00000046 60F2            	    54:     BRA     imprimir_loop
                            	    55: imprimir_fim:
00:00000048 205F            	    56:     MOVE.L  (SP)+,A0           ; Restaura A0 da Pinha
00:0000004A 4E75            	    57:     RTS
                            	    58: 
                            	    59: ; Imprimir caractere (caractere em pilha)
                            	    60: imprimir_caractere:
00:0000004C 2200            	    61:     MOVE.L  D0,D1              ; Pega caractere
00:0000004E 303C0002        	    62:     MOVE.W  #2,d0              ; Função CCONOUT
00:00000052 4E41            	    63:     TRAP    #1                 ; Chama TRAP #1
00:00000054 4E75            	    64:     RTS
                            	    65: 
