                            	   961: XMODEM_Receive:
00:00000720 48E73FFE        	   962:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	   963:        ; Inicializa variáveis
00:00000724 41F90008132D    	   964:        LEA     expected_block,A0
00:0000072A 103C0001        	   965:        MOVE.B  #1,D0
00:0000072E 1080            	   966:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:00000730 41F90008112C    	   967:        LEA     xmodem_buffer,A0
                            	   968: 
00:00000736 41F900081934    	   969:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:0000073C 103C0000        	   970:        MOVE.B  #0,D0
00:00000740 1080            	   971:        MOVE.B  D0,(A0)              ; Program not loaded
                            	   972: 
                            	   973:        ; ---- 1. INICIALIZAÇÃO ----
00:00000742 103C0015        	   974:        MOVE.B  #NAK,D0
00:00000746 4EB80186        	   975:        JSR     UART_WriteChar      ; Solicita início
                            	   976: 
                            	   977:        ;SINALIZA NACK SENT
00:0000074A 303C0800        	   978:        MOVE.W  #$0800,D0
00:0000074E 4EB8011A        	   979:        JSR     __write_leds
                            	   980: 
                            	   981:        ; ---- 2. LOOP PRINCIPAL ----
                            	   982: Receive_Loop:
00:00000752 4EB801C0        	   983:        JSR     UART_ReadCharNonEcho
                            	   984: 
00:00000756 B03C0004        	   985:        CMP.B   #EOT,D0
00:0000075A 670000B0        	   986:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	   987: 
00:0000075E B03C0001        	   988:        CMP.B   #SOH,D0
00:00000762 66EE            	   989:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   990: 
                            	   991:        ;SINALIZA leds
00:00000764 303C0C00        	   992:        MOVE.W  #$0C00,D0
00:00000768 4EB8011A        	   993:        JSR     __write_leds
                            	   994: 
                            	   995:        ; ---- 3. RECEBE HEADER ----
00:0000076C 4EB801C0        	   996:        JSR     UART_ReadCharNonEcho       ; Block number
00:00000770 13C00008132C    	   997:        MOVE.B  D0,block_number
                            	   998: 
00:00000776 4EB801C0        	   999:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1000: 
                            	  1001:        ;SINALIZA leds
00:0000077A 303C0800        	  1002:        MOVE.W  #$0800,D0
00:0000077E 4EB8011A        	  1003:        JSR     __write_leds
                            	  1004: 
                            	  1005:        ; ---- 4. RECEBE DADOS ----
00:00000782 7220            	  1006:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:00000784 43F90008112C    	  1007:        LEA     xmodem_buffer,A1
                            	  1008: Read_Loop:
                            	  1009:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:0000078A 4EB801C0        	  1010:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:0000078E E188            	  1011:        LSL.L   #8,D0
00:00000790 4EB801C0        	  1012:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:00000794 E188            	  1013:        LSL.L   #8,D0
00:00000796 4EB801C0        	  1014:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:0000079A E188            	  1015:        LSL.L   #8,D0
00:0000079C 4EB801C0        	  1016:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:000007A0 22C0            	  1017:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:000007A2 5381            	  1018:        SUBQ.L  #1,D1
00:000007A4 66E4            	  1019:        BNE     Read_Loop
                            	  1020: 
00:000007A6 303C0600        	  1021:        MOVE.W  #$0600,D0
00:000007AA 4EB8011A        	  1022:        JSR     __write_leds
                            	  1023: 
                            	  1024:        ; ---- 5. VERIFICA CHECKSUM ----
00:000007AE 4EB801C0        	  1025:        JSR     UART_ReadCharNonEcho       ; Checksum
00:000007B2 1400            	  1026:        MOVE.B  D0,D2
