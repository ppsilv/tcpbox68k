                            	   932: ;--------------------------------------------------
                            	   933: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   934: ;--------------------------------------------------
                            	   935: ; Exemplo: insere 'A' no buffer
                            	   936: ;          MOVE.B  #'A',D0
                            	   937: ;          JSR     UART_BufferPut
                            	   938: 
                            	   939: BufferPut:
00:000006BC 2F01            	   940:     MOVE.L  D1,-(SP)
00:000006BE 2F08            	   941:     MOVE.L  A0,-(SP)
                            	   942: 
                            	   943:     ;ANDI.W    #$FF00,D0
00:000006C0 41F900081024    	   944:     LEA     BUFFER,A0
00:000006C6 323900081022    	   945:     MOVE.W  BUFFER_COUNT,D1
                            	   946: 
00:000006CC B27C0100        	   947:     CMP.W   #256,D1
00:000006D0 6C1C            	   948:     BGE     .BufferFull
                            	   949: 
                            	   950:     ; Modificado para usar deslocamento de 16 bits
00:000006D2 32390008101A    	   951:     MOVE.W  BUFFER_HEAD,D1
00:000006D8 D0C1            	   952:     ADD     D1,A0
00:000006DA 1080            	   953:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   954: 
00:000006DC 5441            	   955:     ADD     #2,D1              ; Incrementa como word
00:000006DE 024100FF        	   956:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000006E2 33C10008101A    	   957:     MOVE.W  D1,BUFFER_HEAD
                            	   958: 
00:000006E8 527900081022    	   959:     ADDQ.W  #1,BUFFER_COUNT
                            	   960: 
                            	   961: .BufferFull:
00:000006EE 205F            	   962:     MOVE.L  (SP)+,A0
00:000006F0 221F            	   963:     MOVE.L  (SP)+,D1
                            	   964: 
00:000006F2 4E75            	   965:     RTS
                            	   966: 
                            	   967: ;--------------------------------------------------
                            	   968: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   969: ;--------------------------------------------------
                            	   970: ;Exemplo: Lendo byte do buffer
                            	   971: ;         BSR     UART_BufferGet
                            	   972: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   973: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   974: ;         Senão, D0 contém o byte lido!
                            	   975: BufferGet:
00:000006F4 2F01            	   976:     MOVE.L  D1,-(SP)
00:000006F6 2F08            	   977:     MOVE.L  A0,-(SP)
                            	   978: 
00:000006F8 323900081022    	   979:     MOVE.W  BUFFER_COUNT,D1
00:000006FE 6724            	   980:     BEQ     .BufferEmpty
                            	   981: 
00:00000700 41F900081024    	   982:     LEA     BUFFER,A0
                            	   983: 
                            	   984:     ; Modificado para usar deslocamento de 16 bits
00:00000706 32390008101E    	   985:     MOVE.W  BUFFER_TAIL,D1
00:0000070C 10301000        	   986:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   987: 
00:00000710 5401            	   988:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000712 024100FF        	   989:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000716 33C10008101E    	   990:     MOVE.W  D1,BUFFER_TAIL
                            	   991: 
00:0000071C 537900081022    	   992:     SUBQ.W  #1,BUFFER_COUNT
00:00000722 6006            	   993:     BRA     .Exit
                            	   994: 
                            	   995: .BufferEmpty:
00:00000724 4EB80730        	   996:     JSR     FBufferEmpty
00:00000728 70FF            	   997:     MOVEQ   #-1,D0
                            	   998: .Exit:
00:0000072A 205F            	   999:     MOVE.L  (SP)+,A0
00:0000072C 221F            	  1000:     MOVE.L  (SP)+,D1
00:0000072E 4E75            	  1001:     RTS
                            	  1002: 
                            	  1003: FBufferEmpty:
00:00000730 4EB80318        	  1004:         JSR     new_line
00:00000734 41F90000037C    	  1005:         LEA     BufferEmpty,A0
00:0000073A 4EB80278        	  1006:         JSR     UART_WriteString
00:0000073E 4EB80318        	  1007:         JSR     new_line
00:00000742 4E75            	  1008:         RTS
                            	  1009: ;---------------------------------------------------------------------
                            	  1010: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1011: ;---------------------------------------------------------------------
                            	  1012: ClearBufferPointers:
00:00000744 23FC000000000008	  1013:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000074C 101A
00:0000074E 23FC000000000008	  1014:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000756 101E
00:00000758 33FC000000081022	  1015:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000760 4E75            	  1016:     RTS
                            	  1017: ;---------------------------------------------------------------------
                            	  1018: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1019: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1020: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1021: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1022: ;---------------------------------------------------------------------
                            	  1023: MontaAddress:
00:00000762 48E73C80        	  1024:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1025: 
                            	  1026:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000766 323900081022    	  1027:     MOVE.W  BUFFER_COUNT,D1
00:0000076C B27C0008        	  1028:     CMP.W   #8,D1
00:00000770 6D38            	  1029:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1030: 
00:00000772 41F900081024    	  1031:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000778 24390008101E    	  1032:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000077E 7000            	  1033:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000780 7607            	  1034:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1035: 
                            	  1036: .ReadLoop:
00:00000782 18302800        	  1037:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000786 0204000F        	  1038:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1039: 
                            	  1040:     ; Desloca e insere os 4 bits em D0
00:0000078A E988            	  1041:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000078C 8004            	  1042:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1043: 
                            	  1044:     ; Atualiza tail (circular)
00:0000078E 5282            	  1045:     ADDQ.L  #1,D2
00:00000790 0282000000FF    	  1046:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1047: 
00:00000796 51CBFFEA        	  1048:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1049: 
                            	  1050:     ; Atualiza ponteiros globais
00:0000079A 23C20008101E    	  1051:     MOVE.L  D2,BUFFER_TAIL
00:000007A0 517900081022    	  1052:     SUB.W   #8,BUFFER_COUNT
                            	  1053: 
00:000007A6 7200            	  1054:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000007A8 6004            	  1055:     BRA     .Exit
                            	  1056: 
                            	  1057: .BufferUnderrun:
00:000007AA 72FF            	  1058:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000007AC 7000            	  1059:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1060: 
                            	  1061: .Exit:
00:000007AE 4CDF013C        	  1062:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000007B2 4E75            	  1063:     RTS
                            	  1064: 
00:000007B4 4D4552444120494E	  1065:     DC.B "MERDA INCIA"
00:000007BC 434941
                            	  1066:     ALIGN 2
