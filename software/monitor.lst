                            	   181: UART_Init:
00:00000174 227900081008    	   182:     move.l   CurrentUART,a1
00:0000017A 137C000D0004    	   183:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000180 137C00830006    	   184:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000186 12BC0068        	   185:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:0000018A 137C00000002    	   186:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000190 08A900070006    	   187:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000196 4229000E        	   188:     clr.b   SCR(a1)                 ; clear the scratch register
00:0000019A 4E75            	   189:     RTS
                            	   190: 
                            	   191:     ; Escreve caractere (D0.B)
                            	   192: UART_WriteChar:
00:0000019C 2F08            	   193:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000019E 2F00            	   194:     MOVE.L  D0,-(SP)        ; Preserva D0
00:000001A0 207900081008    	   195:     move.l   CurrentUART,A0
                            	   196: .WaitTx:
00:000001A6 08280005000A    	   197:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:000001AC 67F8            	   198:     BEQ     .WaitTx
00:000001AE 1080            	   199:     MOVE.B  D0,THR(A0)      ; transmit byte
00:000001B0 201F            	   200:     MOVE.L  (SP)+,D0        ;Restaura D0
00:000001B2 205F            	   201:     MOVE.L  (SP)+,A0        ;Restaura A0
00:000001B4 4E75            	   202:     RTS
                            	   203: 
                            	   204: 
                            	   205: ; Lê caractere (retorna em D0)
                            	   206: UART_ReadChar:
00:000001B6 2F08            	   207:     MOVE.L  A0,-(SP)        ; Preserva A0
00:000001B8 207900081008    	   208:     move.l   CurrentUART,A0
                            	   209: .WaitRx:
00:000001BE 08280000000A    	   210:     BTST    #0,LSR(A0)        ; RX ready?
00:000001C4 67F8            	   211:     BEQ     .WaitRx
00:000001C6 1010            	   212:     MOVE.B  RHR(A0),D0
00:000001C8 205F            	   213:     MOVE.L  (SP)+,A0        ;Restaura A0
00:000001CA B03C001B        	   214:     CMP.B   #$1b,D0
                            	   215:     BEQ     .fim
                            	   216:     ;JSR     UART_WriteChar
                            	   217: .fim
00:000001CE 4E75            	   218:     RTS
                            	   219: 
                            	   220: ; ----------------------------------------------------------------------
                            	   221: ; UART_WriteString - Envia string terminada em null para UART
                            	   222: ; Entrada:
                            	   223: ;   A0 = Ponteiro para a string (endereço da string)
                            	   224: ; ----------------------------------------------------------------------
                            	   225: UART_WriteString:
00:000001D0 2F08            	   226:     MOVE.L  A0,-(SP)      ; Preserva D0
00:000001D2 2F00            	   227:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   228: .WriteLoop:
00:000001D4 1018            	   229:     MOVE.B  (A0)+,D0      ; Pega caractere
00:000001D6 6706            	   230:     BEQ     .Done
00:000001D8 4EB8019C        	   231:     JSR     UART_WriteChar ; Use sua rotine existente
00:000001DC 60F6            	   232:     BRA     .WriteLoop
                            	   233: .Done:
00:000001DE 201F            	   234:     MOVE.L  (SP)+,D0
00:000001E0 205F            	   235:     MOVE.L  (SP)+,A0
00:000001E2 4E75            	   236:     RTS
