00:00000660 4E75            	   896:         RTS
                            	   897: ;---------------------------------------------------------------------
                            	   898: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   899: ;---------------------------------------------------------------------
                            	   900: ClearBufferPointers:
00:00000662 23FC000000000008	   901:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000066A 101A
00:0000066C 23FC000000000008	   902:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000674 101E
00:00000676 33FC000000081022	   903:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:0000067E 4E75            	   904:     RTS
                            	   905: ;---------------------------------------------------------------------
                            	   906: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   907: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   908: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   909: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   910: ;---------------------------------------------------------------------
                            	   911: MontaAddress:
00:00000680 48E73C80        	   912:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   913: 
                            	   914:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000684 323900081022    	   915:     MOVE.W  BUFFER_COUNT,D1
00:0000068A B27C0008        	   916:     CMP.W   #8,D1
00:0000068E 6D38            	   917:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   918: 
00:00000690 41F900081024    	   919:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000696 24390008101E    	   920:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000069C 7000            	   921:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000069E 7607            	   922:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   923: 
                            	   924: .ReadLoop:
00:000006A0 18302800        	   925:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:000006A4 0204000F        	   926:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   927: 
                            	   928:     ; Desloca e insere os 4 bits em D0
00:000006A8 E988            	   929:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:000006AA 8004            	   930:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   931: 
                            	   932:     ; Atualiza tail (circular)
00:000006AC 5282            	   933:     ADDQ.L  #1,D2
00:000006AE 0282000000FF    	   934:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   935: 
00:000006B4 51CBFFEA        	   936:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   937: 
                            	   938:     ; Atualiza ponteiros globais
00:000006B8 23C20008101E    	   939:     MOVE.L  D2,BUFFER_TAIL
00:000006BE 517900081022    	   940:     SUB.W   #8,BUFFER_COUNT
                            	   941: 
00:000006C4 7200            	   942:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000006C6 6004            	   943:     BRA     .Exit
                            	   944: 
                            	   945: .BufferUnderrun:
00:000006C8 72FF            	   946:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006CA 7000            	   947:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   948: 
                            	   949: .Exit:
00:000006CC 4CDF013C        	   950:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000006D0 4E75            	   951:     RTS
