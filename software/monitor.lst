00:000006AA 4E75            	   900:         RTS
                            	   901: ;---------------------------------------------------------------------
                            	   902: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   903: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   904: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   905: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   906: ;---------------------------------------------------------------------
                            	   907: MontaAddress:
00:000006AC 48E73C80        	   908:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   909: 
                            	   910:         ; Verifica se há pelo menos 8 bytes no buffer
00:000006B0 323900081022    	   911:         MOVE.W  BUFFER_COUNT,D1
00:000006B6 B27C0008        	   912:         CMP.W   #8,D1
00:000006BA 6D38            	   913:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   914: 
00:000006BC 41F900081024    	   915:         LEA     BUFFER,A0      ; A0 = base do buffer
00:000006C2 24390008101E    	   916:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:000006C8 7000            	   917:         CLR.L   D0                ; Zera D0 (resultado final)
00:000006CA 7607            	   918:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   919: 
                            	   920: .ReadLoop:
00:000006CC 18302800        	   921:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:000006D0 0204000F        	   922:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   923: 
                            	   924:         ; Desloca e insere os 4 bits em D0
00:000006D4 E988            	   925:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:000006D6 8004            	   926:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   927: 
                            	   928:         ; Atualiza tail (circular)
00:000006D8 5282            	   929:         ADDQ.L  #1,D2
00:000006DA 0282000000FF    	   930:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   931: 
00:000006E0 51CBFFEA        	   932:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   933: 
                            	   934:         ; Atualiza ponteiros globais
00:000006E4 23C20008101E    	   935:         MOVE.L  D2,BUFFER_TAIL
00:000006EA 517900081022    	   936:         SUB.W   #8,BUFFER_COUNT
                            	   937: 
00:000006F0 7200            	   938:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000006F2 6004            	   939:         BRA     .Exit
                            	   940: 
                            	   941: .BufferUnderrun:
00:000006F4 72FF            	   942:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006F6 7000            	   943:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   944: 
                            	   945: .Exit:
00:000006F8 4CDF013C        	   946:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000006FC 4E75            	   947:         RTS
