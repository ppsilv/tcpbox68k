                            	   180: ; ----------------------------------------------------------------------
                            	   181: ; UART_WriteString - Envia string terminada em null para UART
                            	   182: ; Entrada:
                            	   183: ;   A0 = Ponteiro para a string (endereço da string)
                            	   184: ; ----------------------------------------------------------------------
                            	   185: UART_WriteString:
00:0000016E 2F08            	   186:     MOVE.L  A0,-(SP)      ; Preserva D0
00:00000170 2F00            	   187:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   188: .WriteLoop:
00:00000172 1018            	   189:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000174 6706            	   190:     BEQ     .Done
00:00000176 4EB8013E        	   191:     JSR     UART_WriteChar ; Use sua rotine existente
00:0000017A 60F6            	   192:     BRA     .WriteLoop
                            	   193: .Done:
00:0000017C 201F            	   194:     MOVE.L  (SP)+,D0
00:0000017E 205F            	   195:     MOVE.L  (SP)+,A0
00:00000180 4E75            	   196:     RTS
