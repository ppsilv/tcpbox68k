                            	  1029: ;******************************************************************************************
                            	  1030:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1031:            ;     BRA     Send_ACK
                            	  1032: ;******************************************************************************************
                            	  1033: 
                            	  1034:         ; Calcula checksum local
                            	  1035:         ;LEA     xmodem_buffer,A1
                            	  1036:         ;MOVE.W  #127,D1
                            	  1037:         ;CLR.B   D3
                            	  1038: 
                            	  1039: Calc_Checksum:
                            	  1040:         ;ADD.B   (A1)+,D3
                            	  1041:         ;DBF     D1,Calc_Checksum;
                            	  1042: 
                            	  1043:         ;CMP.B   D2,D3
                            	  1044:         ;BNE     Send_NAK            ; Erro no checksum
                            	  1045: 
                            	  1046:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1047:         ;MOVE.B  block_number,D0
                            	  1048:         ;CMP.B   expected_block,D0
                            	  1049:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1050: 
                            	  1051:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1052:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1053:         ; Exemplo: copiar do buffer para a RAM
                            	  1054:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:000007B4 43F90008112C    	  1055:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:000007BA 24790008132E    	  1056:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:000007C0 7220            	  1057:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1058: Copy_Data:
00:000007C2 24D9            	  1059:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:000007C4 5381            	  1060:         SUBQ.L  #1,D1               ; Decrementa contador
00:000007C6 66FA            	  1061:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1062:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
00:000007C8 20390008132E    	  1063:         MOVE.L  usr_buffer_addr,D0
00:000007CE 068000000080    	  1064:         ADDI.L  #128,D0
00:000007D4 23C00008132E    	  1065:         MOVE.L  D0,usr_buffer_addr
                            	  1066: 
                            	  1067: 
                            	  1068: 
                            	  1069:         ; ---- 8. CONFIMA RECEPÇÃO ----
00:000007DA 52390008132D    	  1070:         ADDQ.B  #1,expected_block   ; Próximo bloco
00:000007E0 103C0006        	  1071:         MOVE.B  #ACK,D0
00:000007E4 4EB80186        	  1072:         JSR     UART_WriteChar
00:000007E8 6000FF68        	  1073:         BRA     Receive_Loop
                            	  1074: 
                            	  1075: Send_ACK:
                            	  1076:         ;SINALIZA NACK SENT
00:000007EC 303C0400        	  1077:         MOVE.W  #$0400,D0
00:000007F0 4EB8011A        	  1078:         JSR     __write_leds
00:000007F4 103C0006        	  1079:         MOVE.B  #ACK,D0
00:000007F8 4EB80186        	  1080:         JSR     UART_WriteChar
00:000007FC 6000FF54        	  1081:         BRA     Receive_Loop
                            	  1082: 
                            	  1083: Send_NAK:
00:00000800 103C0015        	  1084:         MOVE.B  #NAK,D0
00:00000804 4EB80186        	  1085:         JSR     UART_WriteChar
00:00000808 6000FF48        	  1086:         BRA     Receive_Loop
                            	  1087: 
                            	  1088: Transfer_Complete:
00:0000080C 103C0006        	  1089:         MOVE.B  #ACK,D0             ; Confirma EOT
00:00000810 4EB80186        	  1090:         JSR     UART_WriteChar
                            	  1091: 
00:00000814 41F900081934    	  1092:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:0000081A 103C0001        	  1093:         MOVE.B  #1,D0
00:0000081E 1080            	  1094:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1095: 
00:00000820 4CDF7FFC        	  1096:         MOVEM.L (SP)+,D2-D7/A0-A6
00:00000824 4E75            	  1097:         RTS
                            	  1098: ; ========================================================
                            	  1099: ; Validador de Checksum para ROM (MC68000)
                            	  1100: ; Assume:
                            	  1101: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1102: ;   - Big-endian (padrão 68000)
                            	  1103: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1104: ; ========================================================
                            	  1105: 
                            	  1106: VALIDATE_ROM:
00:00000826 91C8            	  1107:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:00000828 203C00003FFC    	  1108:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:0000082E 7200            	  1109:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1110: 
                            	  1111:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1112: .CHECKSUM_LOOP:
00:00000830 2418            	  1113:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:00000832 D282            	  1114:         ADD.L   D2,D1               ; Soma ao acumulador
00:00000834 5980            	  1115:         SUB.L   #4,D0               ; Decrementa contador
00:00000836 6EF8            	  1116:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1117: 
00:00000838 41F900081930    	  1118:         LEA     checksum_rom,A0
00:0000083E 20C1            	  1119:         MOVE.L  D1,(A0)+
                            	  1120:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1121: 
                            	  1122:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:00000840 24383FFC        	  1123:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
00:00000844 B481            	  1124:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000846 6706            	  1125:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1126: 
                            	  1127:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000848 363CDEAD        	  1128:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:0000084C 6002            	  1129:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1130: .CHECKSUM_OK:
00:0000084E 4E75            	  1131:         RTS                         ; Retorna (ROM válida)
                            	  1132: 
                            	  1133: SYSTEM_HALT:
00:00000850 46FC0700        	  1134:         MOVE.W  #$0700,SR        ; Desabilita interrupções
                            	  1135: .INFINITE_LOOP:
00:00000854 60FE            	  1136:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1137: 
                            	  1138: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1139: VALIDATE_ROM_CRC32:
00:00000856 91C8            	  1140:         LEA     ROM_START,A0        ; Endereço inicial
00:00000858 203C00003FFC    	  1141:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
00:0000085E 72FF            	  1142:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1143: 
                            	  1144: CRC_LOOP:
00:00000860 1418            	  1145:         MOVE.B  (A0)+,D2            ; Lê 1 byte
00:00000862 B501            	  1146:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1147: 
                            	  1148:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1149:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1150: 
00:00000864 5380            	  1151:         SUBQ.L  #1,D0
00:00000866 6EF8            	  1152:         BGT     CRC_LOOP
                            	  1153: 
00:00000868 4681            	  1154:         NOT.L   D1                  ; Inverte os bits no final
                            	  1155: 
                            	  1156:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:0000086A 24383FFB        	  1157:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:0000086E B481            	  1158:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000870 6706            	  1159:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1160: 
                            	  1161:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000872 363CDEAD        	  1162:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000876 60D8            	  1163:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1164: .CHECKSUM_OK:
00:00000878 4E75            	  1165:         RTS
                            	  1166: 
                            	  1167: ; --- Constantes ---
                            	  1168: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1169: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1170: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1171: 
                            	  1172: 
                            	  1173: Checksum:
00:0000087A 00000000        	  1174:     DC.L    0               ; Temporariamente 0
                            	  1175:     ALIGN 2
                            	  1176: ; =====================================================================
                            	  1177: ; END XMODEM RECEIVER ROUTINE
                            	  1178: ; =====================================================================
