                            	   196: ; ----------------------------------------------------------------------
                            	   197: ; Constantes
                            	   198: ; ----------------------------------------------------------------------
                            	   199: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   200: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   201:                               ; BAUD_DIV_L em $70000
                            	   202:                               ; BAUD_DIV_U em $70001
                            	   203: 
                            	   204: ; ----------------------------------------------------------------------
                            	   205: ; Rotina: Calcula e armazena divisor de baud rate
                            	   206: ; Entrada:
                            	   207: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   208: ; Saída:
                            	   209: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   210: ; Formulas:
                            	   211: ;
                            	   212: ;
                            	   213: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   214: ; ----------------------------------------------------------------------
                            	   215: 
                            	   216: CalcBaudDiv:
                            	   217: ;[ Registrador D0 (32 bits) ]
                            	   218: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   219: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   220:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   221:     ;((F_CPU/16)/10)
                            	   222:     ;F_CPU = 16000000 ou 0xF42400
00:00000182 203C00F42400    	   223:     MOVE.L  #F_CPU,D0
00:00000188 323C0010        	   224:     MOVE.W  #16,D1         ; Divisor
00:0000018C 61000096        	   225:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   226: ;1
00:00000190 2F00            	   227:     move.l  d0,-(SP)
00:00000192 4EB803A6        	   228:     jsr     PrintHexAddress
00:00000196 4EB8020E        	   229:     jsr     new_line
00:0000019A 201F            	   230:     move.l  (SP)+,d0
                            	   231: 
00:0000019C 323C000A        	   232:     MOVE.W  #10,D1         ; Divisor
00:000001A0 61000082        	   233:     BSR     Div32x16       ; D0 = 0x186A0
                            	   234: ;2
00:000001A4 2F00            	   235:     move.l  d0,-(SP)
00:000001A6 4EB803A6        	   236:     jsr     PrintHexAddress
00:000001AA 4EB8020E        	   237:     jsr     new_line
00:000001AE 201F            	   238:     move.l  (SP)+,d0
                            	   239: 
                            	   240:     ;(BAUD/10)
00:000001B0 2F00            	   241:     move.l  d0,-(SP)
                            	   242: ;3
00:000001B2 7000            	   243:     CLR.L   D0
00:000001B4 30390008100C    	   244:     MOVE.W  CurrentBaudRate,D0
00:000001BA 2F00            	   245:     move.l  d0,-(SP)
00:000001BC 4EB803A6        	   246:     jsr     PrintHexAddress
00:000001C0 4EB8020E        	   247:     jsr     new_line
00:000001C4 201F            	   248:     move.l  (SP)+,d0
                            	   249: 
00:000001C6 123C000A        	   250:     MOVE.B  #10,D1
00:000001CA 6158            	   251:     BSR     Div32x16
                            	   252: 
                            	   253: ;4
00:000001CC 2F00            	   254:     move.l  d0,-(SP)
00:000001CE 4EB803A6        	   255:     jsr     PrintHexAddress
00:000001D2 4EB8020E        	   256:     jsr     new_line
00:000001D6 221F            	   257:     move.l  (SP)+,D1
00:000001D8 201F            	   258:     move.l  (SP)+,D0
                            	   259: 
                            	   260: 
                            	   261:     ;(F_CPU/BAUD)
00:000001DA 6148            	   262:     BSR     Div32x16
                            	   263: ;5
00:000001DC 2F00            	   264:     move.l  d0,-(SP)
00:000001DE 4EB803A6        	   265:     jsr     PrintHexAddress
00:000001E2 4EB8020E        	   266:     jsr     new_line
00:000001E6 201F            	   267:     move.l  (SP)+,d0
                            	   268: 
                            	   269:     ; 4. Separa parte alta/baixa corretamente
00:000001E8 3200            	   270:     MOVE.W  D0,D1
00:000001EA 024000FF        	   271:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000001EE E049            	   272:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000001F0 024100FF        	   273:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   274: 
                            	   275:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000001F4 41F900081012    	   276:     LEA     Baud1DivL,A0
00:000001FA 3080            	   277:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:000001FC 41F900081014    	   278:     LEA     Baud1DivH,A0
00:00000202 3081            	   279:     MOVE.W  D1,(A0)
                            	   280: 
00:00000204 6000FE66        	   281:     BRA     MenuLoop
00:00000208 4E75            	   282:     RTS
                            	   283: .BaudError:
00:0000020A 6000FDFC        	   284:     BRA     _start
                            	   285: 
                            	   286: new_line:
00:0000020E 2F00            	   287:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000210 103C000A        	   288:         MOVE.B  #10,D0
00:00000214 4EB80134        	   289:         JSR     UART_WriteChar
00:00000218 103C000D        	   290:         MOVE.B  #13,D0
00:0000021C 4EB80134        	   291:         JSR     UART_WriteChar
00:00000220 201F            	   292:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000222 4E75            	   293:         RTS
                            	   294: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   295: ; Retorna D0 = Quociente, D1 = Resto
                            	   296: Div32x16:
00:00000224 7400            	   297:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000226 761F            	   298:     MOVEQ   #31,D3      ; 32 iterações
                            	   299: DivLoop:
00:00000228 E388            	   300:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000022A E392            	   301:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000022C B441            	   302:     CMP.W   D1,D2       ; D2 >= D1?
00:0000022E 6D04            	   303:     BLT     .skip
00:00000230 9441            	   304:     SUB.W   D1,D2       ; Sim, subtrai
00:00000232 5280            	   305:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   306: .skip:
00:00000234 51CBFFF2        	   307:     DBRA    D3,DivLoop  ; Repete
00:00000238 2202            	   308:     MOVE.L  D2,D1       ; Resto em D1
00:0000023A 4E75            	   309:     RTS
                            	   310: ; Versão compacta sem stack frame
                            	   311: PrintHexFast:
00:0000023C 2F02            	   312:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000023E 2F00            	   313:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000240 7407            	   314:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   315: 
                            	   316: .Loop:
00:00000242 2017            	   317:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000244 E998            	   318:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000246 2E80            	   319:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000248 0200000F        	   320:     ANDI.B  #$F,D0            ; Isola nibble
                            	   321: 
00:0000024C B03C0009        	   322:     CMP.B   #9,D0
00:00000250 6302            	   323:     BLS     .Digit
00:00000252 5E00            	   324:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   325: .Digit:
00:00000254 D03C0030        	   326:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000258 4EB80134        	   327:     JSR     UART_WriteChar    ; Envia caractere
                            	   328: 
00:0000025C 51CAFFE4        	   329:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   330: 
00:00000260 588F            	   331:     ADDQ.L  #4,SP             ; Remove valor salvo
00:00000262 241F            	   332:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000264 4E75            	   333:     RTS
                            	   334: 
                            	   335: ; ----------------------------------------------------------------------
                            	   336: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   337: ; Entrada:
                            	   338: ;   D0.L = Valor a ser impresso (32 bits)
                            	   339: ;   D1.W = Número de dígitos (1-8)
                            	   340: ; ----------------------------------------------------------------------
                            	   341: PrintHexPRECISA_DE_REVISAO:
00:00000266 4E56FFF8        	   342:     LINK    A6,#-8            ; Reserva espaço na pilha
00:0000026A 2F02            	   343:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000026C 2D40FFFC        	   344:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:00000270 3D41FFFA        	   345:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   346: 
00:00000274 323C0008        	   347:     MOVE.W  #$0008,D1
                            	   348: 
                            	   349:     ; Ajusta para começar pelo dígito mais significativo
00:00000278 E549            	   350:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:0000027A 5941            	   351:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   352: 
                            	   353: .PrintLoop:
00:0000027C 202EFFFC        	   354:     MOVE.L  -4(A6),D0         ; Recupera valor
00:00000280 3401            	   355:     MOVE.W  D1,D2             ; Posição do nibble
00:00000282 E5B8            	   356:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000284 02800000000F    	   357:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   358: 
                            	   359:     ; Converte para ASCII
00:0000028A B03C0009        	   360:     CMP.B   #9,D0
00:0000028E 6302            	   361:     BLS     .Decimal
00:00000290 5E00            	   362:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   363: .Decimal:
00:00000292 D03C0030        	   364:     ADD.B   #'0',D0           ; Converte para caractere
                            	   365: 
                            	   366:     ; Imprime caractere
00:00000296 4EB80134        	   367:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   368: 
00:0000029A 5941            	   369:     SUBQ.W  #4,D1             ; Próximo nibble
00:0000029C 6ADE            	   370:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   371: 
                            	   372:     ; Espaço final para separação
00:0000029E 103C0020        	   373:     MOVE.B  #' ',D0
00:000002A2 4EB80134        	   374:     JSR     UART_WriteChar
                            	   375: 
00:000002A6 241F            	   376:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000002A8 4E5E            	   377:     UNLK    A6                ; Restaura frame
00:000002AA 4E75            	   378:     RTS
                            	   379: ; ----------------------------------------------------------------------
                            	   380: ; Exemplo de uso:
                            	   381: ; ----------------------------------------------------------------------
                            	   382: SetupDivisor:
00:000002AC 303C2580        	   383:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000002B0 6100FED0        	   384:     BSR     CalcBaudDiv
                            	   385: 
                            	   386:     ; Agora pode acessar os valores na RAM:
00:000002B4 41F90008100E    	   387:     LEA     BaudDivL,A0
00:000002BA 1010            	   388:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000002BC 41F900081010    	   389:     LEA     BaudDivH,A0
00:000002C2 1210            	   390:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   391: 
                            	   392:     ; (Aqui você configuraria os registradores da UART)
00:000002C4 4E75            	   393:     RTS
                            	   394: ; ----------------------------------------------------------------------
                            	   395: ; MemDump - Imprime dump de memória formatado
                            	   396: ; Entrada:
                            	   397: ;   A0 = Endereço inicial (ex: $80000)
                            	   398: ;   D0 = Quantidade de bytes (ex: 256)
                            	   399: ; ----------------------------------------------------------------------
                            	   400: MemDump:
00:000002C6 41F90000000D    	   401:     LEA     DumpHeader,A0
00:000002CC 4EB8016E        	   402:     JSR     UART_WriteString
00:000002D0 207900081016    	   403:     MOVE.L  (addressInHex),A0
00:000002D6 2008            	   404:     MOVE.L  A0,D0
00:000002D8 4EB803A6        	   405:     JSR     PrintHexAddress
00:000002DC 4EB8020E        	   406:     JSR     new_line
                            	   407: 
00:000002E0 41F900000020    	   408:     LEA     DumpHeader1,A0
00:000002E6 4EB8016E        	   409:     JSR     UART_WriteString
                            	   410: 
00:000002EA 207900081016    	   411:     MOVE.L  (addressInHex),A0
                            	   412:     ; Calcula endereço final
                            	   413: 
                            	   414: DUMPLOOPMASTER:
00:000002F0 7200            	   415:     CLR.L   D1
00:000002F2 2208            	   416:     MOVE.L  A0,D1
00:000002F4 0681000000FF    	   417:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   418:     ;MOVE.L  D1,D0
                            	   419:     ;JSR     PrintHexAddress
                            	   420:     ;JSR     new_line
                            	   421: 
                            	   422:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   423:     ;JSR     UART_ReadChar
                            	   424: 
                            	   425: 
                            	   426: DumpLoop:
                            	   427:     ; Nova linha a cada 16 bytes
00:000002FA 2008            	   428:     MOVE.L  A0,D0
00:000002FC 02800000000F    	   429:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000302 6616            	   430:     BNE     NoNewLine
                            	   431: 
                            	   432:     ; Imprime endereço
00:00000304 2008            	   433:     MOVE.L  A0,D0
00:00000306 4EB803A6        	   434:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   435: 
00:0000030A 103C003A        	   436:     MOVE.B  #':',D0
00:0000030E 4EB80134        	   437:     JSR     UART_WriteChar
00:00000312 103C0020        	   438:     MOVE.B  #' ',D0
00:00000316 4EB80134        	   439:     JSR     UART_WriteChar
                            	   440: 
                            	   441: NoNewLine:
                            	   442:     ; Imprime byte em hex
00:0000031A 1018            	   443:     MOVE.B  (A0)+,D0
00:0000031C 4EB803B6        	   444:     JSR     PrintByteHex
                            	   445: 
00:00000320 103C0020        	   446:     MOVE.B  #' ',D0
00:00000324 4EB80134        	   447:     JSR     UART_WriteChar
                            	   448: 
                            	   449:     ; Verifica fim da linha (16 bytes)
00:00000328 2008            	   450:     MOVE.L  A0,D0
00:0000032A 02800000000F    	   451:     ANDI.L  #$0000000F,D0
00:00000330 664E            	   452:     BNE     NoEndLine
                            	   453: 
                            	   454:     ; Imprime caracteres ASCII
00:00000332 103C0020        	   455:     MOVE.B  #' ',D0
00:00000336 4EB80134        	   456:     JSR     UART_WriteChar
00:0000033A 103C007C        	   457:     MOVE.B  #'|',D0
00:0000033E 4EB80134        	   458:     JSR     UART_WriteChar
                            	   459: 
00:00000342 43E8FFF0        	   460:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000346 740F            	   461:     MOVEQ   #15,D2            ; 16 caracteres
                            	   462: 
                            	   463: AsciiLoop:
00:00000348 1019            	   464:     MOVE.B  (A1)+,D0
00:0000034A B03C0020        	   465:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000034E 6D0C            	   466:     BLT     NonPrintable
00:00000350 B03C007E        	   467:     CMP.B   #126,D0
00:00000354 6E06            	   468:     BGT     NonPrintable
                            	   469: 
00:00000356 4EB80134        	   470:     JSR     UART_WriteChar
00:0000035A 6008            	   471:     BRA     NextAscii
                            	   472: 
                            	   473: NonPrintable:
00:0000035C 103C002E        	   474:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:00000360 4EB80134        	   475:     JSR     UART_WriteChar
                            	   476: 
                            	   477: NextAscii:
00:00000364 51CAFFE2        	   478:     DBRA    D2,AsciiLoop
                            	   479: 
00:00000368 103C007C        	   480:     MOVE.B  #'|',D0
00:0000036C 4EB80134        	   481:     JSR     UART_WriteChar
00:00000370 103C000D        	   482:     MOVE.B  #13,D0            ; CR
00:00000374 4EB80134        	   483:     JSR     UART_WriteChar
00:00000378 103C000A        	   484:     MOVE.B  #10,D0            ; LF
00:0000037C 4EB80134        	   485:     JSR     UART_WriteChar
                            	   486: 
                            	   487: NoEndLine:
                            	   488:     ; Verifica fim do dump
00:00000380 B1C1            	   489:     CMP.L   D1,A0
00:00000382 6300FF76        	   490:     BLS     DumpLoop
                            	   491: 
00:00000386 2F08            	   492:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000388 41F9000003ED    	   493:     LEA     HitAnyKey,A0
00:0000038E 4EB8016E        	   494:     JSR     UART_WriteString
00:00000392 4EB8014E        	   495:     JSR     UART_ReadChar
00:00000396 B03C001B        	   496:     CMP.B   #$1B,D0
00:0000039A 6706            	   497:     BEQ     .fim
                            	   498: 
00:0000039C 205F            	   499:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:0000039E 6000FF50        	   500:     BRA     DUMPLOOPMASTER
                            	   501: .fim
00:000003A2 6000FCC8        	   502:     BRA     MenuLoop
                            	   503: 
                            	   504: ; ----------------------------------------------------------------------
                            	   505: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   506: ; Entrada: D0 = endereço
                            	   507: ; ----------------------------------------------------------------------
                            	   508: PrintHexAddress:
00:000003A6 4840            	   509:     SWAP    D0                ; Imprime parte alta primeiro
00:000003A8 4EB803AE        	   510:     JSR     PrintWordHex
00:000003AC 4840            	   511:     SWAP    D0                ; Parte baixa
                            	   512:     ; Continua para PrintWordHex
                            	   513: 
                            	   514: ; ----------------------------------------------------------------------
                            	   515: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   516: ; Entrada: D0.w = valor
                            	   517: ; ----------------------------------------------------------------------
                            	   518: PrintWordHex:
00:000003AE E158            	   519:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003B0 4EB803B6        	   520:     JSR     PrintByteHex
00:000003B4 E058            	   521:     ROR.W   #8,D0             ; Byte menos significativo
                            	   522:     ; Continua para PrintByteHex
                            	   523: 
                            	   524: ; ----------------------------------------------------------------------
                            	   525: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   526: ; Entrada: D0.b = valor
                            	   527: ; ----------------------------------------------------------------------
                            	   528: PrintByteHex:
00:000003B6 1F00            	   529:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000003B8 E808            	   530:     LSR.B   #4,D0             ; Nibble alto
00:000003BA 6106            	   531:     BSR     PrintNibble
00:000003BC 101F            	   532:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000003BE 0200000F        	   533:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   534:     ; Continua para PrintNibble
                            	   535: ; ----------------------------------------------------------------------
                            	   536: ; PrintNibble - Imprime um nibble em hex
                            	   537: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   538: ; ----------------------------------------------------------------------
                            	   539: PrintNibble:
00:000003C2 B03C0009        	   540:     CMP.B   #9,D0
00:000003C6 6302            	   541:     BLS     .Decimal
00:000003C8 5E00            	   542:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   543: .Decimal:
00:000003CA D03C0030        	   544:     ADD.B   #'0',D0
00:000003CE 4EF80134        	   545:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   546: 
                            	   547: ClearRAM:
00:000003D2 41F900080000    	   548:     LEA     $80000,A0
00:000003D8 43F90008FFFF    	   549:     LEA     $8FFFF,A1
00:000003DE 7000            	   550:     MOVEQ   #0,D0
                            	   551: .ClearLoop:
00:000003E0 20C0            	   552:     MOVE.L  D0,(A0)+
00:000003E2 B3C8            	   553:     CMPA.L  A0,A1
00:000003E4 62FA            	   554:     BHI     .ClearLoop
00:000003E6 4E75            	   555:     RTS
                            	   556: ; ----------------------------------------------------------------------
                            	   557: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   558: ; ----------------------------------------------------------------------
                            	   559: ClearRAM1:
00:000003E8 41F900080000    	   560:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000003EE 43F900100000    	   561:     LEA     $100000,A1       ; Endereço final + 1
00:000003F4 7000            	   562:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   563: 
                            	   564:     ; Calcula tamanho em bytes (já alinhado para longs)
00:000003F6 2209            	   565:     MOVE.L  A1,D1
00:000003F8 9288            	   566:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   567: 
                            	   568:     ; Otimização: escreve longs (32 bits) quando possível
00:000003FA 2401            	   569:     MOVE.L  D1,D2
00:000003FC 028200000003    	   570:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:00000402 670C            	   571:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   572: 
                            	   573:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000404 5382            	   574:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   575: .ResidualLoop:
00:00000406 10C0            	   576:     MOVE.B  D0,(A0)+
00:00000408 51CAFFFC        	   577:     DBRA    D2,.ResidualLoop
                            	   578: 
                            	   579:     ; Atualiza tamanho restante
00:0000040C 9282            	   580:     SUB.L   D2,D1
00:0000040E 5381            	   581:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   582: 
                            	   583: .ClearLongs:
00:00000410 E489            	   584:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:00000412 5381            	   585:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   586: 
                            	   587: .LongLoop:
00:00000414 20C0            	   588:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000416 51C9FFFC        	   589:     DBRA    D1,.LongLoop
00:0000041A 4E75            	   590:     RTS
                            	   591: 
                            	   592: ; ----------------------------------------------------------------------
                            	   593: ; Subrotinas do Menu
                            	   594: ; ----------------------------------------------------------------------
                            	   595: 
                            	   596: ; 1. Seleciona UART
                            	   597: SelectUART:
00:0000041C 41F90000035C    	   598:     LEA     PromptNotImplemented,A0
00:00000422 4EB8016E        	   599:     JSR     UART_WriteString
                            	   600:     ;LEA     UARTPrompt,A0
                            	   601:     ;JSR     UART_WriteString
                            	   602:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   603:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   604:     ;JSR     UART_Init           ; Reinicializa UART
00:00000426 6000FC44        	   605:     BRA     MenuLoop
                            	   606: 
                            	   607: ; 2. Configura Baud Rate
                            	   608: SetBaudRate:
00:0000042A 41F90000035C    	   609:     LEA     PromptNotImplemented,A0
00:00000430 4EB8016E        	   610:     JSR     UART_WriteString
                            	   611:     ;LEA     BaudPrompt,A0
                            	   612:     ;JSR     UART_WriteString
                            	   613:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   614:     ;MOVE.L  CurrentUART,A0
                            	   615:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
00:00000434 6000FC36        	   616:     BRA     MenuLoop
                            	   617: 
                            	   618: ; 3. Carrega programa via serial
                            	   619: LoadProgram:
                            	   620: 
00:00000438 41F900081124    	   621:     LEA     DEST_BUFFER,A0   ; Onde os dados serão salvos
00:0000043E 23C800081524    	   622:     MOVE.L  A0,user_buffer_ptr
00:00000444 4EB806B4        	   623:     JSR     XMODEM_Receive
                            	   624: 
00:00000448 6000FC22        	   625:     BRA     MenuLoop
                            	   626: ; 4. Grava programa manualmente (hex)
                            	   627: WriteProgram:
00:0000044C 41F900000312    	   628:     LEA     WritePrompt,A0
00:00000452 4EB8016E        	   629:     JSR     UART_WriteString
00:00000456 4EB804E6        	   630:     JSR     UART_ReadHex        ; Lê endereço
00:0000045A 2240            	   631:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   632: 
00:0000045C 41F900000322    	   633:     LEA     WriteSizePrompt,A0
00:00000462 4EB8016E        	   634:     JSR     UART_WriteString
00:00000466 4EB804E6        	   635:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:0000046A 2200            	   636:     MOVE.L  D0,D1               ; D1 = contador
                            	   637: 
                            	   638: .WriteLoop:
00:0000046C 4EB80586        	   639:     JSR     UART_ReadByte       ; Lê byte
00:00000470 12C0            	   640:     MOVE.B  D0,(A1)+            ; Armazena
00:00000472 5381            	   641:     SUBQ.L  #1,D1
00:00000474 66F6            	   642:     BNE     .WriteLoop
                            	   643: 
00:00000476 41F900000334    	   644:     LEA     WriteDoneMsg,A0
00:0000047C 4EB8016E        	   645:     JSR     UART_WriteString
00:00000480 6000FBEA        	   646:     BRA     MenuLoop
                            	   647: 
                            	   648: ; 5. Executa programa na RAM
                            	   649: RunProgram:
00:00000484 41F90000034E    	   650:     LEA     RunPrompt,A0
00:0000048A 4EB8016E        	   651:     JSR     UART_WriteString
00:0000048E 4EB804E6        	   652:     JSR     UART_ReadHex        ; Lê endereço
00:00000492 2040            	   653:     MOVE.L  D0,A0
00:00000494 4E90            	   654:     JSR     (A0)                ; Chama subrotina
00:00000496 6000FBD4        	   655:     BRA     MenuLoop
                            	   656: 
                            	   657: ; ----------------------------------------------------------------------
                            	   658: ; Rotinas Auxiliares
                            	   659: ; ----------------------------------------------------------------------
                            	   660: 
                            	   661: ; Lê número hexadecimal (retorna em D0)
                            	   662: UART_ReadHex1:
00:0000049A 2F01            	   663:         MOVE.L  D1,-(SP)
00:0000049C 2F02            	   664:         MOVE.L  D2,-(SP)
                            	   665: 
00:0000049E 41F900000312    	   666:         LEA     WritePrompt,A0
00:000004A4 4EB8016E        	   667:         JSR     UART_WriteString
                            	   668: 
00:000004A8 4EB8020E        	   669:         JSR     new_line
                            	   670: 
00:000004AC 7000            	   671:         MOVEQ   #0,D0
00:000004AE 7200            	   672:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000004B0 7400            	   673:         MOVEQ   #0,D2            ; Resultado em D2
                            	   674: 
                            	   675: .Loop:
00:000004B2 4EB8014E        	   676:         JSR     UART_ReadChar
00:000004B6 B03C000D        	   677:         CMP.B   #13,D0
00:000004BA 670C            	   678:         BEQ     .Done
00:000004BC B03C000A        	   679:         CMP.B   #10,D0
00:000004C0 6706            	   680:         BEQ     .Done
00:000004C2 4EB805B0        	   681:         JSR     BufferPut
00:000004C6 60EA            	   682:         BRA     .Loop
                            	   683: .Done:
                            	   684: ;         BSR     UART_BufferGet
                            	   685: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   686: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   687: ;         Senão, D0 contém o byte lido!
                            	   688: .loop1:
00:000004C8 4EB805E8        	   689:     JSR     BufferGet
00:000004CC B03C00FF        	   690:     CMP.B   #-1,D0          ; Buffer vazio?
00:000004D0 6706            	   691:     BEQ     .fim      ; Se sim, ignora
00:000004D2 4EB80134        	   692:     JSR     UART_WriteChar
00:000004D6 60F0            	   693:     BRA     .loop1
                            	   694: .fim:
00:000004D8 241F            	   695:     MOVE.L  (SP)+,D2
00:000004DA 221F            	   696:     MOVE.L  (SP)+,D1
00:000004DC 4EB8020E        	   697:     JSR     new_line
00:000004E0 6000FB8A        	   698:     bra     MenuLoop ;provisoriamente
00:000004E4 4E75            	   699:     RTS
                            	   700: 
                            	   701: ; Lê número hexadecimal (retorna em D0)
                            	   702: UART_ReadHex:
00:000004E6 2F01            	   703:         MOVE.L  D1,-(SP)
00:000004E8 2F02            	   704:         MOVE.L  D2,-(SP)
                            	   705: 
00:000004EA 7000            	   706:         MOVEQ   #0,D0
00:000004EC 721C            	   707:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:000004EE 7400            	   708:         MOVEQ   #0,D2            ; Resultado em D2
                            	   709: .Loop:
00:000004F0 7000            	   710:         CLR.L   D0
00:000004F2 4EB8014E        	   711:         JSR     UART_ReadChar
00:000004F6 B03C000D        	   712:         CMP.B   #13,D0
00:000004FA 674C            	   713:         BEQ     .Done
00:000004FC B03C000A        	   714:         CMP.B   #10,D0
00:00000500 6746            	   715:         BEQ     .Done
                            	   716:         ;Tratando os numeros
00:00000502 B03C0030        	   717:         CMP.B   #'0',D0
00:00000506 6C02            	   718:         BGE     .maiorQueZero
00:00000508 60E6            	   719:         BRA     .Loop
                            	   720: .maiorQueZero:
00:0000050A B03C0039        	   721:         CMP.B   #'9',D0
00:0000050E 6F10            	   722:         BLE     .isdigit
                            	   723:         ;Tratando as letras
00:00000510 B03C0041        	   724:         CMP.B   #'A',D0
00:00000514 6C02            	   725:         BGE     .maiorQueA
00:00000516 60D8            	   726:         BRA     .Loop
                            	   727: .maiorQueA:
00:00000518 B03C0046        	   728:         CMP.B   #'F',D0
00:0000051C 6F16            	   729:         BLE     .isletter
00:0000051E 60D0            	   730:         BRA     .Loop
                            	   731: .isdigit:
00:00000520 903C0030        	   732:         SUB.B   #'0',D0
00:00000524 E3A8            	   733:         LSL.L   D1,D0
00:00000526 5901            	   734:         SUB.B   #4,D1
00:00000528 8480            	   735:         OR.L    D0,D2
00:0000052A 41F900081016    	   736:         LEA     addressInHex,A0
00:00000530 2082            	   737:         MOVE.L  D2,(A0)
00:00000532 60BC            	   738:         BRA     .Loop
                            	   739: .isletter:
00:00000534 903C0037        	   740:         SUB.B   #$37,D0
00:00000538 E3A8            	   741:         LSL.L   D1,D0
00:0000053A 5901            	   742:         SUB.B   #4,D1
00:0000053C 8480            	   743:         OR.L    D0,D2
00:0000053E 41F900081016    	   744:         LEA     addressInHex,A0
00:00000544 2082            	   745:         MOVE.L  D2,(A0)
00:00000546 60A8            	   746:         BRA     .Loop
                            	   747: .Done:
00:00000548 4EB8020E        	   748:     JSR     new_line
00:0000054C 41F900081016    	   749:     LEA     addressInHex,A0
00:00000552 2010            	   750:     MOVE.L  (A0),D0
