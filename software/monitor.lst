                            	   591: ; ----------------------------------------------------------------------
                            	   592: ; Subrotinas do Menu
                            	   593: ; ----------------------------------------------------------------------
                            	   594: 
                            	   595: ; 1. Seleciona UART
                            	   596: SelectUART:
00:000003FC 41F9000002ED    	   597:     LEA     PromptNotImplemented,A0
00:00000402 4EB8014E        	   598:     JSR     UART_WriteString
                            	   599:     ;LEA     UARTPrompt,A0
                            	   600:     ;JSR     UART_WriteString
                            	   601:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   602:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   603:     ;JSR     UART_Init           ; Reinicializa UART
00:00000406 4E75            	   604:     RTS
                            	   605: 
                            	   606: ; 2. Configura Baud Rate
                            	   607: SetBaudRate:
00:00000408 41F9000002ED    	   608:     LEA     PromptNotImplemented,A0
00:0000040E 4EB8014E        	   609:     JSR     UART_WriteString
                            	   610:     ;LEA     BaudPrompt,A0
                            	   611:     ;JSR     UART_WriteString
                            	   612:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   613:     ;MOVE.L  CurrentUART,A0
                            	   614:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
00:00000412 4E75            	   615:     RTS
                            	   616: 
                            	   617: ; 3. Carrega programa via serial
                            	   618: LoadProgram:
00:00000414 41F90000023F    	   619:     LEA     LoadPrompt,A0
00:0000041A 4EB8014E        	   620:     JSR     UART_WriteString
00:0000041E 4EB804F0        	   621:     JSR     UART_ReadHex        ; Lê endereço de destino
00:00000422 2240            	   622:     MOVE.L  D0,A1               ; A1 = ponteiro para RAM
                            	   623: 
00:00000424 4EB801EE        	   624:     JSR     new_line
00:00000428 4EB80386        	   625:     JSR     PrintHexAddress
00:0000042C 4EB801EE        	   626:     JSR     new_line
                            	   627: 
                            	   628:     ; Protocolo: [Tamanho(4B)][Dados...]
00:00000430 4EB8057E        	   629:     JSR     UART_ReadLong       ; Lê tamanho (32 bits)
                            	   630: 
00:00000434 41F90000026A    	   631:     LEA     LoadPromptReady,A0
00:0000043A 4EB8014E        	   632:     JSR     UART_WriteString
00:0000043E 4EB801EE        	   633:     JSR     new_line
00:00000442 2200            	   634:     MOVE.L  D0,D1               ; D1 = contador de bytes
                            	   635: 
                            	   636: .LoadLoop:
00:00000444 4EB80590        	   637:     JSR     UART_ReadByte       ; Lê byte
00:00000448 12C0            	   638:     MOVE.B  D0,(A1)+            ; Armazena na RAM
00:0000044A 5381            	   639:     SUBQ.L  #1,D1               ; Decrementa contador
00:0000044C 66F6            	   640:     BNE     .LoadLoop           ; Continua até terminar
                            	   641: 
00:0000044E 41F900000284    	   642:     LEA     LoadDoneMsg,A0
00:00000454 4EB8014E        	   643:     JSR     UART_WriteString
00:00000458 4E75            	   644:     RTS
                            	   645: 
                            	   646: ; 4. Grava programa manualmente (hex)
                            	   647: WriteProgram:
00:0000045A 41F9000002A3    	   648:     LEA     WritePrompt,A0
00:00000460 4EB8014E        	   649:     JSR     UART_WriteString
00:00000464 4EB804F0        	   650:     JSR     UART_ReadHex        ; Lê endereço
00:00000468 2240            	   651:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   652: 
00:0000046A 41F9000002B3    	   653:     LEA     WriteSizePrompt,A0
00:00000470 4EB8014E        	   654:     JSR     UART_WriteString
00:00000474 4EB804F0        	   655:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:00000478 2200            	   656:     MOVE.L  D0,D1               ; D1 = contador
                            	   657: 
                            	   658: .WriteLoop:
00:0000047A 4EB80590        	   659:     JSR     UART_ReadByte       ; Lê byte
00:0000047E 12C0            	   660:     MOVE.B  D0,(A1)+            ; Armazena
00:00000480 5381            	   661:     SUBQ.L  #1,D1
00:00000482 66F6            	   662:     BNE     .WriteLoop
                            	   663: 
00:00000484 41F9000002C5    	   664:     LEA     WriteDoneMsg,A0
00:0000048A 4EB8014E        	   665:     JSR     UART_WriteString
00:0000048E 4E75            	   666:     RTS
                            	   667: 
                            	   668: ; 5. Executa programa na RAM
                            	   669: RunProgram:
00:00000490 41F9000002DF    	   670:     LEA     RunPrompt,A0
00:00000496 4EB8014E        	   671:     JSR     UART_WriteString
00:0000049A 4EB804F0        	   672:     JSR     UART_ReadHex        ; Lê endereço
00:0000049E 2040            	   673:     MOVE.L  D0,A0
00:000004A0 4E90            	   674:     JSR     (A0)                ; Chama subrotina
00:000004A2 4E75            	   675:     RTS
