00:0000068E 323900081026    	   884:         MOVE.W  BUFFER_TAIL,D1
00:00000694 10301000        	   885:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   886: 
00:00000698 5401            	   887:         ADDQ.B  #2,D1              ; Incrementa como word
00:0000069A 024100FF        	   888:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000069E 33C100081026    	   889:         MOVE.W  D1,BUFFER_TAIL
                            	   890: 
00:000006A4 53790008102A    	   891:         SUBQ.W  #1,BUFFER_COUNT
00:000006AA 6006            	   892:         BRA     .Exit
