                            	   140: UART_Init:
00:0000010C 227900081008    	   141:     move.l   CurrentUART,a1
00:00000112 137C000D0004    	   142:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000118 137C00830006    	   143:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:0000011E 12BC0068        	   144:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000122 137C00000002    	   145:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000128 08A900070006    	   146:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:0000012E 4229000E        	   147:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000132 4E75            	   148:     RTS
