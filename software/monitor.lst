00:00000172 43F900081124    	   182:     LEA     xmodem_buffer,A1
00:00000178 303C0101        	   183:     MOVE.W  #$0101,D0    ; Valor inicial
                            	   184: .Loop:
00:0000017C 32C0            	   185:     MOVE.W  D0,(A1)+
00:0000017E D07C0101        	   186:     ADD.W   #$0101,D0    ; Incrementa cada byte do long
00:00000182 5341            	   187:     SUBQ.W  #1,D1
00:00000184 66F6            	   188:     BNE     .Loop
                            	   189: 
                            	   190: TESTE_BUFFER2:
00:00000186 7240D241        	   191:     MOVE.L  #$00000080,D1        ; 32 iterações (128 bytes / 4 bytes por long)
00:0000018A 43F900081124    	   192:     LEA     xmodem_buffer,A1
00:00000190 7001            	   193:     MOVE.L  #$00000001,D0    ; Valor inicial
                            	   194: .Loop:
00:00000192 12C0            	   195:     MOVE.B  D0,(A1)+
00:00000194 5200            	   196:     ADD.B   #$01,D0    ; Incrementa cada byte do long
00:00000196 5301            	   197:     SUBQ.B  #1,D1
00:00000198 66F8            	   198:     BNE     .Loop
                            	   199: 
                            	   200: TESTE_BUFFER3:
