                            	   824: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   825: ;         Senão, D0 contém o byte lido!
                            	   826: .loop1:
01:000015A6 4EB816F2        	   827:         JSR     BufferGet
01:000015AA B03C00FF        	   828:         CMP.B   #-1,D0          ; Buffer vazio?
01:000015AE 6706            	   829:         BEQ     .fim      ; Se sim, ignora
01:000015B0 4EB8121C        	   830:         JSR     UART_WriteChar
01:000015B4 60F0            	   831:         BRA     .loop1
                            	   832: .fim:
