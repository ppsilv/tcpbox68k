                            	   671: ; ----------------------------------------------------------------------
                            	   672: ; Rotinas Auxiliares
                            	   673: ; ----------------------------------------------------------------------
                            	   674: 
                            	   675: ; Lê número hexadecimal (retorna em D0)
                            	   676: UART_ReadHex1:
00:000004B4 2F01            	   677:         MOVE.L  D1,-(SP)
00:000004B6 2F02            	   678:         MOVE.L  D2,-(SP)
                            	   679: 
00:000004B8 41F900000314    	   680:         LEA     WritePrompt,A0
00:000004BE 4EB80188        	   681:         JSR     UART_WriteString
                            	   682: 
00:000004C2 4EB80228        	   683:         JSR     new_line
                            	   684: 
00:000004C6 7000            	   685:         MOVEQ   #0,D0
00:000004C8 7200            	   686:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000004CA 7400            	   687:         MOVEQ   #0,D2            ; Resultado em D2
                            	   688: 
                            	   689: .Loop:
00:000004CC 4EB8014E        	   690:         JSR     UART_ReadChar
00:000004D0 B03C000D        	   691:         CMP.B   #13,D0
00:000004D4 670C            	   692:         BEQ     .Done
00:000004D6 B03C000A        	   693:         CMP.B   #10,D0
00:000004DA 6706            	   694:         BEQ     .Done
00:000004DC 4EB805CA        	   695:         JSR     BufferPut
00:000004E0 60EA            	   696:         BRA     .Loop
                            	   697: .Done:
                            	   698: ;         BSR     UART_BufferGet
                            	   699: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   700: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   701: ;         Senão, D0 contém o byte lido!
                            	   702: .loop1:
00:000004E2 4EB80602        	   703:     JSR     BufferGet
00:000004E6 B03C00FF        	   704:     CMP.B   #-1,D0          ; Buffer vazio?
00:000004EA 6706            	   705:     BEQ     .fim      ; Se sim, ignora
00:000004EC 4EB80134        	   706:     JSR     UART_WriteChar
00:000004F0 60F0            	   707:     BRA     .loop1
                            	   708: .fim:
00:000004F2 241F            	   709:     MOVE.L  (SP)+,D2
00:000004F4 221F            	   710:     MOVE.L  (SP)+,D1
00:000004F6 4EB80228        	   711:     JSR     new_line
00:000004FA 6000FB70        	   712:     bra     MenuLoop ;provisoriamente
00:000004FE 4E75            	   713:     RTS
                            	   714: 
                            	   715: ; Lê número hexadecimal (retorna em D0)
                            	   716: UART_ReadHex:
00:00000500 2F01            	   717:         MOVE.L  D1,-(SP)
00:00000502 2F02            	   718:         MOVE.L  D2,-(SP)
                            	   719: 
00:00000504 7000            	   720:         MOVEQ   #0,D0
00:00000506 721C            	   721:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:00000508 7400            	   722:         MOVEQ   #0,D2            ; Resultado em D2
                            	   723: .Loop:
00:0000050A 7000            	   724:         CLR.L   D0
00:0000050C 4EB8014E        	   725:         JSR     UART_ReadChar
00:00000510 B03C000D        	   726:         CMP.B   #13,D0
00:00000514 674C            	   727:         BEQ     .Done
00:00000516 B03C000A        	   728:         CMP.B   #10,D0
00:0000051A 6746            	   729:         BEQ     .Done
                            	   730:         ;Tratando os numeros
00:0000051C B03C0030        	   731:         CMP.B   #'0',D0
00:00000520 6C02            	   732:         BGE     .maiorQueZero
00:00000522 60E6            	   733:         BRA     .Loop
                            	   734: .maiorQueZero:
00:00000524 B03C0039        	   735:         CMP.B   #'9',D0
00:00000528 6F10            	   736:         BLE     .isdigit
                            	   737:         ;Tratando as letras
00:0000052A B03C0041        	   738:         CMP.B   #'A',D0
00:0000052E 6C02            	   739:         BGE     .maiorQueA
00:00000530 60D8            	   740:         BRA     .Loop
                            	   741: .maiorQueA:
00:00000532 B03C0046        	   742:         CMP.B   #'F',D0
00:00000536 6F16            	   743:         BLE     .isletter
00:00000538 60D0            	   744:         BRA     .Loop
                            	   745: .isdigit:
00:0000053A 903C0030        	   746:         SUB.B   #'0',D0
00:0000053E E3A8            	   747:         LSL.L   D1,D0
00:00000540 5901            	   748:         SUB.B   #4,D1
00:00000542 8480            	   749:         OR.L    D0,D2
00:00000544 41F900081016    	   750:         LEA     addressInHex,A0
00:0000054A 2082            	   751:         MOVE.L  D2,(A0)
