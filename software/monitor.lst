                            	   387: ; ----------------------------------------------------------------------
                            	   388: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   389: ; Entrada:
                            	   390: ;   D0.L = Valor a ser impresso (32 bits)
                            	   391: ;   D1.W = Número de dígitos (1-8)
                            	   392: ; ----------------------------------------------------------------------
                            	   393: PrintHexPRECISA_DE_REVISAO:
00:000002BA 4E56FFF8        	   394:         LINK    A6,#-8            ; Reserva espaço na pilha
00:000002BE 2F02            	   395:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002C0 2D40FFFC        	   396:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000002C4 3D41FFFA        	   397:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   398: 
00:000002C8 323C0008        	   399:         MOVE.W  #$0008,D1
                            	   400: 
                            	   401:         ; Ajusta para começar pelo dígito mais significativo
00:000002CC E549            	   402:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000002CE 5941            	   403:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   404: 
                            	   405: .PrintLoop:
00:000002D0 202EFFFC        	   406:         MOVE.L  -4(A6),D0         ; Recupera valor
00:000002D4 3401            	   407:         MOVE.W  D1,D2             ; Posição do nibble
00:000002D6 E5B8            	   408:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:000002D8 02800000000F    	   409:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   410: 
                            	   411:         ; Converte para ASCII
00:000002DE B03C0009        	   412:         CMP.B   #9,D0
00:000002E2 6302            	   413:         BLS     .Decimal
00:000002E4 5E00            	   414:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   415: .Decimal:
00:000002E6 D03C0030        	   416:         ADD.B   #'0',D0           ; Converte para caractere
                            	   417: 
                            	   418:         ; Imprime caractere
00:000002EA 4EB80172        	   419:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   420: 
00:000002EE 5941            	   421:         SUBQ.W  #4,D1             ; Próximo nibble
00:000002F0 6ADE            	   422:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   423: 
                            	   424:         ; Espaço final para separação
00:000002F2 103C0020        	   425:         MOVE.B  #' ',D0
00:000002F6 4EB80172        	   426:         JSR     UART_WriteChar
                            	   427: 
00:000002FA 241F            	   428:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002FC 4E5E            	   429:         UNLK    A6                ; Restaura frame
00:000002FE 4E75            	   430:         RTS
