                            	   248: ; ----------------------------------------------------------------------
                            	   249: ; Rotinas de E/S da UART
                            	   250: ; ----------------------------------------------------------------------
                            	   251: 
                            	   252: UART_Init:
00:00000200 227900081008    	   253:     move.l   CurrentUART,a1
00:00000206 137C000D0004    	   254:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000020C 137C00830006    	   255:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000212 12BC0068        	   256:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000216 137C00000002    	   257:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000021C 08A900070006    	   258:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000222 4229000E        	   259:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000226 4E75            	   260:     RTS
                            	   261: 
                            	   262:     ; Escreve caractere (D0.B)
                            	   263: UART_WriteChar:
00:00000228 2F08            	   264:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000022A 2F00            	   265:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000022C 207900081008    	   266:     move.l   CurrentUART,A0
                            	   267: .WaitTx:
00:00000232 08280005000A    	   268:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000238 67F8            	   269:     BEQ     .WaitTx
00:0000023A 1080            	   270:     MOVE.B  D0,THR(A0)      ; transmit byte
00:0000023C 201F            	   271:     MOVE.L  (SP)+,D0        ;Restaura D0
00:0000023E 205F            	   272:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000240 4E75            	   273:     RTS
                            	   274: 
                            	   275: 
                            	   276: ; Lê caractere (retorna em D0)
                            	   277: UART_ReadChar:
00:00000242 2F08            	   278:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000244 207900081008    	   279:     MOVE.L   CurrentUART,A0
                            	   280: .WaitRx:
00:0000024A 08280000000A    	   281:     BTST    #0,LSR(A0)        ; RX ready?
00:00000250 67F8            	   282:     BEQ     .WaitRx
00:00000252 1010            	   283:     MOVE.B  RHR(A0),D0
00:00000254 205F            	   284:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000256 B03C001B        	   285:     CMP.B   #$1b,D0
00:0000025A 6704            	   286:     BEQ     .fim
00:0000025C 4EB80228        	   287:     JSR     UART_WriteChar
                            	   288: .fim
00:00000260 4E75            	   289:     RTS
                            	   290: 
                            	   291: ; Lê caractere (retorna em D0)
                            	   292: UART_ReadCharNonEcho:
00:00000262 2F08            	   293:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000264 207900081008    	   294:     MOVE.L  CurrentUART,A0
                            	   295: .WaitRx:
00:0000026A 08280000000A    	   296:     BTST    #0,LSR(A0)        ; RX ready?
00:00000270 67F8            	   297:     BEQ     .WaitRx
                            	   298: 
00:00000272 1010            	   299:     MOVE.B  RHR(A0),D0
00:00000274 205F            	   300:     MOVE.L  (SP)+,A0        ;Restaura A0
                            	   301: 
00:00000276 4E75            	   302:     RTS
                            	   303: 
                            	   304: ; ----------------------------------------------------------------------
                            	   305: ; UART_WriteString - Envia string terminada em null para UART
                            	   306: ; Entrada:
                            	   307: ;   A0 = Ponteiro para a string (endereço da string)
                            	   308: ; ----------------------------------------------------------------------
                            	   309: UART_WriteString:
00:00000278 2F08            	   310:     MOVE.L  A0,-(SP)      ; Preserva D0
00:0000027A 2F00            	   311:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   312: .WriteLoop:
00:0000027C 1018            	   313:     MOVE.B  (A0)+,D0      ; Pega caractere
00:0000027E 6706            	   314:     BEQ     .Done
00:00000280 4EB80228        	   315:     JSR     UART_WriteChar ; Use sua rotine existente
00:00000284 60F6            	   316:     BRA     .WriteLoop
                            	   317: .Done:
00:00000286 201F            	   318:     MOVE.L  (SP)+,D0
00:00000288 205F            	   319:     MOVE.L  (SP)+,A0
00:0000028A 4E75            	   320:     RTS
