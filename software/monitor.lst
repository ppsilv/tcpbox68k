                            	   727: 
                            	   728: ; 1. Seleciona UART
                            	   729: SELECTUART:
01:000014D6 41F900000394    	   730:         LEA     PromptNotImplemented,A0
01:000014DC 4EB8126C        	   731:         JSR     UART_WriteString
                            	   732:         ;LEA     UARTPrompt,A0
                            	   733:         ;JSR     UART_WriteString
                            	   734:         ;JSR     UART_ReadHex        ; Lê endereço da UART
