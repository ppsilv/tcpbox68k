                            	   797: ;--------------------------------------------------
                            	   798: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   799: ;--------------------------------------------------
                            	   800: ; Exemplo: insere 'A' no buffer
                            	   801: ;          MOVE.B  #'A',D0
                            	   802: ;          JSR     UART_BufferPut
                            	   803: 
                            	   804: BufferPut:
00:000005B0 2F01            	   805:     MOVE.L  D1,-(SP)
00:000005B2 2F08            	   806:     MOVE.L  A0,-(SP)
                            	   807: 
                            	   808:     ;ANDI.W    #$FF00,D0
00:000005B4 41F900081024    	   809:     LEA     BUFFER,A0
00:000005BA 323900081022    	   810:     MOVE.W  BUFFER_COUNT,D1
                            	   811: 
00:000005C0 B27C0100        	   812:     CMP.W   #256,D1
00:000005C4 6C1C            	   813:     BGE     .BufferFull
                            	   814: 
                            	   815:     ; Modificado para usar deslocamento de 16 bits
00:000005C6 32390008101A    	   816:     MOVE.W  BUFFER_HEAD,D1
00:000005CC D0C1            	   817:     ADD     D1,A0
00:000005CE 1080            	   818:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   819: 
00:000005D0 5441            	   820:     ADD     #2,D1              ; Incrementa como word
00:000005D2 024100FF        	   821:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005D6 33C10008101A    	   822:     MOVE.W  D1,BUFFER_HEAD
                            	   823: 
00:000005DC 527900081022    	   824:     ADDQ.W  #1,BUFFER_COUNT
                            	   825: 
                            	   826: .BufferFull:
00:000005E2 205F            	   827:     MOVE.L  (SP)+,A0
00:000005E4 221F            	   828:     MOVE.L  (SP)+,D1
                            	   829: 
00:000005E6 4E75            	   830:     RTS
                            	   831: 
                            	   832: ;--------------------------------------------------
                            	   833: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   834: ;--------------------------------------------------
                            	   835: ;Exemplo: Lendo byte do buffer
                            	   836: ;         BSR     UART_BufferGet
                            	   837: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   838: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   839: ;         Senão, D0 contém o byte lido!
                            	   840: BufferGet:
00:000005E8 2F01            	   841:     MOVE.L  D1,-(SP)
00:000005EA 2F08            	   842:     MOVE.L  A0,-(SP)
                            	   843: 
00:000005EC 323900081022    	   844:     MOVE.W  BUFFER_COUNT,D1
00:000005F2 6724            	   845:     BEQ     .BufferEmpty
                            	   846: 
00:000005F4 41F900081024    	   847:     LEA     BUFFER,A0
                            	   848: 
                            	   849:     ; Modificado para usar deslocamento de 16 bits
00:000005FA 32390008101E    	   850:     MOVE.W  BUFFER_TAIL,D1
00:00000600 10301000        	   851:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   852: 
00:00000604 5401            	   853:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000606 024100FF        	   854:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000060A 33C10008101E    	   855:     MOVE.W  D1,BUFFER_TAIL
                            	   856: 
00:00000610 537900081022    	   857:     SUBQ.W  #1,BUFFER_COUNT
00:00000616 6006            	   858:     BRA     .Exit
                            	   859: 
                            	   860: .BufferEmpty:
00:00000618 4EB80624        	   861:     JSR     FBufferEmpty
00:0000061C 70FF            	   862:     MOVEQ   #-1,D0
                            	   863: .Exit:
00:0000061E 205F            	   864:     MOVE.L  (SP)+,A0
00:00000620 221F            	   865:     MOVE.L  (SP)+,D1
00:00000622 4E75            	   866:     RTS
                            	   867: 
                            	   868: FBufferEmpty:
00:00000624 4EB8020E        	   869:         JSR     new_line
00:00000628 41F90000036F    	   870:         LEA     BufferEmpty,A0
00:0000062E 4EB8016E        	   871:         JSR     UART_WriteString
00:00000632 4EB8020E        	   872:         JSR     new_line
00:00000636 4E75            	   873:         RTS
                            	   874: ;---------------------------------------------------------------------
                            	   875: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   876: ;---------------------------------------------------------------------
                            	   877: ClearBufferPointers:
00:00000638 23FC000000000008	   878:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000640 101A
00:00000642 23FC000000000008	   879:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:0000064A 101E
00:0000064C 33FC000000081022	   880:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000654 4E75            	   881:     RTS
                            	   882: ;---------------------------------------------------------------------
                            	   883: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   884: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   885: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   886: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   887: ;---------------------------------------------------------------------
                            	   888: MontaAddress:
00:00000656 48E73C80        	   889:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   890: 
                            	   891:     ; Verifica se há pelo menos 8 bytes no buffer
00:0000065A 323900081022    	   892:     MOVE.W  BUFFER_COUNT,D1
00:00000660 B27C0008        	   893:     CMP.W   #8,D1
00:00000664 6D38            	   894:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   895: 
00:00000666 41F900081024    	   896:     LEA     BUFFER,A0      ; A0 = base do buffer
00:0000066C 24390008101E    	   897:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000672 7000            	   898:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000674 7607            	   899:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   900: 
                            	   901: .ReadLoop:
00:00000676 18302800        	   902:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:0000067A 0204000F        	   903:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   904: 
                            	   905:     ; Desloca e insere os 4 bits em D0
00:0000067E E988            	   906:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000680 8004            	   907:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   908: 
                            	   909:     ; Atualiza tail (circular)
00:00000682 5282            	   910:     ADDQ.L  #1,D2
00:00000684 0282000000FF    	   911:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   912: 
00:0000068A 51CBFFEA        	   913:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   914: 
                            	   915:     ; Atualiza ponteiros globais
00:0000068E 23C20008101E    	   916:     MOVE.L  D2,BUFFER_TAIL
00:00000694 517900081022    	   917:     SUB.W   #8,BUFFER_COUNT
                            	   918: 
00:0000069A 7200            	   919:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:0000069C 6004            	   920:     BRA     .Exit
                            	   921: 
                            	   922: .BufferUnderrun:
00:0000069E 72FF            	   923:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006A0 7000            	   924:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   925: 
                            	   926: .Exit:
00:000006A2 4CDF013C        	   927:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000006A6 4E75            	   928:     RTS
                            	   929: 
