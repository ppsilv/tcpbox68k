                            	   133: ; =============================================
                            	   134: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   135: ; Entrada: D0 = tempo em ms (16 bits)
                            	   136: ; Destrói: D0
                            	   137: ; =============================================
                            	   138: DELAY_MS:
00:00000116 2F01            	   139:         MOVE.L  d1,-(sp)          ; Salva D1
00:00000118 3200            	   140:         MOVE.W  d0,d1             ; Contador de ms
00:0000011A 670E            	   141:         BEQ.S   .end              ; Se D0=0, sai
                            	   142: .loop_ms:
00:0000011C 203C00003E80    	   143:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   144: .inner_loop:
00:00000122 5380            	   145:         SUBQ.L  #1,d0             ; 4 ciclos
00:00000124 66FC            	   146:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
00:00000126 5341            	   147:         SUBQ.W  #1,d1             ; 1 ms
00:00000128 66F2            	   148:         BNE.S   .loop_ms
                            	   149: .end:
00:0000012A 221F            	   150:         MOVE.L  (sp)+,d1          ; Restaura D1
00:0000012C 4E75            	   151:         rts
