00:000005B4 4EB8014E        	   802:     JSR     UART_ReadChar
00:000005B8 B03C0041        	   803:     CMP.B   #'A',D0
00:000005BC 6D02            	   804:     BLT     .Digit
00:000005BE 5F00            	   805:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   806: .Digit:
00:000005C0 903C0030        	   807:     SUB.B   #'0',D0
00:000005C4 C03C000F        	   808:     AND.B   #$0F,D0
00:000005C8 4E75            	   809:     RTS
