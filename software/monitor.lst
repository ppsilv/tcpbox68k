                            	   177: 
                            	   178: UART_INIT:
00:0000014A 227900081008    	   179:         move.l   CurrentUART,a1
00:00000150 137C000D0004    	   180:         move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000156 137C00830006    	   181:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:0000015C 12BC0068        	   182:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000160 137C00000002    	   183:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000166 08A900070006    	   184:         bclr.b  #7,LCR(a1)              ; disable divisor latch
00:0000016C 4229000E        	   185:         clr.b   SCR(a1)                 ; clear the scratch register
00:00000170 4E75            	   186:         RTS
                            	   187: 
                            	   188:     ; Escreve caractere (D0.B)
                            	   189: UART_WriteChar:
00:00000172 2F08            	   190:         MOVE.L  A0,-(SP)        ; Preserva A0
00:00000174 2F00            	   191:         MOVE.L  D0,-(SP)        ; Preserva D0
00:00000176 207900081008    	   192:         move.l   CurrentUART,A0
                            	   193: .WaitTx:
00:0000017C 08280005000A    	   194:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000182 67F8            	   195:         BEQ     .WaitTx
00:00000184 1080            	   196:         MOVE.B  D0,THR(A0)      ; transmit byte
00:00000186 201F            	   197:         MOVE.L  (SP)+,D0        ;Restaura D0
00:00000188 205F            	   198:         MOVE.L  (SP)+,A0        ;Restaura A0
00:0000018A 4E75            	   199:         RTS
                            	   200: 
                            	   201: 
                            	   202: ; Lê caractere (retorna em D0)
                            	   203: UART_ReadChar:
00:0000018C 2F08            	   204:         MOVE.L  A0,-(SP)        ; Preserva A0
00:0000018E 207900081008    	   205:         MOVE.L   CurrentUART,A0
                            	   206: .WaitRx:
00:00000194 08280000000A    	   207:         BTST    #0,LSR(A0)        ; RX ready?
00:0000019A 67F8            	   208:         BEQ     .WaitRx
00:0000019C 1010            	   209:         MOVE.B  RHR(A0),D0
00:0000019E 205F            	   210:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001A0 B03C001B        	   211:         CMP.B   #$1b,D0
00:000001A4 6704            	   212:         BEQ     .fim
00:000001A6 4EB80172        	   213:         JSR     UART_WriteChar
                            	   214: .fim
00:000001AA 4E75            	   215:         RTS
                            	   216: 
