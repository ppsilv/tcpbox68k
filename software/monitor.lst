                            	   656: ; ----------------------------------------------------------------------
                            	   657: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   658: ; Entrada: D0 = endereço
                            	   659: ; ----------------------------------------------------------------------
                            	   660: PrintHexAddress:
01:0000148A 4840            	   661:         SWAP    D0                ; Imprime parte alta primeiro
01:0000148C 4EB81492        	   662:         JSR     PrintWordHex
01:00001490 4840            	   663:         SWAP    D0                ; Parte baixa
                            	   664:         ; Continua para PrintWordHex
                            	   665: 
                            	   666: ; ----------------------------------------------------------------------
                            	   667: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   668: ; Entrada: D0.w = valor
                            	   669: ; ----------------------------------------------------------------------
                            	   670: PrintWordHex:
01:00001492 E158            	   671:         ROL.W   #8,D0             ; Byte mais significativo primeiro
01:00001494 4EB8149A        	   672:         JSR     PrintByteHex
01:00001498 E058            	   673:         ROR.W   #8,D0             ; Byte menos significativo
                            	   674:         ; Continua para PrintByteHex
                            	   675: 
                            	   676: ; ----------------------------------------------------------------------
                            	   677: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   678: ; Entrada: D0.b = valor
                            	   679: ; ----------------------------------------------------------------------
                            	   680: PrintByteHex:
01:0000149A 1F00            	   681:         MOVE.B  D0,-(SP)          ; Salva byte original
01:0000149C E808            	   682:         LSR.B   #4,D0             ; Nibble alto
01:0000149E 6106            	   683:         BSR     PrintNibble
01:000014A0 101F            	   684:         MOVE.B  (SP)+,D0          ; Recupera byte
01:000014A2 0200000F        	   685:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   686:         ; Continua para PrintNibble
                            	   687: ; ----------------------------------------------------------------------
                            	   688: ; PrintNibble - Imprime um nibble em hex
                            	   689: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   690: ; ----------------------------------------------------------------------
                            	   691: PrintNibble:
01:000014A6 B03C0009        	   692:         CMP.B   #9,D0
01:000014AA 6302            	   693:         BLS     .Decimal
01:000014AC 5E00            	   694:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   695: .Decimal:
01:000014AE D03C0030        	   696:         ADD.B   #'0',D0
01:000014B2 4EF8121C        	   697:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   698: 
                            	   699: ;CLEARRAM:
                            	   700: ;        LEA     $80000,A0
                            	   701: ;        LEA     $9FFFF,A1
                            	   702: ;        ;LEA     $BFFFF,A1
                            	   703: ;        MOVEQ   #0,D0
                            	   704: ;.ClearLoop:
                            	   705: ;        MOVE.L  D0,(A0)+
                            	   706: ;        CMPA.L  A0,A1
                            	   707: ;        BHI     .ClearLoop
                            	   708: ;        RTS
                            	   709: 
                            	   710: 
                            	   711: CLEARRAM3:
01:000014B6 20790008101E    	   712:         MOVE.L  (addressInHex),A0
01:000014BC 20390008101E    	   713:         MOVE.L  (addressInHex),D0
01:000014C2 D0BC00001000    	   714:         ADD.L   #$1000,D0
01:000014C8 2240            	   715:         MOVE.L  D0,A1
01:000014CA 7000            	   716:         MOVEQ   #0,D0
                            	   717: .ClearLoop:
01:000014CC 20C0            	   718:         MOVE.L  D0,(A0)+
01:000014CE B3C8            	   719:         CMPA.L  A0,A1
01:000014D0 62FA            	   720:         BHI     .ClearLoop
01:000014D2 6000FBE0        	   721:         BRA     MenuLoop
