                            	   376: 
00:000002D4 123C000A        	   377:     MOVE.B  #10,D1
00:000002D8 6158            	   378:     BSR     Div32x16
                            	   379: 
                            	   380: ;4
00:000002DA 2F00            	   381:     move.l  d0,-(SP)
00:000002DC 4EB804B4        	   382:     jsr     PrintHexAddress
00:000002E0 4EB8031C        	   383:     jsr     new_line
00:000002E4 221F            	   384:     move.l  (SP)+,D1
00:000002E6 201F            	   385:     move.l  (SP)+,D0
                            	   386: 
