                            	   144: UART_Init:
00:00000112 227900081008    	   145:     move.l   CurrentUART,a1
00:00000118 137C000D0004    	   146:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000011E 137C00830006    	   147:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000124 12BC0068        	   148:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000128 137C00000002    	   149:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000012E 08A900070006    	   150:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000134 4229000E        	   151:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000138 4E75            	   152:     RTS
                            	   153: 
                            	   154:     ; Escreve caractere (D0.B)
                            	   155: UART_WriteChar:
00:0000013A 2F08            	   156:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000013C 2F00            	   157:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000013E 207900081008    	   158:     move.l   CurrentUART,A0
                            	   159: .WaitTx:
00:00000144 08280005000A    	   160:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:0000014A 67F8            	   161:     BEQ     .WaitTx
00:0000014C 1080            	   162:     MOVE.B  D0,THR(A0)      ; transmit byte
00:0000014E 201F            	   163:     MOVE.L  (SP)+,D0        ;Restaura D0
00:00000150 205F            	   164:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000152 4E75            	   165:     RTS
                            	   166: 
                            	   167: 
                            	   168: ; Lê caractere (retorna em D0)
                            	   169: UART_ReadChar:
00:00000154 2F08            	   170:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000156 207900081008    	   171:     move.l   CurrentUART,A0
                            	   172: .WaitRx:
00:0000015C 08280000000A    	   173:     BTST    #0,LSR(A0)        ; RX ready?
00:00000162 67F8            	   174:     BEQ     .WaitRx
00:00000164 1010            	   175:     MOVE.B  RHR(A0),D0
00:00000166 205F            	   176:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000168 4EB8013A        	   177:     JSR     UART_WriteChar
00:0000016C 4E75            	   178:     RTS
