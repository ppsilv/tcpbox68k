                            	  1083:         ;SINALIZA NACK SENT
00:00000808 303C0400        	  1084:         MOVE.W  #$0400,D0
00:0000080C 4EB8012E        	  1085:         JSR     __write_leds
00:00000810 103C0006        	  1086:         MOVE.B  #ACK,D0
00:00000814 4EB8019A        	  1087:         JSR     UART_WriteChar
00:00000818 6000FF54        	  1088:         BRA     Receive_Loop
                            	  1089: 
                            	  1090: Send_NAK:
00:0000081C 103C0015        	  1091:         MOVE.B  #NAK,D0
00:00000820 4EB8019A        	  1092:         JSR     UART_WriteChar
00:00000824 6000FF48        	  1093:         BRA     Receive_Loop
                            	  1094: 
