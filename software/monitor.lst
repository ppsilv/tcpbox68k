                            	   125: ; =============================================
                            	   126: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   127: ; Entrada: D0 = tempo em ms (16 bits)
                            	   128: ; Destrói: D0
                            	   129: ; =============================================
                            	   130: DELAY_MS:
00:000000EE 2F01            	   131:         MOVE.L  d1,-(sp)          ; Salva D1
00:000000F0 3200            	   132:         MOVE.W  d0,d1             ; Contador de ms
00:000000F2 670E            	   133:         BEQ.S   .end              ; Se D0=0, sai
                            	   134: .loop_ms:
00:000000F4 203C00003E80    	   135:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   136: .inner_loop:
00:000000FA 5380            	   137:         SUBQ.L  #1,d0             ; 4 ciclos
00:000000FC 66FC            	   138:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
00:000000FE 5341            	   139:         SUBQ.W  #1,d1             ; 1 ms
00:00000100 66F2            	   140:         BNE.S   .loop_ms
                            	   141: .end:
00:00000102 221F            	   142:         MOVE.L  (sp)+,d1          ; Restaura D1
00:00000104 4E75            	   143:         rts
