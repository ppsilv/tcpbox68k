                            	   131: ; =============================================
                            	   132: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   133: ; Entrada: D0 = tempo em ms (16 bits)
                            	   134: ; Destrói: D0
                            	   135: ; =============================================
                            	   136: Delay_ms:
00:00000112 2F01            	   137:     move.l  d1,-(sp)          ; Salva D1
00:00000114 3200            	   138:     move.w  d0,d1             ; Contador de ms
00:00000116 670E            	   139:     beq.s   .end              ; Se D0=0, sai
                            	   140: .loop_ms:
00:00000118 203C00003E80    	   141:     move.l  #16000,d0         ; Ciclos por ms (16MHz)
                            	   142: .inner_loop:
00:0000011E 5380            	   143:     subq.l  #1,d0             ; 4 ciclos
00:00000120 66FC            	   144:     bne.s   .inner_loop       ; 10 ciclos (se taken)
00:00000122 5341            	   145:     subq.w  #1,d1             ; 1 ms
00:00000124 66F2            	   146:     bne.s   .loop_ms
                            	   147: .end:
00:00000126 221F            	   148:     move.l  (sp)+,d1          ; Restaura D1
00:00000128 4E75            	   149:     rts
