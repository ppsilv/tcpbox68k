                            	   853: ;--------------------------------------------------
                            	   854: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   855: ;--------------------------------------------------
                            	   856: ;Exemplo: Lendo byte do buffer
                            	   857: ;         BSR     UART_BufferGet
                            	   858: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   859: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   860: ;         Senão, D0 contém o byte lido!
                            	   861: BufferGet:
00:00000652 2F01            	   862:         MOVE.L  D1,-(SP)
00:00000654 2F08            	   863:         MOVE.L  A0,-(SP)
                            	   864: 
00:00000656 32390008102A    	   865:         MOVE.W  BUFFER_COUNT,D1
00:0000065C 6724            	   866:         BEQ     .BufferEmpty
                            	   867: 
00:0000065E 41F90008102C    	   868:         LEA     BUFFER,A0
                            	   869: 
                            	   870:         ; Modificado para usar deslocamento de 16 bits
00:00000664 323900081026    	   871:         MOVE.W  BUFFER_TAIL,D1
00:0000066A 10301000        	   872:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   873: 
00:0000066E 5401            	   874:         ADDQ.B  #2,D1              ; Incrementa como word
00:00000670 024100FF        	   875:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000674 33C100081026    	   876:         MOVE.W  D1,BUFFER_TAIL
                            	   877: 
00:0000067A 53790008102A    	   878:         SUBQ.W  #1,BUFFER_COUNT
00:00000680 6006            	   879:         BRA     .Exit
                            	   880: 
