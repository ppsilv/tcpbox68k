                            	   818: ;--------------------------------------------------
                            	   819: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   820: ;--------------------------------------------------
                            	   821: ; Exemplo: insere 'A' no buffer
                            	   822: ;          MOVE.B  #'A',D0
                            	   823: ;          JSR     UART_BufferPut
                            	   824: 
                            	   825: BufferPut:
00:0000061A 2F01            	   826:         MOVE.L  D1,-(SP)
00:0000061C 2F08            	   827:         MOVE.L  A0,-(SP)
                            	   828: 
                            	   829:         ;ANDI.W    #$FF00,D0
00:0000061E 41F90008102C    	   830:         LEA     BUFFER,A0
00:00000624 32390008102A    	   831:         MOVE.W  BUFFER_COUNT,D1
                            	   832: 
00:0000062A B27C0100        	   833:         CMP.W   #256,D1
00:0000062E 6C1C            	   834:         BGE     .BufferFull
                            	   835: 
                            	   836:         ; Modificado para usar deslocamento de 16 bits
00:00000630 323900081022    	   837:         MOVE.W  BUFFER_HEAD,D1
00:00000636 D0C1            	   838:         ADD     D1,A0
00:00000638 1080            	   839:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   840: 
00:0000063A 5441            	   841:         ADD     #2,D1              ; Incrementa como word
00:0000063C 024100FF        	   842:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000640 33C100081022    	   843:         MOVE.W  D1,BUFFER_HEAD
                            	   844: 
00:00000646 52790008102A    	   845:         ADDQ.W  #1,BUFFER_COUNT
                            	   846: 
                            	   847: .BufferFull:
00:0000064C 205F            	   848:         MOVE.L  (SP)+,A0
00:0000064E 221F            	   849:         MOVE.L  (SP)+,D1
                            	   850: 
00:00000650 4E75            	   851:         RTS
