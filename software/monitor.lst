                            	   931: ;--------------------------------------------------
                            	   932: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   933: ;--------------------------------------------------
                            	   934: ; Exemplo: insere 'A' no buffer
                            	   935: ;          MOVE.B  #'A',D0
                            	   936: ;          JSR     UART_BufferPut
                            	   937: 
                            	   938: BufferPut:
00:000006BC 2F01            	   939:     MOVE.L  D1,-(SP)
00:000006BE 2F08            	   940:     MOVE.L  A0,-(SP)
                            	   941: 
                            	   942:     ;ANDI.W    #$FF00,D0
00:000006C0 41F900081024    	   943:     LEA     BUFFER,A0
00:000006C6 323900081022    	   944:     MOVE.W  BUFFER_COUNT,D1
                            	   945: 
00:000006CC B27C0100        	   946:     CMP.W   #256,D1
00:000006D0 6C1C            	   947:     BGE     .BufferFull
                            	   948: 
                            	   949:     ; Modificado para usar deslocamento de 16 bits
00:000006D2 32390008101A    	   950:     MOVE.W  BUFFER_HEAD,D1
00:000006D8 D0C1            	   951:     ADD     D1,A0
00:000006DA 1080            	   952:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   953: 
00:000006DC 5441            	   954:     ADD     #2,D1              ; Incrementa como word
00:000006DE 024100FF        	   955:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000006E2 33C10008101A    	   956:     MOVE.W  D1,BUFFER_HEAD
                            	   957: 
00:000006E8 527900081022    	   958:     ADDQ.W  #1,BUFFER_COUNT
                            	   959: 
                            	   960: .BufferFull:
00:000006EE 205F            	   961:     MOVE.L  (SP)+,A0
00:000006F0 221F            	   962:     MOVE.L  (SP)+,D1
                            	   963: 
00:000006F2 4E75            	   964:     RTS
                            	   965: 
                            	   966: ;--------------------------------------------------
                            	   967: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   968: ;--------------------------------------------------
                            	   969: ;Exemplo: Lendo byte do buffer
                            	   970: ;         BSR     UART_BufferGet
                            	   971: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   972: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   973: ;         Senão, D0 contém o byte lido!
                            	   974: BufferGet:
00:000006F4 2F01            	   975:     MOVE.L  D1,-(SP)
00:000006F6 2F08            	   976:     MOVE.L  A0,-(SP)
                            	   977: 
00:000006F8 323900081022    	   978:     MOVE.W  BUFFER_COUNT,D1
00:000006FE 6724            	   979:     BEQ     .BufferEmpty
                            	   980: 
00:00000700 41F900081024    	   981:     LEA     BUFFER,A0
                            	   982: 
                            	   983:     ; Modificado para usar deslocamento de 16 bits
00:00000706 32390008101E    	   984:     MOVE.W  BUFFER_TAIL,D1
00:0000070C 10301000        	   985:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   986: 
00:00000710 5401            	   987:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000712 024100FF        	   988:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000716 33C10008101E    	   989:     MOVE.W  D1,BUFFER_TAIL
                            	   990: 
00:0000071C 537900081022    	   991:     SUBQ.W  #1,BUFFER_COUNT
00:00000722 6006            	   992:     BRA     .Exit
                            	   993: 
                            	   994: .BufferEmpty:
00:00000724 4EB80730        	   995:     JSR     FBufferEmpty
00:00000728 70FF            	   996:     MOVEQ   #-1,D0
                            	   997: .Exit:
00:0000072A 205F            	   998:     MOVE.L  (SP)+,A0
00:0000072C 221F            	   999:     MOVE.L  (SP)+,D1
00:0000072E 4E75            	  1000:     RTS
                            	  1001: 
                            	  1002: FBufferEmpty:
00:00000730 4EB80318        	  1003:         JSR     new_line
00:00000734 41F90000037C    	  1004:         LEA     BufferEmpty,A0
00:0000073A 4EB80278        	  1005:         JSR     UART_WriteString
00:0000073E 4EB80318        	  1006:         JSR     new_line
00:00000742 4E75            	  1007:         RTS
                            	  1008: ;---------------------------------------------------------------------
                            	  1009: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1010: ;---------------------------------------------------------------------
                            	  1011: ClearBufferPointers:
00:00000744 23FC000000000008	  1012:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000074C 101A
00:0000074E 23FC000000000008	  1013:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000756 101E
00:00000758 33FC000000081022	  1014:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000760 4E75            	  1015:     RTS
                            	  1016: ;---------------------------------------------------------------------
                            	  1017: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1018: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1019: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1020: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1021: ;---------------------------------------------------------------------
                            	  1022: MontaAddress:
00:00000762 48E73C80        	  1023:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1024: 
                            	  1025:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000766 323900081022    	  1026:     MOVE.W  BUFFER_COUNT,D1
00:0000076C B27C0008        	  1027:     CMP.W   #8,D1
00:00000770 6D38            	  1028:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1029: 
00:00000772 41F900081024    	  1030:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000778 24390008101E    	  1031:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000077E 7000            	  1032:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000780 7607            	  1033:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1034: 
                            	  1035: .ReadLoop:
00:00000782 18302800        	  1036:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000786 0204000F        	  1037:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1038: 
                            	  1039:     ; Desloca e insere os 4 bits em D0
00:0000078A E988            	  1040:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000078C 8004            	  1041:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1042: 
                            	  1043:     ; Atualiza tail (circular)
00:0000078E 5282            	  1044:     ADDQ.L  #1,D2
00:00000790 0282000000FF    	  1045:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1046: 
00:00000796 51CBFFEA        	  1047:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1048: 
                            	  1049:     ; Atualiza ponteiros globais
00:0000079A 23C20008101E    	  1050:     MOVE.L  D2,BUFFER_TAIL
00:000007A0 517900081022    	  1051:     SUB.W   #8,BUFFER_COUNT
                            	  1052: 
00:000007A6 7200            	  1053:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000007A8 6004            	  1054:     BRA     .Exit
                            	  1055: 
                            	  1056: .BufferUnderrun:
00:000007AA 72FF            	  1057:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000007AC 7000            	  1058:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1059: 
                            	  1060: .Exit:
00:000007AE 4CDF013C        	  1061:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000007B2 4E75            	  1062:     RTS
                            	  1063: 
00:000007B4 4D4552444120494E	  1064:     DC.B "MERDA INCIA"
00:000007BC 434941
                            	  1065:     ALIGN 2
