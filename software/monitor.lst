                            	   938: ;--------------------------------------------------
                            	   939: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   940: ;--------------------------------------------------
                            	   941: ;Exemplo: Lendo byte do buffer
                            	   942: ;         BSR     UART_BufferGet
                            	   943: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   944: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   945: ;         Senão, D0 contém o byte lido!
                            	   946: BufferGet:
00:000006B6 2F01            	   947:     MOVE.L  D1,-(SP)
00:000006B8 2F08            	   948:     MOVE.L  A0,-(SP)
                            	   949: 
00:000006BA 323900081022    	   950:     MOVE.W  BUFFER_COUNT,D1
00:000006C0 6724            	   951:     BEQ     .BufferEmpty
                            	   952: 
00:000006C2 41F900081024    	   953:     LEA     BUFFER,A0
                            	   954: 
                            	   955:     ; Modificado para usar deslocamento de 16 bits
00:000006C8 32390008101E    	   956:     MOVE.W  BUFFER_TAIL,D1
00:000006CE 10301000        	   957:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   958: 
00:000006D2 5401            	   959:     ADDQ.B  #2,D1              ; Incrementa como word
00:000006D4 024100FF        	   960:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000006D8 33C10008101E    	   961:     MOVE.W  D1,BUFFER_TAIL
                            	   962: 
00:000006DE 537900081022    	   963:     SUBQ.W  #1,BUFFER_COUNT
00:000006E4 6006            	   964:     BRA     .Exit
                            	   965: 
                            	   966: .BufferEmpty:
00:000006E6 4EB806F2        	   967:     JSR     FBufferEmpty
00:000006EA 70FF            	   968:     MOVEQ   #-1,D0
                            	   969: .Exit:
00:000006EC 205F            	   970:     MOVE.L  (SP)+,A0
00:000006EE 221F            	   971:     MOVE.L  (SP)+,D1
00:000006F0 4E75            	   972:     RTS
                            	   973: 
                            	   974: FBufferEmpty:
