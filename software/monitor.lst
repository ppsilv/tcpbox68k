                            	   244: DELAY_MS:
01:0000119C 2F01            	   245:         MOVE.L  d1,-(sp)          ; Salva D1
01:0000119E 3200            	   246:         MOVE.W  d0,d1             ; Contador de ms
01:000011A0 670E            	   247:         BEQ.S   .end              ; Se D0=0, sai
                            	   248: .loop_ms:
01:000011A2 203C00003E80    	   249:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   250: .inner_loop:
01:000011A8 5380            	   251:         SUBQ.L  #1,d0             ; 4 ciclos
01:000011AA 66FC            	   252:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
01:000011AC 5341            	   253:         SUBQ.W  #1,d1             ; 1 ms
01:000011AE 66F2            	   254:         BNE.S   .loop_ms
                            	   255: .end:
01:000011B0 221F            	   256:         MOVE.L  (sp)+,d1          ; Restaura D1
01:000011B2 4E75            	   257:         rts
