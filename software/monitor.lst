00:00000746 4E75            	  1008:         RTS
                            	  1009: ;---------------------------------------------------------------------
                            	  1010: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1011: ;---------------------------------------------------------------------
                            	  1012: ClearBufferPointers:
00:00000748 23FC000000000008	  1013:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000750 101A
00:00000752 23FC000000000008	  1014:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:0000075A 101E
00:0000075C 33FC000000081022	  1015:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000764 4E75            	  1016:     RTS
                            	  1017: ;---------------------------------------------------------------------
                            	  1018: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1019: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1020: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1021: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1022: ;---------------------------------------------------------------------
                            	  1023: MontaAddress:
00:00000766 48E73C80        	  1024:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1025: 
                            	  1026:     ; Verifica se há pelo menos 8 bytes no buffer
00:0000076A 323900081022    	  1027:     MOVE.W  BUFFER_COUNT,D1
00:00000770 B27C0008        	  1028:     CMP.W   #8,D1
00:00000774 6D38            	  1029:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1030: 
00:00000776 41F900081024    	  1031:     LEA     BUFFER,A0      ; A0 = base do buffer
00:0000077C 24390008101E    	  1032:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000782 7000            	  1033:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000784 7607            	  1034:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1035: 
                            	  1036: .ReadLoop:
00:00000786 18302800        	  1037:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:0000078A 0204000F        	  1038:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1039: 
                            	  1040:     ; Desloca e insere os 4 bits em D0
00:0000078E E988            	  1041:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000790 8004            	  1042:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1043: 
                            	  1044:     ; Atualiza tail (circular)
00:00000792 5282            	  1045:     ADDQ.L  #1,D2
00:00000794 0282000000FF    	  1046:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1047: 
00:0000079A 51CBFFEA        	  1048:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1049: 
                            	  1050:     ; Atualiza ponteiros globais
00:0000079E 23C20008101E    	  1051:     MOVE.L  D2,BUFFER_TAIL
00:000007A4 517900081022    	  1052:     SUB.W   #8,BUFFER_COUNT
                            	  1053: 
00:000007AA 7200            	  1054:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000007AC 6004            	  1055:     BRA     .Exit
                            	  1056: 
                            	  1057: .BufferUnderrun:
00:000007AE 72FF            	  1058:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000007B0 7000            	  1059:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1060: 
                            	  1061: .Exit:
00:000007B2 4CDF013C        	  1062:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000007B6 4E75            	  1063:     RTS
                            	  1064: 
00:000007B8 4D4552444120494E	  1065:     DC.B "MERDA INCIA"
00:000007C0 434941
                            	  1066:     ALIGN 2
