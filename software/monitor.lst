                            	   838: BufferPut:
00:00000644 2F01            	   839:         MOVE.L  D1,-(SP)
00:00000646 2F08            	   840:         MOVE.L  A0,-(SP)
                            	   841: 
                            	   842:         ;ANDI.W    #$FF00,D0
00:00000648 41F90008102C    	   843:         LEA     BUFFER,A0
00:0000064E 32390008102A    	   844:         MOVE.W  BUFFER_COUNT,D1
                            	   845: 
00:00000654 B27C0100        	   846:         CMP.W   #256,D1
00:00000658 6C1C            	   847:         BGE     .BufferFull
                            	   848: 
                            	   849:         ; Modificado para usar deslocamento de 16 bits
00:0000065A 323900081022    	   850:         MOVE.W  BUFFER_HEAD,D1
00:00000660 D0C1            	   851:         ADD     D1,A0
00:00000662 1080            	   852:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   853: 
00:00000664 5441            	   854:         ADD     #2,D1              ; Incrementa como word
00:00000666 024100FF        	   855:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000066A 33C100081022    	   856:         MOVE.W  D1,BUFFER_HEAD
                            	   857: 
00:00000670 52790008102A    	   858:         ADDQ.W  #1,BUFFER_COUNT
                            	   859: 
                            	   860: .BufferFull:
00:00000676 205F            	   861:         MOVE.L  (SP)+,A0
00:00000678 221F            	   862:         MOVE.L  (SP)+,D1
                            	   863: 
00:0000067A 4E75            	   864:         RTS
