                            	   546: ; ----------------------------------------------------------------------
                            	   547: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   548: ; Entrada: D0 = endereço
                            	   549: ; ----------------------------------------------------------------------
                            	   550: PrintHexAddress:
00:00000408 4840            	   551:     SWAP    D0                ; Imprime parte alta primeiro
00:0000040A 4EB80410        	   552:     JSR     PrintWordHex
00:0000040E 4840            	   553:     SWAP    D0                ; Parte baixa
                            	   554:     ; Continua para PrintWordHex
                            	   555: 
                            	   556: ; ----------------------------------------------------------------------
                            	   557: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   558: ; Entrada: D0.w = valor
                            	   559: ; ----------------------------------------------------------------------
                            	   560: PrintWordHex:
00:00000410 E158            	   561:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:00000412 4EB80418        	   562:     JSR     PrintByteHex
00:00000416 E058            	   563:     ROR.W   #8,D0             ; Byte menos significativo
                            	   564:     ; Continua para PrintByteHex
                            	   565: 
                            	   566: ; ----------------------------------------------------------------------
                            	   567: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   568: ; Entrada: D0.b = valor
                            	   569: ; ----------------------------------------------------------------------
                            	   570: PrintByteHex:
00:00000418 1F00            	   571:     MOVE.B  D0,-(SP)          ; Salva byte original
00:0000041A E808            	   572:     LSR.B   #4,D0             ; Nibble alto
00:0000041C 6106            	   573:     BSR     PrintNibble
00:0000041E 101F            	   574:     MOVE.B  (SP)+,D0          ; Recupera byte
00:00000420 0200000F        	   575:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   576:     ; Continua para PrintNibble
                            	   577: ; ----------------------------------------------------------------------
                            	   578: ; PrintNibble - Imprime um nibble em hex
                            	   579: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   580: ; ----------------------------------------------------------------------
                            	   581: PrintNibble:
00:00000424 B03C0009        	   582:     CMP.B   #9,D0
00:00000428 6302            	   583:     BLS     .Decimal
00:0000042A 5E00            	   584:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   585: .Decimal:
00:0000042C D03C0030        	   586:     ADD.B   #'0',D0
00:00000430 4EF8019C        	   587:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   588: 
                            	   589: ClearRAM:
00:00000434 41F900080000    	   590:     LEA     $80000,A0
00:0000043A 43F90008FFFF    	   591:     LEA     $8FFFF,A1
00:00000440 7000            	   592:     MOVEQ   #0,D0
                            	   593: .ClearLoop:
00:00000442 20C0            	   594:     MOVE.L  D0,(A0)+
00:00000444 B3C8            	   595:     CMPA.L  A0,A1
00:00000446 62FA            	   596:     BHI     .ClearLoop
00:00000448 4E75            	   597:     RTS
                            	   598: ; ----------------------------------------------------------------------
                            	   599: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   600: ; ----------------------------------------------------------------------
                            	   601: ClearRAM1:
00:0000044A 41F900080000    	   602:     LEA     $80000,A0        ; Endereço inicial da RAM
00:00000450 43F900100000    	   603:     LEA     $100000,A1       ; Endereço final + 1
00:00000456 7000            	   604:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   605: 
                            	   606:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000458 2209            	   607:     MOVE.L  A1,D1
00:0000045A 9288            	   608:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   609: 
                            	   610:     ; Otimização: escreve longs (32 bits) quando possível
00:0000045C 2401            	   611:     MOVE.L  D1,D2
00:0000045E 028200000003    	   612:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:00000464 670C            	   613:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   614: 
                            	   615:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000466 5382            	   616:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   617: .ResidualLoop:
00:00000468 10C0            	   618:     MOVE.B  D0,(A0)+
00:0000046A 51CAFFFC        	   619:     DBRA    D2,.ResidualLoop
                            	   620: 
                            	   621:     ; Atualiza tamanho restante
00:0000046E 9282            	   622:     SUB.L   D2,D1
00:00000470 5381            	   623:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   624: 
                            	   625: .ClearLongs:
00:00000472 E489            	   626:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:00000474 5381            	   627:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   628: 
                            	   629: .LongLoop:
00:00000476 20C0            	   630:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000478 51C9FFFC        	   631:     DBRA    D1,.LongLoop
00:0000047C 4E75            	   632:     RTS
