                            	   903: ;--------------------------------------------------
                            	   904: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   905: ;--------------------------------------------------
                            	   906: ; Exemplo: insere 'A' no buffer
                            	   907: ;          MOVE.B  #'A',D0
                            	   908: ;          JSR     UART_BufferPut
                            	   909: 
                            	   910: BufferPut:
00:0000067E 2F01            	   911:     MOVE.L  D1,-(SP)
00:00000680 2F08            	   912:     MOVE.L  A0,-(SP)
                            	   913: 
                            	   914:     ;ANDI.W    #$FF00,D0
00:00000682 41F900081024    	   915:     LEA     BUFFER,A0
00:00000688 323900081022    	   916:     MOVE.W  BUFFER_COUNT,D1
                            	   917: 
00:0000068E B27C0100        	   918:     CMP.W   #256,D1
00:00000692 6C1C            	   919:     BGE     .BufferFull
                            	   920: 
                            	   921:     ; Modificado para usar deslocamento de 16 bits
00:00000694 32390008101A    	   922:     MOVE.W  BUFFER_HEAD,D1
00:0000069A D0C1            	   923:     ADD     D1,A0
00:0000069C 1080            	   924:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   925: 
00:0000069E 5441            	   926:     ADD     #2,D1              ; Incrementa como word
00:000006A0 024100FF        	   927:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000006A4 33C10008101A    	   928:     MOVE.W  D1,BUFFER_HEAD
                            	   929: 
00:000006AA 527900081022    	   930:     ADDQ.W  #1,BUFFER_COUNT
                            	   931: 
                            	   932: .BufferFull:
00:000006B0 205F            	   933:     MOVE.L  (SP)+,A0
00:000006B2 221F            	   934:     MOVE.L  (SP)+,D1
                            	   935: 
00:000006B4 4E75            	   936:     RTS
