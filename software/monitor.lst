00:0000017C 303C0101        	   184:     MOVE.W  #$0101,D0    ; Valor inicial
                            	   185: .Loop:
00:00000180 32C0            	   186:     MOVE.W  D0,(A1)+
00:00000182 D07C0101        	   187:     ADD.W   #$0101,D0    ; Incrementa cada byte do long
00:00000186 5341            	   188:     SUBQ.W  #1,D1
00:00000188 66F6            	   189:     BNE     .Loop
                            	   190: 
                            	   191: TESTE_BUFFER2:
00:0000018A 7240D241        	   192:     MOVE.L  #$00000080,D1        ; 32 iterações (128 bytes / 4 bytes por long)
00:0000018E 43F900081124    	   193:     LEA     xmodem_buffer,A1
00:00000194 7001            	   194:     MOVE.L  #$00000001,D0    ; Valor inicial
                            	   195: .Loop:
00:00000196 12C0            	   196:     MOVE.B  D0,(A1)+
00:00000198 5200            	   197:     ADD.B   #$01,D0    ; Incrementa cada byte do long
00:0000019A 5301            	   198:     SUBQ.B  #1,D1
00:0000019C 66F8            	   199:     BNE     .Loop
                            	   200: 
