00:00000554 721C            	   731:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:00000556 7400            	   732:         MOVEQ   #0,D2            ; Resultado em D2
                            	   733: .Loop:
00:00000558 7000            	   734:         CLR.L   D0
00:0000055A 4EB801CA        	   735:         JSR     UART_ReadChar
00:0000055E B03C000D        	   736:         CMP.B   #13,D0
00:00000562 674C            	   737:         BEQ     .Done
00:00000564 B03C000A        	   738:         CMP.B   #10,D0
00:00000568 6746            	   739:         BEQ     .Done
                            	   740:         ;Tratando os numeros
00:0000056A B03C0030        	   741:         CMP.B   #'0',D0
