                            	  1049:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1050:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1051:         ; Exemplo: copiar do buffer para a RAM
                            	  1052:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:000007A0 43F900081124    	  1053:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:000007A6 247900081326    	  1054:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:000007AC 7220            	  1055:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1056: Copy_Data:
00:000007AE 24D9            	  1057:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:000007B0 5381            	  1058:         SUBQ.L  #1,D1               ; Decrementa contador
00:000007B2 66FA            	  1059:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1060:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
00:000007B4 203900081326    	  1061:         MOVE.L  usr_buffer_addr,D0
00:000007BA 068000000080    	  1062:         ADDI.L  #128,D0
00:000007C0 23C000081326    	  1063:         MOVE.L  D0,usr_buffer_addr
                            	  1064: 
