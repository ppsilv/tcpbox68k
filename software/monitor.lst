                            	    49:             SECTION .text
                            	    50:             ORG $00001000
                            	    51: 
                            	    52: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    53: USER_SP     EQU     $0009F000
                            	    54: ;Clock frequency in Hz
                            	    55: F_CPU       equ 16000000
                            	    56: ;Uart register offsets
                            	    57: RHR         equ     0   ; receive holding register (read)
                            	    58: THR         equ     0   ; transmit holding register (write)
                            	    59: IER         equ     2   ; interrupt enable register
                            	    60: ISR         equ     4   ; interrupt status register (read)
                            	    61: FCR         equ     4   ; FIFO control register (write)
                            	    62: LCR         equ     6   ; line control register
                            	    63: MCR         equ     8   ; modem control register
                            	    64: LSR         equ     10  ; line status register
                            	    65: MSR         equ     12  ; modem status register
                            	    66: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	    67: DLL         equ     0   ; divisor latch LSB
                            	    68: DLM         equ     2   ; divisor latch MSB
                            	    69: ; aliases for register names (used by different manufacturers)cd ..
                            	    70: RBR         equ     RHR ; receive buffer register
                            	    71: IIR         equ     ISR ; interrupt identification register
                            	    72: SCR         equ     SPR ; scratch register
                            	    73: 
                            	    74: LED_ADDRESS equ     $4400
                            	    75: UART_BASE   equ     $4000
                            	    76: BAUD_RATE   equ     9600
                            	    77: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    78: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	    79: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	    80: 
                            	    81: ;=== Uart receiver ================= CONSTANTES =================
                            	    82: SOH         EQU     $01        ; Start Of Header
                            	    83: EOT         EQU     $04        ; End Of Transmission
                            	    84: ACK         EQU     $06        ; Acknowledge
                            	    85: NAK         EQU     $15        ; Negative Acknowledge
                            	    86: CAN         EQU     $18        ; Cancel
                            	    87: 
                            	    88: ; --- Macro para Setar Flag ---
                            	    89: SET_FLAG   MACRO
                            	    90:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	    91:     ENDM
                            	    92: ; --- Macro para Setar Flag ---
                            	    93: CLR_FLAG   MACRO
                            	    94:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	    95:     ENDM
                            	    96: ; --- Macro TEST_FLAG corrigida ---
                            	    97: TEST_FLAG  MACRO
                            	    98:     BTST    #\1,minhas_flags
                            	    99:     ENDM
                            	   100: ; --- Macro para testar flag (com salto se setado) ---
                            	   101: TST_FLAG_SET MACRO
                            	   102:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	   103:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	   104:     ENDM
                            	   105: 
                            	   106:         ALIGN 2
