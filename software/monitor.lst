00:00000716 103C0001        	   963:        MOVE.B  #1,D0
00:0000071A 1080            	   964:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:0000071C 41F900081124    	   965:        LEA     xmodem_buffer,A0
                            	   966: 
00:00000722 41F900081934    	   967:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
