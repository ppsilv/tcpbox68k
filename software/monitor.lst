00:000006BA 4E75            	   926:         RTS
                            	   927: ;---------------------------------------------------------------------
                            	   928: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   929: ;---------------------------------------------------------------------
                            	   930: ClearBufferPointers:
00:000006BC 23FC000000000008	   931:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000006C4 101A
00:000006C6 23FC000000000008	   932:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000006CE 101E
00:000006D0 33FC000000081022	   933:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:000006D8 4E75            	   934:     RTS
                            	   935: ;---------------------------------------------------------------------
                            	   936: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   937: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   938: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   939: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   940: ;---------------------------------------------------------------------
                            	   941: MontaAddress:
00:000006DA 48E73C80        	   942:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   943: 
                            	   944:     ; Verifica se há pelo menos 8 bytes no buffer
00:000006DE 323900081022    	   945:     MOVE.W  BUFFER_COUNT,D1
00:000006E4 B27C0008        	   946:     CMP.W   #8,D1
00:000006E8 6D38            	   947:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   948: 
00:000006EA 41F900081024    	   949:     LEA     BUFFER,A0      ; A0 = base do buffer
00:000006F0 24390008101E    	   950:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:000006F6 7000            	   951:     CLR.L   D0                ; Zera D0 (resultado final)
00:000006F8 7607            	   952:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   953: 
                            	   954: .ReadLoop:
00:000006FA 18302800        	   955:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:000006FE 0204000F        	   956:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   957: 
                            	   958:     ; Desloca e insere os 4 bits em D0
00:00000702 E988            	   959:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000704 8004            	   960:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   961: 
                            	   962:     ; Atualiza tail (circular)
00:00000706 5282            	   963:     ADDQ.L  #1,D2
00:00000708 0282000000FF    	   964:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   965: 
00:0000070E 51CBFFEA        	   966:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   967: 
                            	   968:     ; Atualiza ponteiros globais
00:00000712 23C20008101E    	   969:     MOVE.L  D2,BUFFER_TAIL
00:00000718 517900081022    	   970:     SUB.W   #8,BUFFER_COUNT
                            	   971: 
00:0000071E 7200            	   972:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000720 6004            	   973:     BRA     .Exit
                            	   974: 
                            	   975: .BufferUnderrun:
00:00000722 72FF            	   976:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:00000724 7000            	   977:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   978: 
                            	   979: .Exit:
00:00000726 4CDF013C        	   980:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:0000072A 4E75            	   981:     RTS
                            	   982: 
00:0000072C 4D4552444120494E	   983:     DC.B "MERDA INCIA"
00:00000734 434941
