                            	   127: ; =============================================
                            	   128: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   129: ; Entrada: D0 = tempo em ms (16 bits)
                            	   130: ; Destrói: D0
                            	   131: ; =============================================
                            	   132: DELAY_MS:
00:00000102 2F01            	   133:         MOVE.L  d1,-(sp)          ; Salva D1
00:00000104 3200            	   134:         MOVE.W  d0,d1             ; Contador de ms
00:00000106 670E            	   135:         BEQ.S   .end              ; Se D0=0, sai
                            	   136: .loop_ms:
00:00000108 203C00003E80    	   137:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   138: .inner_loop:
00:0000010E 5380            	   139:         SUBQ.L  #1,d0             ; 4 ciclos
00:00000110 66FC            	   140:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
00:00000112 5341            	   141:         SUBQ.W  #1,d1             ; 1 ms
00:00000114 66F2            	   142:         BNE.S   .loop_ms
                            	   143: .end:
00:00000116 221F            	   144:         MOVE.L  (sp)+,d1          ; Restaura D1
00:00000118 4E75            	   145:         rts
