00:0000016A D07C0101        	   178:     ADD.W   #$0101,D0
00:0000016E 30C0            	   179:     MOVE.W  D0,(A0)+
00:00000170 B3C8            	   180:     CMPA.L  A0,A1
00:00000172 62F6            	   181:     BHI     .ClearLoop
00:00000174 6000FEF6        	   182:     BRA     MenuLoop
                            	   183: 
