00:000001C4 7000            	   216:     MOVEQ   #0,D0
                            	   217: .ClearLoop:
00:000001C6 5200            	   218:     ADDI.B   #$01,D0
00:000001C8 10C0            	   219:     MOVE.B  D0,(A0)+
00:000001CA B3C8            	   220:     CMPA.L  A0,A1
