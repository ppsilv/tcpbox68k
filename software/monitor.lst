                            	   867: ClearBufferPointers:
00:0000065A 23FC000000000008	   868:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000662 101A
00:00000664 23FC000000000008	   869:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:0000066C 101E
