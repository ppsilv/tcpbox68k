                            	   658: ; ----------------------------------------------------------------------
                            	   659: ; Rotinas Auxiliares
                            	   660: ; ----------------------------------------------------------------------
                            	   661: 
                            	   662: ; Lê número hexadecimal (retorna em D0)
                            	   663: UART_ReadHex1:
00:00000490 2F01            	   664:         MOVE.L  D1,-(SP)
00:00000492 2F02            	   665:         MOVE.L  D2,-(SP)
                            	   666: 
00:00000494 41F90000030D    	   667:         LEA     WritePrompt,A0
00:0000049A 4EB8016E        	   668:         JSR     UART_WriteString
                            	   669: 
00:0000049E 4EB8020E        	   670:         JSR     new_line
                            	   671: 
00:000004A2 7000            	   672:         MOVEQ   #0,D0
00:000004A4 7200            	   673:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000004A6 7400            	   674:         MOVEQ   #0,D2            ; Resultado em D2
                            	   675: 
                            	   676: .Loop:
00:000004A8 4EB80154        	   677:         JSR     UART_ReadChar
00:000004AC B03C000D        	   678:         CMP.B   #13,D0
00:000004B0 670C            	   679:         BEQ     .Done
00:000004B2 B03C000A        	   680:         CMP.B   #10,D0
00:000004B6 6706            	   681:         BEQ     .Done
00:000004B8 4EB805A6        	   682:         JSR     BufferPut
00:000004BC 60EA            	   683:         BRA     .Loop
                            	   684: .Done:
                            	   685: ;         BSR     UART_BufferGet
                            	   686: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   687: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   688: ;         Senão, D0 contém o byte lido!
                            	   689: .loop1:
00:000004BE 4EB805DE        	   690:     JSR     BufferGet
00:000004C2 B03C00FF        	   691:     CMP.B   #-1,D0          ; Buffer vazio?
00:000004C6 6706            	   692:     BEQ     .fim      ; Se sim, ignora
00:000004C8 4EB8013A        	   693:     JSR     UART_WriteChar
00:000004CC 60F0            	   694:     BRA     .loop1
                            	   695: .fim:
00:000004CE 241F            	   696:     MOVE.L  (SP)+,D2
00:000004D0 221F            	   697:     MOVE.L  (SP)+,D1
00:000004D2 4EB8020E        	   698:     JSR     new_line
00:000004D6 6000FB9A        	   699:     bra     MenuLoop ;provisoriamente
00:000004DA 4E75            	   700:     RTS
                            	   701: 
                            	   702: ; Lê número hexadecimal (retorna em D0)
                            	   703: UART_ReadHex:
00:000004DC 2F01            	   704:         MOVE.L  D1,-(SP)
00:000004DE 2F02            	   705:         MOVE.L  D2,-(SP)
                            	   706: 
00:000004E0 7000            	   707:         MOVEQ   #0,D0
00:000004E2 721C            	   708:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:000004E4 7400            	   709:         MOVEQ   #0,D2            ; Resultado em D2
                            	   710: .Loop:
00:000004E6 7000            	   711:         CLR.L   D0
00:000004E8 4EB80154        	   712:         JSR     UART_ReadChar
00:000004EC B03C000D        	   713:         CMP.B   #13,D0
00:000004F0 674C            	   714:         BEQ     .Done
00:000004F2 B03C000A        	   715:         CMP.B   #10,D0
00:000004F6 6746            	   716:         BEQ     .Done
                            	   717:         ;Tratando os numeros
00:000004F8 B03C0030        	   718:         CMP.B   #'0',D0
00:000004FC 6C02            	   719:         BGE     .maiorQueZero
00:000004FE 60E6            	   720:         BRA     .Loop
                            	   721: .maiorQueZero:
00:00000500 B03C0039        	   722:         CMP.B   #'9',D0
00:00000504 6F10            	   723:         BLE     .isdigit
                            	   724:         ;Tratando as letras
00:00000506 B03C0041        	   725:         CMP.B   #'A',D0
00:0000050A 6C02            	   726:         BGE     .maiorQueA
00:0000050C 60D8            	   727:         BRA     .Loop
                            	   728: .maiorQueA:
00:0000050E B03C0046        	   729:         CMP.B   #'F',D0
00:00000512 6F16            	   730:         BLE     .isletter
00:00000514 60D0            	   731:         BRA     .Loop
                            	   732: .isdigit:
00:00000516 903C0030        	   733:         SUB.B   #'0',D0
00:0000051A E3A8            	   734:         LSL.L   D1,D0
00:0000051C 5901            	   735:         SUB.B   #4,D1
00:0000051E 8480            	   736:         OR.L    D0,D2
00:00000520 41F900081016    	   737:         LEA     addressInHex,A0
00:00000526 2082            	   738:         MOVE.L  D2,(A0)
00:00000528 60BC            	   739:         BRA     .Loop
                            	   740: .isletter:
00:0000052A 903C0037        	   741:         SUB.B   #$37,D0
00:0000052E E3A8            	   742:         LSL.L   D1,D0
00:00000530 5901            	   743:         SUB.B   #4,D1
00:00000532 8480            	   744:         OR.L    D0,D2
00:00000534 41F900081016    	   745:         LEA     addressInHex,A0
00:0000053A 2082            	   746:         MOVE.L  D2,(A0)
00:0000053C 60A8            	   747:         BRA     .Loop
                            	   748: .Done:
00:0000053E 4EB8020E        	   749:     JSR     new_line
00:00000542 41F900081016    	   750:     LEA     addressInHex,A0
00:00000548 2010            	   751:     MOVE.L  (A0),D0
00:0000054A 4EB803A6        	   752:     JSR     PrintHexAddress
00:0000054E 4EB8020E        	   753:     JSR     new_line
