                            	   413: new_line:
00:0000031C 2F00            	   414:         MOVE.L  D0,-(SP)          ; Salva D0
00:0000031E 103C000A        	   415:         MOVE.B  #10,D0
00:00000322 4EB8022C        	   416:         JSR     UART_WriteChar
00:00000326 103C000D        	   417:         MOVE.B  #13,D0
00:0000032A 4EB8022C        	   418:         JSR     UART_WriteChar
00:0000032E 201F            	   419:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000330 4E75            	   420:         RTS
                            	   421: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   422: ; Retorna D0 = Quociente, D1 = Resto
                            	   423: Div32x16:
00:00000332 7400            	   424:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000334 761F            	   425:     MOVEQ   #31,D3      ; 32 iterações
                            	   426: DivLoop:
00:00000336 E388            	   427:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:00000338 E392            	   428:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000033A B441            	   429:     CMP.W   D1,D2       ; D2 >= D1?
00:0000033C 6D04            	   430:     BLT     .skip
00:0000033E 9441            	   431:     SUB.W   D1,D2       ; Sim, subtrai
00:00000340 5280            	   432:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   433: .skip:
00:00000342 51CBFFF2        	   434:     DBRA    D3,DivLoop  ; Repete
00:00000346 2202            	   435:     MOVE.L  D2,D1       ; Resto em D1
00:00000348 4E75            	   436:     RTS
                            	   437: ; Versão compacta sem stack frame
                            	   438: PrintHexFast:
00:0000034A 2F02            	   439:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000034C 2F00            	   440:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:0000034E 7407            	   441:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   442: 
                            	   443: .Loop:
00:00000350 2017            	   444:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000352 E998            	   445:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000354 2E80            	   446:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000356 0200000F        	   447:     ANDI.B  #$F,D0            ; Isola nibble
                            	   448: 
00:0000035A B03C0009        	   449:     CMP.B   #9,D0
00:0000035E 6302            	   450:     BLS     .Digit
00:00000360 5E00            	   451:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   452: .Digit:
00:00000362 D03C0030        	   453:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000366 4EB8022C        	   454:     JSR     UART_WriteChar    ; Envia caractere
                            	   455: 
00:0000036A 51CAFFE4        	   456:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   457: 
00:0000036E 588F            	   458:     ADDQ.L  #4,SP             ; Remove valor salvo
00:00000370 241F            	   459:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000372 4E75            	   460:     RTS
                            	   461: 
                            	   462: ; ----------------------------------------------------------------------
                            	   463: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   464: ; Entrada:
                            	   465: ;   D0.L = Valor a ser impresso (32 bits)
                            	   466: ;   D1.W = Número de dígitos (1-8)
                            	   467: ; ----------------------------------------------------------------------
                            	   468: PrintHexPRECISA_DE_REVISAO:
00:00000374 4E56FFF8        	   469:     LINK    A6,#-8            ; Reserva espaço na pilha
00:00000378 2F02            	   470:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000037A 2D40FFFC        	   471:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:0000037E 3D41FFFA        	   472:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   473: 
00:00000382 323C0008        	   474:     MOVE.W  #$0008,D1
                            	   475: 
                            	   476:     ; Ajusta para começar pelo dígito mais significativo
00:00000386 E549            	   477:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:00000388 5941            	   478:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   479: 
                            	   480: .PrintLoop:
00:0000038A 202EFFFC        	   481:     MOVE.L  -4(A6),D0         ; Recupera valor
00:0000038E 3401            	   482:     MOVE.W  D1,D2             ; Posição do nibble
00:00000390 E5B8            	   483:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000392 02800000000F    	   484:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   485: 
                            	   486:     ; Converte para ASCII
00:00000398 B03C0009        	   487:     CMP.B   #9,D0
00:0000039C 6302            	   488:     BLS     .Decimal
00:0000039E 5E00            	   489:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   490: .Decimal:
00:000003A0 D03C0030        	   491:     ADD.B   #'0',D0           ; Converte para caractere
                            	   492: 
                            	   493:     ; Imprime caractere
00:000003A4 4EB8022C        	   494:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   495: 
00:000003A8 5941            	   496:     SUBQ.W  #4,D1             ; Próximo nibble
00:000003AA 6ADE            	   497:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   498: 
                            	   499:     ; Espaço final para separação
00:000003AC 103C0020        	   500:     MOVE.B  #' ',D0
00:000003B0 4EB8022C        	   501:     JSR     UART_WriteChar
                            	   502: 
00:000003B4 241F            	   503:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000003B6 4E5E            	   504:     UNLK    A6                ; Restaura frame
00:000003B8 4E75            	   505:     RTS
                            	   506: ; ----------------------------------------------------------------------
                            	   507: ; Exemplo de uso:
                            	   508: ; ----------------------------------------------------------------------
                            	   509: SetupDivisor:
00:000003BA 303C2580        	   510:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000003BE 6100FED0        	   511:     BSR     CalcBaudDiv
                            	   512: 
                            	   513:     ; Agora pode acessar os valores na RAM:
00:000003C2 41F90008100E    	   514:     LEA     BaudDivL,A0
00:000003C8 1010            	   515:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000003CA 41F900081010    	   516:     LEA     BaudDivH,A0
00:000003D0 1210            	   517:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   518: 
                            	   519:     ; (Aqui você configuraria os registradores da UART)
00:000003D2 4E75            	   520:     RTS
                            	   521: ; ----------------------------------------------------------------------
                            	   522: ; MemDump - Imprime dump de memória formatado
                            	   523: ; Entrada:
                            	   524: ;   A0 = Endereço inicial (ex: $80000)
                            	   525: ;   D0 = Quantidade de bytes (ex: 256)
                            	   526: ; ----------------------------------------------------------------------
                            	   527: MemDump:
00:000003D4 41F90000000D    	   528:     LEA     DumpHeader,A0
00:000003DA 4EB8027C        	   529:     JSR     UART_WriteString
00:000003DE 207900081016    	   530:     MOVE.L  (addressInHex),A0
00:000003E4 2008            	   531:     MOVE.L  A0,D0
00:000003E6 4EB804B4        	   532:     JSR     PrintHexAddress
00:000003EA 4EB8031C        	   533:     JSR     new_line
                            	   534: 
00:000003EE 41F900000020    	   535:     LEA     DumpHeader1,A0
00:000003F4 4EB8027C        	   536:     JSR     UART_WriteString
                            	   537: 
00:000003F8 207900081016    	   538:     MOVE.L  (addressInHex),A0
