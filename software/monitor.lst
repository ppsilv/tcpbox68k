                            	   220: ; ----------------------------------------------------------------------
                            	   221: ; Rotinas de E/S da UART
                            	   222: ; ----------------------------------------------------------------------
                            	   223: 
                            	   224: UART_Init:
00:000001C2 227900081008    	   225:     move.l   CurrentUART,a1
00:000001C8 137C000D0004    	   226:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:000001CE 137C00830006    	   227:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:000001D4 12BC0068        	   228:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:000001D8 137C00000002    	   229:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:000001DE 08A900070006    	   230:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:000001E4 4229000E        	   231:     clr.b   SCR(a1)                 ; clear the scratch register
00:000001E8 4E75            	   232:     RTS
                            	   233: 
                            	   234:     ; Escreve caractere (D0.B)
                            	   235: UART_WriteChar:
00:000001EA 2F08            	   236:     MOVE.L  A0,-(SP)        ; Preserva A0
00:000001EC 2F00            	   237:     MOVE.L  D0,-(SP)        ; Preserva D0
00:000001EE 207900081008    	   238:     move.l   CurrentUART,A0
                            	   239: .WaitTx:
00:000001F4 08280005000A    	   240:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:000001FA 67F8            	   241:     BEQ     .WaitTx
00:000001FC 1080            	   242:     MOVE.B  D0,THR(A0)      ; transmit byte
00:000001FE 201F            	   243:     MOVE.L  (SP)+,D0        ;Restaura D0
00:00000200 205F            	   244:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000202 4E75            	   245:     RTS
                            	   246: 
                            	   247: 
                            	   248: ; Lê caractere (retorna em D0)
                            	   249: UART_ReadChar:
00:00000204 2F08            	   250:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000206 207900081008    	   251:     MOVE.L   CurrentUART,A0
                            	   252: .WaitRx:
00:0000020C 08280000000A    	   253:     BTST    #0,LSR(A0)        ; RX ready?
00:00000212 67F8            	   254:     BEQ     .WaitRx
00:00000214 1010            	   255:     MOVE.B  RHR(A0),D0
00:00000216 205F            	   256:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000218 B03C001B        	   257:     CMP.B   #$1b,D0
00:0000021C 6704            	   258:     BEQ     .fim
00:0000021E 4EB801EA        	   259:     JSR     UART_WriteChar
                            	   260: .fim
00:00000222 4E75            	   261:     RTS
                            	   262: 
                            	   263: ; Lê caractere (retorna em D0)
                            	   264: UART_ReadCharNonEcho:
00:00000224 2F08            	   265:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000226 207900081008    	   266:     MOVE.L  CurrentUART,A0
                            	   267: .WaitRx:
00:0000022C 08280000000A    	   268:     BTST    #0,LSR(A0)        ; RX ready?
00:00000232 67F8            	   269:     BEQ     .WaitRx
                            	   270: 
00:00000234 1010            	   271:     MOVE.B  RHR(A0),D0
00:00000236 205F            	   272:     MOVE.L  (SP)+,A0        ;Restaura A0
                            	   273: 
00:00000238 4E75            	   274:     RTS
                            	   275: 
                            	   276: ; ----------------------------------------------------------------------
                            	   277: ; UART_WriteString - Envia string terminada em null para UART
                            	   278: ; Entrada:
                            	   279: ;   A0 = Ponteiro para a string (endereço da string)
                            	   280: ; ----------------------------------------------------------------------
                            	   281: UART_WriteString:
00:0000023A 2F08            	   282:     MOVE.L  A0,-(SP)      ; Preserva D0
00:0000023C 2F00            	   283:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   284: .WriteLoop:
00:0000023E 1018            	   285:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000240 6706            	   286:     BEQ     .Done
00:00000242 4EB801EA        	   287:     JSR     UART_WriteChar ; Use sua rotine existente
00:00000246 60F6            	   288:     BRA     .WriteLoop
                            	   289: .Done:
00:00000248 201F            	   290:     MOVE.L  (SP)+,D0
00:0000024A 205F            	   291:     MOVE.L  (SP)+,A0
00:0000024C 4E75            	   292:     RTS
