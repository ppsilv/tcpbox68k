                            	   908: ;---------------------------------------------------------------------
                            	   909: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   910: ;---------------------------------------------------------------------
                            	   911: ClearBufferPointers:
00:000006CC 23FC000000000008	   912:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000006D4 1022
00:000006D6 23FC000000000008	   913:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000006DE 1026
00:000006E0 33FC00000008102A	   914:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:000006E8 4E75            	   915:         RTS
                            	   916: ;---------------------------------------------------------------------
                            	   917: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   918: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   919: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   920: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   921: ;---------------------------------------------------------------------
                            	   922: MontaAddress:
00:000006EA 48E73C80        	   923:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   924: 
                            	   925:         ; Verifica se há pelo menos 8 bytes no buffer
00:000006EE 32390008102A    	   926:         MOVE.W  BUFFER_COUNT,D1
00:000006F4 B27C0008        	   927:         CMP.W   #8,D1
00:000006F8 6D38            	   928:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   929: 
00:000006FA 41F90008102C    	   930:         LEA     BUFFER,A0      ; A0 = base do buffer
00:00000700 243900081026    	   931:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000706 7000            	   932:         CLR.L   D0                ; Zera D0 (resultado final)
00:00000708 7607            	   933:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   934: 
                            	   935: .ReadLoop:
00:0000070A 18302800        	   936:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:0000070E 0204000F        	   937:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   938: 
                            	   939:         ; Desloca e insere os 4 bits em D0
00:00000712 E988            	   940:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000714 8004            	   941:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   942: 
                            	   943:         ; Atualiza tail (circular)
00:00000716 5282            	   944:         ADDQ.L  #1,D2
00:00000718 0282000000FF    	   945:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   946: 
00:0000071E 51CBFFEA        	   947:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   948: 
                            	   949:         ; Atualiza ponteiros globais
00:00000722 23C200081026    	   950:         MOVE.L  D2,BUFFER_TAIL
00:00000728 51790008102A    	   951:         SUB.W   #8,BUFFER_COUNT
                            	   952: 
00:0000072E 7200            	   953:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000730 6004            	   954:         BRA     .Exit
                            	   955: 
                            	   956: .BufferUnderrun:
00:00000732 72FF            	   957:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:00000734 7000            	   958:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   959: 
                            	   960: .Exit:
00:00000736 4CDF013C        	   961:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:0000073A 4E75            	   962:         RTS
