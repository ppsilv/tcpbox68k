00:000005A0 2F00            	   791:     MOVE.L  D0,-(SP)        ; Preserva D0
00:000005A2 4EB805B4        	   792:     JSR     UART_ReadHexNibble
00:000005A6 E908            	   793:     LSL.B   #4,D0
00:000005A8 1200            	   794:     MOVE.B  D0,D1
00:000005AA 4EB805B4        	   795:     JSR     UART_ReadHexNibble
00:000005AE 8001            	   796:     OR.B    D1,D0
00:000005B0 201F            	   797:     MOVE.L  (SP)+,D0        ; Recupera D0
00:000005B2 4E75            	   798:     RTS
                            	   799: 
                            	   800: ; Lê meio-byte hexadecimal
