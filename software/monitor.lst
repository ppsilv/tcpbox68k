                            	   974: XMODEM_Receive:
00:00000750 48E73FFE        	   975:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	   976:        ; Inicializa variáveis
00:00000754 41F90008132D    	   977:        LEA     expected_block,A0
00:0000075A 103C0001        	   978:        MOVE.B  #1,D0
00:0000075E 1080            	   979:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:00000760 41F90008112C    	   980:        LEA     xmodem_buffer,A0
                            	   981: 
00:00000766 41F900081934    	   982:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:0000076C 103C0000        	   983:        MOVE.B  #0,D0
00:00000770 1080            	   984:        MOVE.B  D0,(A0)              ; Program not loaded
                            	   985: 
                            	   986:        ; ---- 1. INICIALIZAÇÃO ----
00:00000772 103C0015        	   987:        MOVE.B  #NAK,D0
00:00000776 4EB801B0        	   988:        JSR     UART_WriteChar      ; Solicita início
                            	   989: 
                            	   990:        ;SINALIZA NACK SENT
00:0000077A 303C0800        	   991:        MOVE.W  #$0800,D0
00:0000077E 4EB80144        	   992:        JSR     __write_leds
                            	   993: 
                            	   994:        ; ---- 2. LOOP PRINCIPAL ----
                            	   995: Receive_Loop:
00:00000782 4EB801EA        	   996:        JSR     UART_ReadCharNonEcho
                            	   997: 
00:00000786 B03C0004        	   998:        CMP.B   #EOT,D0
00:0000078A 670000B0        	   999:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1000: 
00:0000078E B03C0001        	  1001:        CMP.B   #SOH,D0
00:00000792 66EE            	  1002:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1003: 
                            	  1004:        ;SINALIZA leds
00:00000794 303C0C00        	  1005:        MOVE.W  #$0C00,D0
00:00000798 4EB80144        	  1006:        JSR     __write_leds
                            	  1007: 
                            	  1008:        ; ---- 3. RECEBE HEADER ----
00:0000079C 4EB801EA        	  1009:        JSR     UART_ReadCharNonEcho       ; Block number
00:000007A0 13C00008132C    	  1010:        MOVE.B  D0,block_number
                            	  1011: 
00:000007A6 4EB801EA        	  1012:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1013: 
                            	  1014:        ;SINALIZA leds
00:000007AA 303C0800        	  1015:        MOVE.W  #$0800,D0
00:000007AE 4EB80144        	  1016:        JSR     __write_leds
                            	  1017: 
                            	  1018:        ; ---- 4. RECEBE DADOS ----
00:000007B2 7220            	  1019:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:000007B4 43F90008112C    	  1020:        LEA     xmodem_buffer,A1
                            	  1021: Read_Loop:
                            	  1022:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:000007BA 4EB801EA        	  1023:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:000007BE E188            	  1024:        LSL.L   #8,D0
00:000007C0 4EB801EA        	  1025:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:000007C4 E188            	  1026:        LSL.L   #8,D0
00:000007C6 4EB801EA        	  1027:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:000007CA E188            	  1028:        LSL.L   #8,D0
00:000007CC 4EB801EA        	  1029:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:000007D0 22C0            	  1030:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:000007D2 5381            	  1031:        SUBQ.L  #1,D1
00:000007D4 66E4            	  1032:        BNE     Read_Loop
                            	  1033: 
00:000007D6 303C0600        	  1034:        MOVE.W  #$0600,D0
00:000007DA 4EB80144        	  1035:        JSR     __write_leds
                            	  1036: 
                            	  1037:        ; ---- 5. VERIFICA CHECKSUM ----
00:000007DE 4EB801EA        	  1038:        JSR     UART_ReadCharNonEcho       ; Checksum
00:000007E2 1400            	  1039:        MOVE.B  D0,D2
