                            	   902: ;---------------------------------------------------------------------
                            	   903: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   904: ;---------------------------------------------------------------------
                            	   905: ClearBufferPointers:
00:000006B6 23FC000000000008	   906:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000006BE 1022
00:000006C0 23FC000000000008	   907:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000006C8 1026
00:000006CA 33FC00000008102A	   908:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:000006D2 4E75            	   909:         RTS
                            	   910: ;---------------------------------------------------------------------
                            	   911: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   912: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   913: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   914: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   915: ;---------------------------------------------------------------------
                            	   916: MontaAddress:
00:000006D4 48E73C80        	   917:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   918: 
                            	   919:         ; Verifica se há pelo menos 8 bytes no buffer
00:000006D8 32390008102A    	   920:         MOVE.W  BUFFER_COUNT,D1
00:000006DE B27C0008        	   921:         CMP.W   #8,D1
00:000006E2 6D38            	   922:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   923: 
00:000006E4 41F90008102C    	   924:         LEA     BUFFER,A0      ; A0 = base do buffer
00:000006EA 243900081026    	   925:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:000006F0 7000            	   926:         CLR.L   D0                ; Zera D0 (resultado final)
00:000006F2 7607            	   927:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   928: 
                            	   929: .ReadLoop:
00:000006F4 18302800        	   930:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:000006F8 0204000F        	   931:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   932: 
                            	   933:         ; Desloca e insere os 4 bits em D0
00:000006FC E988            	   934:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:000006FE 8004            	   935:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   936: 
                            	   937:         ; Atualiza tail (circular)
00:00000700 5282            	   938:         ADDQ.L  #1,D2
00:00000702 0282000000FF    	   939:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   940: 
00:00000708 51CBFFEA        	   941:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   942: 
                            	   943:         ; Atualiza ponteiros globais
00:0000070C 23C200081026    	   944:         MOVE.L  D2,BUFFER_TAIL
00:00000712 51790008102A    	   945:         SUB.W   #8,BUFFER_COUNT
                            	   946: 
00:00000718 7200            	   947:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:0000071A 6004            	   948:         BRA     .Exit
                            	   949: 
                            	   950: .BufferUnderrun:
00:0000071C 72FF            	   951:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:0000071E 7000            	   952:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   953: 
                            	   954: .Exit:
00:00000720 4CDF013C        	   955:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:00000724 4E75            	   956:         RTS
