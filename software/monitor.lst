00:000005B2 4EB805C4        	   801:     JSR     UART_ReadHexNibble
00:000005B6 E908            	   802:     LSL.B   #4,D0
00:000005B8 1200            	   803:     MOVE.B  D0,D1
00:000005BA 4EB805C4        	   804:     JSR     UART_ReadHexNibble
00:000005BE 8001            	   805:     OR.B    D1,D0
