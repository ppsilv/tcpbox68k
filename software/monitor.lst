                            	   193: ; ----------------------------------------------------------------------
                            	   194: ; Constantes
                            	   195: ; ----------------------------------------------------------------------
                            	   196: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   197: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   198:                               ; BAUD_DIV_L em $70000
                            	   199:                               ; BAUD_DIV_U em $70001
                            	   200: 
                            	   201: ; ----------------------------------------------------------------------
                            	   202: ; Rotina: Calcula e armazena divisor de baud rate
                            	   203: ; Entrada:
                            	   204: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   205: ; Saída:
                            	   206: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   207: ; Formulas:
                            	   208: ;
                            	   209: ;
                            	   210: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   211: ; ----------------------------------------------------------------------
                            	   212: 
                            	   213: CalcBaudDiv:
                            	   214: ;[ Registrador D0 (32 bits) ]
                            	   215: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   216: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   217:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   218:     ;((F_CPU/16)/10)
                            	   219:     ;F_CPU = 16000000 ou 0xF42400
00:00000162 203C00F42400    	   220:     MOVE.L  #F_CPU,D0
00:00000168 323C0010        	   221:     MOVE.W  #16,D1         ; Divisor
00:0000016C 61000096        	   222:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   223: ;1
00:00000170 2F00            	   224:     move.l  d0,-(SP)
00:00000172 4EB80386        	   225:     jsr     PrintHexAddress
00:00000176 4EB801EE        	   226:     jsr     new_line
00:0000017A 201F            	   227:     move.l  (SP)+,d0
                            	   228: 
00:0000017C 323C000A        	   229:     MOVE.W  #10,D1         ; Divisor
00:00000180 61000082        	   230:     BSR     Div32x16       ; D0 = 0x186A0
                            	   231: ;2
00:00000184 2F00            	   232:     move.l  d0,-(SP)
00:00000186 4EB80386        	   233:     jsr     PrintHexAddress
00:0000018A 4EB801EE        	   234:     jsr     new_line
00:0000018E 201F            	   235:     move.l  (SP)+,d0
                            	   236: 
                            	   237:     ;(BAUD/10)
00:00000190 2F00            	   238:     move.l  d0,-(SP)
                            	   239: ;3
00:00000192 7000            	   240:     CLR.L   D0
00:00000194 30390008101C    	   241:     MOVE.W  CurrentBaudRate,D0
00:0000019A 2F00            	   242:     move.l  d0,-(SP)
00:0000019C 4EB80386        	   243:     jsr     PrintHexAddress
00:000001A0 4EB801EE        	   244:     jsr     new_line
00:000001A4 201F            	   245:     move.l  (SP)+,d0
                            	   246: 
00:000001A6 123C000A        	   247:     MOVE.B  #10,D1
00:000001AA 6158            	   248:     BSR     Div32x16
                            	   249: 
                            	   250: ;4
00:000001AC 2F00            	   251:     move.l  d0,-(SP)
00:000001AE 4EB80386        	   252:     jsr     PrintHexAddress
00:000001B2 4EB801EE        	   253:     jsr     new_line
00:000001B6 221F            	   254:     move.l  (SP)+,D1
00:000001B8 201F            	   255:     move.l  (SP)+,D0
                            	   256: 
                            	   257: 
                            	   258:     ;(F_CPU/BAUD)
00:000001BA 6148            	   259:     BSR     Div32x16
                            	   260: ;5
00:000001BC 2F00            	   261:     move.l  d0,-(SP)
00:000001BE 4EB80386        	   262:     jsr     PrintHexAddress
00:000001C2 4EB801EE        	   263:     jsr     new_line
00:000001C6 201F            	   264:     move.l  (SP)+,d0
                            	   265: 
                            	   266:     ; 4. Separa parte alta/baixa corretamente
00:000001C8 3200            	   267:     MOVE.W  D0,D1
00:000001CA 024000FF        	   268:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000001CE E049            	   269:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000001D0 024100FF        	   270:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   271: 
                            	   272:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000001D4 41F900081022    	   273:     LEA     Baud1DivL,A0
00:000001DA 3080            	   274:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:000001DC 41F900081024    	   275:     LEA     Baud1DivH,A0
00:000001E2 3081            	   276:     MOVE.W  D1,(A0)
                            	   277: 
00:000001E4 6000FE88        	   278:     BRA     MenuLoop
00:000001E8 4E75            	   279:     RTS
                            	   280: .BaudError:
00:000001EA 6000FE1C        	   281:     BRA     _start
                            	   282: 
                            	   283: new_line:
00:000001EE 2F00            	   284:         MOVE.L  D0,-(SP)          ; Salva D0
00:000001F0 103C000A        	   285:         MOVE.B  #10,D0
00:000001F4 4EB8011A        	   286:         JSR     UART_WriteChar
00:000001F8 103C000D        	   287:         MOVE.B  #13,D0
00:000001FC 4EB8011A        	   288:         JSR     UART_WriteChar
00:00000200 201F            	   289:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000202 4E75            	   290:         RTS
                            	   291: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   292: ; Retorna D0 = Quociente, D1 = Resto
                            	   293: Div32x16:
00:00000204 7400            	   294:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000206 761F            	   295:     MOVEQ   #31,D3      ; 32 iterações
                            	   296: DivLoop:
00:00000208 E388            	   297:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000020A E392            	   298:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000020C B441            	   299:     CMP.W   D1,D2       ; D2 >= D1?
00:0000020E 6D04            	   300:     BLT     .skip
00:00000210 9441            	   301:     SUB.W   D1,D2       ; Sim, subtrai
00:00000212 5280            	   302:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   303: .skip:
00:00000214 51CBFFF2        	   304:     DBRA    D3,DivLoop  ; Repete
00:00000218 2202            	   305:     MOVE.L  D2,D1       ; Resto em D1
00:0000021A 4E75            	   306:     RTS
                            	   307: ; Versão compacta sem stack frame
                            	   308: PrintHexFast:
00:0000021C 2F02            	   309:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000021E 2F00            	   310:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000220 7407            	   311:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   312: 
                            	   313: .Loop:
00:00000222 2017            	   314:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000224 E998            	   315:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000226 2E80            	   316:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000228 0200000F        	   317:     ANDI.B  #$F,D0            ; Isola nibble
                            	   318: 
00:0000022C B03C0009        	   319:     CMP.B   #9,D0
00:00000230 6302            	   320:     BLS     .Digit
00:00000232 5E00            	   321:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   322: .Digit:
00:00000234 D03C0030        	   323:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000238 4EB8011A        	   324:     JSR     UART_WriteChar    ; Envia caractere
                            	   325: 
00:0000023C 51CAFFE4        	   326:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   327: 
00:00000240 588F            	   328:     ADDQ.L  #4,SP             ; Remove valor salvo
00:00000242 241F            	   329:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000244 4E75            	   330:     RTS
                            	   331: 
                            	   332: ; ----------------------------------------------------------------------
                            	   333: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   334: ; Entrada:
                            	   335: ;   D0.L = Valor a ser impresso (32 bits)
                            	   336: ;   D1.W = Número de dígitos (1-8)
                            	   337: ; ----------------------------------------------------------------------
                            	   338: PrintHexPRECISA_DE_REVISAO:
00:00000246 4E56FFF8        	   339:     LINK    A6,#-8            ; Reserva espaço na pilha
00:0000024A 2F02            	   340:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000024C 2D40FFFC        	   341:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:00000250 3D41FFFA        	   342:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   343: 
00:00000254 323C0008        	   344:     MOVE.W  #$0008,D1
                            	   345: 
                            	   346:     ; Ajusta para começar pelo dígito mais significativo
00:00000258 E549            	   347:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:0000025A 5941            	   348:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   349: 
                            	   350: .PrintLoop:
00:0000025C 202EFFFC        	   351:     MOVE.L  -4(A6),D0         ; Recupera valor
00:00000260 3401            	   352:     MOVE.W  D1,D2             ; Posição do nibble
00:00000262 E5B8            	   353:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000264 02800000000F    	   354:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   355: 
                            	   356:     ; Converte para ASCII
00:0000026A B03C0009        	   357:     CMP.B   #9,D0
00:0000026E 6302            	   358:     BLS     .Decimal
00:00000270 5E00            	   359:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   360: .Decimal:
00:00000272 D03C0030        	   361:     ADD.B   #'0',D0           ; Converte para caractere
                            	   362: 
                            	   363:     ; Imprime caractere
00:00000276 4EB8011A        	   364:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   365: 
00:0000027A 5941            	   366:     SUBQ.W  #4,D1             ; Próximo nibble
00:0000027C 6ADE            	   367:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   368: 
                            	   369:     ; Espaço final para separação
00:0000027E 103C0020        	   370:     MOVE.B  #' ',D0
00:00000282 4EB8011A        	   371:     JSR     UART_WriteChar
                            	   372: 
00:00000286 241F            	   373:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000288 4E5E            	   374:     UNLK    A6                ; Restaura frame
00:0000028A 4E75            	   375:     RTS
                            	   376: ; ----------------------------------------------------------------------
                            	   377: ; Exemplo de uso:
                            	   378: ; ----------------------------------------------------------------------
                            	   379: SetupDivisor:
00:0000028C 303C2580        	   380:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:00000290 6100FED0        	   381:     BSR     CalcBaudDiv
                            	   382: 
                            	   383:     ; Agora pode acessar os valores na RAM:
00:00000294 41F90008101E    	   384:     LEA     BaudDivL,A0
00:0000029A 1010            	   385:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:0000029C 41F900081020    	   386:     LEA     BaudDivH,A0
00:000002A2 1210            	   387:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   388: 
                            	   389:     ; (Aqui você configuraria os registradores da UART)
00:000002A4 4E75            	   390:     RTS
                            	   391: ; ----------------------------------------------------------------------
                            	   392: ; MemDump - Imprime dump de memória formatado
                            	   393: ; Entrada:
                            	   394: ;   A0 = Endereço inicial (ex: $80000)
                            	   395: ;   D0 = Quantidade de bytes (ex: 256)
                            	   396: ; ----------------------------------------------------------------------
                            	   397: MemDump:
00:000002A6 41F900000036    	   398:     LEA     DumpHeader,A0
00:000002AC 4EB8014E        	   399:     JSR     UART_WriteString
00:000002B0 207900081026    	   400:     MOVE.L  (addressInHex),A0
00:000002B6 2008            	   401:     MOVE.L  A0,D0
00:000002B8 4EB80386        	   402:     JSR     PrintHexAddress
00:000002BC 4EB801EE        	   403:     JSR     new_line
                            	   404: 
00:000002C0 41F900000049    	   405:     LEA     DumpHeader1,A0
00:000002C6 4EB8014E        	   406:     JSR     UART_WriteString
                            	   407: 
00:000002CA 207900081026    	   408:     MOVE.L  (addressInHex),A0
                            	   409:     ; Calcula endereço final
                            	   410: 
                            	   411: DUMPLOOPMASTER:
00:000002D0 7200            	   412:     CLR.L   D1
00:000002D2 2208            	   413:     MOVE.L  A0,D1
00:000002D4 0681000000FF    	   414:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   415:     ;MOVE.L  D1,D0
                            	   416:     ;JSR     PrintHexAddress
                            	   417:     ;JSR     new_line
                            	   418: 
                            	   419:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   420:     ;JSR     UART_ReadChar
                            	   421: 
                            	   422: 
                            	   423: DumpLoop:
                            	   424:     ; Nova linha a cada 16 bytes
00:000002DA 2008            	   425:     MOVE.L  A0,D0
00:000002DC 02800000000F    	   426:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:000002E2 6616            	   427:     BNE     NoNewLine
                            	   428: 
                            	   429:     ; Imprime endereço
00:000002E4 2008            	   430:     MOVE.L  A0,D0
00:000002E6 4EB80386        	   431:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   432: 
00:000002EA 103C003A        	   433:     MOVE.B  #':',D0
00:000002EE 4EB8011A        	   434:     JSR     UART_WriteChar
00:000002F2 103C0020        	   435:     MOVE.B  #' ',D0
00:000002F6 4EB8011A        	   436:     JSR     UART_WriteChar
                            	   437: 
                            	   438: NoNewLine:
                            	   439:     ; Imprime byte em hex
00:000002FA 1018            	   440:     MOVE.B  (A0)+,D0
00:000002FC 4EB80396        	   441:     JSR     PrintByteHex
                            	   442: 
00:00000300 103C0020        	   443:     MOVE.B  #' ',D0
00:00000304 4EB8011A        	   444:     JSR     UART_WriteChar
                            	   445: 
                            	   446:     ; Verifica fim da linha (16 bytes)
00:00000308 2008            	   447:     MOVE.L  A0,D0
00:0000030A 02800000000F    	   448:     ANDI.L  #$0000000F,D0
00:00000310 664E            	   449:     BNE     NoEndLine
                            	   450: 
                            	   451:     ; Imprime caracteres ASCII
00:00000312 103C0020        	   452:     MOVE.B  #' ',D0
00:00000316 4EB8011A        	   453:     JSR     UART_WriteChar
00:0000031A 103C007C        	   454:     MOVE.B  #'|',D0
00:0000031E 4EB8011A        	   455:     JSR     UART_WriteChar
                            	   456: 
00:00000322 43E8FFF0        	   457:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000326 740F            	   458:     MOVEQ   #15,D2            ; 16 caracteres
                            	   459: 
                            	   460: AsciiLoop:
00:00000328 1019            	   461:     MOVE.B  (A1)+,D0
00:0000032A B03C0020        	   462:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000032E 6D0C            	   463:     BLT     NonPrintable
00:00000330 B03C007E        	   464:     CMP.B   #126,D0
00:00000334 6E06            	   465:     BGT     NonPrintable
                            	   466: 
00:00000336 4EB8011A        	   467:     JSR     UART_WriteChar
00:0000033A 6008            	   468:     BRA     NextAscii
                            	   469: 
                            	   470: NonPrintable:
00:0000033C 103C002E        	   471:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:00000340 4EB8011A        	   472:     JSR     UART_WriteChar
                            	   473: 
                            	   474: NextAscii:
00:00000344 51CAFFE2        	   475:     DBRA    D2,AsciiLoop
                            	   476: 
00:00000348 103C007C        	   477:     MOVE.B  #'|',D0
00:0000034C 4EB8011A        	   478:     JSR     UART_WriteChar
00:00000350 103C000D        	   479:     MOVE.B  #13,D0            ; CR
00:00000354 4EB8011A        	   480:     JSR     UART_WriteChar
00:00000358 103C000A        	   481:     MOVE.B  #10,D0            ; LF
00:0000035C 4EB8011A        	   482:     JSR     UART_WriteChar
                            	   483: 
                            	   484: NoEndLine:
                            	   485:     ; Verifica fim do dump
00:00000360 B1C1            	   486:     CMP.L   D1,A0
00:00000362 6300FF76        	   487:     BLS     DumpLoop
                            	   488: 
00:00000366 2F08            	   489:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000368 41F900000380    	   490:     LEA     HitAnyKey,A0
00:0000036E 4EB8014E        	   491:     JSR     UART_WriteString
00:00000372 4EB80134        	   492:     JSR     UART_ReadChar
00:00000376 B03C001B        	   493:     CMP.B   #$1B,D0
00:0000037A 6706            	   494:     BEQ     .fim
                            	   495: 
00:0000037C 205F            	   496:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:0000037E 6000FF50        	   497:     BRA     DUMPLOOPMASTER
                            	   498: .fim
00:00000382 6000FCEA        	   499:     BRA     MenuLoop
                            	   500: 
                            	   501: ; ----------------------------------------------------------------------
                            	   502: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   503: ; Entrada: D0 = endereço
                            	   504: ; ----------------------------------------------------------------------
                            	   505: PrintHexAddress:
00:00000386 4840            	   506:     SWAP    D0                ; Imprime parte alta primeiro
00:00000388 4EB8038E        	   507:     JSR     PrintWordHex
00:0000038C 4840            	   508:     SWAP    D0                ; Parte baixa
                            	   509:     ; Continua para PrintWordHex
                            	   510: 
                            	   511: ; ----------------------------------------------------------------------
                            	   512: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   513: ; Entrada: D0.w = valor
                            	   514: ; ----------------------------------------------------------------------
                            	   515: PrintWordHex:
00:0000038E E158            	   516:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:00000390 4EB80396        	   517:     JSR     PrintByteHex
00:00000394 E058            	   518:     ROR.W   #8,D0             ; Byte menos significativo
                            	   519:     ; Continua para PrintByteHex
                            	   520: 
                            	   521: ; ----------------------------------------------------------------------
                            	   522: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   523: ; Entrada: D0.b = valor
                            	   524: ; ----------------------------------------------------------------------
                            	   525: PrintByteHex:
00:00000396 1F00            	   526:     MOVE.B  D0,-(SP)          ; Salva byte original
00:00000398 E808            	   527:     LSR.B   #4,D0             ; Nibble alto
00:0000039A 6106            	   528:     BSR     PrintNibble
00:0000039C 101F            	   529:     MOVE.B  (SP)+,D0          ; Recupera byte
00:0000039E 0200000F        	   530:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   531:     ; Continua para PrintNibble
                            	   532: ; ----------------------------------------------------------------------
                            	   533: ; PrintNibble - Imprime um nibble em hex
                            	   534: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   535: ; ----------------------------------------------------------------------
                            	   536: PrintNibble:
00:000003A2 B03C0009        	   537:     CMP.B   #9,D0
00:000003A6 6302            	   538:     BLS     .Decimal
00:000003A8 5E00            	   539:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   540: .Decimal:
00:000003AA D03C0030        	   541:     ADD.B   #'0',D0
00:000003AE 4EF8011A        	   542:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   543: 
                            	   544: 
                            	   545: 
                            	   546: ClearRAM:
00:000003B2 41F900080000    	   547:     LEA     $80000,A0
00:000003B8 43F90008FFFF    	   548:     LEA     $8FFFF,A1
00:000003BE 7000            	   549:     MOVEQ   #0,D0
                            	   550: .ClearLoop:
00:000003C0 20C0            	   551:     MOVE.L  D0,(A0)+
00:000003C2 B3C8            	   552:     CMPA.L  A0,A1
00:000003C4 62FA            	   553:     BHI     .ClearLoop
00:000003C6 4E75            	   554:     RTS
                            	   555: ; ----------------------------------------------------------------------
                            	   556: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   557: ; ----------------------------------------------------------------------
                            	   558: ClearRAM1:
00:000003C8 41F900080000    	   559:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000003CE 43F900100000    	   560:     LEA     $100000,A1       ; Endereço final + 1
00:000003D4 7000            	   561:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   562: 
                            	   563:     ; Calcula tamanho em bytes (já alinhado para longs)
00:000003D6 2209            	   564:     MOVE.L  A1,D1
00:000003D8 9288            	   565:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   566: 
                            	   567:     ; Otimização: escreve longs (32 bits) quando possível
00:000003DA 2401            	   568:     MOVE.L  D1,D2
00:000003DC 028200000003    	   569:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:000003E2 670C            	   570:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   571: 
                            	   572:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:000003E4 5382            	   573:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   574: .ResidualLoop:
00:000003E6 10C0            	   575:     MOVE.B  D0,(A0)+
00:000003E8 51CAFFFC        	   576:     DBRA    D2,.ResidualLoop
                            	   577: 
                            	   578:     ; Atualiza tamanho restante
00:000003EC 9282            	   579:     SUB.L   D2,D1
00:000003EE 5381            	   580:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   581: 
                            	   582: .ClearLongs:
00:000003F0 E489            	   583:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:000003F2 5381            	   584:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   585: 
                            	   586: .LongLoop:
00:000003F4 20C0            	   587:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:000003F6 51C9FFFC        	   588:     DBRA    D1,.LongLoop
00:000003FA 4E75            	   589:     RTS
