                            	   156: .Loop:
00:0000013E 32C0            	   157:     MOVE.W  D0,(A1)+
00:00000140 D07C0101        	   158:     ADD.W   #$0101,D0    ; Incrementa cada byte do long
00:00000144 5341            	   159:     SUBQ.W  #1,D1
00:00000146 66F6            	   160:     BNE     .Loop
                            	   161: 
