01:0000152A 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
01:00001532 6704            	     2M     BEQ     .fim                ; Se bit = 0 (Z=1), pula para o rótulo .fim
01:00001534 12C0            	   770:         MOVE.B  D0,(A1)+            ; Armazena
01:00001536 60EE            	   771:         BRA     .WriteLoop
                            	   772: 
                            	   773: .fim:
01:00001538 41F900000346    	   774:         LEA     WriteDoneMsg,A0
01:0000153E 4EB8126C        	   775:         JSR     UART_WriteString
01:00001542 6000FB70        	   776:         BRA     MenuLoop
