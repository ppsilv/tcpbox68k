                            	   294: ; ----------------------------------------------------------------------
                            	   295: ; Constantes
                            	   296: ; ----------------------------------------------------------------------
                            	   297: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   298: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   299:                               ; BAUD_DIV_L em $70000
                            	   300:                               ; BAUD_DIV_U em $70001
                            	   301: 
                            	   302: ; ----------------------------------------------------------------------
                            	   303: ; Rotina: Calcula e armazena divisor de baud rate
                            	   304: ; Entrada:
                            	   305: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   306: ; Saída:
                            	   307: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   308: ; Formulas:
                            	   309: ;
                            	   310: ;
                            	   311: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   312: ; ----------------------------------------------------------------------
                            	   313: 
                            	   314: CalcBaudDiv:
                            	   315: ;[ Registrador D0 (32 bits) ]
                            	   316: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   317: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   318:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   319:     ;((F_CPU/16)/10)
                            	   320:     ;F_CPU = 16000000 ou 0xF42400
00:0000024E 203C00F42400    	   321:     MOVE.L  #F_CPU,D0
00:00000254 323C0010        	   322:     MOVE.W  #16,D1         ; Divisor
00:00000258 61000096        	   323:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   324: ;1
00:0000025C 2F00            	   325:     move.l  d0,-(SP)
00:0000025E 4EB80472        	   326:     jsr     PrintHexAddress
00:00000262 4EB802DA        	   327:     jsr     new_line
00:00000266 201F            	   328:     move.l  (SP)+,d0
                            	   329: 
00:00000268 323C000A        	   330:     MOVE.W  #10,D1         ; Divisor
00:0000026C 61000082        	   331:     BSR     Div32x16       ; D0 = 0x186A0
                            	   332: ;2
00:00000270 2F00            	   333:     move.l  d0,-(SP)
00:00000272 4EB80472        	   334:     jsr     PrintHexAddress
00:00000276 4EB802DA        	   335:     jsr     new_line
00:0000027A 201F            	   336:     move.l  (SP)+,d0
                            	   337: 
                            	   338:     ;(BAUD/10)
00:0000027C 2F00            	   339:     move.l  d0,-(SP)
                            	   340: ;3
00:0000027E 7000            	   341:     CLR.L   D0
00:00000280 30390008100C    	   342:     MOVE.W  CurrentBaudRate,D0
00:00000286 2F00            	   343:     move.l  d0,-(SP)
00:00000288 4EB80472        	   344:     jsr     PrintHexAddress
00:0000028C 4EB802DA        	   345:     jsr     new_line
00:00000290 201F            	   346:     move.l  (SP)+,d0
                            	   347: 
00:00000292 123C000A        	   348:     MOVE.B  #10,D1
00:00000296 6158            	   349:     BSR     Div32x16
                            	   350: 
                            	   351: ;4
00:00000298 2F00            	   352:     move.l  d0,-(SP)
00:0000029A 4EB80472        	   353:     jsr     PrintHexAddress
00:0000029E 4EB802DA        	   354:     jsr     new_line
00:000002A2 221F            	   355:     move.l  (SP)+,D1
00:000002A4 201F            	   356:     move.l  (SP)+,D0
                            	   357: 
                            	   358: 
                            	   359:     ;(F_CPU/BAUD)
00:000002A6 6148            	   360:     BSR     Div32x16
                            	   361: ;5
00:000002A8 2F00            	   362:     move.l  d0,-(SP)
00:000002AA 4EB80472        	   363:     jsr     PrintHexAddress
00:000002AE 4EB802DA        	   364:     jsr     new_line
00:000002B2 201F            	   365:     move.l  (SP)+,d0
                            	   366: 
                            	   367:     ; 4. Separa parte alta/baixa corretamente
00:000002B4 3200            	   368:     MOVE.W  D0,D1
00:000002B6 024000FF        	   369:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000002BA E049            	   370:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000002BC 024100FF        	   371:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   372: 
                            	   373:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000002C0 41F900081012    	   374:     LEA     Baud1DivL,A0
00:000002C6 3080            	   375:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:000002C8 41F900081014    	   376:     LEA     Baud1DivH,A0
00:000002CE 3081            	   377:     MOVE.W  D1,(A0)
                            	   378: 
00:000002D0 6000FD9A        	   379:     BRA     MenuLoop
00:000002D4 4E75            	   380:     RTS
                            	   381: .BaudError:
00:000002D6 6000FD30        	   382:     BRA     _start
                            	   383: 
                            	   384: new_line:
00:000002DA 2F00            	   385:         MOVE.L  D0,-(SP)          ; Salva D0
00:000002DC 103C000A        	   386:         MOVE.B  #10,D0
00:000002E0 4EB801EA        	   387:         JSR     UART_WriteChar
00:000002E4 103C000D        	   388:         MOVE.B  #13,D0
00:000002E8 4EB801EA        	   389:         JSR     UART_WriteChar
00:000002EC 201F            	   390:         MOVE.L  (SP)+,D0          ; Restaura D0
00:000002EE 4E75            	   391:         RTS
                            	   392: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   393: ; Retorna D0 = Quociente, D1 = Resto
                            	   394: Div32x16:
00:000002F0 7400            	   395:     MOVEQ   #0,D2       ; D2 = Quociente
00:000002F2 761F            	   396:     MOVEQ   #31,D3      ; 32 iterações
                            	   397: DivLoop:
00:000002F4 E388            	   398:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:000002F6 E392            	   399:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:000002F8 B441            	   400:     CMP.W   D1,D2       ; D2 >= D1?
00:000002FA 6D04            	   401:     BLT     .skip
00:000002FC 9441            	   402:     SUB.W   D1,D2       ; Sim, subtrai
00:000002FE 5280            	   403:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   404: .skip:
00:00000300 51CBFFF2        	   405:     DBRA    D3,DivLoop  ; Repete
00:00000304 2202            	   406:     MOVE.L  D2,D1       ; Resto em D1
00:00000306 4E75            	   407:     RTS
                            	   408: ; Versão compacta sem stack frame
                            	   409: PrintHexFast:
00:00000308 2F02            	   410:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000030A 2F00            	   411:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:0000030C 7407            	   412:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   413: 
                            	   414: .Loop:
00:0000030E 2017            	   415:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000310 E998            	   416:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000312 2E80            	   417:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000314 0200000F        	   418:     ANDI.B  #$F,D0            ; Isola nibble
                            	   419: 
00:00000318 B03C0009        	   420:     CMP.B   #9,D0
00:0000031C 6302            	   421:     BLS     .Digit
00:0000031E 5E00            	   422:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   423: .Digit:
00:00000320 D03C0030        	   424:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000324 4EB801EA        	   425:     JSR     UART_WriteChar    ; Envia caractere
                            	   426: 
00:00000328 51CAFFE4        	   427:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   428: 
00:0000032C 588F            	   429:     ADDQ.L  #4,SP             ; Remove valor salvo
00:0000032E 241F            	   430:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000330 4E75            	   431:     RTS
                            	   432: 
                            	   433: ; ----------------------------------------------------------------------
                            	   434: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   435: ; Entrada:
                            	   436: ;   D0.L = Valor a ser impresso (32 bits)
                            	   437: ;   D1.W = Número de dígitos (1-8)
                            	   438: ; ----------------------------------------------------------------------
                            	   439: PrintHexPRECISA_DE_REVISAO:
00:00000332 4E56FFF8        	   440:     LINK    A6,#-8            ; Reserva espaço na pilha
00:00000336 2F02            	   441:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000338 2D40FFFC        	   442:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:0000033C 3D41FFFA        	   443:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   444: 
00:00000340 323C0008        	   445:     MOVE.W  #$0008,D1
                            	   446: 
                            	   447:     ; Ajusta para começar pelo dígito mais significativo
00:00000344 E549            	   448:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:00000346 5941            	   449:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   450: 
                            	   451: .PrintLoop:
00:00000348 202EFFFC        	   452:     MOVE.L  -4(A6),D0         ; Recupera valor
00:0000034C 3401            	   453:     MOVE.W  D1,D2             ; Posição do nibble
00:0000034E E5B8            	   454:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000350 02800000000F    	   455:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   456: 
                            	   457:     ; Converte para ASCII
00:00000356 B03C0009        	   458:     CMP.B   #9,D0
00:0000035A 6302            	   459:     BLS     .Decimal
00:0000035C 5E00            	   460:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   461: .Decimal:
00:0000035E D03C0030        	   462:     ADD.B   #'0',D0           ; Converte para caractere
                            	   463: 
                            	   464:     ; Imprime caractere
00:00000362 4EB801EA        	   465:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   466: 
00:00000366 5941            	   467:     SUBQ.W  #4,D1             ; Próximo nibble
00:00000368 6ADE            	   468:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   469: 
                            	   470:     ; Espaço final para separação
00:0000036A 103C0020        	   471:     MOVE.B  #' ',D0
00:0000036E 4EB801EA        	   472:     JSR     UART_WriteChar
                            	   473: 
00:00000372 241F            	   474:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000374 4E5E            	   475:     UNLK    A6                ; Restaura frame
00:00000376 4E75            	   476:     RTS
                            	   477: ; ----------------------------------------------------------------------
                            	   478: ; Exemplo de uso:
                            	   479: ; ----------------------------------------------------------------------
                            	   480: SetupDivisor:
00:00000378 303C2580        	   481:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:0000037C 6100FED0        	   482:     BSR     CalcBaudDiv
                            	   483: 
                            	   484:     ; Agora pode acessar os valores na RAM:
00:00000380 41F90008100E    	   485:     LEA     BaudDivL,A0
00:00000386 1010            	   486:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:00000388 41F900081010    	   487:     LEA     BaudDivH,A0
00:0000038E 1210            	   488:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   489: 
                            	   490:     ; (Aqui você configuraria os registradores da UART)
00:00000390 4E75            	   491:     RTS
                            	   492: ; ----------------------------------------------------------------------
                            	   493: ; MemDump - Imprime dump de memória formatado
                            	   494: ; Entrada:
                            	   495: ;   A0 = Endereço inicial (ex: $80000)
                            	   496: ;   D0 = Quantidade de bytes (ex: 256)
                            	   497: ; ----------------------------------------------------------------------
                            	   498: MemDump:
00:00000392 41F90000000D    	   499:     LEA     DumpHeader,A0
00:00000398 4EB8023A        	   500:     JSR     UART_WriteString
00:0000039C 207900081016    	   501:     MOVE.L  (addressInHex),A0
00:000003A2 2008            	   502:     MOVE.L  A0,D0
00:000003A4 4EB80472        	   503:     JSR     PrintHexAddress
00:000003A8 4EB802DA        	   504:     JSR     new_line
                            	   505: 
00:000003AC 41F900000020    	   506:     LEA     DumpHeader1,A0
00:000003B2 4EB8023A        	   507:     JSR     UART_WriteString
                            	   508: 
00:000003B6 207900081016    	   509:     MOVE.L  (addressInHex),A0
                            	   510:     ; Calcula endereço final
                            	   511: 
                            	   512: DUMPLOOPMASTER:
00:000003BC 7200            	   513:     CLR.L   D1
00:000003BE 2208            	   514:     MOVE.L  A0,D1
00:000003C0 0681000000FF    	   515:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   516:     ;MOVE.L  D1,D0
                            	   517:     ;JSR     PrintHexAddress
                            	   518:     ;JSR     new_line
                            	   519: 
                            	   520:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   521:     ;JSR     UART_ReadChar
                            	   522: 
                            	   523: 
                            	   524: DumpLoop:
                            	   525:     ; Nova linha a cada 16 bytes
00:000003C6 2008            	   526:     MOVE.L  A0,D0
00:000003C8 02800000000F    	   527:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:000003CE 6616            	   528:     BNE     NoNewLine
                            	   529: 
                            	   530:     ; Imprime endereço
00:000003D0 2008            	   531:     MOVE.L  A0,D0
00:000003D2 4EB80472        	   532:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   533: 
00:000003D6 103C003A        	   534:     MOVE.B  #':',D0
00:000003DA 4EB801EA        	   535:     JSR     UART_WriteChar
00:000003DE 103C0020        	   536:     MOVE.B  #' ',D0
00:000003E2 4EB801EA        	   537:     JSR     UART_WriteChar
                            	   538: 
                            	   539: NoNewLine:
                            	   540:     ; Imprime byte em hex
00:000003E6 1018            	   541:     MOVE.B  (A0)+,D0
00:000003E8 4EB80482        	   542:     JSR     PrintByteHex
                            	   543: 
00:000003EC 103C0020        	   544:     MOVE.B  #' ',D0
00:000003F0 4EB801EA        	   545:     JSR     UART_WriteChar
                            	   546: 
                            	   547:     ; Verifica fim da linha (16 bytes)
00:000003F4 2008            	   548:     MOVE.L  A0,D0
00:000003F6 02800000000F    	   549:     ANDI.L  #$0000000F,D0
00:000003FC 664E            	   550:     BNE     NoEndLine
                            	   551: 
                            	   552:     ; Imprime caracteres ASCII
00:000003FE 103C0020        	   553:     MOVE.B  #' ',D0
00:00000402 4EB801EA        	   554:     JSR     UART_WriteChar
00:00000406 103C007C        	   555:     MOVE.B  #'|',D0
00:0000040A 4EB801EA        	   556:     JSR     UART_WriteChar
                            	   557: 
00:0000040E 43E8FFF0        	   558:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000412 740F            	   559:     MOVEQ   #15,D2            ; 16 caracteres
                            	   560: 
                            	   561: AsciiLoop:
00:00000414 1019            	   562:     MOVE.B  (A1)+,D0
00:00000416 B03C0020        	   563:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000041A 6D0C            	   564:     BLT     NonPrintable
00:0000041C B03C007E        	   565:     CMP.B   #126,D0
00:00000420 6E06            	   566:     BGT     NonPrintable
                            	   567: 
00:00000422 4EB801EA        	   568:     JSR     UART_WriteChar
00:00000426 6008            	   569:     BRA     NextAscii
                            	   570: 
                            	   571: NonPrintable:
00:00000428 103C002E        	   572:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000042C 4EB801EA        	   573:     JSR     UART_WriteChar
                            	   574: 
                            	   575: NextAscii:
00:00000430 51CAFFE2        	   576:     DBRA    D2,AsciiLoop
                            	   577: 
00:00000434 103C007C        	   578:     MOVE.B  #'|',D0
00:00000438 4EB801EA        	   579:     JSR     UART_WriteChar
00:0000043C 103C000D        	   580:     MOVE.B  #13,D0            ; CR
00:00000440 4EB801EA        	   581:     JSR     UART_WriteChar
00:00000444 103C000A        	   582:     MOVE.B  #10,D0            ; LF
00:00000448 4EB801EA        	   583:     JSR     UART_WriteChar
                            	   584: 
                            	   585: NoEndLine:
                            	   586:     ; Verifica fim do dump
00:0000044C B1C1            	   587:     CMP.L   D1,A0
00:0000044E 6300FF76        	   588:     BLS     DumpLoop
                            	   589: 
00:00000452 2F08            	   590:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000454 41F9000003F7    	   591:     LEA     HitAnyKey,A0
00:0000045A 4EB8023A        	   592:     JSR     UART_WriteString
00:0000045E 4EB80204        	   593:     JSR     UART_ReadChar
00:00000462 B03C001B        	   594:     CMP.B   #$1B,D0
00:00000466 6706            	   595:     BEQ     .fim
                            	   596: 
00:00000468 205F            	   597:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:0000046A 6000FF50        	   598:     BRA     DUMPLOOPMASTER
                            	   599: .fim
00:0000046E 6000FBFC        	   600:     BRA     MenuLoop
