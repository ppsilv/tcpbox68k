                            	   811: ;--------------------------------------------------
                            	   812: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   813: ;--------------------------------------------------
                            	   814: ; Exemplo: insere 'A' no buffer
                            	   815: ;          MOVE.B  #'A',D0
                            	   816: ;          JSR     UART_BufferPut
                            	   817: 
                            	   818: BufferPut:
00:000005CA 2F01            	   819:     MOVE.L  D1,-(SP)
00:000005CC 2F08            	   820:     MOVE.L  A0,-(SP)
                            	   821: 
                            	   822:     ;ANDI.W    #$FF00,D0
00:000005CE 41F900081024    	   823:     LEA     BUFFER,A0
00:000005D4 323900081022    	   824:     MOVE.W  BUFFER_COUNT,D1
                            	   825: 
00:000005DA B27C0100        	   826:     CMP.W   #256,D1
00:000005DE 6C1C            	   827:     BGE     .BufferFull
                            	   828: 
                            	   829:     ; Modificado para usar deslocamento de 16 bits
00:000005E0 32390008101A    	   830:     MOVE.W  BUFFER_HEAD,D1
00:000005E6 D0C1            	   831:     ADD     D1,A0
00:000005E8 1080            	   832:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   833: 
00:000005EA 5441            	   834:     ADD     #2,D1              ; Incrementa como word
00:000005EC 024100FF        	   835:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005F0 33C10008101A    	   836:     MOVE.W  D1,BUFFER_HEAD
                            	   837: 
00:000005F6 527900081022    	   838:     ADDQ.W  #1,BUFFER_COUNT
                            	   839: 
                            	   840: .BufferFull:
00:000005FC 205F            	   841:     MOVE.L  (SP)+,A0
00:000005FE 221F            	   842:     MOVE.L  (SP)+,D1
                            	   843: 
00:00000600 4E75            	   844:     RTS
                            	   845: 
                            	   846: ;--------------------------------------------------
                            	   847: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   848: ;--------------------------------------------------
                            	   849: ;Exemplo: Lendo byte do buffer
                            	   850: ;         BSR     UART_BufferGet
                            	   851: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   852: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   853: ;         Senão, D0 contém o byte lido!
                            	   854: BufferGet:
00:00000602 2F01            	   855:     MOVE.L  D1,-(SP)
00:00000604 2F08            	   856:     MOVE.L  A0,-(SP)
                            	   857: 
00:00000606 323900081022    	   858:     MOVE.W  BUFFER_COUNT,D1
00:0000060C 6724            	   859:     BEQ     .BufferEmpty
                            	   860: 
00:0000060E 41F900081024    	   861:     LEA     BUFFER,A0
                            	   862: 
                            	   863:     ; Modificado para usar deslocamento de 16 bits
00:00000614 32390008101E    	   864:     MOVE.W  BUFFER_TAIL,D1
00:0000061A 10301000        	   865:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   866: 
00:0000061E 5401            	   867:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000620 024100FF        	   868:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000624 33C10008101E    	   869:     MOVE.W  D1,BUFFER_TAIL
                            	   870: 
00:0000062A 537900081022    	   871:     SUBQ.W  #1,BUFFER_COUNT
00:00000630 6006            	   872:     BRA     .Exit
                            	   873: 
                            	   874: .BufferEmpty:
00:00000632 4EB8063E        	   875:     JSR     FBufferEmpty
00:00000636 70FF            	   876:     MOVEQ   #-1,D0
                            	   877: .Exit:
00:00000638 205F            	   878:     MOVE.L  (SP)+,A0
00:0000063A 221F            	   879:     MOVE.L  (SP)+,D1
00:0000063C 4E75            	   880:     RTS
                            	   881: 
                            	   882: FBufferEmpty:
00:0000063E 4EB80228        	   883:         JSR     new_line
00:00000642 41F900000371    	   884:         LEA     BufferEmpty,A0
