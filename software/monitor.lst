                            	   820: ;--------------------------------------------------
                            	   821: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   822: ;--------------------------------------------------
                            	   823: ; Exemplo: insere 'A' no buffer
                            	   824: ;          MOVE.B  #'A',D0
                            	   825: ;          JSR     UART_BufferPut
                            	   826: 
                            	   827: BufferPut:
00:000005DA 2F01            	   828:     MOVE.L  D1,-(SP)
00:000005DC 2F08            	   829:     MOVE.L  A0,-(SP)
                            	   830: 
                            	   831:     ;ANDI.W    #$FF00,D0
00:000005DE 41F900081024    	   832:     LEA     BUFFER,A0
00:000005E4 323900081022    	   833:     MOVE.W  BUFFER_COUNT,D1
                            	   834: 
00:000005EA B27C0100        	   835:     CMP.W   #256,D1
00:000005EE 6C1C            	   836:     BGE     .BufferFull
                            	   837: 
                            	   838:     ; Modificado para usar deslocamento de 16 bits
00:000005F0 32390008101A    	   839:     MOVE.W  BUFFER_HEAD,D1
00:000005F6 D0C1            	   840:     ADD     D1,A0
00:000005F8 1080            	   841:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   842: 
00:000005FA 5441            	   843:     ADD     #2,D1              ; Incrementa como word
00:000005FC 024100FF        	   844:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000600 33C10008101A    	   845:     MOVE.W  D1,BUFFER_HEAD
                            	   846: 
00:00000606 527900081022    	   847:     ADDQ.W  #1,BUFFER_COUNT
                            	   848: 
                            	   849: .BufferFull:
00:0000060C 205F            	   850:     MOVE.L  (SP)+,A0
00:0000060E 221F            	   851:     MOVE.L  (SP)+,D1
                            	   852: 
00:00000610 4E75            	   853:     RTS
                            	   854: 
                            	   855: ;--------------------------------------------------
                            	   856: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   857: ;--------------------------------------------------
                            	   858: ;Exemplo: Lendo byte do buffer
                            	   859: ;         BSR     UART_BufferGet
                            	   860: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   861: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   862: ;         Senão, D0 contém o byte lido!
                            	   863: BufferGet:
00:00000612 2F01            	   864:     MOVE.L  D1,-(SP)
00:00000614 2F08            	   865:     MOVE.L  A0,-(SP)
                            	   866: 
00:00000616 323900081022    	   867:     MOVE.W  BUFFER_COUNT,D1
00:0000061C 6724            	   868:     BEQ     .BufferEmpty
                            	   869: 
00:0000061E 41F900081024    	   870:     LEA     BUFFER,A0
                            	   871: 
                            	   872:     ; Modificado para usar deslocamento de 16 bits
00:00000624 32390008101E    	   873:     MOVE.W  BUFFER_TAIL,D1
00:0000062A 10301000        	   874:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   875: 
00:0000062E 5401            	   876:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000630 024100FF        	   877:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000634 33C10008101E    	   878:     MOVE.W  D1,BUFFER_TAIL
                            	   879: 
00:0000063A 537900081022    	   880:     SUBQ.W  #1,BUFFER_COUNT
00:00000640 6006            	   881:     BRA     .Exit
                            	   882: 
                            	   883: .BufferEmpty:
00:00000642 4EB8064E        	   884:     JSR     FBufferEmpty
00:00000646 70FF            	   885:     MOVEQ   #-1,D0
                            	   886: .Exit:
00:00000648 205F            	   887:     MOVE.L  (SP)+,A0
00:0000064A 221F            	   888:     MOVE.L  (SP)+,D1
00:0000064C 4E75            	   889:     RTS
                            	   890: 
                            	   891: FBufferEmpty:
00:0000064E 4EB8020E        	   892:         JSR     new_line
00:00000652 41F900000371    	   893:         LEA     BufferEmpty,A0
00:00000658 4EB8016E        	   894:         JSR     UART_WriteString
