00:0000014C 43F900081124    	   164:     LEA     xmodem_buffer,A1
00:00000152 7001            	   165:     MOVE.L  #$00000001,D0    ; Valor inicial
                            	   166: .Loop:
00:00000154 12C0            	   167:     MOVE.B  D0,(A1)+
00:00000156 5200            	   168:     ADD.B   #$01,D0    ; Incrementa cada byte do long
00:00000158 5301            	   169:     SUBQ.B  #1,D1
00:0000015A 66F8            	   170:     BNE     .Loop
                            	   171: 
