00:00000410 B03C0009        	   580:         CMP.B   #9,D0
00:00000414 6302            	   581:         BLS     .Decimal
00:00000416 5E00            	   582:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   583: .Decimal:
00:00000418 D03C0030        	   584:         ADD.B   #'0',D0
00:0000041C 4EF80186        	   585:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   586: 
