                            	   395: ; ----------------------------------------------------------------------
                            	   396: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   397: ; Entrada:
                            	   398: ;   D0.L = Valor a ser impresso (32 bits)
                            	   399: ;   D1.W = Número de dígitos (1-8)
                            	   400: ; ----------------------------------------------------------------------
                            	   401: PrintHexPRECISA_DE_REVISAO:
00:000002E2 4E56FFF8        	   402:         LINK    A6,#-8            ; Reserva espaço na pilha
00:000002E6 2F02            	   403:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002E8 2D40FFFC        	   404:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000002EC 3D41FFFA        	   405:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   406: 
00:000002F0 323C0008        	   407:         MOVE.W  #$0008,D1
                            	   408: 
                            	   409:         ; Ajusta para começar pelo dígito mais significativo
00:000002F4 E549            	   410:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000002F6 5941            	   411:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   412: 
                            	   413: .PrintLoop:
00:000002F8 202EFFFC        	   414:         MOVE.L  -4(A6),D0         ; Recupera valor
00:000002FC 3401            	   415:         MOVE.W  D1,D2             ; Posição do nibble
00:000002FE E5B8            	   416:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000300 02800000000F    	   417:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   418: 
                            	   419:         ; Converte para ASCII
00:00000306 B03C0009        	   420:         CMP.B   #9,D0
00:0000030A 6302            	   421:         BLS     .Decimal
00:0000030C 5E00            	   422:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   423: .Decimal:
00:0000030E D03C0030        	   424:         ADD.B   #'0',D0           ; Converte para caractere
                            	   425: 
                            	   426:         ; Imprime caractere
00:00000312 4EB8019A        	   427:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   428: 
00:00000316 5941            	   429:         SUBQ.W  #4,D1             ; Próximo nibble
00:00000318 6ADE            	   430:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   431: 
                            	   432:         ; Espaço final para separação
00:0000031A 103C0020        	   433:         MOVE.B  #' ',D0
00:0000031E 4EB8019A        	   434:         JSR     UART_WriteChar
                            	   435: 
00:00000322 241F            	   436:         MOVE.L  (SP)+,D2          ; Restaura D2
00:00000324 4E5E            	   437:         UNLK    A6                ; Restaura frame
00:00000326 4E75            	   438:         RTS
                            	   439: 
                            	   440: ; ----------------------------------------------------------------------
                            	   441: ; MemDump - Imprime dump de memória formatado
                            	   442: ; Entrada:
                            	   443: ;   A0 = Endereço inicial (ex: $80000)
                            	   444: ;   D0 = Quantidade de bytes (ex: 256)
                            	   445: ; ----------------------------------------------------------------------
                            	   446: MEMDUMP:
00:00000328 41F90000000D    	   447:         LEA     DumpHeader,A0
00:0000032E 4EB801EA        	   448:         JSR     UART_WriteString
00:00000332 20790008101E    	   449:         MOVE.L  (addressInHex),A0
00:00000338 2008            	   450:         MOVE.L  A0,D0
00:0000033A 4EB80408        	   451:         JSR     PrintHexAddress
00:0000033E 4EB8028A        	   452:         JSR     new_line
                            	   453: 
00:00000342 41F900000020    	   454:         LEA     DumpHeader1,A0
00:00000348 4EB801EA        	   455:         JSR     UART_WriteString
                            	   456: 
00:0000034C 20790008101E    	   457:         MOVE.L  (addressInHex),A0
                            	   458:         ; Calcula endereço final
                            	   459: 
                            	   460: DUMPLOOPMASTER:
00:00000352 7200            	   461:         CLR.L   D1
00:00000354 2208            	   462:         MOVE.L  A0,D1
00:00000356 0681000000FF    	   463:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   464:         ;MOVE.L  D1,D0
                            	   465:         ;JSR     PrintHexAddress
                            	   466:         ;JSR     new_line
                            	   467: 
                            	   468:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   469:         ;JSR     UART_ReadChar
                            	   470: 
                            	   471: 
                            	   472: DumpLoop:
                            	   473:         ; Nova linha a cada 16 bytes
00:0000035C 2008            	   474:         MOVE.L  A0,D0
00:0000035E 02800000000F    	   475:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000364 6616            	   476:         BNE     NoNewLine
                            	   477: 
                            	   478:         ; Imprime endereço
00:00000366 2008            	   479:         MOVE.L  A0,D0
00:00000368 4EB80408        	   480:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   481: 
00:0000036C 103C003A        	   482:         MOVE.B  #':',D0
00:00000370 4EB8019A        	   483:         JSR     UART_WriteChar
00:00000374 103C0020        	   484:         MOVE.B  #' ',D0
00:00000378 4EB8019A        	   485:         JSR     UART_WriteChar
                            	   486: 
                            	   487: NoNewLine:
                            	   488:         ; Imprime byte em hex
00:0000037C 1018            	   489:         MOVE.B  (A0)+,D0
00:0000037E 4EB80418        	   490:         JSR     PrintByteHex
                            	   491: 
00:00000382 103C0020        	   492:         MOVE.B  #' ',D0
00:00000386 4EB8019A        	   493:         JSR     UART_WriteChar
                            	   494: 
                            	   495:         ; Verifica fim da linha (16 bytes)
00:0000038A 2008            	   496:         MOVE.L  A0,D0
00:0000038C 02800000000F    	   497:         ANDI.L  #$0000000F,D0
00:00000392 664E            	   498:         BNE     NoEndLine
                            	   499: 
                            	   500:         ; Imprime caracteres ASCII
00:00000394 103C0020        	   501:         MOVE.B  #' ',D0
00:00000398 4EB8019A        	   502:         JSR     UART_WriteChar
00:0000039C 103C007C        	   503:         MOVE.B  #'|',D0
00:000003A0 4EB8019A        	   504:         JSR     UART_WriteChar
                            	   505: 
00:000003A4 43E8FFF0        	   506:         LEA     -16(A0),A1        ; Volta ao início da linha
00:000003A8 740F            	   507:         MOVEQ   #15,D2            ; 16 caracteres
                            	   508: 
                            	   509: AsciiLoop:
00:000003AA 1019            	   510:         MOVE.B  (A1)+,D0
00:000003AC B03C0020        	   511:         CMP.B   #32,D0            ; Verifica se é imprimível
00:000003B0 6D0C            	   512:         BLT     NonPrintable
00:000003B2 B03C007E        	   513:         CMP.B   #126,D0
00:000003B6 6E06            	   514:         BGT     NonPrintable
                            	   515: 
00:000003B8 4EB8019A        	   516:         JSR     UART_WriteChar
00:000003BC 6008            	   517:         BRA     NextAscii
                            	   518: 
                            	   519: NonPrintable:
00:000003BE 103C002E        	   520:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:000003C2 4EB8019A        	   521:         JSR     UART_WriteChar
                            	   522: 
                            	   523: NextAscii:
00:000003C6 51CAFFE2        	   524:         DBRA    D2,AsciiLoop
                            	   525: 
00:000003CA 103C007C        	   526:         MOVE.B  #'|',D0
00:000003CE 4EB8019A        	   527:         JSR     UART_WriteChar
00:000003D2 103C000D        	   528:         MOVE.B  #13,D0            ; CR
00:000003D6 4EB8019A        	   529:         JSR     UART_WriteChar
00:000003DA 103C000A        	   530:         MOVE.B  #10,D0            ; LF
00:000003DE 4EB8019A        	   531:         JSR     UART_WriteChar
                            	   532: 
                            	   533: NoEndLine:
                            	   534:         ; Verifica fim do dump
00:000003E2 B1C1            	   535:         CMP.L   D1,A0
00:000003E4 6300FF76        	   536:         BLS     DumpLoop
                            	   537: 
00:000003E8 2F08            	   538:         MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003EA 41F900000425    	   539:         LEA     HitAnyKey,A0
00:000003F0 4EB801EA        	   540:         JSR     UART_WriteString
00:000003F4 4EB801B4        	   541:         JSR     UART_ReadChar
00:000003F8 B03C001B        	   542:         CMP.B   #$1B,D0
00:000003FC 6706            	   543:         BEQ     .fim
                            	   544: 
00:000003FE 205F            	   545:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:00000400 6000FF50        	   546:         BRA     DUMPLOOPMASTER
                            	   547: .fim
00:00000404 6000FCAA        	   548:         BRA     MenuLoop
