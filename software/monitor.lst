00:00000532 4EB805B4        	   732:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:00000536 2200            	   733:     MOVE.L  D0,D1               ; D1 = contador
                            	   734: 
                            	   735: .WriteLoop:
