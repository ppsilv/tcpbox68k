                            	   249: ; ----------------------------------------------------------------------
                            	   250: ; Rotinas de E/S da UART
                            	   251: ; ----------------------------------------------------------------------
                            	   252: 
                            	   253: UART_Init:
00:00000204 227900081008    	   254:     move.l   CurrentUART,a1
00:0000020A 137C000D0004    	   255:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000210 137C00830006    	   256:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000216 12BC0068        	   257:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:0000021A 137C00000002    	   258:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000220 08A900070006    	   259:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000226 4229000E        	   260:     clr.b   SCR(a1)                 ; clear the scratch register
00:0000022A 4E75            	   261:     RTS
                            	   262: 
                            	   263:     ; Escreve caractere (D0.B)
                            	   264: UART_WriteChar:
00:0000022C 2F08            	   265:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000022E 2F00            	   266:     MOVE.L  D0,-(SP)        ; Preserva D0
00:00000230 207900081008    	   267:     move.l   CurrentUART,A0
                            	   268: .WaitTx:
00:00000236 08280005000A    	   269:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:0000023C 67F8            	   270:     BEQ     .WaitTx
00:0000023E 1080            	   271:     MOVE.B  D0,THR(A0)      ; transmit byte
00:00000240 201F            	   272:     MOVE.L  (SP)+,D0        ;Restaura D0
00:00000242 205F            	   273:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000244 4E75            	   274:     RTS
                            	   275: 
                            	   276: 
                            	   277: ; Lê caractere (retorna em D0)
                            	   278: UART_ReadChar:
00:00000246 2F08            	   279:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000248 207900081008    	   280:     MOVE.L   CurrentUART,A0
                            	   281: .WaitRx:
00:0000024E 08280000000A    	   282:     BTST    #0,LSR(A0)        ; RX ready?
00:00000254 67F8            	   283:     BEQ     .WaitRx
00:00000256 1010            	   284:     MOVE.B  RHR(A0),D0
00:00000258 205F            	   285:     MOVE.L  (SP)+,A0        ;Restaura A0
00:0000025A B03C001B        	   286:     CMP.B   #$1b,D0
00:0000025E 6704            	   287:     BEQ     .fim
00:00000260 4EB8022C        	   288:     JSR     UART_WriteChar
                            	   289: .fim
00:00000264 4E75            	   290:     RTS
                            	   291: 
                            	   292: ; Lê caractere (retorna em D0)
                            	   293: UART_ReadCharNonEcho:
00:00000266 2F08            	   294:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000268 207900081008    	   295:     MOVE.L  CurrentUART,A0
                            	   296: .WaitRx:
00:0000026E 08280000000A    	   297:     BTST    #0,LSR(A0)        ; RX ready?
00:00000274 67F8            	   298:     BEQ     .WaitRx
                            	   299: 
00:00000276 1010            	   300:     MOVE.B  RHR(A0),D0
00:00000278 205F            	   301:     MOVE.L  (SP)+,A0        ;Restaura A0
                            	   302: 
00:0000027A 4E75            	   303:     RTS
                            	   304: 
                            	   305: ; ----------------------------------------------------------------------
                            	   306: ; UART_WriteString - Envia string terminada em null para UART
                            	   307: ; Entrada:
                            	   308: ;   A0 = Ponteiro para a string (endereço da string)
                            	   309: ; ----------------------------------------------------------------------
                            	   310: UART_WriteString:
00:0000027C 2F08            	   311:     MOVE.L  A0,-(SP)      ; Preserva D0
00:0000027E 2F00            	   312:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   313: .WriteLoop:
00:00000280 1018            	   314:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000282 6706            	   315:     BEQ     .Done
00:00000284 4EB8022C        	   316:     JSR     UART_WriteChar ; Use sua rotine existente
00:00000288 60F6            	   317:     BRA     .WriteLoop
                            	   318: .Done:
00:0000028A 201F            	   319:     MOVE.L  (SP)+,D0
00:0000028C 205F            	   320:     MOVE.L  (SP)+,A0
00:0000028E 4E75            	   321:     RTS
