01:00001970 E44A            	  1334:     LSR.W   #2,D2           ; Divide por 4 para get vector number
01:00001972 024200FF        	  1335:     ANDI.W  #$FF,D2         ; Vector number em D2
                            	  1336: 
01:00001976 41F81A1F        	  1337:     LEA     vector_num_msg,A0
01:0000197A 4EB8126C        	  1338:     JSR     UART_WriteString
01:0000197E 3002            	  1339:     MOVE.W  D2,D0
01:00001980 4EB8148A        	  1340:     JSR     PrintHexAddress
01:00001984 4EB8130C        	  1341:     JSR     new_line
