00:000005F8 721C            	   842:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:000005FA 7400            	   843:         MOVEQ   #0,D2            ; Resultado em D2
                            	   844: .Loop:
00:000005FC 7000            	   845:         CLR.L   D0
00:000005FE 4EB80242        	   846:         JSR     UART_ReadChar
