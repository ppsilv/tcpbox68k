                            	   986: ; XMODEM RECEIVER ROUTINE
                            	   987: ; =====================================================================
                            	   988: XMODEM_Receive:
00:00000738 48E73FFE        	   989:                 MOVEM.L D2-D7/A0-A6,-(SP)
                            	   990:                 ; Inicializa variáveis
00:0000073C 41F900081625    	   991:                 LEA     expected_block,A0
00:00000742 103C0001        	   992:                 MOVE.B  #1,D0
00:00000746 1080            	   993:                 MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:00000748 41F9000815A4    	   994:                 LEA     xmodem_buffer,A0
                            	   995: 
                            	   996:                 ; ---- 1. INICIALIZAÇÃO ----
00:0000074E 103C0015        	   997:                 MOVE.B  #NAK,D0
00:00000752 4EB8019C        	   998:                 JSR     UART_WriteChar      ; Solicita início
                            	   999: 
                            	  1000:                 ; ---- 2. LOOP PRINCIPAL ----
                            	  1001: Receive_Loop:
00:00000756 4EB801B6        	  1002:                 JSR     UART_ReadChar
00:0000075A B03C0004        	  1003:                 CMP.B   #EOT,D0
00:0000075E 67000088        	  1004:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1005: 
00:00000762 B03C0001        	  1006:                 CMP.B   #SOH,D0
00:00000766 66EE            	  1007:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1008: 
                            	  1009:                 ; ---- 3. RECEBE HEADER ----
00:00000768 4EB801B6        	  1010:                 JSR     UART_ReadChar       ; Block number
00:0000076C 13C000081624    	  1011:                 MOVE.B  D0,block_number
00:00000772 4EB801B6        	  1012:                 JSR     UART_ReadChar       ; ~Block number (complemento)
                            	  1013: 
                            	  1014:                 ; ---- 4. RECEBE DADOS ----
00:00000776 323C007F        	  1015:                 MOVE.W  #127,D1             ; 128 bytes (0-based)
00:0000077A 43F9000815A4    	  1016:                 LEA     xmodem_buffer,A1
                            	  1017: 
                            	  1018: Receive_Data:
00:00000780 4EB801B6        	  1019:                 JSR     UART_ReadChar
00:00000784 12C0            	  1020:                 MOVE.B  D0,(A1)+
00:00000786 51C9FFF8        	  1021:                 DBF     D1,Receive_Data
                            	  1022: 
                            	  1023:                 ; ---- 5. VERIFICA CHECKSUM ----
00:0000078A 4EB801B6        	  1024:                 JSR     UART_ReadChar       ; Checksum
00:0000078E 1400            	  1025:                 MOVE.B  D0,D2
                            	  1026: 
                            	  1027:                 ; Calcula checksum local
00:00000790 43F9000815A4    	  1028:                 LEA     xmodem_buffer,A1
00:00000796 323C007F        	  1029:                 MOVE.W  #127,D1
00:0000079A 4203            	  1030:                 CLR.B   D3
                            	  1031: 
                            	  1032: Calc_Checksum:
00:0000079C D619            	  1033:                 ADD.B   (A1)+,D3
00:0000079E 51C9FFFC        	  1034:                 DBF     D1,Calc_Checksum
                            	  1035: 
00:000007A2 B602            	  1036:                 CMP.B   D2,D3
00:000007A4 6636            	  1037:                 BNE     Send_NAK            ; Erro no checksum
                            	  1038: 
                            	  1039:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
00:000007A6 103900081624    	  1040:                 MOVE.B  block_number,D0
00:000007AC B03900081625    	  1041:                 CMP.B   expected_block,D0
00:000007B2 6628            	  1042:                 BNE     Send_NAK            ; Bloco fora de ordem
                            	  1043: 
                            	  1044:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1045:                 ; (Aqui você processa os 128 bytes recebidos)
                            	  1046:                 ; Exemplo: copiar para RAM/Flash
00:000007B4 43F9000815A4    	  1047:                 LEA     xmodem_buffer,A1
00:000007BA 247900081524    	  1048:                 MOVE.L  user_buffer_ptr,A2  ; Defina isso antes de chamar
00:000007C0 323C007F        	  1049:                 MOVE.W  #127,D1
                            	  1050: Copy_Data:
00:000007C4 14D9            	  1051:                 MOVE.B  (A1)+,(A2)+
00:000007C6 51C9FFFC        	  1052:                 DBF     D1,Copy_Data
                            	  1053: 
                            	  1054:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:000007CA 523900081625    	  1055:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:000007D0 103C0006        	  1056:                 MOVE.B  #ACK,D0
00:000007D4 4EB8019C        	  1057:                 JSR     UART_WriteChar
00:000007D8 6000FF7C        	  1058:                 BRA     Receive_Loop
                            	  1059: 
                            	  1060: Send_NAK:
00:000007DC 103C0015        	  1061:                 MOVE.B  #NAK,D0
00:000007E0 4EB8019C        	  1062:                 JSR     UART_WriteChar
00:000007E4 6000FF70        	  1063:                 BRA     Receive_Loop
                            	  1064: 
                            	  1065: Transfer_Complete:
00:000007E8 103C0006        	  1066:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:000007EC 4EB8019C        	  1067:                 JSR     UART_WriteChar
00:000007F0 4CDF7FFC        	  1068:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:000007F4 4E75            	  1069:                 RTS
                            	  1070: 
00:000007F6 4D45524441205445	  1071:     DC.B "MERDA TERMINA"
00:000007FE 524D494E41
