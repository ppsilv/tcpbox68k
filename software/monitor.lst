                            	   832: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   833: ;--------------------------------------------------
                            	   834: ; Exemplo: insere 'A' no buffer
                            	   835: ;          MOVE.B  #'A',D0
                            	   836: ;          JSR     UART_BufferPut
