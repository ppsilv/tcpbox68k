                            	   177: ; Rotinas de E/S da UART
                            	   178: ; ----------------------------------------------------------------------
                            	   179: 
                            	   180: UART_INIT:
00:0000015E 227900081010    	   181:         move.l   CurrentUART,a1
00:00000164 137C000D0004    	   182:         move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000016A 137C00830006    	   183:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000170 12BC0068        	   184:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000174 137C00000002    	   185:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000017A 08A900070006    	   186:         bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000180 4229000E        	   187:         clr.b   SCR(a1)                 ; clear the scratch register
00:00000184 4E75            	   188:         RTS
                            	   189: 
                            	   190:     ; Escreve caractere (D0.B)
                            	   191: UART_WriteChar:
00:00000186 2F08            	   192:         MOVE.L  A0,-(SP)        ; Preserva A0
00:00000188 2F00            	   193:         MOVE.L  D0,-(SP)        ; Preserva D0
00:0000018A 207900081010    	   194:         move.l   CurrentUART,A0
                            	   195: .WaitTx:
00:00000190 08280005000A    	   196:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000196 67F8            	   197:         BEQ     .WaitTx
00:00000198 1080            	   198:         MOVE.B  D0,THR(A0)      ; transmit byte
00:0000019A 201F            	   199:         MOVE.L  (SP)+,D0        ;Restaura D0
00:0000019C 205F            	   200:         MOVE.L  (SP)+,A0        ;Restaura A0
00:0000019E 4E75            	   201:         RTS
                            	   202: 
                            	   203: 
                            	   204: ; Lê caractere (retorna em D0)
                            	   205: UART_ReadChar:
00:000001A0 2F08            	   206:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001A2 207900081010    	   207:         MOVE.L   CurrentUART,A0
                            	   208: .WaitRx:
00:000001A8 08280000000A    	   209:         BTST    #0,LSR(A0)        ; RX ready?
00:000001AE 67F8            	   210:         BEQ     .WaitRx
00:000001B0 1010            	   211:         MOVE.B  RHR(A0),D0
00:000001B2 205F            	   212:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001B4 B03C001B        	   213:         CMP.B   #$1b,D0
00:000001B8 6704            	   214:         BEQ     .fim
00:000001BA 4EB80186        	   215:         JSR     UART_WriteChar
                            	   216: .fim
00:000001BE 4E75            	   217:         RTS
                            	   218: 
                            	   219: ; Lê caractere (retorna em D0)
                            	   220: UART_ReadCharNonEcho:
00:000001C0 2F08            	   221:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001C2 207900081010    	   222:         MOVE.L  CurrentUART,A0
                            	   223: .WaitRx:
00:000001C8 08280000000A    	   224:         BTST    #0,LSR(A0)        ; RX ready?
00:000001CE 67F8            	   225:         BEQ     .WaitRx
                            	   226: 
00:000001D0 1010            	   227:         MOVE.B  RHR(A0),D0
00:000001D2 205F            	   228:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   229: 
00:000001D4 4E75            	   230:         RTS
