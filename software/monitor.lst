                            	   232: UART_ReadCharNonEcho:
00:000001EA 2F08            	   233:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001EC 207900081010    	   234:         MOVE.L  CurrentUART,A0
                            	   235: .WaitRx:
00:000001F2 08280000000A    	   236:         BTST    #0,LSR(A0)        ; RX ready?
00:000001F8 67F8            	   237:         BEQ     .WaitRx
                            	   238: 
00:000001FA 1010            	   239:         MOVE.B  RHR(A0),D0
00:000001FC 205F            	   240:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   241: 
00:000001FE 4E75            	   242:         RTS
