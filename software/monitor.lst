00:00000686 70FF            	   883:         MOVEQ   #-1,D0
                            	   884: .Exit:
00:00000688 205F            	   885:         MOVE.L  (SP)+,A0
00:0000068A 221F            	   886:         MOVE.L  (SP)+,D1
00:0000068C 4E75            	   887:         RTS
