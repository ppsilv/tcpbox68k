                            	   244: ; ----------------------------------------------------------------------
                            	   245: ; UART_WriteString - Envia string terminada em null para UART
                            	   246: ; Entrada:
                            	   247: ;   A0 = Ponteiro para a string (endereço da string)
                            	   248: ; ----------------------------------------------------------------------
                            	   249: UART_WriteString:
00:00000200 2F08            	   250:         MOVE.L  A0,-(SP)      ; Preserva D0
00:00000202 2F00            	   251:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   252: .WriteLoop:
00:00000204 1018            	   253:         MOVE.B  (A0)+,D0      ; Pega caractere
00:00000206 6706            	   254:         BEQ     .Done
00:00000208 4EB801B0        	   255:         JSR     UART_WriteChar ; Use sua rotine existente
00:0000020C 60F6            	   256:         BRA     .WriteLoop
                            	   257: .Done:
00:0000020E 201F            	   258:         MOVE.L  (SP)+,D0
00:00000210 205F            	   259:         MOVE.L  (SP)+,A0
00:00000212 4E75            	   260:         RTS
