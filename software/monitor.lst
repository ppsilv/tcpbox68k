                            	   630: ; ----------------------------------------------------------------------
                            	   631: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   632: ; Entrada: D0 = endereço
                            	   633: ; ----------------------------------------------------------------------
                            	   634: PrintHexAddress:
00:000004B0 4840            	   635:     SWAP    D0                ; Imprime parte alta primeiro
00:000004B2 4EB804B8        	   636:     JSR     PrintWordHex
00:000004B6 4840            	   637:     SWAP    D0                ; Parte baixa
                            	   638:     ; Continua para PrintWordHex
                            	   639: 
                            	   640: ; ----------------------------------------------------------------------
                            	   641: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   642: ; Entrada: D0.w = valor
                            	   643: ; ----------------------------------------------------------------------
                            	   644: PrintWordHex:
00:000004B8 E158            	   645:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000004BA 4EB804C0        	   646:     JSR     PrintByteHex
00:000004BE E058            	   647:     ROR.W   #8,D0             ; Byte menos significativo
                            	   648:     ; Continua para PrintByteHex
                            	   649: 
                            	   650: ; ----------------------------------------------------------------------
                            	   651: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   652: ; Entrada: D0.b = valor
                            	   653: ; ----------------------------------------------------------------------
                            	   654: PrintByteHex:
00:000004C0 1F00            	   655:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000004C2 E808            	   656:     LSR.B   #4,D0             ; Nibble alto
00:000004C4 6106            	   657:     BSR     PrintNibble
00:000004C6 101F            	   658:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000004C8 0200000F        	   659:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   660:     ; Continua para PrintNibble
                            	   661: ; ----------------------------------------------------------------------
                            	   662: ; PrintNibble - Imprime um nibble em hex
                            	   663: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   664: ; ----------------------------------------------------------------------
                            	   665: PrintNibble:
00:000004CC B03C0009        	   666:     CMP.B   #9,D0
00:000004D0 6302            	   667:     BLS     .Decimal
00:000004D2 5E00            	   668:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   669: .Decimal:
00:000004D4 D03C0030        	   670:     ADD.B   #'0',D0
00:000004D8 4EF80228        	   671:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   672: 
                            	   673: ClearRAM:
00:000004DC 41F900080000    	   674:     LEA     $80000,A0
00:000004E2 43F90008FFFF    	   675:     LEA     $8FFFF,A1
00:000004E8 7000            	   676:     MOVEQ   #0,D0
                            	   677: .ClearLoop:
00:000004EA 20C0            	   678:     MOVE.L  D0,(A0)+
00:000004EC B3C8            	   679:     CMPA.L  A0,A1
00:000004EE 62FA            	   680:     BHI     .ClearLoop
00:000004F0 4E75            	   681:     RTS
                            	   682: ; ----------------------------------------------------------------------
                            	   683: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   684: ; ----------------------------------------------------------------------
                            	   685: ClearRAM1:
00:000004F2 41F900080000    	   686:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000004F8 43F900100000    	   687:     LEA     $100000,A1       ; Endereço final + 1
00:000004FE 7000            	   688:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   689: 
                            	   690:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000500 2209            	   691:     MOVE.L  A1,D1
00:00000502 9288            	   692:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   693: 
                            	   694:     ; Otimização: escreve longs (32 bits) quando possível
00:00000504 2401            	   695:     MOVE.L  D1,D2
00:00000506 028200000003    	   696:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:0000050C 670C            	   697:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   698: 
                            	   699:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:0000050E 5382            	   700:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   701: .ResidualLoop:
00:00000510 10C0            	   702:     MOVE.B  D0,(A0)+
00:00000512 51CAFFFC        	   703:     DBRA    D2,.ResidualLoop
                            	   704: 
                            	   705:     ; Atualiza tamanho restante
00:00000516 9282            	   706:     SUB.L   D2,D1
00:00000518 5381            	   707:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   708: 
                            	   709: .ClearLongs:
00:0000051A E489            	   710:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:0000051C 5381            	   711:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   712: 
                            	   713: .LongLoop:
00:0000051E 20C0            	   714:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000520 51C9FFFC        	   715:     DBRA    D1,.LongLoop
00:00000524 4E75            	   716:     RTS
