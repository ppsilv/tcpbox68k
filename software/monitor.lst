                            	   249: ; ----------------------------------------------------------------------
                            	   250: ; Rotinas de E/S da UART
                            	   251: ; ----------------------------------------------------------------------
                            	   252: 
                            	   253: UART_Init:
00:00000200 227900081008    	   254:     move.l   CurrentUART,a1
00:00000206 137C000D0004    	   255:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000020C 137C00830006    	   256:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000212 12BC0068        	   257:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000216 137C00000002    	   258:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000021C 08A900070006    	   259:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000222 4229000E        	   260:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000226 4E75            	   261:     RTS
                            	   262: 
                            	   263:     ; Escreve caractere (D0.B)
                            	   264: UART_WriteChar:
00:00000228 2F08            	   265:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000022A 2F00            	   266:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000022C 207900081008    	   267:     move.l   CurrentUART,A0
                            	   268: .WaitTx:
00:00000232 08280005000A    	   269:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000238 67F8            	   270:     BEQ     .WaitTx
00:0000023A 1080            	   271:     MOVE.B  D0,THR(A0)      ; transmit byte
00:0000023C 201F            	   272:     MOVE.L  (SP)+,D0        ;Restaura D0
00:0000023E 205F            	   273:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000240 4E75            	   274:     RTS
                            	   275: 
                            	   276: 
                            	   277: ; Lê caractere (retorna em D0)
                            	   278: UART_ReadChar:
00:00000242 2F08            	   279:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000244 207900081008    	   280:     MOVE.L   CurrentUART,A0
                            	   281: .WaitRx:
00:0000024A 08280000000A    	   282:     BTST    #0,LSR(A0)        ; RX ready?
00:00000250 67F8            	   283:     BEQ     .WaitRx
00:00000252 1010            	   284:     MOVE.B  RHR(A0),D0
00:00000254 205F            	   285:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000256 B03C001B        	   286:     CMP.B   #$1b,D0
00:0000025A 6704            	   287:     BEQ     .fim
00:0000025C 4EB80228        	   288:     JSR     UART_WriteChar
                            	   289: .fim
00:00000260 4E75            	   290:     RTS
                            	   291: 
                            	   292: ; Lê caractere (retorna em D0)
                            	   293: UART_ReadCharNonEcho:
00:00000262 2F08            	   294:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000264 207900081008    	   295:     MOVE.L  CurrentUART,A0
                            	   296: .WaitRx:
00:0000026A 08280000000A    	   297:     BTST    #0,LSR(A0)        ; RX ready?
00:00000270 67F8            	   298:     BEQ     .WaitRx
                            	   299: 
00:00000272 1010            	   300:     MOVE.B  RHR(A0),D0
00:00000274 205F            	   301:     MOVE.L  (SP)+,A0        ;Restaura A0
                            	   302: 
00:00000276 4E75            	   303:     RTS
                            	   304: 
                            	   305: ; ----------------------------------------------------------------------
                            	   306: ; UART_WriteString - Envia string terminada em null para UART
                            	   307: ; Entrada:
                            	   308: ;   A0 = Ponteiro para a string (endereço da string)
                            	   309: ; ----------------------------------------------------------------------
                            	   310: UART_WriteString:
00:00000278 2F08            	   311:     MOVE.L  A0,-(SP)      ; Preserva D0
00:0000027A 2F00            	   312:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   313: .WriteLoop:
00:0000027C 1018            	   314:     MOVE.B  (A0)+,D0      ; Pega caractere
00:0000027E 6706            	   315:     BEQ     .Done
00:00000280 4EB80228        	   316:     JSR     UART_WriteChar ; Use sua rotine existente
00:00000284 60F6            	   317:     BRA     .WriteLoop
                            	   318: .Done:
00:00000286 201F            	   319:     MOVE.L  (SP)+,D0
00:00000288 205F            	   320:     MOVE.L  (SP)+,A0
00:0000028A 4E75            	   321:     RTS
                            	   322: 
                            	   323: ; ----------------------------------------------------------------------
                            	   324: ; Constantes
                            	   325: ; ----------------------------------------------------------------------
                            	   326: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   327: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   328:                               ; BAUD_DIV_L em $70000
                            	   329:                               ; BAUD_DIV_U em $70001
                            	   330: 
                            	   331: ; ----------------------------------------------------------------------
                            	   332: ; Rotina: Calcula e armazena divisor de baud rate
                            	   333: ; Entrada:
                            	   334: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   335: ; Saída:
                            	   336: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   337: ; Formulas:
                            	   338: ;
                            	   339: ;
                            	   340: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   341: ; ----------------------------------------------------------------------
                            	   342: 
                            	   343: CalcBaudDiv:
                            	   344: ;[ Registrador D0 (32 bits) ]
                            	   345: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   346: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   347:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   348:     ;((F_CPU/16)/10)
                            	   349:     ;F_CPU = 16000000 ou 0xF42400
00:0000028C 203C00F42400    	   350:     MOVE.L  #F_CPU,D0
00:00000292 323C0010        	   351:     MOVE.W  #16,D1         ; Divisor
00:00000296 61000096        	   352:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   353: ;1
00:0000029A 2F00            	   354:     move.l  d0,-(SP)
00:0000029C 4EB804B0        	   355:     jsr     PrintHexAddress
00:000002A0 4EB80318        	   356:     jsr     new_line
00:000002A4 201F            	   357:     move.l  (SP)+,d0
                            	   358: 
00:000002A6 323C000A        	   359:     MOVE.W  #10,D1         ; Divisor
00:000002AA 61000082        	   360:     BSR     Div32x16       ; D0 = 0x186A0
                            	   361: ;2
00:000002AE 2F00            	   362:     move.l  d0,-(SP)
00:000002B0 4EB804B0        	   363:     jsr     PrintHexAddress
00:000002B4 4EB80318        	   364:     jsr     new_line
00:000002B8 201F            	   365:     move.l  (SP)+,d0
                            	   366: 
                            	   367:     ;(BAUD/10)
00:000002BA 2F00            	   368:     move.l  d0,-(SP)
                            	   369: ;3
00:000002BC 7000            	   370:     CLR.L   D0
00:000002BE 30390008100C    	   371:     MOVE.W  CurrentBaudRate,D0
00:000002C4 2F00            	   372:     move.l  d0,-(SP)
00:000002C6 4EB804B0        	   373:     jsr     PrintHexAddress
00:000002CA 4EB80318        	   374:     jsr     new_line
00:000002CE 201F            	   375:     move.l  (SP)+,d0
                            	   376: 
00:000002D0 123C000A        	   377:     MOVE.B  #10,D1
00:000002D4 6158            	   378:     BSR     Div32x16
                            	   379: 
                            	   380: ;4
00:000002D6 2F00            	   381:     move.l  d0,-(SP)
00:000002D8 4EB804B0        	   382:     jsr     PrintHexAddress
00:000002DC 4EB80318        	   383:     jsr     new_line
00:000002E0 221F            	   384:     move.l  (SP)+,D1
00:000002E2 201F            	   385:     move.l  (SP)+,D0
                            	   386: 
                            	   387: 
                            	   388:     ;(F_CPU/BAUD)
00:000002E4 6148            	   389:     BSR     Div32x16
                            	   390: ;5
00:000002E6 2F00            	   391:     move.l  d0,-(SP)
00:000002E8 4EB804B0        	   392:     jsr     PrintHexAddress
00:000002EC 4EB80318        	   393:     jsr     new_line
00:000002F0 201F            	   394:     move.l  (SP)+,d0
                            	   395: 
                            	   396:     ; 4. Separa parte alta/baixa corretamente
00:000002F2 3200            	   397:     MOVE.W  D0,D1
00:000002F4 024000FF        	   398:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000002F8 E049            	   399:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000002FA 024100FF        	   400:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   401: 
                            	   402:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000002FE 41F900081012    	   403:     LEA     Baud1DivL,A0
00:00000304 3080            	   404:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000306 41F900081014    	   405:     LEA     Baud1DivH,A0
00:0000030C 3081            	   406:     MOVE.W  D1,(A0)
                            	   407: 
00:0000030E 6000FD74        	   408:     BRA     MenuLoop
00:00000312 4E75            	   409:     RTS
                            	   410: .BaudError:
00:00000314 6000FD0A        	   411:     BRA     _start
                            	   412: 
                            	   413: new_line:
00:00000318 2F00            	   414:         MOVE.L  D0,-(SP)          ; Salva D0
00:0000031A 103C000A        	   415:         MOVE.B  #10,D0
00:0000031E 4EB80228        	   416:         JSR     UART_WriteChar
00:00000322 103C000D        	   417:         MOVE.B  #13,D0
00:00000326 4EB80228        	   418:         JSR     UART_WriteChar
00:0000032A 201F            	   419:         MOVE.L  (SP)+,D0          ; Restaura D0
00:0000032C 4E75            	   420:         RTS
                            	   421: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   422: ; Retorna D0 = Quociente, D1 = Resto
                            	   423: Div32x16:
00:0000032E 7400            	   424:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000330 761F            	   425:     MOVEQ   #31,D3      ; 32 iterações
                            	   426: DivLoop:
00:00000332 E388            	   427:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:00000334 E392            	   428:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000336 B441            	   429:     CMP.W   D1,D2       ; D2 >= D1?
00:00000338 6D04            	   430:     BLT     .skip
00:0000033A 9441            	   431:     SUB.W   D1,D2       ; Sim, subtrai
00:0000033C 5280            	   432:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   433: .skip:
00:0000033E 51CBFFF2        	   434:     DBRA    D3,DivLoop  ; Repete
00:00000342 2202            	   435:     MOVE.L  D2,D1       ; Resto em D1
00:00000344 4E75            	   436:     RTS
                            	   437: ; Versão compacta sem stack frame
                            	   438: PrintHexFast:
00:00000346 2F02            	   439:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000348 2F00            	   440:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:0000034A 7407            	   441:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   442: 
                            	   443: .Loop:
00:0000034C 2017            	   444:     MOVE.L  (SP),D0           ; Recupera valor original
00:0000034E E998            	   445:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000350 2E80            	   446:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000352 0200000F        	   447:     ANDI.B  #$F,D0            ; Isola nibble
                            	   448: 
00:00000356 B03C0009        	   449:     CMP.B   #9,D0
00:0000035A 6302            	   450:     BLS     .Digit
00:0000035C 5E00            	   451:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   452: .Digit:
00:0000035E D03C0030        	   453:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000362 4EB80228        	   454:     JSR     UART_WriteChar    ; Envia caractere
                            	   455: 
00:00000366 51CAFFE4        	   456:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   457: 
00:0000036A 588F            	   458:     ADDQ.L  #4,SP             ; Remove valor salvo
00:0000036C 241F            	   459:     MOVE.L  (SP)+,D2          ; Restaura D2
00:0000036E 4E75            	   460:     RTS
                            	   461: 
                            	   462: ; ----------------------------------------------------------------------
                            	   463: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   464: ; Entrada:
                            	   465: ;   D0.L = Valor a ser impresso (32 bits)
                            	   466: ;   D1.W = Número de dígitos (1-8)
                            	   467: ; ----------------------------------------------------------------------
                            	   468: PrintHexPRECISA_DE_REVISAO:
00:00000370 4E56FFF8        	   469:     LINK    A6,#-8            ; Reserva espaço na pilha
00:00000374 2F02            	   470:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000376 2D40FFFC        	   471:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:0000037A 3D41FFFA        	   472:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   473: 
00:0000037E 323C0008        	   474:     MOVE.W  #$0008,D1
                            	   475: 
                            	   476:     ; Ajusta para começar pelo dígito mais significativo
00:00000382 E549            	   477:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:00000384 5941            	   478:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   479: 
                            	   480: .PrintLoop:
00:00000386 202EFFFC        	   481:     MOVE.L  -4(A6),D0         ; Recupera valor
00:0000038A 3401            	   482:     MOVE.W  D1,D2             ; Posição do nibble
00:0000038C E5B8            	   483:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:0000038E 02800000000F    	   484:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   485: 
                            	   486:     ; Converte para ASCII
00:00000394 B03C0009        	   487:     CMP.B   #9,D0
00:00000398 6302            	   488:     BLS     .Decimal
00:0000039A 5E00            	   489:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   490: .Decimal:
00:0000039C D03C0030        	   491:     ADD.B   #'0',D0           ; Converte para caractere
                            	   492: 
                            	   493:     ; Imprime caractere
00:000003A0 4EB80228        	   494:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   495: 
00:000003A4 5941            	   496:     SUBQ.W  #4,D1             ; Próximo nibble
00:000003A6 6ADE            	   497:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   498: 
                            	   499:     ; Espaço final para separação
00:000003A8 103C0020        	   500:     MOVE.B  #' ',D0
00:000003AC 4EB80228        	   501:     JSR     UART_WriteChar
                            	   502: 
00:000003B0 241F            	   503:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000003B2 4E5E            	   504:     UNLK    A6                ; Restaura frame
00:000003B4 4E75            	   505:     RTS
                            	   506: ; ----------------------------------------------------------------------
                            	   507: ; Exemplo de uso:
                            	   508: ; ----------------------------------------------------------------------
                            	   509: SetupDivisor:
00:000003B6 303C2580        	   510:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000003BA 6100FED0        	   511:     BSR     CalcBaudDiv
                            	   512: 
                            	   513:     ; Agora pode acessar os valores na RAM:
00:000003BE 41F90008100E    	   514:     LEA     BaudDivL,A0
00:000003C4 1010            	   515:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000003C6 41F900081010    	   516:     LEA     BaudDivH,A0
00:000003CC 1210            	   517:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   518: 
                            	   519:     ; (Aqui você configuraria os registradores da UART)
00:000003CE 4E75            	   520:     RTS
                            	   521: ; ----------------------------------------------------------------------
                            	   522: ; MemDump - Imprime dump de memória formatado
                            	   523: ; Entrada:
                            	   524: ;   A0 = Endereço inicial (ex: $80000)
                            	   525: ;   D0 = Quantidade de bytes (ex: 256)
                            	   526: ; ----------------------------------------------------------------------
                            	   527: MemDump:
00:000003D0 41F90000000D    	   528:     LEA     DumpHeader,A0
00:000003D6 4EB80278        	   529:     JSR     UART_WriteString
00:000003DA 207900081016    	   530:     MOVE.L  (addressInHex),A0
00:000003E0 2008            	   531:     MOVE.L  A0,D0
00:000003E2 4EB804B0        	   532:     JSR     PrintHexAddress
00:000003E6 4EB80318        	   533:     JSR     new_line
                            	   534: 
00:000003EA 41F900000020    	   535:     LEA     DumpHeader1,A0
00:000003F0 4EB80278        	   536:     JSR     UART_WriteString
                            	   537: 
00:000003F4 207900081016    	   538:     MOVE.L  (addressInHex),A0
                            	   539:     ; Calcula endereço final
                            	   540: 
                            	   541: DUMPLOOPMASTER:
00:000003FA 7200            	   542:     CLR.L   D1
00:000003FC 2208            	   543:     MOVE.L  A0,D1
00:000003FE 0681000000FF    	   544:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   545:     ;MOVE.L  D1,D0
                            	   546:     ;JSR     PrintHexAddress
                            	   547:     ;JSR     new_line
                            	   548: 
                            	   549:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   550:     ;JSR     UART_ReadChar
                            	   551: 
                            	   552: 
                            	   553: DumpLoop:
                            	   554:     ; Nova linha a cada 16 bytes
00:00000404 2008            	   555:     MOVE.L  A0,D0
00:00000406 02800000000F    	   556:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000040C 6616            	   557:     BNE     NoNewLine
                            	   558: 
                            	   559:     ; Imprime endereço
00:0000040E 2008            	   560:     MOVE.L  A0,D0
00:00000410 4EB804B0        	   561:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   562: 
00:00000414 103C003A        	   563:     MOVE.B  #':',D0
00:00000418 4EB80228        	   564:     JSR     UART_WriteChar
00:0000041C 103C0020        	   565:     MOVE.B  #' ',D0
00:00000420 4EB80228        	   566:     JSR     UART_WriteChar
                            	   567: 
                            	   568: NoNewLine:
                            	   569:     ; Imprime byte em hex
00:00000424 1018            	   570:     MOVE.B  (A0)+,D0
00:00000426 4EB804C0        	   571:     JSR     PrintByteHex
                            	   572: 
00:0000042A 103C0020        	   573:     MOVE.B  #' ',D0
00:0000042E 4EB80228        	   574:     JSR     UART_WriteChar
                            	   575: 
                            	   576:     ; Verifica fim da linha (16 bytes)
00:00000432 2008            	   577:     MOVE.L  A0,D0
00:00000434 02800000000F    	   578:     ANDI.L  #$0000000F,D0
00:0000043A 664E            	   579:     BNE     NoEndLine
                            	   580: 
                            	   581:     ; Imprime caracteres ASCII
00:0000043C 103C0020        	   582:     MOVE.B  #' ',D0
00:00000440 4EB80228        	   583:     JSR     UART_WriteChar
00:00000444 103C007C        	   584:     MOVE.B  #'|',D0
00:00000448 4EB80228        	   585:     JSR     UART_WriteChar
                            	   586: 
00:0000044C 43E8FFF0        	   587:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000450 740F            	   588:     MOVEQ   #15,D2            ; 16 caracteres
                            	   589: 
                            	   590: AsciiLoop:
00:00000452 1019            	   591:     MOVE.B  (A1)+,D0
00:00000454 B03C0020        	   592:     CMP.B   #32,D0            ; Verifica se é imprimível
00:00000458 6D0C            	   593:     BLT     NonPrintable
00:0000045A B03C007E        	   594:     CMP.B   #126,D0
00:0000045E 6E06            	   595:     BGT     NonPrintable
                            	   596: 
00:00000460 4EB80228        	   597:     JSR     UART_WriteChar
00:00000464 6008            	   598:     BRA     NextAscii
                            	   599: 
                            	   600: NonPrintable:
00:00000466 103C002E        	   601:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000046A 4EB80228        	   602:     JSR     UART_WriteChar
                            	   603: 
                            	   604: NextAscii:
00:0000046E 51CAFFE2        	   605:     DBRA    D2,AsciiLoop
                            	   606: 
00:00000472 103C007C        	   607:     MOVE.B  #'|',D0
00:00000476 4EB80228        	   608:     JSR     UART_WriteChar
00:0000047A 103C000D        	   609:     MOVE.B  #13,D0            ; CR
00:0000047E 4EB80228        	   610:     JSR     UART_WriteChar
00:00000482 103C000A        	   611:     MOVE.B  #10,D0            ; LF
00:00000486 4EB80228        	   612:     JSR     UART_WriteChar
                            	   613: 
                            	   614: NoEndLine:
                            	   615:     ; Verifica fim do dump
00:0000048A B1C1            	   616:     CMP.L   D1,A0
00:0000048C 6300FF76        	   617:     BLS     DumpLoop
                            	   618: 
00:00000490 2F08            	   619:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000492 41F9000003FA    	   620:     LEA     HitAnyKey,A0
00:00000498 4EB80278        	   621:     JSR     UART_WriteString
00:0000049C 4EB80242        	   622:     JSR     UART_ReadChar
00:000004A0 B03C001B        	   623:     CMP.B   #$1B,D0
00:000004A4 6706            	   624:     BEQ     .fim
                            	   625: 
00:000004A6 205F            	   626:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000004A8 6000FF50        	   627:     BRA     DUMPLOOPMASTER
                            	   628: .fim
00:000004AC 6000FBD6        	   629:     BRA     MenuLoop
