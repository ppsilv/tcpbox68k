00:00000502 2F01            	   687:         MOVE.L  D1,-(SP)
00:00000504 2F02            	   688:         MOVE.L  D2,-(SP)
                            	   689: 
00:00000506 41F900000311    	   690:         LEA     WritePrompt,A0
00:0000050C 4EB80200        	   691:         JSR     UART_WriteString
                            	   692: 
00:00000510 4EB802A0        	   693:         JSR     new_line
                            	   694: 
00:00000514 7000            	   695:         MOVEQ   #0,D0
