                            	   230: ; ----------------------------------------------------------------------
                            	   231: ; UART_WriteString - Envia string terminada em null para UART
                            	   232: ; Entrada:
                            	   233: ;   A0 = Ponteiro para a string (endereço da string)
                            	   234: ; ----------------------------------------------------------------------
                            	   235: UART_WriteString:
00:000001C2 2F08            	   236:         MOVE.L  A0,-(SP)      ; Preserva D0
00:000001C4 2F00            	   237:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   238: .WriteLoop:
00:000001C6 1018            	   239:         MOVE.B  (A0)+,D0      ; Pega caractere
00:000001C8 6706            	   240:         BEQ     .Done
00:000001CA 4EB80172        	   241:         JSR     UART_WriteChar ; Use sua rotine existente
00:000001CE 60F6            	   242:         BRA     .WriteLoop
                            	   243: .Done:
00:000001D0 201F            	   244:         MOVE.L  (SP)+,D0
00:000001D2 205F            	   245:         MOVE.L  (SP)+,A0
00:000001D4 4E75            	   246:         RTS
