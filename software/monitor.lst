                            	   211: ; ----------------------------------------------------------------------
                            	   212: ; Constantes
                            	   213: ; ----------------------------------------------------------------------
                            	   214: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   215: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   216:                               ; BAUD_DIV_L em $70000
                            	   217:                               ; BAUD_DIV_U em $70001
                            	   218: 
                            	   219: ; ----------------------------------------------------------------------
                            	   220: ; Rotina: Calcula e armazena divisor de baud rate
                            	   221: ; Entrada:
                            	   222: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   223: ; Saída:
                            	   224: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   225: ; Formulas:
                            	   226: ;
                            	   227: ;
                            	   228: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   229: ; ----------------------------------------------------------------------
                            	   230: 
                            	   231: CalcBaudDiv:
                            	   232: ;[ Registrador D0 (32 bits) ]
                            	   233: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   234: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   235:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   236:     ;((F_CPU/16)/10)
                            	   237:     ;F_CPU = 16000000 ou 0xF42400
00:0000019C 203C00F42400    	   238:     MOVE.L  #F_CPU,D0
00:000001A2 323C0010        	   239:     MOVE.W  #16,D1         ; Divisor
00:000001A6 61000096        	   240:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   241: ;1
00:000001AA 2F00            	   242:     move.l  d0,-(SP)
00:000001AC 4EB803C0        	   243:     jsr     PrintHexAddress
00:000001B0 4EB80228        	   244:     jsr     new_line
00:000001B4 201F            	   245:     move.l  (SP)+,d0
                            	   246: 
00:000001B6 323C000A        	   247:     MOVE.W  #10,D1         ; Divisor
00:000001BA 61000082        	   248:     BSR     Div32x16       ; D0 = 0x186A0
                            	   249: ;2
00:000001BE 2F00            	   250:     move.l  d0,-(SP)
00:000001C0 4EB803C0        	   251:     jsr     PrintHexAddress
00:000001C4 4EB80228        	   252:     jsr     new_line
00:000001C8 201F            	   253:     move.l  (SP)+,d0
                            	   254: 
                            	   255:     ;(BAUD/10)
00:000001CA 2F00            	   256:     move.l  d0,-(SP)
                            	   257: ;3
00:000001CC 7000            	   258:     CLR.L   D0
00:000001CE 30390008100C    	   259:     MOVE.W  CurrentBaudRate,D0
00:000001D4 2F00            	   260:     move.l  d0,-(SP)
00:000001D6 4EB803C0        	   261:     jsr     PrintHexAddress
00:000001DA 4EB80228        	   262:     jsr     new_line
00:000001DE 201F            	   263:     move.l  (SP)+,d0
                            	   264: 
00:000001E0 123C000A        	   265:     MOVE.B  #10,D1
00:000001E4 6158            	   266:     BSR     Div32x16
                            	   267: 
                            	   268: ;4
00:000001E6 2F00            	   269:     move.l  d0,-(SP)
00:000001E8 4EB803C0        	   270:     jsr     PrintHexAddress
00:000001EC 4EB80228        	   271:     jsr     new_line
00:000001F0 221F            	   272:     move.l  (SP)+,D1
00:000001F2 201F            	   273:     move.l  (SP)+,D0
                            	   274: 
                            	   275: 
                            	   276:     ;(F_CPU/BAUD)
00:000001F4 6148            	   277:     BSR     Div32x16
                            	   278: ;5
00:000001F6 2F00            	   279:     move.l  d0,-(SP)
00:000001F8 4EB803C0        	   280:     jsr     PrintHexAddress
00:000001FC 4EB80228        	   281:     jsr     new_line
00:00000200 201F            	   282:     move.l  (SP)+,d0
                            	   283: 
                            	   284:     ; 4. Separa parte alta/baixa corretamente
00:00000202 3200            	   285:     MOVE.W  D0,D1
00:00000204 024000FF        	   286:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000208 E049            	   287:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:0000020A 024100FF        	   288:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   289: 
                            	   290:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:0000020E 41F900081012    	   291:     LEA     Baud1DivL,A0
00:00000214 3080            	   292:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000216 41F900081014    	   293:     LEA     Baud1DivH,A0
00:0000021C 3081            	   294:     MOVE.W  D1,(A0)
                            	   295: 
00:0000021E 6000FE4C        	   296:     BRA     MenuLoop
00:00000222 4E75            	   297:     RTS
                            	   298: .BaudError:
00:00000224 6000FDE2        	   299:     BRA     _start
                            	   300: 
                            	   301: new_line:
00:00000228 2F00            	   302:         MOVE.L  D0,-(SP)          ; Salva D0
00:0000022A 103C000A        	   303:         MOVE.B  #10,D0
00:0000022E 4EB80134        	   304:         JSR     UART_WriteChar
00:00000232 103C000D        	   305:         MOVE.B  #13,D0
00:00000236 4EB80134        	   306:         JSR     UART_WriteChar
00:0000023A 201F            	   307:         MOVE.L  (SP)+,D0          ; Restaura D0
00:0000023C 4E75            	   308:         RTS
                            	   309: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   310: ; Retorna D0 = Quociente, D1 = Resto
                            	   311: Div32x16:
00:0000023E 7400            	   312:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000240 761F            	   313:     MOVEQ   #31,D3      ; 32 iterações
                            	   314: DivLoop:
00:00000242 E388            	   315:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:00000244 E392            	   316:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000246 B441            	   317:     CMP.W   D1,D2       ; D2 >= D1?
00:00000248 6D04            	   318:     BLT     .skip
00:0000024A 9441            	   319:     SUB.W   D1,D2       ; Sim, subtrai
00:0000024C 5280            	   320:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   321: .skip:
00:0000024E 51CBFFF2        	   322:     DBRA    D3,DivLoop  ; Repete
00:00000252 2202            	   323:     MOVE.L  D2,D1       ; Resto em D1
00:00000254 4E75            	   324:     RTS
                            	   325: ; Versão compacta sem stack frame
                            	   326: PrintHexFast:
00:00000256 2F02            	   327:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000258 2F00            	   328:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:0000025A 7407            	   329:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   330: 
                            	   331: .Loop:
00:0000025C 2017            	   332:     MOVE.L  (SP),D0           ; Recupera valor original
00:0000025E E998            	   333:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000260 2E80            	   334:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000262 0200000F        	   335:     ANDI.B  #$F,D0            ; Isola nibble
                            	   336: 
00:00000266 B03C0009        	   337:     CMP.B   #9,D0
00:0000026A 6302            	   338:     BLS     .Digit
00:0000026C 5E00            	   339:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   340: .Digit:
00:0000026E D03C0030        	   341:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000272 4EB80134        	   342:     JSR     UART_WriteChar    ; Envia caractere
                            	   343: 
00:00000276 51CAFFE4        	   344:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   345: 
00:0000027A 588F            	   346:     ADDQ.L  #4,SP             ; Remove valor salvo
00:0000027C 241F            	   347:     MOVE.L  (SP)+,D2          ; Restaura D2
00:0000027E 4E75            	   348:     RTS
                            	   349: 
                            	   350: ; ----------------------------------------------------------------------
                            	   351: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   352: ; Entrada:
                            	   353: ;   D0.L = Valor a ser impresso (32 bits)
                            	   354: ;   D1.W = Número de dígitos (1-8)
                            	   355: ; ----------------------------------------------------------------------
                            	   356: PrintHexPRECISA_DE_REVISAO:
00:00000280 4E56FFF8        	   357:     LINK    A6,#-8            ; Reserva espaço na pilha
00:00000284 2F02            	   358:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000286 2D40FFFC        	   359:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:0000028A 3D41FFFA        	   360:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   361: 
00:0000028E 323C0008        	   362:     MOVE.W  #$0008,D1
                            	   363: 
                            	   364:     ; Ajusta para começar pelo dígito mais significativo
00:00000292 E549            	   365:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:00000294 5941            	   366:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   367: 
                            	   368: .PrintLoop:
00:00000296 202EFFFC        	   369:     MOVE.L  -4(A6),D0         ; Recupera valor
00:0000029A 3401            	   370:     MOVE.W  D1,D2             ; Posição do nibble
00:0000029C E5B8            	   371:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:0000029E 02800000000F    	   372:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   373: 
                            	   374:     ; Converte para ASCII
00:000002A4 B03C0009        	   375:     CMP.B   #9,D0
00:000002A8 6302            	   376:     BLS     .Decimal
00:000002AA 5E00            	   377:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   378: .Decimal:
00:000002AC D03C0030        	   379:     ADD.B   #'0',D0           ; Converte para caractere
                            	   380: 
                            	   381:     ; Imprime caractere
00:000002B0 4EB80134        	   382:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   383: 
00:000002B4 5941            	   384:     SUBQ.W  #4,D1             ; Próximo nibble
00:000002B6 6ADE            	   385:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   386: 
                            	   387:     ; Espaço final para separação
00:000002B8 103C0020        	   388:     MOVE.B  #' ',D0
00:000002BC 4EB80134        	   389:     JSR     UART_WriteChar
                            	   390: 
00:000002C0 241F            	   391:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000002C2 4E5E            	   392:     UNLK    A6                ; Restaura frame
00:000002C4 4E75            	   393:     RTS
                            	   394: ; ----------------------------------------------------------------------
                            	   395: ; Exemplo de uso:
                            	   396: ; ----------------------------------------------------------------------
                            	   397: SetupDivisor:
00:000002C6 303C2580        	   398:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000002CA 6100FED0        	   399:     BSR     CalcBaudDiv
                            	   400: 
                            	   401:     ; Agora pode acessar os valores na RAM:
00:000002CE 41F90008100E    	   402:     LEA     BaudDivL,A0
00:000002D4 1010            	   403:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000002D6 41F900081010    	   404:     LEA     BaudDivH,A0
00:000002DC 1210            	   405:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   406: 
                            	   407:     ; (Aqui você configuraria os registradores da UART)
00:000002DE 4E75            	   408:     RTS
                            	   409: ; ----------------------------------------------------------------------
                            	   410: ; MemDump - Imprime dump de memória formatado
                            	   411: ; Entrada:
                            	   412: ;   A0 = Endereço inicial (ex: $80000)
                            	   413: ;   D0 = Quantidade de bytes (ex: 256)
                            	   414: ; ----------------------------------------------------------------------
                            	   415: MemDump:
00:000002E0 41F90000000D    	   416:     LEA     DumpHeader,A0
00:000002E6 4EB80188        	   417:     JSR     UART_WriteString
00:000002EA 207900081016    	   418:     MOVE.L  (addressInHex),A0
00:000002F0 2008            	   419:     MOVE.L  A0,D0
00:000002F2 4EB803C0        	   420:     JSR     PrintHexAddress
00:000002F6 4EB80228        	   421:     JSR     new_line
                            	   422: 
00:000002FA 41F900000020    	   423:     LEA     DumpHeader1,A0
00:00000300 4EB80188        	   424:     JSR     UART_WriteString
                            	   425: 
00:00000304 207900081016    	   426:     MOVE.L  (addressInHex),A0
                            	   427:     ; Calcula endereço final
                            	   428: 
                            	   429: DUMPLOOPMASTER:
00:0000030A 7200            	   430:     CLR.L   D1
00:0000030C 2208            	   431:     MOVE.L  A0,D1
00:0000030E 0681000000FF    	   432:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   433:     ;MOVE.L  D1,D0
                            	   434:     ;JSR     PrintHexAddress
                            	   435:     ;JSR     new_line
                            	   436: 
                            	   437:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   438:     ;JSR     UART_ReadChar
                            	   439: 
                            	   440: 
                            	   441: DumpLoop:
                            	   442:     ; Nova linha a cada 16 bytes
00:00000314 2008            	   443:     MOVE.L  A0,D0
00:00000316 02800000000F    	   444:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000031C 6616            	   445:     BNE     NoNewLine
                            	   446: 
                            	   447:     ; Imprime endereço
00:0000031E 2008            	   448:     MOVE.L  A0,D0
00:00000320 4EB803C0        	   449:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   450: 
00:00000324 103C003A        	   451:     MOVE.B  #':',D0
00:00000328 4EB80134        	   452:     JSR     UART_WriteChar
00:0000032C 103C0020        	   453:     MOVE.B  #' ',D0
00:00000330 4EB80134        	   454:     JSR     UART_WriteChar
                            	   455: 
                            	   456: NoNewLine:
                            	   457:     ; Imprime byte em hex
00:00000334 1018            	   458:     MOVE.B  (A0)+,D0
00:00000336 4EB803D0        	   459:     JSR     PrintByteHex
                            	   460: 
00:0000033A 103C0020        	   461:     MOVE.B  #' ',D0
00:0000033E 4EB80134        	   462:     JSR     UART_WriteChar
                            	   463: 
                            	   464:     ; Verifica fim da linha (16 bytes)
00:00000342 2008            	   465:     MOVE.L  A0,D0
00:00000344 02800000000F    	   466:     ANDI.L  #$0000000F,D0
00:0000034A 664E            	   467:     BNE     NoEndLine
                            	   468: 
                            	   469:     ; Imprime caracteres ASCII
00:0000034C 103C0020        	   470:     MOVE.B  #' ',D0
00:00000350 4EB80134        	   471:     JSR     UART_WriteChar
00:00000354 103C007C        	   472:     MOVE.B  #'|',D0
00:00000358 4EB80134        	   473:     JSR     UART_WriteChar
                            	   474: 
00:0000035C 43E8FFF0        	   475:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000360 740F            	   476:     MOVEQ   #15,D2            ; 16 caracteres
                            	   477: 
                            	   478: AsciiLoop:
00:00000362 1019            	   479:     MOVE.B  (A1)+,D0
00:00000364 B03C0020        	   480:     CMP.B   #32,D0            ; Verifica se é imprimível
00:00000368 6D0C            	   481:     BLT     NonPrintable
00:0000036A B03C007E        	   482:     CMP.B   #126,D0
00:0000036E 6E06            	   483:     BGT     NonPrintable
                            	   484: 
00:00000370 4EB80134        	   485:     JSR     UART_WriteChar
00:00000374 6008            	   486:     BRA     NextAscii
                            	   487: 
                            	   488: NonPrintable:
00:00000376 103C002E        	   489:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000037A 4EB80134        	   490:     JSR     UART_WriteChar
                            	   491: 
                            	   492: NextAscii:
00:0000037E 51CAFFE2        	   493:     DBRA    D2,AsciiLoop
                            	   494: 
00:00000382 103C007C        	   495:     MOVE.B  #'|',D0
00:00000386 4EB80134        	   496:     JSR     UART_WriteChar
00:0000038A 103C000D        	   497:     MOVE.B  #13,D0            ; CR
00:0000038E 4EB80134        	   498:     JSR     UART_WriteChar
00:00000392 103C000A        	   499:     MOVE.B  #10,D0            ; LF
00:00000396 4EB80134        	   500:     JSR     UART_WriteChar
                            	   501: 
                            	   502: NoEndLine:
                            	   503:     ; Verifica fim do dump
00:0000039A B1C1            	   504:     CMP.L   D1,A0
00:0000039C 6300FF76        	   505:     BLS     DumpLoop
                            	   506: 
00:000003A0 2F08            	   507:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003A2 41F9000003EF    	   508:     LEA     HitAnyKey,A0
00:000003A8 4EB80188        	   509:     JSR     UART_WriteString
00:000003AC 4EB8014E        	   510:     JSR     UART_ReadChar
00:000003B0 B03C001B        	   511:     CMP.B   #$1B,D0
00:000003B4 6706            	   512:     BEQ     .fim
                            	   513: 
00:000003B6 205F            	   514:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000003B8 6000FF50        	   515:     BRA     DUMPLOOPMASTER
                            	   516: .fim
00:000003BC 6000FCAE        	   517:     BRA     MenuLoop
                            	   518: 
                            	   519: ; ----------------------------------------------------------------------
                            	   520: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   521: ; Entrada: D0 = endereço
                            	   522: ; ----------------------------------------------------------------------
                            	   523: PrintHexAddress:
00:000003C0 4840            	   524:     SWAP    D0                ; Imprime parte alta primeiro
00:000003C2 4EB803C8        	   525:     JSR     PrintWordHex
00:000003C6 4840            	   526:     SWAP    D0                ; Parte baixa
                            	   527:     ; Continua para PrintWordHex
                            	   528: 
                            	   529: ; ----------------------------------------------------------------------
                            	   530: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   531: ; Entrada: D0.w = valor
                            	   532: ; ----------------------------------------------------------------------
                            	   533: PrintWordHex:
00:000003C8 E158            	   534:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003CA 4EB803D0        	   535:     JSR     PrintByteHex
00:000003CE E058            	   536:     ROR.W   #8,D0             ; Byte menos significativo
                            	   537:     ; Continua para PrintByteHex
                            	   538: 
                            	   539: ; ----------------------------------------------------------------------
                            	   540: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   541: ; Entrada: D0.b = valor
                            	   542: ; ----------------------------------------------------------------------
                            	   543: PrintByteHex:
00:000003D0 1F00            	   544:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000003D2 E808            	   545:     LSR.B   #4,D0             ; Nibble alto
00:000003D4 6106            	   546:     BSR     PrintNibble
00:000003D6 101F            	   547:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000003D8 0200000F        	   548:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   549:     ; Continua para PrintNibble
                            	   550: ; ----------------------------------------------------------------------
                            	   551: ; PrintNibble - Imprime um nibble em hex
                            	   552: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   553: ; ----------------------------------------------------------------------
                            	   554: PrintNibble:
00:000003DC B03C0009        	   555:     CMP.B   #9,D0
00:000003E0 6302            	   556:     BLS     .Decimal
00:000003E2 5E00            	   557:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   558: .Decimal:
00:000003E4 D03C0030        	   559:     ADD.B   #'0',D0
00:000003E8 4EF80134        	   560:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   561: 
                            	   562: ClearRAM:
00:000003EC 41F900080000    	   563:     LEA     $80000,A0
00:000003F2 43F90008FFFF    	   564:     LEA     $8FFFF,A1
00:000003F8 7000            	   565:     MOVEQ   #0,D0
                            	   566: .ClearLoop:
00:000003FA 20C0            	   567:     MOVE.L  D0,(A0)+
00:000003FC B3C8            	   568:     CMPA.L  A0,A1
00:000003FE 62FA            	   569:     BHI     .ClearLoop
00:00000400 4E75            	   570:     RTS
                            	   571: ; ----------------------------------------------------------------------
                            	   572: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   573: ; ----------------------------------------------------------------------
                            	   574: ClearRAM1:
00:00000402 41F900080000    	   575:     LEA     $80000,A0        ; Endereço inicial da RAM
00:00000408 43F900100000    	   576:     LEA     $100000,A1       ; Endereço final + 1
00:0000040E 7000            	   577:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   578: 
                            	   579:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000410 2209            	   580:     MOVE.L  A1,D1
00:00000412 9288            	   581:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   582: 
                            	   583:     ; Otimização: escreve longs (32 bits) quando possível
00:00000414 2401            	   584:     MOVE.L  D1,D2
00:00000416 028200000003    	   585:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:0000041C 670C            	   586:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   587: 
                            	   588:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:0000041E 5382            	   589:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   590: .ResidualLoop:
00:00000420 10C0            	   591:     MOVE.B  D0,(A0)+
00:00000422 51CAFFFC        	   592:     DBRA    D2,.ResidualLoop
                            	   593: 
                            	   594:     ; Atualiza tamanho restante
00:00000426 9282            	   595:     SUB.L   D2,D1
00:00000428 5381            	   596:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   597: 
                            	   598: .ClearLongs:
00:0000042A E489            	   599:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:0000042C 5381            	   600:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   601: 
                            	   602: .LongLoop:
00:0000042E 20C0            	   603:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000430 51C9FFFC        	   604:     DBRA    D1,.LongLoop
00:00000434 4E75            	   605:     RTS
