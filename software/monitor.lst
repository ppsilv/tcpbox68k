                            	   248: ; ----------------------------------------------------------------------
                            	   249: ; Constantes
                            	   250: ; ----------------------------------------------------------------------
                            	   251: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   252: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   253:                               ; BAUD_DIV_L em $70000
                            	   254:                               ; BAUD_DIV_U em $70001
                            	   255: 
                            	   256: ; ----------------------------------------------------------------------
                            	   257: ; Rotina: Calcula e armazena divisor de baud rate
                            	   258: ; Entrada:
                            	   259: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   260: ; Saída:
                            	   261: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   262: ; Formulas:
                            	   263: ;
                            	   264: ;
                            	   265: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   266: ; ----------------------------------------------------------------------
                            	   267: 
                            	   268: CALCBAUDDIV:
                            	   269: ;[ Registrador D0 (32 bits) ]
                            	   270: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   271: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   272:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   273:         ;((F_CPU/16)/10)
                            	   274:         ;F_CPU = 16000000 ou 0xF42400
00:000001D6 203C00F42400    	   275:         MOVE.L  #F_CPU,D0
00:000001DC 323C0010        	   276:         MOVE.W  #16,D1         ; Divisor
00:000001E0 61000096        	   277:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   278: ;1
00:000001E4 2F00            	   279:         move.l  d0,-(SP)
00:000001E6 4EB803E0        	   280:         jsr     PrintHexAddress
00:000001EA 4EB80262        	   281:         jsr     new_line
00:000001EE 201F            	   282:         move.l  (SP)+,d0
                            	   283: 
00:000001F0 323C000A        	   284:         MOVE.W  #10,D1         ; Divisor
00:000001F4 61000082        	   285:         BSR     Div32x16       ; D0 = 0x186A0
                            	   286: ;2
00:000001F8 2F00            	   287:         move.l  d0,-(SP)
00:000001FA 4EB803E0        	   288:         jsr     PrintHexAddress
00:000001FE 4EB80262        	   289:         jsr     new_line
00:00000202 201F            	   290:         move.l  (SP)+,d0
                            	   291: 
                            	   292:         ;(BAUD/10)
00:00000204 2F00            	   293:         move.l  d0,-(SP)
                            	   294: ;3
00:00000206 7000            	   295:         CLR.L   D0
00:00000208 30390008100C    	   296:         MOVE.W  CurrentBaudRate,D0
00:0000020E 2F00            	   297:         move.l  d0,-(SP)
00:00000210 4EB803E0        	   298:         jsr     PrintHexAddress
00:00000214 4EB80262        	   299:         jsr     new_line
00:00000218 201F            	   300:         move.l  (SP)+,d0
                            	   301: 
00:0000021A 123C000A        	   302:         MOVE.B  #10,D1
00:0000021E 6158            	   303:         BSR     Div32x16
                            	   304: 
                            	   305: ;4
00:00000220 2F00            	   306:         move.l  d0,-(SP)
00:00000222 4EB803E0        	   307:         jsr     PrintHexAddress
00:00000226 4EB80262        	   308:         jsr     new_line
00:0000022A 221F            	   309:         move.l  (SP)+,D1
00:0000022C 201F            	   310:         move.l  (SP)+,D0
                            	   311: 
                            	   312: 
                            	   313:         ;(F_CPU/BAUD)
00:0000022E 6148            	   314:         BSR     Div32x16
                            	   315: ;5
00:00000230 2F00            	   316:         move.l  d0,-(SP)
00:00000232 4EB803E0        	   317:         jsr     PrintHexAddress
00:00000236 4EB80262        	   318:         jsr     new_line
00:0000023A 201F            	   319:         move.l  (SP)+,d0
                            	   320: 
                            	   321:         ; 4. Separa parte alta/baixa corretamente
00:0000023C 3200            	   322:         MOVE.W  D0,D1
00:0000023E 024000FF        	   323:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000242 E049            	   324:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:00000244 024100FF        	   325:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   326: 
                            	   327:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000248 41F900081012    	   328:         LEA     Baud1DivL,A0
00:0000024E 3080            	   329:         MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000250 41F900081014    	   330:         LEA     Baud1DivH,A0
00:00000256 3081            	   331:         MOVE.W  D1,(A0)
                            	   332: 
00:00000258 6000FE2E        	   333:         BRA     MenuLoop
00:0000025C 4E75            	   334:         RTS
                            	   335: .BaudError:
00:0000025E 6000FDC0        	   336:         BRA     _start
                            	   337: 
                            	   338: new_line:
00:00000262 2F00            	   339:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000264 103C000A        	   340:         MOVE.B  #10,D0
00:00000268 4EB80172        	   341:         JSR     UART_WriteChar
00:0000026C 103C000D        	   342:         MOVE.B  #13,D0
00:00000270 4EB80172        	   343:         JSR     UART_WriteChar
00:00000274 201F            	   344:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000276 4E75            	   345:         RTS
                            	   346: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   347: ; Retorna D0 = Quociente, D1 = Resto
                            	   348: Div32x16:
00:00000278 7400            	   349:         MOVEQ   #0,D2       ; D2 = Quociente
00:0000027A 761F            	   350:         MOVEQ   #31,D3      ; 32 iterações
                            	   351: DivLoop:
00:0000027C E388            	   352:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000027E E392            	   353:         ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000280 B441            	   354:         CMP.W   D1,D2       ; D2 >= D1?
00:00000282 6D04            	   355:         BLT     .skip
00:00000284 9441            	   356:         SUB.W   D1,D2       ; Sim, subtrai
00:00000286 5280            	   357:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   358: .skip:
00:00000288 51CBFFF2        	   359:         DBRA    D3,DivLoop  ; Repete
00:0000028C 2202            	   360:         MOVE.L  D2,D1       ; Resto em D1
00:0000028E 4E75            	   361:         RTS
                            	   362: ; Versão compacta sem stack frame
                            	   363: PrintHexFast:
00:00000290 2F02            	   364:         MOVE.L  D2,-(SP)          ; Salva D2
00:00000292 2F00            	   365:         MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000294 7407            	   366:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   367: 
                            	   368: .Loop:
00:00000296 2017            	   369:         MOVE.L  (SP),D0           ; Recupera valor original
00:00000298 E998            	   370:         ROL.L   #4,D0             ; Pega próximo nibble
00:0000029A 2E80            	   371:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:0000029C 0200000F        	   372:         ANDI.B  #$F,D0            ; Isola nibble
                            	   373: 
00:000002A0 B03C0009        	   374:         CMP.B   #9,D0
00:000002A4 6302            	   375:         BLS     .Digit
00:000002A6 5E00            	   376:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   377: .Digit:
00:000002A8 D03C0030        	   378:         ADD.B   #'0',D0           ; Converte para ASCII
00:000002AC 4EB80172        	   379:         JSR     UART_WriteChar    ; Envia caractere
                            	   380: 
00:000002B0 51CAFFE4        	   381:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   382: 
00:000002B4 588F            	   383:         ADDQ.L  #4,SP             ; Remove valor salvo
00:000002B6 241F            	   384:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002B8 4E75            	   385:         RTS
