                            	   544: ; ----------------------------------------------------------------------
                            	   545: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   546: ; Entrada: D0 = endereço
                            	   547: ; ----------------------------------------------------------------------
                            	   548: PrintHexAddress:
00:000003F4 4840            	   549:         SWAP    D0                ; Imprime parte alta primeiro
00:000003F6 4EB803FC        	   550:         JSR     PrintWordHex
00:000003FA 4840            	   551:         SWAP    D0                ; Parte baixa
                            	   552:         ; Continua para PrintWordHex
                            	   553: 
                            	   554: ; ----------------------------------------------------------------------
                            	   555: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   556: ; Entrada: D0.w = valor
                            	   557: ; ----------------------------------------------------------------------
                            	   558: PrintWordHex:
00:000003FC E158            	   559:         ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003FE 4EB80404        	   560:         JSR     PrintByteHex
00:00000402 E058            	   561:         ROR.W   #8,D0             ; Byte menos significativo
                            	   562:         ; Continua para PrintByteHex
                            	   563: 
                            	   564: ; ----------------------------------------------------------------------
                            	   565: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   566: ; Entrada: D0.b = valor
                            	   567: ; ----------------------------------------------------------------------
                            	   568: PrintByteHex:
00:00000404 1F00            	   569:         MOVE.B  D0,-(SP)          ; Salva byte original
00:00000406 E808            	   570:         LSR.B   #4,D0             ; Nibble alto
00:00000408 6106            	   571:         BSR     PrintNibble
00:0000040A 101F            	   572:         MOVE.B  (SP)+,D0          ; Recupera byte
00:0000040C 0200000F        	   573:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   574:         ; Continua para PrintNibble
                            	   575: ; ----------------------------------------------------------------------
                            	   576: ; PrintNibble - Imprime um nibble em hex
                            	   577: ; Entrada: D0.b bits 3-0 = nibble (0-15)
