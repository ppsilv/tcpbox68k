00:00000644 323900081022    	   844:         MOVE.W  BUFFER_HEAD,D1
00:0000064A D0C1            	   845:         ADD     D1,A0
00:0000064C 1080            	   846:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   847: 
00:0000064E 5441            	   848:         ADD     #2,D1              ; Incrementa como word
00:00000650 024100FF        	   849:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000654 33C100081022    	   850:         MOVE.W  D1,BUFFER_HEAD
                            	   851: 
00:0000065A 52790008102A    	   852:         ADDQ.W  #1,BUFFER_COUNT
                            	   853: 
