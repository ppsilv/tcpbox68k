                            	   322: ; ----------------------------------------------------------------------
                            	   323: ; Constantes
                            	   324: ; ----------------------------------------------------------------------
                            	   325: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   326: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   327:                               ; BAUD_DIV_L em $70000
                            	   328:                               ; BAUD_DIV_U em $70001
                            	   329: 
                            	   330: ; ----------------------------------------------------------------------
                            	   331: ; Rotina: Calcula e armazena divisor de baud rate
                            	   332: ; Entrada:
                            	   333: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   334: ; Saída:
                            	   335: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   336: ; Formulas:
                            	   337: ;
                            	   338: ;
                            	   339: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   340: ; ----------------------------------------------------------------------
                            	   341: 
                            	   342: CalcBaudDiv:
                            	   343: ;[ Registrador D0 (32 bits) ]
                            	   344: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   345: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   346:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   347:     ;((F_CPU/16)/10)
                            	   348:     ;F_CPU = 16000000 ou 0xF42400
00:0000028C 203C00F42400    	   349:     MOVE.L  #F_CPU,D0
00:00000292 323C0010        	   350:     MOVE.W  #16,D1         ; Divisor
00:00000296 61000096        	   351:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   352: ;1
00:0000029A 2F00            	   353:     move.l  d0,-(SP)
00:0000029C 4EB804B0        	   354:     jsr     PrintHexAddress
00:000002A0 4EB80318        	   355:     jsr     new_line
00:000002A4 201F            	   356:     move.l  (SP)+,d0
                            	   357: 
00:000002A6 323C000A        	   358:     MOVE.W  #10,D1         ; Divisor
00:000002AA 61000082        	   359:     BSR     Div32x16       ; D0 = 0x186A0
                            	   360: ;2
00:000002AE 2F00            	   361:     move.l  d0,-(SP)
00:000002B0 4EB804B0        	   362:     jsr     PrintHexAddress
00:000002B4 4EB80318        	   363:     jsr     new_line
00:000002B8 201F            	   364:     move.l  (SP)+,d0
                            	   365: 
                            	   366:     ;(BAUD/10)
00:000002BA 2F00            	   367:     move.l  d0,-(SP)
                            	   368: ;3
00:000002BC 7000            	   369:     CLR.L   D0
00:000002BE 30390008100C    	   370:     MOVE.W  CurrentBaudRate,D0
00:000002C4 2F00            	   371:     move.l  d0,-(SP)
00:000002C6 4EB804B0        	   372:     jsr     PrintHexAddress
00:000002CA 4EB80318        	   373:     jsr     new_line
00:000002CE 201F            	   374:     move.l  (SP)+,d0
                            	   375: 
00:000002D0 123C000A        	   376:     MOVE.B  #10,D1
00:000002D4 6158            	   377:     BSR     Div32x16
                            	   378: 
                            	   379: ;4
00:000002D6 2F00            	   380:     move.l  d0,-(SP)
00:000002D8 4EB804B0        	   381:     jsr     PrintHexAddress
00:000002DC 4EB80318        	   382:     jsr     new_line
00:000002E0 221F            	   383:     move.l  (SP)+,D1
00:000002E2 201F            	   384:     move.l  (SP)+,D0
                            	   385: 
                            	   386: 
                            	   387:     ;(F_CPU/BAUD)
00:000002E4 6148            	   388:     BSR     Div32x16
                            	   389: ;5
00:000002E6 2F00            	   390:     move.l  d0,-(SP)
00:000002E8 4EB804B0        	   391:     jsr     PrintHexAddress
00:000002EC 4EB80318        	   392:     jsr     new_line
00:000002F0 201F            	   393:     move.l  (SP)+,d0
                            	   394: 
                            	   395:     ; 4. Separa parte alta/baixa corretamente
00:000002F2 3200            	   396:     MOVE.W  D0,D1
00:000002F4 024000FF        	   397:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000002F8 E049            	   398:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000002FA 024100FF        	   399:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   400: 
                            	   401:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000002FE 41F900081012    	   402:     LEA     Baud1DivL,A0
00:00000304 3080            	   403:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000306 41F900081014    	   404:     LEA     Baud1DivH,A0
00:0000030C 3081            	   405:     MOVE.W  D1,(A0)
                            	   406: 
00:0000030E 6000FD74        	   407:     BRA     MenuLoop
00:00000312 4E75            	   408:     RTS
                            	   409: .BaudError:
00:00000314 6000FD0A        	   410:     BRA     _start
                            	   411: 
                            	   412: new_line:
00:00000318 2F00            	   413:         MOVE.L  D0,-(SP)          ; Salva D0
00:0000031A 103C000A        	   414:         MOVE.B  #10,D0
00:0000031E 4EB80228        	   415:         JSR     UART_WriteChar
00:00000322 103C000D        	   416:         MOVE.B  #13,D0
00:00000326 4EB80228        	   417:         JSR     UART_WriteChar
00:0000032A 201F            	   418:         MOVE.L  (SP)+,D0          ; Restaura D0
00:0000032C 4E75            	   419:         RTS
                            	   420: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   421: ; Retorna D0 = Quociente, D1 = Resto
                            	   422: Div32x16:
00:0000032E 7400            	   423:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000330 761F            	   424:     MOVEQ   #31,D3      ; 32 iterações
                            	   425: DivLoop:
00:00000332 E388            	   426:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:00000334 E392            	   427:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000336 B441            	   428:     CMP.W   D1,D2       ; D2 >= D1?
00:00000338 6D04            	   429:     BLT     .skip
00:0000033A 9441            	   430:     SUB.W   D1,D2       ; Sim, subtrai
00:0000033C 5280            	   431:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   432: .skip:
00:0000033E 51CBFFF2        	   433:     DBRA    D3,DivLoop  ; Repete
00:00000342 2202            	   434:     MOVE.L  D2,D1       ; Resto em D1
00:00000344 4E75            	   435:     RTS
                            	   436: ; Versão compacta sem stack frame
                            	   437: PrintHexFast:
00:00000346 2F02            	   438:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000348 2F00            	   439:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:0000034A 7407            	   440:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   441: 
                            	   442: .Loop:
00:0000034C 2017            	   443:     MOVE.L  (SP),D0           ; Recupera valor original
00:0000034E E998            	   444:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000350 2E80            	   445:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000352 0200000F        	   446:     ANDI.B  #$F,D0            ; Isola nibble
                            	   447: 
00:00000356 B03C0009        	   448:     CMP.B   #9,D0
00:0000035A 6302            	   449:     BLS     .Digit
00:0000035C 5E00            	   450:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   451: .Digit:
00:0000035E D03C0030        	   452:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000362 4EB80228        	   453:     JSR     UART_WriteChar    ; Envia caractere
                            	   454: 
00:00000366 51CAFFE4        	   455:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   456: 
00:0000036A 588F            	   457:     ADDQ.L  #4,SP             ; Remove valor salvo
00:0000036C 241F            	   458:     MOVE.L  (SP)+,D2          ; Restaura D2
00:0000036E 4E75            	   459:     RTS
                            	   460: 
                            	   461: ; ----------------------------------------------------------------------
                            	   462: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   463: ; Entrada:
                            	   464: ;   D0.L = Valor a ser impresso (32 bits)
                            	   465: ;   D1.W = Número de dígitos (1-8)
                            	   466: ; ----------------------------------------------------------------------
                            	   467: PrintHexPRECISA_DE_REVISAO:
00:00000370 4E56FFF8        	   468:     LINK    A6,#-8            ; Reserva espaço na pilha
00:00000374 2F02            	   469:     MOVE.L  D2,-(SP)          ; Salva D2
00:00000376 2D40FFFC        	   470:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:0000037A 3D41FFFA        	   471:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   472: 
00:0000037E 323C0008        	   473:     MOVE.W  #$0008,D1
                            	   474: 
                            	   475:     ; Ajusta para começar pelo dígito mais significativo
00:00000382 E549            	   476:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:00000384 5941            	   477:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   478: 
                            	   479: .PrintLoop:
00:00000386 202EFFFC        	   480:     MOVE.L  -4(A6),D0         ; Recupera valor
00:0000038A 3401            	   481:     MOVE.W  D1,D2             ; Posição do nibble
00:0000038C E5B8            	   482:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:0000038E 02800000000F    	   483:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   484: 
                            	   485:     ; Converte para ASCII
00:00000394 B03C0009        	   486:     CMP.B   #9,D0
00:00000398 6302            	   487:     BLS     .Decimal
00:0000039A 5E00            	   488:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   489: .Decimal:
00:0000039C D03C0030        	   490:     ADD.B   #'0',D0           ; Converte para caractere
                            	   491: 
                            	   492:     ; Imprime caractere
00:000003A0 4EB80228        	   493:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   494: 
00:000003A4 5941            	   495:     SUBQ.W  #4,D1             ; Próximo nibble
00:000003A6 6ADE            	   496:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   497: 
                            	   498:     ; Espaço final para separação
00:000003A8 103C0020        	   499:     MOVE.B  #' ',D0
00:000003AC 4EB80228        	   500:     JSR     UART_WriteChar
                            	   501: 
00:000003B0 241F            	   502:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000003B2 4E5E            	   503:     UNLK    A6                ; Restaura frame
00:000003B4 4E75            	   504:     RTS
                            	   505: ; ----------------------------------------------------------------------
                            	   506: ; Exemplo de uso:
                            	   507: ; ----------------------------------------------------------------------
                            	   508: SetupDivisor:
00:000003B6 303C2580        	   509:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000003BA 6100FED0        	   510:     BSR     CalcBaudDiv
                            	   511: 
                            	   512:     ; Agora pode acessar os valores na RAM:
00:000003BE 41F90008100E    	   513:     LEA     BaudDivL,A0
00:000003C4 1010            	   514:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000003C6 41F900081010    	   515:     LEA     BaudDivH,A0
00:000003CC 1210            	   516:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   517: 
                            	   518:     ; (Aqui você configuraria os registradores da UART)
00:000003CE 4E75            	   519:     RTS
                            	   520: ; ----------------------------------------------------------------------
                            	   521: ; MemDump - Imprime dump de memória formatado
                            	   522: ; Entrada:
                            	   523: ;   A0 = Endereço inicial (ex: $80000)
                            	   524: ;   D0 = Quantidade de bytes (ex: 256)
                            	   525: ; ----------------------------------------------------------------------
                            	   526: MemDump:
00:000003D0 41F90000000D    	   527:     LEA     DumpHeader,A0
00:000003D6 4EB80278        	   528:     JSR     UART_WriteString
00:000003DA 207900081016    	   529:     MOVE.L  (addressInHex),A0
00:000003E0 2008            	   530:     MOVE.L  A0,D0
00:000003E2 4EB804B0        	   531:     JSR     PrintHexAddress
00:000003E6 4EB80318        	   532:     JSR     new_line
                            	   533: 
00:000003EA 41F900000020    	   534:     LEA     DumpHeader1,A0
00:000003F0 4EB80278        	   535:     JSR     UART_WriteString
                            	   536: 
00:000003F4 207900081016    	   537:     MOVE.L  (addressInHex),A0
                            	   538:     ; Calcula endereço final
                            	   539: 
                            	   540: DUMPLOOPMASTER:
00:000003FA 7200            	   541:     CLR.L   D1
00:000003FC 2208            	   542:     MOVE.L  A0,D1
00:000003FE 0681000000FF    	   543:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   544:     ;MOVE.L  D1,D0
                            	   545:     ;JSR     PrintHexAddress
                            	   546:     ;JSR     new_line
                            	   547: 
                            	   548:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   549:     ;JSR     UART_ReadChar
                            	   550: 
                            	   551: 
                            	   552: DumpLoop:
                            	   553:     ; Nova linha a cada 16 bytes
00:00000404 2008            	   554:     MOVE.L  A0,D0
00:00000406 02800000000F    	   555:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000040C 6616            	   556:     BNE     NoNewLine
                            	   557: 
                            	   558:     ; Imprime endereço
00:0000040E 2008            	   559:     MOVE.L  A0,D0
00:00000410 4EB804B0        	   560:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   561: 
00:00000414 103C003A        	   562:     MOVE.B  #':',D0
00:00000418 4EB80228        	   563:     JSR     UART_WriteChar
00:0000041C 103C0020        	   564:     MOVE.B  #' ',D0
00:00000420 4EB80228        	   565:     JSR     UART_WriteChar
                            	   566: 
                            	   567: NoNewLine:
                            	   568:     ; Imprime byte em hex
00:00000424 1018            	   569:     MOVE.B  (A0)+,D0
00:00000426 4EB804C0        	   570:     JSR     PrintByteHex
                            	   571: 
00:0000042A 103C0020        	   572:     MOVE.B  #' ',D0
00:0000042E 4EB80228        	   573:     JSR     UART_WriteChar
                            	   574: 
                            	   575:     ; Verifica fim da linha (16 bytes)
00:00000432 2008            	   576:     MOVE.L  A0,D0
00:00000434 02800000000F    	   577:     ANDI.L  #$0000000F,D0
00:0000043A 664E            	   578:     BNE     NoEndLine
                            	   579: 
                            	   580:     ; Imprime caracteres ASCII
00:0000043C 103C0020        	   581:     MOVE.B  #' ',D0
00:00000440 4EB80228        	   582:     JSR     UART_WriteChar
00:00000444 103C007C        	   583:     MOVE.B  #'|',D0
00:00000448 4EB80228        	   584:     JSR     UART_WriteChar
                            	   585: 
00:0000044C 43E8FFF0        	   586:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000450 740F            	   587:     MOVEQ   #15,D2            ; 16 caracteres
                            	   588: 
                            	   589: AsciiLoop:
00:00000452 1019            	   590:     MOVE.B  (A1)+,D0
00:00000454 B03C0020        	   591:     CMP.B   #32,D0            ; Verifica se é imprimível
00:00000458 6D0C            	   592:     BLT     NonPrintable
00:0000045A B03C007E        	   593:     CMP.B   #126,D0
00:0000045E 6E06            	   594:     BGT     NonPrintable
                            	   595: 
00:00000460 4EB80228        	   596:     JSR     UART_WriteChar
00:00000464 6008            	   597:     BRA     NextAscii
                            	   598: 
                            	   599: NonPrintable:
00:00000466 103C002E        	   600:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000046A 4EB80228        	   601:     JSR     UART_WriteChar
                            	   602: 
                            	   603: NextAscii:
00:0000046E 51CAFFE2        	   604:     DBRA    D2,AsciiLoop
                            	   605: 
00:00000472 103C007C        	   606:     MOVE.B  #'|',D0
00:00000476 4EB80228        	   607:     JSR     UART_WriteChar
00:0000047A 103C000D        	   608:     MOVE.B  #13,D0            ; CR
00:0000047E 4EB80228        	   609:     JSR     UART_WriteChar
00:00000482 103C000A        	   610:     MOVE.B  #10,D0            ; LF
00:00000486 4EB80228        	   611:     JSR     UART_WriteChar
                            	   612: 
                            	   613: NoEndLine:
                            	   614:     ; Verifica fim do dump
00:0000048A B1C1            	   615:     CMP.L   D1,A0
00:0000048C 6300FF76        	   616:     BLS     DumpLoop
                            	   617: 
00:00000490 2F08            	   618:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000492 41F9000003FA    	   619:     LEA     HitAnyKey,A0
00:00000498 4EB80278        	   620:     JSR     UART_WriteString
00:0000049C 4EB80242        	   621:     JSR     UART_ReadChar
00:000004A0 B03C001B        	   622:     CMP.B   #$1B,D0
00:000004A4 6706            	   623:     BEQ     .fim
                            	   624: 
00:000004A6 205F            	   625:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000004A8 6000FF50        	   626:     BRA     DUMPLOOPMASTER
                            	   627: .fim
00:000004AC 6000FBD6        	   628:     BRA     MenuLoop
