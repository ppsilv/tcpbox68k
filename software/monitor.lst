                            	   932: ;--------------------------------------------------
                            	   933: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   934: ;--------------------------------------------------
                            	   935: ; Exemplo: insere 'A' no buffer
                            	   936: ;          MOVE.B  #'A',D0
                            	   937: ;          JSR     UART_BufferPut
                            	   938: 
                            	   939: BufferPut:
00:000006C0 2F01            	   940:     MOVE.L  D1,-(SP)
00:000006C2 2F08            	   941:     MOVE.L  A0,-(SP)
                            	   942: 
                            	   943:     ;ANDI.W    #$FF00,D0
00:000006C4 41F900081024    	   944:     LEA     BUFFER,A0
00:000006CA 323900081022    	   945:     MOVE.W  BUFFER_COUNT,D1
                            	   946: 
00:000006D0 B27C0100        	   947:     CMP.W   #256,D1
00:000006D4 6C1C            	   948:     BGE     .BufferFull
                            	   949: 
                            	   950:     ; Modificado para usar deslocamento de 16 bits
00:000006D6 32390008101A    	   951:     MOVE.W  BUFFER_HEAD,D1
00:000006DC D0C1            	   952:     ADD     D1,A0
00:000006DE 1080            	   953:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   954: 
00:000006E0 5441            	   955:     ADD     #2,D1              ; Incrementa como word
00:000006E2 024100FF        	   956:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000006E6 33C10008101A    	   957:     MOVE.W  D1,BUFFER_HEAD
                            	   958: 
00:000006EC 527900081022    	   959:     ADDQ.W  #1,BUFFER_COUNT
                            	   960: 
                            	   961: .BufferFull:
00:000006F2 205F            	   962:     MOVE.L  (SP)+,A0
00:000006F4 221F            	   963:     MOVE.L  (SP)+,D1
                            	   964: 
00:000006F6 4E75            	   965:     RTS
                            	   966: 
                            	   967: ;--------------------------------------------------
                            	   968: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   969: ;--------------------------------------------------
                            	   970: ;Exemplo: Lendo byte do buffer
                            	   971: ;         BSR     UART_BufferGet
                            	   972: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   973: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   974: ;         Senão, D0 contém o byte lido!
                            	   975: BufferGet:
00:000006F8 2F01            	   976:     MOVE.L  D1,-(SP)
00:000006FA 2F08            	   977:     MOVE.L  A0,-(SP)
                            	   978: 
00:000006FC 323900081022    	   979:     MOVE.W  BUFFER_COUNT,D1
00:00000702 6724            	   980:     BEQ     .BufferEmpty
                            	   981: 
00:00000704 41F900081024    	   982:     LEA     BUFFER,A0
                            	   983: 
                            	   984:     ; Modificado para usar deslocamento de 16 bits
00:0000070A 32390008101E    	   985:     MOVE.W  BUFFER_TAIL,D1
00:00000710 10301000        	   986:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   987: 
00:00000714 5401            	   988:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000716 024100FF        	   989:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000071A 33C10008101E    	   990:     MOVE.W  D1,BUFFER_TAIL
                            	   991: 
00:00000720 537900081022    	   992:     SUBQ.W  #1,BUFFER_COUNT
00:00000726 6006            	   993:     BRA     .Exit
                            	   994: 
                            	   995: .BufferEmpty:
00:00000728 4EB80734        	   996:     JSR     FBufferEmpty
00:0000072C 70FF            	   997:     MOVEQ   #-1,D0
                            	   998: .Exit:
00:0000072E 205F            	   999:     MOVE.L  (SP)+,A0
00:00000730 221F            	  1000:     MOVE.L  (SP)+,D1
00:00000732 4E75            	  1001:     RTS
                            	  1002: 
                            	  1003: FBufferEmpty:
