00:00000534 B03C00FF        	   714:         CMP.B   #-1,D0          ; Buffer vazio?
00:00000538 6706            	   715:         BEQ     .fim      ; Se sim, ignora
00:0000053A 4EB801B0        	   716:         JSR     UART_WriteChar
00:0000053E 60F0            	   717:         BRA     .loop1
                            	   718: .fim:
00:00000540 241F            	   719:         MOVE.L  (SP)+,D2
00:00000542 221F            	   720:         MOVE.L  (SP)+,D1
