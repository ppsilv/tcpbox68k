                            	  1064: 
00:000007D8 4CDF7FFC        	  1065:         MOVEM.L (SP)+,D2-D7/A0-A6
00:000007DC 4E75            	  1066:         RTS
                            	  1067: ; ========================================================
                            	  1068: ; Validador de Checksum para ROM (MC68000)
                            	  1069: ; Assume:
                            	  1070: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1071: ;   - Big-endian (padrão 68000)
                            	  1072: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1073: ; ========================================================
                            	  1074: 
                            	  1075: VALIDATE_ROM:
00:000007DE 91C8            	  1076:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:000007E0 203C00003FFC    	  1077:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:000007E6 7200            	  1078:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1079: 
                            	  1080:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1081: .CHECKSUM_LOOP:
00:000007E8 2418            	  1082:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:000007EA D282            	  1083:         ADD.L   D2,D1               ; Soma ao acumulador
00:000007EC 5980            	  1084:         SUB.L   #4,D0               ; Decrementa contador
00:000007EE 6EF8            	  1085:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1086: 
00:000007F0 41F900081930    	  1087:         LEA     checksum_rom,A0
00:000007F6 20C1            	  1088:         MOVE.L  D1,(A0)+
                            	  1089:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1090: 
                            	  1091:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:000007F8 24383FFC        	  1092:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
00:000007FC B481            	  1093:         CMP.L   D1,D2               ; Combina com o calculado?
00:000007FE 6706            	  1094:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1095: 
                            	  1096:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000800 363CDEAD        	  1097:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000804 6002            	  1098:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1099: .CHECKSUM_OK:
00:00000806 4E75            	  1100:         RTS                         ; Retorna (ROM válida)
                            	  1101: 
                            	  1102: SYSTEM_HALT:
00:00000808 46FC0700        	  1103:         MOVE.W  #$0700,SR        ; Desabilita interrupções
                            	  1104: .INFINITE_LOOP:
00:0000080C 60FE            	  1105:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1106: 
                            	  1107: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1108: VALIDATE_ROM_CRC32:
00:0000080E 91C8            	  1109:         LEA     ROM_START,A0        ; Endereço inicial
00:00000810 203C00003FFC    	  1110:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
00:00000816 72FF            	  1111:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1112: 
                            	  1113: CRC_LOOP:
00:00000818 1418            	  1114:         MOVE.B  (A0)+,D2            ; Lê 1 byte
00:0000081A B501            	  1115:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1116: 
                            	  1117:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1118:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1119: 
00:0000081C 5380            	  1120:         SUBQ.L  #1,D0
00:0000081E 6EF8            	  1121:         BGT     CRC_LOOP
                            	  1122: 
00:00000820 4681            	  1123:         NOT.L   D1                  ; Inverte os bits no final
                            	  1124: 
                            	  1125:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:00000822 24383FFB        	  1126:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:00000826 B481            	  1127:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000828 6706            	  1128:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1129: 
                            	  1130:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:0000082A 363CDEAD        	  1131:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:0000082E 60D8            	  1132:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1133: .CHECKSUM_OK:
00:00000830 4E75            	  1134:         RTS
                            	  1135: 
                            	  1136: ; --- Constantes ---
                            	  1137: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1138: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1139: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1140: 
                            	  1141: Checksum:
00:00000832 00000000        	  1142:     DC.L    0               ; Temporariamente 0
                            	  1143:     ALIGN 2
                            	  1144: ; =====================================================================
                            	  1145: ; END XMODEM RECEIVER ROUTINE
                            	  1146: ; =====================================================================
