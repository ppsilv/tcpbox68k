                            	  1036: ;******************************************************************************************
                            	  1037:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1038:            ;     BRA     Send_ACK
                            	  1039: ;******************************************************************************************
                            	  1040: 
                            	  1041:         ; Calcula checksum local
                            	  1042:         ;LEA     xmodem_buffer,A1
                            	  1043:         ;MOVE.W  #127,D1
                            	  1044:         ;CLR.B   D3
                            	  1045: 
                            	  1046: Calc_Checksum:
                            	  1047:         ;ADD.B   (A1)+,D3
                            	  1048:         ;DBF     D1,Calc_Checksum;
                            	  1049: 
                            	  1050:         ;CMP.B   D2,D3
                            	  1051:         ;BNE     Send_NAK            ; Erro no checksum
                            	  1052: 
                            	  1053:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1054:         ;MOVE.B  block_number,D0
                            	  1055:         ;CMP.B   expected_block,D0
                            	  1056:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1057: 
                            	  1058:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1059:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1060:         ; Exemplo: copiar do buffer para a RAM
                            	  1061:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:000007D0 43F90008112C    	  1062:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:000007D6 24790008132E    	  1063:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:000007DC 7220            	  1064:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1065: Copy_Data:
00:000007DE 24D9            	  1066:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:000007E0 5381            	  1067:         SUBQ.L  #1,D1               ; Decrementa contador
00:000007E2 66FA            	  1068:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1069:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
00:000007E4 20390008132E    	  1070:         MOVE.L  usr_buffer_addr,D0
00:000007EA 068000000080    	  1071:         ADDI.L  #128,D0
00:000007F0 23C00008132E    	  1072:         MOVE.L  D0,usr_buffer_addr
                            	  1073: 
                            	  1074: 
                            	  1075: 
                            	  1076:         ; ---- 8. CONFIMA RECEPÇÃO ----
00:000007F6 52390008132D    	  1077:         ADDQ.B  #1,expected_block   ; Próximo bloco
00:000007FC 103C0006        	  1078:         MOVE.B  #ACK,D0
00:00000800 4EB8019A        	  1079:         JSR     UART_WriteChar
00:00000804 6000FF68        	  1080:         BRA     Receive_Loop
                            	  1081: 
