                            	   185: 
                            	   186: UART_INIT:
00:00000172 227900081010    	   187:         move.l   CurrentUART,a1
00:00000178 137C000D0004    	   188:         move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000017E 137C00830006    	   189:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000184 12BC0068        	   190:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000188 137C00000002    	   191:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000018E 08A900070006    	   192:         bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000194 4229000E        	   193:         clr.b   SCR(a1)                 ; clear the scratch register
00:00000198 4E75            	   194:         RTS
                            	   195: 
                            	   196:     ; Escreve caractere (D0.B)
                            	   197: UART_WriteChar:
00:0000019A 2F08            	   198:         MOVE.L  A0,-(SP)        ; Preserva A0
00:0000019C 2F00            	   199:         MOVE.L  D0,-(SP)        ; Preserva D0
00:0000019E 207900081010    	   200:         move.l   CurrentUART,A0
                            	   201: .WaitTx:
00:000001A4 08280005000A    	   202:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:000001AA 67F8            	   203:         BEQ     .WaitTx
00:000001AC 1080            	   204:         MOVE.B  D0,THR(A0)      ; transmit byte
00:000001AE 201F            	   205:         MOVE.L  (SP)+,D0        ;Restaura D0
00:000001B0 205F            	   206:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001B2 4E75            	   207:         RTS
                            	   208: 
                            	   209: 
                            	   210: ; Lê caractere (retorna em D0)
                            	   211: UART_ReadChar:
00:000001B4 2F08            	   212:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001B6 207900081010    	   213:         MOVE.L   CurrentUART,A0
                            	   214: .WaitRx:
00:000001BC 08280000000A    	   215:         BTST    #0,LSR(A0)        ; RX ready?
00:000001C2 67F8            	   216:         BEQ     .WaitRx
00:000001C4 1010            	   217:         MOVE.B  RHR(A0),D0
00:000001C6 205F            	   218:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001C8 B03C001B        	   219:         CMP.B   #$1b,D0
00:000001CC 6704            	   220:         BEQ     .fim
00:000001CE 4EB8019A        	   221:         JSR     UART_WriteChar
                            	   222: .fim
00:000001D2 4E75            	   223:         RTS
                            	   224: 
