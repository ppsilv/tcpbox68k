                            	   143: UART_Init:
00:00000112 227900081008    	   144:     move.l   CurrentUART,a1
00:00000118 137C000D0004    	   145:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000011E 137C00830006    	   146:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000124 12BC0068        	   147:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000128 137C00000002    	   148:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000012E 08A900070006    	   149:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000134 4229000E        	   150:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000138 4E75            	   151:     RTS
                            	   152: 
                            	   153:     ; Escreve caractere (D0.B)
                            	   154: UART_WriteChar:
00:0000013A 2F08            	   155:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000013C 2F00            	   156:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000013E 207900081008    	   157:     move.l   CurrentUART,A0
                            	   158: .WaitTx:
00:00000144 08280005000A    	   159:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:0000014A 67F8            	   160:     BEQ     .WaitTx
00:0000014C 1080            	   161:     MOVE.B  D0,THR(A0)      ; transmit byte
00:0000014E 201F            	   162:     MOVE.L  (SP)+,D0        ;Restaura D0
00:00000150 205F            	   163:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000152 4E75            	   164:     RTS
                            	   165: 
                            	   166: 
                            	   167: ; Lê caractere (retorna em D0)
                            	   168: UART_ReadChar:
00:00000154 2F08            	   169:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000156 207900081008    	   170:     move.l   CurrentUART,A0
                            	   171: .WaitRx:
00:0000015C 08280000000A    	   172:     BTST    #0,LSR(A0)        ; RX ready?
00:00000162 67F8            	   173:     BEQ     .WaitRx
00:00000164 1010            	   174:     MOVE.B  RHR(A0),D0
00:00000166 205F            	   175:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000168 4EB8013A        	   176:     JSR     UART_WriteChar
00:0000016C 4E75            	   177:     RTS
