                            	   139: ; =============================================
                            	   140: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   141: ; Entrada: D0 = tempo em ms (16 bits)
                            	   142: ; Destrói: D0
                            	   143: ; =============================================
                            	   144: DELAY_MS:
00:0000012C 2F01            	   145:         MOVE.L  d1,-(sp)          ; Salva D1
00:0000012E 3200            	   146:         MOVE.W  d0,d1             ; Contador de ms
00:00000130 670E            	   147:         BEQ.S   .end              ; Se D0=0, sai
                            	   148: .loop_ms:
00:00000132 203C00003E80    	   149:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   150: .inner_loop:
00:00000138 5380            	   151:         SUBQ.L  #1,d0             ; 4 ciclos
00:0000013A 66FC            	   152:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
00:0000013C 5341            	   153:         SUBQ.W  #1,d1             ; 1 ms
00:0000013E 66F2            	   154:         BNE.S   .loop_ms
                            	   155: .end:
00:00000140 221F            	   156:         MOVE.L  (sp)+,d1          ; Restaura D1
00:00000142 4E75            	   157:         rts
