00:00000746 E188            	   980:        LSL.L   #8,D0
00:00000748 4EB801AC        	   981:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:0000074C E188            	   982:        LSL.L   #8,D0
00:0000074E 4EB801AC        	   983:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:00000752 E188            	   984:        LSL.L   #8,D0
00:00000754 4EB801AC        	   985:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:00000758 22C0            	   986:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
