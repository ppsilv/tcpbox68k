                            	   766: ; Lê 4 bytes (32 bits) via UART
                            	   767: UART_ReadLong:
00:0000056A 7000            	   768:     MOVEQ   #0,D0
00:0000056C 7203            	   769:     MOVEQ   #3,D1            ; 4 bytes a ler
                            	   770: .Loop:
00:0000056E E188            	   771:     LSL.L   #8,D0            ; Desloca resultado atual
00:00000570 4EB8057C        	   772:     JSR     UART_ReadByte
00:00000574 8000            	   773:     OR.B    D0,D0            ; Combina com novo byte
00:00000576 51C9FFF6        	   774:     DBF     D1,.Loop
00:0000057A 4E75            	   775:     RTS
                            	   776: 
                            	   777: ; Lê byte hexadecimal (2 caracteres ASCII)
                            	   778: UART_ReadByte:
00:0000057C 2F00            	   779:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000057E 4EB80590        	   780:     JSR     UART_ReadHexNibble
00:00000582 E908            	   781:     LSL.B   #4,D0
00:00000584 1200            	   782:     MOVE.B  D0,D1
00:00000586 4EB80590        	   783:     JSR     UART_ReadHexNibble
00:0000058A 8001            	   784:     OR.B    D1,D0
00:0000058C 201F            	   785:     MOVE.L  (SP)+,D0        ; Recupera D0
00:0000058E 4E75            	   786:     RTS
                            	   787: 
                            	   788: ; Lê meio-byte hexadecimal
                            	   789: UART_ReadHexNibble:
00:00000590 4EB80158        	   790:     JSR     UART_ReadChar
00:00000594 B03C0041        	   791:     CMP.B   #'A',D0
00:00000598 6D02            	   792:     BLT     .Digit
00:0000059A 5F00            	   793:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   794: .Digit:
00:0000059C 903C0030        	   795:     SUB.B   #'0',D0
00:000005A0 C03C000F        	   796:     AND.B   #$0F,D0
00:000005A4 4E75            	   797:     RTS
                            	   798: 
                            	   799: ;--------------------------------------------------
                            	   800: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   801: ;--------------------------------------------------
                            	   802: ; Exemplo: insere 'A' no buffer
                            	   803: ;          MOVE.B  #'A',D0
                            	   804: ;          JSR     UART_BufferPut
                            	   805: 
                            	   806: BufferPut:
00:000005A6 2F01            	   807:     MOVE.L  D1,-(SP)
00:000005A8 2F08            	   808:     MOVE.L  A0,-(SP)
                            	   809: 
                            	   810:     ;ANDI.W    #$FF00,D0
00:000005AA 41F900081024    	   811:     LEA     BUFFER,A0
00:000005B0 323900081022    	   812:     MOVE.W  BUFFER_COUNT,D1
                            	   813: 
00:000005B6 B27C0100        	   814:     CMP.W   #256,D1
00:000005BA 6C1C            	   815:     BGE     .BufferFull
                            	   816: 
                            	   817:     ; Modificado para usar deslocamento de 16 bits
00:000005BC 32390008101A    	   818:     MOVE.W  BUFFER_HEAD,D1
00:000005C2 D0C1            	   819:     ADD     D1,A0
00:000005C4 1080            	   820:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   821: 
00:000005C6 5441            	   822:     ADD     #2,D1              ; Incrementa como word
00:000005C8 024100FF        	   823:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005CC 33C10008101A    	   824:     MOVE.W  D1,BUFFER_HEAD
                            	   825: 
00:000005D2 527900081022    	   826:     ADDQ.W  #1,BUFFER_COUNT
                            	   827: 
                            	   828: .BufferFull:
00:000005D8 205F            	   829:     MOVE.L  (SP)+,A0
00:000005DA 221F            	   830:     MOVE.L  (SP)+,D1
                            	   831: 
00:000005DC 4E75            	   832:     RTS
                            	   833: 
                            	   834: ;--------------------------------------------------
                            	   835: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   836: ;--------------------------------------------------
                            	   837: ;Exemplo: Lendo byte do buffer
                            	   838: ;         BSR     UART_BufferGet
                            	   839: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   840: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   841: ;         Senão, D0 contém o byte lido!
                            	   842: BufferGet:
00:000005DE 2F01            	   843:     MOVE.L  D1,-(SP)
00:000005E0 2F08            	   844:     MOVE.L  A0,-(SP)
                            	   845: 
00:000005E2 323900081022    	   846:     MOVE.W  BUFFER_COUNT,D1
00:000005E8 6724            	   847:     BEQ     .BufferEmpty
                            	   848: 
00:000005EA 41F900081024    	   849:     LEA     BUFFER,A0
                            	   850: 
                            	   851:     ; Modificado para usar deslocamento de 16 bits
00:000005F0 32390008101E    	   852:     MOVE.W  BUFFER_TAIL,D1
00:000005F6 10301000        	   853:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   854: 
00:000005FA 5401            	   855:     ADDQ.B  #2,D1              ; Incrementa como word
00:000005FC 024100FF        	   856:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000600 33C10008101E    	   857:     MOVE.W  D1,BUFFER_TAIL
                            	   858: 
00:00000606 537900081022    	   859:     SUBQ.W  #1,BUFFER_COUNT
00:0000060C 6006            	   860:     BRA     .Exit
                            	   861: 
                            	   862: .BufferEmpty:
00:0000060E 4EB8061A        	   863:     JSR     FBufferEmpty
00:00000612 70FF            	   864:     MOVEQ   #-1,D0
                            	   865: .Exit:
00:00000614 205F            	   866:     MOVE.L  (SP)+,A0
00:00000616 221F            	   867:     MOVE.L  (SP)+,D1
00:00000618 4E75            	   868:     RTS
                            	   869: 
                            	   870: FBufferEmpty:
00:0000061A 4EB8020E        	   871:         JSR     new_line
00:0000061E 41F90000036F    	   872:         LEA     BufferEmpty,A0
00:00000624 4EB8016E        	   873:         JSR     UART_WriteString
00:00000628 4EB8020E        	   874:         JSR     new_line
00:0000062C 4E75            	   875:         RTS
                            	   876: ;---------------------------------------------------------------------
                            	   877: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   878: ;---------------------------------------------------------------------
                            	   879: ClearBufferPointers:
00:0000062E 23FC000000000008	   880:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000636 101A
00:00000638 23FC000000000008	   881:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000640 101E
00:00000642 33FC000000081022	   882:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:0000064A 4E75            	   883:     RTS
                            	   884: ;---------------------------------------------------------------------
                            	   885: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   886: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   887: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   888: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   889: ;---------------------------------------------------------------------
                            	   890: MontaAddress:
00:0000064C 48E73C80        	   891:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   892: 
                            	   893:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000650 323900081022    	   894:     MOVE.W  BUFFER_COUNT,D1
00:00000656 B27C0008        	   895:     CMP.W   #8,D1
00:0000065A 6D38            	   896:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   897: 
00:0000065C 41F900081024    	   898:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000662 24390008101E    	   899:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000668 7000            	   900:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000066A 7607            	   901:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   902: 
                            	   903: .ReadLoop:
00:0000066C 18302800        	   904:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000670 0204000F        	   905:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   906: 
                            	   907:     ; Desloca e insere os 4 bits em D0
00:00000674 E988            	   908:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000676 8004            	   909:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   910: 
                            	   911:     ; Atualiza tail (circular)
00:00000678 5282            	   912:     ADDQ.L  #1,D2
00:0000067A 0282000000FF    	   913:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   914: 
00:00000680 51CBFFEA        	   915:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   916: 
                            	   917:     ; Atualiza ponteiros globais
00:00000684 23C20008101E    	   918:     MOVE.L  D2,BUFFER_TAIL
00:0000068A 517900081022    	   919:     SUB.W   #8,BUFFER_COUNT
                            	   920: 
00:00000690 7200            	   921:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000692 6004            	   922:     BRA     .Exit
                            	   923: 
                            	   924: .BufferUnderrun:
00:00000694 72FF            	   925:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:00000696 7000            	   926:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   927: 
                            	   928: .Exit:
00:00000698 4CDF013C        	   929:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:0000069C 4E75            	   930:     RTS
