                            	   593: ; ----------------------------------------------------------------------
                            	   594: ; Subrotinas do Menu
                            	   595: ; ----------------------------------------------------------------------
                            	   596: 
                            	   597: ; 1. Seleciona UART
                            	   598: SelectUART:
00:0000041C 41F900000357    	   599:     LEA     PromptNotImplemented,A0
00:00000422 4EB8016E        	   600:     JSR     UART_WriteString
                            	   601:     ;LEA     UARTPrompt,A0
                            	   602:     ;JSR     UART_WriteString
                            	   603:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   604:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   605:     ;JSR     UART_Init           ; Reinicializa UART
00:00000426 4E75            	   606:     RTS
                            	   607: 
                            	   608: ; 2. Configura Baud Rate
                            	   609: SetBaudRate:
00:00000428 41F900000357    	   610:     LEA     PromptNotImplemented,A0
00:0000042E 4EB8016E        	   611:     JSR     UART_WriteString
                            	   612:     ;LEA     BaudPrompt,A0
                            	   613:     ;JSR     UART_WriteString
                            	   614:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   615:     ;MOVE.L  CurrentUART,A0
                            	   616:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
00:00000432 4E75            	   617:     RTS
                            	   618: 
                            	   619: ; 3. Carrega programa via serial
                            	   620: LoadProgram:
                            	   621: 
00:00000434 41F900081124    	   622:     LEA     DEST_BUFFER,A0   ; Onde os dados serão salvos
00:0000043A 23C800081524    	   623:     MOVE.L  A0,user_buffer_ptr
00:00000440 4EB806AC        	   624:     JSR     XMODEM_Receive
                            	   625: 
00:00000444 4E75            	   626:     RTS
                            	   627: ; 4. Grava programa manualmente (hex)
                            	   628: WriteProgram:
00:00000446 41F90000030D    	   629:     LEA     WritePrompt,A0
00:0000044C 4EB8016E        	   630:     JSR     UART_WriteString
00:00000450 4EB804DC        	   631:     JSR     UART_ReadHex        ; Lê endereço
00:00000454 2240            	   632:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   633: 
00:00000456 41F90000031D    	   634:     LEA     WriteSizePrompt,A0
00:0000045C 4EB8016E        	   635:     JSR     UART_WriteString
00:00000460 4EB804DC        	   636:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:00000464 2200            	   637:     MOVE.L  D0,D1               ; D1 = contador
                            	   638: 
                            	   639: .WriteLoop:
00:00000466 4EB8057C        	   640:     JSR     UART_ReadByte       ; Lê byte
00:0000046A 12C0            	   641:     MOVE.B  D0,(A1)+            ; Armazena
00:0000046C 5381            	   642:     SUBQ.L  #1,D1
00:0000046E 66F6            	   643:     BNE     .WriteLoop
                            	   644: 
00:00000470 41F90000032F    	   645:     LEA     WriteDoneMsg,A0
00:00000476 4EB8016E        	   646:     JSR     UART_WriteString
00:0000047A 4E75            	   647:     RTS
                            	   648: 
                            	   649: ; 5. Executa programa na RAM
                            	   650: RunProgram:
00:0000047C 41F900000349    	   651:     LEA     RunPrompt,A0
00:00000482 4EB8016E        	   652:     JSR     UART_WriteString
00:00000486 4EB804DC        	   653:     JSR     UART_ReadHex        ; Lê endereço
00:0000048A 2040            	   654:     MOVE.L  D0,A0
00:0000048C 4E90            	   655:     JSR     (A0)                ; Chama subrotina
00:0000048E 4E75            	   656:     RTS
