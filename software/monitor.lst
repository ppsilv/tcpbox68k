                            	  1068: ; XMODEM RECEIVER ROUTINE
                            	  1069: ;bloco.append(0x01);        // SOH
                            	  1070: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1071: ;bloco.append(255 - blockNumber); // Complemento
                            	  1072: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1073: ;bloco.append(checksum);    // Checksum calculado
                            	  1074: ; =====================================================================
                            	  1075: XMODEM_Receive:
00:000007C0 48E73FFE        	  1076:                 MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1077:                 ; Inicializa variáveis
00:000007C4 41F900081325    	  1078:                 LEA     expected_block,A0
00:000007CA 103C0001        	  1079:                 MOVE.B  #1,D0
00:000007CE 1080            	  1080:                 MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:000007D0 41F900081124    	  1081:                 LEA     xmodem_buffer,A0
                            	  1082: 
                            	  1083:                 ; ---- 1. INICIALIZAÇÃO ----
00:000007D6 103C0015        	  1084:                 MOVE.B  #NAK,D0
00:000007DA 4EB80228        	  1085:                 JSR     UART_WriteChar      ; Solicita início
                            	  1086: 
                            	  1087:                 ;SINALIZA NACK SENT
00:000007DE 303C0800        	  1088:                 MOVE.W  #$0800,D0
00:000007E2 4EB80168        	  1089:                 JSR     WRITE_LEDS
                            	  1090: 
                            	  1091:                 ; ---- 2. LOOP PRINCIPAL ----
                            	  1092: Receive_Loop:
00:000007E6 4EB80262        	  1093:                 JSR     UART_ReadCharNonEcho
                            	  1094: 
00:000007EA B03C0004        	  1095:                 CMP.B   #EOT,D0
00:000007EE 670000B0        	  1096:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1097: 
00:000007F2 B03C0001        	  1098:                 CMP.B   #SOH,D0
00:000007F6 66EE            	  1099:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1100: 
                            	  1101:                 ;SINALIZA leds
00:000007F8 303C0C00        	  1102:                 MOVE.W  #$0C00,D0
00:000007FC 4EB80168        	  1103:                 JSR     WRITE_LEDS
                            	  1104: 
                            	  1105:                 ; ---- 3. RECEBE HEADER ----
00:00000800 4EB80262        	  1106:                 JSR     UART_ReadCharNonEcho       ; Block number
00:00000804 13C000081324    	  1107:                 MOVE.B  D0,block_number
                            	  1108: 
00:0000080A 4EB80262        	  1109:                 JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1110: 
                            	  1111:                 ;SINALIZA leds
00:0000080E 303C0800        	  1112:                 MOVE.W  #$0800,D0
00:00000812 4EB80168        	  1113:                 JSR     WRITE_LEDS
                            	  1114: 
                            	  1115:                 ; ---- 4. RECEBE DADOS ----
00:00000816 7220            	  1116:                 MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:00000818 43F900081124    	  1117:                 LEA     xmodem_buffer,A1
                            	  1118: Read_Loop:
                            	  1119:                 ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:0000081E 4EB80262        	  1120:                 JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:00000822 E188            	  1121:                 LSL.L   #8,D0
00:00000824 4EB80262        	  1122:                 JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:00000828 E188            	  1123:                 LSL.L   #8,D0
00:0000082A 4EB80262        	  1124:                 JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:0000082E E188            	  1125:                 LSL.L   #8,D0
00:00000830 4EB80262        	  1126:                 JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:00000834 22C0            	  1127:                 MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:00000836 5381            	  1128:                 SUBQ.L  #1,D1
00:00000838 66E4            	  1129:                 BNE     Read_Loop
                            	  1130: 
00:0000083A 303C0600        	  1131:                 MOVE.W  #$0600,D0
00:0000083E 4EB80168        	  1132:                 JSR     WRITE_LEDS
                            	  1133: 
                            	  1134:                 ; ---- 5. VERIFICA CHECKSUM ----
00:00000842 4EB80262        	  1135:                 JSR     UART_ReadCharNonEcho       ; Checksum
00:00000846 1400            	  1136:                 MOVE.B  D0,D2
                            	  1137: 
                            	  1138: 
                            	  1139: ;******************************************************************************************
                            	  1140:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1141:            ;     BRA     Send_ACK
                            	  1142: ;******************************************************************************************
                            	  1143: 
                            	  1144:                 ; Calcula checksum local
                            	  1145:            ;     LEA     xmodem_buffer,A1
                            	  1146:            ;     MOVE.W  #127,D1
                            	  1147:            ;     CLR.B   D3
                            	  1148: 
                            	  1149: Calc_Checksum:
                            	  1150:            ;     ADD.B   (A1)+,D3
                            	  1151:            ;     DBF     D1,Calc_Checksum;
                            	  1152: 
                            	  1153:            ;     CMP.B   D2,D3
                            	  1154:            ;     BNE     Send_NAK            ; Erro no checksum
                            	  1155: 
                            	  1156:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1157:            ;     MOVE.B  block_number,D0
                            	  1158:            ;     CMP.B   expected_block,D0
                            	  1159:            ;     BNE     Send_NAK            ; Bloco fora de ordem
                            	  1160: 
                            	  1161:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1162:                 ; (Aqui você processa os 128 bytes recebidos)
                            	  1163:                 ; Exemplo: copiar do buffer para a RAM
                            	  1164:                 ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:00000848 43F900081124    	  1165:                 LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:0000084E 247900081326    	  1166:                 MOVE.L  user_buffer_ptr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:00000854 7220            	  1167:                 MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1168: Copy_Data:
00:00000856 24D9            	  1169:                 MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:00000858 5381            	  1170:                 SUBQ.L  #1,D1               ; Decrementa contador
00:0000085A 66FA            	  1171:                 BNE     Copy_Data            ; Repete até D1 = 0
                            	  1172:                 ; 2. Atualiza user_buffer_ptr para o próximo bloco (+128 bytes)
00:0000085C 203900081326    	  1173:                 MOVE.L  user_buffer_ptr,D0
00:00000862 068000000080    	  1174:                 ADDI.L  #128,D0
00:00000868 23C000081326    	  1175:                 MOVE.L  D0,user_buffer_ptr
                            	  1176: 
                            	  1177: 
                            	  1178: 
                            	  1179:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:0000086E 523900081325    	  1180:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000874 103C0006        	  1181:                 MOVE.B  #ACK,D0
00:00000878 4EB80228        	  1182:                 JSR     UART_WriteChar
00:0000087C 6000FF68        	  1183:                 BRA     Receive_Loop
                            	  1184: 
                            	  1185: Send_ACK:
                            	  1186:                 ;SINALIZA NACK SENT
00:00000880 303C0400        	  1187:                 MOVE.W  #$0400,D0
00:00000884 4EB80168        	  1188:                 JSR     WRITE_LEDS
00:00000888 103C0006        	  1189:                 MOVE.B  #ACK,D0
00:0000088C 4EB80228        	  1190:                 JSR     UART_WriteChar
00:00000890 6000FF54        	  1191:                 BRA     Receive_Loop
                            	  1192: 
                            	  1193: Send_NAK:
00:00000894 103C0015        	  1194:                 MOVE.B  #NAK,D0
00:00000898 4EB80228        	  1195:                 JSR     UART_WriteChar
00:0000089C 6000FF48        	  1196:                 BRA     Receive_Loop
                            	  1197: 
                            	  1198: Transfer_Complete:
00:000008A0 103C0006        	  1199:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:000008A4 4EB80228        	  1200:                 JSR     UART_WriteChar
00:000008A8 4CDF7FFC        	  1201:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:000008AC 4E75            	  1202:                 RTS
                            	  1203: ; ========================================================
                            	  1204: ; Validador de Checksum para ROM (MC68000)
                            	  1205: ; Assume:
                            	  1206: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1207: ;   - Big-endian (padrão 68000)
                            	  1208: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1209: ; ========================================================
                            	  1210: 
                            	  1211: VALIDATE_ROM:
00:000008AE 91C8            	  1212:     LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:000008B0 203C00007FFC    	  1213:     MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:000008B6 7200            	  1214:     MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1215: 
                            	  1216:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1217: .CHECKSUM_LOOP:
00:000008B8 2418            	  1218:     MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:000008BA D282            	  1219:     ADD.L   D2,D1               ; Soma ao acumulador
00:000008BC 5980            	  1220:     SUB.L   #4,D0               ; Decrementa contador
00:000008BE 6EF8            	  1221:     BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1222: 
                            	  1223:     ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:000008C0 24387FFB        	  1224:     MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:000008C4 B481            	  1225:     CMP.L   D1,D2               ; Combina com o calculado?
00:000008C6 6706            	  1226:     BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1227: 
                            	  1228:     ; --- Checksum inválido: travar o sistema ou notificar ---
00:000008C8 363CDEAD        	  1229:     MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:000008CC 6002            	  1230:     BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1231: .CHECKSUM_OK:
00:000008CE 4E75            	  1232:     RTS                         ; Retorna (ROM válida)
                            	  1233: 
                            	  1234: SYSTEM_HALT:
00:000008D0 46FC2700        	  1235:     MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1236: .INFINITE_LOOP:
00:000008D4 60FE            	  1237:     BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1238: 
                            	  1239: ; --- Constantes ---
                            	  1240: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1241: ROM_END     EQU     $00007FFF   ; Fim da ROM (8KB)
                            	  1242: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1243: 
                            	  1244: Checksum:
00:000008D6 00000000        	  1245:     DC.L    0               ; Temporariamente 0
                            	  1246: 
00:000008DA 4D45524441205445	  1247:     DC.B "MERDA TERMINA"
00:000008E2 524D494E41
