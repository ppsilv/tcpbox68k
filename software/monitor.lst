                            	    23: ;# Clock frequency in Hz
                            	    24: F_CPU           equ 16000000
                            	    25: ;# Serial baud rate
                            	    26: 
                            	    27: ;UART            equ $2000
                            	    28: ; register offsets
                            	    29: RHR             equ 0   ; receive holding register (read)
                            	    30: THR             equ 0   ; transmit holding register (write)
                            	    31: IER             equ 2   ; interrupt enable register
                            	    32: ISR             equ 4   ; interrupt status register (read)
                            	    33: FCR             equ 4   ; FIFO control register (write)
                            	    34: LCR             equ 6   ; line control register
                            	    35: MCR             equ 8   ; modem control register
                            	    36: LSR             equ 10  ; line status register
                            	    37: MSR             equ 12  ; modem status register
                            	    38: SPR             equ 14  ; scratchpad register (reserved for system use)
                            	    39: DLL             equ 0   ; divisor latch LSB
                            	    40: DLM             equ 2   ; divisor latch MSB
                            	    41: ; aliases for register names (used by different manufacturers)cd ..
                            	    42: RBR             equ RHR ; receive buffer register
                            	    43: IIR             equ ISR ; interrupt identification register
                            	    44: SCR             equ SPR ; scratch register
                            	    45: 
                            	    46: LED_ADDRESS     equ $4400
                            	    47: UART_BASE       equ $4000
                            	    48: BAUD_RATE       equ 9600
                            	    49: BAUD_DIV        equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    50: BAUD_DIV_L      equ     (BAUD_DIV&$FF)
                            	    51: BAUD_DIV_U      equ     ((BAUD_DIV>>8)&$FF)
                            	    52: 
                            	    53: ;=== Uart receiver ================= CONSTANTES =================
                            	    54: SOH            EQU     $01        ; Start Of Header
                            	    55: EOT            EQU     $04        ; End Of Transmission
                            	    56: ACK            EQU     $06        ; Acknowledge
                            	    57: NAK            EQU     $15        ; Negative Acknowledge
                            	    58: CAN            EQU     $18        ; Cancel
                            	    59: 
