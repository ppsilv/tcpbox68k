                            	   659: ; ----------------------------------------------------------------------
                            	   660: ; Rotinas Auxiliares
                            	   661: ; ----------------------------------------------------------------------
                            	   662: 
                            	   663: ; Lê número hexadecimal (retorna em D0)
                            	   664: UART_ReadHex1:
00:00000490 2F01            	   665:         MOVE.L  D1,-(SP)
00:00000492 2F02            	   666:         MOVE.L  D2,-(SP)
                            	   667: 
00:00000494 41F900000312    	   668:         LEA     WritePrompt,A0
00:0000049A 4EB8016E        	   669:         JSR     UART_WriteString
                            	   670: 
00:0000049E 4EB8020E        	   671:         JSR     new_line
                            	   672: 
00:000004A2 7000            	   673:         MOVEQ   #0,D0
00:000004A4 7200            	   674:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000004A6 7400            	   675:         MOVEQ   #0,D2            ; Resultado em D2
                            	   676: 
                            	   677: .Loop:
00:000004A8 4EB80158        	   678:         JSR     UART_ReadChar
00:000004AC B03C000D        	   679:         CMP.B   #13,D0
00:000004B0 670C            	   680:         BEQ     .Done
00:000004B2 B03C000A        	   681:         CMP.B   #10,D0
00:000004B6 6706            	   682:         BEQ     .Done
00:000004B8 4EB805A6        	   683:         JSR     BufferPut
00:000004BC 60EA            	   684:         BRA     .Loop
                            	   685: .Done:
                            	   686: ;         BSR     UART_BufferGet
                            	   687: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   688: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   689: ;         Senão, D0 contém o byte lido!
                            	   690: .loop1:
00:000004BE 4EB805DE        	   691:     JSR     BufferGet
00:000004C2 B03C00FF        	   692:     CMP.B   #-1,D0          ; Buffer vazio?
00:000004C6 6706            	   693:     BEQ     .fim      ; Se sim, ignora
00:000004C8 4EB8013E        	   694:     JSR     UART_WriteChar
00:000004CC 60F0            	   695:     BRA     .loop1
                            	   696: .fim:
00:000004CE 241F            	   697:     MOVE.L  (SP)+,D2
00:000004D0 221F            	   698:     MOVE.L  (SP)+,D1
00:000004D2 4EB8020E        	   699:     JSR     new_line
00:000004D6 6000FBA4        	   700:     bra     MenuLoop ;provisoriamente
00:000004DA 4E75            	   701:     RTS
                            	   702: 
                            	   703: ; Lê número hexadecimal (retorna em D0)
                            	   704: UART_ReadHex:
00:000004DC 2F01            	   705:         MOVE.L  D1,-(SP)
00:000004DE 2F02            	   706:         MOVE.L  D2,-(SP)
                            	   707: 
00:000004E0 7000            	   708:         MOVEQ   #0,D0
00:000004E2 721C            	   709:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:000004E4 7400            	   710:         MOVEQ   #0,D2            ; Resultado em D2
                            	   711: .Loop:
00:000004E6 7000            	   712:         CLR.L   D0
00:000004E8 4EB80158        	   713:         JSR     UART_ReadChar
00:000004EC B03C000D        	   714:         CMP.B   #13,D0
00:000004F0 674C            	   715:         BEQ     .Done
00:000004F2 B03C000A        	   716:         CMP.B   #10,D0
00:000004F6 6746            	   717:         BEQ     .Done
                            	   718:         ;Tratando os numeros
00:000004F8 B03C0030        	   719:         CMP.B   #'0',D0
00:000004FC 6C02            	   720:         BGE     .maiorQueZero
00:000004FE 60E6            	   721:         BRA     .Loop
                            	   722: .maiorQueZero:
00:00000500 B03C0039        	   723:         CMP.B   #'9',D0
00:00000504 6F10            	   724:         BLE     .isdigit
                            	   725:         ;Tratando as letras
00:00000506 B03C0041        	   726:         CMP.B   #'A',D0
00:0000050A 6C02            	   727:         BGE     .maiorQueA
00:0000050C 60D8            	   728:         BRA     .Loop
                            	   729: .maiorQueA:
00:0000050E B03C0046        	   730:         CMP.B   #'F',D0
00:00000512 6F16            	   731:         BLE     .isletter
00:00000514 60D0            	   732:         BRA     .Loop
                            	   733: .isdigit:
00:00000516 903C0030        	   734:         SUB.B   #'0',D0
00:0000051A E3A8            	   735:         LSL.L   D1,D0
00:0000051C 5901            	   736:         SUB.B   #4,D1
00:0000051E 8480            	   737:         OR.L    D0,D2
00:00000520 41F900081016    	   738:         LEA     addressInHex,A0
00:00000526 2082            	   739:         MOVE.L  D2,(A0)
00:00000528 60BC            	   740:         BRA     .Loop
                            	   741: .isletter:
00:0000052A 903C0037        	   742:         SUB.B   #$37,D0
00:0000052E E3A8            	   743:         LSL.L   D1,D0
00:00000530 5901            	   744:         SUB.B   #4,D1
00:00000532 8480            	   745:         OR.L    D0,D2
00:00000534 41F900081016    	   746:         LEA     addressInHex,A0
00:0000053A 2082            	   747:         MOVE.L  D2,(A0)
00:0000053C 60A8            	   748:         BRA     .Loop
                            	   749: .Done:
00:0000053E 4EB8020E        	   750:     JSR     new_line
00:00000542 41F900081016    	   751:     LEA     addressInHex,A0
00:00000548 2010            	   752:     MOVE.L  (A0),D0
00:0000054A 4EB803A6        	   753:     JSR     PrintHexAddress
