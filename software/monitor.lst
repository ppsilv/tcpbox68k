                            	   256: ; ----------------------------------------------------------------------
                            	   257: ; Constantes
                            	   258: ; ----------------------------------------------------------------------
                            	   259: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   260: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   261:                               ; BAUD_DIV_L em $70000
                            	   262:                               ; BAUD_DIV_U em $70001
                            	   263: 
                            	   264: ; ----------------------------------------------------------------------
                            	   265: ; Rotina: Calcula e armazena divisor de baud rate
                            	   266: ; Entrada:
                            	   267: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   268: ; Saída:
                            	   269: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   270: ; Formulas:
                            	   271: ;
                            	   272: ;
                            	   273: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   274: ; ----------------------------------------------------------------------
                            	   275: 
                            	   276: CALCBAUDDIV:
                            	   277: ;[ Registrador D0 (32 bits) ]
                            	   278: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   279: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   280:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   281:         ;((F_CPU/16)/10)
                            	   282:         ;F_CPU = 16000000 ou 0xF42400
00:000001FE 203C00F42400    	   283:         MOVE.L  #F_CPU,D0
00:00000204 323C0010        	   284:         MOVE.W  #16,D1         ; Divisor
00:00000208 61000096        	   285:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   286: ;1
00:0000020C 2F00            	   287:         move.l  d0,-(SP)
00:0000020E 4EB80408        	   288:         jsr     PrintHexAddress
00:00000212 4EB8028A        	   289:         jsr     new_line
00:00000216 201F            	   290:         move.l  (SP)+,d0
                            	   291: 
00:00000218 323C000A        	   292:         MOVE.W  #10,D1         ; Divisor
00:0000021C 61000082        	   293:         BSR     Div32x16       ; D0 = 0x186A0
                            	   294: ;2
00:00000220 2F00            	   295:         move.l  d0,-(SP)
00:00000222 4EB80408        	   296:         jsr     PrintHexAddress
00:00000226 4EB8028A        	   297:         jsr     new_line
00:0000022A 201F            	   298:         move.l  (SP)+,d0
                            	   299: 
                            	   300:         ;(BAUD/10)
00:0000022C 2F00            	   301:         move.l  d0,-(SP)
                            	   302: ;3
00:0000022E 7000            	   303:         CLR.L   D0
00:00000230 303900081014    	   304:         MOVE.W  CurrentBaudRate,D0
00:00000236 2F00            	   305:         move.l  d0,-(SP)
00:00000238 4EB80408        	   306:         jsr     PrintHexAddress
00:0000023C 4EB8028A        	   307:         jsr     new_line
00:00000240 201F            	   308:         move.l  (SP)+,d0
                            	   309: 
00:00000242 123C000A        	   310:         MOVE.B  #10,D1
00:00000246 6158            	   311:         BSR     Div32x16
                            	   312: 
                            	   313: ;4
00:00000248 2F00            	   314:         move.l  d0,-(SP)
00:0000024A 4EB80408        	   315:         jsr     PrintHexAddress
00:0000024E 4EB8028A        	   316:         jsr     new_line
00:00000252 221F            	   317:         move.l  (SP)+,D1
00:00000254 201F            	   318:         move.l  (SP)+,D0
                            	   319: 
                            	   320: 
                            	   321:         ;(F_CPU/BAUD)
00:00000256 6148            	   322:         BSR     Div32x16
                            	   323: ;5
00:00000258 2F00            	   324:         move.l  d0,-(SP)
00:0000025A 4EB80408        	   325:         jsr     PrintHexAddress
00:0000025E 4EB8028A        	   326:         jsr     new_line
00:00000262 201F            	   327:         move.l  (SP)+,d0
                            	   328: 
                            	   329:         ; 4. Separa parte alta/baixa corretamente
00:00000264 3200            	   330:         MOVE.W  D0,D1
00:00000266 024000FF        	   331:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:0000026A E049            	   332:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:0000026C 024100FF        	   333:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   334: 
                            	   335:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000270 41F90008101A    	   336:         LEA     Baud1DivL,A0
00:00000276 3080            	   337:         MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000278 41F90008101C    	   338:         LEA     Baud1DivH,A0
00:0000027E 3081            	   339:         MOVE.W  D1,(A0)
                            	   340: 
00:00000280 6000FE2E        	   341:         BRA     MenuLoop
00:00000284 4E75            	   342:         RTS
                            	   343: .BaudError:
00:00000286 6000FD98        	   344:         BRA     _start
                            	   345: 
                            	   346: new_line:
00:0000028A 2F00            	   347:         MOVE.L  D0,-(SP)          ; Salva D0
00:0000028C 103C000A        	   348:         MOVE.B  #10,D0
00:00000290 4EB8019A        	   349:         JSR     UART_WriteChar
00:00000294 103C000D        	   350:         MOVE.B  #13,D0
00:00000298 4EB8019A        	   351:         JSR     UART_WriteChar
00:0000029C 201F            	   352:         MOVE.L  (SP)+,D0          ; Restaura D0
00:0000029E 4E75            	   353:         RTS
                            	   354: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   355: ; Retorna D0 = Quociente, D1 = Resto
                            	   356: Div32x16:
00:000002A0 7400            	   357:         MOVEQ   #0,D2       ; D2 = Quociente
00:000002A2 761F            	   358:         MOVEQ   #31,D3      ; 32 iterações
                            	   359: DivLoop:
00:000002A4 E388            	   360:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:000002A6 E392            	   361:         ROXL.L  #1,D2       ; Desloca D2 com Carry
00:000002A8 B441            	   362:         CMP.W   D1,D2       ; D2 >= D1?
00:000002AA 6D04            	   363:         BLT     .skip
00:000002AC 9441            	   364:         SUB.W   D1,D2       ; Sim, subtrai
00:000002AE 5280            	   365:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   366: .skip:
00:000002B0 51CBFFF2        	   367:         DBRA    D3,DivLoop  ; Repete
00:000002B4 2202            	   368:         MOVE.L  D2,D1       ; Resto em D1
00:000002B6 4E75            	   369:         RTS
                            	   370: ; Versão compacta sem stack frame
                            	   371: PrintHexFast:
00:000002B8 2F02            	   372:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002BA 2F00            	   373:         MOVE.L  D0,-(SP)          ; Salva D0 original
00:000002BC 7407            	   374:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   375: 
                            	   376: .Loop:
00:000002BE 2017            	   377:         MOVE.L  (SP),D0           ; Recupera valor original
00:000002C0 E998            	   378:         ROL.L   #4,D0             ; Pega próximo nibble
00:000002C2 2E80            	   379:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:000002C4 0200000F        	   380:         ANDI.B  #$F,D0            ; Isola nibble
                            	   381: 
00:000002C8 B03C0009        	   382:         CMP.B   #9,D0
00:000002CC 6302            	   383:         BLS     .Digit
00:000002CE 5E00            	   384:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   385: .Digit:
00:000002D0 D03C0030        	   386:         ADD.B   #'0',D0           ; Converte para ASCII
00:000002D4 4EB8019A        	   387:         JSR     UART_WriteChar    ; Envia caractere
                            	   388: 
00:000002D8 51CAFFE4        	   389:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   390: 
00:000002DC 588F            	   391:         ADDQ.L  #4,SP             ; Remove valor salvo
00:000002DE 241F            	   392:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002E0 4E75            	   393:         RTS
