                            	    13: FL_ESC      EQU     0   ;ESC flag de tecla ESC recebida pela serial
                            	    14: 
                            	    15: ; --- Macro para Setar Flag ---
                            	    16: SET_FLAG   MACRO
                            	    17:     BCLR    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	    18:     ENDM
                            	    19: ; --- Macro para Setar Flag ---
                            	    20: CLR_FLAG   MACRO
                            	    21:     BSET    #\1,minhas_flags  ; \1 = primeiro argumento (bit)
                            	    22:     ENDM
                            	    23: ; --- Macro TEST_FLAG corrigida ---
                            	    24: TEST_FLAG  MACRO
                            	    25:     BTST    #\1,minhas_flags
                            	    26:     ENDM
                            	    27: ; --- Macro para testar flag (com salto se setado) ---
                            	    28: TST_FLAG_SET MACRO
                            	    29:     BTST    #\1,minhas_flags  ; Testa o bit \1
                            	    30:     BEQ     \2                ; Se bit = 0 (Z=1), pula para o rótulo \2
                            	    31:     ENDM
                            	    32: 
                            	    33: ;Clock frequency in Hz
                            	    34: F_CPU       equ 16000000
                            	    35: ;Uart register offsets
                            	    36: RHR         equ     0   ; receive holding register (read)
                            	    37: THR         equ     0   ; transmit holding register (write)
                            	    38: IER         equ     2   ; interrupt enable register
                            	    39: ISR         equ     4   ; interrupt status register (read)
                            	    40: FCR         equ     4   ; FIFO control register (write)
                            	    41: LCR         equ     6   ; line control register
                            	    42: MCR         equ     8   ; modem control register
                            	    43: LSR         equ     10  ; line status register
                            	    44: MSR         equ     12  ; modem status register
                            	    45: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	    46: DLL         equ     0   ; divisor latch LSB
                            	    47: DLM         equ     2   ; divisor latch MSB
                            	    48: ; aliases for register names (used by different manufacturers)cd ..
                            	    49: RBR         equ     RHR ; receive buffer register
                            	    50: IIR         equ     ISR ; interrupt identification register
                            	    51: SCR         equ     SPR ; scratch register
                            	    52: 
                            	    53: LED_ADDRESS equ     $4400
                            	    54: UART_BASE   equ     $4000
                            	    55: BAUD_RATE   equ     9600
                            	    56: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    57: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	    58: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	    59: 
                            	    60: ;=== Uart receiver ================= CONSTANTES =================
                            	    61: SOH         EQU     $01        ; Start Of Header
                            	    62: EOT         EQU     $04        ; End Of Transmission
                            	    63: ACK         EQU     $06        ; Acknowledge
                            	    64: NAK         EQU     $15        ; Negative Acknowledge
                            	    65: CAN         EQU     $18        ; Cancel
                            	    66: 
