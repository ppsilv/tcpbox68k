                            	   150:     ; Escreve caractere (D0.B)
                            	   151: UART_WriteChar:
00:00000134 2F08            	   152:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000136 2F00            	   153:     MOVE.L  D0,-(SP)        ; Preserva D0
00:00000138 207900081008    	   154:     move.l   CurrentUART,A0
                            	   155: .WaitTx:
00:0000013E 08280005000A    	   156:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000144 67F8            	   157:     BEQ     .WaitTx
00:00000146 1080            	   158:     MOVE.B  D0,THR(A0)      ; transmit byte
00:00000148 201F            	   159:     MOVE.L  (SP)+,D0        ;Restaura D0
00:0000014A 205F            	   160:     MOVE.L  (SP)+,A0        ;Restaura A0
00:0000014C 4E75            	   161:     RTS
                            	   162: 
                            	   163: 
                            	   164: ; Lê caractere (retorna em D0)
                            	   165: UART_ReadChar:
00:0000014E 2F08            	   166:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000150 207900081008    	   167:     move.l   CurrentUART,A0
                            	   168: .WaitRx:
00:00000156 08280000000A    	   169:     BTST    #0,LSR(A0)        ; RX ready?
00:0000015C 67F8            	   170:     BEQ     .WaitRx
00:0000015E 1010            	   171:     MOVE.B  RHR(A0),D0
00:00000160 205F            	   172:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000162 B03C001B        	   173:     CMP.B   #$1b,D0
00:00000166 6704            	   174:     BEQ     .fim
00:00000168 4EB80134        	   175:     JSR     UART_WriteChar
                            	   176: .fim
00:0000016C 4E75            	   177:     RTS
                            	   178: 
