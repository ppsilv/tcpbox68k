                            	   642:     ;LEA     UARTPrompt,A0
                            	   643:     ;JSR     UART_WriteString
                            	   644:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   645:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   646:     ;JSR     UART_Init           ; Reinicializa UART
00:00000488 6000FBE2        	   647:     BRA     MenuLoop
