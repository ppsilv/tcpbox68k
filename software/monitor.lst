00:00000828 103C0006        	  1096:         MOVE.B  #ACK,D0             ; Confirma EOT
00:0000082C 4EB8019A        	  1097:         JSR     UART_WriteChar
                            	  1098: 
00:00000830 41F900081934    	  1099:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:00000836 103C0001        	  1100:         MOVE.B  #1,D0
00:0000083A 1080            	  1101:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1102: 
00:0000083C 4CDF7FFC        	  1103:         MOVEM.L (SP)+,D2-D7/A0-A6
00:00000840 4E75            	  1104:         RTS
                            	  1105: ; ========================================================
                            	  1106: ; Validador de Checksum para ROM (MC68000)
                            	  1107: ; Assume:
                            	  1108: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1109: ;   - Big-endian (padrão 68000)
                            	  1110: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1111: ; ========================================================
                            	  1112: 
                            	  1113: VALIDATE_ROM:
00:00000842 91C8            	  1114:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:00000844 203C00003FFC    	  1115:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:0000084A 7200            	  1116:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1117: 
                            	  1118:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1119: .CHECKSUM_LOOP:
00:0000084C 2418            	  1120:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:0000084E D282            	  1121:         ADD.L   D2,D1               ; Soma ao acumulador
00:00000850 5980            	  1122:         SUB.L   #4,D0               ; Decrementa contador
00:00000852 6EF8            	  1123:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1124: 
00:00000854 41F900081930    	  1125:         LEA     checksum_rom,A0
00:0000085A 20C1            	  1126:         MOVE.L  D1,(A0)+
                            	  1127:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1128: 
                            	  1129:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:0000085C 24383FFC        	  1130:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
00:00000860 B481            	  1131:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000862 6706            	  1132:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1133: 
                            	  1134:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000864 363CDEAD        	  1135:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000868 6002            	  1136:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1137: .CHECKSUM_OK:
00:0000086A 4E75            	  1138:         RTS                         ; Retorna (ROM válida)
                            	  1139: 
                            	  1140: SYSTEM_HALT:
00:0000086C 46FC0700        	  1141:         MOVE.W  #$0700,SR        ; Desabilita interrupções
                            	  1142: .INFINITE_LOOP:
00:00000870 60FE            	  1143:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1144: 
                            	  1145: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1146: VALIDATE_ROM_CRC32:
00:00000872 91C8            	  1147:         LEA     ROM_START,A0        ; Endereço inicial
00:00000874 203C00003FFC    	  1148:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
00:0000087A 72FF            	  1149:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1150: 
                            	  1151: CRC_LOOP:
00:0000087C 1418            	  1152:         MOVE.B  (A0)+,D2            ; Lê 1 byte
00:0000087E B501            	  1153:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1154: 
                            	  1155:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1156:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1157: 
00:00000880 5380            	  1158:         SUBQ.L  #1,D0
00:00000882 6EF8            	  1159:         BGT     CRC_LOOP
                            	  1160: 
00:00000884 4681            	  1161:         NOT.L   D1                  ; Inverte os bits no final
                            	  1162: 
                            	  1163:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:00000886 24383FFB        	  1164:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:0000088A B481            	  1165:         CMP.L   D1,D2               ; Combina com o calculado?
00:0000088C 6706            	  1166:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1167: 
                            	  1168:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:0000088E 363CDEAD        	  1169:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000892 60D8            	  1170:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1171: .CHECKSUM_OK:
00:00000894 4E75            	  1172:         RTS
                            	  1173: 
                            	  1174: ; --- Constantes ---
                            	  1175: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1176: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1177: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1178: 
                            	  1179: 
                            	  1180:     ALIGN 2
                            	  1181: ; =====================================================================
                            	  1182: ; END XMODEM RECEIVER ROUTINE
                            	  1183: ; =====================================================================
