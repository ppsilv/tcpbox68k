                            	   193: ; ----------------------------------------------------------------------
                            	   194: ; UART_WriteString - Envia string terminada em null para UART
                            	   195: ; Entrada:
                            	   196: ;   A0 = Ponteiro para a string (endereço da string)
                            	   197: ; ----------------------------------------------------------------------
                            	   198: UART_WriteString:
00:00000188 2F08            	   199:     MOVE.L  A0,-(SP)      ; Preserva D0
00:0000018A 2F00            	   200:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   201: .WriteLoop:
00:0000018C 1018            	   202:     MOVE.B  (A0)+,D0      ; Pega caractere
00:0000018E 6706            	   203:     BEQ     .Done
00:00000190 4EB80134        	   204:     JSR     UART_WriteChar ; Use sua rotine existente
00:00000194 60F6            	   205:     BRA     .WriteLoop
                            	   206: .Done:
00:00000196 201F            	   207:     MOVE.L  (SP)+,D0
00:00000198 205F            	   208:     MOVE.L  (SP)+,A0
00:0000019A 4E75            	   209:     RTS
