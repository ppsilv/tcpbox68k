00:0000067E 32390008101E    	   903:     MOVE.W  BUFFER_TAIL,D1
00:00000684 10301000        	   904:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   905: 
00:00000688 5401            	   906:     ADDQ.B  #2,D1              ; Incrementa como word
00:0000068A 024100FF        	   907:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000068E 33C10008101E    	   908:     MOVE.W  D1,BUFFER_TAIL
                            	   909: 
00:00000694 537900081022    	   910:     SUBQ.W  #1,BUFFER_COUNT
00:0000069A 6006            	   911:     BRA     .Exit
                            	   912: 
                            	   913: .BufferEmpty:
00:0000069C 4EB806A8        	   914:     JSR     FBufferEmpty
00:000006A0 70FF            	   915:     MOVEQ   #-1,D0
                            	   916: .Exit:
00:000006A2 205F            	   917:     MOVE.L  (SP)+,A0
00:000006A4 221F            	   918:     MOVE.L  (SP)+,D1
00:000006A6 4E75            	   919:     RTS
                            	   920: 
                            	   921: FBufferEmpty:
00:000006A8 4EB80270        	   922:         JSR     new_line
00:000006AC 41F90000038F    	   923:         LEA     BufferEmpty,A0
