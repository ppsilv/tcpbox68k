                            	   710: ; ----------------------------------------------------------------------
                            	   711: ; Rotinas Auxiliares
                            	   712: ; ----------------------------------------------------------------------
                            	   713: 
                            	   714: ; Lê número hexadecimal (retorna em D0)
                            	   715: UART_ReadHex1:
00:0000051E 2F01            	   716:         MOVE.L  D1,-(SP)
00:00000520 2F02            	   717:         MOVE.L  D2,-(SP)
                            	   718: 
00:00000522 41F900000332    	   719:         LEA     WritePrompt,A0
00:00000528 4EB801D0        	   720:         JSR     UART_WriteString
                            	   721: 
00:0000052C 4EB80270        	   722:         JSR     new_line
                            	   723: 
00:00000530 7000            	   724:         MOVEQ   #0,D0
00:00000532 7200            	   725:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:00000534 7400            	   726:         MOVEQ   #0,D2            ; Resultado em D2
                            	   727: 
                            	   728: .Loop:
00:00000536 4EB801B6        	   729:         JSR     UART_ReadChar
00:0000053A B03C000D        	   730:         CMP.B   #13,D0
00:0000053E 670C            	   731:         BEQ     .Done
00:00000540 B03C000A        	   732:         CMP.B   #10,D0
00:00000544 6706            	   733:         BEQ     .Done
00:00000546 4EB80634        	   734:         JSR     BufferPut
00:0000054A 60EA            	   735:         BRA     .Loop
                            	   736: .Done:
                            	   737: ;         BSR     UART_BufferGet
                            	   738: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   739: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   740: ;         Senão, D0 contém o byte lido!
                            	   741: .loop1:
00:0000054C 4EB8066C        	   742:     JSR     BufferGet
00:00000550 B03C00FF        	   743:     CMP.B   #-1,D0          ; Buffer vazio?
00:00000554 6706            	   744:     BEQ     .fim      ; Se sim, ignora
00:00000556 4EB8019C        	   745:     JSR     UART_WriteChar
00:0000055A 60F0            	   746:     BRA     .loop1
                            	   747: .fim:
00:0000055C 241F            	   748:     MOVE.L  (SP)+,D2
00:0000055E 221F            	   749:     MOVE.L  (SP)+,D1
00:00000560 4EB80270        	   750:     JSR     new_line
00:00000564 6000FB06        	   751:     bra     MenuLoop ;provisoriamente
00:00000568 4E75            	   752:     RTS
                            	   753: 
                            	   754: ; Lê número hexadecimal (retorna em D0)
                            	   755: UART_ReadHex:
