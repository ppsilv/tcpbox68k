                            	   660: ; 3. Carrega programa via serial
                            	   661: LoadProgram:
                            	   662: 
00:0000049A 41F90000000D    	   663:     LEA    xSOH,A0
00:000004A0 4EB801D0        	   664:     JSR     UART_WriteString
00:000004A4 41F900000012    	   665:     LEA    xEOT,A0
00:000004AA 4EB801D0        	   666:     JSR     UART_WriteString
00:000004AE 41F900000017    	   667:     LEA    xACK,A0
00:000004B4 4EB801D0        	   668:     JSR     UART_WriteString
00:000004B8 41F90000001C    	   669:     LEA    xNAK,A0
00:000004BE 4EB801D0        	   670:     JSR     UART_WriteString
00:000004C2 41F900000021    	   671:     LEA    xCAN,A0
00:000004C8 4EB801D0        	   672:     JSR     UART_WriteString
                            	   673: 
                            	   674:     ;LEA     DEST_BUFFER,A0   ; Onde os dados serão salvos
                            	   675:     ;MOVE.L  A0,user_buffer_ptr
                            	   676:     ;JSR     XMODEM_Receive
                            	   677: 
00:000004CC 6000FB9E        	   678:     BRA     MenuLoop
                            	   679: ; 4. Grava programa manualmente (hex)
                            	   680: WriteProgram:
00:000004D0 41F900000332    	   681:     LEA     WritePrompt,A0
00:000004D6 4EB801D0        	   682:     JSR     UART_WriteString
00:000004DA 4EB8056A        	   683:     JSR     UART_ReadHex        ; Lê endereço
00:000004DE 2240            	   684:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   685: 
00:000004E0 41F900000342    	   686:     LEA     WriteSizePrompt,A0
00:000004E6 4EB801D0        	   687:     JSR     UART_WriteString
00:000004EA 4EB8056A        	   688:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:000004EE 2200            	   689:     MOVE.L  D0,D1               ; D1 = contador
                            	   690: 
                            	   691: .WriteLoop:
00:000004F0 4EB8060A        	   692:     JSR     UART_ReadByte       ; Lê byte
00:000004F4 12C0            	   693:     MOVE.B  D0,(A1)+            ; Armazena
00:000004F6 5381            	   694:     SUBQ.L  #1,D1
00:000004F8 66F6            	   695:     BNE     .WriteLoop
                            	   696: 
00:000004FA 41F900000354    	   697:     LEA     WriteDoneMsg,A0
00:00000500 4EB801D0        	   698:     JSR     UART_WriteString
00:00000504 6000FB66        	   699:     BRA     MenuLoop
                            	   700: 
                            	   701: ; 5. Executa programa na RAM
                            	   702: RunProgram:
00:00000508 41F90000036E    	   703:     LEA     RunPrompt,A0
00:0000050E 4EB801D0        	   704:     JSR     UART_WriteString
