                            	   288: ; ----------------------------------------------------------------------
                            	   289: ; Rotinas de E/S da UART
                            	   290: ; ----------------------------------------------------------------------
                            	   291: 
                            	   292: UART_INIT:
01:000011F4 227900081010    	   293:         move.l   CurrentUART,a1
01:000011FA 137C000D0004    	   294:         move.b  #%00001101,FCR(a1)      ; enable FIFO
01:00001200 137C00830006    	   295:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
01:00001206 12BC0068        	   296:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
01:0000120A 137C00000002    	   297:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
01:00001210 08A900070006    	   298:         bclr.b  #7,LCR(a1)              ; disable divisor latch
01:00001216 4229000E        	   299:         clr.b   SCR(a1)                 ; clear the scratch register
01:0000121A 4E75            	   300:         RTS
                            	   301: 
                            	   302:     ; Escreve caractere (D0.B)
                            	   303: UART_WriteChar:
01:0000121C 2F08            	   304:         MOVE.L  A0,-(SP)        ; Preserva A0
01:0000121E 2F00            	   305:         MOVE.L  D0,-(SP)        ; Preserva D0
01:00001220 207900081010    	   306:         move.l   CurrentUART,A0
                            	   307: .WaitTx:
01:00001226 08280005000A    	   308:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
01:0000122C 67F8            	   309:         BEQ     .WaitTx
01:0000122E 1080            	   310:         MOVE.B  D0,THR(A0)      ; transmit byte
01:00001230 201F            	   311:         MOVE.L  (SP)+,D0        ;Restaura D0
01:00001232 205F            	   312:         MOVE.L  (SP)+,A0        ;Restaura A0
01:00001234 4E75            	   313:         RTS
                            	   314: 
                            	   315: 
                            	   316: ; Lê caractere (retorna em D0)
                            	   317: UART_ReadChar:
01:00001236 2F08            	   318:         MOVE.L  A0,-(SP)        ; Preserva A0
01:00001238 207900081010    	   319:         MOVE.L   CurrentUART,A0
                            	   320: .WaitRx:
01:0000123E 08280000000A    	   321:         BTST    #0,LSR(A0)        ; RX ready?
01:00001244 67F8            	   322:         BEQ     .WaitRx
01:00001246 1010            	   323:         MOVE.B  RHR(A0),D0
01:00001248 205F            	   324:         MOVE.L  (SP)+,A0        ;Restaura A0
01:0000124A B03C001B        	   325:         CMP.B   #$1b,D0
01:0000124E 6704            	   326:         BEQ     .fim
01:00001250 4EB8121C        	   327:         JSR     UART_WriteChar
                            	   328: .fim
01:00001254 4E75            	   329:         RTS
                            	   330: 
                            	   331: ; Lê caractere (retorna em D0)
                            	   332: UART_ReadCharNonEcho:
01:00001256 2F08            	   333:         MOVE.L  A0,-(SP)        ; Preserva A0
01:00001258 207900081010    	   334:         MOVE.L  CurrentUART,A0
                            	   335: .WaitRx:
01:0000125E 08280000000A    	   336:         BTST    #0,LSR(A0)        ; RX ready?
01:00001264 67F8            	   337:         BEQ     .WaitRx
                            	   338: 
01:00001266 1010            	   339:         MOVE.B  RHR(A0),D0
01:00001268 205F            	   340:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   341: 
01:0000126A 4E75            	   342:         RTS
                            	   343: 
                            	   344: ; ----------------------------------------------------------------------
                            	   345: ; UART_WriteString - Envia string terminada em null para UART
                            	   346: ; Entrada:
                            	   347: ;   A0 = Ponteiro para a string (endereço da string)
                            	   348: ; ----------------------------------------------------------------------
                            	   349: UART_WriteString:
01:0000126C 2F08            	   350:         MOVE.L  A0,-(SP)      ; Preserva D0
01:0000126E 2F00            	   351:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   352: .WriteLoop:
01:00001270 1018            	   353:         MOVE.B  (A0)+,D0      ; Pega caractere
01:00001272 6706            	   354:         BEQ     .Done
01:00001274 4EB8121C        	   355:         JSR     UART_WriteChar ; Use sua rotine existente
01:00001278 60F6            	   356:         BRA     .WriteLoop
                            	   357: .Done:
01:0000127A 201F            	   358:         MOVE.L  (SP)+,D0
01:0000127C 205F            	   359:         MOVE.L  (SP)+,A0
01:0000127E 4E75            	   360:         RTS
                            	   361: 
                            	   362: ; ----------------------------------------------------------------------
                            	   363: ; Constantes
                            	   364: ; ----------------------------------------------------------------------
                            	   365: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   366: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   367:                               ; BAUD_DIV_L em $70000
                            	   368:                               ; BAUD_DIV_U em $70001
                            	   369: 
                            	   370: ; ----------------------------------------------------------------------
                            	   371: ; Rotina: Calcula e armazena divisor de baud rate
                            	   372: ; Entrada:
                            	   373: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   374: ; Saída:
                            	   375: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   376: ; Formulas:
                            	   377: ;
                            	   378: ;
                            	   379: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   380: ; ----------------------------------------------------------------------
                            	   381: 
                            	   382: CALCBAUDDIV:
                            	   383: ;[ Registrador D0 (32 bits) ]
                            	   384: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   385: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   386:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   387:         ;((F_CPU/16)/10)
                            	   388:         ;F_CPU = 16000000 ou 0xF42400
01:00001280 203C00F42400    	   389:         MOVE.L  #F_CPU,D0
01:00001286 323C0010        	   390:         MOVE.W  #16,D1         ; Divisor
01:0000128A 61000096        	   391:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   392: ;1
01:0000128E 2F00            	   393:         move.l  d0,-(SP)
01:00001290 4EB8148A        	   394:         jsr     PrintHexAddress
01:00001294 4EB8130C        	   395:         jsr     new_line
01:00001298 201F            	   396:         move.l  (SP)+,d0
                            	   397: 
01:0000129A 323C000A        	   398:         MOVE.W  #10,D1         ; Divisor
01:0000129E 61000082        	   399:         BSR     Div32x16       ; D0 = 0x186A0
                            	   400: ;2
01:000012A2 2F00            	   401:         move.l  d0,-(SP)
01:000012A4 4EB8148A        	   402:         jsr     PrintHexAddress
01:000012A8 4EB8130C        	   403:         jsr     new_line
01:000012AC 201F            	   404:         move.l  (SP)+,d0
                            	   405: 
                            	   406:         ;(BAUD/10)
01:000012AE 2F00            	   407:         move.l  d0,-(SP)
                            	   408: ;3
01:000012B0 7000            	   409:         CLR.L   D0
01:000012B2 303900081014    	   410:         MOVE.W  CurrentBaudRate,D0
01:000012B8 2F00            	   411:         move.l  d0,-(SP)
01:000012BA 4EB8148A        	   412:         jsr     PrintHexAddress
01:000012BE 4EB8130C        	   413:         jsr     new_line
01:000012C2 201F            	   414:         move.l  (SP)+,d0
                            	   415: 
01:000012C4 123C000A        	   416:         MOVE.B  #10,D1
01:000012C8 6158            	   417:         BSR     Div32x16
                            	   418: 
                            	   419: ;4
01:000012CA 2F00            	   420:         move.l  d0,-(SP)
01:000012CC 4EB8148A        	   421:         jsr     PrintHexAddress
01:000012D0 4EB8130C        	   422:         jsr     new_line
01:000012D4 221F            	   423:         move.l  (SP)+,D1
01:000012D6 201F            	   424:         move.l  (SP)+,D0
                            	   425: 
                            	   426: 
                            	   427:         ;(F_CPU/BAUD)
01:000012D8 6148            	   428:         BSR     Div32x16
                            	   429: ;5
01:000012DA 2F00            	   430:         move.l  d0,-(SP)
01:000012DC 4EB8148A        	   431:         jsr     PrintHexAddress
01:000012E0 4EB8130C        	   432:         jsr     new_line
01:000012E4 201F            	   433:         move.l  (SP)+,d0
                            	   434: 
                            	   435:         ; 4. Separa parte alta/baixa corretamente
01:000012E6 3200            	   436:         MOVE.W  D0,D1
01:000012E8 024000FF        	   437:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
01:000012EC E049            	   438:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
01:000012EE 024100FF        	   439:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   440: 
                            	   441:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
01:000012F2 41F90008101A    	   442:         LEA     Baud1DivL,A0
01:000012F8 3080            	   443:         MOVE.W  D0,(A0)        ; 16 bits suficientes
01:000012FA 41F90008101C    	   444:         LEA     Baud1DivH,A0
01:00001300 3081            	   445:         MOVE.W  D1,(A0)
                            	   446: 
01:00001302 6000FDB0        	   447:         BRA     MenuLoop
01:00001306 4E75            	   448:         RTS
                            	   449: .BaudError:
01:00001308 6000FCF6        	   450:         BRA     _start
                            	   451: 
                            	   452: new_line:
01:0000130C 2F00            	   453:         MOVE.L  D0,-(SP)          ; Salva D0
01:0000130E 103C000A        	   454:         MOVE.B  #10,D0
01:00001312 4EB8121C        	   455:         JSR     UART_WriteChar
01:00001316 103C000D        	   456:         MOVE.B  #13,D0
01:0000131A 4EB8121C        	   457:         JSR     UART_WriteChar
01:0000131E 201F            	   458:         MOVE.L  (SP)+,D0          ; Restaura D0
01:00001320 4E75            	   459:         RTS
                            	   460: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   461: ; Retorna D0 = Quociente, D1 = Resto
                            	   462: Div32x16:
01:00001322 7400            	   463:         MOVEQ   #0,D2       ; D2 = Quociente
01:00001324 761F            	   464:         MOVEQ   #31,D3      ; 32 iterações
                            	   465: DivLoop:
01:00001326 E388            	   466:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
01:00001328 E392            	   467:         ROXL.L  #1,D2       ; Desloca D2 com Carry
01:0000132A B441            	   468:         CMP.W   D1,D2       ; D2 >= D1?
01:0000132C 6D04            	   469:         BLT     .skip
01:0000132E 9441            	   470:         SUB.W   D1,D2       ; Sim, subtrai
01:00001330 5280            	   471:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   472: .skip:
01:00001332 51CBFFF2        	   473:         DBRA    D3,DivLoop  ; Repete
01:00001336 2202            	   474:         MOVE.L  D2,D1       ; Resto em D1
01:00001338 4E75            	   475:         RTS
                            	   476: ; Versão compacta sem stack frame
                            	   477: PrintHexFast:
01:0000133A 2F02            	   478:         MOVE.L  D2,-(SP)          ; Salva D2
01:0000133C 2F00            	   479:         MOVE.L  D0,-(SP)          ; Salva D0 original
01:0000133E 7407            	   480:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   481: 
                            	   482: .Loop:
01:00001340 2017            	   483:         MOVE.L  (SP),D0           ; Recupera valor original
01:00001342 E998            	   484:         ROL.L   #4,D0             ; Pega próximo nibble
01:00001344 2E80            	   485:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
01:00001346 0200000F        	   486:         ANDI.B  #$F,D0            ; Isola nibble
                            	   487: 
01:0000134A B03C0009        	   488:         CMP.B   #9,D0
01:0000134E 6302            	   489:         BLS     .Digit
01:00001350 5E00            	   490:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   491: .Digit:
01:00001352 D03C0030        	   492:         ADD.B   #'0',D0           ; Converte para ASCII
01:00001356 4EB8121C        	   493:         JSR     UART_WriteChar    ; Envia caractere
                            	   494: 
01:0000135A 51CAFFE4        	   495:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   496: 
01:0000135E 588F            	   497:         ADDQ.L  #4,SP             ; Remove valor salvo
01:00001360 241F            	   498:         MOVE.L  (SP)+,D2          ; Restaura D2
01:00001362 4E75            	   499:         RTS
                            	   500: 
                            	   501: ; ----------------------------------------------------------------------
                            	   502: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   503: ; Entrada:
                            	   504: ;   D0.L = Valor a ser impresso (32 bits)
                            	   505: ;   D1.W = Número de dígitos (1-8)
                            	   506: ; ----------------------------------------------------------------------
                            	   507: PrintHexPRECISA_DE_REVISAO:
01:00001364 4E56FFF8        	   508:         LINK    A6,#-8            ; Reserva espaço na pilha
01:00001368 2F02            	   509:         MOVE.L  D2,-(SP)          ; Salva D2
01:0000136A 2D40FFFC        	   510:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
01:0000136E 3D41FFFA        	   511:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   512: 
01:00001372 323C0008        	   513:         MOVE.W  #$0008,D1
                            	   514: 
                            	   515:         ; Ajusta para começar pelo dígito mais significativo
01:00001376 E549            	   516:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
01:00001378 5941            	   517:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   518: 
                            	   519: .PrintLoop:
01:0000137A 202EFFFC        	   520:         MOVE.L  -4(A6),D0         ; Recupera valor
01:0000137E 3401            	   521:         MOVE.W  D1,D2             ; Posição do nibble
01:00001380 E5B8            	   522:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
01:00001382 02800000000F    	   523:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   524: 
                            	   525:         ; Converte para ASCII
01:00001388 B03C0009        	   526:         CMP.B   #9,D0
01:0000138C 6302            	   527:         BLS     .Decimal
01:0000138E 5E00            	   528:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   529: .Decimal:
01:00001390 D03C0030        	   530:         ADD.B   #'0',D0           ; Converte para caractere
                            	   531: 
                            	   532:         ; Imprime caractere
01:00001394 4EB8121C        	   533:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   534: 
01:00001398 5941            	   535:         SUBQ.W  #4,D1             ; Próximo nibble
01:0000139A 6ADE            	   536:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   537: 
                            	   538:         ; Espaço final para separação
01:0000139C 103C0020        	   539:         MOVE.B  #' ',D0
01:000013A0 4EB8121C        	   540:         JSR     UART_WriteChar
                            	   541: 
01:000013A4 241F            	   542:         MOVE.L  (SP)+,D2          ; Restaura D2
01:000013A6 4E5E            	   543:         UNLK    A6                ; Restaura frame
01:000013A8 4E75            	   544:         RTS
                            	   545: 
                            	   546: ; ----------------------------------------------------------------------
                            	   547: ; MemDump - Imprime dump de memória formatado
                            	   548: ; Entrada:
                            	   549: ;   A0 = Endereço inicial (ex: $80000)
                            	   550: ;   D0 = Quantidade de bytes (ex: 256)
                            	   551: ; ----------------------------------------------------------------------
                            	   552: MEMDUMP:
01:000013AA 41F90000000D    	   553:         LEA     DumpHeader,A0
01:000013B0 4EB8126C        	   554:         JSR     UART_WriteString
01:000013B4 20790008101E    	   555:         MOVE.L  (addressInHex),A0
01:000013BA 2008            	   556:         MOVE.L  A0,D0
01:000013BC 4EB8148A        	   557:         JSR     PrintHexAddress
01:000013C0 4EB8130C        	   558:         JSR     new_line
                            	   559: 
01:000013C4 41F900000020    	   560:         LEA     DumpHeader1,A0
01:000013CA 4EB8126C        	   561:         JSR     UART_WriteString
                            	   562: 
01:000013CE 20790008101E    	   563:         MOVE.L  (addressInHex),A0
                            	   564:         ; Calcula endereço final
                            	   565: 
                            	   566: DUMPLOOPMASTER:
01:000013D4 7200            	   567:         CLR.L   D1
01:000013D6 2208            	   568:         MOVE.L  A0,D1
01:000013D8 0681000000FF    	   569:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   570:         ;MOVE.L  D1,D0
                            	   571:         ;JSR     PrintHexAddress
                            	   572:         ;JSR     new_line
                            	   573: 
                            	   574:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   575:         ;JSR     UART_ReadChar
                            	   576: 
                            	   577: 
                            	   578: DumpLoop:
                            	   579:         ; Nova linha a cada 16 bytes
01:000013DE 2008            	   580:         MOVE.L  A0,D0
01:000013E0 02800000000F    	   581:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
01:000013E6 6616            	   582:         BNE     NoNewLine
                            	   583: 
                            	   584:         ; Imprime endereço
01:000013E8 2008            	   585:         MOVE.L  A0,D0
01:000013EA 4EB8148A        	   586:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   587: 
01:000013EE 103C003A        	   588:         MOVE.B  #':',D0
01:000013F2 4EB8121C        	   589:         JSR     UART_WriteChar
01:000013F6 103C0020        	   590:         MOVE.B  #' ',D0
01:000013FA 4EB8121C        	   591:         JSR     UART_WriteChar
                            	   592: 
                            	   593: NoNewLine:
                            	   594:         ; Imprime byte em hex
01:000013FE 1018            	   595:         MOVE.B  (A0)+,D0
01:00001400 4EB8149A        	   596:         JSR     PrintByteHex
                            	   597: 
01:00001404 103C0020        	   598:         MOVE.B  #' ',D0
01:00001408 4EB8121C        	   599:         JSR     UART_WriteChar
                            	   600: 
                            	   601:         ; Verifica fim da linha (16 bytes)
01:0000140C 2008            	   602:         MOVE.L  A0,D0
01:0000140E 02800000000F    	   603:         ANDI.L  #$0000000F,D0
01:00001414 664E            	   604:         BNE     NoEndLine
                            	   605: 
                            	   606:         ; Imprime caracteres ASCII
01:00001416 103C0020        	   607:         MOVE.B  #' ',D0
01:0000141A 4EB8121C        	   608:         JSR     UART_WriteChar
01:0000141E 103C007C        	   609:         MOVE.B  #'|',D0
01:00001422 4EB8121C        	   610:         JSR     UART_WriteChar
                            	   611: 
01:00001426 43E8FFF0        	   612:         LEA     -16(A0),A1        ; Volta ao início da linha
01:0000142A 740F            	   613:         MOVEQ   #15,D2            ; 16 caracteres
                            	   614: 
                            	   615: AsciiLoop:
01:0000142C 1019            	   616:         MOVE.B  (A1)+,D0
01:0000142E B03C0020        	   617:         CMP.B   #32,D0            ; Verifica se é imprimível
01:00001432 6D0C            	   618:         BLT     NonPrintable
01:00001434 B03C007E        	   619:         CMP.B   #126,D0
01:00001438 6E06            	   620:         BGT     NonPrintable
                            	   621: 
01:0000143A 4EB8121C        	   622:         JSR     UART_WriteChar
01:0000143E 6008            	   623:         BRA     NextAscii
                            	   624: 
                            	   625: NonPrintable:
01:00001440 103C002E        	   626:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
01:00001444 4EB8121C        	   627:         JSR     UART_WriteChar
                            	   628: 
                            	   629: NextAscii:
01:00001448 51CAFFE2        	   630:         DBRA    D2,AsciiLoop
                            	   631: 
01:0000144C 103C007C        	   632:         MOVE.B  #'|',D0
01:00001450 4EB8121C        	   633:         JSR     UART_WriteChar
01:00001454 103C000D        	   634:         MOVE.B  #13,D0            ; CR
01:00001458 4EB8121C        	   635:         JSR     UART_WriteChar
01:0000145C 103C000A        	   636:         MOVE.B  #10,D0            ; LF
01:00001460 4EB8121C        	   637:         JSR     UART_WriteChar
                            	   638: 
                            	   639: NoEndLine:
                            	   640:         ; Verifica fim do dump
01:00001464 B1C1            	   641:         CMP.L   D1,A0
01:00001466 6300FF76        	   642:         BLS     DumpLoop
                            	   643: 
01:0000146A 2F08            	   644:         MOVE.L  A0,-(SP)          ; Salva endereço atual
01:0000146C 41F900000425    	   645:         LEA     HitAnyKey,A0
01:00001472 4EB8126C        	   646:         JSR     UART_WriteString
01:00001476 4EB81236        	   647:         JSR     UART_ReadChar
01:0000147A B03C001B        	   648:         CMP.B   #$1B,D0
01:0000147E 6706            	   649:         BEQ     .fim
                            	   650: 
01:00001480 205F            	   651:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
01:00001482 6000FF50        	   652:         BRA     DUMPLOOPMASTER
                            	   653: .fim
01:00001486 6000FC2C        	   654:         BRA     MenuLoop
