                            	   228: ; ----------------------------------------------------------------------
                            	   229: ; Constantes
                            	   230: ; ----------------------------------------------------------------------
                            	   231: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   232: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   233:                               ; BAUD_DIV_L em $70000
                            	   234:                               ; BAUD_DIV_U em $70001
                            	   235: 
                            	   236: ; ----------------------------------------------------------------------
                            	   237: ; Rotina: Calcula e armazena divisor de baud rate
                            	   238: ; Entrada:
                            	   239: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   240: ; Saída:
                            	   241: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   242: ; Formulas:
                            	   243: ;
                            	   244: ;
                            	   245: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   246: ; ----------------------------------------------------------------------
                            	   247: 
                            	   248: CALCBAUDDIV:
                            	   249: ;[ Registrador D0 (32 bits) ]
                            	   250: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   251: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   252:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   253:         ;((F_CPU/16)/10)
                            	   254:         ;F_CPU = 16000000 ou 0xF42400
00:000001D6 203C00F42400    	   255:         MOVE.L  #F_CPU,D0
00:000001DC 323C0010        	   256:         MOVE.W  #16,D1         ; Divisor
00:000001E0 61000096        	   257:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   258: ;1
00:000001E4 2F00            	   259:         move.l  d0,-(SP)
00:000001E6 4EB803E0        	   260:         jsr     PrintHexAddress
00:000001EA 4EB80262        	   261:         jsr     new_line
00:000001EE 201F            	   262:         move.l  (SP)+,d0
                            	   263: 
00:000001F0 323C000A        	   264:         MOVE.W  #10,D1         ; Divisor
00:000001F4 61000082        	   265:         BSR     Div32x16       ; D0 = 0x186A0
                            	   266: ;2
00:000001F8 2F00            	   267:         move.l  d0,-(SP)
00:000001FA 4EB803E0        	   268:         jsr     PrintHexAddress
00:000001FE 4EB80262        	   269:         jsr     new_line
00:00000202 201F            	   270:         move.l  (SP)+,d0
                            	   271: 
                            	   272:         ;(BAUD/10)
00:00000204 2F00            	   273:         move.l  d0,-(SP)
                            	   274: ;3
00:00000206 7000            	   275:         CLR.L   D0
00:00000208 30390008100C    	   276:         MOVE.W  CurrentBaudRate,D0
00:0000020E 2F00            	   277:         move.l  d0,-(SP)
00:00000210 4EB803E0        	   278:         jsr     PrintHexAddress
00:00000214 4EB80262        	   279:         jsr     new_line
00:00000218 201F            	   280:         move.l  (SP)+,d0
                            	   281: 
00:0000021A 123C000A        	   282:         MOVE.B  #10,D1
00:0000021E 6158            	   283:         BSR     Div32x16
                            	   284: 
                            	   285: ;4
00:00000220 2F00            	   286:         move.l  d0,-(SP)
00:00000222 4EB803E0        	   287:         jsr     PrintHexAddress
00:00000226 4EB80262        	   288:         jsr     new_line
00:0000022A 221F            	   289:         move.l  (SP)+,D1
00:0000022C 201F            	   290:         move.l  (SP)+,D0
                            	   291: 
                            	   292: 
                            	   293:         ;(F_CPU/BAUD)
00:0000022E 6148            	   294:         BSR     Div32x16
                            	   295: ;5
00:00000230 2F00            	   296:         move.l  d0,-(SP)
00:00000232 4EB803E0        	   297:         jsr     PrintHexAddress
00:00000236 4EB80262        	   298:         jsr     new_line
00:0000023A 201F            	   299:         move.l  (SP)+,d0
                            	   300: 
                            	   301:         ; 4. Separa parte alta/baixa corretamente
00:0000023C 3200            	   302:         MOVE.W  D0,D1
00:0000023E 024000FF        	   303:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000242 E049            	   304:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:00000244 024100FF        	   305:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   306: 
                            	   307:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000248 41F900081012    	   308:         LEA     Baud1DivL,A0
00:0000024E 3080            	   309:         MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000250 41F900081014    	   310:         LEA     Baud1DivH,A0
00:00000256 3081            	   311:         MOVE.W  D1,(A0)
                            	   312: 
00:00000258 6000FE2E        	   313:         BRA     MenuLoop
00:0000025C 4E75            	   314:         RTS
                            	   315: .BaudError:
00:0000025E 6000FDC0        	   316:         BRA     _start
                            	   317: 
                            	   318: new_line:
00:00000262 2F00            	   319:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000264 103C000A        	   320:         MOVE.B  #10,D0
00:00000268 4EB80172        	   321:         JSR     UART_WriteChar
00:0000026C 103C000D        	   322:         MOVE.B  #13,D0
00:00000270 4EB80172        	   323:         JSR     UART_WriteChar
00:00000274 201F            	   324:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000276 4E75            	   325:         RTS
                            	   326: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   327: ; Retorna D0 = Quociente, D1 = Resto
                            	   328: Div32x16:
00:00000278 7400            	   329:         MOVEQ   #0,D2       ; D2 = Quociente
00:0000027A 761F            	   330:         MOVEQ   #31,D3      ; 32 iterações
                            	   331: DivLoop:
00:0000027C E388            	   332:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000027E E392            	   333:         ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000280 B441            	   334:         CMP.W   D1,D2       ; D2 >= D1?
00:00000282 6D04            	   335:         BLT     .skip
00:00000284 9441            	   336:         SUB.W   D1,D2       ; Sim, subtrai
00:00000286 5280            	   337:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   338: .skip:
00:00000288 51CBFFF2        	   339:         DBRA    D3,DivLoop  ; Repete
00:0000028C 2202            	   340:         MOVE.L  D2,D1       ; Resto em D1
00:0000028E 4E75            	   341:         RTS
                            	   342: ; Versão compacta sem stack frame
                            	   343: PrintHexFast:
00:00000290 2F02            	   344:         MOVE.L  D2,-(SP)          ; Salva D2
00:00000292 2F00            	   345:         MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000294 7407            	   346:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   347: 
                            	   348: .Loop:
00:00000296 2017            	   349:         MOVE.L  (SP),D0           ; Recupera valor original
00:00000298 E998            	   350:         ROL.L   #4,D0             ; Pega próximo nibble
00:0000029A 2E80            	   351:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:0000029C 0200000F        	   352:         ANDI.B  #$F,D0            ; Isola nibble
                            	   353: 
00:000002A0 B03C0009        	   354:         CMP.B   #9,D0
00:000002A4 6302            	   355:         BLS     .Digit
00:000002A6 5E00            	   356:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   357: .Digit:
00:000002A8 D03C0030        	   358:         ADD.B   #'0',D0           ; Converte para ASCII
00:000002AC 4EB80172        	   359:         JSR     UART_WriteChar    ; Envia caractere
                            	   360: 
00:000002B0 51CAFFE4        	   361:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   362: 
00:000002B4 588F            	   363:         ADDQ.L  #4,SP             ; Remove valor salvo
00:000002B6 241F            	   364:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002B8 4E75            	   365:         RTS
                            	   366: 
                            	   367: ; ----------------------------------------------------------------------
                            	   368: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   369: ; Entrada:
                            	   370: ;   D0.L = Valor a ser impresso (32 bits)
                            	   371: ;   D1.W = Número de dígitos (1-8)
                            	   372: ; ----------------------------------------------------------------------
                            	   373: PrintHexPRECISA_DE_REVISAO:
00:000002BA 4E56FFF8        	   374:         LINK    A6,#-8            ; Reserva espaço na pilha
00:000002BE 2F02            	   375:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002C0 2D40FFFC        	   376:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000002C4 3D41FFFA        	   377:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   378: 
00:000002C8 323C0008        	   379:         MOVE.W  #$0008,D1
                            	   380: 
                            	   381:         ; Ajusta para começar pelo dígito mais significativo
00:000002CC E549            	   382:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000002CE 5941            	   383:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   384: 
                            	   385: .PrintLoop:
00:000002D0 202EFFFC        	   386:         MOVE.L  -4(A6),D0         ; Recupera valor
00:000002D4 3401            	   387:         MOVE.W  D1,D2             ; Posição do nibble
00:000002D6 E5B8            	   388:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:000002D8 02800000000F    	   389:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   390: 
                            	   391:         ; Converte para ASCII
00:000002DE B03C0009        	   392:         CMP.B   #9,D0
00:000002E2 6302            	   393:         BLS     .Decimal
00:000002E4 5E00            	   394:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   395: .Decimal:
00:000002E6 D03C0030        	   396:         ADD.B   #'0',D0           ; Converte para caractere
                            	   397: 
                            	   398:         ; Imprime caractere
00:000002EA 4EB80172        	   399:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   400: 
00:000002EE 5941            	   401:         SUBQ.W  #4,D1             ; Próximo nibble
00:000002F0 6ADE            	   402:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   403: 
                            	   404:         ; Espaço final para separação
00:000002F2 103C0020        	   405:         MOVE.B  #' ',D0
00:000002F6 4EB80172        	   406:         JSR     UART_WriteChar
                            	   407: 
00:000002FA 241F            	   408:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002FC 4E5E            	   409:         UNLK    A6                ; Restaura frame
00:000002FE 4E75            	   410:         RTS
                            	   411: 
                            	   412: ; ----------------------------------------------------------------------
                            	   413: ; MemDump - Imprime dump de memória formatado
                            	   414: ; Entrada:
                            	   415: ;   A0 = Endereço inicial (ex: $80000)
                            	   416: ;   D0 = Quantidade de bytes (ex: 256)
                            	   417: ; ----------------------------------------------------------------------
                            	   418: MEMDUMP:
00:00000300 41F90000000D    	   419:         LEA     DumpHeader,A0
00:00000306 4EB801C2        	   420:         JSR     UART_WriteString
00:0000030A 207900081016    	   421:         MOVE.L  (addressInHex),A0
00:00000310 2008            	   422:         MOVE.L  A0,D0
00:00000312 4EB803E0        	   423:         JSR     PrintHexAddress
00:00000316 4EB80262        	   424:         JSR     new_line
                            	   425: 
00:0000031A 41F900000020    	   426:         LEA     DumpHeader1,A0
00:00000320 4EB801C2        	   427:         JSR     UART_WriteString
                            	   428: 
00:00000324 207900081016    	   429:         MOVE.L  (addressInHex),A0
                            	   430:         ; Calcula endereço final
                            	   431: 
                            	   432: DUMPLOOPMASTER:
00:0000032A 7200            	   433:         CLR.L   D1
00:0000032C 2208            	   434:         MOVE.L  A0,D1
00:0000032E 0681000000FF    	   435:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   436:         ;MOVE.L  D1,D0
                            	   437:         ;JSR     PrintHexAddress
                            	   438:         ;JSR     new_line
                            	   439: 
                            	   440:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   441:         ;JSR     UART_ReadChar
                            	   442: 
                            	   443: 
                            	   444: DumpLoop:
                            	   445:         ; Nova linha a cada 16 bytes
00:00000334 2008            	   446:         MOVE.L  A0,D0
00:00000336 02800000000F    	   447:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000033C 6616            	   448:         BNE     NoNewLine
                            	   449: 
                            	   450:         ; Imprime endereço
00:0000033E 2008            	   451:         MOVE.L  A0,D0
00:00000340 4EB803E0        	   452:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   453: 
00:00000344 103C003A        	   454:         MOVE.B  #':',D0
00:00000348 4EB80172        	   455:         JSR     UART_WriteChar
00:0000034C 103C0020        	   456:         MOVE.B  #' ',D0
00:00000350 4EB80172        	   457:         JSR     UART_WriteChar
                            	   458: 
                            	   459: NoNewLine:
                            	   460:         ; Imprime byte em hex
00:00000354 1018            	   461:         MOVE.B  (A0)+,D0
00:00000356 4EB803F0        	   462:         JSR     PrintByteHex
                            	   463: 
00:0000035A 103C0020        	   464:         MOVE.B  #' ',D0
00:0000035E 4EB80172        	   465:         JSR     UART_WriteChar
                            	   466: 
                            	   467:         ; Verifica fim da linha (16 bytes)
00:00000362 2008            	   468:         MOVE.L  A0,D0
00:00000364 02800000000F    	   469:         ANDI.L  #$0000000F,D0
00:0000036A 664E            	   470:         BNE     NoEndLine
                            	   471: 
                            	   472:         ; Imprime caracteres ASCII
00:0000036C 103C0020        	   473:         MOVE.B  #' ',D0
00:00000370 4EB80172        	   474:         JSR     UART_WriteChar
00:00000374 103C007C        	   475:         MOVE.B  #'|',D0
00:00000378 4EB80172        	   476:         JSR     UART_WriteChar
                            	   477: 
00:0000037C 43E8FFF0        	   478:         LEA     -16(A0),A1        ; Volta ao início da linha
00:00000380 740F            	   479:         MOVEQ   #15,D2            ; 16 caracteres
                            	   480: 
                            	   481: AsciiLoop:
00:00000382 1019            	   482:         MOVE.B  (A1)+,D0
00:00000384 B03C0020        	   483:         CMP.B   #32,D0            ; Verifica se é imprimível
00:00000388 6D0C            	   484:         BLT     NonPrintable
00:0000038A B03C007E        	   485:         CMP.B   #126,D0
00:0000038E 6E06            	   486:         BGT     NonPrintable
                            	   487: 
00:00000390 4EB80172        	   488:         JSR     UART_WriteChar
00:00000394 6008            	   489:         BRA     NextAscii
                            	   490: 
                            	   491: NonPrintable:
00:00000396 103C002E        	   492:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000039A 4EB80172        	   493:         JSR     UART_WriteChar
                            	   494: 
                            	   495: NextAscii:
00:0000039E 51CAFFE2        	   496:         DBRA    D2,AsciiLoop
                            	   497: 
00:000003A2 103C007C        	   498:         MOVE.B  #'|',D0
00:000003A6 4EB80172        	   499:         JSR     UART_WriteChar
00:000003AA 103C000D        	   500:         MOVE.B  #13,D0            ; CR
00:000003AE 4EB80172        	   501:         JSR     UART_WriteChar
00:000003B2 103C000A        	   502:         MOVE.B  #10,D0            ; LF
00:000003B6 4EB80172        	   503:         JSR     UART_WriteChar
                            	   504: 
                            	   505: NoEndLine:
                            	   506:         ; Verifica fim do dump
00:000003BA B1C1            	   507:         CMP.L   D1,A0
00:000003BC 6300FF76        	   508:         BLS     DumpLoop
                            	   509: 
00:000003C0 2F08            	   510:         MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003C2 41F9000003DF    	   511:         LEA     HitAnyKey,A0
00:000003C8 4EB801C2        	   512:         JSR     UART_WriteString
00:000003CC 4EB8018C        	   513:         JSR     UART_ReadChar
00:000003D0 B03C001B        	   514:         CMP.B   #$1B,D0
00:000003D4 6706            	   515:         BEQ     .fim
                            	   516: 
00:000003D6 205F            	   517:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000003D8 6000FF50        	   518:         BRA     DUMPLOOPMASTER
                            	   519: .fim
00:000003DC 6000FCAA        	   520:         BRA     MenuLoop
                            	   521: 
                            	   522: ; ----------------------------------------------------------------------
                            	   523: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   524: ; Entrada: D0 = endereço
                            	   525: ; ----------------------------------------------------------------------
                            	   526: PrintHexAddress:
00:000003E0 4840            	   527:         SWAP    D0                ; Imprime parte alta primeiro
00:000003E2 4EB803E8        	   528:         JSR     PrintWordHex
00:000003E6 4840            	   529:         SWAP    D0                ; Parte baixa
                            	   530:         ; Continua para PrintWordHex
                            	   531: 
                            	   532: ; ----------------------------------------------------------------------
                            	   533: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   534: ; Entrada: D0.w = valor
                            	   535: ; ----------------------------------------------------------------------
                            	   536: PrintWordHex:
00:000003E8 E158            	   537:         ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003EA 4EB803F0        	   538:         JSR     PrintByteHex
00:000003EE E058            	   539:         ROR.W   #8,D0             ; Byte menos significativo
                            	   540:         ; Continua para PrintByteHex
                            	   541: 
                            	   542: ; ----------------------------------------------------------------------
                            	   543: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   544: ; Entrada: D0.b = valor
                            	   545: ; ----------------------------------------------------------------------
                            	   546: PrintByteHex:
00:000003F0 1F00            	   547:         MOVE.B  D0,-(SP)          ; Salva byte original
00:000003F2 E808            	   548:         LSR.B   #4,D0             ; Nibble alto
00:000003F4 6106            	   549:         BSR     PrintNibble
00:000003F6 101F            	   550:         MOVE.B  (SP)+,D0          ; Recupera byte
00:000003F8 0200000F        	   551:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   552:         ; Continua para PrintNibble
                            	   553: ; ----------------------------------------------------------------------
                            	   554: ; PrintNibble - Imprime um nibble em hex
                            	   555: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   556: ; ----------------------------------------------------------------------
                            	   557: PrintNibble:
00:000003FC B03C0009        	   558:         CMP.B   #9,D0
00:00000400 6302            	   559:         BLS     .Decimal
00:00000402 5E00            	   560:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   561: .Decimal:
00:00000404 D03C0030        	   562:         ADD.B   #'0',D0
00:00000408 4EF80172        	   563:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   564: 
                            	   565: CLEARRAM:
00:0000040C 41F900080000    	   566:         LEA     $80000,A0
00:00000412 43F90008FFFF    	   567:         LEA     $8FFFF,A1
00:00000418 7000            	   568:         MOVEQ   #0,D0
                            	   569: .ClearLoop:
00:0000041A 20C0            	   570:         MOVE.L  D0,(A0)+
00:0000041C B3C8            	   571:         CMPA.L  A0,A1
00:0000041E 62FA            	   572:         BHI     .ClearLoop
00:00000420 4E75            	   573:         RTS
