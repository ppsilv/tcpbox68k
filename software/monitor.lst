                            	   945: ;--------------------------------------------------
                            	   946: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   947: ;--------------------------------------------------
                            	   948: ; Exemplo: insere 'A' no buffer
                            	   949: ;          MOVE.B  #'A',D0
                            	   950: ;          JSR     UART_BufferPut
                            	   951: 
                            	   952: BufferPut:
01:000016BA 2F01            	   953:         MOVE.L  D1,-(SP)
01:000016BC 2F08            	   954:         MOVE.L  A0,-(SP)
                            	   955: 
                            	   956:         ;ANDI.W    #$FF00,D0
01:000016BE 41F90008102C    	   957:         LEA     BUFFER,A0
01:000016C4 32390008102A    	   958:         MOVE.W  BUFFER_COUNT,D1
                            	   959: 
01:000016CA B27C0100        	   960:         CMP.W   #256,D1
01:000016CE 6C1C            	   961:         BGE     .BufferFull
                            	   962: 
                            	   963:         ; Modificado para usar deslocamento de 16 bits
01:000016D0 323900081022    	   964:         MOVE.W  BUFFER_HEAD,D1
01:000016D6 D0C1            	   965:         ADD     D1,A0
01:000016D8 1080            	   966:         MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   967: 
01:000016DA 5441            	   968:         ADD     #2,D1              ; Incrementa como word
01:000016DC 024100FF        	   969:         ANDI.W  #255,D1            ; Mantém no range 0-255
01:000016E0 33C100081022    	   970:         MOVE.W  D1,BUFFER_HEAD
                            	   971: 
01:000016E6 52790008102A    	   972:         ADDQ.W  #1,BUFFER_COUNT
                            	   973: 
                            	   974: .BufferFull:
01:000016EC 205F            	   975:         MOVE.L  (SP)+,A0
01:000016EE 221F            	   976:         MOVE.L  (SP)+,D1
                            	   977: 
01:000016F0 4E75            	   978:         RTS
                            	   979: 
                            	   980: ;--------------------------------------------------
                            	   981: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   982: ;--------------------------------------------------
                            	   983: ;Exemplo: Lendo byte do buffer
                            	   984: ;         BSR     UART_BufferGet
                            	   985: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   986: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   987: ;         Senão, D0 contém o byte lido!
                            	   988: BufferGet:
01:000016F2 2F01            	   989:         MOVE.L  D1,-(SP)
01:000016F4 2F08            	   990:         MOVE.L  A0,-(SP)
                            	   991: 
01:000016F6 32390008102A    	   992:         MOVE.W  BUFFER_COUNT,D1
01:000016FC 6724            	   993:         BEQ     .BufferEmpty
                            	   994: 
01:000016FE 41F90008102C    	   995:         LEA     BUFFER,A0
                            	   996: 
                            	   997:         ; Modificado para usar deslocamento de 16 bits
01:00001704 323900081026    	   998:         MOVE.W  BUFFER_TAIL,D1
01:0000170A 10301000        	   999:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	  1000: 
01:0000170E 5401            	  1001:         ADDQ.B  #2,D1              ; Incrementa como word
01:00001710 024100FF        	  1002:         ANDI.W  #255,D1            ; Mantém no range 0-255
01:00001714 33C100081026    	  1003:         MOVE.W  D1,BUFFER_TAIL
                            	  1004: 
01:0000171A 53790008102A    	  1005:         SUBQ.W  #1,BUFFER_COUNT
01:00001720 6006            	  1006:         BRA     .Exit
                            	  1007: 
                            	  1008: .BufferEmpty:
01:00001722 4EB8172E        	  1009:         JSR     FBufferEmpty
01:00001726 70FF            	  1010:         MOVEQ   #-1,D0
                            	  1011: .Exit:
01:00001728 205F            	  1012:         MOVE.L  (SP)+,A0
01:0000172A 221F            	  1013:         MOVE.L  (SP)+,D1
01:0000172C 4E75            	  1014:         RTS
                            	  1015: 
                            	  1016: FBufferEmpty:
01:0000172E 4EB8130C        	  1017:         JSR     new_line
01:00001732 41F9000003A7    	  1018:         LEA     BufferEmpty,A0
01:00001738 4EB8126C        	  1019:         JSR     UART_WriteString
01:0000173C 4EB8130C        	  1020:         JSR     new_line
01:00001740 4E75            	  1021:         RTS
                            	  1022: ;---------------------------------------------------------------------
                            	  1023: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	  1024: ;---------------------------------------------------------------------
                            	  1025: ClearBufferPointers:
01:00001742 23FC000000000008	  1026:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
01:0000174A 1022
01:0000174C 23FC000000000008	  1027:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
01:00001754 1026
01:00001756 33FC00000008102A	  1028:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
01:0000175E 4E75            	  1029:         RTS
                            	  1030: ;---------------------------------------------------------------------
                            	  1031: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	  1032: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	  1033: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	  1034: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	  1035: ;---------------------------------------------------------------------
                            	  1036: MontaAddress:
01:00001760 48E73C80        	  1037:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	  1038: 
                            	  1039:         ; Verifica se há pelo menos 8 bytes no buffer
01:00001764 32390008102A    	  1040:         MOVE.W  BUFFER_COUNT,D1
01:0000176A B27C0008        	  1041:         CMP.W   #8,D1
01:0000176E 6D38            	  1042:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1043: 
01:00001770 41F90008102C    	  1044:         LEA     BUFFER,A0      ; A0 = base do buffer
01:00001776 243900081026    	  1045:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
01:0000177C 7000            	  1046:         CLR.L   D0                ; Zera D0 (resultado final)
01:0000177E 7607            	  1047:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1048: 
                            	  1049: .ReadLoop:
01:00001780 18302800        	  1050:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
01:00001784 0204000F        	  1051:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1052: 
                            	  1053:         ; Desloca e insere os 4 bits em D0
01:00001788 E988            	  1054:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
01:0000178A 8004            	  1055:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1056: 
                            	  1057:         ; Atualiza tail (circular)
01:0000178C 5282            	  1058:         ADDQ.L  #1,D2
01:0000178E 0282000000FF    	  1059:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1060: 
01:00001794 51CBFFEA        	  1061:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1062: 
                            	  1063:         ; Atualiza ponteiros globais
01:00001798 23C200081026    	  1064:         MOVE.L  D2,BUFFER_TAIL
01:0000179E 51790008102A    	  1065:         SUB.W   #8,BUFFER_COUNT
                            	  1066: 
01:000017A4 7200            	  1067:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
01:000017A6 6004            	  1068:         BRA     .Exit
                            	  1069: 
                            	  1070: .BufferUnderrun:
01:000017A8 72FF            	  1071:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
01:000017AA 7000            	  1072:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1073: 
                            	  1074: .Exit:
01:000017AC 4CDF013C        	  1075:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
01:000017B0 4E75            	  1076:         RTS
                            	  1077: 
01:000017B2 706473696C766120	  1078:         DC.B "pdsilva AKA pgordao"
01:000017BA 414B412070676F72
01:000017C2 64616F
                            	  1079:         ALIGN 2
