00:0000019C 41F900082000    	   202:     LEA     $82000,A0
00:000001A2 43F90008FFFF    	   203:     LEA     $8FFFF,A1
00:000001A8 7000            	   204:     MOVEQ   #0,D0
                            	   205: .ClearLoop:
00:000001AA D07C0101        	   206:     ADD.W   #$0101,D0
00:000001AE 30C0            	   207:     MOVE.W  D0,(A0)+
00:000001B0 B3C8            	   208:     CMPA.L  A0,A1
00:000001B2 62F6            	   209:     BHI     .ClearLoop
00:000001B4 6000FECE        	   210:     BRA     MenuLoop
                            	   211: 
