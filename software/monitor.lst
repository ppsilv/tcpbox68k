                            	   197: ; ----------------------------------------------------------------------
                            	   198: ; Constantes
                            	   199: ; ----------------------------------------------------------------------
                            	   200: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   201: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   202:                               ; BAUD_DIV_L em $70000
                            	   203:                               ; BAUD_DIV_U em $70001
                            	   204: 
                            	   205: ; ----------------------------------------------------------------------
                            	   206: ; Rotina: Calcula e armazena divisor de baud rate
                            	   207: ; Entrada:
                            	   208: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   209: ; Saída:
                            	   210: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   211: ; Formulas:
                            	   212: ;
                            	   213: ;
                            	   214: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   215: ; ----------------------------------------------------------------------
                            	   216: 
                            	   217: CalcBaudDiv:
                            	   218: ;[ Registrador D0 (32 bits) ]
                            	   219: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   220: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   221:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   222:     ;((F_CPU/16)/10)
                            	   223:     ;F_CPU = 16000000 ou 0xF42400
00:00000182 203C00F42400    	   224:     MOVE.L  #F_CPU,D0
00:00000188 323C0010        	   225:     MOVE.W  #16,D1         ; Divisor
00:0000018C 61000096        	   226:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   227: ;1
00:00000190 2F00            	   228:     move.l  d0,-(SP)
00:00000192 4EB803A6        	   229:     jsr     PrintHexAddress
00:00000196 4EB8020E        	   230:     jsr     new_line
00:0000019A 201F            	   231:     move.l  (SP)+,d0
                            	   232: 
00:0000019C 323C000A        	   233:     MOVE.W  #10,D1         ; Divisor
00:000001A0 61000082        	   234:     BSR     Div32x16       ; D0 = 0x186A0
                            	   235: ;2
00:000001A4 2F00            	   236:     move.l  d0,-(SP)
00:000001A6 4EB803A6        	   237:     jsr     PrintHexAddress
00:000001AA 4EB8020E        	   238:     jsr     new_line
00:000001AE 201F            	   239:     move.l  (SP)+,d0
                            	   240: 
                            	   241:     ;(BAUD/10)
00:000001B0 2F00            	   242:     move.l  d0,-(SP)
                            	   243: ;3
00:000001B2 7000            	   244:     CLR.L   D0
00:000001B4 30390008100C    	   245:     MOVE.W  CurrentBaudRate,D0
00:000001BA 2F00            	   246:     move.l  d0,-(SP)
00:000001BC 4EB803A6        	   247:     jsr     PrintHexAddress
00:000001C0 4EB8020E        	   248:     jsr     new_line
00:000001C4 201F            	   249:     move.l  (SP)+,d0
                            	   250: 
00:000001C6 123C000A        	   251:     MOVE.B  #10,D1
00:000001CA 6158            	   252:     BSR     Div32x16
                            	   253: 
                            	   254: ;4
00:000001CC 2F00            	   255:     move.l  d0,-(SP)
00:000001CE 4EB803A6        	   256:     jsr     PrintHexAddress
00:000001D2 4EB8020E        	   257:     jsr     new_line
00:000001D6 221F            	   258:     move.l  (SP)+,D1
00:000001D8 201F            	   259:     move.l  (SP)+,D0
                            	   260: 
                            	   261: 
                            	   262:     ;(F_CPU/BAUD)
00:000001DA 6148            	   263:     BSR     Div32x16
                            	   264: ;5
00:000001DC 2F00            	   265:     move.l  d0,-(SP)
00:000001DE 4EB803A6        	   266:     jsr     PrintHexAddress
00:000001E2 4EB8020E        	   267:     jsr     new_line
00:000001E6 201F            	   268:     move.l  (SP)+,d0
                            	   269: 
                            	   270:     ; 4. Separa parte alta/baixa corretamente
00:000001E8 3200            	   271:     MOVE.W  D0,D1
00:000001EA 024000FF        	   272:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000001EE E049            	   273:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000001F0 024100FF        	   274:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   275: 
                            	   276:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000001F4 41F900081012    	   277:     LEA     Baud1DivL,A0
00:000001FA 3080            	   278:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:000001FC 41F900081014    	   279:     LEA     Baud1DivH,A0
00:00000202 3081            	   280:     MOVE.W  D1,(A0)
                            	   281: 
00:00000204 6000FE6C        	   282:     BRA     MenuLoop
00:00000208 4E75            	   283:     RTS
                            	   284: .BaudError:
00:0000020A 6000FDFC        	   285:     BRA     _start
                            	   286: 
                            	   287: new_line:
00:0000020E 2F00            	   288:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000210 103C000A        	   289:         MOVE.B  #10,D0
00:00000214 4EB8013A        	   290:         JSR     UART_WriteChar
00:00000218 103C000D        	   291:         MOVE.B  #13,D0
00:0000021C 4EB8013A        	   292:         JSR     UART_WriteChar
00:00000220 201F            	   293:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000222 4E75            	   294:         RTS
                            	   295: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   296: ; Retorna D0 = Quociente, D1 = Resto
                            	   297: Div32x16:
00:00000224 7400            	   298:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000226 761F            	   299:     MOVEQ   #31,D3      ; 32 iterações
                            	   300: DivLoop:
00:00000228 E388            	   301:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000022A E392            	   302:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000022C B441            	   303:     CMP.W   D1,D2       ; D2 >= D1?
00:0000022E 6D04            	   304:     BLT     .skip
00:00000230 9441            	   305:     SUB.W   D1,D2       ; Sim, subtrai
00:00000232 5280            	   306:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   307: .skip:
00:00000234 51CBFFF2        	   308:     DBRA    D3,DivLoop  ; Repete
00:00000238 2202            	   309:     MOVE.L  D2,D1       ; Resto em D1
00:0000023A 4E75            	   310:     RTS
                            	   311: ; Versão compacta sem stack frame
                            	   312: PrintHexFast:
00:0000023C 2F02            	   313:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000023E 2F00            	   314:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000240 7407            	   315:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   316: 
                            	   317: .Loop:
00:00000242 2017            	   318:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000244 E998            	   319:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000246 2E80            	   320:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000248 0200000F        	   321:     ANDI.B  #$F,D0            ; Isola nibble
                            	   322: 
00:0000024C B03C0009        	   323:     CMP.B   #9,D0
00:00000250 6302            	   324:     BLS     .Digit
00:00000252 5E00            	   325:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   326: .Digit:
00:00000254 D03C0030        	   327:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000258 4EB8013A        	   328:     JSR     UART_WriteChar    ; Envia caractere
                            	   329: 
00:0000025C 51CAFFE4        	   330:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   331: 
00:00000260 588F            	   332:     ADDQ.L  #4,SP             ; Remove valor salvo
00:00000262 241F            	   333:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000264 4E75            	   334:     RTS
                            	   335: 
                            	   336: ; ----------------------------------------------------------------------
                            	   337: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   338: ; Entrada:
                            	   339: ;   D0.L = Valor a ser impresso (32 bits)
                            	   340: ;   D1.W = Número de dígitos (1-8)
                            	   341: ; ----------------------------------------------------------------------
                            	   342: PrintHexPRECISA_DE_REVISAO:
00:00000266 4E56FFF8        	   343:     LINK    A6,#-8            ; Reserva espaço na pilha
00:0000026A 2F02            	   344:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000026C 2D40FFFC        	   345:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:00000270 3D41FFFA        	   346:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   347: 
00:00000274 323C0008        	   348:     MOVE.W  #$0008,D1
                            	   349: 
                            	   350:     ; Ajusta para começar pelo dígito mais significativo
00:00000278 E549            	   351:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:0000027A 5941            	   352:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   353: 
                            	   354: .PrintLoop:
00:0000027C 202EFFFC        	   355:     MOVE.L  -4(A6),D0         ; Recupera valor
00:00000280 3401            	   356:     MOVE.W  D1,D2             ; Posição do nibble
00:00000282 E5B8            	   357:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000284 02800000000F    	   358:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   359: 
                            	   360:     ; Converte para ASCII
00:0000028A B03C0009        	   361:     CMP.B   #9,D0
00:0000028E 6302            	   362:     BLS     .Decimal
00:00000290 5E00            	   363:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   364: .Decimal:
00:00000292 D03C0030        	   365:     ADD.B   #'0',D0           ; Converte para caractere
                            	   366: 
                            	   367:     ; Imprime caractere
00:00000296 4EB8013A        	   368:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   369: 
00:0000029A 5941            	   370:     SUBQ.W  #4,D1             ; Próximo nibble
00:0000029C 6ADE            	   371:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   372: 
                            	   373:     ; Espaço final para separação
00:0000029E 103C0020        	   374:     MOVE.B  #' ',D0
00:000002A2 4EB8013A        	   375:     JSR     UART_WriteChar
                            	   376: 
00:000002A6 241F            	   377:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000002A8 4E5E            	   378:     UNLK    A6                ; Restaura frame
00:000002AA 4E75            	   379:     RTS
                            	   380: ; ----------------------------------------------------------------------
                            	   381: ; Exemplo de uso:
                            	   382: ; ----------------------------------------------------------------------
                            	   383: SetupDivisor:
00:000002AC 303C2580        	   384:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000002B0 6100FED0        	   385:     BSR     CalcBaudDiv
                            	   386: 
                            	   387:     ; Agora pode acessar os valores na RAM:
00:000002B4 41F90008100E    	   388:     LEA     BaudDivL,A0
00:000002BA 1010            	   389:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000002BC 41F900081010    	   390:     LEA     BaudDivH,A0
00:000002C2 1210            	   391:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   392: 
                            	   393:     ; (Aqui você configuraria os registradores da UART)
00:000002C4 4E75            	   394:     RTS
                            	   395: ; ----------------------------------------------------------------------
                            	   396: ; MemDump - Imprime dump de memória formatado
                            	   397: ; Entrada:
                            	   398: ;   A0 = Endereço inicial (ex: $80000)
                            	   399: ;   D0 = Quantidade de bytes (ex: 256)
                            	   400: ; ----------------------------------------------------------------------
                            	   401: MemDump:
00:000002C6 41F900000008    	   402:     LEA     DumpHeader,A0
00:000002CC 4EB8016E        	   403:     JSR     UART_WriteString
00:000002D0 207900081016    	   404:     MOVE.L  (addressInHex),A0
00:000002D6 2008            	   405:     MOVE.L  A0,D0
00:000002D8 4EB803A6        	   406:     JSR     PrintHexAddress
00:000002DC 4EB8020E        	   407:     JSR     new_line
                            	   408: 
00:000002E0 41F90000001B    	   409:     LEA     DumpHeader1,A0
00:000002E6 4EB8016E        	   410:     JSR     UART_WriteString
                            	   411: 
00:000002EA 207900081016    	   412:     MOVE.L  (addressInHex),A0
                            	   413:     ; Calcula endereço final
                            	   414: 
                            	   415: DUMPLOOPMASTER:
00:000002F0 7200            	   416:     CLR.L   D1
00:000002F2 2208            	   417:     MOVE.L  A0,D1
00:000002F4 0681000000FF    	   418:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   419:     ;MOVE.L  D1,D0
                            	   420:     ;JSR     PrintHexAddress
                            	   421:     ;JSR     new_line
                            	   422: 
                            	   423:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   424:     ;JSR     UART_ReadChar
                            	   425: 
                            	   426: 
                            	   427: DumpLoop:
                            	   428:     ; Nova linha a cada 16 bytes
00:000002FA 2008            	   429:     MOVE.L  A0,D0
00:000002FC 02800000000F    	   430:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000302 6616            	   431:     BNE     NoNewLine
                            	   432: 
                            	   433:     ; Imprime endereço
00:00000304 2008            	   434:     MOVE.L  A0,D0
00:00000306 4EB803A6        	   435:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   436: 
00:0000030A 103C003A        	   437:     MOVE.B  #':',D0
00:0000030E 4EB8013A        	   438:     JSR     UART_WriteChar
00:00000312 103C0020        	   439:     MOVE.B  #' ',D0
00:00000316 4EB8013A        	   440:     JSR     UART_WriteChar
                            	   441: 
                            	   442: NoNewLine:
                            	   443:     ; Imprime byte em hex
00:0000031A 1018            	   444:     MOVE.B  (A0)+,D0
00:0000031C 4EB803B6        	   445:     JSR     PrintByteHex
                            	   446: 
00:00000320 103C0020        	   447:     MOVE.B  #' ',D0
00:00000324 4EB8013A        	   448:     JSR     UART_WriteChar
                            	   449: 
                            	   450:     ; Verifica fim da linha (16 bytes)
00:00000328 2008            	   451:     MOVE.L  A0,D0
00:0000032A 02800000000F    	   452:     ANDI.L  #$0000000F,D0
00:00000330 664E            	   453:     BNE     NoEndLine
                            	   454: 
                            	   455:     ; Imprime caracteres ASCII
00:00000332 103C0020        	   456:     MOVE.B  #' ',D0
00:00000336 4EB8013A        	   457:     JSR     UART_WriteChar
00:0000033A 103C007C        	   458:     MOVE.B  #'|',D0
00:0000033E 4EB8013A        	   459:     JSR     UART_WriteChar
                            	   460: 
00:00000342 43E8FFF0        	   461:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000346 740F            	   462:     MOVEQ   #15,D2            ; 16 caracteres
                            	   463: 
                            	   464: AsciiLoop:
00:00000348 1019            	   465:     MOVE.B  (A1)+,D0
00:0000034A B03C0020        	   466:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000034E 6D0C            	   467:     BLT     NonPrintable
00:00000350 B03C007E        	   468:     CMP.B   #126,D0
00:00000354 6E06            	   469:     BGT     NonPrintable
                            	   470: 
00:00000356 4EB8013A        	   471:     JSR     UART_WriteChar
00:0000035A 6008            	   472:     BRA     NextAscii
                            	   473: 
                            	   474: NonPrintable:
00:0000035C 103C002E        	   475:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:00000360 4EB8013A        	   476:     JSR     UART_WriteChar
                            	   477: 
                            	   478: NextAscii:
00:00000364 51CAFFE2        	   479:     DBRA    D2,AsciiLoop
                            	   480: 
00:00000368 103C007C        	   481:     MOVE.B  #'|',D0
00:0000036C 4EB8013A        	   482:     JSR     UART_WriteChar
00:00000370 103C000D        	   483:     MOVE.B  #13,D0            ; CR
00:00000374 4EB8013A        	   484:     JSR     UART_WriteChar
00:00000378 103C000A        	   485:     MOVE.B  #10,D0            ; LF
00:0000037C 4EB8013A        	   486:     JSR     UART_WriteChar
                            	   487: 
                            	   488: NoEndLine:
                            	   489:     ; Verifica fim do dump
00:00000380 B1C1            	   490:     CMP.L   D1,A0
00:00000382 6300FF76        	   491:     BLS     DumpLoop
                            	   492: 
00:00000386 2F08            	   493:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000388 41F9000003EA    	   494:     LEA     HitAnyKey,A0
00:0000038E 4EB8016E        	   495:     JSR     UART_WriteString
00:00000392 4EB80154        	   496:     JSR     UART_ReadChar
00:00000396 B03C001B        	   497:     CMP.B   #$1B,D0
00:0000039A 6706            	   498:     BEQ     .fim
                            	   499: 
00:0000039C 205F            	   500:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:0000039E 6000FF50        	   501:     BRA     DUMPLOOPMASTER
                            	   502: .fim
00:000003A2 6000FCCE        	   503:     BRA     MenuLoop
                            	   504: 
                            	   505: ; ----------------------------------------------------------------------
                            	   506: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   507: ; Entrada: D0 = endereço
                            	   508: ; ----------------------------------------------------------------------
                            	   509: PrintHexAddress:
00:000003A6 4840            	   510:     SWAP    D0                ; Imprime parte alta primeiro
00:000003A8 4EB803AE        	   511:     JSR     PrintWordHex
00:000003AC 4840            	   512:     SWAP    D0                ; Parte baixa
                            	   513:     ; Continua para PrintWordHex
                            	   514: 
                            	   515: ; ----------------------------------------------------------------------
                            	   516: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   517: ; Entrada: D0.w = valor
                            	   518: ; ----------------------------------------------------------------------
                            	   519: PrintWordHex:
00:000003AE E158            	   520:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003B0 4EB803B6        	   521:     JSR     PrintByteHex
00:000003B4 E058            	   522:     ROR.W   #8,D0             ; Byte menos significativo
                            	   523:     ; Continua para PrintByteHex
                            	   524: 
                            	   525: ; ----------------------------------------------------------------------
                            	   526: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   527: ; Entrada: D0.b = valor
                            	   528: ; ----------------------------------------------------------------------
                            	   529: PrintByteHex:
00:000003B6 1F00            	   530:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000003B8 E808            	   531:     LSR.B   #4,D0             ; Nibble alto
00:000003BA 6106            	   532:     BSR     PrintNibble
00:000003BC 101F            	   533:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000003BE 0200000F        	   534:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   535:     ; Continua para PrintNibble
                            	   536: ; ----------------------------------------------------------------------
                            	   537: ; PrintNibble - Imprime um nibble em hex
                            	   538: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   539: ; ----------------------------------------------------------------------
                            	   540: PrintNibble:
00:000003C2 B03C0009        	   541:     CMP.B   #9,D0
00:000003C6 6302            	   542:     BLS     .Decimal
00:000003C8 5E00            	   543:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   544: .Decimal:
00:000003CA D03C0030        	   545:     ADD.B   #'0',D0
00:000003CE 4EF8013A        	   546:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   547: 
                            	   548: ClearRAM:
00:000003D2 41F900080000    	   549:     LEA     $80000,A0
00:000003D8 43F90008FFFF    	   550:     LEA     $8FFFF,A1
00:000003DE 7000            	   551:     MOVEQ   #0,D0
                            	   552: .ClearLoop:
00:000003E0 20C0            	   553:     MOVE.L  D0,(A0)+
00:000003E2 B3C8            	   554:     CMPA.L  A0,A1
00:000003E4 62FA            	   555:     BHI     .ClearLoop
00:000003E6 4E75            	   556:     RTS
                            	   557: ; ----------------------------------------------------------------------
                            	   558: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   559: ; ----------------------------------------------------------------------
                            	   560: ClearRAM1:
00:000003E8 41F900080000    	   561:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000003EE 43F900100000    	   562:     LEA     $100000,A1       ; Endereço final + 1
00:000003F4 7000            	   563:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   564: 
                            	   565:     ; Calcula tamanho em bytes (já alinhado para longs)
00:000003F6 2209            	   566:     MOVE.L  A1,D1
00:000003F8 9288            	   567:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   568: 
                            	   569:     ; Otimização: escreve longs (32 bits) quando possível
00:000003FA 2401            	   570:     MOVE.L  D1,D2
00:000003FC 028200000003    	   571:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:00000402 670C            	   572:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   573: 
                            	   574:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000404 5382            	   575:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   576: .ResidualLoop:
00:00000406 10C0            	   577:     MOVE.B  D0,(A0)+
00:00000408 51CAFFFC        	   578:     DBRA    D2,.ResidualLoop
                            	   579: 
                            	   580:     ; Atualiza tamanho restante
00:0000040C 9282            	   581:     SUB.L   D2,D1
00:0000040E 5381            	   582:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   583: 
                            	   584: .ClearLongs:
00:00000410 E489            	   585:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:00000412 5381            	   586:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   587: 
                            	   588: .LongLoop:
00:00000414 20C0            	   589:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000416 51C9FFFC        	   590:     DBRA    D1,.LongLoop
00:0000041A 4E75            	   591:     RTS
