                            	    15: ;Term vt-102 cursor positioning \033[0;0H
                            	    16: 
                            	    17: ;# Clock frequency in Hz
                            	    18: F_CPU           equ 16000000
                            	    19: ;# Serial baud rate
                            	    20: 
                            	    21: ;UART            equ $2000
                            	    22: ; register offsets
                            	    23: RHR             equ 0   ; receive holding register (read)
                            	    24: THR             equ 0   ; transmit holding register (write)
                            	    25: IER             equ 2   ; interrupt enable register
                            	    26: ISR             equ 4   ; interrupt status register (read)
                            	    27: FCR             equ 4   ; FIFO control register (write)
                            	    28: LCR             equ 6   ; line control register
                            	    29: MCR             equ 8   ; modem control register
                            	    30: LSR             equ 10  ; line status register
                            	    31: MSR             equ 12  ; modem status register
                            	    32: SPR             equ 14  ; scratchpad register (reserved for system use)
                            	    33: DLL             equ 0   ; divisor latch LSB
                            	    34: DLM             equ 2   ; divisor latch MSB
                            	    35: ; aliases for register names (used by different manufacturers)cd ..
                            	    36: RBR             equ RHR ; receive buffer register
                            	    37: IIR             equ ISR ; interrupt identification register
                            	    38: SCR             equ SPR ; scratch register
                            	    39: 
                            	    40: UART_BASE       equ $2000
                            	    41: BAUD_RATE       equ 9600
                            	    42: BAUD_DIV        equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    43: BAUD_DIV_L      equ     (BAUD_DIV&$FF)
                            	    44: BAUD_DIV_U      equ     ((BAUD_DIV>>8)&$FF)
                            	    45: 
                            	    46: ;=== Uart receiver ================= CONSTANTES =================
                            	    47: SOH            EQU     $01        ; Start Of Header
                            	    48: EOT            EQU     $04        ; End Of Transmission
                            	    49: ACK            EQU     $06        ; Acknowledge
                            	    50: NAK            EQU     $15        ; Negative Acknowledge
                            	    51: CAN            EQU     $18        ; Cancel
                            	    52: 
