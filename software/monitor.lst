                            	   250: ; ----------------------------------------------------------------------
                            	   251: ; Constantes
                            	   252: ; ----------------------------------------------------------------------
                            	   253: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   254: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   255:                               ; BAUD_DIV_L em $70000
                            	   256:                               ; BAUD_DIV_U em $70001
                            	   257: 
                            	   258: ; ----------------------------------------------------------------------
                            	   259: ; Rotina: Calcula e armazena divisor de baud rate
                            	   260: ; Entrada:
                            	   261: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   262: ; Saída:
                            	   263: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   264: ; Formulas:
                            	   265: ;
                            	   266: ;
                            	   267: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   268: ; ----------------------------------------------------------------------
                            	   269: 
                            	   270: CALCBAUDDIV:
                            	   271: ;[ Registrador D0 (32 bits) ]
                            	   272: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   273: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   274:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   275:         ;((F_CPU/16)/10)
                            	   276:         ;F_CPU = 16000000 ou 0xF42400
00:000001EA 203C00F42400    	   277:         MOVE.L  #F_CPU,D0
00:000001F0 323C0010        	   278:         MOVE.W  #16,D1         ; Divisor
00:000001F4 61000096        	   279:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   280: ;1
00:000001F8 2F00            	   281:         move.l  d0,-(SP)
00:000001FA 4EB803F4        	   282:         jsr     PrintHexAddress
00:000001FE 4EB80276        	   283:         jsr     new_line
00:00000202 201F            	   284:         move.l  (SP)+,d0
                            	   285: 
00:00000204 323C000A        	   286:         MOVE.W  #10,D1         ; Divisor
00:00000208 61000082        	   287:         BSR     Div32x16       ; D0 = 0x186A0
                            	   288: ;2
00:0000020C 2F00            	   289:         move.l  d0,-(SP)
00:0000020E 4EB803F4        	   290:         jsr     PrintHexAddress
00:00000212 4EB80276        	   291:         jsr     new_line
00:00000216 201F            	   292:         move.l  (SP)+,d0
                            	   293: 
                            	   294:         ;(BAUD/10)
00:00000218 2F00            	   295:         move.l  d0,-(SP)
                            	   296: ;3
00:0000021A 7000            	   297:         CLR.L   D0
00:0000021C 303900081014    	   298:         MOVE.W  CurrentBaudRate,D0
00:00000222 2F00            	   299:         move.l  d0,-(SP)
00:00000224 4EB803F4        	   300:         jsr     PrintHexAddress
00:00000228 4EB80276        	   301:         jsr     new_line
00:0000022C 201F            	   302:         move.l  (SP)+,d0
                            	   303: 
00:0000022E 123C000A        	   304:         MOVE.B  #10,D1
00:00000232 6158            	   305:         BSR     Div32x16
                            	   306: 
                            	   307: ;4
00:00000234 2F00            	   308:         move.l  d0,-(SP)
00:00000236 4EB803F4        	   309:         jsr     PrintHexAddress
00:0000023A 4EB80276        	   310:         jsr     new_line
00:0000023E 221F            	   311:         move.l  (SP)+,D1
00:00000240 201F            	   312:         move.l  (SP)+,D0
                            	   313: 
                            	   314: 
                            	   315:         ;(F_CPU/BAUD)
00:00000242 6148            	   316:         BSR     Div32x16
                            	   317: ;5
00:00000244 2F00            	   318:         move.l  d0,-(SP)
00:00000246 4EB803F4        	   319:         jsr     PrintHexAddress
00:0000024A 4EB80276        	   320:         jsr     new_line
00:0000024E 201F            	   321:         move.l  (SP)+,d0
                            	   322: 
                            	   323:         ; 4. Separa parte alta/baixa corretamente
00:00000250 3200            	   324:         MOVE.W  D0,D1
00:00000252 024000FF        	   325:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000256 E049            	   326:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:00000258 024100FF        	   327:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   328: 
                            	   329:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:0000025C 41F90008101A    	   330:         LEA     Baud1DivL,A0
00:00000262 3080            	   331:         MOVE.W  D0,(A0)        ; 16 bits suficientes
00:00000264 41F90008101C    	   332:         LEA     Baud1DivH,A0
00:0000026A 3081            	   333:         MOVE.W  D1,(A0)
                            	   334: 
00:0000026C 6000FE2E        	   335:         BRA     MenuLoop
00:00000270 4E75            	   336:         RTS
                            	   337: .BaudError:
00:00000272 6000FDAC        	   338:         BRA     _start
                            	   339: 
                            	   340: new_line:
00:00000276 2F00            	   341:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000278 103C000A        	   342:         MOVE.B  #10,D0
00:0000027C 4EB80186        	   343:         JSR     UART_WriteChar
00:00000280 103C000D        	   344:         MOVE.B  #13,D0
00:00000284 4EB80186        	   345:         JSR     UART_WriteChar
00:00000288 201F            	   346:         MOVE.L  (SP)+,D0          ; Restaura D0
00:0000028A 4E75            	   347:         RTS
                            	   348: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   349: ; Retorna D0 = Quociente, D1 = Resto
                            	   350: Div32x16:
00:0000028C 7400            	   351:         MOVEQ   #0,D2       ; D2 = Quociente
00:0000028E 761F            	   352:         MOVEQ   #31,D3      ; 32 iterações
                            	   353: DivLoop:
00:00000290 E388            	   354:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:00000292 E392            	   355:         ROXL.L  #1,D2       ; Desloca D2 com Carry
00:00000294 B441            	   356:         CMP.W   D1,D2       ; D2 >= D1?
00:00000296 6D04            	   357:         BLT     .skip
00:00000298 9441            	   358:         SUB.W   D1,D2       ; Sim, subtrai
00:0000029A 5280            	   359:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   360: .skip:
00:0000029C 51CBFFF2        	   361:         DBRA    D3,DivLoop  ; Repete
00:000002A0 2202            	   362:         MOVE.L  D2,D1       ; Resto em D1
00:000002A2 4E75            	   363:         RTS
                            	   364: ; Versão compacta sem stack frame
                            	   365: PrintHexFast:
00:000002A4 2F02            	   366:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002A6 2F00            	   367:         MOVE.L  D0,-(SP)          ; Salva D0 original
00:000002A8 7407            	   368:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   369: 
                            	   370: .Loop:
00:000002AA 2017            	   371:         MOVE.L  (SP),D0           ; Recupera valor original
00:000002AC E998            	   372:         ROL.L   #4,D0             ; Pega próximo nibble
00:000002AE 2E80            	   373:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:000002B0 0200000F        	   374:         ANDI.B  #$F,D0            ; Isola nibble
                            	   375: 
00:000002B4 B03C0009        	   376:         CMP.B   #9,D0
00:000002B8 6302            	   377:         BLS     .Digit
00:000002BA 5E00            	   378:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   379: .Digit:
00:000002BC D03C0030        	   380:         ADD.B   #'0',D0           ; Converte para ASCII
00:000002C0 4EB80186        	   381:         JSR     UART_WriteChar    ; Envia caractere
                            	   382: 
00:000002C4 51CAFFE4        	   383:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   384: 
00:000002C8 588F            	   385:         ADDQ.L  #4,SP             ; Remove valor salvo
00:000002CA 241F            	   386:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002CC 4E75            	   387:         RTS
