                            	   947: ; XMODEM RECEIVER ROUTINE
                            	   948: ; =====================================================================
                            	   949: XMODEM_Receive:
00:000006D0 48E73FFE        	   950:                 MOVEM.L D2-D7/A0-A6,-(SP)
                            	   951:                 ; Inicializa variáveis
00:000006D4 41F900081625    	   952:                 LEA     expected_block,A0
00:000006DA 103C0001        	   953:                 MOVE.B  #1,D0
00:000006DE 1080            	   954:                 MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:000006E0 41F9000815A4    	   955:                 LEA     xmodem_buffer,A0
                            	   956: 
                            	   957:                 ; ---- 1. INICIALIZAÇÃO ----
00:000006E6 103C0015        	   958:                 MOVE.B  #NAK,D0
00:000006EA 4EB80134        	   959:                 JSR     UART_WriteChar      ; Solicita início
                            	   960: 
                            	   961:                 ; ---- 2. LOOP PRINCIPAL ----
                            	   962: Receive_Loop:
00:000006EE 4EB8016E        	   963:                 JSR     UART_ReadCharNonEcho
00:000006F2 B03C0004        	   964:                 CMP.B   #EOT,D0
00:000006F6 67000088        	   965:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	   966: 
00:000006FA B03C0001        	   967:                 CMP.B   #SOH,D0
00:000006FE 66EE            	   968:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   969: 
                            	   970:                 ; ---- 3. RECEBE HEADER ----
00:00000700 4EB8016E        	   971:                 JSR     UART_ReadCharNonEcho       ; Block number
00:00000704 13C000081624    	   972:                 MOVE.B  D0,block_number
00:0000070A 4EB8016E        	   973:                 JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	   974: 
                            	   975:                 ; ---- 4. RECEBE DADOS ----
00:0000070E 323C007F        	   976:                 MOVE.W  #127,D1             ; 128 bytes (0-based)
00:00000712 43F9000815A4    	   977:                 LEA     xmodem_buffer,A1
                            	   978: 
                            	   979: Receive_Data:
00:00000718 4EB8016E        	   980:                 JSR     UART_ReadCharNonEcho
00:0000071C 12C0            	   981:                 MOVE.B  D0,(A1)+
00:0000071E 51C9FFF8        	   982:                 DBF     D1,Receive_Data
                            	   983: 
                            	   984:                 ; ---- 5. VERIFICA CHECKSUM ----
00:00000722 4EB8016E        	   985:                 JSR     UART_ReadCharNonEcho       ; Checksum
00:00000726 1400            	   986:                 MOVE.B  D0,D2
                            	   987: 
                            	   988:                 ; Calcula checksum local
00:00000728 43F9000815A4    	   989:                 LEA     xmodem_buffer,A1
00:0000072E 323C007F        	   990:                 MOVE.W  #127,D1
00:00000732 4203            	   991:                 CLR.B   D3
                            	   992: 
                            	   993: Calc_Checksum:
00:00000734 D619            	   994:                 ADD.B   (A1)+,D3
00:00000736 51C9FFFC        	   995:                 DBF     D1,Calc_Checksum
                            	   996: 
00:0000073A B602            	   997:                 CMP.B   D2,D3
00:0000073C 6636            	   998:                 BNE     Send_NAK            ; Erro no checksum
                            	   999: 
                            	  1000:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
00:0000073E 103900081624    	  1001:                 MOVE.B  block_number,D0
00:00000744 B03900081625    	  1002:                 CMP.B   expected_block,D0
00:0000074A 6628            	  1003:                 BNE     Send_NAK            ; Bloco fora de ordem
                            	  1004: 
                            	  1005:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1006:                 ; (Aqui você processa os 128 bytes recebidos)
                            	  1007:                 ; Exemplo: copiar para RAM/Flash
00:0000074C 43F9000815A4    	  1008:                 LEA     xmodem_buffer,A1
00:00000752 247900081524    	  1009:                 MOVE.L  user_buffer_ptr,A2  ; Defina isso antes de chamar
00:00000758 323C007F        	  1010:                 MOVE.W  #127,D1
                            	  1011: Copy_Data:
00:0000075C 14D9            	  1012:                 MOVE.B  (A1)+,(A2)+
00:0000075E 51C9FFFC        	  1013:                 DBF     D1,Copy_Data
                            	  1014: 
                            	  1015:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:00000762 523900081625    	  1016:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000768 103C0006        	  1017:                 MOVE.B  #ACK,D0
00:0000076C 4EB80134        	  1018:                 JSR     UART_WriteChar
00:00000770 6000FF7C        	  1019:                 BRA     Receive_Loop
                            	  1020: 
                            	  1021: Send_NAK:
00:00000774 103C0015        	  1022:                 MOVE.B  #NAK,D0
00:00000778 4EB80134        	  1023:                 JSR     UART_WriteChar
00:0000077C 6000FF70        	  1024:                 BRA     Receive_Loop
                            	  1025: 
                            	  1026: Transfer_Complete:
00:00000780 103C0006        	  1027:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:00000784 4EB80134        	  1028:                 JSR     UART_WriteChar
00:00000788 4CDF7FFC        	  1029:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:0000078C 4E75            	  1030:                 RTS
