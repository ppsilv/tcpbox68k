                            	   894: ;---------------------------------------------------------------------
                            	   895: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   896: ;---------------------------------------------------------------------
                            	   897: ClearBufferPointers:
00:00000642 23FC000000000008	   898:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000064A 102A
00:0000064C 23FC000000000008	   899:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000654 102E
00:00000656 33FC000000081032	   900:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:0000065E 4E75            	   901:     RTS
                            	   902: ;---------------------------------------------------------------------
                            	   903: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   904: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   905: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   906: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   907: ;---------------------------------------------------------------------
                            	   908: MontaAddress:
00:00000660 48E73C80        	   909:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   910: 
                            	   911:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000664 323900081032    	   912:     MOVE.W  BUFFER_COUNT,D1
00:0000066A B27C0008        	   913:     CMP.W   #8,D1
00:0000066E 6D38            	   914:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   915: 
00:00000670 41F900081034    	   916:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000676 24390008102E    	   917:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000067C 7000            	   918:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000067E 7607            	   919:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   920: 
                            	   921: .ReadLoop:
00:00000680 18302800        	   922:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000684 0204000F        	   923:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   924: 
                            	   925:     ; Desloca e insere os 4 bits em D0
00:00000688 E988            	   926:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000068A 8004            	   927:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   928: 
                            	   929:     ; Atualiza tail (circular)
00:0000068C 5282            	   930:     ADDQ.L  #1,D2
00:0000068E 0282000000FF    	   931:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   932: 
00:00000694 51CBFFEA        	   933:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   934: 
                            	   935:     ; Atualiza ponteiros globais
00:00000698 23C20008102E    	   936:     MOVE.L  D2,BUFFER_TAIL
00:0000069E 517900081032    	   937:     SUB.W   #8,BUFFER_COUNT
                            	   938: 
00:000006A4 7200            	   939:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000006A6 6004            	   940:     BRA     .Exit
                            	   941: 
                            	   942: .BufferUnderrun:
00:000006A8 72FF            	   943:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006AA 7000            	   944:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   945: 
                            	   946: .Exit:
00:000006AC 4CDF013C        	   947:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000006B0 4E75            	   948:     RTS
