00:00000548 5901            	   724:         SUB.B   #4,D1
00:0000054A 8480            	   725:         OR.L    D0,D2
00:0000054C 41F900081016    	   726:         LEA     addressInHex,A0
00:00000552 2082            	   727:         MOVE.L  D2,(A0)
00:00000554 60BC            	   728:         BRA     .Loop
                            	   729: .isletter:
