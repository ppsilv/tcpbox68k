                            	   850: ;--------------------------------------------------
                            	   851: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   852: ;--------------------------------------------------
                            	   853: ; Exemplo: insere 'A' no buffer
                            	   854: ;          MOVE.B  #'A',D0
                            	   855: ;          JSR     UART_BufferPut
                            	   856: 
                            	   857: BufferPut:
00:00000634 2F01            	   858:     MOVE.L  D1,-(SP)
00:00000636 2F08            	   859:     MOVE.L  A0,-(SP)
                            	   860: 
                            	   861:     ;ANDI.W    #$FF00,D0
00:00000638 41F900081024    	   862:     LEA     BUFFER,A0
00:0000063E 323900081022    	   863:     MOVE.W  BUFFER_COUNT,D1
                            	   864: 
00:00000644 B27C0100        	   865:     CMP.W   #256,D1
00:00000648 6C1C            	   866:     BGE     .BufferFull
                            	   867: 
                            	   868:     ; Modificado para usar deslocamento de 16 bits
00:0000064A 32390008101A    	   869:     MOVE.W  BUFFER_HEAD,D1
00:00000650 D0C1            	   870:     ADD     D1,A0
00:00000652 1080            	   871:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   872: 
00:00000654 5441            	   873:     ADD     #2,D1              ; Incrementa como word
00:00000656 024100FF        	   874:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:0000065A 33C10008101A    	   875:     MOVE.W  D1,BUFFER_HEAD
                            	   876: 
00:00000660 527900081022    	   877:     ADDQ.W  #1,BUFFER_COUNT
                            	   878: 
                            	   879: .BufferFull:
00:00000666 205F            	   880:     MOVE.L  (SP)+,A0
00:00000668 221F            	   881:     MOVE.L  (SP)+,D1
                            	   882: 
00:0000066A 4E75            	   883:     RTS
                            	   884: 
                            	   885: ;--------------------------------------------------
                            	   886: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   887: ;--------------------------------------------------
                            	   888: ;Exemplo: Lendo byte do buffer
                            	   889: ;         BSR     UART_BufferGet
                            	   890: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   891: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   892: ;         Senão, D0 contém o byte lido!
                            	   893: BufferGet:
00:0000066C 2F01            	   894:     MOVE.L  D1,-(SP)
00:0000066E 2F08            	   895:     MOVE.L  A0,-(SP)
                            	   896: 
00:00000670 323900081022    	   897:     MOVE.W  BUFFER_COUNT,D1
00:00000676 6724            	   898:     BEQ     .BufferEmpty
                            	   899: 
00:00000678 41F900081024    	   900:     LEA     BUFFER,A0
                            	   901: 
