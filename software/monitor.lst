                            	   980: ;---------------------------------------------------------------------
                            	   981: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   982: ;---------------------------------------------------------------------
                            	   983: ClearBufferPointers:
00:00000706 23FC000000000008	   984:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000070E 101A
00:00000710 23FC000000000008	   985:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000718 101E
00:0000071A 33FC000000081022	   986:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:00000722 4E75            	   987:     RTS
                            	   988: ;---------------------------------------------------------------------
                            	   989: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   990: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   991: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   992: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   993: ;---------------------------------------------------------------------
                            	   994: MontaAddress:
00:00000724 48E73C80        	   995:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   996: 
                            	   997:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000728 323900081022    	   998:     MOVE.W  BUFFER_COUNT,D1
00:0000072E B27C0008        	   999:     CMP.W   #8,D1
00:00000732 6D38            	  1000:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	  1001: 
00:00000734 41F900081024    	  1002:     LEA     BUFFER,A0      ; A0 = base do buffer
00:0000073A 24390008101E    	  1003:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000740 7000            	  1004:     CLR.L   D0                ; Zera D0 (resultado final)
00:00000742 7607            	  1005:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	  1006: 
                            	  1007: .ReadLoop:
00:00000744 18302800        	  1008:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000748 0204000F        	  1009:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	  1010: 
                            	  1011:     ; Desloca e insere os 4 bits em D0
00:0000074C E988            	  1012:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000074E 8004            	  1013:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	  1014: 
                            	  1015:     ; Atualiza tail (circular)
00:00000750 5282            	  1016:     ADDQ.L  #1,D2
00:00000752 0282000000FF    	  1017:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	  1018: 
00:00000758 51CBFFEA        	  1019:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	  1020: 
                            	  1021:     ; Atualiza ponteiros globais
00:0000075C 23C20008101E    	  1022:     MOVE.L  D2,BUFFER_TAIL
00:00000762 517900081022    	  1023:     SUB.W   #8,BUFFER_COUNT
                            	  1024: 
00:00000768 7200            	  1025:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:0000076A 6004            	  1026:     BRA     .Exit
                            	  1027: 
                            	  1028: .BufferUnderrun:
00:0000076C 72FF            	  1029:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:0000076E 7000            	  1030:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	  1031: 
                            	  1032: .Exit:
00:00000770 4CDF013C        	  1033:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:00000774 4E75            	  1034:     RTS
                            	  1035: 
00:00000776 4D4552444120494E	  1036:     DC.B "MERDA INCIA"
00:0000077E 434941
                            	  1037:     ALIGN 2
                            	  1038: ; =====================================================================
                            	  1039: ; XMODEM RECEIVER ROUTINE
                            	  1040: ;bloco.append(0x01);        // SOH
                            	  1041: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1042: ;bloco.append(255 - blockNumber); // Complemento
                            	  1043: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1044: ;bloco.append(checksum);    // Checksum calculado
                            	  1045: ; =====================================================================
                            	  1046: XMODEM_Receive:
00:00000784 48E73FFE        	  1047:                 MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1048:                 ; Inicializa variáveis
00:00000788 41F900081325    	  1049:                 LEA     expected_block,A0
00:0000078E 103C0001        	  1050:                 MOVE.B  #1,D0
00:00000792 1080            	  1051:                 MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:00000794 41F900081124    	  1052:                 LEA     xmodem_buffer,A0
                            	  1053: 
                            	  1054:                 ; ---- 1. INICIALIZAÇÃO ----
00:0000079A 103C0015        	  1055:                 MOVE.B  #NAK,D0
00:0000079E 4EB801EA        	  1056:                 JSR     UART_WriteChar      ; Solicita início
                            	  1057: 
                            	  1058:                 ;SINALIZA NACK SENT
00:000007A2 303C0800        	  1059:                 MOVE.W  #$0800,D0
00:000007A6 4EB8012A        	  1060:                 JSR     WRITE_LEDS
                            	  1061: 
                            	  1062:                 ; ---- 2. LOOP PRINCIPAL ----
                            	  1063: Receive_Loop:
00:000007AA 4EB80224        	  1064:                 JSR     UART_ReadCharNonEcho
                            	  1065: 
00:000007AE B03C0004        	  1066:                 CMP.B   #EOT,D0
00:000007B2 670000B0        	  1067:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1068: 
00:000007B6 B03C0001        	  1069:                 CMP.B   #SOH,D0
00:000007BA 66EE            	  1070:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1071: 
                            	  1072:                 ;SINALIZA leds
00:000007BC 303C0C00        	  1073:                 MOVE.W  #$0C00,D0
00:000007C0 4EB8012A        	  1074:                 JSR     WRITE_LEDS
                            	  1075: 
                            	  1076:                 ; ---- 3. RECEBE HEADER ----
00:000007C4 4EB80224        	  1077:                 JSR     UART_ReadCharNonEcho       ; Block number
00:000007C8 13C000081324    	  1078:                 MOVE.B  D0,block_number
                            	  1079: 
00:000007CE 4EB80224        	  1080:                 JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1081: 
                            	  1082:                 ;SINALIZA leds
00:000007D2 303C0800        	  1083:                 MOVE.W  #$0800,D0
00:000007D6 4EB8012A        	  1084:                 JSR     WRITE_LEDS
                            	  1085: 
                            	  1086:                 ; ---- 4. RECEBE DADOS ----
00:000007DA 7220            	  1087:                 MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:000007DC 43F900081124    	  1088:                 LEA     xmodem_buffer,A1
                            	  1089: Read_Loop:
                            	  1090:                 ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:000007E2 4EB80224        	  1091:                 JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:000007E6 E188            	  1092:                 LSL.L   #8,D0
00:000007E8 4EB80224        	  1093:                 JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:000007EC E188            	  1094:                 LSL.L   #8,D0
00:000007EE 4EB80224        	  1095:                 JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:000007F2 E188            	  1096:                 LSL.L   #8,D0
00:000007F4 4EB80224        	  1097:                 JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:000007F8 22C0            	  1098:                 MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:000007FA 5381            	  1099:                 SUBQ.L  #1,D1
00:000007FC 66E4            	  1100:                 BNE     Read_Loop
                            	  1101: 
00:000007FE 303C0600        	  1102:                 MOVE.W  #$0600,D0
00:00000802 4EB8012A        	  1103:                 JSR     WRITE_LEDS
                            	  1104: 
                            	  1105:                 ; ---- 5. VERIFICA CHECKSUM ----
00:00000806 4EB80224        	  1106:                 JSR     UART_ReadCharNonEcho       ; Checksum
00:0000080A 1400            	  1107:                 MOVE.B  D0,D2
                            	  1108: 
                            	  1109: 
                            	  1110: ;******************************************************************************************
                            	  1111:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1112:            ;     BRA     Send_ACK
                            	  1113: ;******************************************************************************************
                            	  1114: 
                            	  1115:                 ; Calcula checksum local
                            	  1116:            ;     LEA     xmodem_buffer,A1
                            	  1117:            ;     MOVE.W  #127,D1
                            	  1118:            ;     CLR.B   D3
                            	  1119: 
                            	  1120: Calc_Checksum:
                            	  1121:            ;     ADD.B   (A1)+,D3
                            	  1122:            ;     DBF     D1,Calc_Checksum;
                            	  1123: 
                            	  1124:            ;     CMP.B   D2,D3
                            	  1125:            ;     BNE     Send_NAK            ; Erro no checksum
                            	  1126: 
                            	  1127:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1128:            ;     MOVE.B  block_number,D0
                            	  1129:            ;     CMP.B   expected_block,D0
                            	  1130:            ;     BNE     Send_NAK            ; Bloco fora de ordem
                            	  1131: 
                            	  1132:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1133:                 ; (Aqui você processa os 128 bytes recebidos)
                            	  1134:                 ; Exemplo: copiar do buffer para a RAM
                            	  1135:                 ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:0000080C 43F900081124    	  1136:                 LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:00000812 247900081326    	  1137:                 MOVE.L  user_buffer_ptr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:00000818 7220            	  1138:                 MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1139: Copy_Data:
00:0000081A 24D9            	  1140:                 MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:0000081C 5381            	  1141:                 SUBQ.L  #1,D1               ; Decrementa contador
00:0000081E 66FA            	  1142:                 BNE     Copy_Data            ; Repete até D1 = 0
                            	  1143:                 ; 2. Atualiza user_buffer_ptr para o próximo bloco (+128 bytes)
00:00000820 203900081326    	  1144:                 MOVE.L  user_buffer_ptr,D0
00:00000826 068000000080    	  1145:                 ADDI.L  #128,D0
00:0000082C 23C000081326    	  1146:                 MOVE.L  D0,user_buffer_ptr
                            	  1147: 
                            	  1148: 
                            	  1149: 
                            	  1150:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:00000832 523900081325    	  1151:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000838 103C0006        	  1152:                 MOVE.B  #ACK,D0
00:0000083C 4EB801EA        	  1153:                 JSR     UART_WriteChar
00:00000840 6000FF68        	  1154:                 BRA     Receive_Loop
                            	  1155: 
                            	  1156: Send_ACK:
                            	  1157:                 ;SINALIZA NACK SENT
00:00000844 303C0400        	  1158:                 MOVE.W  #$0400,D0
00:00000848 4EB8012A        	  1159:                 JSR     WRITE_LEDS
00:0000084C 103C0006        	  1160:                 MOVE.B  #ACK,D0
00:00000850 4EB801EA        	  1161:                 JSR     UART_WriteChar
00:00000854 6000FF54        	  1162:                 BRA     Receive_Loop
                            	  1163: 
                            	  1164: Send_NAK:
00:00000858 103C0015        	  1165:                 MOVE.B  #NAK,D0
00:0000085C 4EB801EA        	  1166:                 JSR     UART_WriteChar
00:00000860 6000FF48        	  1167:                 BRA     Receive_Loop
                            	  1168: 
                            	  1169: Transfer_Complete:
00:00000864 103C0006        	  1170:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:00000868 4EB801EA        	  1171:                 JSR     UART_WriteChar
00:0000086C 4CDF7FFC        	  1172:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:00000870 4E75            	  1173:                 RTS
                            	  1174: 
                            	  1175: ;Receive_XMODEM:
                            	  1176: ;    MOVE.L  #64,D1           ; 128 bytes / 2 (64 words)
                            	  1177: ;    LEA     xmodem_buffer,A1
                            	  1178: ;Receive_Loop:
                            	  1179: ;    JSR     UART_ReadChar    ; Lê byte alto (D0.b)
                            	  1180: ;    LSL.W   #8,D0            ; Desloca para o byte alto da word
                            	  1181: ;    MOVE.B  D0,D2            ; Armazena temporariamente
                            	  1182: ;    JSR     UART_ReadChar    ; Lê byte baixo (D0.b)
                            	  1183: ;    OR.B    D2,D0            ; Combina os dois bytes em uma word (D0.w)
                            	  1184: ;    MOVE.W  D0,(A1)+         ; Grava a word na memória
                            	  1185: ;    SUBQ    #1,D1
                            	  1186: ;    BNE     Receive_Loop
                            	  1187: 
                            	  1188: ;Receive_XMODEM:
                            	  1189: ;    LEA     xmodem_buffer,A0
                            	  1190: ;    LEA     128(A0),A1       ; A1 = fim do buffer (A0 + 128)
                            	  1191: ;    MOVEQ   #0,D0            ; Limpa D0 (opcional)
                            	  1192: ;Read_Loop:
                            	  1193: ;    JSR     UART_ReadChar    ; Lê byte 1 (D0.b)
                            	  1194: ;    LSL.W   #8,D0            ; Armazena no byte alto da word
                            	  1195: ;    JSR     UART_ReadChar    ; Lê byte 2 (D0.b)
                            	  1196: ;    MOVE.W  D0,(A0)+         ; Grava a word
                            	  1197: ;    CMPA.L  A0,A1            ; A0 >= A1?
                            	  1198: ;    BLO     Read_Loop        ; Se não, continua
                            	  1199: 
                            	  1200: ;Receive_XMODEM:
                            	  1201: ;    MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
                            	  1202: ;    LEA     xmodem_buffer,A1
                            	  1203: ;Read_Loop:
                            	  1204: ;    ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
                            	  1205: ;    JSR     UART_ReadChar    ; Byte 1 (bits 24-31)
                            	  1206: ;    LSL.L   #8,D0
                            	  1207: ;    JSR     UART_ReadChar    ; Byte 2 (bits 16-23)
                            	  1208: ;    LSL.L   #8,D0
                            	  1209: ;    JSR     UART_ReadChar    ; Byte 3 (bits 8-15)
                            	  1210: ;    LSL.L   #8,D0
                            	  1211: ;    JSR     UART_ReadChar    ; Byte 4 (bits 0-7)
                            	  1212: ;    MOVE.L  D0,(A1)+         ; Grava os 4 bytes
                            	  1213: ;    SUBQ.L  #1,D1
                            	  1214: ;    BNE     Read_Loop
                            	  1215: 
