                            	   817: ;--------------------------------------------------
                            	   818: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   819: ;--------------------------------------------------
                            	   820: ; Exemplo: insere 'A' no buffer
                            	   821: ;          MOVE.B  #'A',D0
                            	   822: ;          JSR     UART_BufferPut
                            	   823: 
                            	   824: BufferPut:
00:000005BA 2F01            	   825:     MOVE.L  D1,-(SP)
00:000005BC 2F08            	   826:     MOVE.L  A0,-(SP)
                            	   827: 
                            	   828:     ;ANDI.W    #$FF00,D0
00:000005BE 41F900081034    	   829:     LEA     BUFFER,A0
00:000005C4 323900081032    	   830:     MOVE.W  BUFFER_COUNT,D1
                            	   831: 
00:000005CA B27C0100        	   832:     CMP.W   #256,D1
00:000005CE 6C1C            	   833:     BGE     .BufferFull
                            	   834: 
                            	   835:     ; Modificado para usar deslocamento de 16 bits
00:000005D0 32390008102A    	   836:     MOVE.W  BUFFER_HEAD,D1
00:000005D6 D0C1            	   837:     ADD     D1,A0
00:000005D8 1080            	   838:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   839: 
00:000005DA 5441            	   840:     ADD     #2,D1              ; Incrementa como word
00:000005DC 024100FF        	   841:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005E0 33C10008102A    	   842:     MOVE.W  D1,BUFFER_HEAD
                            	   843: 
00:000005E6 527900081032    	   844:     ADDQ.W  #1,BUFFER_COUNT
                            	   845: 
                            	   846: .BufferFull:
00:000005EC 205F            	   847:     MOVE.L  (SP)+,A0
00:000005EE 221F            	   848:     MOVE.L  (SP)+,D1
                            	   849: 
00:000005F0 4E75            	   850:     RTS
                            	   851: 
                            	   852: ;--------------------------------------------------
                            	   853: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   854: ;--------------------------------------------------
                            	   855: ;Exemplo: Lendo byte do buffer
                            	   856: ;         BSR     UART_BufferGet
                            	   857: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   858: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   859: ;         Senão, D0 contém o byte lido!
                            	   860: BufferGet:
00:000005F2 2F01            	   861:     MOVE.L  D1,-(SP)
00:000005F4 2F08            	   862:     MOVE.L  A0,-(SP)
                            	   863: 
00:000005F6 323900081032    	   864:     MOVE.W  BUFFER_COUNT,D1
00:000005FC 6724            	   865:     BEQ     .BufferEmpty
                            	   866: 
00:000005FE 41F900081034    	   867:     LEA     BUFFER,A0
                            	   868: 
                            	   869:     ; Modificado para usar deslocamento de 16 bits
00:00000604 32390008102E    	   870:     MOVE.W  BUFFER_TAIL,D1
00:0000060A 10301000        	   871:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   872: 
00:0000060E 5401            	   873:     ADDQ.B  #2,D1              ; Incrementa como word
00:00000610 024100FF        	   874:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000614 33C10008102E    	   875:     MOVE.W  D1,BUFFER_TAIL
                            	   876: 
00:0000061A 537900081032    	   877:     SUBQ.W  #1,BUFFER_COUNT
00:00000620 6006            	   878:     BRA     .Exit
                            	   879: 
                            	   880: .BufferEmpty:
00:00000622 4EB8062E        	   881:     JSR     FBufferEmpty
00:00000626 70FF            	   882:     MOVEQ   #-1,D0
                            	   883: .Exit:
00:00000628 205F            	   884:     MOVE.L  (SP)+,A0
00:0000062A 221F            	   885:     MOVE.L  (SP)+,D1
00:0000062C 4E75            	   886:     RTS
                            	   887: 
                            	   888: FBufferEmpty:
00:0000062E 4EB801EE        	   889:         JSR     new_line
00:00000632 41F900000300    	   890:         LEA     BufferEmpty,A0
