                            	    13: ;Clock frequency in Hz
                            	    14: F_CPU       equ 16000000
                            	    15: ;Uart register offsets
                            	    16: RHR         equ     0   ; receive holding register (read)
                            	    17: THR         equ     0   ; transmit holding register (write)
                            	    18: IER         equ     2   ; interrupt enable register
                            	    19: ISR         equ     4   ; interrupt status register (read)
                            	    20: FCR         equ     4   ; FIFO control register (write)
                            	    21: LCR         equ     6   ; line control register
                            	    22: MCR         equ     8   ; modem control register
                            	    23: LSR         equ     10  ; line status register
                            	    24: MSR         equ     12  ; modem status register
                            	    25: SPR         equ     14  ; scratchpad register (reserved for system use)
                            	    26: DLL         equ     0   ; divisor latch LSB
                            	    27: DLM         equ     2   ; divisor latch MSB
                            	    28: ; aliases for register names (used by different manufacturers)cd ..
                            	    29: RBR         equ     RHR ; receive buffer register
                            	    30: IIR         equ     ISR ; interrupt identification register
                            	    31: SCR         equ     SPR ; scratch register
                            	    32: 
                            	    33: LED_ADDRESS equ     $4400
                            	    34: UART_BASE   equ     $4000
                            	    35: BAUD_RATE   equ     9600
                            	    36: BAUD_DIV    equ     (((F_CPU*10)/(16*BAUD_RATE))+5)/10 ; compute one extra decimal place and round
                            	    37: BAUD_DIV_L  equ     (BAUD_DIV&$FF)
                            	    38: BAUD_DIV_U  equ     ((BAUD_DIV>>8)&$FF)
                            	    39: 
                            	    40: ;=== Uart receiver ================= CONSTANTES =================
                            	    41: SOH         EQU     $01        ; Start Of Header
                            	    42: EOT         EQU     $04        ; End Of Transmission
                            	    43: ACK         EQU     $06        ; Acknowledge
                            	    44: NAK         EQU     $15        ; Negative Acknowledge
                            	    45: CAN         EQU     $18        ; Cancel
                            	    46: 
