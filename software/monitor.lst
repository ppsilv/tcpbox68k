00:00000776 4EB801AC        	  1008:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:0000077A E188            	  1009:        LSL.L   #8,D0
00:0000077C 4EB801AC        	  1010:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:00000780 E188            	  1011:        LSL.L   #8,D0
00:00000782 4EB801AC        	  1012:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:00000786 E188            	  1013:        LSL.L   #8,D0
00:00000788 4EB801AC        	  1014:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:0000078C 22C0            	  1015:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:0000078E 5381            	  1016:        SUBQ.L  #1,D1
00:00000790 66E4            	  1017:        BNE     Read_Loop
