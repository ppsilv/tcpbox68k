                            	   210: ; ----------------------------------------------------------------------
                            	   211: ; UART_WriteString - Envia string terminada em null para UART
                            	   212: ; Entrada:
                            	   213: ;   A0 = Ponteiro para a string (endereço da string)
                            	   214: ; ----------------------------------------------------------------------
                            	   215: UART_WriteString:
00:000001C2 2F08            	   216:         MOVE.L  A0,-(SP)      ; Preserva D0
00:000001C4 2F00            	   217:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   218: .WriteLoop:
00:000001C6 1018            	   219:         MOVE.B  (A0)+,D0      ; Pega caractere
00:000001C8 6706            	   220:         BEQ     .Done
00:000001CA 4EB80172        	   221:         JSR     UART_WriteChar ; Use sua rotine existente
00:000001CE 60F6            	   222:         BRA     .WriteLoop
                            	   223: .Done:
00:000001D0 201F            	   224:         MOVE.L  (SP)+,D0
00:000001D2 205F            	   225:         MOVE.L  (SP)+,A0
00:000001D4 4E75            	   226:         RTS
