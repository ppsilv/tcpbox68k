                            	   707: .Done:
                            	   708: ;         BSR     UART_BufferGet
                            	   709: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   710: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   711: ;         Senão, D0 contém o byte lido!
                            	   712: .loop1:
