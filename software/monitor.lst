                            	   695: 
00:0000050C 7000            	   696:         MOVEQ   #0,D0
00:0000050E 721C            	   697:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:00000510 7400            	   698:         MOVEQ   #0,D2            ; Resultado em D2
                            	   699: .Loop:
00:00000512 7000            	   700:         CLR.L   D0
00:00000514 4EB8018C        	   701:         JSR     UART_ReadChar
00:00000518 B03C000D        	   702:         CMP.B   #13,D0
00:0000051C 674C            	   703:         BEQ     .Done
00:0000051E B03C000A        	   704:         CMP.B   #10,D0
00:00000522 6746            	   705:         BEQ     .Done
