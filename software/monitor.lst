                            	   933: ; XMODEM RECEIVER ROUTINE
                            	   934: ; =====================================================================
                            	   935: XMODEM_Receive:
00:000006B4 48E73FFE        	   936:                 MOVEM.L D2-D7/A0-A6,-(SP)
00:000006B8 41F9000815A4    	   937:                 LEA     xmodem_buffer,A0
                            	   938: 
                            	   939:                 ; ---- 1. INICIALIZAÇÃO ----
00:000006BE 103C0015        	   940:                 MOVE.B  #NAK,D0
00:000006C2 4EB80134        	   941:                 JSR     UART_WriteChar      ; Solicita início
                            	   942: 
                            	   943:                 ; ---- 2. LOOP PRINCIPAL ----
                            	   944: Receive_Loop:
00:000006C6 4EB8014E        	   945:                 JSR     UART_ReadChar
00:000006CA B03C0004        	   946:                 CMP.B   #EOT,D0
00:000006CE 67000088        	   947:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	   948: 
00:000006D2 B03C0001        	   949:                 CMP.B   #SOH,D0
00:000006D6 66EE            	   950:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   951: 
                            	   952:                 ; ---- 3. RECEBE HEADER ----
00:000006D8 4EB8014E        	   953:                 JSR     UART_ReadChar       ; Block number
00:000006DC 13C000081624    	   954:                 MOVE.B  D0,block_number
00:000006E2 4EB8014E        	   955:                 JSR     UART_ReadChar       ; ~Block number (complemento)
                            	   956: 
                            	   957:                 ; ---- 4. RECEBE DADOS ----
00:000006E6 323C007F        	   958:                 MOVE.W  #127,D1             ; 128 bytes (0-based)
00:000006EA 43F9000815A4    	   959:                 LEA     xmodem_buffer,A1
                            	   960: 
                            	   961: Receive_Data:
00:000006F0 4EB8014E        	   962:                 JSR     UART_ReadChar
00:000006F4 12C0            	   963:                 MOVE.B  D0,(A1)+
00:000006F6 51C9FFF8        	   964:                 DBF     D1,Receive_Data
                            	   965: 
                            	   966:                 ; ---- 5. VERIFICA CHECKSUM ----
00:000006FA 4EB8014E        	   967:                 JSR     UART_ReadChar       ; Checksum
00:000006FE 1400            	   968:                 MOVE.B  D0,D2
                            	   969: 
                            	   970:                 ; Calcula checksum local
00:00000700 43F9000815A4    	   971:                 LEA     xmodem_buffer,A1
00:00000706 323C007F        	   972:                 MOVE.W  #127,D1
00:0000070A 4203            	   973:                 CLR.B   D3
                            	   974: 
                            	   975: Calc_Checksum:
00:0000070C D619            	   976:                 ADD.B   (A1)+,D3
00:0000070E 51C9FFFC        	   977:                 DBF     D1,Calc_Checksum
                            	   978: 
00:00000712 B602            	   979:                 CMP.B   D2,D3
00:00000714 6636            	   980:                 BNE     Send_NAK            ; Erro no checksum
                            	   981: 
                            	   982:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
00:00000716 103900081624    	   983:                 MOVE.B  block_number,D0
00:0000071C B03900081625    	   984:                 CMP.B   expected_block,D0
00:00000722 6628            	   985:                 BNE     Send_NAK            ; Bloco fora de ordem
                            	   986: 
                            	   987:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	   988:                 ; (Aqui você processa os 128 bytes recebidos)
                            	   989:                 ; Exemplo: copiar para RAM/Flash
00:00000724 43F9000815A4    	   990:                 LEA     xmodem_buffer,A1
00:0000072A 247900081524    	   991:                 MOVE.L  user_buffer_ptr,A2  ; Defina isso antes de chamar
00:00000730 323C007F        	   992:                 MOVE.W  #127,D1
                            	   993: Copy_Data:
00:00000734 14D9            	   994:                 MOVE.B  (A1)+,(A2)+
00:00000736 51C9FFFC        	   995:                 DBF     D1,Copy_Data
                            	   996: 
                            	   997:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:0000073A 523900081625    	   998:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000740 103C0006        	   999:                 MOVE.B  #ACK,D0
00:00000744 4EB80134        	  1000:                 JSR     UART_WriteChar
00:00000748 6000FF7C        	  1001:                 BRA     Receive_Loop
                            	  1002: 
                            	  1003: Send_NAK:
00:0000074C 103C0015        	  1004:                 MOVE.B  #NAK,D0
00:00000750 4EB80134        	  1005:                 JSR     UART_WriteChar
00:00000754 6000FF70        	  1006:                 BRA     Receive_Loop
                            	  1007: 
                            	  1008: Transfer_Complete:
00:00000758 103C0006        	  1009:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:0000075C 4EB80134        	  1010:                 JSR     UART_WriteChar
00:00000760 4CDF7FFC        	  1011:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:00000764 4E75            	  1012:                 RTS
                            	  1013: 
00:00000766 4D45524441205445	  1014:     DC.B "MERDA TERMINA"
00:0000076E 524D494E41
