                            	   178: ; ----------------------------------------------------------------------
                            	   179: ; UART_WriteString - Envia string terminada em null para UART
                            	   180: ; Entrada:
                            	   181: ;   A0 = Ponteiro para a string (endereço da string)
                            	   182: ; ----------------------------------------------------------------------
                            	   183: UART_WriteString:
00:0000016E 2F08            	   184:     MOVE.L  A0,-(SP)      ; Preserva D0
00:00000170 2F00            	   185:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   186: .WriteLoop:
00:00000172 1018            	   187:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000174 6706            	   188:     BEQ     .Done
00:00000176 4EB80134        	   189:     JSR     UART_WriteChar ; Use sua rotine existente
00:0000017A 60F6            	   190:     BRA     .WriteLoop
                            	   191: .Done:
00:0000017C 201F            	   192:     MOVE.L  (SP)+,D0
00:0000017E 205F            	   193:     MOVE.L  (SP)+,A0
00:00000180 4E75            	   194:     RTS
