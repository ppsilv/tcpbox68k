00:000005AE 5F00            	   811:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   812: .Digit:
00:000005B0 903C0030        	   813:     SUB.B   #'0',D0
00:000005B4 C03C000F        	   814:     AND.B   #$0F,D0
00:000005B8 4E75            	   815:     RTS
