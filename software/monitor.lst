                            	   607: ; ----------------------------------------------------------------------
                            	   608: ; Subrotinas do Menu
                            	   609: ; ----------------------------------------------------------------------
                            	   610: 
                            	   611: ; 1. Seleciona UART
                            	   612: SelectUART:
00:00000436 41F90000035E    	   613:     LEA     PromptNotImplemented,A0
00:0000043C 4EB80188        	   614:     JSR     UART_WriteString
                            	   615:     ;LEA     UARTPrompt,A0
                            	   616:     ;JSR     UART_WriteString
                            	   617:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   618:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   619:     ;JSR     UART_Init           ; Reinicializa UART
00:00000440 6000FC2A        	   620:     BRA     MenuLoop
                            	   621: 
                            	   622: ; 2. Configura Baud Rate
                            	   623: SetBaudRate:
00:00000444 41F90000035E    	   624:     LEA     PromptNotImplemented,A0
00:0000044A 4EB80188        	   625:     JSR     UART_WriteString
                            	   626:     ;LEA     BaudPrompt,A0
                            	   627:     ;JSR     UART_WriteString
                            	   628:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   629:     ;MOVE.L  CurrentUART,A0
                            	   630:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
00:0000044E 6000FC1C        	   631:     BRA     MenuLoop
                            	   632: 
                            	   633: ; 3. Carrega programa via serial
                            	   634: LoadProgram:
00:00000452 41F900081124    	   635:     LEA     DEST_BUFFER,A0   ; Onde os dados serão salvos
00:00000458 23C800081524    	   636:     MOVE.L  A0,user_buffer_ptr
00:0000045E 4EB806D0        	   637:     JSR     XMODEM_Receive
00:00000462 6000FC08        	   638:     BRA     MenuLoop
                            	   639: 
                            	   640: ; 4. Grava programa manualmente (hex)
                            	   641: WriteProgram:
00:00000466 41F900000314    	   642:     LEA     WritePrompt,A0
00:0000046C 4EB80188        	   643:     JSR     UART_WriteString
00:00000470 4EB80500        	   644:     JSR     UART_ReadHex        ; Lê endereço
00:00000474 2240            	   645:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   646: 
00:00000476 41F900000324    	   647:     LEA     WriteSizePrompt,A0
00:0000047C 4EB80188        	   648:     JSR     UART_WriteString
00:00000480 4EB80500        	   649:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:00000484 2200            	   650:     MOVE.L  D0,D1               ; D1 = contador
                            	   651: 
                            	   652: .WriteLoop:
00:00000486 4EB805A0        	   653:     JSR     UART_ReadByte       ; Lê byte
00:0000048A 12C0            	   654:     MOVE.B  D0,(A1)+            ; Armazena
00:0000048C 5381            	   655:     SUBQ.L  #1,D1
00:0000048E 66F6            	   656:     BNE     .WriteLoop
                            	   657: 
00:00000490 41F900000336    	   658:     LEA     WriteDoneMsg,A0
00:00000496 4EB80188        	   659:     JSR     UART_WriteString
00:0000049A 6000FBD0        	   660:     BRA     MenuLoop
                            	   661: 
                            	   662: ; 5. Executa programa na RAM
                            	   663: RunProgram:
00:0000049E 41F900000350    	   664:     LEA     RunPrompt,A0
00:000004A4 4EB80188        	   665:     JSR     UART_WriteString
00:000004A8 4EB80500        	   666:     JSR     UART_ReadHex        ; Lê endereço
00:000004AC 2040            	   667:     MOVE.L  D0,A0
00:000004AE 4E90            	   668:     JSR     (A0)                ; Chama subrotina
00:000004B0 6000FBBA        	   669:     BRA     MenuLoop
