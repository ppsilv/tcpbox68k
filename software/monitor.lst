                            	  1049:         ;MOVE.W  #127,D1
                            	  1050:         ;CLR.B   D3
                            	  1051: 
                            	  1052: Calc_Checksum:
                            	  1053:         ;ADD.B   (A1)+,D3
                            	  1054:         ;DBF     D1,Calc_Checksum;
                            	  1055: 
                            	  1056:         ;CMP.B   D2,D3
                            	  1057:         ;BNE     Send_NAK            ; Erro no checksum
                            	  1058: 
                            	  1059:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1060:         ;MOVE.B  block_number,D0
                            	  1061:         ;CMP.B   expected_block,D0
                            	  1062:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1063: 
                            	  1064:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1065:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1066:         ; Exemplo: copiar do buffer para a RAM
                            	  1067:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:000007E4 43F90008112C    	  1068:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:000007EA 24790008132E    	  1069:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:000007F0 7220            	  1070:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1071: Copy_Data:
00:000007F2 24D9            	  1072:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:000007F4 5381            	  1073:         SUBQ.L  #1,D1               ; Decrementa contador
00:000007F6 66FA            	  1074:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1075:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
00:000007F8 20390008132E    	  1076:         MOVE.L  usr_buffer_addr,D0
00:000007FE 068000000080    	  1077:         ADDI.L  #128,D0
00:00000804 23C00008132E    	  1078:         MOVE.L  D0,usr_buffer_addr
                            	  1079: 
                            	  1080: 
                            	  1081: 
