00:00000518 7400            	   697:         MOVEQ   #0,D2            ; Resultado em D2
                            	   698: 
                            	   699: .Loop:
00:0000051A 4EB801CA        	   700:         JSR     UART_ReadChar
00:0000051E B03C000D        	   701:         CMP.B   #13,D0
00:00000522 670C            	   702:         BEQ     .Done
