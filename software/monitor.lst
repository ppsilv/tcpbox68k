00:00000186 D03C0101        	   190:     ADD.B   #$0101,D0
00:0000018A 10C0            	   191:     MOVE.B  D0,(A0)+
00:0000018C B3C8            	   192:     CMPA.L  A0,A1
00:0000018E 62F6            	   193:     BHI     .ClearLoop
