                            	  1081: ; XMODEM RECEIVER ROUTINE
                            	  1082: ;bloco.append(0x01);        // SOH
                            	  1083: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1084: ;bloco.append(255 - blockNumber); // Complemento
                            	  1085: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1086: ;bloco.append(checksum);    // Checksum calculado
                            	  1087: ; =====================================================================
                            	  1088: XMODEM_Receive:
01:000017C8 48E73FFE        	  1089:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1090:        ; Inicializa variáveis
01:000017CC 41F90008132D    	  1091:        LEA     expected_block,A0
01:000017D2 103C0001        	  1092:        MOVE.B  #1,D0
01:000017D6 1080            	  1093:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
01:000017D8 41F90008112C    	  1094:        LEA     xmodem_buffer,A0
                            	  1095: 
01:000017DE 41F900081934    	  1096:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
01:000017E4 103C0000        	  1097:        MOVE.B  #0,D0
01:000017E8 1080            	  1098:        MOVE.B  D0,(A0)              ; Program not loaded
                            	  1099: 
                            	  1100:        ; ---- 1. INICIALIZAÇÃO ----
01:000017EA 103C0015        	  1101:        MOVE.B  #NAK,D0
01:000017EE 4EB8121C        	  1102:        JSR     UART_WriteChar      ; Solicita início
                            	  1103: 
                            	  1104:        ;SINALIZA NACK SENT
01:000017F2 303C0800        	  1105:        MOVE.W  #$0800,D0
01:000017F6 4EB811B4        	  1106:        JSR     __write_leds
                            	  1107: 
                            	  1108:        ; ---- 2. LOOP PRINCIPAL ----
                            	  1109: Receive_Loop:
01:000017FA 4EB81256        	  1110:        JSR     UART_ReadCharNonEcho
                            	  1111: 
01:000017FE B03C0004        	  1112:        CMP.B   #EOT,D0
01:00001802 670000B0        	  1113:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1114: 
01:00001806 B03C0001        	  1115:        CMP.B   #SOH,D0
01:0000180A 66EE            	  1116:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1117: 
                            	  1118:        ;SINALIZA leds
01:0000180C 303C0C00        	  1119:        MOVE.W  #$0C00,D0
01:00001810 4EB811B4        	  1120:        JSR     __write_leds
                            	  1121: 
                            	  1122:        ; ---- 3. RECEBE HEADER ----
01:00001814 4EB81256        	  1123:        JSR     UART_ReadCharNonEcho       ; Block number
01:00001818 13C00008132C    	  1124:        MOVE.B  D0,block_number
                            	  1125: 
01:0000181E 4EB81256        	  1126:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1127: 
                            	  1128:        ;SINALIZA leds
01:00001822 303C0800        	  1129:        MOVE.W  #$0800,D0
01:00001826 4EB811B4        	  1130:        JSR     __write_leds
                            	  1131: 
                            	  1132:        ; ---- 4. RECEBE DADOS ----
01:0000182A 7220            	  1133:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
01:0000182C 43F90008112C    	  1134:        LEA     xmodem_buffer,A1
                            	  1135: Read_Loop:
                            	  1136:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
01:00001832 4EB81256        	  1137:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
01:00001836 E188            	  1138:        LSL.L   #8,D0
01:00001838 4EB81256        	  1139:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
01:0000183C E188            	  1140:        LSL.L   #8,D0
01:0000183E 4EB81256        	  1141:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
01:00001842 E188            	  1142:        LSL.L   #8,D0
01:00001844 4EB81256        	  1143:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
01:00001848 22C0            	  1144:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
01:0000184A 5381            	  1145:        SUBQ.L  #1,D1
01:0000184C 66E4            	  1146:        BNE     Read_Loop
                            	  1147: 
01:0000184E 303C0600        	  1148:        MOVE.W  #$0600,D0
01:00001852 4EB811B4        	  1149:        JSR     __write_leds
                            	  1150: 
                            	  1151:        ; ---- 5. VERIFICA CHECKSUM ----
01:00001856 4EB81256        	  1152:        JSR     UART_ReadCharNonEcho       ; Checksum
01:0000185A 1400            	  1153:        MOVE.B  D0,D2
                            	  1154: 
                            	  1155: 
                            	  1156: ;******************************************************************************************
                            	  1157:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1158:            ;     BRA     Send_ACK
                            	  1159: ;******************************************************************************************
                            	  1160: 
                            	  1161:         ; Calcula checksum local
                            	  1162:         ;LEA     xmodem_buffer,A1
                            	  1163:         ;MOVE.W  #127,D1
                            	  1164:         ;CLR.B   D3
                            	  1165: 
                            	  1166: Calc_Checksum:
                            	  1167:         ;ADD.B   (A1)+,D3
                            	  1168:         ;DBF     D1,Calc_Checksum;
                            	  1169: 
                            	  1170:         ;CMP.B   D2,D3
                            	  1171:         ;BNE     Send_NAK            ; Erro no checksum
                            	  1172: 
                            	  1173:         ;---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1174:         ;MOVE.B  block_number,D0
                            	  1175:         ;CMP.B   expected_block,D0
                            	  1176:         ;BNE     Send_NAK            ; Bloco fora de ordem
                            	  1177: 
                            	  1178:         ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1179:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1180:         ; Exemplo: copiar do buffer para a RAM
                            	  1181:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
01:0000185C 43F90008112C    	  1182:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
01:00001862 24790008132E    	  1183:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
01:00001868 7220            	  1184:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1185: Copy_Data:
01:0000186A 24D9            	  1186:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
01:0000186C 5381            	  1187:         SUBQ.L  #1,D1               ; Decrementa contador
01:0000186E 66FA            	  1188:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1189:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
01:00001870 20390008132E    	  1190:         MOVE.L  usr_buffer_addr,D0
01:00001876 068000000080    	  1191:         ADDI.L  #128,D0
01:0000187C 23C00008132E    	  1192:         MOVE.L  D0,usr_buffer_addr
                            	  1193: 
                            	  1194: 
                            	  1195: 
                            	  1196:         ; ---- 8. CONFIMA RECEPÇÃO ----
01:00001882 52390008132D    	  1197:         ADDQ.B  #1,expected_block   ; Próximo bloco
01:00001888 103C0006        	  1198:         MOVE.B  #ACK,D0
01:0000188C 4EB8121C        	  1199:         JSR     UART_WriteChar
01:00001890 6000FF68        	  1200:         BRA     Receive_Loop
                            	  1201: 
                            	  1202: Send_ACK:
                            	  1203:         ;SINALIZA NACK SENT
01:00001894 303C0400        	  1204:         MOVE.W  #$0400,D0
01:00001898 4EB811B4        	  1205:         JSR     __write_leds
01:0000189C 103C0006        	  1206:         MOVE.B  #ACK,D0
01:000018A0 4EB8121C        	  1207:         JSR     UART_WriteChar
01:000018A4 6000FF54        	  1208:         BRA     Receive_Loop
                            	  1209: 
                            	  1210: Send_NAK:
01:000018A8 103C0015        	  1211:         MOVE.B  #NAK,D0
01:000018AC 4EB8121C        	  1212:         JSR     UART_WriteChar
01:000018B0 6000FF48        	  1213:         BRA     Receive_Loop
                            	  1214: 
                            	  1215: Transfer_Complete:
01:000018B4 103C0006        	  1216:         MOVE.B  #ACK,D0             ; Confirma EOT
01:000018B8 4EB8121C        	  1217:         JSR     UART_WriteChar
                            	  1218: 
01:000018BC 41F900081934    	  1219:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
01:000018C2 103C0001        	  1220:         MOVE.B  #1,D0
01:000018C6 1080            	  1221:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1222: 
01:000018C8 4CDF7FFC        	  1223:         MOVEM.L (SP)+,D2-D7/A0-A6
01:000018CC 4E75            	  1224:         RTS
                            	  1225: ; ========================================================
                            	  1226: ; Validador de Checksum para ROM (MC68000)
                            	  1227: ; Assume:
                            	  1228: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1229: ;   - Big-endian (padrão 68000)
                            	  1230: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1231: ; ========================================================
                            	  1232: 
                            	  1233: VALIDATE_ROM:
01:000018CE 91C8            	  1234:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
01:000018D0 203C00003FFC    	  1235:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
01:000018D6 7200            	  1236:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1237: 
                            	  1238:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1239: .CHECKSUM_LOOP:
01:000018D8 2418            	  1240:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
01:000018DA D282            	  1241:         ADD.L   D2,D1               ; Soma ao acumulador
01:000018DC 5980            	  1242:         SUB.L   #4,D0               ; Decrementa contador
01:000018DE 6EF8            	  1243:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1244: 
01:000018E0 41F900081930    	  1245:         LEA     checksum_calc,A0
01:000018E6 20C1            	  1246:         MOVE.L  D1,(A0)+
                            	  1247:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1248: 
                            	  1249:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
01:000018E8 24383FFC        	  1250:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
01:000018EC B481            	  1251:         CMP.L   D1,D2               ; Combina com o calculado?
01:000018EE 6706            	  1252:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1253: 
                            	  1254:         ; --- Checksum inválido: travar o sistema ou notificar ---
01:000018F0 363CDEAD        	  1255:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
01:000018F4 6002            	  1256:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1257: .CHECKSUM_OK:
01:000018F6 4E75            	  1258:         RTS                         ; Retorna (ROM válida)
                            	  1259: 
                            	  1260: SYSTEM_HALT:
01:000018F8 46FC2700        	  1261:         MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1262: .INFINITE_LOOP:
01:000018FC 60FE            	  1263:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1264: 
                            	  1265: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1266: VALIDATE_ROM_CRC32:
01:000018FE 91C8            	  1267:         LEA     ROM_START,A0        ; Endereço inicial
01:00001900 203C00003FFC    	  1268:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
01:00001906 72FF            	  1269:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1270: 
                            	  1271: CRC_LOOP:
01:00001908 1418            	  1272:         MOVE.B  (A0)+,D2            ; Lê 1 byte
01:0000190A B501            	  1273:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1274: 
                            	  1275:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1276:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1277: 
01:0000190C 5380            	  1278:         SUBQ.L  #1,D0
01:0000190E 6EF8            	  1279:         BGT     CRC_LOOP
                            	  1280: 
01:00001910 4681            	  1281:         NOT.L   D1                  ; Inverte os bits no final
                            	  1282: 
                            	  1283:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
01:00001912 24383FFB        	  1284:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
01:00001916 B481            	  1285:         CMP.L   D1,D2               ; Combina com o calculado?
01:00001918 6706            	  1286:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1287: 
                            	  1288:         ; --- Checksum inválido: travar o sistema ou notificar ---
01:0000191A 363CDEAD        	  1289:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
01:0000191E 60D8            	  1290:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1291: .CHECKSUM_OK:
01:00001920 4E75            	  1292:         RTS
                            	  1293: 
                            	  1294: ; --- Constantes ---
                            	  1295: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1296: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1297: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1298: 
                            	  1299: SPURIOUS_HANDLER:
01:00001922 31FCCB004400    	  1300:     MOVE.W  #$CB00,LED_ADDRESS  ; Indica spurious
01:00001928 4E73            	  1301:     RTE
                            	  1302: 
                            	  1303: DEFAULT_HANDLER:
01:0000192A 48E7FFFE        	  1304:     MOVEM.L D0-D7/A0-A6,-(SP)
                            	  1305: 
                            	  1306:     ; --- IDENTIFICA O TIPO DE EXCEÇÃO ---
                            	  1307:     ; --- AGORA lê corretamente da pilha ---
01:0000192E 202F000E        	  1308:     MOVE.L  (14,SP),D0      ; ⭐⭐ PC (14 bytes abaixo por causa dos registradores salvos)
01:00001932 322F0012        	  1309:     MOVE.W  (18,SP),D1      ; ⭐⭐ SR (18 bytes abaixo)
01:00001936 342F0014        	  1310:     MOVE.W  (20,SP),D2      ; ⭐⭐ Vector Offset (20 bytes abaixo)
                            	  1311: 
