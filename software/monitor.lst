00:000003D4 2F08            	   532:         MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003D6 41F9000003F6    	   533:         LEA     HitAnyKey,A0
00:000003DC 4EB801D6        	   534:         JSR     UART_WriteString
00:000003E0 4EB801A0        	   535:         JSR     UART_ReadChar
