00:000007FC 4EB80172        	  1088:         JSR     UART_WriteChar
                            	  1089: 
00:00000800 41F900081934    	  1090:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:00000806 103C0001        	  1091:         MOVE.B  #1,D0
00:0000080A 1080            	  1092:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1093: 
00:0000080C 4CDF7FFC        	  1094:         MOVEM.L (SP)+,D2-D7/A0-A6
00:00000810 4E75            	  1095:         RTS
                            	  1096: ; ========================================================
                            	  1097: ; Validador de Checksum para ROM (MC68000)
                            	  1098: ; Assume:
                            	  1099: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1100: ;   - Big-endian (padrão 68000)
                            	  1101: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1102: ; ========================================================
                            	  1103: 
                            	  1104: VALIDATE_ROM:
00:00000812 91C8            	  1105:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:00000814 203C00003FFC    	  1106:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:0000081A 7200            	  1107:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1108: 
                            	  1109:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1110: .CHECKSUM_LOOP:
00:0000081C 2418            	  1111:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:0000081E D282            	  1112:         ADD.L   D2,D1               ; Soma ao acumulador
00:00000820 5980            	  1113:         SUB.L   #4,D0               ; Decrementa contador
00:00000822 6EF8            	  1114:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1115: 
00:00000824 41F900081930    	  1116:         LEA     checksum_rom,A0
00:0000082A 20C1            	  1117:         MOVE.L  D1,(A0)+
                            	  1118:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1119: 
                            	  1120:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:0000082C 24383FFC        	  1121:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
00:00000830 B481            	  1122:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000832 6706            	  1123:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1124: 
                            	  1125:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000834 363CDEAD        	  1126:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000838 6002            	  1127:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1128: .CHECKSUM_OK:
00:0000083A 4E75            	  1129:         RTS                         ; Retorna (ROM válida)
                            	  1130: 
                            	  1131: SYSTEM_HALT:
00:0000083C 46FC0700        	  1132:         MOVE.W  #$0700,SR        ; Desabilita interrupções
                            	  1133: .INFINITE_LOOP:
00:00000840 60FE            	  1134:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1135: 
                            	  1136: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1137: VALIDATE_ROM_CRC32:
00:00000842 91C8            	  1138:         LEA     ROM_START,A0        ; Endereço inicial
00:00000844 203C00003FFC    	  1139:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
00:0000084A 72FF            	  1140:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1141: 
                            	  1142: CRC_LOOP:
00:0000084C 1418            	  1143:         MOVE.B  (A0)+,D2            ; Lê 1 byte
00:0000084E B501            	  1144:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1145: 
                            	  1146:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1147:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1148: 
00:00000850 5380            	  1149:         SUBQ.L  #1,D0
00:00000852 6EF8            	  1150:         BGT     CRC_LOOP
                            	  1151: 
00:00000854 4681            	  1152:         NOT.L   D1                  ; Inverte os bits no final
                            	  1153: 
                            	  1154:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:00000856 24383FFB        	  1155:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:0000085A B481            	  1156:         CMP.L   D1,D2               ; Combina com o calculado?
00:0000085C 6706            	  1157:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1158: 
                            	  1159:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:0000085E 363CDEAD        	  1160:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:00000862 60D8            	  1161:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1162: .CHECKSUM_OK:
00:00000864 4E75            	  1163:         RTS
                            	  1164: 
                            	  1165: ; --- Constantes ---
                            	  1166: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1167: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1168: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1169: 
                            	  1170: 
                            	  1171: Checksum:
00:00000866 00000000        	  1172:     DC.L    0               ; Temporariamente 0
                            	  1173:     ALIGN 2
                            	  1174: ; =====================================================================
                            	  1175: ; END XMODEM RECEIVER ROUTINE
