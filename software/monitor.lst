                            	   860: ;--------------------------------------------------
                            	   861: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   862: ;--------------------------------------------------
                            	   863: ;Exemplo: Lendo byte do buffer
                            	   864: ;         BSR     UART_BufferGet
                            	   865: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   866: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   867: ;         Senão, D0 contém o byte lido!
                            	   868: BufferGet:
00:00000666 2F01            	   869:         MOVE.L  D1,-(SP)
00:00000668 2F08            	   870:         MOVE.L  A0,-(SP)
                            	   871: 
00:0000066A 32390008102A    	   872:         MOVE.W  BUFFER_COUNT,D1
00:00000670 6724            	   873:         BEQ     .BufferEmpty
                            	   874: 
00:00000672 41F90008102C    	   875:         LEA     BUFFER,A0
