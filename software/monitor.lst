00:0000081C 303C0400        	  1090:         MOVE.W  #$0400,D0
00:00000820 4EB80144        	  1091:         JSR     __write_leds
00:00000824 103C0006        	  1092:         MOVE.B  #ACK,D0
00:00000828 4EB801B0        	  1093:         JSR     UART_WriteChar
00:0000082C 6000FF54        	  1094:         BRA     Receive_Loop
                            	  1095: 
                            	  1096: Send_NAK:
00:00000830 103C0015        	  1097:         MOVE.B  #NAK,D0
00:00000834 4EB801B0        	  1098:         JSR     UART_WriteChar
00:00000838 6000FF48        	  1099:         BRA     Receive_Loop
                            	  1100: 
                            	  1101: Transfer_Complete:
00:0000083C 103C0006        	  1102:         MOVE.B  #ACK,D0             ; Confirma EOT
00:00000840 4EB801B0        	  1103:         JSR     UART_WriteChar
                            	  1104: 
00:00000844 41F900081934    	  1105:         LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:0000084A 103C0001        	  1106:         MOVE.B  #1,D0
00:0000084E 1080            	  1107:         MOVE.B  D0,(A0)              ; Program  loaded
                            	  1108: 
00:00000850 4CDF7FFC        	  1109:         MOVEM.L (SP)+,D2-D7/A0-A6
00:00000854 4E75            	  1110:         RTS
                            	  1111: ; ========================================================
                            	  1112: ; Validador de Checksum para ROM (MC68000)
                            	  1113: ; Assume:
                            	  1114: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1115: ;   - Big-endian (padrão 68000)
                            	  1116: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1117: ; ========================================================
                            	  1118: 
                            	  1119: VALIDATE_ROM:
00:00000856 91C8            	  1120:         LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:00000858 203C00003FFC    	  1121:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:0000085E 7200            	  1122:         MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1123: 
                            	  1124:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1125: .CHECKSUM_LOOP:
00:00000860 2418            	  1126:         MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:00000862 D282            	  1127:         ADD.L   D2,D1               ; Soma ao acumulador
00:00000864 5980            	  1128:         SUB.L   #4,D0               ; Decrementa contador
00:00000866 6EF8            	  1129:         BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1130: 
00:00000868 41F900081930    	  1131:         LEA     checksum_calc,A0
00:0000086E 20C1            	  1132:         MOVE.L  D1,(A0)+
                            	  1133:         ;RTS     ;NESSE MOMENTO NÃO FAZ NADA COM O RESULTADO
                            	  1134: 
                            	  1135:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:00000870 24383FFC        	  1136:         MOVE.L  ROM_END-4+1,D2        ; Lê o checksum gravado (0x0000FFFC)
00:00000874 B481            	  1137:         CMP.L   D1,D2               ; Combina com o calculado?
00:00000876 6706            	  1138:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1139: 
                            	  1140:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:00000878 363CDEAD        	  1141:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:0000087C 6002            	  1142:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1143: .CHECKSUM_OK:
00:0000087E 4E75            	  1144:         RTS                         ; Retorna (ROM válida)
                            	  1145: 
                            	  1146: SYSTEM_HALT:
00:00000880 46FC0700        	  1147:         MOVE.W  #$0700,SR        ; Desabilita interrupções
                            	  1148: .INFINITE_LOOP:
00:00000884 60FE            	  1149:         BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1150: 
                            	  1151: ; Implementação simplificada de CRC32 (precisa da tabela de polinômios)
                            	  1152: VALIDATE_ROM_CRC32:
00:00000886 91C8            	  1153:         LEA     ROM_START,A0        ; Endereço inicial
00:00000888 203C00003FFC    	  1154:         MOVE.L  #ROM_SIZE-4,D0      ; Tamanho total - 4 bytes
00:0000088E 72FF            	  1155:         MOVE.L  #$FFFFFFFF,D1      ; CRC32 initial value
                            	  1156: 
                            	  1157: CRC_LOOP:
00:00000890 1418            	  1158:         MOVE.B  (A0)+,D2            ; Lê 1 byte
00:00000892 B501            	  1159:         EOR.B   D2,D1               ; XOR com byte atual
                            	  1160: 
                            	  1161:         ; Aqui viria o loop de 8 iterações com shifts e XORs
                            	  1162:         ; usando a tabela de polinômios do CRC32 (omitido por brevidade)
                            	  1163: 
00:00000894 5380            	  1164:         SUBQ.L  #1,D0
00:00000896 6EF8            	  1165:         BGT     CRC_LOOP
                            	  1166: 
00:00000898 4681            	  1167:         NOT.L   D1                  ; Inverte os bits no final
                            	  1168: 
                            	  1169:         ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:0000089A 24383FFB        	  1170:         MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:0000089E B481            	  1171:         CMP.L   D1,D2               ; Combina com o calculado?
00:000008A0 6706            	  1172:         BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1173: 
                            	  1174:         ; --- Checksum inválido: travar o sistema ou notificar ---
00:000008A2 363CDEAD        	  1175:         MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:000008A6 60D8            	  1176:         BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1177: .CHECKSUM_OK:
00:000008A8 4E75            	  1178:         RTS
                            	  1179: 
                            	  1180: ; --- Constantes ---
                            	  1181: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1182: ROM_END     EQU     $00003FFF   ; Fim da ROM (8KB)
                            	  1183: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1184: 
                            	  1185: 
                            	  1186:     ALIGN 2
                            	  1187: ; =====================================================================
                            	  1188: ; END XMODEM RECEIVER ROUTINE
                            	  1189: ; =====================================================================
