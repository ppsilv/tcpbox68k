                            	   649: 
00:000004A4 41F900000321    	   650:         LEA     WriteSizePrompt,A0
00:000004AA 4EB80200        	   651:         JSR     UART_WriteString
00:000004AE 7000            	   652:         MOVE.L  #$00000000,D0
                            	   653: .WriteLoop:
00:000004B0 4EB805EE        	   654:         JSR     UART_ReadByte       ; Lê byte
