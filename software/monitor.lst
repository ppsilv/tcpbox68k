                            	   389: ; ----------------------------------------------------------------------
                            	   390: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   391: ; Entrada:
                            	   392: ;   D0.L = Valor a ser impresso (32 bits)
                            	   393: ;   D1.W = Número de dígitos (1-8)
                            	   394: ; ----------------------------------------------------------------------
                            	   395: PrintHexPRECISA_DE_REVISAO:
00:000002CE 4E56FFF8        	   396:         LINK    A6,#-8            ; Reserva espaço na pilha
00:000002D2 2F02            	   397:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002D4 2D40FFFC        	   398:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000002D8 3D41FFFA        	   399:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   400: 
00:000002DC 323C0008        	   401:         MOVE.W  #$0008,D1
                            	   402: 
                            	   403:         ; Ajusta para começar pelo dígito mais significativo
00:000002E0 E549            	   404:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000002E2 5941            	   405:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   406: 
                            	   407: .PrintLoop:
00:000002E4 202EFFFC        	   408:         MOVE.L  -4(A6),D0         ; Recupera valor
00:000002E8 3401            	   409:         MOVE.W  D1,D2             ; Posição do nibble
00:000002EA E5B8            	   410:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:000002EC 02800000000F    	   411:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   412: 
                            	   413:         ; Converte para ASCII
00:000002F2 B03C0009        	   414:         CMP.B   #9,D0
00:000002F6 6302            	   415:         BLS     .Decimal
00:000002F8 5E00            	   416:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   417: .Decimal:
00:000002FA D03C0030        	   418:         ADD.B   #'0',D0           ; Converte para caractere
                            	   419: 
                            	   420:         ; Imprime caractere
00:000002FE 4EB80186        	   421:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   422: 
00:00000302 5941            	   423:         SUBQ.W  #4,D1             ; Próximo nibble
00:00000304 6ADE            	   424:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   425: 
                            	   426:         ; Espaço final para separação
00:00000306 103C0020        	   427:         MOVE.B  #' ',D0
00:0000030A 4EB80186        	   428:         JSR     UART_WriteChar
                            	   429: 
00:0000030E 241F            	   430:         MOVE.L  (SP)+,D2          ; Restaura D2
00:00000310 4E5E            	   431:         UNLK    A6                ; Restaura frame
00:00000312 4E75            	   432:         RTS
