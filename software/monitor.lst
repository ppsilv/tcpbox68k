                            	   175: ; ----------------------------------------------------------------------
                            	   176: ; UART_WriteString - Envia string terminada em null para UART
                            	   177: ; Entrada:
                            	   178: ;   A0 = Ponteiro para a string (endereço da string)
                            	   179: ; ----------------------------------------------------------------------
                            	   180: UART_WriteString:
00:0000014E 2F08            	   181:     MOVE.L  A0,-(SP)      ; Preserva D0
00:00000150 2F00            	   182:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   183: .WriteLoop:
00:00000152 1018            	   184:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000154 6706            	   185:     BEQ     .Done
00:00000156 4EB8011A        	   186:     JSR     UART_WriteChar ; Use sua rotine existente
00:0000015A 60F6            	   187:     BRA     .WriteLoop
                            	   188: .Done:
00:0000015C 201F            	   189:     MOVE.L  (SP)+,D0
00:0000015E 205F            	   190:     MOVE.L  (SP)+,A0
00:00000160 4E75            	   191:     RTS
