                            	   191: 
                            	   192: UART_INIT:
00:00000188 227900081010    	   193:         move.l   CurrentUART,a1
00:0000018E 137C000D0004    	   194:         move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000194 137C00830006    	   195:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:0000019A 12BC0068        	   196:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:0000019E 137C00000002    	   197:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:000001A4 08A900070006    	   198:         bclr.b  #7,LCR(a1)              ; disable divisor latch
00:000001AA 4229000E        	   199:         clr.b   SCR(a1)                 ; clear the scratch register
00:000001AE 4E75            	   200:         RTS
                            	   201: 
                            	   202:     ; Escreve caractere (D0.B)
                            	   203: UART_WriteChar:
00:000001B0 2F08            	   204:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001B2 2F00            	   205:         MOVE.L  D0,-(SP)        ; Preserva D0
00:000001B4 207900081010    	   206:         move.l   CurrentUART,A0
                            	   207: .WaitTx:
00:000001BA 08280005000A    	   208:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:000001C0 67F8            	   209:         BEQ     .WaitTx
00:000001C2 1080            	   210:         MOVE.B  D0,THR(A0)      ; transmit byte
00:000001C4 201F            	   211:         MOVE.L  (SP)+,D0        ;Restaura D0
00:000001C6 205F            	   212:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001C8 4E75            	   213:         RTS
                            	   214: 
                            	   215: 
                            	   216: ; Lê caractere (retorna em D0)
                            	   217: UART_ReadChar:
00:000001CA 2F08            	   218:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001CC 207900081010    	   219:         MOVE.L   CurrentUART,A0
                            	   220: .WaitRx:
00:000001D2 08280000000A    	   221:         BTST    #0,LSR(A0)        ; RX ready?
00:000001D8 67F8            	   222:         BEQ     .WaitRx
00:000001DA 1010            	   223:         MOVE.B  RHR(A0),D0
00:000001DC 205F            	   224:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001DE B03C001B        	   225:         CMP.B   #$1b,D0
00:000001E2 6704            	   226:         BEQ     .fim
00:000001E4 4EB801B0        	   227:         JSR     UART_WriteChar
                            	   228: .fim
00:000001E8 4E75            	   229:         RTS
                            	   230: 
