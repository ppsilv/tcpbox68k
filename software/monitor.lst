                            	   198: ; ----------------------------------------------------------------------
                            	   199: ; Constantes
                            	   200: ; ----------------------------------------------------------------------
                            	   201: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   202: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   203:                               ; BAUD_DIV_L em $70000
                            	   204:                               ; BAUD_DIV_U em $70001
                            	   205: 
                            	   206: ; ----------------------------------------------------------------------
                            	   207: ; Rotina: Calcula e armazena divisor de baud rate
                            	   208: ; Entrada:
                            	   209: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   210: ; Saída:
                            	   211: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   212: ; Formulas:
                            	   213: ;
                            	   214: ;
                            	   215: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   216: ; ----------------------------------------------------------------------
                            	   217: 
                            	   218: CalcBaudDiv:
                            	   219: ;[ Registrador D0 (32 bits) ]
                            	   220: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   221: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   222:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   223:     ;((F_CPU/16)/10)
                            	   224:     ;F_CPU = 16000000 ou 0xF42400
00:00000182 203C00F42400    	   225:     MOVE.L  #F_CPU,D0
00:00000188 323C0010        	   226:     MOVE.W  #16,D1         ; Divisor
00:0000018C 61000096        	   227:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   228: ;1
00:00000190 2F00            	   229:     move.l  d0,-(SP)
00:00000192 4EB803A6        	   230:     jsr     PrintHexAddress
00:00000196 4EB8020E        	   231:     jsr     new_line
00:0000019A 201F            	   232:     move.l  (SP)+,d0
                            	   233: 
00:0000019C 323C000A        	   234:     MOVE.W  #10,D1         ; Divisor
00:000001A0 61000082        	   235:     BSR     Div32x16       ; D0 = 0x186A0
                            	   236: ;2
00:000001A4 2F00            	   237:     move.l  d0,-(SP)
00:000001A6 4EB803A6        	   238:     jsr     PrintHexAddress
00:000001AA 4EB8020E        	   239:     jsr     new_line
00:000001AE 201F            	   240:     move.l  (SP)+,d0
                            	   241: 
                            	   242:     ;(BAUD/10)
00:000001B0 2F00            	   243:     move.l  d0,-(SP)
                            	   244: ;3
00:000001B2 7000            	   245:     CLR.L   D0
00:000001B4 30390008100C    	   246:     MOVE.W  CurrentBaudRate,D0
00:000001BA 2F00            	   247:     move.l  d0,-(SP)
00:000001BC 4EB803A6        	   248:     jsr     PrintHexAddress
00:000001C0 4EB8020E        	   249:     jsr     new_line
00:000001C4 201F            	   250:     move.l  (SP)+,d0
                            	   251: 
00:000001C6 123C000A        	   252:     MOVE.B  #10,D1
00:000001CA 6158            	   253:     BSR     Div32x16
                            	   254: 
                            	   255: ;4
00:000001CC 2F00            	   256:     move.l  d0,-(SP)
00:000001CE 4EB803A6        	   257:     jsr     PrintHexAddress
00:000001D2 4EB8020E        	   258:     jsr     new_line
00:000001D6 221F            	   259:     move.l  (SP)+,D1
00:000001D8 201F            	   260:     move.l  (SP)+,D0
                            	   261: 
                            	   262: 
                            	   263:     ;(F_CPU/BAUD)
00:000001DA 6148            	   264:     BSR     Div32x16
                            	   265: ;5
00:000001DC 2F00            	   266:     move.l  d0,-(SP)
00:000001DE 4EB803A6        	   267:     jsr     PrintHexAddress
00:000001E2 4EB8020E        	   268:     jsr     new_line
00:000001E6 201F            	   269:     move.l  (SP)+,d0
                            	   270: 
                            	   271:     ; 4. Separa parte alta/baixa corretamente
00:000001E8 3200            	   272:     MOVE.W  D0,D1
00:000001EA 024000FF        	   273:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000001EE E049            	   274:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000001F0 024100FF        	   275:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   276: 
                            	   277:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:000001F4 41F900081012    	   278:     LEA     Baud1DivL,A0
00:000001FA 3080            	   279:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:000001FC 41F900081014    	   280:     LEA     Baud1DivH,A0
00:00000202 3081            	   281:     MOVE.W  D1,(A0)
                            	   282: 
00:00000204 6000FE76        	   283:     BRA     MenuLoop
00:00000208 4E75            	   284:     RTS
                            	   285: .BaudError:
00:0000020A 6000FDFC        	   286:     BRA     _start
                            	   287: 
                            	   288: new_line:
00:0000020E 2F00            	   289:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000210 103C000A        	   290:         MOVE.B  #10,D0
00:00000214 4EB8013E        	   291:         JSR     UART_WriteChar
00:00000218 103C000D        	   292:         MOVE.B  #13,D0
00:0000021C 4EB8013E        	   293:         JSR     UART_WriteChar
00:00000220 201F            	   294:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000222 4E75            	   295:         RTS
                            	   296: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   297: ; Retorna D0 = Quociente, D1 = Resto
                            	   298: Div32x16:
00:00000224 7400            	   299:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000226 761F            	   300:     MOVEQ   #31,D3      ; 32 iterações
                            	   301: DivLoop:
00:00000228 E388            	   302:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000022A E392            	   303:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000022C B441            	   304:     CMP.W   D1,D2       ; D2 >= D1?
00:0000022E 6D04            	   305:     BLT     .skip
00:00000230 9441            	   306:     SUB.W   D1,D2       ; Sim, subtrai
00:00000232 5280            	   307:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   308: .skip:
00:00000234 51CBFFF2        	   309:     DBRA    D3,DivLoop  ; Repete
00:00000238 2202            	   310:     MOVE.L  D2,D1       ; Resto em D1
00:0000023A 4E75            	   311:     RTS
                            	   312: ; Versão compacta sem stack frame
                            	   313: PrintHexFast:
00:0000023C 2F02            	   314:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000023E 2F00            	   315:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:00000240 7407            	   316:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   317: 
                            	   318: .Loop:
00:00000242 2017            	   319:     MOVE.L  (SP),D0           ; Recupera valor original
00:00000244 E998            	   320:     ROL.L   #4,D0             ; Pega próximo nibble
00:00000246 2E80            	   321:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:00000248 0200000F        	   322:     ANDI.B  #$F,D0            ; Isola nibble
                            	   323: 
00:0000024C B03C0009        	   324:     CMP.B   #9,D0
00:00000250 6302            	   325:     BLS     .Digit
00:00000252 5E00            	   326:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   327: .Digit:
00:00000254 D03C0030        	   328:     ADD.B   #'0',D0           ; Converte para ASCII
00:00000258 4EB8013E        	   329:     JSR     UART_WriteChar    ; Envia caractere
                            	   330: 
00:0000025C 51CAFFE4        	   331:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   332: 
00:00000260 588F            	   333:     ADDQ.L  #4,SP             ; Remove valor salvo
00:00000262 241F            	   334:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000264 4E75            	   335:     RTS
                            	   336: 
                            	   337: ; ----------------------------------------------------------------------
                            	   338: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   339: ; Entrada:
                            	   340: ;   D0.L = Valor a ser impresso (32 bits)
                            	   341: ;   D1.W = Número de dígitos (1-8)
                            	   342: ; ----------------------------------------------------------------------
                            	   343: PrintHexPRECISA_DE_REVISAO:
00:00000266 4E56FFF8        	   344:     LINK    A6,#-8            ; Reserva espaço na pilha
00:0000026A 2F02            	   345:     MOVE.L  D2,-(SP)          ; Salva D2
00:0000026C 2D40FFFC        	   346:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:00000270 3D41FFFA        	   347:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   348: 
00:00000274 323C0008        	   349:     MOVE.W  #$0008,D1
                            	   350: 
                            	   351:     ; Ajusta para começar pelo dígito mais significativo
00:00000278 E549            	   352:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:0000027A 5941            	   353:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   354: 
                            	   355: .PrintLoop:
00:0000027C 202EFFFC        	   356:     MOVE.L  -4(A6),D0         ; Recupera valor
00:00000280 3401            	   357:     MOVE.W  D1,D2             ; Posição do nibble
00:00000282 E5B8            	   358:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000284 02800000000F    	   359:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   360: 
                            	   361:     ; Converte para ASCII
00:0000028A B03C0009        	   362:     CMP.B   #9,D0
00:0000028E 6302            	   363:     BLS     .Decimal
00:00000290 5E00            	   364:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   365: .Decimal:
00:00000292 D03C0030        	   366:     ADD.B   #'0',D0           ; Converte para caractere
                            	   367: 
                            	   368:     ; Imprime caractere
00:00000296 4EB8013E        	   369:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   370: 
00:0000029A 5941            	   371:     SUBQ.W  #4,D1             ; Próximo nibble
00:0000029C 6ADE            	   372:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   373: 
                            	   374:     ; Espaço final para separação
00:0000029E 103C0020        	   375:     MOVE.B  #' ',D0
00:000002A2 4EB8013E        	   376:     JSR     UART_WriteChar
                            	   377: 
00:000002A6 241F            	   378:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000002A8 4E5E            	   379:     UNLK    A6                ; Restaura frame
00:000002AA 4E75            	   380:     RTS
                            	   381: ; ----------------------------------------------------------------------
                            	   382: ; Exemplo de uso:
                            	   383: ; ----------------------------------------------------------------------
                            	   384: SetupDivisor:
00:000002AC 303C2580        	   385:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:000002B0 6100FED0        	   386:     BSR     CalcBaudDiv
                            	   387: 
                            	   388:     ; Agora pode acessar os valores na RAM:
00:000002B4 41F90008100E    	   389:     LEA     BaudDivL,A0
00:000002BA 1010            	   390:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:000002BC 41F900081010    	   391:     LEA     BaudDivH,A0
00:000002C2 1210            	   392:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   393: 
                            	   394:     ; (Aqui você configuraria os registradores da UART)
00:000002C4 4E75            	   395:     RTS
                            	   396: ; ----------------------------------------------------------------------
                            	   397: ; MemDump - Imprime dump de memória formatado
                            	   398: ; Entrada:
                            	   399: ;   A0 = Endereço inicial (ex: $80000)
                            	   400: ;   D0 = Quantidade de bytes (ex: 256)
                            	   401: ; ----------------------------------------------------------------------
                            	   402: MemDump:
00:000002C6 41F90000000D    	   403:     LEA     DumpHeader,A0
00:000002CC 4EB8016E        	   404:     JSR     UART_WriteString
00:000002D0 207900081016    	   405:     MOVE.L  (addressInHex),A0
00:000002D6 2008            	   406:     MOVE.L  A0,D0
00:000002D8 4EB803A6        	   407:     JSR     PrintHexAddress
00:000002DC 4EB8020E        	   408:     JSR     new_line
                            	   409: 
00:000002E0 41F900000020    	   410:     LEA     DumpHeader1,A0
00:000002E6 4EB8016E        	   411:     JSR     UART_WriteString
                            	   412: 
00:000002EA 207900081016    	   413:     MOVE.L  (addressInHex),A0
                            	   414:     ; Calcula endereço final
                            	   415: 
                            	   416: DUMPLOOPMASTER:
00:000002F0 7200            	   417:     CLR.L   D1
00:000002F2 2208            	   418:     MOVE.L  A0,D1
00:000002F4 0681000000FF    	   419:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   420:     ;MOVE.L  D1,D0
                            	   421:     ;JSR     PrintHexAddress
                            	   422:     ;JSR     new_line
                            	   423: 
                            	   424:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   425:     ;JSR     UART_ReadChar
                            	   426: 
                            	   427: 
                            	   428: DumpLoop:
                            	   429:     ; Nova linha a cada 16 bytes
00:000002FA 2008            	   430:     MOVE.L  A0,D0
00:000002FC 02800000000F    	   431:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000302 6616            	   432:     BNE     NoNewLine
                            	   433: 
                            	   434:     ; Imprime endereço
00:00000304 2008            	   435:     MOVE.L  A0,D0
00:00000306 4EB803A6        	   436:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   437: 
00:0000030A 103C003A        	   438:     MOVE.B  #':',D0
00:0000030E 4EB8013E        	   439:     JSR     UART_WriteChar
00:00000312 103C0020        	   440:     MOVE.B  #' ',D0
00:00000316 4EB8013E        	   441:     JSR     UART_WriteChar
                            	   442: 
                            	   443: NoNewLine:
                            	   444:     ; Imprime byte em hex
00:0000031A 1018            	   445:     MOVE.B  (A0)+,D0
00:0000031C 4EB803B6        	   446:     JSR     PrintByteHex
                            	   447: 
00:00000320 103C0020        	   448:     MOVE.B  #' ',D0
00:00000324 4EB8013E        	   449:     JSR     UART_WriteChar
                            	   450: 
                            	   451:     ; Verifica fim da linha (16 bytes)
00:00000328 2008            	   452:     MOVE.L  A0,D0
00:0000032A 02800000000F    	   453:     ANDI.L  #$0000000F,D0
00:00000330 664E            	   454:     BNE     NoEndLine
                            	   455: 
                            	   456:     ; Imprime caracteres ASCII
00:00000332 103C0020        	   457:     MOVE.B  #' ',D0
00:00000336 4EB8013E        	   458:     JSR     UART_WriteChar
00:0000033A 103C007C        	   459:     MOVE.B  #'|',D0
00:0000033E 4EB8013E        	   460:     JSR     UART_WriteChar
                            	   461: 
00:00000342 43E8FFF0        	   462:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000346 740F            	   463:     MOVEQ   #15,D2            ; 16 caracteres
                            	   464: 
                            	   465: AsciiLoop:
00:00000348 1019            	   466:     MOVE.B  (A1)+,D0
00:0000034A B03C0020        	   467:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000034E 6D0C            	   468:     BLT     NonPrintable
00:00000350 B03C007E        	   469:     CMP.B   #126,D0
00:00000354 6E06            	   470:     BGT     NonPrintable
                            	   471: 
00:00000356 4EB8013E        	   472:     JSR     UART_WriteChar
00:0000035A 6008            	   473:     BRA     NextAscii
                            	   474: 
                            	   475: NonPrintable:
00:0000035C 103C002E        	   476:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:00000360 4EB8013E        	   477:     JSR     UART_WriteChar
                            	   478: 
                            	   479: NextAscii:
00:00000364 51CAFFE2        	   480:     DBRA    D2,AsciiLoop
                            	   481: 
00:00000368 103C007C        	   482:     MOVE.B  #'|',D0
00:0000036C 4EB8013E        	   483:     JSR     UART_WriteChar
00:00000370 103C000D        	   484:     MOVE.B  #13,D0            ; CR
00:00000374 4EB8013E        	   485:     JSR     UART_WriteChar
00:00000378 103C000A        	   486:     MOVE.B  #10,D0            ; LF
00:0000037C 4EB8013E        	   487:     JSR     UART_WriteChar
                            	   488: 
                            	   489: NoEndLine:
                            	   490:     ; Verifica fim do dump
00:00000380 B1C1            	   491:     CMP.L   D1,A0
00:00000382 6300FF76        	   492:     BLS     DumpLoop
                            	   493: 
00:00000386 2F08            	   494:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000388 41F9000003EF    	   495:     LEA     HitAnyKey,A0
00:0000038E 4EB8016E        	   496:     JSR     UART_WriteString
00:00000392 4EB80158        	   497:     JSR     UART_ReadChar
00:00000396 B03C001B        	   498:     CMP.B   #$1B,D0
00:0000039A 6706            	   499:     BEQ     .fim
                            	   500: 
00:0000039C 205F            	   501:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:0000039E 6000FF50        	   502:     BRA     DUMPLOOPMASTER
                            	   503: .fim
00:000003A2 6000FCD8        	   504:     BRA     MenuLoop
                            	   505: 
                            	   506: ; ----------------------------------------------------------------------
                            	   507: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   508: ; Entrada: D0 = endereço
                            	   509: ; ----------------------------------------------------------------------
                            	   510: PrintHexAddress:
00:000003A6 4840            	   511:     SWAP    D0                ; Imprime parte alta primeiro
00:000003A8 4EB803AE        	   512:     JSR     PrintWordHex
00:000003AC 4840            	   513:     SWAP    D0                ; Parte baixa
                            	   514:     ; Continua para PrintWordHex
                            	   515: 
                            	   516: ; ----------------------------------------------------------------------
                            	   517: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   518: ; Entrada: D0.w = valor
                            	   519: ; ----------------------------------------------------------------------
                            	   520: PrintWordHex:
00:000003AE E158            	   521:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003B0 4EB803B6        	   522:     JSR     PrintByteHex
00:000003B4 E058            	   523:     ROR.W   #8,D0             ; Byte menos significativo
                            	   524:     ; Continua para PrintByteHex
                            	   525: 
                            	   526: ; ----------------------------------------------------------------------
                            	   527: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   528: ; Entrada: D0.b = valor
                            	   529: ; ----------------------------------------------------------------------
                            	   530: PrintByteHex:
00:000003B6 1F00            	   531:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000003B8 E808            	   532:     LSR.B   #4,D0             ; Nibble alto
00:000003BA 6106            	   533:     BSR     PrintNibble
00:000003BC 101F            	   534:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000003BE 0200000F        	   535:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   536:     ; Continua para PrintNibble
                            	   537: ; ----------------------------------------------------------------------
                            	   538: ; PrintNibble - Imprime um nibble em hex
                            	   539: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   540: ; ----------------------------------------------------------------------
                            	   541: PrintNibble:
00:000003C2 B03C0009        	   542:     CMP.B   #9,D0
00:000003C6 6302            	   543:     BLS     .Decimal
00:000003C8 5E00            	   544:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   545: .Decimal:
00:000003CA D03C0030        	   546:     ADD.B   #'0',D0
00:000003CE 4EF8013E        	   547:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   548: 
                            	   549: ClearRAM:
00:000003D2 41F900080000    	   550:     LEA     $80000,A0
00:000003D8 43F90008FFFF    	   551:     LEA     $8FFFF,A1
00:000003DE 7000            	   552:     MOVEQ   #0,D0
                            	   553: .ClearLoop:
00:000003E0 20C0            	   554:     MOVE.L  D0,(A0)+
00:000003E2 B3C8            	   555:     CMPA.L  A0,A1
00:000003E4 62FA            	   556:     BHI     .ClearLoop
00:000003E6 4E75            	   557:     RTS
                            	   558: ; ----------------------------------------------------------------------
                            	   559: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   560: ; ----------------------------------------------------------------------
                            	   561: ClearRAM1:
00:000003E8 41F900080000    	   562:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000003EE 43F900100000    	   563:     LEA     $100000,A1       ; Endereço final + 1
00:000003F4 7000            	   564:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   565: 
                            	   566:     ; Calcula tamanho em bytes (já alinhado para longs)
00:000003F6 2209            	   567:     MOVE.L  A1,D1
00:000003F8 9288            	   568:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   569: 
                            	   570:     ; Otimização: escreve longs (32 bits) quando possível
00:000003FA 2401            	   571:     MOVE.L  D1,D2
00:000003FC 028200000003    	   572:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:00000402 670C            	   573:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   574: 
                            	   575:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000404 5382            	   576:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   577: .ResidualLoop:
00:00000406 10C0            	   578:     MOVE.B  D0,(A0)+
00:00000408 51CAFFFC        	   579:     DBRA    D2,.ResidualLoop
                            	   580: 
                            	   581:     ; Atualiza tamanho restante
00:0000040C 9282            	   582:     SUB.L   D2,D1
00:0000040E 5381            	   583:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   584: 
                            	   585: .ClearLongs:
00:00000410 E489            	   586:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:00000412 5381            	   587:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   588: 
                            	   589: .LongLoop:
00:00000414 20C0            	   590:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000416 51C9FFFC        	   591:     DBRA    D1,.LongLoop
00:0000041A 4E75            	   592:     RTS
