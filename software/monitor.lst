00:00000170 207900081008    	   182:     move.l   CurrentUART,A0
                            	   183: .WaitRx:
00:00000176 08280000000A    	   184:     BTST    #0,LSR(A0)        ; RX ready?
00:0000017C 67F8            	   185:     BEQ     .WaitRx
00:0000017E 1010            	   186:     MOVE.B  RHR(A0),D0
00:00000180 205F            	   187:     MOVE.L  (SP)+,A0        ;Restaura A0
