00:000001B8 41F900082000    	   215:     LEA     $82000,A0
00:000001BE 43F90008FFFF    	   216:     LEA     $8FFFF,A1
00:000001C4 7000            	   217:     MOVEQ   #0,D0
                            	   218: .ClearLoop:
00:000001C6 5200            	   219:     ADDI.B   #$01,D0
00:000001C8 10C0            	   220:     MOVE.B  D0,(A0)+
00:000001CA B3C8            	   221:     CMPA.L  A0,A1
00:000001CC 62F8            	   222:     BHI     .ClearLoop
00:000001CE 6000FEB4        	   223:     BRA     MenuLoop
