                            	   105: ; =============================================
                            	   106: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   107: ; Entrada: D0 = tempo em ms (16 bits)
                            	   108: ; Destrói: D0
                            	   109: ; =============================================
                            	   110: DELAY_MS:
00:000000EE 2F01            	   111:         MOVE.L  d1,-(sp)          ; Salva D1
00:000000F0 3200            	   112:         MOVE.W  d0,d1             ; Contador de ms
00:000000F2 670E            	   113:         BEQ.S   .end              ; Se D0=0, sai
                            	   114: .loop_ms:
00:000000F4 203C00003E80    	   115:         MOVE.L  #16000,d0         ; Ciclos por ms (16MHz)
                            	   116: .inner_loop:
00:000000FA 5380            	   117:         SUBQ.L  #1,d0             ; 4 ciclos
00:000000FC 66FC            	   118:         BNE.S   .inner_loop       ; 10 ciclos (se taken)
00:000000FE 5341            	   119:         SUBQ.W  #1,d1             ; 1 ms
00:00000100 66F2            	   120:         BNE.S   .loop_ms
                            	   121: .end:
00:00000102 221F            	   122:         MOVE.L  (sp)+,d1          ; Restaura D1
00:00000104 4E75            	   123:         rts
