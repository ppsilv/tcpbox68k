                            	   935: ; XMODEM RECEIVER ROUTINE
                            	   936: ; =====================================================================
                            	   937: XMODEM_Receive:
00:000006AC 48E73FFE        	   938:                 MOVEM.L D2-D7/A0-A6,-(SP)
00:000006B0 41F9000815A4    	   939:                 LEA     xmodem_buffer,A0
                            	   940: 
                            	   941:                 ; ---- 1. INICIALIZAÇÃO ----
00:000006B6 103C0015        	   942:                 MOVE.B  #NAK,D0
00:000006BA 4EB8013E        	   943:                 JSR     UART_WriteChar      ; Solicita início
                            	   944: 
                            	   945:                 ; ---- 2. LOOP PRINCIPAL ----
                            	   946: Receive_Loop:
00:000006BE 4EB80158        	   947:                 JSR     UART_ReadChar
00:000006C2 B03C0004        	   948:                 CMP.B   #EOT,D0
00:000006C6 67000088        	   949:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	   950: 
00:000006CA B03C0001        	   951:                 CMP.B   #SOH,D0
00:000006CE 66EE            	   952:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   953: 
                            	   954:                 ; ---- 3. RECEBE HEADER ----
00:000006D0 4EB80158        	   955:                 JSR     UART_ReadChar       ; Block number
00:000006D4 13C000081624    	   956:                 MOVE.B  D0,block_number
00:000006DA 4EB80158        	   957:                 JSR     UART_ReadChar       ; ~Block number (complemento)
                            	   958: 
                            	   959:                 ; ---- 4. RECEBE DADOS ----
00:000006DE 323C007F        	   960:                 MOVE.W  #127,D1             ; 128 bytes (0-based)
00:000006E2 43F9000815A4    	   961:                 LEA     xmodem_buffer,A1
                            	   962: 
                            	   963: Receive_Data:
00:000006E8 4EB80158        	   964:                 JSR     UART_ReadChar
00:000006EC 12C0            	   965:                 MOVE.B  D0,(A1)+
00:000006EE 51C9FFF8        	   966:                 DBF     D1,Receive_Data
                            	   967: 
                            	   968:                 ; ---- 5. VERIFICA CHECKSUM ----
00:000006F2 4EB80158        	   969:                 JSR     UART_ReadChar       ; Checksum
00:000006F6 1400            	   970:                 MOVE.B  D0,D2
                            	   971: 
                            	   972:                 ; Calcula checksum local
00:000006F8 43F9000815A4    	   973:                 LEA     xmodem_buffer,A1
00:000006FE 323C007F        	   974:                 MOVE.W  #127,D1
00:00000702 4203            	   975:                 CLR.B   D3
                            	   976: 
                            	   977: Calc_Checksum:
00:00000704 D619            	   978:                 ADD.B   (A1)+,D3
00:00000706 51C9FFFC        	   979:                 DBF     D1,Calc_Checksum
                            	   980: 
00:0000070A B602            	   981:                 CMP.B   D2,D3
00:0000070C 6636            	   982:                 BNE     Send_NAK            ; Erro no checksum
                            	   983: 
                            	   984:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
00:0000070E 103900081624    	   985:                 MOVE.B  block_number,D0
00:00000714 B03900081625    	   986:                 CMP.B   expected_block,D0
00:0000071A 6628            	   987:                 BNE     Send_NAK            ; Bloco fora de ordem
                            	   988: 
                            	   989:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	   990:                 ; (Aqui você processa os 128 bytes recebidos)
                            	   991:                 ; Exemplo: copiar para RAM/Flash
00:0000071C 43F9000815A4    	   992:                 LEA     xmodem_buffer,A1
00:00000722 247900081524    	   993:                 MOVE.L  user_buffer_ptr,A2  ; Defina isso antes de chamar
00:00000728 323C007F        	   994:                 MOVE.W  #127,D1
                            	   995: Copy_Data:
00:0000072C 14D9            	   996:                 MOVE.B  (A1)+,(A2)+
00:0000072E 51C9FFFC        	   997:                 DBF     D1,Copy_Data
                            	   998: 
                            	   999:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:00000732 523900081625    	  1000:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000738 103C0006        	  1001:                 MOVE.B  #ACK,D0
00:0000073C 4EB8013E        	  1002:                 JSR     UART_WriteChar
00:00000740 6000FF7C        	  1003:                 BRA     Receive_Loop
                            	  1004: 
                            	  1005: Send_NAK:
00:00000744 103C0015        	  1006:                 MOVE.B  #NAK,D0
00:00000748 4EB8013E        	  1007:                 JSR     UART_WriteChar
00:0000074C 6000FF70        	  1008:                 BRA     Receive_Loop
                            	  1009: 
                            	  1010: Transfer_Complete:
00:00000750 103C0006        	  1011:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:00000754 4EB8013E        	  1012:                 JSR     UART_WriteChar
00:00000758 4CDF7FFC        	  1013:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:0000075C 4E75            	  1014:                 RTS
                            	  1015: 
00:0000075E 4D45524441205445	  1016:     DC.B "MERDA TERMINA"
00:00000766 524D494E41
