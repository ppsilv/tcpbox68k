                            	   787: ; Lê 4 bytes (32 bits) via UART
                            	   788: UART_ReadLong:
00:0000059E 7000            	   789:     MOVEQ   #0,D0
00:000005A0 7203            	   790:     MOVEQ   #3,D1            ; 4 bytes a ler
                            	   791: .Loop:
