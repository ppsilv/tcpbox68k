                            	   432: ; ----------------------------------------------------------------------
                            	   433: ; MemDump - Imprime dump de memória formatado
                            	   434: ; Entrada:
                            	   435: ;   A0 = Endereço inicial (ex: $80000)
                            	   436: ;   D0 = Quantidade de bytes (ex: 256)
                            	   437: ; ----------------------------------------------------------------------
                            	   438: MEMDUMP:
00:00000300 41F90000000D    	   439:         LEA     DumpHeader,A0
00:00000306 4EB801C2        	   440:         JSR     UART_WriteString
00:0000030A 207900081016    	   441:         MOVE.L  (addressInHex),A0
00:00000310 2008            	   442:         MOVE.L  A0,D0
00:00000312 4EB803E0        	   443:         JSR     PrintHexAddress
00:00000316 4EB80262        	   444:         JSR     new_line
                            	   445: 
00:0000031A 41F900000020    	   446:         LEA     DumpHeader1,A0
00:00000320 4EB801C2        	   447:         JSR     UART_WriteString
                            	   448: 
00:00000324 207900081016    	   449:         MOVE.L  (addressInHex),A0
                            	   450:         ; Calcula endereço final
                            	   451: 
                            	   452: DUMPLOOPMASTER:
00:0000032A 7200            	   453:         CLR.L   D1
00:0000032C 2208            	   454:         MOVE.L  A0,D1
00:0000032E 0681000000FF    	   455:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   456:         ;MOVE.L  D1,D0
                            	   457:         ;JSR     PrintHexAddress
                            	   458:         ;JSR     new_line
                            	   459: 
                            	   460:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   461:         ;JSR     UART_ReadChar
                            	   462: 
                            	   463: 
                            	   464: DumpLoop:
                            	   465:         ; Nova linha a cada 16 bytes
00:00000334 2008            	   466:         MOVE.L  A0,D0
00:00000336 02800000000F    	   467:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000033C 6616            	   468:         BNE     NoNewLine
                            	   469: 
                            	   470:         ; Imprime endereço
00:0000033E 2008            	   471:         MOVE.L  A0,D0
00:00000340 4EB803E0        	   472:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   473: 
00:00000344 103C003A        	   474:         MOVE.B  #':',D0
00:00000348 4EB80172        	   475:         JSR     UART_WriteChar
00:0000034C 103C0020        	   476:         MOVE.B  #' ',D0
00:00000350 4EB80172        	   477:         JSR     UART_WriteChar
                            	   478: 
                            	   479: NoNewLine:
                            	   480:         ; Imprime byte em hex
00:00000354 1018            	   481:         MOVE.B  (A0)+,D0
00:00000356 4EB803F0        	   482:         JSR     PrintByteHex
                            	   483: 
00:0000035A 103C0020        	   484:         MOVE.B  #' ',D0
00:0000035E 4EB80172        	   485:         JSR     UART_WriteChar
                            	   486: 
                            	   487:         ; Verifica fim da linha (16 bytes)
00:00000362 2008            	   488:         MOVE.L  A0,D0
00:00000364 02800000000F    	   489:         ANDI.L  #$0000000F,D0
00:0000036A 664E            	   490:         BNE     NoEndLine
                            	   491: 
                            	   492:         ; Imprime caracteres ASCII
00:0000036C 103C0020        	   493:         MOVE.B  #' ',D0
00:00000370 4EB80172        	   494:         JSR     UART_WriteChar
00:00000374 103C007C        	   495:         MOVE.B  #'|',D0
00:00000378 4EB80172        	   496:         JSR     UART_WriteChar
                            	   497: 
00:0000037C 43E8FFF0        	   498:         LEA     -16(A0),A1        ; Volta ao início da linha
00:00000380 740F            	   499:         MOVEQ   #15,D2            ; 16 caracteres
                            	   500: 
                            	   501: AsciiLoop:
00:00000382 1019            	   502:         MOVE.B  (A1)+,D0
00:00000384 B03C0020        	   503:         CMP.B   #32,D0            ; Verifica se é imprimível
00:00000388 6D0C            	   504:         BLT     NonPrintable
00:0000038A B03C007E        	   505:         CMP.B   #126,D0
00:0000038E 6E06            	   506:         BGT     NonPrintable
                            	   507: 
00:00000390 4EB80172        	   508:         JSR     UART_WriteChar
00:00000394 6008            	   509:         BRA     NextAscii
                            	   510: 
                            	   511: NonPrintable:
00:00000396 103C002E        	   512:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000039A 4EB80172        	   513:         JSR     UART_WriteChar
                            	   514: 
                            	   515: NextAscii:
00:0000039E 51CAFFE2        	   516:         DBRA    D2,AsciiLoop
                            	   517: 
00:000003A2 103C007C        	   518:         MOVE.B  #'|',D0
00:000003A6 4EB80172        	   519:         JSR     UART_WriteChar
00:000003AA 103C000D        	   520:         MOVE.B  #13,D0            ; CR
00:000003AE 4EB80172        	   521:         JSR     UART_WriteChar
00:000003B2 103C000A        	   522:         MOVE.B  #10,D0            ; LF
00:000003B6 4EB80172        	   523:         JSR     UART_WriteChar
                            	   524: 
                            	   525: NoEndLine:
                            	   526:         ; Verifica fim do dump
00:000003BA B1C1            	   527:         CMP.L   D1,A0
00:000003BC 6300FF76        	   528:         BLS     DumpLoop
                            	   529: 
00:000003C0 2F08            	   530:         MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003C2 41F9000003F6    	   531:         LEA     HitAnyKey,A0
00:000003C8 4EB801C2        	   532:         JSR     UART_WriteString
00:000003CC 4EB8018C        	   533:         JSR     UART_ReadChar
00:000003D0 B03C001B        	   534:         CMP.B   #$1B,D0
00:000003D4 6706            	   535:         BEQ     .fim
                            	   536: 
00:000003D6 205F            	   537:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000003D8 6000FF50        	   538:         BRA     DUMPLOOPMASTER
                            	   539: .fim
00:000003DC 6000FCAA        	   540:         BRA     MenuLoop
