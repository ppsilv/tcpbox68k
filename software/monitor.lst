                            	   542: ; ----------------------------------------------------------------------
                            	   543: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   544: ; Entrada: D0 = endereço
                            	   545: ; ----------------------------------------------------------------------
                            	   546: PrintHexAddress:
00:000003E0 4840            	   547:         SWAP    D0                ; Imprime parte alta primeiro
00:000003E2 4EB803E8        	   548:         JSR     PrintWordHex
00:000003E6 4840            	   549:         SWAP    D0                ; Parte baixa
                            	   550:         ; Continua para PrintWordHex
                            	   551: 
                            	   552: ; ----------------------------------------------------------------------
                            	   553: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   554: ; Entrada: D0.w = valor
                            	   555: ; ----------------------------------------------------------------------
                            	   556: PrintWordHex:
00:000003E8 E158            	   557:         ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000003EA 4EB803F0        	   558:         JSR     PrintByteHex
00:000003EE E058            	   559:         ROR.W   #8,D0             ; Byte menos significativo
                            	   560:         ; Continua para PrintByteHex
                            	   561: 
                            	   562: ; ----------------------------------------------------------------------
                            	   563: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   564: ; Entrada: D0.b = valor
                            	   565: ; ----------------------------------------------------------------------
                            	   566: PrintByteHex:
00:000003F0 1F00            	   567:         MOVE.B  D0,-(SP)          ; Salva byte original
00:000003F2 E808            	   568:         LSR.B   #4,D0             ; Nibble alto
00:000003F4 6106            	   569:         BSR     PrintNibble
00:000003F6 101F            	   570:         MOVE.B  (SP)+,D0          ; Recupera byte
00:000003F8 0200000F        	   571:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   572:         ; Continua para PrintNibble
                            	   573: ; ----------------------------------------------------------------------
                            	   574: ; PrintNibble - Imprime um nibble em hex
                            	   575: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   576: ; ----------------------------------------------------------------------
                            	   577: PrintNibble:
00:000003FC B03C0009        	   578:         CMP.B   #9,D0
00:00000400 6302            	   579:         BLS     .Decimal
00:00000402 5E00            	   580:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   581: .Decimal:
00:00000404 D03C0030        	   582:         ADD.B   #'0',D0
00:00000408 4EF80172        	   583:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   584: 
                            	   585: CLEARRAM:
00:0000040C 41F900080000    	   586:         LEA     $80000,A0
00:00000412 43F90008FFFF    	   587:         LEA     $8FFFF,A1
00:00000418 7000            	   588:         MOVEQ   #0,D0
                            	   589: .ClearLoop:
00:0000041A 20C0            	   590:         MOVE.L  D0,(A0)+
00:0000041C B3C8            	   591:         CMPA.L  A0,A1
00:0000041E 62FA            	   592:         BHI     .ClearLoop
00:00000420 4E75            	   593:         RTS
