00:00000574 7000            	   766:     MOVEQ   #0,D0
00:00000576 7203            	   767:     MOVEQ   #3,D1            ; 4 bytes a ler
                            	   768: .Loop:
00:00000578 E188            	   769:     LSL.L   #8,D0            ; Desloca resultado atual
00:0000057A 4EB80586        	   770:     JSR     UART_ReadByte
00:0000057E 8000            	   771:     OR.B    D0,D0            ; Combina com novo byte
00:00000580 51C9FFF6        	   772:     DBF     D1,.Loop
00:00000584 4E75            	   773:     RTS
                            	   774: 
                            	   775: ; Lê byte hexadecimal (2 caracteres ASCII)
                            	   776: UART_ReadByte:
00:00000586 2F00            	   777:     MOVE.L  D0,-(SP)        ; Preserva D0
00:00000588 4EB8059A        	   778:     JSR     UART_ReadHexNibble
00:0000058C E908            	   779:     LSL.B   #4,D0
00:0000058E 1200            	   780:     MOVE.B  D0,D1
00:00000590 4EB8059A        	   781:     JSR     UART_ReadHexNibble
00:00000594 8001            	   782:     OR.B    D1,D0
00:00000596 201F            	   783:     MOVE.L  (SP)+,D0        ; Recupera D0
00:00000598 4E75            	   784:     RTS
                            	   785: 
                            	   786: ; Lê meio-byte hexadecimal
                            	   787: UART_ReadHexNibble:
00:0000059A 4EB8014E        	   788:     JSR     UART_ReadChar
00:0000059E B03C0041        	   789:     CMP.B   #'A',D0
00:000005A2 6D02            	   790:     BLT     .Digit
00:000005A4 5F00            	   791:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   792: .Digit:
00:000005A6 903C0030        	   793:     SUB.B   #'0',D0
00:000005AA C03C000F        	   794:     AND.B   #$0F,D0
00:000005AE 4E75            	   795:     RTS
