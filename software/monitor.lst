                            	   323: ; ----------------------------------------------------------------------
                            	   324: ; Constantes
                            	   325: ; ----------------------------------------------------------------------
                            	   326: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   327: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   328:                               ; BAUD_DIV_L em $70000
                            	   329:                               ; BAUD_DIV_U em $70001
                            	   330: 
                            	   331: ; ----------------------------------------------------------------------
                            	   332: ; Rotina: Calcula e armazena divisor de baud rate
                            	   333: ; Entrada:
                            	   334: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   335: ; Saída:
                            	   336: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   337: ; Formulas:
                            	   338: ;
                            	   339: ;
                            	   340: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   341: ; ----------------------------------------------------------------------
                            	   342: 
                            	   343: CalcBaudDiv:
                            	   344: ;[ Registrador D0 (32 bits) ]
                            	   345: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   346: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   347:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   348:     ;((F_CPU/16)/10)
                            	   349:     ;F_CPU = 16000000 ou 0xF42400
00:00000290 203C00F42400    	   350:     MOVE.L  #F_CPU,D0
00:00000296 323C0010        	   351:     MOVE.W  #16,D1         ; Divisor
00:0000029A 61000096        	   352:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   353: ;1
00:0000029E 2F00            	   354:     move.l  d0,-(SP)
00:000002A0 4EB804B4        	   355:     jsr     PrintHexAddress
00:000002A4 4EB8031C        	   356:     jsr     new_line
00:000002A8 201F            	   357:     move.l  (SP)+,d0
                            	   358: 
00:000002AA 323C000A        	   359:     MOVE.W  #10,D1         ; Divisor
00:000002AE 61000082        	   360:     BSR     Div32x16       ; D0 = 0x186A0
                            	   361: ;2
00:000002B2 2F00            	   362:     move.l  d0,-(SP)
00:000002B4 4EB804B4        	   363:     jsr     PrintHexAddress
00:000002B8 4EB8031C        	   364:     jsr     new_line
00:000002BC 201F            	   365:     move.l  (SP)+,d0
                            	   366: 
                            	   367:     ;(BAUD/10)
00:000002BE 2F00            	   368:     move.l  d0,-(SP)
                            	   369: ;3
00:000002C0 7000            	   370:     CLR.L   D0
00:000002C2 30390008100C    	   371:     MOVE.W  CurrentBaudRate,D0
00:000002C8 2F00            	   372:     move.l  d0,-(SP)
00:000002CA 4EB804B4        	   373:     jsr     PrintHexAddress
