00:0000049E 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
00:000004A6 6704            	     2M     BEQ     .fim                ; Se bit = 0 (Z=1), pula para o rótulo .fim
00:000004A8 12C0            	   650:         MOVE.B  D0,(A1)+            ; Armazena
00:000004AA 60EE            	   651:         BRA     .WriteLoop
                            	   652: 
