                            	   232: ; ----------------------------------------------------------------------
                            	   233: ; UART_WriteString - Envia string terminada em null para UART
                            	   234: ; Entrada:
                            	   235: ;   A0 = Ponteiro para a string (endereço da string)
                            	   236: ; ----------------------------------------------------------------------
                            	   237: UART_WriteString:
00:000001D6 2F08            	   238:         MOVE.L  A0,-(SP)      ; Preserva D0
00:000001D8 2F00            	   239:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   240: .WriteLoop:
00:000001DA 1018            	   241:         MOVE.B  (A0)+,D0      ; Pega caractere
00:000001DC 6706            	   242:         BEQ     .Done
00:000001DE 4EB80186        	   243:         JSR     UART_WriteChar ; Use sua rotine existente
00:000001E2 60F6            	   244:         BRA     .WriteLoop
                            	   245: .Done:
00:000001E4 201F            	   246:         MOVE.L  (SP)+,D0
00:000001E6 205F            	   247:         MOVE.L  (SP)+,A0
00:000001E8 4E75            	   248:         RTS
