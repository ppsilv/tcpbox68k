00:00000678 323900081026    	   878:         MOVE.W  BUFFER_TAIL,D1
00:0000067E 10301000        	   879:         MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   880: 
00:00000682 5401            	   881:         ADDQ.B  #2,D1              ; Incrementa como word
00:00000684 024100FF        	   882:         ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000688 33C100081026    	   883:         MOVE.W  D1,BUFFER_TAIL
                            	   884: 
00:0000068E 53790008102A    	   885:         SUBQ.W  #1,BUFFER_COUNT
00:00000694 6006            	   886:         BRA     .Exit
