                            	   825: ;--------------------------------------------------
                            	   826: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   827: ;--------------------------------------------------
                            	   828: ; Exemplo: insere 'A' no buffer
                            	   829: ;          MOVE.B  #'A',D0
                            	   830: ;          JSR     UART_BufferPut
                            	   831: 
                            	   832: BufferPut:
00:0000062E 2F01            	   833:         MOVE.L  D1,-(SP)
00:00000630 2F08            	   834:         MOVE.L  A0,-(SP)
                            	   835: 
                            	   836:         ;ANDI.W    #$FF00,D0
00:00000632 41F90008102C    	   837:         LEA     BUFFER,A0
00:00000638 32390008102A    	   838:         MOVE.W  BUFFER_COUNT,D1
                            	   839: 
00:0000063E B27C0100        	   840:         CMP.W   #256,D1
00:00000642 6C1C            	   841:         BGE     .BufferFull
