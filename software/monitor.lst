                            	   550: ; ----------------------------------------------------------------------
                            	   551: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   552: ; Entrada: D0 = endereço
                            	   553: ; ----------------------------------------------------------------------
                            	   554: PrintHexAddress:
00:00000408 4840            	   555:         SWAP    D0                ; Imprime parte alta primeiro
00:0000040A 4EB80410        	   556:         JSR     PrintWordHex
00:0000040E 4840            	   557:         SWAP    D0                ; Parte baixa
                            	   558:         ; Continua para PrintWordHex
                            	   559: 
                            	   560: ; ----------------------------------------------------------------------
                            	   561: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   562: ; Entrada: D0.w = valor
                            	   563: ; ----------------------------------------------------------------------
                            	   564: PrintWordHex:
00:00000410 E158            	   565:         ROL.W   #8,D0             ; Byte mais significativo primeiro
00:00000412 4EB80418        	   566:         JSR     PrintByteHex
00:00000416 E058            	   567:         ROR.W   #8,D0             ; Byte menos significativo
                            	   568:         ; Continua para PrintByteHex
                            	   569: 
                            	   570: ; ----------------------------------------------------------------------
                            	   571: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   572: ; Entrada: D0.b = valor
                            	   573: ; ----------------------------------------------------------------------
                            	   574: PrintByteHex:
00:00000418 1F00            	   575:         MOVE.B  D0,-(SP)          ; Salva byte original
00:0000041A E808            	   576:         LSR.B   #4,D0             ; Nibble alto
00:0000041C 6106            	   577:         BSR     PrintNibble
00:0000041E 101F            	   578:         MOVE.B  (SP)+,D0          ; Recupera byte
00:00000420 0200000F        	   579:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   580:         ; Continua para PrintNibble
                            	   581: ; ----------------------------------------------------------------------
                            	   582: ; PrintNibble - Imprime um nibble em hex
                            	   583: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   584: ; ----------------------------------------------------------------------
                            	   585: PrintNibble:
00:00000424 B03C0009        	   586:         CMP.B   #9,D0
00:00000428 6302            	   587:         BLS     .Decimal
00:0000042A 5E00            	   588:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   589: .Decimal:
00:0000042C D03C0030        	   590:         ADD.B   #'0',D0
00:00000430 4EF8019A        	   591:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   592: 
                            	   593: CLEARRAM:
00:00000434 41F900080000    	   594:         LEA     $80000,A0
00:0000043A 43F90008FFFF    	   595:         LEA     $8FFFF,A1
                            	   596:         ;LEA     $BFFFF,A1
00:00000440 7000            	   597:         MOVEQ   #0,D0
                            	   598: .ClearLoop:
00:00000442 20C0            	   599:         MOVE.L  D0,(A0)+
00:00000444 B3C8            	   600:         CMPA.L  A0,A1
00:00000446 62FA            	   601:         BHI     .ClearLoop
00:00000448 4E75            	   602:         RTS
