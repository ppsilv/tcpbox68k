                            	   434: ; ----------------------------------------------------------------------
                            	   435: ; MemDump - Imprime dump de memória formatado
                            	   436: ; Entrada:
                            	   437: ;   A0 = Endereço inicial (ex: $80000)
                            	   438: ;   D0 = Quantidade de bytes (ex: 256)
                            	   439: ; ----------------------------------------------------------------------
                            	   440: MEMDUMP:
00:00000314 41F90000000D    	   441:         LEA     DumpHeader,A0
00:0000031A 4EB801D6        	   442:         JSR     UART_WriteString
00:0000031E 20790008101E    	   443:         MOVE.L  (addressInHex),A0
00:00000324 2008            	   444:         MOVE.L  A0,D0
00:00000326 4EB803F4        	   445:         JSR     PrintHexAddress
00:0000032A 4EB80276        	   446:         JSR     new_line
                            	   447: 
00:0000032E 41F900000020    	   448:         LEA     DumpHeader1,A0
00:00000334 4EB801D6        	   449:         JSR     UART_WriteString
                            	   450: 
00:00000338 20790008101E    	   451:         MOVE.L  (addressInHex),A0
                            	   452:         ; Calcula endereço final
                            	   453: 
                            	   454: DUMPLOOPMASTER:
00:0000033E 7200            	   455:         CLR.L   D1
00:00000340 2208            	   456:         MOVE.L  A0,D1
00:00000342 0681000000FF    	   457:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   458:         ;MOVE.L  D1,D0
                            	   459:         ;JSR     PrintHexAddress
                            	   460:         ;JSR     new_line
                            	   461: 
                            	   462:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   463:         ;JSR     UART_ReadChar
                            	   464: 
                            	   465: 
                            	   466: DumpLoop:
                            	   467:         ; Nova linha a cada 16 bytes
00:00000348 2008            	   468:         MOVE.L  A0,D0
00:0000034A 02800000000F    	   469:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000350 6616            	   470:         BNE     NoNewLine
                            	   471: 
                            	   472:         ; Imprime endereço
00:00000352 2008            	   473:         MOVE.L  A0,D0
00:00000354 4EB803F4        	   474:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   475: 
00:00000358 103C003A        	   476:         MOVE.B  #':',D0
00:0000035C 4EB80186        	   477:         JSR     UART_WriteChar
00:00000360 103C0020        	   478:         MOVE.B  #' ',D0
00:00000364 4EB80186        	   479:         JSR     UART_WriteChar
                            	   480: 
                            	   481: NoNewLine:
                            	   482:         ; Imprime byte em hex
00:00000368 1018            	   483:         MOVE.B  (A0)+,D0
00:0000036A 4EB80404        	   484:         JSR     PrintByteHex
                            	   485: 
00:0000036E 103C0020        	   486:         MOVE.B  #' ',D0
00:00000372 4EB80186        	   487:         JSR     UART_WriteChar
                            	   488: 
                            	   489:         ; Verifica fim da linha (16 bytes)
00:00000376 2008            	   490:         MOVE.L  A0,D0
00:00000378 02800000000F    	   491:         ANDI.L  #$0000000F,D0
00:0000037E 664E            	   492:         BNE     NoEndLine
                            	   493: 
                            	   494:         ; Imprime caracteres ASCII
00:00000380 103C0020        	   495:         MOVE.B  #' ',D0
00:00000384 4EB80186        	   496:         JSR     UART_WriteChar
00:00000388 103C007C        	   497:         MOVE.B  #'|',D0
00:0000038C 4EB80186        	   498:         JSR     UART_WriteChar
                            	   499: 
00:00000390 43E8FFF0        	   500:         LEA     -16(A0),A1        ; Volta ao início da linha
00:00000394 740F            	   501:         MOVEQ   #15,D2            ; 16 caracteres
                            	   502: 
                            	   503: AsciiLoop:
00:00000396 1019            	   504:         MOVE.B  (A1)+,D0
00:00000398 B03C0020        	   505:         CMP.B   #32,D0            ; Verifica se é imprimível
00:0000039C 6D0C            	   506:         BLT     NonPrintable
00:0000039E B03C007E        	   507:         CMP.B   #126,D0
00:000003A2 6E06            	   508:         BGT     NonPrintable
                            	   509: 
00:000003A4 4EB80186        	   510:         JSR     UART_WriteChar
00:000003A8 6008            	   511:         BRA     NextAscii
                            	   512: 
                            	   513: NonPrintable:
00:000003AA 103C002E        	   514:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:000003AE 4EB80186        	   515:         JSR     UART_WriteChar
                            	   516: 
                            	   517: NextAscii:
00:000003B2 51CAFFE2        	   518:         DBRA    D2,AsciiLoop
                            	   519: 
00:000003B6 103C007C        	   520:         MOVE.B  #'|',D0
00:000003BA 4EB80186        	   521:         JSR     UART_WriteChar
00:000003BE 103C000D        	   522:         MOVE.B  #13,D0            ; CR
00:000003C2 4EB80186        	   523:         JSR     UART_WriteChar
00:000003C6 103C000A        	   524:         MOVE.B  #10,D0            ; LF
00:000003CA 4EB80186        	   525:         JSR     UART_WriteChar
                            	   526: 
                            	   527: NoEndLine:
