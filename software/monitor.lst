00:000004B4 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
00:000004BC 6704            	     2M     BEQ     .fim                ; Se bit = 0 (Z=1), pula para o rótulo .fim
00:000004BE 12C0            	   656:         MOVE.B  D0,(A1)+            ; Armazena
00:000004C0 60EE            	   657:         BRA     .WriteLoop
                            	   658: 
