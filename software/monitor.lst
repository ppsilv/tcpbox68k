01:00001944 4EB8148A        	  1318:     JSR     PrintHexAddress
01:00001948 4EB8130C        	  1319:     JSR     new_line
                            	  1320: 
01:0000194C 41F819E9        	  1321:     LEA     sr_msg,A0
01:00001950 4EB8126C        	  1322:     JSR     UART_WriteString
01:00001954 3001            	  1323:     MOVE.W  D1,D0           ; SR
01:00001956 4EB8148A        	  1324:     JSR     PrintHexAddress
01:0000195A 4EB8130C        	  1325:     JSR     new_line
                            	  1326: 
01:0000195E 41F81A0F        	  1327:     LEA     vector_msg,A0
01:00001962 4EB8126C        	  1328:     JSR     UART_WriteString
01:00001966 3002            	  1329:     MOVE.W  D2,D0           ; Vector offset
01:00001968 4EB8148A        	  1330:     JSR     PrintHexAddress
01:0000196C 4EB8130C        	  1331:     JSR     new_line
                            	  1332: 
