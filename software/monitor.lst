                            	   902: ; Lê 4 bytes (32 bits) via UART
                            	   903: UART_ReadLong:
01:00001652 7000            	   904:         MOVEQ   #0,D0
01:00001654 7203            	   905:         MOVEQ   #3,D1            ; 4 bytes a ler
                            	   906: .Loop:
01:00001656 E188            	   907:         LSL.L   #8,D0            ; Desloca resultado atual
01:00001658 4EB81664        	   908:         JSR     UART_ReadByte
01:0000165C 8000            	   909:         OR.B    D0,D0            ; Combina com novo byte
01:0000165E 51C9FFF6        	   910:         DBF     D1,.Loop
01:00001662 4E75            	   911:         RTS
                            	   912: 
                            	   913: ; Lê byte hexadecimal (2 caracteres ASCII)
                            	   914: UART_ReadByte:
                            	   915:         CLR_FLAG    FL_ESC
01:00001664 08F9000000081935	     1M     BSET    #FL_ESC,minhas_flags  ; FL_ESC = primeiro argumento (bit)
01:0000166C 44FC0000        	   916:         MOVE #0,CCR
                            	   917:         ;MOVE.L  D0,-(SP)            ; Preserva D0
01:00001670 4EB81694        	   918:         JSR     UART_ReadHexNibble
                            	   919:         TST_FLAG_SET FL_ESC,.Fim            ; Testa o bit 0 (Z=0 se setado)
01:00001674 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
01:0000167C 6714            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
01:0000167E E908            	   920:         LSL.B   #4,D0
01:00001680 1200            	   921:         MOVE.B  D0,D1
01:00001682 4EB81694        	   922:         JSR     UART_ReadHexNibble
                            	   923:         TST_FLAG_SET FL_ESC,.Fim            ; Testa o bit 0 (Z=0 se setado)
01:00001686 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
01:0000168E 6702            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
01:00001690 8001            	   924:         OR.B    D1,D0
                            	   925: .Fim:
                            	   926:         ;MOVE.L  (SP)+,D0        ; Recupera D0
01:00001692 4E75            	   927:         RTS
                            	   928: 
                            	   929: ; Lê meio-byte hexadecimal
                            	   930: UART_ReadHexNibble:
01:00001694 4EB81236        	   931:         JSR     UART_ReadChar
01:00001698 B03C001B        	   932:         CMP.B   #$1B,D0
01:0000169C 6712            	   933:         BEQ     .Fim
01:0000169E B03C0041        	   934:         CMP.B   #'A',D0
01:000016A2 6D02            	   935:         BLT     .Digit
01:000016A4 5F00            	   936:         SUB.B   #7,D0            ; Ajuste para A-F
                            	   937: .Digit:
01:000016A6 903C0030        	   938:         SUB.B   #'0',D0
01:000016AA C03C000F        	   939:         AND.B   #$0F,D0
01:000016AE 4E75            	   940:         RTS
                            	   941: .Fim:
                            	   942:         SET_FLAG FL_ESC
01:000016B0 08B9000000081935	     1M     BCLR    #FL_ESC,minhas_flags  ; FL_ESC = primeiro argumento (bit)
01:000016B8 4E75            	   943:         RTS
