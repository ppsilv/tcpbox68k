                            	   556: ; ----------------------------------------------------------------------
                            	   557: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   558: ; Entrada: D0 = endereço
                            	   559: ; ----------------------------------------------------------------------
                            	   560: PrintHexAddress:
00:0000041E 4840            	   561:         SWAP    D0                ; Imprime parte alta primeiro
00:00000420 4EB80426        	   562:         JSR     PrintWordHex
00:00000424 4840            	   563:         SWAP    D0                ; Parte baixa
                            	   564:         ; Continua para PrintWordHex
                            	   565: 
                            	   566: ; ----------------------------------------------------------------------
                            	   567: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   568: ; Entrada: D0.w = valor
                            	   569: ; ----------------------------------------------------------------------
                            	   570: PrintWordHex:
00:00000426 E158            	   571:         ROL.W   #8,D0             ; Byte mais significativo primeiro
00:00000428 4EB8042E        	   572:         JSR     PrintByteHex
00:0000042C E058            	   573:         ROR.W   #8,D0             ; Byte menos significativo
                            	   574:         ; Continua para PrintByteHex
                            	   575: 
                            	   576: ; ----------------------------------------------------------------------
                            	   577: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   578: ; Entrada: D0.b = valor
                            	   579: ; ----------------------------------------------------------------------
                            	   580: PrintByteHex:
00:0000042E 1F00            	   581:         MOVE.B  D0,-(SP)          ; Salva byte original
00:00000430 E808            	   582:         LSR.B   #4,D0             ; Nibble alto
00:00000432 6106            	   583:         BSR     PrintNibble
00:00000434 101F            	   584:         MOVE.B  (SP)+,D0          ; Recupera byte
00:00000436 0200000F        	   585:         ANDI.B  #$0F,D0           ; Nibble baixo
                            	   586:         ; Continua para PrintNibble
                            	   587: ; ----------------------------------------------------------------------
                            	   588: ; PrintNibble - Imprime um nibble em hex
                            	   589: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   590: ; ----------------------------------------------------------------------
                            	   591: PrintNibble:
00:0000043A B03C0009        	   592:         CMP.B   #9,D0
00:0000043E 6302            	   593:         BLS     .Decimal
00:00000440 5E00            	   594:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   595: .Decimal:
00:00000442 D03C0030        	   596:         ADD.B   #'0',D0
00:00000446 4EF801B0        	   597:         JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   598: 
                            	   599: CLEARRAM:
00:0000044A 41F900080000    	   600:         LEA     $80000,A0
00:00000450 43F90008FFFF    	   601:         LEA     $8FFFF,A1
                            	   602:         ;LEA     $BFFFF,A1
00:00000456 7000            	   603:         MOVEQ   #0,D0
                            	   604: .ClearLoop:
00:00000458 20C0            	   605:         MOVE.L  D0,(A0)+
00:0000045A B3C8            	   606:         CMPA.L  A0,A1
00:0000045C 62FA            	   607:         BHI     .ClearLoop
00:0000045E 4E75            	   608:         RTS
