                            	   262: ; ----------------------------------------------------------------------
                            	   263: ; Constantes
                            	   264: ; ----------------------------------------------------------------------
                            	   265: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   266: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   267:                               ; BAUD_DIV_L em $70000
                            	   268:                               ; BAUD_DIV_U em $70001
                            	   269: 
                            	   270: ; ----------------------------------------------------------------------
                            	   271: ; Rotina: Calcula e armazena divisor de baud rate
                            	   272: ; Entrada:
                            	   273: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   274: ; Saída:
                            	   275: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   276: ; Formulas:
                            	   277: ;
                            	   278: ;
                            	   279: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   280: ; ----------------------------------------------------------------------
                            	   281: 
                            	   282: CALCBAUDDIV:
                            	   283: ;[ Registrador D0 (32 bits) ]
                            	   284: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   285: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   286:         ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   287:         ;((F_CPU/16)/10)
                            	   288:         ;F_CPU = 16000000 ou 0xF42400
00:00000214 203C00F42400    	   289:         MOVE.L  #F_CPU,D0
00:0000021A 323C0010        	   290:         MOVE.W  #16,D1         ; Divisor
00:0000021E 61000096        	   291:         BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   292: ;1
00:00000222 2F00            	   293:         move.l  d0,-(SP)
00:00000224 4EB8041E        	   294:         jsr     PrintHexAddress
00:00000228 4EB802A0        	   295:         jsr     new_line
00:0000022C 201F            	   296:         move.l  (SP)+,d0
                            	   297: 
00:0000022E 323C000A        	   298:         MOVE.W  #10,D1         ; Divisor
00:00000232 61000082        	   299:         BSR     Div32x16       ; D0 = 0x186A0
                            	   300: ;2
00:00000236 2F00            	   301:         move.l  d0,-(SP)
00:00000238 4EB8041E        	   302:         jsr     PrintHexAddress
00:0000023C 4EB802A0        	   303:         jsr     new_line
00:00000240 201F            	   304:         move.l  (SP)+,d0
                            	   305: 
                            	   306:         ;(BAUD/10)
00:00000242 2F00            	   307:         move.l  d0,-(SP)
                            	   308: ;3
00:00000244 7000            	   309:         CLR.L   D0
00:00000246 303900081014    	   310:         MOVE.W  CurrentBaudRate,D0
00:0000024C 2F00            	   311:         move.l  d0,-(SP)
00:0000024E 4EB8041E        	   312:         jsr     PrintHexAddress
00:00000252 4EB802A0        	   313:         jsr     new_line
00:00000256 201F            	   314:         move.l  (SP)+,d0
                            	   315: 
00:00000258 123C000A        	   316:         MOVE.B  #10,D1
00:0000025C 6158            	   317:         BSR     Div32x16
                            	   318: 
                            	   319: ;4
00:0000025E 2F00            	   320:         move.l  d0,-(SP)
00:00000260 4EB8041E        	   321:         jsr     PrintHexAddress
00:00000264 4EB802A0        	   322:         jsr     new_line
00:00000268 221F            	   323:         move.l  (SP)+,D1
00:0000026A 201F            	   324:         move.l  (SP)+,D0
                            	   325: 
                            	   326: 
                            	   327:         ;(F_CPU/BAUD)
00:0000026C 6148            	   328:         BSR     Div32x16
                            	   329: ;5
00:0000026E 2F00            	   330:         move.l  d0,-(SP)
00:00000270 4EB8041E        	   331:         jsr     PrintHexAddress
00:00000274 4EB802A0        	   332:         jsr     new_line
00:00000278 201F            	   333:         move.l  (SP)+,d0
                            	   334: 
                            	   335:         ; 4. Separa parte alta/baixa corretamente
00:0000027A 3200            	   336:         MOVE.W  D0,D1
00:0000027C 024000FF        	   337:         ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000280 E049            	   338:         LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:00000282 024100FF        	   339:         ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   340: 
                            	   341:         ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000286 41F90008101A    	   342:         LEA     Baud1DivL,A0
00:0000028C 3080            	   343:         MOVE.W  D0,(A0)        ; 16 bits suficientes
00:0000028E 41F90008101C    	   344:         LEA     Baud1DivH,A0
00:00000294 3081            	   345:         MOVE.W  D1,(A0)
                            	   346: 
00:00000296 6000FE2E        	   347:         BRA     MenuLoop
00:0000029A 4E75            	   348:         RTS
                            	   349: .BaudError:
00:0000029C 6000FD82        	   350:         BRA     _start
                            	   351: 
                            	   352: new_line:
00:000002A0 2F00            	   353:         MOVE.L  D0,-(SP)          ; Salva D0
00:000002A2 103C000A        	   354:         MOVE.B  #10,D0
00:000002A6 4EB801B0        	   355:         JSR     UART_WriteChar
00:000002AA 103C000D        	   356:         MOVE.B  #13,D0
00:000002AE 4EB801B0        	   357:         JSR     UART_WriteChar
00:000002B2 201F            	   358:         MOVE.L  (SP)+,D0          ; Restaura D0
00:000002B4 4E75            	   359:         RTS
                            	   360: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   361: ; Retorna D0 = Quociente, D1 = Resto
                            	   362: Div32x16:
00:000002B6 7400            	   363:         MOVEQ   #0,D2       ; D2 = Quociente
00:000002B8 761F            	   364:         MOVEQ   #31,D3      ; 32 iterações
                            	   365: DivLoop:
00:000002BA E388            	   366:         LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:000002BC E392            	   367:         ROXL.L  #1,D2       ; Desloca D2 com Carry
00:000002BE B441            	   368:         CMP.W   D1,D2       ; D2 >= D1?
00:000002C0 6D04            	   369:         BLT     .skip
00:000002C2 9441            	   370:         SUB.W   D1,D2       ; Sim, subtrai
00:000002C4 5280            	   371:         ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   372: .skip:
00:000002C6 51CBFFF2        	   373:         DBRA    D3,DivLoop  ; Repete
00:000002CA 2202            	   374:         MOVE.L  D2,D1       ; Resto em D1
00:000002CC 4E75            	   375:         RTS
                            	   376: ; Versão compacta sem stack frame
                            	   377: PrintHexFast:
00:000002CE 2F02            	   378:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002D0 2F00            	   379:         MOVE.L  D0,-(SP)          ; Salva D0 original
00:000002D2 7407            	   380:         MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   381: 
                            	   382: .Loop:
00:000002D4 2017            	   383:         MOVE.L  (SP),D0           ; Recupera valor original
00:000002D6 E998            	   384:         ROL.L   #4,D0             ; Pega próximo nibble
00:000002D8 2E80            	   385:         MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:000002DA 0200000F        	   386:         ANDI.B  #$F,D0            ; Isola nibble
                            	   387: 
00:000002DE B03C0009        	   388:         CMP.B   #9,D0
00:000002E2 6302            	   389:         BLS     .Digit
00:000002E4 5E00            	   390:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   391: .Digit:
00:000002E6 D03C0030        	   392:         ADD.B   #'0',D0           ; Converte para ASCII
00:000002EA 4EB801B0        	   393:         JSR     UART_WriteChar    ; Envia caractere
                            	   394: 
00:000002EE 51CAFFE4        	   395:         DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   396: 
00:000002F2 588F            	   397:         ADDQ.L  #4,SP             ; Remove valor salvo
00:000002F4 241F            	   398:         MOVE.L  (SP)+,D2          ; Restaura D2
00:000002F6 4E75            	   399:         RTS
                            	   400: 
                            	   401: ; ----------------------------------------------------------------------
                            	   402: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   403: ; Entrada:
                            	   404: ;   D0.L = Valor a ser impresso (32 bits)
                            	   405: ;   D1.W = Número de dígitos (1-8)
                            	   406: ; ----------------------------------------------------------------------
                            	   407: PrintHexPRECISA_DE_REVISAO:
00:000002F8 4E56FFF8        	   408:         LINK    A6,#-8            ; Reserva espaço na pilha
00:000002FC 2F02            	   409:         MOVE.L  D2,-(SP)          ; Salva D2
00:000002FE 2D40FFFC        	   410:         MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:00000302 3D41FFFA        	   411:         MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   412: 
00:00000306 323C0008        	   413:         MOVE.W  #$0008,D1
                            	   414: 
                            	   415:         ; Ajusta para começar pelo dígito mais significativo
00:0000030A E549            	   416:         LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:0000030C 5941            	   417:         SUBQ.W  #4,D1             ; Ajuste inicial
                            	   418: 
                            	   419: .PrintLoop:
00:0000030E 202EFFFC        	   420:         MOVE.L  -4(A6),D0         ; Recupera valor
00:00000312 3401            	   421:         MOVE.W  D1,D2             ; Posição do nibble
00:00000314 E5B8            	   422:         ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000316 02800000000F    	   423:         ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   424: 
                            	   425:         ; Converte para ASCII
00:0000031C B03C0009        	   426:         CMP.B   #9,D0
00:00000320 6302            	   427:         BLS     .Decimal
00:00000322 5E00            	   428:         ADD.B   #7,D0             ; Ajuste para A-F
                            	   429: .Decimal:
00:00000324 D03C0030        	   430:         ADD.B   #'0',D0           ; Converte para caractere
                            	   431: 
                            	   432:         ; Imprime caractere
00:00000328 4EB801B0        	   433:         JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   434: 
00:0000032C 5941            	   435:         SUBQ.W  #4,D1             ; Próximo nibble
00:0000032E 6ADE            	   436:         BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   437: 
                            	   438:         ; Espaço final para separação
00:00000330 103C0020        	   439:         MOVE.B  #' ',D0
00:00000334 4EB801B0        	   440:         JSR     UART_WriteChar
                            	   441: 
00:00000338 241F            	   442:         MOVE.L  (SP)+,D2          ; Restaura D2
00:0000033A 4E5E            	   443:         UNLK    A6                ; Restaura frame
00:0000033C 4E75            	   444:         RTS
                            	   445: 
                            	   446: ; ----------------------------------------------------------------------
                            	   447: ; MemDump - Imprime dump de memória formatado
                            	   448: ; Entrada:
                            	   449: ;   A0 = Endereço inicial (ex: $80000)
                            	   450: ;   D0 = Quantidade de bytes (ex: 256)
                            	   451: ; ----------------------------------------------------------------------
                            	   452: MEMDUMP:
00:0000033E 41F90000000D    	   453:         LEA     DumpHeader,A0
00:00000344 4EB80200        	   454:         JSR     UART_WriteString
00:00000348 20790008101E    	   455:         MOVE.L  (addressInHex),A0
00:0000034E 2008            	   456:         MOVE.L  A0,D0
00:00000350 4EB8041E        	   457:         JSR     PrintHexAddress
00:00000354 4EB802A0        	   458:         JSR     new_line
                            	   459: 
00:00000358 41F900000020    	   460:         LEA     DumpHeader1,A0
00:0000035E 4EB80200        	   461:         JSR     UART_WriteString
                            	   462: 
00:00000362 20790008101E    	   463:         MOVE.L  (addressInHex),A0
                            	   464:         ; Calcula endereço final
                            	   465: 
                            	   466: DUMPLOOPMASTER:
00:00000368 7200            	   467:         CLR.L   D1
00:0000036A 2208            	   468:         MOVE.L  A0,D1
00:0000036C 0681000000FF    	   469:         ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   470:         ;MOVE.L  D1,D0
                            	   471:         ;JSR     PrintHexAddress
                            	   472:         ;JSR     new_line
                            	   473: 
                            	   474:         ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   475:         ;JSR     UART_ReadChar
                            	   476: 
                            	   477: 
                            	   478: DumpLoop:
                            	   479:         ; Nova linha a cada 16 bytes
00:00000372 2008            	   480:         MOVE.L  A0,D0
00:00000374 02800000000F    	   481:         ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:0000037A 6616            	   482:         BNE     NoNewLine
                            	   483: 
                            	   484:         ; Imprime endereço
00:0000037C 2008            	   485:         MOVE.L  A0,D0
00:0000037E 4EB8041E        	   486:         JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   487: 
00:00000382 103C003A        	   488:         MOVE.B  #':',D0
00:00000386 4EB801B0        	   489:         JSR     UART_WriteChar
00:0000038A 103C0020        	   490:         MOVE.B  #' ',D0
00:0000038E 4EB801B0        	   491:         JSR     UART_WriteChar
                            	   492: 
                            	   493: NoNewLine:
                            	   494:         ; Imprime byte em hex
00:00000392 1018            	   495:         MOVE.B  (A0)+,D0
00:00000394 4EB8042E        	   496:         JSR     PrintByteHex
                            	   497: 
00:00000398 103C0020        	   498:         MOVE.B  #' ',D0
00:0000039C 4EB801B0        	   499:         JSR     UART_WriteChar
                            	   500: 
                            	   501:         ; Verifica fim da linha (16 bytes)
00:000003A0 2008            	   502:         MOVE.L  A0,D0
00:000003A2 02800000000F    	   503:         ANDI.L  #$0000000F,D0
00:000003A8 664E            	   504:         BNE     NoEndLine
                            	   505: 
                            	   506:         ; Imprime caracteres ASCII
00:000003AA 103C0020        	   507:         MOVE.B  #' ',D0
00:000003AE 4EB801B0        	   508:         JSR     UART_WriteChar
00:000003B2 103C007C        	   509:         MOVE.B  #'|',D0
00:000003B6 4EB801B0        	   510:         JSR     UART_WriteChar
                            	   511: 
00:000003BA 43E8FFF0        	   512:         LEA     -16(A0),A1        ; Volta ao início da linha
00:000003BE 740F            	   513:         MOVEQ   #15,D2            ; 16 caracteres
                            	   514: 
                            	   515: AsciiLoop:
00:000003C0 1019            	   516:         MOVE.B  (A1)+,D0
00:000003C2 B03C0020        	   517:         CMP.B   #32,D0            ; Verifica se é imprimível
00:000003C6 6D0C            	   518:         BLT     NonPrintable
00:000003C8 B03C007E        	   519:         CMP.B   #126,D0
00:000003CC 6E06            	   520:         BGT     NonPrintable
                            	   521: 
00:000003CE 4EB801B0        	   522:         JSR     UART_WriteChar
00:000003D2 6008            	   523:         BRA     NextAscii
                            	   524: 
                            	   525: NonPrintable:
00:000003D4 103C002E        	   526:         MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:000003D8 4EB801B0        	   527:         JSR     UART_WriteChar
                            	   528: 
                            	   529: NextAscii:
00:000003DC 51CAFFE2        	   530:         DBRA    D2,AsciiLoop
                            	   531: 
00:000003E0 103C007C        	   532:         MOVE.B  #'|',D0
00:000003E4 4EB801B0        	   533:         JSR     UART_WriteChar
00:000003E8 103C000D        	   534:         MOVE.B  #13,D0            ; CR
00:000003EC 4EB801B0        	   535:         JSR     UART_WriteChar
00:000003F0 103C000A        	   536:         MOVE.B  #10,D0            ; LF
00:000003F4 4EB801B0        	   537:         JSR     UART_WriteChar
                            	   538: 
                            	   539: NoEndLine:
                            	   540:         ; Verifica fim do dump
00:000003F8 B1C1            	   541:         CMP.L   D1,A0
00:000003FA 6300FF76        	   542:         BLS     DumpLoop
                            	   543: 
00:000003FE 2F08            	   544:         MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000400 41F900000425    	   545:         LEA     HitAnyKey,A0
00:00000406 4EB80200        	   546:         JSR     UART_WriteString
00:0000040A 4EB801CA        	   547:         JSR     UART_ReadChar
00:0000040E B03C001B        	   548:         CMP.B   #$1B,D0
00:00000412 6706            	   549:         BEQ     .fim
                            	   550: 
00:00000414 205F            	   551:         MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:00000416 6000FF50        	   552:         BRA     DUMPLOOPMASTER
                            	   553: .fim
00:0000041A 6000FCAA        	   554:         BRA     MenuLoop
