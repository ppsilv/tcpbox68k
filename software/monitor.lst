                            	   895: ;---------------------------------------------------------------------
                            	   896: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   897: ;---------------------------------------------------------------------
                            	   898: ClearBufferPointers:
00:000006A2 23FC000000000008	   899:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000006AA 1022
00:000006AC 23FC000000000008	   900:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000006B4 1026
00:000006B6 33FC00000008102A	   901:         MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:000006BE 4E75            	   902:         RTS
                            	   903: ;---------------------------------------------------------------------
                            	   904: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   905: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   906: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   907: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   908: ;---------------------------------------------------------------------
                            	   909: MontaAddress:
00:000006C0 48E73C80        	   910:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   911: 
                            	   912:         ; Verifica se há pelo menos 8 bytes no buffer
00:000006C4 32390008102A    	   913:         MOVE.W  BUFFER_COUNT,D1
00:000006CA B27C0008        	   914:         CMP.W   #8,D1
00:000006CE 6D38            	   915:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   916: 
00:000006D0 41F90008102C    	   917:         LEA     BUFFER,A0      ; A0 = base do buffer
00:000006D6 243900081026    	   918:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:000006DC 7000            	   919:         CLR.L   D0                ; Zera D0 (resultado final)
00:000006DE 7607            	   920:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   921: 
                            	   922: .ReadLoop:
00:000006E0 18302800        	   923:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:000006E4 0204000F        	   924:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   925: 
                            	   926:         ; Desloca e insere os 4 bits em D0
00:000006E8 E988            	   927:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:000006EA 8004            	   928:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   929: 
                            	   930:         ; Atualiza tail (circular)
00:000006EC 5282            	   931:         ADDQ.L  #1,D2
00:000006EE 0282000000FF    	   932:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   933: 
00:000006F4 51CBFFEA        	   934:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   935: 
                            	   936:         ; Atualiza ponteiros globais
00:000006F8 23C200081026    	   937:         MOVE.L  D2,BUFFER_TAIL
00:000006FE 51790008102A    	   938:         SUB.W   #8,BUFFER_COUNT
                            	   939: 
00:00000704 7200            	   940:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000706 6004            	   941:         BRA     .Exit
                            	   942: 
                            	   943: .BufferUnderrun:
00:00000708 72FF            	   944:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:0000070A 7000            	   945:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   946: 
                            	   947: .Exit:
00:0000070C 4CDF013C        	   948:         MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:00000710 4E75            	   949:         RTS
