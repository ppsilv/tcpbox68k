01:00001988 B47C0008        	  1344:     CMP.W   #8,D2
01:0000198C 6606            	  1345:     BNE     .not_bus_error
01:0000198E 41F81A2F        	  1346:     LEA     bus_error_msg,A0
01:00001992 6028            	  1347:     BRA     .show_msg
                            	  1348: .not_bus_error:
01:00001994 B47C0009        	  1349:     CMP.W   #9,D2
01:00001998 6606            	  1350:     BNE     .not_address_error
01:0000199A 41F81A3A        	  1351:     LEA     address_error_msg,A0
01:0000199E 601C            	  1352:     BRA     .show_msg
                            	  1353: .not_address_error:
01:000019A0 B47C000A        	  1354:     CMP.W   #10,D2
01:000019A4 6606            	  1355:     BNE     .not_illegal
01:000019A6 41F81A49        	  1356:     LEA     illegal_msg,A0
01:000019AA 6010            	  1357:     BRA     .show_msg
                            	  1358: .not_illegal:
01:000019AC B47C0020        	  1359:     CMP.W   #32,D2
01:000019B0 6506            	  1360:     BLO     .other_exception
01:000019B2 41F81A5E        	  1361:     LEA     trap_msg,A0
01:000019B6 6004            	  1362:     BRA     .show_msg
                            	  1363: .other_exception:
01:000019B8 41F81A70        	  1364:     LEA     unknown_msg,A0
                            	  1365: 
                            	  1366: .show_msg:
