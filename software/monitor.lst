00:000001A0 41F900082000    	   203:     LEA     $82000,A0
00:000001A6 43F90008FFFF    	   204:     LEA     $8FFFF,A1
00:000001AC 7000            	   205:     MOVEQ   #0,D0
                            	   206: .ClearLoop:
00:000001AE D07C0101        	   207:     ADD.W   #$0101,D0
00:000001B2 30C0            	   208:     MOVE.W  D0,(A0)+
00:000001B4 B3C8            	   209:     CMPA.L  A0,A1
00:000001B6 62F6            	   210:     BHI     .ClearLoop
00:000001B8 6000FECE        	   211:     BRA     MenuLoop
                            	   212: 
