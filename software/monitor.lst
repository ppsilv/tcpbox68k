                            	   154: ; ----------------------------------------------------------------------
                            	   155: ; Rotinas de E/S da UART
                            	   156: ; ----------------------------------------------------------------------
                            	   157: 
                            	   158: UART_INIT:
00:0000014A 227900081008    	   159:         move.l   CurrentUART,a1
00:00000150 137C000D0004    	   160:         move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000156 137C00830006    	   161:         move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:0000015C 12BC0068        	   162:         move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000160 137C00000002    	   163:         move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000166 08A900070006    	   164:         bclr.b  #7,LCR(a1)              ; disable divisor latch
00:0000016C 4229000E        	   165:         clr.b   SCR(a1)                 ; clear the scratch register
00:00000170 4E75            	   166:         RTS
                            	   167: 
                            	   168:     ; Escreve caractere (D0.B)
                            	   169: UART_WriteChar:
00:00000172 2F08            	   170:         MOVE.L  A0,-(SP)        ; Preserva A0
00:00000174 2F00            	   171:         MOVE.L  D0,-(SP)        ; Preserva D0
00:00000176 207900081008    	   172:         move.l   CurrentUART,A0
                            	   173: .WaitTx:
00:0000017C 08280005000A    	   174:         BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000182 67F8            	   175:         BEQ     .WaitTx
00:00000184 1080            	   176:         MOVE.B  D0,THR(A0)      ; transmit byte
00:00000186 201F            	   177:         MOVE.L  (SP)+,D0        ;Restaura D0
00:00000188 205F            	   178:         MOVE.L  (SP)+,A0        ;Restaura A0
00:0000018A 4E75            	   179:         RTS
                            	   180: 
                            	   181: 
                            	   182: ; Lê caractere (retorna em D0)
                            	   183: UART_ReadChar:
00:0000018C 2F08            	   184:         MOVE.L  A0,-(SP)        ; Preserva A0
00:0000018E 207900081008    	   185:         MOVE.L   CurrentUART,A0
                            	   186: .WaitRx:
00:00000194 08280000000A    	   187:         BTST    #0,LSR(A0)        ; RX ready?
00:0000019A 67F8            	   188:         BEQ     .WaitRx
00:0000019C 1010            	   189:         MOVE.B  RHR(A0),D0
00:0000019E 205F            	   190:         MOVE.L  (SP)+,A0        ;Restaura A0
00:000001A0 B03C001B        	   191:         CMP.B   #$1b,D0
00:000001A4 6704            	   192:         BEQ     .fim
00:000001A6 4EB80172        	   193:         JSR     UART_WriteChar
                            	   194: .fim
00:000001AA 4E75            	   195:         RTS
                            	   196: 
                            	   197: ; Lê caractere (retorna em D0)
                            	   198: UART_ReadCharNonEcho:
00:000001AC 2F08            	   199:         MOVE.L  A0,-(SP)        ; Preserva A0
00:000001AE 207900081008    	   200:         MOVE.L  CurrentUART,A0
                            	   201: .WaitRx:
00:000001B4 08280000000A    	   202:         BTST    #0,LSR(A0)        ; RX ready?
00:000001BA 67F8            	   203:         BEQ     .WaitRx
                            	   204: 
00:000001BC 1010            	   205:         MOVE.B  RHR(A0),D0
00:000001BE 205F            	   206:         MOVE.L  (SP)+,A0        ;Restaura A0
