                            	   631: ; ----------------------------------------------------------------------
                            	   632: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   633: ; Entrada: D0 = endereço
                            	   634: ; ----------------------------------------------------------------------
                            	   635: PrintHexAddress:
00:000004B0 4840            	   636:     SWAP    D0                ; Imprime parte alta primeiro
00:000004B2 4EB804B8        	   637:     JSR     PrintWordHex
00:000004B6 4840            	   638:     SWAP    D0                ; Parte baixa
                            	   639:     ; Continua para PrintWordHex
                            	   640: 
                            	   641: ; ----------------------------------------------------------------------
                            	   642: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   643: ; Entrada: D0.w = valor
                            	   644: ; ----------------------------------------------------------------------
                            	   645: PrintWordHex:
00:000004B8 E158            	   646:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:000004BA 4EB804C0        	   647:     JSR     PrintByteHex
00:000004BE E058            	   648:     ROR.W   #8,D0             ; Byte menos significativo
                            	   649:     ; Continua para PrintByteHex
                            	   650: 
                            	   651: ; ----------------------------------------------------------------------
                            	   652: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   653: ; Entrada: D0.b = valor
                            	   654: ; ----------------------------------------------------------------------
                            	   655: PrintByteHex:
00:000004C0 1F00            	   656:     MOVE.B  D0,-(SP)          ; Salva byte original
00:000004C2 E808            	   657:     LSR.B   #4,D0             ; Nibble alto
00:000004C4 6106            	   658:     BSR     PrintNibble
00:000004C6 101F            	   659:     MOVE.B  (SP)+,D0          ; Recupera byte
00:000004C8 0200000F        	   660:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   661:     ; Continua para PrintNibble
                            	   662: ; ----------------------------------------------------------------------
                            	   663: ; PrintNibble - Imprime um nibble em hex
                            	   664: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   665: ; ----------------------------------------------------------------------
                            	   666: PrintNibble:
00:000004CC B03C0009        	   667:     CMP.B   #9,D0
00:000004D0 6302            	   668:     BLS     .Decimal
00:000004D2 5E00            	   669:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   670: .Decimal:
00:000004D4 D03C0030        	   671:     ADD.B   #'0',D0
00:000004D8 4EF80228        	   672:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   673: 
                            	   674: ClearRAM:
00:000004DC 41F900080000    	   675:     LEA     $80000,A0
00:000004E2 43F90008FFFF    	   676:     LEA     $8FFFF,A1
00:000004E8 7000            	   677:     MOVEQ   #0,D0
                            	   678: .ClearLoop:
00:000004EA 20C0            	   679:     MOVE.L  D0,(A0)+
00:000004EC B3C8            	   680:     CMPA.L  A0,A1
00:000004EE 62FA            	   681:     BHI     .ClearLoop
00:000004F0 4E75            	   682:     RTS
                            	   683: ; ----------------------------------------------------------------------
                            	   684: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   685: ; ----------------------------------------------------------------------
                            	   686: ClearRAM1:
00:000004F2 41F900080000    	   687:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000004F8 43F900100000    	   688:     LEA     $100000,A1       ; Endereço final + 1
00:000004FE 7000            	   689:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   690: 
                            	   691:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000500 2209            	   692:     MOVE.L  A1,D1
00:00000502 9288            	   693:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   694: 
                            	   695:     ; Otimização: escreve longs (32 bits) quando possível
00:00000504 2401            	   696:     MOVE.L  D1,D2
00:00000506 028200000003    	   697:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:0000050C 670C            	   698:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   699: 
                            	   700:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:0000050E 5382            	   701:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   702: .ResidualLoop:
00:00000510 10C0            	   703:     MOVE.B  D0,(A0)+
00:00000512 51CAFFFC        	   704:     DBRA    D2,.ResidualLoop
                            	   705: 
                            	   706:     ; Atualiza tamanho restante
00:00000516 9282            	   707:     SUB.L   D2,D1
00:00000518 5381            	   708:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   709: 
                            	   710: .ClearLongs:
00:0000051A E489            	   711:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:0000051C 5381            	   712:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   713: 
                            	   714: .LongLoop:
00:0000051E 20C0            	   715:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000520 51C9FFFC        	   716:     DBRA    D1,.LongLoop
00:00000524 4E75            	   717:     RTS
