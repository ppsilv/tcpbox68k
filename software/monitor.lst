                            	   238: ; ----------------------------------------------------------------------
                            	   239: ; Constantes
                            	   240: ; ----------------------------------------------------------------------
                            	   241: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   242: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   243:                               ; BAUD_DIV_L em $70000
                            	   244:                               ; BAUD_DIV_U em $70001
                            	   245: 
                            	   246: ; ----------------------------------------------------------------------
                            	   247: ; Rotina: Calcula e armazena divisor de baud rate
                            	   248: ; Entrada:
                            	   249: ;   Nenhuma a rotina pega o baudrate na memoria e faz ocalculo
                            	   250: ; Saída:
                            	   251: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   252: ; Formulas:
                            	   253: ;
                            	   254: ;
                            	   255: ; Simplificada: F_CPU/16/10/BAUD_RATE/10
                            	   256: ; ----------------------------------------------------------------------
                            	   257: 
                            	   258: CalcBaudDiv:
                            	   259: ;[ Registrador D0 (32 bits) ]
                            	   260: ;[   DIVU.W #16,D0          ]  → "Divida esse LONG por 16, mas... só pode retornar WORD!"
                            	   261: ;[   Se o resultado > 65535 ]  → "F*DEU, vou ignorar e deixar o original mesmo ¯\_(ツ)_/¯"
                            	   262:     ;==(((F_CPU/16)/10)/(BAUD/10))+5/10
                            	   263:     ;((F_CPU/16)/10)
                            	   264:     ;F_CPU = 16000000 ou 0xF42400
00:000001E4 203C00F42400    	   265:     MOVE.L  #F_CPU,D0
00:000001EA 323C0010        	   266:     MOVE.W  #16,D1         ; Divisor
00:000001EE 61000096        	   267:     BSR     Div32x16       ; D0 = 0xF4240 (1.000.000)
                            	   268: ;1
00:000001F2 2F00            	   269:     move.l  d0,-(SP)
00:000001F4 4EB80408        	   270:     jsr     PrintHexAddress
00:000001F8 4EB80270        	   271:     jsr     new_line
00:000001FC 201F            	   272:     move.l  (SP)+,d0
                            	   273: 
00:000001FE 323C000A        	   274:     MOVE.W  #10,D1         ; Divisor
00:00000202 61000082        	   275:     BSR     Div32x16       ; D0 = 0x186A0
                            	   276: ;2
00:00000206 2F00            	   277:     move.l  d0,-(SP)
00:00000208 4EB80408        	   278:     jsr     PrintHexAddress
00:0000020C 4EB80270        	   279:     jsr     new_line
00:00000210 201F            	   280:     move.l  (SP)+,d0
                            	   281: 
                            	   282:     ;(BAUD/10)
00:00000212 2F00            	   283:     move.l  d0,-(SP)
                            	   284: ;3
00:00000214 7000            	   285:     CLR.L   D0
00:00000216 30390008100C    	   286:     MOVE.W  CurrentBaudRate,D0
00:0000021C 2F00            	   287:     move.l  d0,-(SP)
00:0000021E 4EB80408        	   288:     jsr     PrintHexAddress
00:00000222 4EB80270        	   289:     jsr     new_line
00:00000226 201F            	   290:     move.l  (SP)+,d0
                            	   291: 
00:00000228 123C000A        	   292:     MOVE.B  #10,D1
00:0000022C 6158            	   293:     BSR     Div32x16
                            	   294: 
                            	   295: ;4
00:0000022E 2F00            	   296:     move.l  d0,-(SP)
00:00000230 4EB80408        	   297:     jsr     PrintHexAddress
00:00000234 4EB80270        	   298:     jsr     new_line
00:00000238 221F            	   299:     move.l  (SP)+,D1
00:0000023A 201F            	   300:     move.l  (SP)+,D0
                            	   301: 
                            	   302: 
                            	   303:     ;(F_CPU/BAUD)
00:0000023C 6148            	   304:     BSR     Div32x16
                            	   305: ;5
00:0000023E 2F00            	   306:     move.l  d0,-(SP)
00:00000240 4EB80408        	   307:     jsr     PrintHexAddress
00:00000244 4EB80270        	   308:     jsr     new_line
00:00000248 201F            	   309:     move.l  (SP)+,d0
                            	   310: 
                            	   311:     ; 4. Separa parte alta/baixa corretamente
00:0000024A 3200            	   312:     MOVE.W  D0,D1
00:0000024C 024000FF        	   313:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:00000250 E049            	   314:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:00000252 024100FF        	   315:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   316: 
                            	   317:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000256 41F900081012    	   318:     LEA     Baud1DivL,A0
00:0000025C 3080            	   319:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:0000025E 41F900081014    	   320:     LEA     Baud1DivH,A0
00:00000264 3081            	   321:     MOVE.W  D1,(A0)
                            	   322: 
00:00000266 6000FE04        	   323:     BRA     MenuLoop
00:0000026A 4E75            	   324:     RTS
                            	   325: .BaudError:
00:0000026C 6000FD9A        	   326:     BRA     _start
                            	   327: 
                            	   328: new_line:
00:00000270 2F00            	   329:         MOVE.L  D0,-(SP)          ; Salva D0
00:00000272 103C000A        	   330:         MOVE.B  #10,D0
00:00000276 4EB8019C        	   331:         JSR     UART_WriteChar
00:0000027A 103C000D        	   332:         MOVE.B  #13,D0
00:0000027E 4EB8019C        	   333:         JSR     UART_WriteChar
00:00000282 201F            	   334:         MOVE.L  (SP)+,D0          ; Restaura D0
00:00000284 4E75            	   335:         RTS
                            	   336: ; D0 = Dividendo (32 bits), D1 = Divisor (16 bits)
                            	   337: ; Retorna D0 = Quociente, D1 = Resto
                            	   338: Div32x16:
00:00000286 7400            	   339:     MOVEQ   #0,D2       ; D2 = Quociente
00:00000288 761F            	   340:     MOVEQ   #31,D3      ; 32 iterações
                            	   341: DivLoop:
00:0000028A E388            	   342:     LSL.L   #1,D0       ; Desloca D0 (MSB → Carry)
00:0000028C E392            	   343:     ROXL.L  #1,D2       ; Desloca D2 com Carry
00:0000028E B441            	   344:     CMP.W   D1,D2       ; D2 >= D1?
00:00000290 6D04            	   345:     BLT     .skip
00:00000292 9441            	   346:     SUB.W   D1,D2       ; Sim, subtrai
00:00000294 5280            	   347:     ADDQ.L  #1,D0       ; E adiciona 1 ao quociente
                            	   348: .skip:
00:00000296 51CBFFF2        	   349:     DBRA    D3,DivLoop  ; Repete
00:0000029A 2202            	   350:     MOVE.L  D2,D1       ; Resto em D1
00:0000029C 4E75            	   351:     RTS
                            	   352: ; Versão compacta sem stack frame
                            	   353: PrintHexFast:
00:0000029E 2F02            	   354:     MOVE.L  D2,-(SP)          ; Salva D2
00:000002A0 2F00            	   355:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:000002A2 7407            	   356:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   357: 
                            	   358: .Loop:
00:000002A4 2017            	   359:     MOVE.L  (SP),D0           ; Recupera valor original
00:000002A6 E998            	   360:     ROL.L   #4,D0             ; Pega próximo nibble
00:000002A8 2E80            	   361:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:000002AA 0200000F        	   362:     ANDI.B  #$F,D0            ; Isola nibble
                            	   363: 
00:000002AE B03C0009        	   364:     CMP.B   #9,D0
00:000002B2 6302            	   365:     BLS     .Digit
00:000002B4 5E00            	   366:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   367: .Digit:
00:000002B6 D03C0030        	   368:     ADD.B   #'0',D0           ; Converte para ASCII
00:000002BA 4EB8019C        	   369:     JSR     UART_WriteChar    ; Envia caractere
                            	   370: 
00:000002BE 51CAFFE4        	   371:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   372: 
00:000002C2 588F            	   373:     ADDQ.L  #4,SP             ; Remove valor salvo
00:000002C4 241F            	   374:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000002C6 4E75            	   375:     RTS
                            	   376: 
                            	   377: ; ----------------------------------------------------------------------
                            	   378: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   379: ; Entrada:
                            	   380: ;   D0.L = Valor a ser impresso (32 bits)
                            	   381: ;   D1.W = Número de dígitos (1-8)
                            	   382: ; ----------------------------------------------------------------------
                            	   383: PrintHexPRECISA_DE_REVISAO:
00:000002C8 4E56FFF8        	   384:     LINK    A6,#-8            ; Reserva espaço na pilha
00:000002CC 2F02            	   385:     MOVE.L  D2,-(SP)          ; Salva D2
00:000002CE 2D40FFFC        	   386:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000002D2 3D41FFFA        	   387:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   388: 
00:000002D6 323C0008        	   389:     MOVE.W  #$0008,D1
                            	   390: 
                            	   391:     ; Ajusta para começar pelo dígito mais significativo
00:000002DA E549            	   392:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000002DC 5941            	   393:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   394: 
                            	   395: .PrintLoop:
00:000002DE 202EFFFC        	   396:     MOVE.L  -4(A6),D0         ; Recupera valor
00:000002E2 3401            	   397:     MOVE.W  D1,D2             ; Posição do nibble
00:000002E4 E5B8            	   398:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:000002E6 02800000000F    	   399:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   400: 
                            	   401:     ; Converte para ASCII
00:000002EC B03C0009        	   402:     CMP.B   #9,D0
00:000002F0 6302            	   403:     BLS     .Decimal
00:000002F2 5E00            	   404:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   405: .Decimal:
00:000002F4 D03C0030        	   406:     ADD.B   #'0',D0           ; Converte para caractere
                            	   407: 
                            	   408:     ; Imprime caractere
00:000002F8 4EB8019C        	   409:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   410: 
00:000002FC 5941            	   411:     SUBQ.W  #4,D1             ; Próximo nibble
00:000002FE 6ADE            	   412:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   413: 
                            	   414:     ; Espaço final para separação
00:00000300 103C0020        	   415:     MOVE.B  #' ',D0
00:00000304 4EB8019C        	   416:     JSR     UART_WriteChar
                            	   417: 
00:00000308 241F            	   418:     MOVE.L  (SP)+,D2          ; Restaura D2
00:0000030A 4E5E            	   419:     UNLK    A6                ; Restaura frame
00:0000030C 4E75            	   420:     RTS
                            	   421: ; ----------------------------------------------------------------------
                            	   422: ; Exemplo de uso:
                            	   423: ; ----------------------------------------------------------------------
                            	   424: SetupDivisor:
00:0000030E 303C2580        	   425:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:00000312 6100FED0        	   426:     BSR     CalcBaudDiv
                            	   427: 
                            	   428:     ; Agora pode acessar os valores na RAM:
00:00000316 41F90008100E    	   429:     LEA     BaudDivL,A0
00:0000031C 1010            	   430:     MOVE.B  (A0),D0          ; D0 = BAUD_DIV_L
00:0000031E 41F900081010    	   431:     LEA     BaudDivH,A0
00:00000324 1210            	   432:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   433: 
                            	   434:     ; (Aqui você configuraria os registradores da UART)
00:00000326 4E75            	   435:     RTS
                            	   436: ; ----------------------------------------------------------------------
                            	   437: ; MemDump - Imprime dump de memória formatado
                            	   438: ; Entrada:
                            	   439: ;   A0 = Endereço inicial (ex: $80000)
                            	   440: ;   D0 = Quantidade de bytes (ex: 256)
                            	   441: ; ----------------------------------------------------------------------
                            	   442: MemDump:
00:00000328 41F90000002B    	   443:     LEA     DumpHeader,A0
00:0000032E 4EB801D0        	   444:     JSR     UART_WriteString
00:00000332 207900081016    	   445:     MOVE.L  (addressInHex),A0
00:00000338 2008            	   446:     MOVE.L  A0,D0
00:0000033A 4EB80408        	   447:     JSR     PrintHexAddress
00:0000033E 4EB80270        	   448:     JSR     new_line
                            	   449: 
00:00000342 41F90000003E    	   450:     LEA     DumpHeader1,A0
00:00000348 4EB801D0        	   451:     JSR     UART_WriteString
                            	   452: 
00:0000034C 207900081016    	   453:     MOVE.L  (addressInHex),A0
                            	   454:     ; Calcula endereço final
                            	   455: 
                            	   456: DUMPLOOPMASTER:
00:00000352 7200            	   457:     CLR.L   D1
00:00000354 2208            	   458:     MOVE.L  A0,D1
00:00000356 0681000000FF    	   459:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   460:     ;MOVE.L  D1,D0
                            	   461:     ;JSR     PrintHexAddress
                            	   462:     ;JSR     new_line
                            	   463: 
                            	   464:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   465:     ;JSR     UART_ReadChar
                            	   466: 
                            	   467: 
                            	   468: DumpLoop:
                            	   469:     ; Nova linha a cada 16 bytes
00:0000035C 2008            	   470:     MOVE.L  A0,D0
00:0000035E 02800000000F    	   471:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000364 6616            	   472:     BNE     NoNewLine
                            	   473: 
                            	   474:     ; Imprime endereço
00:00000366 2008            	   475:     MOVE.L  A0,D0
00:00000368 4EB80408        	   476:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   477: 
00:0000036C 103C003A        	   478:     MOVE.B  #':',D0
00:00000370 4EB8019C        	   479:     JSR     UART_WriteChar
00:00000374 103C0020        	   480:     MOVE.B  #' ',D0
00:00000378 4EB8019C        	   481:     JSR     UART_WriteChar
                            	   482: 
                            	   483: NoNewLine:
                            	   484:     ; Imprime byte em hex
00:0000037C 1018            	   485:     MOVE.B  (A0)+,D0
00:0000037E 4EB80418        	   486:     JSR     PrintByteHex
                            	   487: 
00:00000382 103C0020        	   488:     MOVE.B  #' ',D0
00:00000386 4EB8019C        	   489:     JSR     UART_WriteChar
                            	   490: 
                            	   491:     ; Verifica fim da linha (16 bytes)
00:0000038A 2008            	   492:     MOVE.L  A0,D0
00:0000038C 02800000000F    	   493:     ANDI.L  #$0000000F,D0
00:00000392 664E            	   494:     BNE     NoEndLine
                            	   495: 
                            	   496:     ; Imprime caracteres ASCII
00:00000394 103C0020        	   497:     MOVE.B  #' ',D0
00:00000398 4EB8019C        	   498:     JSR     UART_WriteChar
00:0000039C 103C007C        	   499:     MOVE.B  #'|',D0
00:000003A0 4EB8019C        	   500:     JSR     UART_WriteChar
                            	   501: 
00:000003A4 43E8FFF0        	   502:     LEA     -16(A0),A1        ; Volta ao início da linha
00:000003A8 740F            	   503:     MOVEQ   #15,D2            ; 16 caracteres
                            	   504: 
                            	   505: AsciiLoop:
00:000003AA 1019            	   506:     MOVE.B  (A1)+,D0
00:000003AC B03C0020        	   507:     CMP.B   #32,D0            ; Verifica se é imprimível
00:000003B0 6D0C            	   508:     BLT     NonPrintable
00:000003B2 B03C007E        	   509:     CMP.B   #126,D0
00:000003B6 6E06            	   510:     BGT     NonPrintable
                            	   511: 
00:000003B8 4EB8019C        	   512:     JSR     UART_WriteChar
00:000003BC 6008            	   513:     BRA     NextAscii
                            	   514: 
                            	   515: NonPrintable:
00:000003BE 103C002E        	   516:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:000003C2 4EB8019C        	   517:     JSR     UART_WriteChar
                            	   518: 
                            	   519: NextAscii:
00:000003C6 51CAFFE2        	   520:     DBRA    D2,AsciiLoop
                            	   521: 
00:000003CA 103C007C        	   522:     MOVE.B  #'|',D0
00:000003CE 4EB8019C        	   523:     JSR     UART_WriteChar
00:000003D2 103C000D        	   524:     MOVE.B  #13,D0            ; CR
00:000003D6 4EB8019C        	   525:     JSR     UART_WriteChar
00:000003DA 103C000A        	   526:     MOVE.B  #10,D0            ; LF
00:000003DE 4EB8019C        	   527:     JSR     UART_WriteChar
                            	   528: 
                            	   529: NoEndLine:
                            	   530:     ; Verifica fim do dump
00:000003E2 B1C1            	   531:     CMP.L   D1,A0
00:000003E4 6300FF76        	   532:     BLS     DumpLoop
                            	   533: 
00:000003E8 2F08            	   534:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:000003EA 41F90000040D    	   535:     LEA     HitAnyKey,A0
00:000003F0 4EB801D0        	   536:     JSR     UART_WriteString
00:000003F4 4EB801B6        	   537:     JSR     UART_ReadChar
00:000003F8 B03C001B        	   538:     CMP.B   #$1B,D0
00:000003FC 6706            	   539:     BEQ     .fim
                            	   540: 
00:000003FE 205F            	   541:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:00000400 6000FF50        	   542:     BRA     DUMPLOOPMASTER
                            	   543: .fim
00:00000404 6000FC66        	   544:     BRA     MenuLoop
