                            	  1067: ; XMODEM RECEIVER ROUTINE
                            	  1068: ;bloco.append(0x01);        // SOH
                            	  1069: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	  1070: ;bloco.append(255 - blockNumber); // Complemento
                            	  1071: ;bloco.append(dados);       // Seus 128 bytes de dados
                            	  1072: ;bloco.append(checksum);    // Checksum calculado
                            	  1073: ; =====================================================================
                            	  1074: XMODEM_Receive:
00:000007C0 48E73FFE        	  1075:                 MOVEM.L D2-D7/A0-A6,-(SP)
                            	  1076:                 ; Inicializa variáveis
00:000007C4 41F900081325    	  1077:                 LEA     expected_block,A0
00:000007CA 103C0001        	  1078:                 MOVE.B  #1,D0
00:000007CE 1080            	  1079:                 MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:000007D0 41F900081124    	  1080:                 LEA     xmodem_buffer,A0
                            	  1081: 
                            	  1082:                 ; ---- 1. INICIALIZAÇÃO ----
00:000007D6 103C0015        	  1083:                 MOVE.B  #NAK,D0
00:000007DA 4EB80228        	  1084:                 JSR     UART_WriteChar      ; Solicita início
                            	  1085: 
                            	  1086:                 ;SINALIZA NACK SENT
00:000007DE 303C0800        	  1087:                 MOVE.W  #$0800,D0
00:000007E2 4EB80168        	  1088:                 JSR     WRITE_LEDS
                            	  1089: 
                            	  1090:                 ; ---- 2. LOOP PRINCIPAL ----
                            	  1091: Receive_Loop:
00:000007E6 4EB80262        	  1092:                 JSR     UART_ReadCharNonEcho
                            	  1093: 
00:000007EA B03C0004        	  1094:                 CMP.B   #EOT,D0
00:000007EE 670000B0        	  1095:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	  1096: 
00:000007F2 B03C0001        	  1097:                 CMP.B   #SOH,D0
00:000007F6 66EE            	  1098:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	  1099: 
                            	  1100:                 ;SINALIZA leds
00:000007F8 303C0C00        	  1101:                 MOVE.W  #$0C00,D0
00:000007FC 4EB80168        	  1102:                 JSR     WRITE_LEDS
                            	  1103: 
                            	  1104:                 ; ---- 3. RECEBE HEADER ----
00:00000800 4EB80262        	  1105:                 JSR     UART_ReadCharNonEcho       ; Block number
00:00000804 13C000081324    	  1106:                 MOVE.B  D0,block_number
                            	  1107: 
00:0000080A 4EB80262        	  1108:                 JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1109: 
                            	  1110:                 ;SINALIZA leds
00:0000080E 303C0800        	  1111:                 MOVE.W  #$0800,D0
00:00000812 4EB80168        	  1112:                 JSR     WRITE_LEDS
                            	  1113: 
                            	  1114:                 ; ---- 4. RECEBE DADOS ----
00:00000816 7220            	  1115:                 MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:00000818 43F900081124    	  1116:                 LEA     xmodem_buffer,A1
                            	  1117: Read_Loop:
                            	  1118:                 ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:0000081E 4EB80262        	  1119:                 JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:00000822 E188            	  1120:                 LSL.L   #8,D0
00:00000824 4EB80262        	  1121:                 JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:00000828 E188            	  1122:                 LSL.L   #8,D0
00:0000082A 4EB80262        	  1123:                 JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:0000082E E188            	  1124:                 LSL.L   #8,D0
00:00000830 4EB80262        	  1125:                 JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:00000834 22C0            	  1126:                 MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:00000836 5381            	  1127:                 SUBQ.L  #1,D1
00:00000838 66E4            	  1128:                 BNE     Read_Loop
                            	  1129: 
00:0000083A 303C0600        	  1130:                 MOVE.W  #$0600,D0
00:0000083E 4EB80168        	  1131:                 JSR     WRITE_LEDS
                            	  1132: 
                            	  1133:                 ; ---- 5. VERIFICA CHECKSUM ----
00:00000842 4EB80262        	  1134:                 JSR     UART_ReadCharNonEcho       ; Checksum
00:00000846 1400            	  1135:                 MOVE.B  D0,D2
                            	  1136: 
                            	  1137: 
                            	  1138: ;******************************************************************************************
                            	  1139:                 ;SEM CHECKSUM NESSE MOMENTO SEM COPIAR DADOS SO TESTANDO ENVIO
                            	  1140:            ;     BRA     Send_ACK
                            	  1141: ;******************************************************************************************
                            	  1142: 
                            	  1143:                 ; Calcula checksum local
                            	  1144:            ;     LEA     xmodem_buffer,A1
                            	  1145:            ;     MOVE.W  #127,D1
                            	  1146:            ;     CLR.B   D3
                            	  1147: 
                            	  1148: Calc_Checksum:
                            	  1149:            ;     ADD.B   (A1)+,D3
                            	  1150:            ;     DBF     D1,Calc_Checksum;
                            	  1151: 
                            	  1152:            ;     CMP.B   D2,D3
                            	  1153:            ;     BNE     Send_NAK            ; Erro no checksum
                            	  1154: 
                            	  1155:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
                            	  1156:            ;     MOVE.B  block_number,D0
                            	  1157:            ;     CMP.B   expected_block,D0
                            	  1158:            ;     BNE     Send_NAK            ; Bloco fora de ordem
                            	  1159: 
                            	  1160:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	  1161:                 ; (Aqui você processa os 128 bytes recebidos)
                            	  1162:                 ; Exemplo: copiar do buffer para a RAM
                            	  1163:                 ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:00000848 43F900081124    	  1164:                 LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:0000084E 247900081326    	  1165:                 MOVE.L  user_buffer_ptr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:00000854 7220            	  1166:                 MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1167: Copy_Data:
00:00000856 24D9            	  1168:                 MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:00000858 5381            	  1169:                 SUBQ.L  #1,D1               ; Decrementa contador
00:0000085A 66FA            	  1170:                 BNE     Copy_Data            ; Repete até D1 = 0
                            	  1171:                 ; 2. Atualiza user_buffer_ptr para o próximo bloco (+128 bytes)
00:0000085C 203900081326    	  1172:                 MOVE.L  user_buffer_ptr,D0
00:00000862 068000000080    	  1173:                 ADDI.L  #128,D0
00:00000868 23C000081326    	  1174:                 MOVE.L  D0,user_buffer_ptr
                            	  1175: 
                            	  1176: 
                            	  1177: 
                            	  1178:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:0000086E 523900081325    	  1179:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000874 103C0006        	  1180:                 MOVE.B  #ACK,D0
00:00000878 4EB80228        	  1181:                 JSR     UART_WriteChar
00:0000087C 6000FF68        	  1182:                 BRA     Receive_Loop
                            	  1183: 
                            	  1184: Send_ACK:
                            	  1185:                 ;SINALIZA NACK SENT
00:00000880 303C0400        	  1186:                 MOVE.W  #$0400,D0
00:00000884 4EB80168        	  1187:                 JSR     WRITE_LEDS
00:00000888 103C0006        	  1188:                 MOVE.B  #ACK,D0
00:0000088C 4EB80228        	  1189:                 JSR     UART_WriteChar
00:00000890 6000FF54        	  1190:                 BRA     Receive_Loop
                            	  1191: 
                            	  1192: Send_NAK:
00:00000894 103C0015        	  1193:                 MOVE.B  #NAK,D0
00:00000898 4EB80228        	  1194:                 JSR     UART_WriteChar
00:0000089C 6000FF48        	  1195:                 BRA     Receive_Loop
                            	  1196: 
                            	  1197: Transfer_Complete:
00:000008A0 103C0006        	  1198:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:000008A4 4EB80228        	  1199:                 JSR     UART_WriteChar
00:000008A8 4CDF7FFC        	  1200:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:000008AC 4E75            	  1201:                 RTS
                            	  1202: ; ========================================================
                            	  1203: ; Validador de Checksum para ROM (MC68000)
                            	  1204: ; Assume:
                            	  1205: ;   - Checksum está nos últimos 4 bytes da ROM (LONG)
                            	  1206: ;   - Big-endian (padrão 68000)
                            	  1207: ;   - ROM termina em 0x0000FFFF (16KB)
                            	  1208: ; ========================================================
                            	  1209: 
                            	  1210: VALIDATE_ROM:
00:000008AE 91C8            	  1211:     LEA     ROM_START,A0        ; Endereço inicial da ROM (0x00000000)
00:000008B0 203C00007FFC    	  1212:     MOVE.L  #ROM_SIZE-4,D0      ; Tamanho da ROM (16KB - 4 bytes)
00:000008B6 7200            	  1213:     MOVE.L  #0,D1               ; Acumulador do checksum
                            	  1214: 
                            	  1215:     ; --- Calcula checksum (soma de todos os LONGs, exceto os últimos 4 bytes) ---
                            	  1216: .CHECKSUM_LOOP:
00:000008B8 2418            	  1217:     MOVE.L  (A0)+,D2            ; Lê 4 bytes da ROM
00:000008BA D282            	  1218:     ADD.L   D2,D1               ; Soma ao acumulador
00:000008BC 5980            	  1219:     SUB.L   #4,D0               ; Decrementa contador
00:000008BE 6EF8            	  1220:     BGT     .CHECKSUM_LOOP      ; Repete até D0 <= 0
                            	  1221: 
                            	  1222:     ; --- Compara com o checksum armazenado (últimos 4 bytes da ROM) ---
00:000008C0 24387FFB        	  1223:     MOVE.L  ROM_END-4,D2        ; Lê o checksum gravado (0x0000FFFC)
00:000008C4 B481            	  1224:     CMP.L   D1,D2               ; Combina com o calculado?
00:000008C6 6706            	  1225:     BEQ     .CHECKSUM_OK        ; Se sim, ROM válida
                            	  1226: 
                            	  1227:     ; --- Checksum inválido: travar o sistema ou notificar ---
00:000008C8 363CDEAD        	  1228:     MOVE.W  #$DEAD,D3           ; Código de erro (opcional)
00:000008CC 6002            	  1229:     BRA     SYSTEM_HALT         ; Trava o sistema (ou reinicia)
                            	  1230: .CHECKSUM_OK:
00:000008CE 4E75            	  1231:     RTS                         ; Retorna (ROM válida)
                            	  1232: 
                            	  1233: SYSTEM_HALT:
00:000008D0 46FC2700        	  1234:     MOVE.W  #$2700,SR        ; Desabilita interrupções
                            	  1235: .INFINITE_LOOP:
00:000008D4 60FE            	  1236:     BRA     .INFINITE_LOOP   ; Trava o sistema
                            	  1237: 
                            	  1238: ; --- Constantes ---
                            	  1239: ROM_START   EQU     $00000000   ; Início da ROM
                            	  1240: ROM_END     EQU     $00007FFF   ; Fim da ROM (8KB)
                            	  1241: ROM_SIZE    EQU     ROM_END-ROM_START+1  ; Tamanho total (16384 bytes)
                            	  1242: 
                            	  1243: Checksum:
00:000008D6 00000000        	  1244:     DC.L    0               ; Temporariamente 0
                            	  1245: 
00:000008DA 4D45524441205445	  1246:     DC.B "MERDA TERMINA"
00:000008E2 524D494E41
