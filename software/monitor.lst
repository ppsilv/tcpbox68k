                            	   541: DUMPLOOPMASTER:
00:000003FE 7200            	   542:     CLR.L   D1
00:00000400 2208            	   543:     MOVE.L  A0,D1
00:00000402 0681000000FF    	   544:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
                            	   545:     ;MOVE.L  D1,D0
                            	   546:     ;JSR     PrintHexAddress
                            	   547:     ;JSR     new_line
                            	   548: 
                            	   549:     ;aguarda um caractere ser digitado mas nao usa é somente para parar a execução aqui
                            	   550:     ;JSR     UART_ReadChar
                            	   551: 
                            	   552: 
                            	   553: DumpLoop:
                            	   554:     ; Nova linha a cada 16 bytes
00:00000408 2008            	   555:     MOVE.L  A0,D0
00:0000040A 02800000000F    	   556:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000410 6616            	   557:     BNE     NoNewLine
                            	   558: 
                            	   559:     ; Imprime endereço
00:00000412 2008            	   560:     MOVE.L  A0,D0
00:00000414 4EB804B4        	   561:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   562: 
00:00000418 103C003A        	   563:     MOVE.B  #':',D0
00:0000041C 4EB8022C        	   564:     JSR     UART_WriteChar
00:00000420 103C0020        	   565:     MOVE.B  #' ',D0
00:00000424 4EB8022C        	   566:     JSR     UART_WriteChar
                            	   567: 
                            	   568: NoNewLine:
                            	   569:     ; Imprime byte em hex
00:00000428 1018            	   570:     MOVE.B  (A0)+,D0
00:0000042A 4EB804C4        	   571:     JSR     PrintByteHex
                            	   572: 
00:0000042E 103C0020        	   573:     MOVE.B  #' ',D0
00:00000432 4EB8022C        	   574:     JSR     UART_WriteChar
                            	   575: 
                            	   576:     ; Verifica fim da linha (16 bytes)
00:00000436 2008            	   577:     MOVE.L  A0,D0
00:00000438 02800000000F    	   578:     ANDI.L  #$0000000F,D0
00:0000043E 664E            	   579:     BNE     NoEndLine
                            	   580: 
                            	   581:     ; Imprime caracteres ASCII
00:00000440 103C0020        	   582:     MOVE.B  #' ',D0
00:00000444 4EB8022C        	   583:     JSR     UART_WriteChar
00:00000448 103C007C        	   584:     MOVE.B  #'|',D0
00:0000044C 4EB8022C        	   585:     JSR     UART_WriteChar
                            	   586: 
00:00000450 43E8FFF0        	   587:     LEA     -16(A0),A1        ; Volta ao início da linha
00:00000454 740F            	   588:     MOVEQ   #15,D2            ; 16 caracteres
                            	   589: 
                            	   590: AsciiLoop:
00:00000456 1019            	   591:     MOVE.B  (A1)+,D0
00:00000458 B03C0020        	   592:     CMP.B   #32,D0            ; Verifica se é imprimível
00:0000045C 6D0C            	   593:     BLT     NonPrintable
00:0000045E B03C007E        	   594:     CMP.B   #126,D0
00:00000462 6E06            	   595:     BGT     NonPrintable
                            	   596: 
00:00000464 4EB8022C        	   597:     JSR     UART_WriteChar
00:00000468 6008            	   598:     BRA     NextAscii
                            	   599: 
                            	   600: NonPrintable:
00:0000046A 103C002E        	   601:     MOVE.B  #'.',D0           ; Substitui não imprimíveis
00:0000046E 4EB8022C        	   602:     JSR     UART_WriteChar
                            	   603: 
                            	   604: NextAscii:
00:00000472 51CAFFE2        	   605:     DBRA    D2,AsciiLoop
                            	   606: 
00:00000476 103C007C        	   607:     MOVE.B  #'|',D0
00:0000047A 4EB8022C        	   608:     JSR     UART_WriteChar
00:0000047E 103C000D        	   609:     MOVE.B  #13,D0            ; CR
00:00000482 4EB8022C        	   610:     JSR     UART_WriteChar
00:00000486 103C000A        	   611:     MOVE.B  #10,D0            ; LF
00:0000048A 4EB8022C        	   612:     JSR     UART_WriteChar
                            	   613: 
                            	   614: NoEndLine:
                            	   615:     ; Verifica fim do dump
00:0000048E B1C1            	   616:     CMP.L   D1,A0
00:00000490 6300FF76        	   617:     BLS     DumpLoop
                            	   618: 
00:00000494 2F08            	   619:     MOVE.L  A0,-(SP)          ; Salva endereço atual
00:00000496 41F9000003FA    	   620:     LEA     HitAnyKey,A0
00:0000049C 4EB8027C        	   621:     JSR     UART_WriteString
00:000004A0 4EB80246        	   622:     JSR     UART_ReadChar
00:000004A4 B03C001B        	   623:     CMP.B   #$1B,D0
00:000004A8 6706            	   624:     BEQ     .fim
                            	   625: 
00:000004AA 205F            	   626:     MOVE.L  (SP)+,A0          ; Recupera endereço atual
00:000004AC 6000FF50        	   627:     BRA     DUMPLOOPMASTER
