                            	   238: ; ----------------------------------------------------------------------
                            	   239: ; UART_WriteString - Envia string terminada em null para UART
                            	   240: ; Entrada:
                            	   241: ;   A0 = Ponteiro para a string (endereço da string)
                            	   242: ; ----------------------------------------------------------------------
                            	   243: UART_WriteString:
00:000001EA 2F08            	   244:         MOVE.L  A0,-(SP)      ; Preserva D0
00:000001EC 2F00            	   245:         MOVE.L  D0,-(SP)      ; Preserva D0
                            	   246: .WriteLoop:
00:000001EE 1018            	   247:         MOVE.B  (A0)+,D0      ; Pega caractere
00:000001F0 6706            	   248:         BEQ     .Done
00:000001F2 4EB8019A        	   249:         JSR     UART_WriteChar ; Use sua rotine existente
00:000001F6 60F6            	   250:         BRA     .WriteLoop
                            	   251: .Done:
00:000001F8 201F            	   252:         MOVE.L  (SP)+,D0
00:000001FA 205F            	   253:         MOVE.L  (SP)+,A0
00:000001FC 4E75            	   254:         RTS
