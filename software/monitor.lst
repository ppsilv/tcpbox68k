00:00000676 4E75            	   871:         RTS
                            	   872: ;---------------------------------------------------------------------
                            	   873: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   874: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   875: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   876: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   877: ;---------------------------------------------------------------------
                            	   878: MontaAddress:
00:00000678 48E73C80        	   879:         MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   880: 
                            	   881:         ; Verifica se há pelo menos 8 bytes no buffer
00:0000067C 323900081022    	   882:         MOVE.W  BUFFER_COUNT,D1
00:00000682 B27C0008        	   883:         CMP.W   #8,D1
00:00000686 6D38            	   884:         BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   885: 
00:00000688 41F900081024    	   886:         LEA     BUFFER,A0      ; A0 = base do buffer
00:0000068E 24390008101E    	   887:         MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000694 7000            	   888:         CLR.L   D0                ; Zera D0 (resultado final)
00:00000696 7607            	   889:         MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   890: 
                            	   891: .ReadLoop:
00:00000698 18302800        	   892:         MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:0000069C 0204000F        	   893:         ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   894: 
                            	   895:         ; Desloca e insere os 4 bits em D0
00:000006A0 E988            	   896:         LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:000006A2 8004            	   897:         OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   898: 
                            	   899:         ; Atualiza tail (circular)
00:000006A4 5282            	   900:         ADDQ.L  #1,D2
00:000006A6 0282000000FF    	   901:         ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   902: 
00:000006AC 51CBFFEA        	   903:         DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   904: 
                            	   905:         ; Atualiza ponteiros globais
00:000006B0 23C20008101E    	   906:         MOVE.L  D2,BUFFER_TAIL
00:000006B6 517900081022    	   907:         SUB.W   #8,BUFFER_COUNT
                            	   908: 
00:000006BC 7200            	   909:         MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000006BE 6004            	   910:         BRA     .Exit
                            	   911: 
                            	   912: .BufferUnderrun:
00:000006C0 72FF            	   913:         MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006C2 7000            	   914:         MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   915: 
