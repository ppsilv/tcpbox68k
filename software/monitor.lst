01:00001594 B03C000D        	   815:         CMP.B   #13,D0
01:00001598 670C            	   816:         BEQ     .Done
01:0000159A B03C000A        	   817:         CMP.B   #10,D0
01:0000159E 6706            	   818:         BEQ     .Done
