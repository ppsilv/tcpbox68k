01:00001554 41F900000379    	   784:         LEA     NO_PROGRAM_TO_RUN,A0
01:0000155A 4EB8126C        	   785:         JSR     UART_WriteString
01:0000155E 6000FB54        	   786:         BRA     MenuLoop
