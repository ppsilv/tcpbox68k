00:000001D6 207900081010    	   228:         MOVE.L  CurrentUART,A0
                            	   229: .WaitRx:
00:000001DC 08280000000A    	   230:         BTST    #0,LSR(A0)        ; RX ready?
00:000001E2 67F8            	   231:         BEQ     .WaitRx
                            	   232: 
00:000001E4 1010            	   233:         MOVE.B  RHR(A0),D0
00:000001E6 205F            	   234:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   235: 
00:000001E8 4E75            	   236:         RTS
