                            	   839: ; Lê número hexadecimal (retorna em D0)
                            	   840: UART_ReadHex:
01:000015C4 2F01            	   841:         MOVE.L  D1,-(SP)
01:000015C6 2F02            	   842:         MOVE.L  D2,-(SP)
                            	   843: 
01:000015C8 7000            	   844:         MOVEQ   #0,D0
01:000015CA 721C            	   845:         MOVEQ   #28,D1            ; Máximo 8 dígitos
01:000015CC 7400            	   846:         MOVEQ   #0,D2            ; Resultado em D2
                            	   847: .Loop:
01:000015CE 7000            	   848:         CLR.L   D0
01:000015D0 4EB81236        	   849:         JSR     UART_ReadChar
01:000015D4 B03C000D        	   850:         CMP.B   #13,D0
01:000015D8 674C            	   851:         BEQ     .Done
01:000015DA B03C000A        	   852:         CMP.B   #10,D0
01:000015DE 6746            	   853:         BEQ     .Done
                            	   854:         ;Tratando os numeros
01:000015E0 B03C0030        	   855:         CMP.B   #'0',D0
01:000015E4 6C02            	   856:         BGE     .maiorQueZero
01:000015E6 60E6            	   857:         BRA     .Loop
                            	   858: .maiorQueZero:
01:000015E8 B03C0039        	   859:         CMP.B   #'9',D0
01:000015EC 6F10            	   860:         BLE     .isdigit
                            	   861:         ;Tratando as letras
01:000015EE B03C0041        	   862:         CMP.B   #'A',D0
01:000015F2 6C02            	   863:         BGE     .maiorQueA
01:000015F4 60D8            	   864:         BRA     .Loop
                            	   865: .maiorQueA:
01:000015F6 B03C0046        	   866:         CMP.B   #'F',D0
01:000015FA 6F16            	   867:         BLE     .isletter
01:000015FC 60D0            	   868:         BRA     .Loop
                            	   869: .isdigit:
01:000015FE 903C0030        	   870:         SUB.B   #'0',D0
01:00001602 E3A8            	   871:         LSL.L   D1,D0
01:00001604 5901            	   872:         SUB.B   #4,D1
01:00001606 8480            	   873:         OR.L    D0,D2
01:00001608 41F90008101E    	   874:         LEA     addressInHex,A0
01:0000160E 2082            	   875:         MOVE.L  D2,(A0)
01:00001610 60BC            	   876:         BRA     .Loop
                            	   877: .isletter:
01:00001612 903C0037        	   878:         SUB.B   #$37,D0
01:00001616 E3A8            	   879:         LSL.L   D1,D0
01:00001618 5901            	   880:         SUB.B   #4,D1
01:0000161A 8480            	   881:         OR.L    D0,D2
01:0000161C 41F90008101E    	   882:         LEA     addressInHex,A0
01:00001622 2082            	   883:         MOVE.L  D2,(A0)
01:00001624 60A8            	   884:         BRA     .Loop
                            	   885: .Done:
01:00001626 4EB8130C        	   886:         JSR     new_line
01:0000162A 41F90008101E    	   887:         LEA     addressInHex,A0
01:00001630 2010            	   888:         MOVE.L  (A0),D0
01:00001632 4EB8148A        	   889:         JSR     PrintHexAddress
01:00001636 4EB8130C        	   890:         JSR     new_line
01:0000163A 241F            	   891:         MOVE.L  (SP)+,D2
01:0000163C 221F            	   892:         MOVE.L  (SP)+,D1
