00:000005A4 4EB805B0        	   793:     JSR     UART_ReadByte
00:000005A8 8000            	   794:     OR.B    D0,D0            ; Combina com novo byte
00:000005AA 51C9FFF6        	   795:     DBF     D1,.Loop
00:000005AE 4E75            	   796:     RTS
                            	   797: 
                            	   798: ; Lê byte hexadecimal (2 caracteres ASCII)
