                            	   866: ;--------------------------------------------------
                            	   867: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   868: ;--------------------------------------------------
                            	   869: ;Exemplo: Lendo byte do buffer
                            	   870: ;         BSR     UART_BufferGet
                            	   871: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   872: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   873: ;         Senão, D0 contém o byte lido!
                            	   874: BufferGet:
00:0000067C 2F01            	   875:         MOVE.L  D1,-(SP)
00:0000067E 2F08            	   876:         MOVE.L  A0,-(SP)
                            	   877: 
00:00000680 32390008102A    	   878:         MOVE.W  BUFFER_COUNT,D1
00:00000686 6724            	   879:         BEQ     .BufferEmpty
                            	   880: 
00:00000688 41F90008102C    	   881:         LEA     BUFFER,A0
