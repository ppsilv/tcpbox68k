00:000002E8 6148            	   389:     BSR     Div32x16
                            	   390: ;5
00:000002EA 2F00            	   391:     move.l  d0,-(SP)
00:000002EC 4EB804B4        	   392:     jsr     PrintHexAddress
00:000002F0 4EB8031C        	   393:     jsr     new_line
00:000002F4 201F            	   394:     move.l  (SP)+,d0
                            	   395: 
                            	   396:     ; 4. Separa parte alta/baixa corretamente
00:000002F6 3200            	   397:     MOVE.W  D0,D1
00:000002F8 024000FF        	   398:     ANDI.W  #$FF,D0        ; D0 = BAUD_DIV_L (8 bits baixos)
00:000002FC E049            	   399:     LSR.W   #8,D1          ; D1 = BAUD_DIV_H (8 bits altos)
00:000002FE 024100FF        	   400:     ANDI.W  #$FF,D1        ; Limpa bits extras
                            	   401: 
                            	   402:     ; 5. Armazena (AGORA COM 16 BITS, NÃO 32!)
00:00000302 41F900081012    	   403:     LEA     Baud1DivL,A0
00:00000308 3080            	   404:     MOVE.W  D0,(A0)        ; 16 bits suficientes
00:0000030A 41F900081014    	   405:     LEA     Baud1DivH,A0
00:00000310 3081            	   406:     MOVE.W  D1,(A0)
                            	   407: 
