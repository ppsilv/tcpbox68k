00:000005C8 B03C0041        	   812:     CMP.B   #'A',D0
00:000005CC 6D02            	   813:     BLT     .Digit
00:000005CE 5F00            	   814:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   815: .Digit:
00:000005D0 903C0030        	   816:     SUB.B   #'0',D0
