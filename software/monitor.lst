                            	   602: ; ----------------------------------------------------------------------
                            	   603: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   604: ; Entrada: D0 = endereço
                            	   605: ; ----------------------------------------------------------------------
                            	   606: PrintHexAddress:
00:00000472 4840            	   607:     SWAP    D0                ; Imprime parte alta primeiro
00:00000474 4EB8047A        	   608:     JSR     PrintWordHex
00:00000478 4840            	   609:     SWAP    D0                ; Parte baixa
                            	   610:     ; Continua para PrintWordHex
                            	   611: 
                            	   612: ; ----------------------------------------------------------------------
                            	   613: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   614: ; Entrada: D0.w = valor
                            	   615: ; ----------------------------------------------------------------------
                            	   616: PrintWordHex:
00:0000047A E158            	   617:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:0000047C 4EB80482        	   618:     JSR     PrintByteHex
00:00000480 E058            	   619:     ROR.W   #8,D0             ; Byte menos significativo
                            	   620:     ; Continua para PrintByteHex
                            	   621: 
                            	   622: ; ----------------------------------------------------------------------
                            	   623: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   624: ; Entrada: D0.b = valor
                            	   625: ; ----------------------------------------------------------------------
                            	   626: PrintByteHex:
00:00000482 1F00            	   627:     MOVE.B  D0,-(SP)          ; Salva byte original
00:00000484 E808            	   628:     LSR.B   #4,D0             ; Nibble alto
00:00000486 6106            	   629:     BSR     PrintNibble
00:00000488 101F            	   630:     MOVE.B  (SP)+,D0          ; Recupera byte
00:0000048A 0200000F        	   631:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   632:     ; Continua para PrintNibble
                            	   633: ; ----------------------------------------------------------------------
                            	   634: ; PrintNibble - Imprime um nibble em hex
                            	   635: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   636: ; ----------------------------------------------------------------------
                            	   637: PrintNibble:
00:0000048E B03C0009        	   638:     CMP.B   #9,D0
00:00000492 6302            	   639:     BLS     .Decimal
00:00000494 5E00            	   640:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   641: .Decimal:
00:00000496 D03C0030        	   642:     ADD.B   #'0',D0
00:0000049A 4EF801EA        	   643:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   644: 
                            	   645: ClearRAM:
00:0000049E 41F900080000    	   646:     LEA     $80000,A0
00:000004A4 43F90008FFFF    	   647:     LEA     $8FFFF,A1
00:000004AA 7000            	   648:     MOVEQ   #0,D0
                            	   649: .ClearLoop:
00:000004AC 20C0            	   650:     MOVE.L  D0,(A0)+
00:000004AE B3C8            	   651:     CMPA.L  A0,A1
00:000004B0 62FA            	   652:     BHI     .ClearLoop
00:000004B2 4E75            	   653:     RTS
                            	   654: ; ----------------------------------------------------------------------
                            	   655: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   656: ; ----------------------------------------------------------------------
                            	   657: ClearRAM1:
00:000004B4 41F900080000    	   658:     LEA     $80000,A0        ; Endereço inicial da RAM
00:000004BA 43F900100000    	   659:     LEA     $100000,A1       ; Endereço final + 1
00:000004C0 7000            	   660:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   661: 
                            	   662:     ; Calcula tamanho em bytes (já alinhado para longs)
00:000004C2 2209            	   663:     MOVE.L  A1,D1
00:000004C4 9288            	   664:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   665: 
                            	   666:     ; Otimização: escreve longs (32 bits) quando possível
00:000004C6 2401            	   667:     MOVE.L  D1,D2
00:000004C8 028200000003    	   668:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:000004CE 670C            	   669:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   670: 
                            	   671:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:000004D0 5382            	   672:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   673: .ResidualLoop:
00:000004D2 10C0            	   674:     MOVE.B  D0,(A0)+
00:000004D4 51CAFFFC        	   675:     DBRA    D2,.ResidualLoop
                            	   676: 
                            	   677:     ; Atualiza tamanho restante
00:000004D8 9282            	   678:     SUB.L   D2,D1
00:000004DA 5381            	   679:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   680: 
                            	   681: .ClearLongs:
00:000004DC E489            	   682:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:000004DE 5381            	   683:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   684: 
                            	   685: .LongLoop:
00:000004E0 20C0            	   686:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:000004E2 51C9FFFC        	   687:     DBRA    D1,.LongLoop
00:000004E6 4E75            	   688:     RTS
