                            	   934: ; XMODEM RECEIVER ROUTINE
                            	   935: ; =====================================================================
                            	   936: XMODEM_Receive:
00:000006AC 48E73FFE        	   937:                 MOVEM.L D2-D7/A0-A6,-(SP)
00:000006B0 41F9000815A4    	   938:                 LEA     xmodem_buffer,A0
                            	   939: 
                            	   940:                 ; ---- 1. INICIALIZAÇÃO ----
00:000006B6 103C0015        	   941:                 MOVE.B  #NAK,D0
00:000006BA 4EB8013A        	   942:                 JSR     UART_WriteChar      ; Solicita início
                            	   943: 
                            	   944:                 ; ---- 2. LOOP PRINCIPAL ----
                            	   945: Receive_Loop:
00:000006BE 4EB80154        	   946:                 JSR     UART_ReadChar
00:000006C2 B03C0004        	   947:                 CMP.B   #EOT,D0
00:000006C6 67000088        	   948:                 BEQ     Transfer_Complete   ; Fim da transmissão
                            	   949: 
00:000006CA B03C0001        	   950:                 CMP.B   #SOH,D0
00:000006CE 66EE            	   951:                 BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   952: 
                            	   953:                 ; ---- 3. RECEBE HEADER ----
00:000006D0 4EB80154        	   954:                 JSR     UART_ReadChar       ; Block number
00:000006D4 13C000081624    	   955:                 MOVE.B  D0,block_number
00:000006DA 4EB80154        	   956:                 JSR     UART_ReadChar       ; ~Block number (complemento)
                            	   957: 
                            	   958:                 ; ---- 4. RECEBE DADOS ----
00:000006DE 323C007F        	   959:                 MOVE.W  #127,D1             ; 128 bytes (0-based)
00:000006E2 43F9000815A4    	   960:                 LEA     xmodem_buffer,A1
                            	   961: 
                            	   962: Receive_Data:
00:000006E8 4EB80154        	   963:                 JSR     UART_ReadChar
00:000006EC 12C0            	   964:                 MOVE.B  D0,(A1)+
00:000006EE 51C9FFF8        	   965:                 DBF     D1,Receive_Data
                            	   966: 
                            	   967:                 ; ---- 5. VERIFICA CHECKSUM ----
00:000006F2 4EB80154        	   968:                 JSR     UART_ReadChar       ; Checksum
00:000006F6 1400            	   969:                 MOVE.B  D0,D2
                            	   970: 
                            	   971:                 ; Calcula checksum local
00:000006F8 43F9000815A4    	   972:                 LEA     xmodem_buffer,A1
00:000006FE 323C007F        	   973:                 MOVE.W  #127,D1
00:00000702 4203            	   974:                 CLR.B   D3
                            	   975: 
                            	   976: Calc_Checksum:
00:00000704 D619            	   977:                 ADD.B   (A1)+,D3
00:00000706 51C9FFFC        	   978:                 DBF     D1,Calc_Checksum
                            	   979: 
00:0000070A B602            	   980:                 CMP.B   D2,D3
00:0000070C 6636            	   981:                 BNE     Send_NAK            ; Erro no checksum
                            	   982: 
                            	   983:                 ; ---- 6. VALIDA NÚMERO DO BLOCO ----
00:0000070E 103900081624    	   984:                 MOVE.B  block_number,D0
00:00000714 B03900081625    	   985:                 CMP.B   expected_block,D0
00:0000071A 6628            	   986:                 BNE     Send_NAK            ; Bloco fora de ordem
                            	   987: 
                            	   988:                 ; ---- 7. COPIA DADOS VÁLIDOS ----
                            	   989:                 ; (Aqui você processa os 128 bytes recebidos)
                            	   990:                 ; Exemplo: copiar para RAM/Flash
00:0000071C 43F9000815A4    	   991:                 LEA     xmodem_buffer,A1
00:00000722 247900081524    	   992:                 MOVE.L  user_buffer_ptr,A2  ; Defina isso antes de chamar
00:00000728 323C007F        	   993:                 MOVE.W  #127,D1
                            	   994: Copy_Data:
00:0000072C 14D9            	   995:                 MOVE.B  (A1)+,(A2)+
00:0000072E 51C9FFFC        	   996:                 DBF     D1,Copy_Data
                            	   997: 
                            	   998:                 ; ---- 8. CONFIMA RECEPÇÃO ----
00:00000732 523900081625    	   999:                 ADDQ.B  #1,expected_block   ; Próximo bloco
00:00000738 103C0006        	  1000:                 MOVE.B  #ACK,D0
00:0000073C 4EB8013A        	  1001:                 JSR     UART_WriteChar
00:00000740 6000FF7C        	  1002:                 BRA     Receive_Loop
                            	  1003: 
                            	  1004: Send_NAK:
00:00000744 103C0015        	  1005:                 MOVE.B  #NAK,D0
00:00000748 4EB8013A        	  1006:                 JSR     UART_WriteChar
00:0000074C 6000FF70        	  1007:                 BRA     Receive_Loop
                            	  1008: 
                            	  1009: Transfer_Complete:
00:00000750 103C0006        	  1010:                 MOVE.B  #ACK,D0             ; Confirma EOT
00:00000754 4EB8013A        	  1011:                 JSR     UART_WriteChar
00:00000758 4CDF7FFC        	  1012:                 MOVEM.L (SP)+,D2-D7/A0-A6
00:0000075C 4E75            	  1013:                 RTS
                            	  1014: 
00:0000075E 4D45524441205445	  1015:     DC.B "MERDA TERMINA"
00:00000766 524D494E41
