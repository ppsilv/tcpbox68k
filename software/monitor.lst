                            	   664: 
                            	   665: .Loop:
00:000004D4 4EB8018C        	   666:         JSR     UART_ReadChar
00:000004D8 B03C000D        	   667:         CMP.B   #13,D0
00:000004DC 670C            	   668:         BEQ     .Done
