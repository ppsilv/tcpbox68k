                            	   765: ; Lê 4 bytes (32 bits) via UART
                            	   766: UART_ReadLong:
00:0000056A 7000            	   767:     MOVEQ   #0,D0
00:0000056C 7203            	   768:     MOVEQ   #3,D1            ; 4 bytes a ler
                            	   769: .Loop:
00:0000056E E188            	   770:     LSL.L   #8,D0            ; Desloca resultado atual
00:00000570 4EB8057C        	   771:     JSR     UART_ReadByte
00:00000574 8000            	   772:     OR.B    D0,D0            ; Combina com novo byte
00:00000576 51C9FFF6        	   773:     DBF     D1,.Loop
00:0000057A 4E75            	   774:     RTS
                            	   775: 
                            	   776: ; Lê byte hexadecimal (2 caracteres ASCII)
                            	   777: UART_ReadByte:
00:0000057C 2F00            	   778:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000057E 4EB80590        	   779:     JSR     UART_ReadHexNibble
00:00000582 E908            	   780:     LSL.B   #4,D0
00:00000584 1200            	   781:     MOVE.B  D0,D1
00:00000586 4EB80590        	   782:     JSR     UART_ReadHexNibble
00:0000058A 8001            	   783:     OR.B    D1,D0
00:0000058C 201F            	   784:     MOVE.L  (SP)+,D0        ; Recupera D0
00:0000058E 4E75            	   785:     RTS
                            	   786: 
                            	   787: ; Lê meio-byte hexadecimal
                            	   788: UART_ReadHexNibble:
00:00000590 4EB80154        	   789:     JSR     UART_ReadChar
00:00000594 B03C0041        	   790:     CMP.B   #'A',D0
00:00000598 6D02            	   791:     BLT     .Digit
00:0000059A 5F00            	   792:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   793: .Digit:
00:0000059C 903C0030        	   794:     SUB.B   #'0',D0
00:000005A0 C03C000F        	   795:     AND.B   #$0F,D0
00:000005A4 4E75            	   796:     RTS
                            	   797: 
                            	   798: ;--------------------------------------------------
                            	   799: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   800: ;--------------------------------------------------
                            	   801: ; Exemplo: insere 'A' no buffer
                            	   802: ;          MOVE.B  #'A',D0
                            	   803: ;          JSR     UART_BufferPut
                            	   804: 
                            	   805: BufferPut:
00:000005A6 2F01            	   806:     MOVE.L  D1,-(SP)
00:000005A8 2F08            	   807:     MOVE.L  A0,-(SP)
                            	   808: 
                            	   809:     ;ANDI.W    #$FF00,D0
00:000005AA 41F900081024    	   810:     LEA     BUFFER,A0
00:000005B0 323900081022    	   811:     MOVE.W  BUFFER_COUNT,D1
                            	   812: 
00:000005B6 B27C0100        	   813:     CMP.W   #256,D1
00:000005BA 6C1C            	   814:     BGE     .BufferFull
                            	   815: 
                            	   816:     ; Modificado para usar deslocamento de 16 bits
00:000005BC 32390008101A    	   817:     MOVE.W  BUFFER_HEAD,D1
00:000005C2 D0C1            	   818:     ADD     D1,A0
00:000005C4 1080            	   819:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   820: 
00:000005C6 5441            	   821:     ADD     #2,D1              ; Incrementa como word
00:000005C8 024100FF        	   822:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005CC 33C10008101A    	   823:     MOVE.W  D1,BUFFER_HEAD
                            	   824: 
00:000005D2 527900081022    	   825:     ADDQ.W  #1,BUFFER_COUNT
                            	   826: 
                            	   827: .BufferFull:
00:000005D8 205F            	   828:     MOVE.L  (SP)+,A0
00:000005DA 221F            	   829:     MOVE.L  (SP)+,D1
                            	   830: 
00:000005DC 4E75            	   831:     RTS
                            	   832: 
                            	   833: ;--------------------------------------------------
                            	   834: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   835: ;--------------------------------------------------
                            	   836: ;Exemplo: Lendo byte do buffer
                            	   837: ;         BSR     UART_BufferGet
                            	   838: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   839: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   840: ;         Senão, D0 contém o byte lido!
                            	   841: BufferGet:
00:000005DE 2F01            	   842:     MOVE.L  D1,-(SP)
00:000005E0 2F08            	   843:     MOVE.L  A0,-(SP)
                            	   844: 
00:000005E2 323900081022    	   845:     MOVE.W  BUFFER_COUNT,D1
00:000005E8 6724            	   846:     BEQ     .BufferEmpty
                            	   847: 
00:000005EA 41F900081024    	   848:     LEA     BUFFER,A0
                            	   849: 
                            	   850:     ; Modificado para usar deslocamento de 16 bits
00:000005F0 32390008101E    	   851:     MOVE.W  BUFFER_TAIL,D1
00:000005F6 10301000        	   852:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   853: 
00:000005FA 5401            	   854:     ADDQ.B  #2,D1              ; Incrementa como word
00:000005FC 024100FF        	   855:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000600 33C10008101E    	   856:     MOVE.W  D1,BUFFER_TAIL
                            	   857: 
00:00000606 537900081022    	   858:     SUBQ.W  #1,BUFFER_COUNT
00:0000060C 6006            	   859:     BRA     .Exit
                            	   860: 
                            	   861: .BufferEmpty:
00:0000060E 4EB8061A        	   862:     JSR     FBufferEmpty
00:00000612 70FF            	   863:     MOVEQ   #-1,D0
                            	   864: .Exit:
00:00000614 205F            	   865:     MOVE.L  (SP)+,A0
00:00000616 221F            	   866:     MOVE.L  (SP)+,D1
00:00000618 4E75            	   867:     RTS
                            	   868: 
                            	   869: FBufferEmpty:
00:0000061A 4EB8020E        	   870:         JSR     new_line
00:0000061E 41F90000036A    	   871:         LEA     BufferEmpty,A0
00:00000624 4EB8016E        	   872:         JSR     UART_WriteString
00:00000628 4EB8020E        	   873:         JSR     new_line
00:0000062C 4E75            	   874:         RTS
                            	   875: ;---------------------------------------------------------------------
                            	   876: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   877: ;---------------------------------------------------------------------
                            	   878: ClearBufferPointers:
00:0000062E 23FC000000000008	   879:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000636 101A
00:00000638 23FC000000000008	   880:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000640 101E
00:00000642 33FC000000081022	   881:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:0000064A 4E75            	   882:     RTS
                            	   883: ;---------------------------------------------------------------------
                            	   884: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   885: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   886: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   887: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   888: ;---------------------------------------------------------------------
                            	   889: MontaAddress:
00:0000064C 48E73C80        	   890:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   891: 
                            	   892:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000650 323900081022    	   893:     MOVE.W  BUFFER_COUNT,D1
00:00000656 B27C0008        	   894:     CMP.W   #8,D1
00:0000065A 6D38            	   895:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   896: 
00:0000065C 41F900081024    	   897:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000662 24390008101E    	   898:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:00000668 7000            	   899:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000066A 7607            	   900:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   901: 
                            	   902: .ReadLoop:
00:0000066C 18302800        	   903:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000670 0204000F        	   904:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   905: 
                            	   906:     ; Desloca e insere os 4 bits em D0
00:00000674 E988            	   907:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:00000676 8004            	   908:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   909: 
                            	   910:     ; Atualiza tail (circular)
00:00000678 5282            	   911:     ADDQ.L  #1,D2
00:0000067A 0282000000FF    	   912:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   913: 
00:00000680 51CBFFEA        	   914:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   915: 
                            	   916:     ; Atualiza ponteiros globais
00:00000684 23C20008101E    	   917:     MOVE.L  D2,BUFFER_TAIL
00:0000068A 517900081022    	   918:     SUB.W   #8,BUFFER_COUNT
                            	   919: 
00:00000690 7200            	   920:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000692 6004            	   921:     BRA     .Exit
                            	   922: 
                            	   923: .BufferUnderrun:
00:00000694 72FF            	   924:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:00000696 7000            	   925:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   926: 
                            	   927: .Exit:
00:00000698 4CDF013C        	   928:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:0000069C 4E75            	   929:     RTS
