00:000005D4 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
00:000005DC 6714            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
00:000005DE E908            	   793:         LSL.B   #4,D0
00:000005E0 1200            	   794:         MOVE.B  D0,D1
00:000005E2 4EB805F4        	   795:         JSR     UART_ReadHexNibble
                            	   796:         TST_FLAG_SET FL_ESC,.Fim            ; Testa o bit 0 (Z=0 se setado)
00:000005E6 0839000000081935	     1M     BTST    #FL_ESC,minhas_flags  ; Testa o bit FL_ESC
00:000005EE 6702            	     2M     BEQ     .Fim                ; Se bit = 0 (Z=1), pula para o rótulo .Fim
