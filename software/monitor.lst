                            	   967: ; =====================================================================
                            	   968: XMODEM_Receive:
00:0000073C 48E73FFE        	   969:        MOVEM.L D2-D7/A0-A6,-(SP)
                            	   970:        ; Inicializa variáveis
00:00000740 41F90008132D    	   971:        LEA     expected_block,A0
00:00000746 103C0001        	   972:        MOVE.B  #1,D0
00:0000074A 1080            	   973:        MOVE.B  D0,(A0)             ; Bloco esperado (0)
00:0000074C 41F90008112C    	   974:        LEA     xmodem_buffer,A0
                            	   975: 
00:00000752 41F900081934    	   976:        LEA     flag_pgm_loaded,A0   ; Get flag program loaded
00:00000758 103C0000        	   977:        MOVE.B  #0,D0
00:0000075C 1080            	   978:        MOVE.B  D0,(A0)              ; Program not loaded
                            	   979: 
                            	   980:        ; ---- 1. INICIALIZAÇÃO ----
00:0000075E 103C0015        	   981:        MOVE.B  #NAK,D0
00:00000762 4EB8019A        	   982:        JSR     UART_WriteChar      ; Solicita início
                            	   983: 
                            	   984:        ;SINALIZA NACK SENT
00:00000766 303C0800        	   985:        MOVE.W  #$0800,D0
00:0000076A 4EB8012E        	   986:        JSR     __write_leds
                            	   987: 
                            	   988:        ; ---- 2. LOOP PRINCIPAL ----
                            	   989: Receive_Loop:
00:0000076E 4EB801D4        	   990:        JSR     UART_ReadCharNonEcho
                            	   991: 
00:00000772 B03C0004        	   992:        CMP.B   #EOT,D0
00:00000776 670000B0        	   993:        BEQ     Transfer_Complete   ; Fim da transmissão
                            	   994: 
00:0000077A B03C0001        	   995:        CMP.B   #SOH,D0
00:0000077E 66EE            	   996:        BNE     Receive_Loop        ; Ignora bytes inválidos
                            	   997: 
                            	   998:        ;SINALIZA leds
00:00000780 303C0C00        	   999:        MOVE.W  #$0C00,D0
00:00000784 4EB8012E        	  1000:        JSR     __write_leds
                            	  1001: 
                            	  1002:        ; ---- 3. RECEBE HEADER ----
00:00000788 4EB801D4        	  1003:        JSR     UART_ReadCharNonEcho       ; Block number
00:0000078C 13C00008132C    	  1004:        MOVE.B  D0,block_number
                            	  1005: 
00:00000792 4EB801D4        	  1006:        JSR     UART_ReadCharNonEcho       ; ~Block number (complemento)
                            	  1007: 
                            	  1008:        ;SINALIZA leds
00:00000796 303C0800        	  1009:        MOVE.W  #$0800,D0
00:0000079A 4EB8012E        	  1010:        JSR     __write_leds
                            	  1011: 
                            	  1012:        ; ---- 4. RECEBE DADOS ----
00:0000079E 7220            	  1013:        MOVE.L  #128/4,D1        ; 32 longs (128 bytes)
00:000007A0 43F90008112C    	  1014:        LEA     xmodem_buffer,A1
                            	  1015: Read_Loop:
                            	  1016:        ; Lê 4 bytes da UART e armazena em D0 (usando shifts/ORs)
00:000007A6 4EB801D4        	  1017:        JSR     UART_ReadCharNonEcho    ; Byte 1 (bits 24-31)
00:000007AA E188            	  1018:        LSL.L   #8,D0
00:000007AC 4EB801D4        	  1019:        JSR     UART_ReadCharNonEcho    ; Byte 2 (bits 16-23)
00:000007B0 E188            	  1020:        LSL.L   #8,D0
00:000007B2 4EB801D4        	  1021:        JSR     UART_ReadCharNonEcho    ; Byte 3 (bits 8-15)
00:000007B6 E188            	  1022:        LSL.L   #8,D0
00:000007B8 4EB801D4        	  1023:        JSR     UART_ReadCharNonEcho    ; Byte 4 (bits 0-7)
00:000007BC 22C0            	  1024:        MOVE.L  D0,(A1)+         ; Grava os 4 bytes
00:000007BE 5381            	  1025:        SUBQ.L  #1,D1
00:000007C0 66E4            	  1026:        BNE     Read_Loop
                            	  1027: 
00:000007C2 303C0600        	  1028:        MOVE.W  #$0600,D0
00:000007C6 4EB8012E        	  1029:        JSR     __write_leds
                            	  1030: 
                            	  1031:        ; ---- 5. VERIFICA CHECKSUM ----
00:000007CA 4EB801D4        	  1032:        JSR     UART_ReadCharNonEcho       ; Checksum
00:000007CE 1400            	  1033:        MOVE.B  D0,D2
