                            	  1021:         ; (Aqui você processa os 128 bytes recebidos)
                            	  1022:         ; Exemplo: copiar do buffer para a RAM
                            	  1023:         ; 1. Copia os 128 bytes do XMODEM para o buffer destino
00:0000076C 43F900081124    	  1024:         LEA     xmodem_buffer,A1     ; Origem (128 bytes)
00:00000772 247900081326    	  1025:         MOVE.L  usr_buffer_addr,A2   ; Destino (garanta alinhamento em 4 bytes)
00:00000778 7220            	  1026:         MOVE.L  #32,D1              ; 32 longs = 128 bytes (contador exato)
                            	  1027: Copy_Data:
00:0000077A 24D9            	  1028:         MOVE.L  (A1)+,(A2)+         ; Copia 4 bytes por vez
00:0000077C 5381            	  1029:         SUBQ.L  #1,D1               ; Decrementa contador
00:0000077E 66FA            	  1030:         BNE     Copy_Data            ; Repete até D1 = 0
                            	  1031:         ; 2. Atualiza usr_buffer_addr para o próximo bloco (+128 bytes)
00:00000780 203900081326    	  1032:         MOVE.L  usr_buffer_addr,D0
00:00000786 068000000080    	  1033:         ADDI.L  #128,D0
00:0000078C 23C000081326    	  1034:         MOVE.L  D0,usr_buffer_addr
