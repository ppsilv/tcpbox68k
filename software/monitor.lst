00:000001AE 207900081008    	   220:         MOVE.L  CurrentUART,A0
                            	   221: .WaitRx:
00:000001B4 08280000000A    	   222:         BTST    #0,LSR(A0)        ; RX ready?
00:000001BA 67F8            	   223:         BEQ     .WaitRx
                            	   224: 
00:000001BC 1010            	   225:         MOVE.B  RHR(A0),D0
00:000001BE 205F            	   226:         MOVE.L  (SP)+,A0        ;Restaura A0
                            	   227: 
00:000001C0 4E75            	   228:         RTS
