                            	   139: UART_Init:
00:0000010C 227900081008    	   140:     move.l   CurrentUART,a1
00:00000112 137C000D0004    	   141:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:00000118 137C00830006    	   142:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:0000011E 12BC0068        	   143:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000122 137C00000002    	   144:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:00000128 08A900070006    	   145:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:0000012E 4229000E        	   146:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000132 4E75            	   147:     RTS
                            	   148: 
                            	   149:     ; Escreve caractere (D0.B)
                            	   150: UART_WriteChar:
00:00000134 2F08            	   151:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000136 2F00            	   152:     MOVE.L  D0,-(SP)        ; Preserva D0
00:00000138 207900081008    	   153:     move.l   CurrentUART,A0
                            	   154: .WaitTx:
00:0000013E 08280005000A    	   155:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:00000144 67F8            	   156:     BEQ     .WaitTx
00:00000146 1080            	   157:     MOVE.B  D0,THR(A0)      ; transmit byte
00:00000148 201F            	   158:     MOVE.L  (SP)+,D0        ;Restaura D0
00:0000014A 205F            	   159:     MOVE.L  (SP)+,A0        ;Restaura A0
00:0000014C 4E75            	   160:     RTS
                            	   161: 
                            	   162: 
                            	   163: ; Lê caractere (retorna em D0)
                            	   164: UART_ReadChar:
00:0000014E 2F08            	   165:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000150 207900081008    	   166:     move.l   CurrentUART,A0
                            	   167: .WaitRx:
00:00000156 08280000000A    	   168:     BTST    #0,LSR(A0)        ; RX ready?
00:0000015C 67F8            	   169:     BEQ     .WaitRx
00:0000015E 1010            	   170:     MOVE.B  RHR(A0),D0
00:00000160 205F            	   171:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000162 B03C001B        	   172:     CMP.B   #$1b,D0
00:00000166 6704            	   173:     BEQ     .fim
00:00000168 4EB80134        	   174:     JSR     UART_WriteChar
                            	   175: .fim
00:0000016C 4E75            	   176:     RTS
