                            	   132: ; =============================================
                            	   133: ; Delay em milissegundos para MC68000 @ 16MHz
                            	   134: ; Entrada: D0 = tempo em ms (16 bits)
                            	   135: ; Destrói: D0
                            	   136: ; =============================================
                            	   137: Delay_ms:
00:00000112 2F01            	   138:     move.l  d1,-(sp)          ; Salva D1
00:00000114 3200            	   139:     move.w  d0,d1             ; Contador de ms
00:00000116 670E            	   140:     beq.s   .end              ; Se D0=0, sai
                            	   141: .loop_ms:
00:00000118 203C00003E80    	   142:     move.l  #16000,d0         ; Ciclos por ms (16MHz)
                            	   143: .inner_loop:
00:0000011E 5380            	   144:     subq.l  #1,d0             ; 4 ciclos
00:00000120 66FC            	   145:     bne.s   .inner_loop       ; 10 ciclos (se taken)
00:00000122 5341            	   146:     subq.w  #1,d1             ; 1 ms
00:00000124 66F2            	   147:     bne.s   .loop_ms
                            	   148: .end:
00:00000126 221F            	   149:     move.l  (sp)+,d1          ; Restaura D1
00:00000128 4E75            	   150:     rts
