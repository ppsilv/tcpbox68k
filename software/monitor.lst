                            	   594: ; ----------------------------------------------------------------------
                            	   595: ; Subrotinas do Menu
                            	   596: ; ----------------------------------------------------------------------
                            	   597: 
                            	   598: ; 1. Seleciona UART
                            	   599: SelectUART:
00:0000041C 41F90000035C    	   600:     LEA     PromptNotImplemented,A0
00:00000422 4EB8016E        	   601:     JSR     UART_WriteString
                            	   602:     ;LEA     UARTPrompt,A0
                            	   603:     ;JSR     UART_WriteString
                            	   604:     ;JSR     UART_ReadHex        ; Lê endereço da UART
                            	   605:     ;MOVE.L  D0,CurrentUART      ; Atualiza UART atual
                            	   606:     ;JSR     UART_Init           ; Reinicializa UART
00:00000426 4E75            	   607:     RTS
                            	   608: 
                            	   609: ; 2. Configura Baud Rate
                            	   610: SetBaudRate:
00:00000428 41F90000035C    	   611:     LEA     PromptNotImplemented,A0
00:0000042E 4EB8016E        	   612:     JSR     UART_WriteString
                            	   613:     ;LEA     BaudPrompt,A0
                            	   614:     ;JSR     UART_WriteString
                            	   615:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   616:     ;MOVE.L  CurrentUART,A0
                            	   617:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
00:00000432 4E75            	   618:     RTS
                            	   619: 
                            	   620: ; 3. Carrega programa via serial
                            	   621: LoadProgram:
                            	   622: 
00:00000434 41F900081124    	   623:     LEA     DEST_BUFFER,A0   ; Onde os dados serão salvos
00:0000043A 23C800081524    	   624:     MOVE.L  A0,user_buffer_ptr
00:00000440 4EB806AC        	   625:     JSR     XMODEM_Receive
                            	   626: 
00:00000444 4E75            	   627:     RTS
                            	   628: ; 4. Grava programa manualmente (hex)
                            	   629: WriteProgram:
00:00000446 41F900000312    	   630:     LEA     WritePrompt,A0
00:0000044C 4EB8016E        	   631:     JSR     UART_WriteString
00:00000450 4EB804DC        	   632:     JSR     UART_ReadHex        ; Lê endereço
00:00000454 2240            	   633:     MOVE.L  D0,A1               ; A1 = ponteiro
                            	   634: 
00:00000456 41F900000322    	   635:     LEA     WriteSizePrompt,A0
00:0000045C 4EB8016E        	   636:     JSR     UART_WriteString
00:00000460 4EB804DC        	   637:     JSR     UART_ReadHex        ; Lê quantidade de bytes
00:00000464 2200            	   638:     MOVE.L  D0,D1               ; D1 = contador
                            	   639: 
                            	   640: .WriteLoop:
00:00000466 4EB8057C        	   641:     JSR     UART_ReadByte       ; Lê byte
00:0000046A 12C0            	   642:     MOVE.B  D0,(A1)+            ; Armazena
00:0000046C 5381            	   643:     SUBQ.L  #1,D1
00:0000046E 66F6            	   644:     BNE     .WriteLoop
                            	   645: 
00:00000470 41F900000334    	   646:     LEA     WriteDoneMsg,A0
00:00000476 4EB8016E        	   647:     JSR     UART_WriteString
00:0000047A 4E75            	   648:     RTS
                            	   649: 
                            	   650: ; 5. Executa programa na RAM
                            	   651: RunProgram:
00:0000047C 41F90000034E    	   652:     LEA     RunPrompt,A0
00:00000482 4EB8016E        	   653:     JSR     UART_WriteString
00:00000486 4EB804DC        	   654:     JSR     UART_ReadHex        ; Lê endereço
00:0000048A 2040            	   655:     MOVE.L  D0,A0
00:0000048C 4E90            	   656:     JSR     (A0)                ; Chama subrotina
00:0000048E 4E75            	   657:     RTS
