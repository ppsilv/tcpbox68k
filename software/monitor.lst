                            	   894: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   895: ;---------------------------------------------------------------------
                            	   896: ClearBufferPointers:
00:0000068E 23FC000000000008	   897:         MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:00000696 101A
00:00000698 23FC000000000008	   898:         MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000006A0 101E
