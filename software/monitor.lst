                            	   181: TESTE_BUFFER:
00:0000016E 323C0040        	   182:     MOVE.W  #128/2,D1        ; 32 iterações (128 bytes / 4 bytes por long)
00:00000172 43F900081124    	   183:     LEA     xmodem_buffer,A1
00:00000178 303C0101        	   184:     MOVE.W  #$0101,D0    ; Valor inicial
                            	   185: .Loop:
00:0000017C 32C0            	   186:     MOVE.W  D0,(A1)+
00:0000017E D07C0101        	   187:     ADD.W   #$0101,D0    ; Incrementa cada byte do long
00:00000182 5341            	   188:     SUBQ.W  #1,D1
00:00000184 66F6            	   189:     BNE     .Loop
                            	   190: 
                            	   191: TESTE_BUFFER2:
00:00000186 7240D241        	   192:     MOVE.L  #$00000080,D1        ; 32 iterações (128 bytes / 4 bytes por long)
00:0000018A 43F900081124    	   193:     LEA     xmodem_buffer,A1
00:00000190 7001            	   194:     MOVE.L  #$00000001,D0    ; Valor inicial
                            	   195: .Loop:
00:00000192 12C0            	   196:     MOVE.B  D0,(A1)+
00:00000194 5200            	   197:     ADD.B   #$01,D0    ; Incrementa cada byte do long
00:00000196 5301            	   198:     SUBQ.B  #1,D1
00:00000198 66F8            	   199:     BNE     .Loop
                            	   200: 
                            	   201: TESTE_BUFFER3:
                            	   202:     ALIGN   2
00:0000019C 41F900082000    	   203:     LEA     $82000,A0
00:000001A2 43F90008FFFF    	   204:     LEA     $8FFFF,A1
00:000001A8 7000            	   205:     MOVEQ   #0,D0
                            	   206: .ClearLoop:
00:000001AA D07C0101        	   207:     ADD.W   #$0101,D0
00:000001AE 30C0            	   208:     MOVE.W  D0,(A0)+
00:000001B0 B3C8            	   209:     CMPA.L  A0,A1
00:000001B2 62F6            	   210:     BHI     .ClearLoop
00:000001B4 6000FECE        	   211:     BRA     MenuLoop
                            	   212: 
                            	   213: TESTE_BUFFER4:
