                            	   888: ;---------------------------------------------------------------------
                            	   889: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   890: ;---------------------------------------------------------------------
                            	   891: ClearBufferPointers:
00:00000652 23FC000000000008	   892:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:0000065A 101A
00:0000065C 23FC000000000008	   893:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:00000664 101E
00:00000666 33FC000000081022	   894:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:0000066E 4E75            	   895:     RTS
                            	   896: ;---------------------------------------------------------------------
                            	   897: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   898: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   899: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   900: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   901: ;---------------------------------------------------------------------
                            	   902: MontaAddress:
00:00000670 48E73C80        	   903:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   904: 
                            	   905:     ; Verifica se há pelo menos 8 bytes no buffer
00:00000674 323900081022    	   906:     MOVE.W  BUFFER_COUNT,D1
00:0000067A B27C0008        	   907:     CMP.W   #8,D1
00:0000067E 6D38            	   908:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   909: 
00:00000680 41F900081024    	   910:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000686 24390008101E    	   911:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000068C 7000            	   912:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000068E 7607            	   913:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   914: 
                            	   915: .ReadLoop:
00:00000690 18302800        	   916:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000694 0204000F        	   917:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   918: 
                            	   919:     ; Desloca e insere os 4 bits em D0
00:00000698 E988            	   920:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000069A 8004            	   921:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   922: 
                            	   923:     ; Atualiza tail (circular)
00:0000069C 5282            	   924:     ADDQ.L  #1,D2
00:0000069E 0282000000FF    	   925:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   926: 
00:000006A4 51CBFFEA        	   927:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   928: 
                            	   929:     ; Atualiza ponteiros globais
00:000006A8 23C20008101E    	   930:     MOVE.L  D2,BUFFER_TAIL
00:000006AE 517900081022    	   931:     SUB.W   #8,BUFFER_COUNT
                            	   932: 
00:000006B4 7200            	   933:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:000006B6 6004            	   934:     BRA     .Exit
                            	   935: 
                            	   936: .BufferUnderrun:
00:000006B8 72FF            	   937:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:000006BA 7000            	   938:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   939: 
                            	   940: .Exit:
00:000006BC 4CDF013C        	   941:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:000006C0 4E75            	   942:     RTS
