                            	   961: ; XMODEM RECEIVER ROUTINE
                            	   962: ;bloco.append(0x01);        // SOH
                            	   963: ;bloco.append(blockNumber); // Número do bloco (começa com 1)
                            	   964: ;bloco.append(255 - blockNumber); // Complemento
