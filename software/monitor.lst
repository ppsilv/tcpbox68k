                            	   179: ; ----------------------------------------------------------------------
                            	   180: ; UART_WriteString - Envia string terminada em null para UART
                            	   181: ; Entrada:
                            	   182: ;   A0 = Ponteiro para a string (endereço da string)
                            	   183: ; ----------------------------------------------------------------------
                            	   184: UART_WriteString:
00:0000016E 2F08            	   185:     MOVE.L  A0,-(SP)      ; Preserva D0
00:00000170 2F00            	   186:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   187: .WriteLoop:
00:00000172 1018            	   188:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000174 6706            	   189:     BEQ     .Done
00:00000176 4EB8013A        	   190:     JSR     UART_WriteChar ; Use sua rotine existente
00:0000017A 60F6            	   191:     BRA     .WriteLoop
                            	   192: .Done:
00:0000017C 201F            	   193:     MOVE.L  (SP)+,D0
00:0000017E 205F            	   194:     MOVE.L  (SP)+,A0
00:00000180 4E75            	   195:     RTS
