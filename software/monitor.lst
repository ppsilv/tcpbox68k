                            	   653:     ;LEA     BaudPrompt,A0
                            	   654:     ;JSR     UART_WriteString
                            	   655:     ;JSR     UART_ReadHex        ; Lê valor do baud rate
                            	   656:     ;MOVE.L  CurrentUART,A0
                            	   657:     ;MOVE.B  D0,(UART_BAUD,A0)   ; Configura registrador
