                            	   677: ; ----------------------------------------------------------------------
                            	   678: ; Rotinas Auxiliares
                            	   679: ; ----------------------------------------------------------------------
                            	   680: 
                            	   681: ; Lê número hexadecimal (retorna em D0)
                            	   682: UART_ReadHex1:
00:000004A4 2F01            	   683:         MOVE.L  D1,-(SP)
00:000004A6 2F02            	   684:         MOVE.L  D2,-(SP)
                            	   685: 
00:000004A8 41F9000002A3    	   686:         LEA     WritePrompt,A0
00:000004AE 4EB8014E        	   687:         JSR     UART_WriteString
                            	   688: 
00:000004B2 4EB801EE        	   689:         JSR     new_line
                            	   690: 
00:000004B6 7000            	   691:         MOVEQ   #0,D0
00:000004B8 7200            	   692:         MOVEQ   #0,D1            ; Máximo 8 dígitos
00:000004BA 7400            	   693:         MOVEQ   #0,D2            ; Resultado em D2
                            	   694: 
                            	   695: .Loop:
00:000004BC 4EB80134        	   696:         JSR     UART_ReadChar
00:000004C0 B03C000D        	   697:         CMP.B   #13,D0
00:000004C4 670C            	   698:         BEQ     .Done
00:000004C6 B03C000A        	   699:         CMP.B   #10,D0
00:000004CA 6706            	   700:         BEQ     .Done
00:000004CC 4EB805BA        	   701:         JSR     BufferPut
00:000004D0 60EA            	   702:         BRA     .Loop
                            	   703: .Done:
                            	   704: ;         BSR     UART_BufferGet
                            	   705: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   706: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   707: ;         Senão, D0 contém o byte lido!
                            	   708: .loop1:
00:000004D2 4EB805F2        	   709:     JSR     BufferGet
00:000004D6 B03C00FF        	   710:     CMP.B   #-1,D0          ; Buffer vazio?
00:000004DA 6706            	   711:     BEQ     .fim      ; Se sim, ignora
00:000004DC 4EB8011A        	   712:     JSR     UART_WriteChar
00:000004E0 60F0            	   713:     BRA     .loop1
                            	   714: .fim:
00:000004E2 241F            	   715:     MOVE.L  (SP)+,D2
00:000004E4 221F            	   716:     MOVE.L  (SP)+,D1
00:000004E6 4EB801EE        	   717:     JSR     new_line
00:000004EA 6000FB82        	   718:     bra     MenuLoop ;provisoriamente
00:000004EE 4E75            	   719:     RTS
                            	   720: 
                            	   721: ; Lê número hexadecimal (retorna em D0)
                            	   722: UART_ReadHex:
00:000004F0 2F01            	   723:         MOVE.L  D1,-(SP)
00:000004F2 2F02            	   724:         MOVE.L  D2,-(SP)
                            	   725: 
00:000004F4 7000            	   726:         MOVEQ   #0,D0
00:000004F6 721C            	   727:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:000004F8 7400            	   728:         MOVEQ   #0,D2            ; Resultado em D2
                            	   729: .Loop:
00:000004FA 7000            	   730:         CLR.L   D0
00:000004FC 4EB80134        	   731:         JSR     UART_ReadChar
00:00000500 B03C000D        	   732:         CMP.B   #13,D0
00:00000504 674C            	   733:         BEQ     .Done
00:00000506 B03C000A        	   734:         CMP.B   #10,D0
00:0000050A 6746            	   735:         BEQ     .Done
                            	   736:         ;Tratando os numeros
00:0000050C B03C0030        	   737:         CMP.B   #'0',D0
00:00000510 6C02            	   738:         BGE     .maiorQueZero
00:00000512 60E6            	   739:         BRA     .Loop
                            	   740: .maiorQueZero:
00:00000514 B03C0039        	   741:         CMP.B   #'9',D0
00:00000518 6F10            	   742:         BLE     .isdigit
                            	   743:         ;Tratando as letras
00:0000051A B03C0041        	   744:         CMP.B   #'A',D0
00:0000051E 6C02            	   745:         BGE     .maiorQueA
00:00000520 60D8            	   746:         BRA     .Loop
                            	   747: .maiorQueA:
00:00000522 B03C0046        	   748:         CMP.B   #'F',D0
00:00000526 6F16            	   749:         BLE     .isletter
00:00000528 60D0            	   750:         BRA     .Loop
                            	   751: .isdigit:
00:0000052A 903C0030        	   752:         SUB.B   #'0',D0
00:0000052E E3A8            	   753:         LSL.L   D1,D0
00:00000530 5901            	   754:         SUB.B   #4,D1
00:00000532 8480            	   755:         OR.L    D0,D2
00:00000534 41F900081026    	   756:         LEA     addressInHex,A0
00:0000053A 2082            	   757:         MOVE.L  D2,(A0)
