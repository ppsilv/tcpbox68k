                            	   378: NoNewLine:
                            	   379:     ; Imprime byte em hex
00:000002A0 1018            	   380:     MOVE.B  (A0)+,D0
00:000002A2 4EB80322        	   381:     JSR     PrintByteHex
                            	   382: 
00:000002A6 103C0020        	   383:     MOVE.B  #' ',D0
00:000002AA 4EB8012A        	   384:     JSR     UART_WriteChar
                            	   385: 
                            	   386:     ; Verifica fim da linha (16 bytes)
00:000002AE 2008            	   387:     MOVE.L  A0,D0
00:000002B0 02800000000F    	   388:     ANDI.L  #$0000000F,D0
00:000002B6 664E            	   389:     BNE     NoEndLine
                            	   390: 
                            	   391:     ; Imprime caracteres ASCII
00:000002B8 103C0020        	   392:     MOVE.B  #' ',D0
