                            	   156:     ; Escreve caractere (D0.B)
                            	   157: UART_WriteChar:
00:0000012A 2F08            	   158:     MOVE.L  A0,-(SP)        ; Preserva A0
00:0000012C 2F00            	   159:     MOVE.L  D0,-(SP)        ; Preserva D0
00:0000012E 207900081000    	   160:     move.l   UART_CURRENT,A0
                            	   161: .WaitTx:
00:00000134 08280005000A    	   162:     BTST.B  #5,LSR(A0)      ; wait until transmit holding register is empty
00:0000013A 67F8            	   163:     BEQ     .WaitTx
00:0000013C 1080            	   164:     MOVE.B  D0,THR(A0)      ; transmit byte
00:0000013E 201F            	   165:     MOVE.L  (SP)+,D0        ;Restaura D0
00:00000140 205F            	   166:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000142 4E75            	   167:     RTS
                            	   168: 
                            	   169: 
                            	   170: ; Lê caractere (retorna em D0)
                            	   171: UART_ReadChar:
00:00000144 2F08            	   172:     MOVE.L  A0,-(SP)        ; Preserva A0
00:00000146 207900081000    	   173:     move.l   UART_CURRENT,A0
                            	   174: .WaitRx:
00:0000014C 08280000000A    	   175:     BTST    #0,LSR(A0)        ; RX ready?
00:00000152 67F8            	   176:     BEQ     .WaitRx
00:00000154 1010            	   177:     MOVE.B  RHR(A0),D0
00:00000156 205F            	   178:     MOVE.L  (SP)+,A0        ;Restaura A0
00:00000158 4EB8012A        	   179:     JSR     UART_WriteChar
00:0000015C 4E75            	   180:     RTS
