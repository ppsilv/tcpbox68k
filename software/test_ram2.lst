00:000002C0 103C007C        	   394:     MOVE.B  #'|',D0
00:000002C4 4EB8012A        	   395:     JSR     UART_WriteChar
                            	   396: 
00:000002C8 43E8FFF0        	   397:     LEA     -16(A0),A1        ; Volta ao início da linha
00:000002CC 740F            	   398:     MOVEQ   #15,D2            ; 16 caracteres
                            	   399: 
                            	   400: AsciiLoop:
00:000002CE 1019            	   401:     MOVE.B  (A1)+,D0
00:000002D0 B03C0020        	   402:     CMP.B   #32,D0            ; Verifica se é imprimível
00:000002D4 6D0C            	   403:     BLT     NonPrintable
00:000002D6 B03C007E        	   404:     CMP.B   #126,D0
00:000002DA 6E06            	   405:     BGT     NonPrintable
                            	   406: 
00:000002DC 4EB8012A        	   407:     JSR     UART_WriteChar
00:000002E0 6008            	   408:     BRA     NextAscii
                            	   409: 
