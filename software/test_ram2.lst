                            	   129: ; Inicialização da UART
                            	   130: UART_Init0:
00:000000CC 303C2580        	   131:     MOVE.W  #9600,D0    ; Para 9600 bauds
00:000000D0 610000A0        	   132:     BSR     CalcBaudDiv
00:000000D4 227900081000    	   133:     move.l  UART_CURRENT,a1
00:000000DA 137C000D0004    	   134:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:000000E0 137C00830006    	   135:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:000000E6 41F900081004    	   136:     LEA     BAUD_TABLE,A0
00:000000EC 1018            	   137:     MOVE.B  (A0)+,D0
00:000000EE 1280            	   138:     move.b  D0,DLL(a1)     ; set divisor latch low byte
00:000000F0 1010            	   139:     MOVE.B  (A0),D0
00:000000F2 13400002        	   140:     move.b  D0,DLM(a1)     ; set divisor latch high byte
00:000000F6 08A900070006    	   141:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:000000FC 4229000E        	   142:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000100 4E75            	   143:     RTS
