                            	   674:         BGE     .maiorQueA
                            	   675: .maiorQueA:
00:000004AE B03C0046        	   676:         CMP.B   #'F',D0
00:000004B2 6F1A            	   677:         BLE     .isletter
00:000004B4 60D4            	   678:         BRA     .Loop
                            	   679: .isdigit:
