                            	   635: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   636: ;         Senão, D0 contém o byte lido!
                            	   637: .loop1:
00:0000045E 4EB80582        	   638:     JSR     BufferGet
00:00000462 B03C00FF        	   639:     CMP.B   #-1,D0          ; Buffer vazio?
00:00000466 6706            	   640:     BEQ     .fim      ; Se sim, ignora
