00:000002E6 4EB8012A        	   412:     JSR     UART_WriteChar
                            	   413: 
                            	   414: NextAscii:
00:000002EA 51CAFFE2        	   415:     DBRA    D2,AsciiLoop
                            	   416: 
00:000002EE 103C007C        	   417:     MOVE.B  #'|',D0
00:000002F2 4EB8012A        	   418:     JSR     UART_WriteChar
