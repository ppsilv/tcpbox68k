00:000004BA E3A8            	   681:         LSL.L   D1,D0
00:000004BC 2AC0            	   682:         MOVE.L  D0,(A5)+
00:000004BE 5901            	   683:         SUB.B   #4,D1
00:000004C0 2881            	   684:         MOVE.L  D1,(A4)
00:000004C2 8480            	   685:         OR.L    D0,D2
00:000004C4 41F900081014    	   686:         LEA     addressInHex,A0
00:000004CA 2082            	   687:         MOVE.L  D2,(A0)
00:000004CC 60BC            	   688:         BRA     .Loop
                            	   689: .isletter:
00:000004CE 903C0037        	   690:         SUB.B   #$37,D0
00:000004D2 E3A8            	   691:         LSL.L   D1,D0
00:000004D4 5901            	   692:         SUB.B   #4,D1
00:000004D6 8480            	   693:         OR.L    D0,D2
00:000004D8 41F900081014    	   694:         LEA     addressInHex,A0
00:000004DE 2082            	   695:         MOVE.L  D2,(A0)
00:000004E0 60A8            	   696:         BRA     .Loop
                            	   697: .Done:
