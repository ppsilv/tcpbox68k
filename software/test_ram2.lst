                            	     9: ;Term vt-102 cursor positioning \033[0;0H
                            	    10: 
                            	    11: ;# Clock frequency in Hz
                            	    12: F_CPU           equ 16000000
                            	    13: ;# Serial baud rate
                            	    14: BAUD            equ 9600
                            	    15: UART            equ $2000
                            	    16: UART_BASE       equ $2000
                            	    17: ; register offsets
                            	    18: RHR             equ 0   ; receive holding register (read)
                            	    19: THR             equ 0   ; transmit holding register (write)
                            	    20: IER             equ 2   ; interrupt enable register
                            	    21: ISR             equ 4   ; interrupt status register (read)
                            	    22: FCR             equ 4   ; FIFO control register (write)
                            	    23: LCR             equ 6   ; line control register
                            	    24: MCR             equ 8   ; modem control register
                            	    25: LSR             equ 10  ; line status register
                            	    26: MSR             equ 12  ; modem status register
                            	    27: SPR             equ 14  ; scratchpad register (reserved for system use)
                            	    28: DLL             equ 0   ; divisor latch LSB
                            	    29: DLM             equ 2   ; divisor latch MSB
                            	    30: ; aliases for register names (used by different manufacturers)cd ..
                            	    31: RBR             equ RHR ; receive buffer register
                            	    32: IIR             equ ISR ; interrupt identification register
                            	    33: SCR             equ SPR ; scratch register
                            	    34: 
                            	    35: BAUD_DIV        equ     (((F_CPU*10)/(16*BAUD))+5)/10 ; compute one extra decimal place and round
                            	    36: BAUD_DIV_L      equ     (BAUD_DIV&$FF)
                            	    37: BAUD_DIV_U      equ     ((BAUD_DIV>>8)&$FF)
                            	    38: 
                            	    39: RAM_START     EQU     $080000      ; Início da RAM disponível
                            	    40: STACK_INIT    EQU     $100000      ; Topo da pilha (ajuste conforme necessário)
                            	    41: ;Variables
                            	    42: UART_CURRENT EQU $81000
                            	    43: BAUD_TABLE   EQU $81004         ; BAUD_DIV_L em $81004  ; BAUD_DIV_U em $81006
                            	    44: 
