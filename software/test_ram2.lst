00:00000522 4EB80534        	   728:     JSR     UART_ReadHexNibble
00:00000526 E908            	   729:     LSL.B   #4,D0
00:00000528 1200            	   730:     MOVE.B  D0,D1
00:0000052A 4EB80534        	   731:     JSR     UART_ReadHexNibble
00:0000052E 8001            	   732:     OR.B    D1,D0
