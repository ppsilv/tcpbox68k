00:00000484 7000            	   655:         MOVEQ   #0,D0
00:00000486 721C            	   656:         MOVEQ   #28,D1            ; Máximo 8 dígitos
00:00000488 7400            	   657:         MOVEQ   #0,D2            ; Resultado em D2
                            	   658: .Loop:
00:0000048A 7000            	   659:         CLR.L   D0
00:0000048C 4EB80144        	   660:         JSR     UART_ReadChar
00:00000490 B03C000D        	   661:         CMP.B   #13,D0
00:00000494 674C            	   662:         BEQ     .Done
00:00000496 B03C000A        	   663:         CMP.B   #10,D0
00:0000049A 6746            	   664:         BEQ     .Done
                            	   665:         ;Tratando os numeros
