00:00000538 B03C0041        	   739:     CMP.B   #'A',D0
00:0000053C 6D02            	   740:     BLT     .Digit
00:0000053E 5F00            	   741:     SUB.B   #7,D0            ; Ajuste para A-F
                            	   742: .Digit:
00:00000540 903C0030        	   743:     SUB.B   #'0',D0
00:00000544 C03C000F        	   744:     AND.B   #$0F,D0
00:00000548 4E75            	   745:     RTS
