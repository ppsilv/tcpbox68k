                            	   182: ; ----------------------------------------------------------------------
                            	   183: ; UART_WriteString - Envia string terminada em null para UART
                            	   184: ; Entrada:
                            	   185: ;   A0 = Ponteiro para a string (endereço da string)
                            	   186: ; ----------------------------------------------------------------------
                            	   187: UART_WriteString:
00:0000015E 2F08            	   188:     MOVE.L  A0,-(SP)      ; Preserva D0
00:00000160 2F00            	   189:     MOVE.L  D0,-(SP)      ; Preserva D0
                            	   190: .WriteLoop:
00:00000162 1018            	   191:     MOVE.B  (A0)+,D0      ; Pega caractere
00:00000164 6706            	   192:     BEQ     .Done
00:00000166 4EB8012A        	   193:     JSR     UART_WriteChar ; Use sua rotine existente
00:0000016A 60F6            	   194:     BRA     .WriteLoop
                            	   195: .Done:
00:0000016C 201F            	   196:     MOVE.L  (SP)+,D0
00:0000016E 205F            	   197:     MOVE.L  (SP)+,A0
00:00000170 4E75            	   198:     RTS
                            	   199: 
                            	   200: ; ----------------------------------------------------------------------
                            	   201: ; Constantes
                            	   202: ; ----------------------------------------------------------------------
                            	   203: ;F_CPU       EQU 16000000       ; Clock do CPU (16MHz)
                            	   204: ;BAUD_TABLE  EQU $70000         ; Endereço base na RAM para armazenar divisores
                            	   205:                               ; BAUD_DIV_L em $70000
                            	   206:                               ; BAUD_DIV_U em $70001
                            	   207: 
                            	   208: ; ----------------------------------------------------------------------
                            	   209: ; Rotina: Calcula e armazena divisor de baud rate
                            	   210: ; Entrada:
                            	   211: ;   D0.W - BAUD rate desejado (ex: 9600)
                            	   212: ; Saída:
                            	   213: ;   BAUD_DIV_L e BAUD_DIV_U armazenados na RAM
                            	   214: ; ----------------------------------------------------------------------
                            	   215: CalcBaudDiv:
00:00000172 4E56FFFC        	   216:     LINK    A6,#-4            ; Cria frame de stack (4 bytes locais)
                            	   217: 
                            	   218:     ; 1. Calcula BAUD_DIV = (((F_CPU*10)/(16*BAUD))+5)/10
00:00000176 223C00F42400    	   219:     MOVE.L  #F_CPU,D1         ; D1 = F_CPU
00:0000017C C2FC000A        	   220:     MULU.W  #10,D1            ; D1 = F_CPU*10
                            	   221: 
00:00000180 3400            	   222:     MOVE.W  D0,D2             ; D2 = BAUD
00:00000182 E94A            	   223:     LSL.W   #4,D2             ; D2 = 16*BAUD (shift left 4 bits)
                            	   224: 
00:00000184 82C2            	   225:     DIVU.W  D2,D1             ; D1 = (F_CPU*10)/(16*BAUD)
00:00000186 5A41            	   226:     ADD.W   #5,D1             ; +5 para arredondar
00:00000188 82FC000A        	   227:     DIVU.W  #10,D1            ; /10
                            	   228: 
                            	   229:     ; 2. Separa em parte alta e baixa
00:0000018C 3001            	   230:     MOVE.W  D1,D0             ; D0 = BAUD_DIV completo
00:0000018E 024000FF        	   231:     ANDI.W  #$FF,D0           ; D0 = BAUD_DIV_L (parte baixa)
00:00000192 3401            	   232:     MOVE.W  D1,D2
00:00000194 E04A            	   233:     LSR.W   #8,D2             ; D2 = BAUD_DIV_U (parte alta)
                            	   234: 
                            	   235:     ; 3. Armazena na RAM
00:00000196 41F900081004    	   236:     LEA     BAUD_TABLE,A0
00:0000019C 10C0            	   237:     MOVE.B  D0,(A0)+          ; Armazena BAUD_DIV_L
00:0000019E 1082            	   238:     MOVE.B  D2,(A0)           ; Armazena BAUD_DIV_U
                            	   239: 
00:000001A0 4E5E            	   240:     UNLK    A6                ; Restaura frame de stack
00:000001A2 4E75            	   241:     RTS
                            	   242: 
                            	   243: new_line:
00:000001A4 2F00            	   244:         MOVE.L  D0,-(SP)          ; Salva D0
00:000001A6 103C000A        	   245:         MOVE.B  #10,D0
00:000001AA 4EB8012A        	   246:         JSR     UART_WriteChar
00:000001AE 103C000D        	   247:         MOVE.B  #13,D0
00:000001B2 4EB8012A        	   248:         JSR     UART_WriteChar
00:000001B6 201F            	   249:         MOVE.L  (SP)+,D0          ; Restaura D0
00:000001B8 4E75            	   250:         RTS
                            	   251: 
                            	   252: ; Versão compacta sem stack frame
                            	   253: PrintHexFast:
00:000001BA 2F02            	   254:     MOVE.L  D2,-(SP)          ; Salva D2
00:000001BC 2F00            	   255:     MOVE.L  D0,-(SP)          ; Salva D0 original
00:000001BE 7407            	   256:     MOVEQ   #7,D2             ; 8 dígitos (contador)
                            	   257: 
                            	   258: .Loop:
00:000001C0 2017            	   259:     MOVE.L  (SP),D0           ; Recupera valor original
00:000001C2 E998            	   260:     ROL.L   #4,D0             ; Pega próximo nibble
00:000001C4 2E80            	   261:     MOVE.L  D0,(SP)           ; Armazena valor rotacionado
00:000001C6 0200000F        	   262:     ANDI.B  #$F,D0            ; Isola nibble
                            	   263: 
00:000001CA B03C0009        	   264:     CMP.B   #9,D0
00:000001CE 6302            	   265:     BLS     .Digit
00:000001D0 5E00            	   266:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   267: .Digit:
00:000001D2 D03C0030        	   268:     ADD.B   #'0',D0           ; Converte para ASCII
00:000001D6 4EB8012A        	   269:     JSR     UART_WriteChar    ; Envia caractere
                            	   270: 
00:000001DA 51CAFFE4        	   271:     DBRA    D2,.Loop          ; Repete para todos dígitos
                            	   272: 
00:000001DE 588F            	   273:     ADDQ.L  #4,SP             ; Remove valor salvo
00:000001E0 241F            	   274:     MOVE.L  (SP)+,D2          ; Restaura D2
00:000001E2 4E75            	   275:     RTS
                            	   276: 
                            	   277: ; ----------------------------------------------------------------------
                            	   278: ; PrintHex - Imprime valor hexadecimal no terminal
                            	   279: ; Entrada:
                            	   280: ;   D0.L = Valor a ser impresso (32 bits)
                            	   281: ;   D1.W = Número de dígitos (1-8)
                            	   282: ; ----------------------------------------------------------------------
                            	   283: PrintHexPRECISA_DE_REVISAO:
00:000001E4 4E56FFF8        	   284:     LINK    A6,#-8            ; Reserva espaço na pilha
00:000001E8 2F02            	   285:     MOVE.L  D2,-(SP)          ; Salva D2
00:000001EA 2D40FFFC        	   286:     MOVE.L  D0,-4(A6)         ; Guarda o valor original
00:000001EE 3D41FFFA        	   287:     MOVE.W  D1,-6(A6)         ; Guarda contador de dígitos
                            	   288: 
00:000001F2 323C0008        	   289:     MOVE.W  #$0008,D1
                            	   290: 
                            	   291:     ; Ajusta para começar pelo dígito mais significativo
00:000001F6 E549            	   292:     LSL.W   #2,D1             ; Multiplica por 4 (bits por dígito)
00:000001F8 5941            	   293:     SUBQ.W  #4,D1             ; Ajuste inicial
                            	   294: 
                            	   295: .PrintLoop:
00:000001FA 202EFFFC        	   296:     MOVE.L  -4(A6),D0         ; Recupera valor
00:000001FE 3401            	   297:     MOVE.W  D1,D2             ; Posição do nibble
00:00000200 E5B8            	   298:     ROL.L   D2,D0             ; Rola para colocar nibble nos bits 31-28
00:00000202 02800000000F    	   299:     ANDI.L  #$F,D0            ; Isola o nibble (4 bits)
                            	   300: 
                            	   301:     ; Converte para ASCII
00:00000208 B03C0009        	   302:     CMP.B   #9,D0
00:0000020C 6302            	   303:     BLS     .Decimal
00:0000020E 5E00            	   304:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   305: .Decimal:
00:00000210 D03C0030        	   306:     ADD.B   #'0',D0           ; Converte para caractere
                            	   307: 
                            	   308:     ; Imprime caractere
00:00000214 4EB8012A        	   309:     JSR     UART_WriteChar    ; Sua rotina de envio UART
                            	   310: 
00:00000218 5941            	   311:     SUBQ.W  #4,D1             ; Próximo nibble
00:0000021A 6ADE            	   312:     BPL     .PrintLoop        ; Repete até todos os dígitos
                            	   313: 
                            	   314:     ; Espaço final para separação
00:0000021C 103C0020        	   315:     MOVE.B  #' ',D0
00:00000220 4EB8012A        	   316:     JSR     UART_WriteChar
                            	   317: 
00:00000224 241F            	   318:     MOVE.L  (SP)+,D2          ; Restaura D2
00:00000226 4E5E            	   319:     UNLK    A6                ; Restaura frame
00:00000228 4E75            	   320:     RTS
                            	   321: ; ----------------------------------------------------------------------
                            	   322: ; Exemplo de uso:
                            	   323: ; ----------------------------------------------------------------------
                            	   324: SetupDivisor:
00:0000022A 303C2580        	   325:     MOVE.W  #9600,D0          ; Configura para 9600 bauds
00:0000022E 6100FF42        	   326:     BSR     CalcBaudDiv
                            	   327: 
                            	   328:     ; Agora pode acessar os valores na RAM:
00:00000232 41F900081004    	   329:     LEA     BAUD_TABLE,A0
00:00000238 1018            	   330:     MOVE.B  (A0)+,D0          ; D0 = BAUD_DIV_L
00:0000023A 1210            	   331:     MOVE.B  (A0),D1           ; D1 = BAUD_DIV_U
                            	   332: 
                            	   333:     ; (Aqui você configuraria os registradores da UART)
00:0000023C 4E75            	   334:     RTS
                            	   335: ; ----------------------------------------------------------------------
                            	   336: ; MemDump - Imprime dump de memória formatado
                            	   337: ; Entrada:
                            	   338: ;   A0 = Endereço inicial (ex: $80000)
                            	   339: ;   D0 = Quantidade de bytes (ex: 256)
                            	   340: ; ----------------------------------------------------------------------
                            	   341: MemDump:
00:0000023E 41F900000036    	   342:     LEA     DumpHeader,A0
00:00000244 4EB8015E        	   343:     JSR     UART_WriteString
00:00000248 207900081014    	   344:     MOVE.L  (addressInHex),A0
00:0000024E 2008            	   345:     MOVE.L  A0,D0
00:00000250 4EB80312        	   346:     JSR     PrintHexAddress
00:00000254 4EB801A4        	   347:     JSR     new_line
                            	   348: 
00:00000258 41F900000049    	   349:     LEA     DumpHeader1,A0
00:0000025E 4EB8015E        	   350:     JSR     UART_WriteString
                            	   351: 
00:00000262 207900081014    	   352:     MOVE.L  (addressInHex),A0
                            	   353:     ; Calcula endereço final
                            	   354: 
00:00000268 7200            	   355:     CLR.L   D1
00:0000026A 2208            	   356:     MOVE.L  A0,D1
00:0000026C 0681000000FF    	   357:     ADDI.L  #$000000FF,D1             ; D1 = endereço final
00:00000272 2001            	   358:     MOVE.L  D1,D0
00:00000274 4EB80312        	   359:     JSR     PrintHexAddress
00:00000278 4EB801A4        	   360:     JSR     new_line
                            	   361: 
00:0000027C 4EB80144        	   362:     JSR     UART_ReadChar
                            	   363: DumpLoop:
                            	   364:     ; Nova linha a cada 16 bytes
00:00000280 2008            	   365:     MOVE.L  A0,D0
00:00000282 02800000000F    	   366:     ANDI.L  #$0000000F,D0     ; Verifica se é início de linha
00:00000288 6616            	   367:     BNE     NoNewLine
                            	   368: 
                            	   369:     ; Imprime endereço
00:0000028A 2008            	   370:     MOVE.L  A0,D0
00:0000028C 4EB80312        	   371:     JSR     PrintHexAddress    ; Imprime 8 dígitos hex
                            	   372: 
00:00000290 103C003A        	   373:     MOVE.B  #':',D0
00:00000294 4EB8012A        	   374:     JSR     UART_WriteChar
00:00000298 103C0020        	   375:     MOVE.B  #' ',D0
