                            	   747: ;--------------------------------------------------
                            	   748: ; BufferPut - Insere um byte no buffer (D0.B = byte)
                            	   749: ;--------------------------------------------------
                            	   750: ; Exemplo: insere 'A' no buffer
                            	   751: ;          MOVE.B  #'A',D0
                            	   752: ;          JSR     UART_BufferPut
                            	   753: 
                            	   754: BufferPut:
00:0000054A 2F01            	   755:     MOVE.L  D1,-(SP)
00:0000054C 2F08            	   756:     MOVE.L  A0,-(SP)
                            	   757: 
                            	   758:     ;ANDI.W    #$FF00,D0
00:0000054E 41F900081022    	   759:     LEA     BUFFER,A0
00:00000554 323900081020    	   760:     MOVE.W  BUFFER_COUNT,D1
                            	   761: 
00:0000055A B27C0100        	   762:     CMP.W   #256,D1
00:0000055E 6C1C            	   763:     BGE     .BufferFull
                            	   764: 
                            	   765:     ; Modificado para usar deslocamento de 16 bits
00:00000560 323900081018    	   766:     MOVE.W  BUFFER_HEAD,D1
00:00000566 D0C1            	   767:     ADD     D1,A0
00:00000568 1080            	   768:     MOVE.B  D0,(A0)              ;PUTTING BYTE
                            	   769: 
00:0000056A 5441            	   770:     ADD     #2,D1              ; Incrementa como word
00:0000056C 024100FF        	   771:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:00000570 33C100081018    	   772:     MOVE.W  D1,BUFFER_HEAD
                            	   773: 
00:00000576 527900081020    	   774:     ADDQ.W  #1,BUFFER_COUNT
                            	   775: 
                            	   776: .BufferFull:
00:0000057C 205F            	   777:     MOVE.L  (SP)+,A0
00:0000057E 221F            	   778:     MOVE.L  (SP)+,D1
                            	   779: 
00:00000580 4E75            	   780:     RTS
                            	   781: 
                            	   782: ;--------------------------------------------------
                            	   783: ; BufferGet - Pega um byte do buffer (retorna em D0.B, ou -1 se vazio)
                            	   784: ;--------------------------------------------------
                            	   785: ;Exemplo: Lendo byte do buffer
                            	   786: ;         BSR     UART_BufferGet
                            	   787: ;         CMP.B   #-1,D0          ; Buffer vazio?
                            	   788: ;         BEQ     NadaParaLer      ; Se sim, ignora
                            	   789: ;         Senão, D0 contém o byte lido!
                            	   790: BufferGet:
00:00000582 2F01            	   791:     MOVE.L  D1,-(SP)
00:00000584 2F08            	   792:     MOVE.L  A0,-(SP)
                            	   793: 
00:00000586 323900081020    	   794:     MOVE.W  BUFFER_COUNT,D1
00:0000058C 6724            	   795:     BEQ     .BufferEmpty
                            	   796: 
00:0000058E 41F900081022    	   797:     LEA     BUFFER,A0
                            	   798: 
                            	   799:     ; Modificado para usar deslocamento de 16 bits
00:00000594 32390008101C    	   800:     MOVE.W  BUFFER_TAIL,D1
00:0000059A 10301000        	   801:     MOVE.B  (A0,D1.W),D0       ; Usando D1.W em vez de D1.L
                            	   802: 
00:0000059E 5401            	   803:     ADDQ.B  #2,D1              ; Incrementa como word
00:000005A0 024100FF        	   804:     ANDI.W  #255,D1            ; Mantém no range 0-255
00:000005A4 33C10008101C    	   805:     MOVE.W  D1,BUFFER_TAIL
                            	   806: 
00:000005AA 537900081020    	   807:     SUBQ.W  #1,BUFFER_COUNT
00:000005B0 6006            	   808:     BRA     .Exit
                            	   809: 
                            	   810: .BufferEmpty:
00:000005B2 4EB805BE        	   811:     JSR     FBufferEmpty
00:000005B6 70FF            	   812:     MOVEQ   #-1,D0
                            	   813: .Exit:
00:000005B8 205F            	   814:     MOVE.L  (SP)+,A0
00:000005BA 221F            	   815:     MOVE.L  (SP)+,D1
00:000005BC 4E75            	   816:     RTS
                            	   817: 
                            	   818: FBufferEmpty:
00:000005BE 4EB801A4        	   819:         JSR     new_line
00:000005C2 41F9000002FD    	   820:         LEA     BufferEmpty,A0
00:000005C8 4EB8015E        	   821:         JSR     UART_WriteString
00:000005CC 4EB801A4        	   822:         JSR     new_line
00:000005D0 4E75            	   823:         RTS
                            	   824: ;---------------------------------------------------------------------
                            	   825: ; Zera os ponteiros do buffer circular (HEAD e TAIL) - VASM Edition
                            	   826: ;---------------------------------------------------------------------
                            	   827: ClearBufferPointers:
00:000005D2 23FC000000000008	   828:     MOVE.L  #0,BUFFER_HEAD    ; Zera BUFFER_HEAD (32 bits)
00:000005DA 1018
00:000005DC 23FC000000000008	   829:     MOVE.L  #0,BUFFER_TAIL    ; Zera BUFFER_TAIL (32 bits)
00:000005E4 101C
00:000005E6 33FC000000081020	   830:     MOVE.W  #0,BUFFER_COUNT   ; Opcional: zera contador (16 bits)
00:000005EE 4E75            	   831:     RTS
                            	   832: ;---------------------------------------------------------------------
                            	   833: ; MontaAddress - Lê 8 bytes (4 bits cada) e forma um uint32
                            	   834: ; Entrada: Buffer contém 8 bytes (MSB first, 4 bits úteis cada)
                            	   835: ; Saída:   D0.L = valor de 32 bits (formado pelos nibbles)
                            	   836: ;          D1.B = 0 (sucesso) ou -1 (erro, buffer vazio)
                            	   837: ;---------------------------------------------------------------------
                            	   838: MontaAddress:
00:000005F0 48E73C80        	   839:     MOVEM.L D2-D5/A0,-(SP)   ; Salva registradores
                            	   840: 
                            	   841:     ; Verifica se há pelo menos 8 bytes no buffer
00:000005F4 323900081020    	   842:     MOVE.W  BUFFER_COUNT,D1
00:000005FA B27C0008        	   843:     CMP.W   #8,D1
00:000005FE 6D38            	   844:     BLT     .BufferUnderrun   ; Erro se menos que 8 bytes
                            	   845: 
00:00000600 41F900081022    	   846:     LEA     BUFFER,A0      ; A0 = base do buffer
00:00000606 24390008101C    	   847:     MOVE.L  BUFFER_TAIL,D2    ; D2 = tail (ponteiro de leitura)
00:0000060C 7000            	   848:     CLR.L   D0                ; Zera D0 (resultado final)
00:0000060E 7607            	   849:     MOVEQ   #7,D3             ; Contador (8 nibbles, MSB first)
                            	   850: 
                            	   851: .ReadLoop:
00:00000610 18302800        	   852:     MOVE.B  (A0,D2.L),D4      ; Lê byte do buffer
00:00000614 0204000F        	   853:     ANDI.B  #$0F,D4          ; Pega apenas os 4 bits inferiores
                            	   854: 
                            	   855:     ; Desloca e insere os 4 bits em D0
00:00000618 E988            	   856:     LSL.L   #4,D0             ; Abre espaço para o novo nibble
00:0000061A 8004            	   857:     OR.B    D4,D0             ; Adiciona os 4 bits no LSB
                            	   858: 
                            	   859:     ; Atualiza tail (circular)
00:0000061C 5282            	   860:     ADDQ.L  #1,D2
00:0000061E 0282000000FF    	   861:     ANDI.L  #255,D2           ; Mantém entre 0-255
                            	   862: 
00:00000624 51CBFFEA        	   863:     DBRA    D3,.ReadLoop      ; Repete para todos os 8 nibbles
                            	   864: 
                            	   865:     ; Atualiza ponteiros globais
00:00000628 23C20008101C    	   866:     MOVE.L  D2,BUFFER_TAIL
00:0000062E 517900081020    	   867:     SUB.W   #8,BUFFER_COUNT
                            	   868: 
00:00000634 7200            	   869:     MOVEQ   #0,D1             ; Sucesso (D1 = 0)
00:00000636 6004            	   870:     BRA     .Exit
                            	   871: 
                            	   872: .BufferUnderrun:
00:00000638 72FF            	   873:     MOVEQ   #-1,D1            ; Erro (D1 = -1)
00:0000063A 7000            	   874:     MOVEQ   #0,D0             ; Retorna 0 em D0
                            	   875: 
                            	   876: .Exit:
00:0000063C 4CDF013C        	   877:     MOVEM.L (SP)+,D2-D5/A0    ; Restaura registradores
00:00000640 4E75            	   878:     RTS
