                            	   146: UART_Init:
00:00000102 227900081000    	   147:     move.l   UART_CURRENT,a1
00:00000108 137C000D0004    	   148:     move.b  #%00001101,FCR(a1)      ; enable FIFO
00:0000010E 137C00830006    	   149:     move.b  #%10000011,LCR(a1)      ; 8 data bits, no parity, 1 stop bit, DLAB=1
00:00000114 12BC0068        	   150:     move.b  #BAUD_DIV_L,DLL(a1)     ; set divisor latch low byte
00:00000118 137C00000002    	   151:     move.b  #BAUD_DIV_U,DLM(a1)     ; set divisor latch high byte
00:0000011E 08A900070006    	   152:     bclr.b  #7,LCR(a1)              ; disable divisor latch
00:00000124 4229000E        	   153:     clr.b   SCR(a1)                 ; clear the scratch register
00:00000128 4E75            	   154:     RTS
