                            	   431: ; ----------------------------------------------------------------------
                            	   432: ; PrintHexAddress - Imprime endereço de 32 bits
                            	   433: ; Entrada: D0 = endereço
                            	   434: ; ----------------------------------------------------------------------
                            	   435: PrintHexAddress:
00:00000312 4840            	   436:     SWAP    D0                ; Imprime parte alta primeiro
00:00000314 4EB8031A        	   437:     JSR     PrintWordHex
00:00000318 4840            	   438:     SWAP    D0                ; Parte baixa
                            	   439:     ; Continua para PrintWordHex
                            	   440: 
                            	   441: ; ----------------------------------------------------------------------
                            	   442: ; PrintWordHex - Imprime word em hex (16 bits)
                            	   443: ; Entrada: D0.w = valor
                            	   444: ; ----------------------------------------------------------------------
                            	   445: PrintWordHex:
00:0000031A E158            	   446:     ROL.W   #8,D0             ; Byte mais significativo primeiro
00:0000031C 4EB80322        	   447:     JSR     PrintByteHex
00:00000320 E058            	   448:     ROR.W   #8,D0             ; Byte menos significativo
                            	   449:     ; Continua para PrintByteHex
                            	   450: 
                            	   451: ; ----------------------------------------------------------------------
                            	   452: ; PrintByteHex - Imprime byte em hex (8 bits)
                            	   453: ; Entrada: D0.b = valor
                            	   454: ; ----------------------------------------------------------------------
                            	   455: PrintByteHex:
00:00000322 1F00            	   456:     MOVE.B  D0,-(SP)          ; Salva byte original
00:00000324 E808            	   457:     LSR.B   #4,D0             ; Nibble alto
00:00000326 6106            	   458:     BSR     PrintNibble
00:00000328 101F            	   459:     MOVE.B  (SP)+,D0          ; Recupera byte
00:0000032A 0200000F        	   460:     ANDI.B  #$0F,D0           ; Nibble baixo
                            	   461:     ; Continua para PrintNibble
                            	   462: 
                            	   463: ; ----------------------------------------------------------------------
                            	   464: ; PrintNibble - Imprime um nibble em hex
                            	   465: ; Entrada: D0.b bits 3-0 = nibble (0-15)
                            	   466: ; ----------------------------------------------------------------------
                            	   467: PrintNibble:
00:0000032E B03C0009        	   468:     CMP.B   #9,D0
00:00000332 6302            	   469:     BLS     .Decimal
00:00000334 5E00            	   470:     ADD.B   #7,D0             ; Ajuste para A-F
                            	   471: .Decimal:
00:00000336 D03C0030        	   472:     ADD.B   #'0',D0
00:0000033A 4EF8012A        	   473:     JMP     UART_WriteChar    ; Usa JMP para tail call optimization
                            	   474: 
                            	   475: ClearRAM:
00:0000033E 41F900081000    	   476:     LEA     $81000,A0
00:00000344 43F9000821FF    	   477:     LEA     $821FF,A1
00:0000034A 7000            	   478:     MOVEQ   #0,D0
                            	   479: .ClearLoop:
00:0000034C 20C0            	   480:     MOVE.L  D0,(A0)+
00:0000034E B3C8            	   481:     CMPA.L  A0,A1
00:00000350 62FA            	   482:     BHI     .ClearLoop
00:00000352 4E75            	   483:     RTS
                            	   484: ; ----------------------------------------------------------------------
                            	   485: ; ClearRAM - Zera a RAM de 0x80000 até 0xFFFFF
                            	   486: ; ----------------------------------------------------------------------
                            	   487: ClearRAM1:
00:00000354 41F900080000    	   488:     LEA     $80000,A0        ; Endereço inicial da RAM
00:0000035A 43F900100000    	   489:     LEA     $100000,A1       ; Endereço final + 1
00:00000360 7000            	   490:     MOVEQ   #0,D0            ; Usa D0 como zero
                            	   491: 
                            	   492:     ; Calcula tamanho em bytes (já alinhado para longs)
00:00000362 2209            	   493:     MOVE.L  A1,D1
00:00000364 9288            	   494:     SUB.L   A0,D1            ; D1 = tamanho em bytes
                            	   495: 
                            	   496:     ; Otimização: escreve longs (32 bits) quando possível
00:00000366 2401            	   497:     MOVE.L  D1,D2
00:00000368 028200000003    	   498:     ANDI.L  #$00000003,D2    ; Verifica se é múltiplo de 4
00:0000036E 670C            	   499:     BEQ     .ClearLongs       ; Se for, usa escrita long
                            	   500: 
                            	   501:     ; Zera bytes residuais (1-3 bytes no início para alinhamento)
00:00000370 5382            	   502:     SUBQ.L  #1,D2            ; Ajusta contador
                            	   503: .ResidualLoop:
00:00000372 10C0            	   504:     MOVE.B  D0,(A0)+
00:00000374 51CAFFFC        	   505:     DBRA    D2,.ResidualLoop
                            	   506: 
                            	   507:     ; Atualiza tamanho restante
00:00000378 9282            	   508:     SUB.L   D2,D1
00:0000037A 5381            	   509:     SUBQ.L  #1,D1            ; Ajuste para DBRA
                            	   510: 
                            	   511: .ClearLongs:
00:0000037C E489            	   512:     LSR.L   #2,D1            ; Converte bytes para longs (divide por 4)
00:0000037E 5381            	   513:     SUBQ.L  #1,D1            ; Ajusta para DBRA
                            	   514: 
                            	   515: .LongLoop:
00:00000380 20C0            	   516:     MOVE.L  D0,(A0)+         ; Zera 4 bytes de cada vez
00:00000382 51C9FFFC        	   517:     DBRA    D1,.LongLoop
00:00000386 4E75            	   518:     RTS
