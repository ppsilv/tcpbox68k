# Makefile simplificado

CC = m68k-elf-gcc
AS = vasmm68k_mot
LD = m68k-elf-ld
OBJCOPY = m68k-elf-objcopy

CFLAGS = -m68000 -Os -Wall
LDFLAGS = -nostdlib -T readwrite.ld

all: readwrite.bin readwrite.lst

readwrite.o: readwrite.c
	$(CC) $(CFLAGS) -c $< -o $@

readwrite.lst: readwrite.c
	$(CC) $(CFLAGS) -S $< -o temp.s
	$(AS) -m68000 -Felf -L $@ temp.s -o /dev/null 2>&1 | true
	#rm -f temp.s

readwrite.elf: readwrite.o
	$(LD) $(LDFLAGS) $^ -o $@

readwrite.bin: readwrite.elf
	$(OBJCOPY) -O binary $< $@

clean:
	rm -f *.o *.elf *.bin *.lst *.s temp.s

.PHONY: all clean
