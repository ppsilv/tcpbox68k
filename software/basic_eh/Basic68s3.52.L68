00082476  4CDF 0206                312      MOVEM.l (sp)+,d1-d2/a1      * restore d1, d2 & a1
0008247A  003C 0001                313      ORI.b   #1,CCR          * set carry, flag we got a byte
0008247E  4E75                     314      RTS
