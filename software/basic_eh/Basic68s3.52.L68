00085D7B                          9830  *************************************************************************************
00085D7B                          9831  * EhBASIC keywords quick reference list                             *
00085D7B                          9832  *************************************************************************************
00085D7B                          9833  
00085D7B                          9834  * glossary
00085D7B                          9835  
00085D7B                          9836  *       <.>       required
00085D7B                          9837  *       {.|.}         one of required
00085D7B                          9838  *       [.]       optional
00085D7B                          9839  *       ...       may repeat as last
00085D7B                          9840  
00085D7B                          9841  *       any     = anything
00085D7B                          9842  *       num     = number
00085D7B                          9843  *       state       = statement
00085D7B                          9844  *       pint        = positive integer
00085D7B                          9845  *       str     = string
00085D7B                          9846  *       var     = variable
00085D7B                          9847  *       nvar        = numeric variable
00085D7B                          9848  *       svar        = string variable
00085D7B                          9849  *       expr        = expression
00085D7B                          9850  *       nexpr       = numeric expression
00085D7B                          9851  *       sexpr       = string expression
00085D7B                          9852  
00085D7B                          9853  * statement separator
00085D7B                          9854  
00085D7B                          9855  * :     . [<state>] : [<state>]                     * done
00085D7B                          9856  
00085D7B                          9857  * number bases
00085D7B                          9858  
00085D7B                          9859  * %     . %<binary num>                         * done
00085D7B                          9860  * $     . $<hex num>                            * done
00085D7B                          9861  
00085D7B                          9862  * commands
00085D7B                          9863  
00085D7B                          9864  * END       . END                                   * done
00085D7B                          9865  * FOR       . FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]      * done
00085D7B                          9866  * NEXT  . NEXT [<nvar>[,<nvar>]...]                 * done
00085D7B                          9867  * DATA  . DATA [{num|["]str["]}[,{num|["]str["]}]...]       * done
00085D7B                          9868  * INPUT . INPUT [<">str<">;] <var>[,<var>[,<var>]...]       * done
00085D7B                          9869  * DIM       . DIM <var>(<nexpr>[,<nexpr>[,<nexpr>]])            * done
00085D7B                          9870  * READ  . READ <var>[,<var>[,<var>]...]             * done
00085D7B                          9871  * LET       . [LET] <var>=<expr>                        * done
00085D7B                          9872  * DEC       . DEC <nvar>[,<nvar>[,<nvar>]...]               * done
00085D7B                          9873  * GOTO  . GOTO <pint>                           * done
00085D7B                          9874  * RUN       . RUN [pint]                            * done
00085D7B                          9875  * IF        . IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]    * done
00085D7B                          9876  * RESTORE   . RESTORE [pint]                            * done
00085D7B                          9877  * GOSUB . GOSUB <pint>                          * done
00085D7B                          9878  * RETURN    . RETURN                                * done
00085D7B                          9879  * REM       . REM [any]                             * done
00085D7B                          9880  * STOP  . STOP                              * done
00085D7B                          9881  * ON        . ON <nexpr> {GOTO|GOSUB} <pint>[,<pint>[,<pint>]...]   * done
00085D7B                          9882  * NULL  . NULL <nexpr>                          * done
00085D7B                          9883  * INC       . INC <nvar>[,<nvar>[,<nvar>]...]               * done
00085D7B                          9884  * WAIT  . WAIT <nexpr>,<nexpr>[,<nexpr>]                * done
00085D7B                          9885  * LOAD  . LOAD [<sexpr>]                            * done for simulator
00085D7B                          9886  * SAVE  . SAVE [<sexpr>][,[<n>][-<n>]]              * done for simulator
00085D7B                          9887  * DEF       . DEF FN<var>(<var>)=<expr>                 * done
00085D7B                          9888  * POKE  . POKE <nexpr>,<nexpr>                      * done
00085D7B                          9889  * DOKE  . DOKE <nexpr>,<nexpr>                      * done
00085D7B                          9890  * LOKE  . LOKE <nexpr>,<nexpr>                      * done
00085D7B                          9891  * CALL  . CALL <nexpr>                          * done
00085D7B                          9892  * DO        . DO                                    * done
00085D7B                          9893  * LOOP  . LOOP [{WHILE|UNTIL}<nexpr>]                   * done
00085D7B                          9894  * PRINT . PRINT [{;|,}][expr][{;|,}[expr][{;|,}[expr]]...]  * done
00085D7B                          9895  * CONT  . CONT                              * done
00085D7B                          9896  * LIST  . LIST [pint][-pint]                        * done
00085D7B                          9897  * CLEAR . CLEAR                             * done
00085D7B                          9898  * NEW       . NEW                                   * done
00085D7B                          9899  * WIDTH . WIDTH [<pint>][,<pint>]                   * done
00085D7B                          9900  * GET       . GET <var>                             * done
00085D7B                          9901  * SWAP  . SWAP <var>,<var>                      * done
00085D7B                          9902  * BITSET    . BITSET <nexpr>,<nexpr>                    * done
00085D7B                          9903  * BITCLR    . BITCLR <nexpr>,<nexpr>                    * done
00085D7B                          9904  
00085D7B                          9905  * new graphics commands for EASy68k
00085D7B                          9906  
00085D7B                          9907  * BUFFER    . BUFFER                                * done
00085D7B                          9908  * CLS       . CLS                                   * done
00085D7B                          9909  * CURSOR    . CURSOR <nexpr>,<nexpr>                    * done
00085D7B                          9910  * LINE  . LINE <nexpr>,<nexpr>[,<nexpr>,<nexpr>][,][<nexpr>]    * done
00085D7B                          9911  * FILL  . FILL <nexpr>,<nexpr>[,][<nexpr>]              * done
00085D7B                          9912  * MOVE  . MOVE <nexpr>,<nexpr>                      * done
00085D7B                          9913  * POINT . POINT <nexpr>,<nexpr>[,][<nexpr>]             * done
00085D7B                          9914  * RECT  . RECT <nexpr>,<nexpr>[,<nexpr>,<nexpr>][,<nexpr>[,<nexpr>]]    * done
00085D7B                          9915  * RECTF . RECTF <nexpr>,<nexpr>[,<nexpr>,<nexpr>][,<nexpr>[,<nexpr>]]   * done
00085D7B                          9916  * ELLIPSE   . ELLIPSE <nexpr>,<nexpr>[,<nexpr>,<nexpr>][,<nexpr>[,<nexpr>]] * done
00085D7B                          9917  * ELLIPSEF  . ELLIPSEF <nexpr>,<nexpr>[,<nexpr>,<nexpr>][,<nexpr>[,<nexpr>]]    * done
00085D7B                          9918  * MODE  . MODE <pint>                           * done
00085D7B                          9919  * SIZE  . SIZE <pint>                           * done
00085D7B                          9920  
00085D7B                          9921  * sub commands (may not start a statement)
00085D7B                          9922  
00085D7B                          9923  * TAB       . TAB(<nexpr>)                          * done
00085D7B                          9924  * ELSE  . IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]    * done
00085D7B                          9925  * TO        . FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]      * done
00085D7B                          9926  * FN        . FN<var>(<expr>)                           * done
00085D7B                          9927  * SPC       . SPC(<nexpr>)                          * done
00085D7B                          9928  * THEN  . IF <nexpr> {THEN {pint|comm}|GOTO <pint>}     * done
00085D7B                          9929  * NOT       . NOT <nexpr>                           * done
00085D7B                          9930  * STEP  . FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]      * done
00085D7B                          9931  * UNTIL . LOOP [{WHILE|UNTIL}<nexpr>]                   * done
00085D7B                          9932  * WHILE . LOOP [{WHILE|UNTIL}<nexpr>]                   * done
00085D7B                          9933  
00085D7B                          9934  * operators
00085D7B                          9935  
00085D7B                          9936  * +     . [expr] + <expr>                           * done
00085D7B                          9937  * -     . [nexpr] - <nexpr>                     * done
00085D7B                          9938  * *     . <nexpr> * <nexpr>                     * done fast hardware
00085D7B                          9939  * /     . <nexpr> / <nexpr>                     * done fast hardware
00085D7B                          9940  * ^     . <nexpr> ^ <nexpr>                     * done
00085D7B                          9941  * AND       . <nexpr> AND <nexpr>                       * done
00085D7B                          9942  * EOR       . <nexpr> EOR <nexpr>                       * done
00085D7B                          9943  * OR        . <nexpr> OR <nexpr>                        * done
00085D7B                          9944  * >>        . <nexpr> >> <nexpr>                        * done
00085D7B                          9945  * <<        . <nexpr> << <nexpr>                        * done
00085D7B                          9946  
00085D7B                          9947  * compare functions
00085D7B                          9948  
00085D7B                          9949  * <     . <expr> < <expr>                           * done
00085D7B                          9950  * =     . <expr> = <expr>                           * done
00085D7B                          9951  * >     . <expr> > <expr>                           * done
