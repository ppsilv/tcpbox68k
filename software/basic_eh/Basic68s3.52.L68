00082400                           231  *************************************************************************************
00082400                           232  *
00082400                           233  * the following code is simulator specific, change to suit your system
00082400                           234  
00082400                           235  * output character to the console from register d0.b
00082400                           236  
00082400                           237  VEC_OUT
00082400  48E7 C000                238      MOVEM.l d0-d1,-(sp)         * save d0, d1
00082404  1200                     239      MOVE.b  d0,d1               * copy character
00082406  7006                     240      MOVEQ   #6,d0               * character out
00082408  4E4F                     241      TRAP    #15             * do I/O function
0008240A  4CDF 0003                242      MOVEM.l (sp)+,d0-d1         * restore d0, d1
0008240E  4E75                     243      RTS
00082410                           244  
00082410                           245  
00082410                           246  *************************************************************************************
00082410                           247  *
00082410                           248  * input a character from the console into register d0
00082410                           249  * else return Cb=0 if there's no character available
00082410                           250  
00082410                           251  VEC_IN
00082410  2F01                     252      MOVE.l  d1,-(sp)            * save d1
00082412  7007                     253      MOVEQ       #7,d0           * get the status
00082414  4E4F                     254      TRAP        #15             * do I/O function
00082416                           255  
00082416  1001                     256      MOVE.b  d1,d0               * copy the returned status
00082418  6606                     257      BNE.s       RETCHR          * if a character is waiting go get it
0008241A                           258  
0008241A  221F                     259      MOVE.l  (sp)+,d1            * else restore d1
0008241C  4A00                     260      TST.b       d0              * set the z flag
0008241E                           261  *   ANDI.b  #$FE,CCR            * clear the carry, flag we got no byte
0008241E                           262  *                           * done by the TST.b
0008241E  4E75                     263      RTS
00082420                           264  
00082420                           265  RETCHR
00082420  7005                     266      MOVEQ       #5,d0               * get byte form the keyboard
00082422  4E4F                     267      TRAP        #15             * do I/O function
00082424                           268  
00082424  1001                     269      MOVE.b  d1,d0               * copy the returned byte
00082426  221F                     270      MOVE.l  (sp)+,d1            * restore d1
00082428  4A00                     271      TST.b       d0              * set the z flag on the received byte
0008242A  003C 0001                272      ORI.b       #1,CCR          * set the carry, flag we got a byte
0008242E  4E75                     273      RTS
00082430                           274  
00082430                           275  
00082430                           276  *************************************************************************************
00082430                           277  *
