00082466  43EB 05EB                303      LEA     file_byte(a3),a1        * point to byte buffer
0008246A  7401                     304      MOVEQ       #1,d2               * set count for one byte
0008246C  7035                     305      MOVEQ       #53,d0          * read from file
0008246E  4E4F                     306      TRAP        #15             * do I/O function
00082470                           307  
00082470  4A40                     308      TST.w       d0              * test status
00082472  660C                     309      BNE.s       LOAD_eof            * branch if byte read failed
00082474                           310  
