0008249A                           331  *************************************************************************************
0008249A                           332  *
0008249A                           333  * get the filename from the line or from the filename requester
0008249A                           334  *
0008249A                           335  * if the name is null, "", or there is nothing following then the requester is used
0008249A                           336  * to get a filename else the filename is got from the line. if the requester is used
0008249A                           337  * the name buffer is allocated in string space and is always null terminated before
0008249A                           338  * it is passed to the file requester
0008249A                           339  
0008249A                           340  get_filename
0008249A  6740                     341      BEQ.s       get_name            * if no following go use the requester
0008249C                           342  
0008249C                           343  get_file
0008249C  2F09                     344      MOVE.l  a1,-(sp)            * save the title string pointer
0008249E  534D                     345      SUBQ.w  #1,a5               * decrement the execute pointer
000824A0  6100 0E0A                346      BSR     LAB_GVAL            * get value from line
000824A4  225F                     347      MOVEA.l (sp)+,a1            * restore the title string pointer
000824A6  4A2B 05B5                348      TST.b       Dtypef(a3)          * test the data type flag
000824AA  6A00 01E2                349      BPL     LAB_TMER            * if not string type do type mismatch error
000824AE                           350  
000824AE  246B 0590                351      MOVEA.l FAC1_m(a3),a2       * get the descriptor pointer
000824B2  322A 0004                352      MOVE.w  4(a2),d1            * get the string length
000824B6  6724                     353      BEQ.s       get_name            * if null go use the file requester
000824B8                           354  
000824B8  2252                     355      MOVEA.l (a2),a1         * get the string pointer
000824BA  3001                     356      MOVE.w  d1,d0               * copy the string length
000824BC  5241                     357      ADDQ.w  #1,d1               * increment the string length
000824BE  6100 14BC                358      BSR     LAB_2115            * make space d1 bytes long
000824C2                           359  
000824C2  11BC 0000 0000           360      MOVE.b  #$00,(a0,d0.w)      * null terminate the new string
000824C8  5340                     361      SUBQ.w  #1,d0               * decrement the string length
000824CA                           362  name_copy
000824CA  11B1 0000 0000           363      MOVE.b  (a1,d0.w),(a0,d0.w) * copy a file name byte
000824D0  51C8 FFF8                364      DBF     d0,name_copy        * loop while more to do
000824D4                           365  
000824D4  2248                     366      MOVEA.l a0,a1               * copy the new, terminated, file name pointer
000824D6                           367  
000824D6  204A                     368      MOVEA.l a2,a0               * copy the old filename descriptor pointer
000824D8  6000 1636                369      BRA     LAB_22B6            * pop string off descriptor stack or from memory
000824DC                           370                              * returns with d0 = length, a0 = pointer
000824DC                           371  
