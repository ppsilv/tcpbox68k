                            	  9209: 
                            	  9210: 
                            	  9211: *************************************************************************************
                            	  9212: * EhBASIC keywords quick reference list								*
                            	  9213: *************************************************************************************
                            	  9214: 
                            	  9215: * glossary
                            	  9216: 
                            	  9217: *		<.>		  required
                            	  9218: *		{.|.}		  one of required
                            	  9219: *		[.]		  optional
                            	  9220: *		...		  may repeat as last
                            	  9221: 
                            	  9222: *		any		= anything
                            	  9223: *		num		= number
                            	  9224: *		state		= statement
                            	  9225: *		n		= positive integer
                            	  9226: *		str		= string
                            	  9227: *		var		= variable
                            	  9228: *		nvar		= numeric variable
                            	  9229: *		svar		= string variable
                            	  9230: *		expr		= expression
                            	  9231: *		nexpr		= numeric expression
                            	  9232: *		sexpr		= string expression
                            	  9233: 
                            	  9234: * statement separator
                            	  9235: 
                            	  9236: * :		. [<state>] : [<state>]						* done
                            	  9237: 
                            	  9238: * number bases
                            	  9239: 
                            	  9240: * %		. %<binary num>							* done
                            	  9241: * $		. $<hex num>							* done
                            	  9242: 
                            	  9243: * commands
                            	  9244: 
                            	  9245: * END		. END									* done
                            	  9246: * FOR		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9247: * NEXT	. NEXT [<nvar>[,<nvar>]...]					* done
                            	  9248: * DATA	. DATA [{num|["]str["]}[,{num|["]str["]}]...]		* done
                            	  9249: * INPUT	. INPUT [<">str<">;] <var>[,<var>[,<var>]...]		* done
                            	  9250: * DIM		. DIM <var>(<nexpr>[,<nexpr>[,<nexpr>]])			* done
                            	  9251: * READ	. READ <var>[,<var>[,<var>]...]				* done
                            	  9252: * LET		. [LET] <var>=<expr>						* done
                            	  9253: * DEC		. DEC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9254: * GOTO	. GOTO <n>								* done
                            	  9255: * RUN		. RUN [<n>]								* done
                            	  9256: * IF		. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9257: * RESTORE	. RESTORE [<n>]							* done
                            	  9258: * GOSUB	. GOSUB <n>								* done
                            	  9259: * RETURN	. RETURN								* done
                            	  9260: * REM		. REM [<any>]							* done
                            	  9261: * STOP	. STOP								* done
                            	  9262: * ON		. ON <nexpr>{GOTO|GOSUB}<n>[,<n>[,<n>]...]		* done
                            	  9263: * NULL	. NULL <nexpr>							* done
                            	  9264: * INC		. INC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9265: * WAIT	. WAIT <nexpr>,<nexpr>[,<nexpr>]				* done
                            	  9266: * LOAD	. LOAD [<sexpr>]							* done for sim
                            	  9267: * SAVE	. SAVE [<sexpr>][,[<n>][-<n>]]				* done for sim
                            	  9268: * DEF		. DEF FN<var>(<var>)=<expr>					* done
                            	  9269: * POKE	. POKE <nexpr>,<nexpr>						* done
                            	  9270: * DOKE	. DOKE <nexpr>,<nexpr>						* done
                            	  9271: * LOKE	. LOKE <nexpr>,<nexpr>						* done
                            	  9272: * CALL	. CALL <nexpr>							* done
                            	  9273: * DO		. DO									* done
                            	  9274: * LOOP	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9275: * PRINT	. PRINT [{;|,}][<expr>][{;|,}[<expr>]...]			* done
                            	  9276: * CONT	. CONT								* done
                            	  9277: * LIST	. LIST [<n>][-<n>]						* done
                            	  9278: * CLEAR	. CLEAR								* done
                            	  9279: * NEW		. NEW									* done
                            	  9280: * WIDTH	. WIDTH [<n>][,<n>]						* done
                            	  9281: * GET		. GET <var>								* done
                            	  9282: * SWAP	. SWAP <var>,<var>						* done
                            	  9283: * BITSET	. BITSET <nexpr>,<nexpr>					* done
                            	  9284: * BITCLR	. BITCLR <nexpr>,<nexpr>					* done
                            	  9285: 
                            	  9286: * sub commands (may not start a statement)
                            	  9287: 
                            	  9288: * TAB		. TAB(<nexpr>)							* done
                            	  9289: * ELSE	. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9290: * TO		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9291: * FN		. FN <var>(<expr>)						* done
                            	  9292: * SPC		. SPC(<nexpr>)							* done
                            	  9293: * THEN	. IF <nexpr> {THEN <{n|comm}>|GOTO <n>}			* done
                            	  9294: * NOT		. NOT <nexpr>							* done
                            	  9295: * STEP	. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9296: * UNTIL	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9297: * WHILE	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9298: 
                            	  9299: * operators
                            	  9300: 
                            	  9301: * +		. [expr] + <expr>							* done
                            	  9302: * -		. [nexpr] - <nexpr>						* done
                            	  9303: * *		. <nexpr> * <nexpr>						* done fast hardware
                            	  9304: * /		. <nexpr> / <nexpr>						* done fast hardware
                            	  9305: * ^		. <nexpr> ^ <nexpr>						* done
                            	  9306: * AND		. <nexpr> AND <nexpr>						* done
                            	  9307: * EOR		. <nexpr> EOR <nexpr>						* done
                            	  9308: * OR		. <nexpr> OR <nexpr>						* done
                            	  9309: * >>		. <nexpr> >> <nexpr>						* done
                            	  9310: * <<		. <nexpr> << <nexpr>						* done
                            	  9311: 
                            	  9312: * compare functions
                            	  9313: 
                            	  9314: * <		. <expr> < <expr>							* done
                            	  9315: * =		. <expr> = <expr>							* done
                            	  9316: * >		. <expr> > <expr>							* done
                            	  9317: 
                            	  9318: * functions
                            	  9319: 
                            	  9320: * SGN		. SGN(<nexpr>)							* done
                            	  9321: * INT		. INT(<nexpr>)							* done
                            	  9322: * ABS		. ABS(<nexpr>)							* done
                            	  9323: * USR		. USR(<expr>)							* done
                            	  9324: * FRE		. FRE(<expr>)							* done
                            	  9325: * POS		. POS(<expr>)							* done
                            	  9326: * SQR		. SQR(<nexpr>)							* done fast shift/sub
                            	  9327: * RND		. RND(<nexpr>)							* done 32 bit PRNG
                            	  9328: * LOG		. LOG(<nexpr>)							* done fast cordic
                            	  9329: * EXP		. EXP(<nexpr>)							* done fast cordic
                            	  9330: * COS		. COS(<nexpr>)							* done fast cordic
                            	  9331: * SIN		. SIN(<nexpr>)							* done fast cordic
                            	  9332: * TAN		. TAN(<nexpr>)							* done fast cordic
                            	  9333: * ATN		. ATN(<nexpr>)							* done fast cordic
                            	  9334: * PEEK	. PEEK(<nexpr>)							* done
                            	  9335: * DEEK	. DEEK(<nexpr>)							* done
                            	  9336: * LEEK	. LEEK(<nexpr>)							* done
                            	  9337: * LEN		. LEN(<sexpr>)							* done
                            	  9338: * STR$	. STR$(<nexpr>)							* done
                            	  9339: * VAL		. VAL(<sexpr>)							* done
                            	  9340: * ASC		. ASC(<sexpr>)							* done
                            	  9341: * UCASE$	. UCASE$(<sexpr>)							* done
                            	  9342: * LCASE$	. LCASE$(<sexpr>)							* done
                            	  9343: * CHR$	. CHR$(<nexpr>)							* done
                            	  9344: * HEX$	. HEX$(<nexpr>)							* done
                            	  9345: * BIN$	. BIN$(<nexpr>)							* done
                            	  9346: * BTST	. BTST(<nexpr>,<nexpr>)						* done
                            	  9347: * MAX		. MAX(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9348: * MIN		. MIN(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9349: * PI		. PI									* done
                            	  9350: * TWOPI	. TWOPI								* done
                            	  9351: * VARPTR	. VARPTR(<var>)							* done
                            	  9352: * SADD	. SADD(<svar>)							* done
                            	  9353: * LEFT$	. LEFT$(<sexpr>,<nexpr>)					* done
                            	  9354: * RIGHT$	. RIGHT$(<sexpr>,<nexpr>)					* done
                            	  9355: * MID$	. MID$(<sexpr>,<nexpr>[,<nexpr>])				* done
                            	  9356: * USING$	. USING$(<sexpr>,<nexpr>[,<nexpr>]...])			* done
                            	  9357: 
                            	  9358: 
                            	  9359: *************************************************************************************
                            	  9360: 
                            	  9361: 	END	code_start
