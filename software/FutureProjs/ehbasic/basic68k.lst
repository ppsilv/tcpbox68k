                            	  6436: 
                            	  6437: *************************************************************************************
                            	  6438: *
                            	  6439: * RND(n), 32 bit Galois version. make n=0 for 19th next number in sequence or n<>0
                            	  6440: * to get 19th next number in sequence after seed n. This version of the PRNG uses
                            	  6441: * the Galois method and a sample of 65536 bytes produced gives the following values.
                            	  6442: 
                            	  6443: * Entropy = 7.997442 bits per byte
                            	  6444: * Optimum compression would reduce these 65536 bytes by 0 percent
                            	  6445: 
                            	  6446: * Chi square distribution for 65536 samples is 232.01, and
                            	  6447: * randomly would exceed this value 75.00 percent of the time
                            	  6448: 
                            	  6449: * Arithmetic mean value of data bytes is 127.6724, 127.5 would be random
                            	  6450: * Monte Carlo value for Pi is 3.122871269, error 0.60 percent
                            	  6451: * Serial correlation coefficient is -0.000370, totally uncorrelated would be 0.0
                            	  6452: 
                            	  6453: LAB_RND
01:000840EE 4A2B1EDC        	  6454: 	TST.b		FAC1_e(a3)			* get FAC1 exponent
01:000840F2 670C            	  6455: 	BEQ.s		NextPRN			* do next random number if zero
                            	  6456: 
                            	  6457: 							* else get seed into random number store
01:000840F4 204BD1FC00081EE8	  6458: 	LEA		PRNlword(a3),a0		* set PRNG pointer
01:000840FC 6100FA9E        	  6459: 	BSR		LAB_2778			* pack FAC1 into (a0)
                            	  6460: NextPRN
01:00084100 72AF            	  6461: 	MOVEQ		#$AF-$100,d1		* set EOR value
01:00084102 7412            	  6462: 	MOVEQ		#18,d2			* do this 19 times
01:00084104 202B1EE8        	  6463: 	MOVE.l	PRNlword(a3),d0		* get current
                            	  6464: Ninc0
01:00084108 D080            	  6465: 	ADD.l		d0,d0				* shift left 1 bit
01:0008410A 6402            	  6466: 	BCC.s		Ninc1				* branch if bit 32 not set
                            	  6467: 
01:0008410C B300            	  6468: 	EOR.b		d1,d0				* do Galois LFSR feedback
                            	  6469: Ninc1
01:0008410E 51CAFFF8        	  6470: 	DBF		d2,Ninc0			* loop
                            	  6471: 
01:00084112 27401EE8        	  6472: 	MOVE.l	d0,PRNlword(a3)		* save back to seed word
01:00084116 27401ED8        	  6473: 	MOVE.l	d0,FAC1_m(a3)		* copy to FAC1 mantissa
01:0008411A 377C80001EDC    	  6474: 	MOVE.w	#$8000,FAC1_e(a3)		* set the exponent and clear the sign
01:00084120 6000F7DE        	  6475: 	BRA		LAB_24D5			* normalise FAC1 & return
                            	  6476: 
