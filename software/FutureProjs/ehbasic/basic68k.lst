01:00083BFC 7000            	  5698: 	MOVEQ		#0,d0				* clear d0
01:00083BFE 102B1EDC        	  5699: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00083C02 67F6            	  5700: 	BEQ.s		RTS_017			* exit if zero (already correct SGN(0)=0)
                            	  5701: 
                            	  5702: 
                            	  5703: *************************************************************************************
                            	  5704: *
                            	  5705: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
