                            	  3316: 
                            	  3317: LAB_CASC
01:00082F8A B03C0061        	  3318: 	CMP.b		#$61,d0			* compare with "a"
01:00082F8E 6410            	  3319: 	BCC.s		LAB_1D83			* if >="a" go check =<"z"
                            	  3320: 
                            	  3321: 
                            	  3322: *************************************************************************************
                            	  3323: *
