01:00082F7E 61000C42        	  3305: 	BSR		LAB_279B			* copy FAC2 to FAC1, get first value in
                            	  3306: 							* expression
01:00082F82 6100016E        	  3307: 	BSR		LAB_EVIR			* evaluate integer expression (no sign check)
                            	  3308: 							* result in d0 and Itemp
01:00082F86 4A02            	  3309: 	TST.b		d2				* test byte value
01:00082F88 4E75            	  3310: 	RTS
