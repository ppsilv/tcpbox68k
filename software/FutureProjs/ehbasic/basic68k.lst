                            	  7110: 
                            	  7111: * now check for any tail on the format string
                            	  7112: 
01:00084554 302F0004        	  7113: 	MOVE.w	fsti(sp),d0			* get this index
01:00084558 6720            	  7114: 	BEQ.s		LAB_U04C			* if at start of string skip the output
                            	  7115: 
01:0008455A 3F400006        	  7116: 	MOVE.w	d0,fsli(sp)			* save this index to the last index
01:0008455E 61000082        	  7117: 	BSR		LAB_ProcFo			* now process the format string
01:00084562 4A02            	  7118: 	TST.b		d2				* test the special characters flag
01:00084564 6614            	  7119: 	BNE.s		LAB_U04C			* if special characters present skip the output
                            	  7120: 
                            	  7121: * else output the new string part
                            	  7122: 
01:00084566 613C            	  7123: 	BSR.s		LAB_DupFmt			* duplicate the processed format string section
01:00084568 3F6F00040006    	  7124: 	MOVE.w	fsti(sp),fsli(sp)		* copy this index to the last index
                            	  7125: 
                            	  7126: * add the new string to the previous string
                            	  7127: 
01:0008456E 41EC0006        	  7128: 	LEA		6(a4),a0			* get the descriptor pointer for string 1
01:00084572 274C1ED8        	  7129: 	MOVE.l	a4,FAC1_m(a3)		* save the descriptor pointer for string 2
01:00084576 6100EFD2        	  7130: 	BSR		LAB_224E			* concatenate the strings
                            	  7131: 
                            	  7132: * check for another value or end of function
                            	  7133: 
                            	  7134: LAB_U04C
01:0008457A 101D            	  7135: 	MOVE.b	(a5)+,d0			* get the next BASIC byte
01:0008457C B03C0029        	  7136: 	CMP.b		#')',d0			* compare with close bracket
01:00084580 6600FDC6        	  7137: 	BNE		LAB_U002			* if not ")" go do next value
                            	  7138: 
                            	  7139: * pop the result string off the descriptor stack
                            	  7140: 
01:00084584 204C            	  7141: 	MOVEA.l	a4,a0				* copy the result string descriptor pointer
01:00084586 222B1446        	  7142: 	MOVE.l	Sstorl(a3),d1		* save the bottom of string space
01:0008458A 6100F020        	  7143: 	BSR		LAB_22BA			* pop (a0) descriptor, returns with ..
                            	  7144: 							* d0 = length, a0 = pointer
01:0008458E 27411446        	  7145: 	MOVE.l	d1,Sstorl(a3)		* restore the bottom of string space
01:00084592 2248            	  7146: 	MOVEA.l	a0,a1				* copy the string result pointer
01:00084594 3200            	  7147: 	MOVE.w	d0,d1				* copy the string result length
                            	  7148: 
                            	  7149: * pop the format string off the descriptor stack
                            	  7150: 
01:00084596 205F            	  7151: 	MOVEA.l	(sp)+,a0			* pull the format string descriptor pointer
01:00084598 6100F012        	  7152: 	BSR		LAB_22BA			* pop (a0) descriptor, returns with ..
                            	  7153: 							* d0 = length, a0 = pointer
                            	  7154: 
01:0008459C 508F            	  7155: 	LEA		fend(sp),sp			* dump the saved values
                            	  7156: 
                            	  7157: * push the result string back on the descriptor stack and return
                            	  7158: 
01:0008459E 2049            	  7159: 	MOVEA.l	a1,a0				* copy the result string pointer back
01:000845A0 6000EE60        	  7160: 	BRA		LAB_RTST			* push a string on the descriptor stack and
                            	  7161: 							* return. a0 = pointer, d1 = length
                            	  7162: 
                            	  7163: 
                            	  7164: *************************************************************************************
                            	  7165: *
                            	  7166: * duplicate the processed format string section
                            	  7167: 
                            	  7168: 							* make a string as long as the format string
                            	  7169: LAB_DupFmt
01:000845A4 226F0004        	  7170: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:000845A8 3E290004        	  7171: 	MOVE.w	4(a1),d7			* get the format string length
01:000845AC 342F000A        	  7172: 	MOVE.w	4+fsli(sp),d2		* get the format string last index
01:000845B0 3C2F0008        	  7173: 	MOVE.w	4+fsti(sp),d6		* get the format string this index
01:000845B4 3206            	  7174: 	MOVE.w	d6,d1				* copy the format string this index
01:000845B6 9242            	  7175: 	SUB.w		d2,d1				* subtract the format string last index
01:000845B8 6202            	  7176: 	BHI.s		LAB_D002			* if > 0 skip the correction
                            	  7177: 
01:000845BA D247            	  7178: 	ADD.w		d7,d1				* else add the format string length as the
                            	  7179: 							* correction
                            	  7180: LAB_D002
01:000845BC 6100EE5E        	  7181: 	BSR		LAB_2115			* make string space d1 bytes long
                            	  7182: 							* return a0/Sutill = pointer, others unchanged
                            	  7183: 
                            	  7184: * push the new string on the descriptor stack
                            	  7185: 
01:000845C0 6100EE40        	  7186: 	BSR		LAB_RTST			* push a string on the descriptor stack and
                            	  7187: 							* return. a0 = pointer, d1 = length
                            	  7188: 
                            	  7189: * copy the characters from the format string
                            	  7190: 
01:000845C4 226F0004        	  7191: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:000845C8 2251            	  7192: 	MOVEA.l	(a1),a1			* get the format string pointer
01:000845CA 7800            	  7193: 	MOVEQ		#0,d4				* clear the new string index
                            	  7194: LAB_D00A
01:000845CC 11B120004000    	  7195: 	MOVE.b	(a1,d2.w),(a0,d4.w)	* get a character from the format string and
                            	  7196: 							* save it to the new string
01:000845D2 5244            	  7197: 	ADDQ.w	#1,d4				* increment the new string index
01:000845D4 5242            	  7198: 	ADDQ.w	#1,d2				* increment the format string index
01:000845D6 BE42            	  7199: 	CMP.w		d2,d7				* compare the format index with the length
01:000845D8 6602            	  7200: 	BNE.s		LAB_D00E			* if not there skip the reset
                            	  7201: 
01:000845DA 7400            	  7202: 	MOVEQ		#0,d2				* else reset the format string index
                            	  7203: LAB_D00E
01:000845DC BC42            	  7204: 	CMP.w		d2,d6				* compare the index with this index
01:000845DE 66EC            	  7205: 	BNE.s		LAB_D00A			* if not equal go do the next character
                            	  7206: 
01:000845E0 4E75            	  7207: 	RTS
                            	  7208: 
                            	  7209: 
                            	  7210: **************************************************************************************
                            	  7211: *
                            	  7212: * process the format string
                            	  7213: 
                            	  7214: LAB_ProcFo
01:000845E2 226F0004        	  7215: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:000845E6 3E290004        	  7216: 	MOVE.w	4(a1),d7			* get the format string length
01:000845EA 2251            	  7217: 	MOVEA.l	(a1),a1			* get the format string pointer
01:000845EC 3C2F000A        	  7218: 	MOVE.w	4+fsli(sp),d6		* get the format string last index
                            	  7219: 
01:000845F0 3F47000C        	  7220: 	MOVE.w	d7,4+fsdpi(sp)		* set the format string decimal point index
                            	  7221: *##	MOVE.w	#-1,4+fsdpi(sp)		* set the format string decimal point index
01:000845F4 7A00            	  7222: 	MOVEQ		#0,d5				* no decimal point
01:000845F6 7600            	  7223: 	MOVEQ		#0,d3				* no decimal characters
01:000845F8 7400            	  7224: 	MOVEQ		#0,d2				* no special characters
                            	  7225: LAB_P004
01:000845FA 10316000        	  7226: 	MOVE.b	(a1,d6.w),d0		* get a format string byte
                            	  7227: 
01:000845FE B03C002C        	  7228: 	CMP.b		#',',d0			* compare it with ","
01:00084602 6742            	  7229: 	BEQ.s		LAB_P01A			* if "," go do the next format string byte
                            	  7230: 
01:00084604 B03C0023        	  7231: 	CMP.b		#'#',d0			* compare it with "#"
01:00084608 6706            	  7232: 	BEQ.s		LAB_P008			* if "#" go flag special characters
                            	  7233: 
01:0008460A B03C0025        	  7234: 	CMP.b		#'%',d0			* compare it with "%"
01:0008460E 6608            	  7235: 	BNE.s		LAB_P00C			* if not "%" go try "+"
                            	  7236: 
                            	  7237: LAB_P008
01:00084610 4A85            	  7238: 	TST.l		d5				* test the decimal point flag
01:00084612 6A10            	  7239: 	BPL.s		LAB_P00E			* if no point skip counting decimal characters
                            	  7240: 
01:00084614 5243            	  7241: 	ADDQ.w	#1,d3				* else increment the decimal character count
01:00084616 602E            	  7242: 	BRA.s		LAB_P01A			* go do the next character
                            	  7243: 
                            	  7244: LAB_P00C
01:00084618 B03C002B        	  7245: 	CMP.b		#'+',d0			* compare it with "+"
01:0008461C 6706            	  7246: 	BEQ.s		LAB_P00E			* if "+" go flag special characters
                            	  7247: 
01:0008461E B03C002D        	  7248: 	CMP.b		#'-',d0			* compare it with "-"
01:00084622 6604            	  7249: 	BNE.s		LAB_P010			* if not "-" go check decimal point
                            	  7250: 
                            	  7251: LAB_P00E
01:00084624 8400            	  7252: 	OR.b		d0,d2				* flag special characters
01:00084626 601E            	  7253: 	BRA.s		LAB_P01A			* go do the next character
                            	  7254: 
                            	  7255: LAB_P010
01:00084628 B03C002E        	  7256: 	CMP.b		#'.',d0			* compare it with "."
01:0008462C 6614            	  7257: 	BNE.s		LAB_P018			* if not "." go check next
                            	  7258: 
                            	  7259: * "." a decimal point
                            	  7260: 
01:0008462E 4A85            	  7261: 	TST.l		d5				* if there is already a decimal point
01:00084630 6B14            	  7262: 	BMI.s		LAB_P01A			* go do the next character
                            	  7263: 
01:00084632 3006            	  7264: 	MOVE.w	d6,d0				* copy the decimal point index
01:00084634 906F000A        	  7265: 	SUB.w		4+fsli(sp),d0		* calculate it from the scan start
01:00084638 3F40000C        	  7266: 	MOVE.w	d0,4+fsdpi(sp)		* save the decimal point index
01:0008463C 7AFF            	  7267: 	MOVEQ		#-1,d5			* flag decimal point
01:0008463E 8400            	  7268: 	OR.b		d0,d2				* flag special characters
01:00084640 6004            	  7269: 	BRA.s		LAB_P01A			* go do the next character
                            	  7270: 
                            	  7271: * was not a special character
                            	  7272: 
                            	  7273: LAB_P018
01:00084642 4A02            	  7274: 	TST.b		d2				* test if there have been special characters
01:00084644 6608            	  7275: 	BNE.s		LAB_P01E			* if so exit the format string process
                            	  7276: 
                            	  7277: LAB_P01A
01:00084646 5246            	  7278: 	ADDQ.w	#1,d6				* increment the format string index
01:00084648 BE46            	  7279: 	CMP.w		d6,d7				* compare it with the format string length
01:0008464A 62AE            	  7280: 	BHI.s		LAB_P004			* if length > index go get the next character
                            	  7281: 
01:0008464C 7C00            	  7282: 	MOVEQ		#0,d6				* length = index so reset the format string
                            	  7283: 							* index
                            	  7284: LAB_P01E
01:0008464E 3F460008        	  7285: 	MOVE.w	d6,4+fsti(sp)		* save the format string this index
01:00084652 3F43000E        	  7286: 	MOVE.w	d3,4+fsdc(sp)		* save the format string decimal characters
                            	  7287: 
01:00084656 4E75            	  7288: 	RTS
