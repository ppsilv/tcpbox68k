                            	  7372: *************************************************************************************
                            	  7373: *
                            	  7374: * ctrl-c check routine. includes limited "life" byte save for INGET routine
                            	  7375: 
                            	  7376: VEC_CC
01:000846E0 4A2B1F30        	  7377: 	TST.b		ccflag(a3)			* check [CTRL-C] check flag
01:000846E4 661E            	  7378: 	BNE.s		RTS_022			* exit if [CTRL-C] check inhibited
                            	  7379: 
01:000846E6 4EAB140C        	  7380: 	JSR		V_INPT(a3)			* scan input device
01:000846EA 640E            	  7381: 	BCC.s		LAB_FBA0			* exit if buffer empty
                            	  7382: 
01:000846EC 17401F31        	  7383: 	MOVE.b	d0,ccbyte(a3)		* save received byte
01:000846F0 177C00201F32    	  7384: 	MOVE.b	#$20,ccnull(a3)		* set "life" timer for bytes countdown
01:000846F6 6000DECA        	  7385: 	BRA		LAB_1636			* return to BASIC
                            	  7386: 
                            	  7387: LAB_FBA0
01:000846FA 4A2B1F32        	  7388: 	TST.b		ccnull(a3)			* get countdown byte
01:000846FE 6704            	  7389: 	BEQ.s		RTS_022			* exit if finished
                            	  7390: 
01:00084700 532B1F32        	  7391: 	SUBQ.b	#1,ccnull(a3)		* else decrement countdown
                            	  7392: RTS_022
01:00084704 4E75            	  7393: 	RTS
                            	  7394: 
                            	  7395: 
                            	  7396: *************************************************************************************
                            	  7397: *
                            	  7398: * get byte from input device, no waiting
                            	  7399: * returns with carry set if byte in A
                            	  7400: 
                            	  7401: INGET
01:00084706 4EAB140C        	  7402: 	JSR		V_INPT(a3)			* call scan input device
01:0008470A 650A            	  7403: 	BCS.s		LAB_FB95			* if byte go reset timer
                            	  7404: 
01:0008470C 102B1F32        	  7405: 	MOVE.b	ccnull(a3),d0		* get countdown
01:00084710 67F2            	  7406: 	BEQ.s		RTS_022			* exit if empty
                            	  7407: 
01:00084712 102B1F31        	  7408: 	MOVE.b	ccbyte(a3),d0		* get last received byte
                            	  7409: LAB_FB95
01:00084716 177C00001F32    	  7410: 	MOVE.b	#$00,ccnull(a3)		* clear timer because we got a byte
01:0008471C 003C0001        	  7411: 	ORI.b		#1,CCR			* set carry, flag we got a byte
01:00084720 4E75            	  7412: 	RTS
