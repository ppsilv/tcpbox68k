                            	  7291: *************************************************************************************
                            	  7292: *
                            	  7293: * perform BIN$()
                            	  7294: * # of leading 0s is in d1, the number is in d0
                            	  7295: 
                            	  7296: LAB_BINS
01:00084658 B23C0021        	  7297: 	CMP.b		#$21,d1			* max + 1
01:0008465C 6400DAE6        	  7298: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7299: 
01:00084660 741F            	  7300: 	MOVEQ		#$1F,d2			* bit count-1
01:00084662 204BD1FC00081EFE	  7301: 	LEA		Binss(a3),a0		* point to string
01:0008466A 7830            	  7302: 	MOVEQ		#$30,d4			* "0" character for ADDX
                            	  7303: NextB1
01:0008466C 7600            	  7304: 	MOVEQ		#0,d3				* clear byte
01:0008466E E288            	  7305: 	LSR.l		#1,d0				* shift bit into Xb
01:00084670 D704            	  7306: 	ADDX.b	d4,d3				* add carry and character to zero
01:00084672 11832000        	  7307: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:00084676 51CAFFF4        	  7308: 	DBF		d2,NextB1			* decrement and loop if not done
                            	  7309: 
                            	  7310: * this is the exit code and is also used by HEX$()
                            	  7311: 
                            	  7312: EndBHS
01:0008467A 177C00001F1E    	  7313: 	MOVE.b	#0,BHsend(a3)		* null terminate the string
01:00084680 4A01            	  7314: 	TST.b		d1				* test # of characters
01:00084682 670E            	  7315: 	BEQ.s		NextB2			* go truncate string
                            	  7316: 
01:00084684 4481            	  7317: 	NEG.l		d1				* make -ve
01:00084686 D2BC00081F1E    	  7318: 	ADD.l		#BHsend,d1			* effectively (end-length)
01:0008468C 41F31000        	  7319: 	LEA		0(a3,d1.w),a0		* effectively add (end-length) to pointer
01:00084690 600E            	  7320: 	BRA.s		BinPr				* go print string
                            	  7321: 
                            	  7322: * truncate string to remove leading "0"s
                            	  7323: 
                            	  7324: NextB2
01:00084692 1010            	  7325: 	MOVE.b	(a0),d0			* get byte
01:00084694 670A            	  7326: 	BEQ.s		BinPr				* if null then end of string so add 1 and go
                            	  7327: 							* print it
                            	  7328: 
01:00084696 B03C0030        	  7329: 	CMP.b		#'0',d0			* compare with "0"
01:0008469A 6612            	  7330: 	BNE.s		GoPr				* if not "0" then go print string from here
                            	  7331: 
01:0008469C 5248            	  7332: 	ADDQ.w	#1,a0				* else increment pointer
01:0008469E 60F2            	  7333: 	BRA.s		NextB2			* loop always
                            	  7334: 
                            	  7335: * make fixed length output string - ignore overflows!
                            	  7336: 
                            	  7337: BinPr
01:000846A0 224BD3FC00081F1E	  7338: 	LEA		BHsend(a3),a1		* get string end
01:000846A8 B1C9            	  7339: 	CMPA.l	a1,a0				* are we at the string end
01:000846AA 6602            	  7340: 	BNE.s		GoPr				* branch if not
                            	  7341: 
01:000846AC 5348            	  7342: 	SUBQ.w	#1,a0				* else need at least one zero
                            	  7343: GoPr
01:000846AE 6000ED0C        	  7344: 	BRA		LAB_20AE			* print " terminated string to FAC1, stack & RET
                            	  7345: 
