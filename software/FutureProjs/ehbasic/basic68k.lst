01:00084792 B03C002C        	  7495: 	CMP.b		#',',d0			* is next byte ","
01:00084796 672C            	  7496: 	BEQ.s		LAB_TBSZ			* if so do tab size
                            	  7497: 
01:00084798 6100EF6E        	  7498: 	BSR		LAB_GTBY			* get byte parameter, result in d0 and Itemp
01:0008479C 4A00            	  7499: 	TST.b		d0				* test result
01:0008479E 6712            	  7500: 	BEQ.s		LAB_NSTT			* branch if set for infinite line
                            	  7501: 
01:000847A0 B03C0010        	  7502: 	CMP.b		#$10,d0			* else make min width = 16d
01:000847A4 6500D99E        	  7503: 	BCS		LAB_FCER			* if less do function call error & exit
                            	  7504: 
