                            	  5869: 
                            	  5870: 
                            	  5871: *************************************************************************************
                            	  5872: *
                            	  5873: * print d0 as unsigned integer
                            	  5874: 
                            	  5875: LAB_295E
01:00083CBC 43FA0E06        	  5876: 	LEA		Bin2dec,a1		* get table address
01:00083CC0 7200            	  5877: 	MOVEQ		#0,d1				* table index
01:00083CC2 204BD1FC00081F14	  5878: 	LEA		Usdss(a3),a0		* output string start
01:00083CCA 2401            	  5879: 	MOVE.l	d1,d2				* output string index
                            	  5880: LAB_2967
01:00083CCC 26311000        	  5881: 	MOVE.l	(a1,d1.w),d3		* get table value
01:00083CD0 6714            	  5882: 	BEQ.s		LAB_2969			* exit if end marker
                            	  5883: 
01:00083CD2 782F            	  5884: 	MOVEQ		#'0'-1,d4			* set character to "0"-1
                            	  5885: LAB_2968
01:00083CD4 5244            	  5886: 	ADDQ.w	#1,d4				* next numeric character
01:00083CD6 9083            	  5887: 	SUB.l		d3,d0				* subtract table value
01:00083CD8 6AFA            	  5888: 	BPL.s		LAB_2968			* not overdone so loop
                            	  5889: 
01:00083CDA D083            	  5890: 	ADD.l		d3,d0				* correct value
01:00083CDC 11842000        	  5891: 	MOVE.b	d4,(a0,d2.w)		* character out to string
01:00083CE0 5841            	  5892: 	ADDQ.w	#4,d1				* increment table pointer
01:00083CE2 5242            	  5893: 	ADDQ.w	#1,d2				* increment output string pointer
01:00083CE4 60E6            	  5894: 	BRA.s		LAB_2967			* loop
                            	  5895: 
                            	  5896: LAB_2969
01:00083CE6 D03C0030        	  5897: 	ADD.b		#'0',d0			* make last character
01:00083CEA 11802000        	  5898: 	MOVE.b	d0,(a0,d2.w)		* character out to string
01:00083CEE 5348            	  5899: 	SUBQ.w	#1,a0				* decrement a0 (allow simple loop)
                            	  5900: 
                            	  5901: 							* now find non zero start of string
                            	  5902: LAB_296A
01:00083CF0 5248            	  5903: 	ADDQ.w	#1,a0				* increment a0 (this will never carry to b16)
01:00083CF2 224BD3FC00081F1D	  5904: 	LEA		BHsend-1(a3),a1		* get string end
01:00083CFA B1C9            	  5905: 	CMPA.l	a1,a0				* are we at end
01:00083CFC 6700ECD4        	  5906: 	BEQ		LAB_18C3			* if so print null terminated string and RETURN
                            	  5907: 
01:00083D00 0C100030        	  5908: 	CMPI.b	#'0',(a0)			* is character "0" ?
01:00083D04 67EA            	  5909: 	BEQ.s		LAB_296A			* loop if so
                            	  5910: 
01:00083D06 6000ECCA        	  5911: 	BRA		LAB_18C3			* print null terminated string from memory & RET
                            	  5912: 
                            	  5913: 
                            	  5914: *************************************************************************************
                            	  5915: *
                            	  5916: * convert FAC1 to ASCII string result in (a0)
                            	  5917: * STR$() function enters here
                            	  5918: 
                            	  5919: * now outputs 7 significant digits
                            	  5920: 
                            	  5921: * d0 is character out
                            	  5922: * d1 is save index
                            	  5923: * d2 is gash
                            	  5924: 
                            	  5925: * a0 is output string pointer
                            	  5926: 
                            	  5927: LAB_2970
01:00083D0A 224BD3FC00081F0E	  5928: 	LEA		Decss(a3),a1		* set output string start
                            	  5929: 
01:00083D12 7420            	  5930: 	MOVEQ		#' ',d2			* character = " ", assume +ve
01:00083D14 08AB00071EDD    	  5931: 	BCLR.b	#7,FAC1_s(a3)		* test and clear FAC1 sign (b7)
01:00083D1A 6702            	  5932: 	BEQ.s		LAB_2978			* branch if +ve
                            	  5933: 
01:00083D1C 742D            	  5934: 	MOVEQ		#'-',d2			* else character = "-"
                            	  5935: LAB_2978
01:00083D1E 1282            	  5936: 	MOVE.b	d2,(a1)			* save the sign character
01:00083D20 142B1EDC        	  5937: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00083D24 6608            	  5938: 	BNE.s		LAB_2989			* branch if FAC1<>0
                            	  5939: 
                            	  5940: 							* exponent was $00 so FAC1 is 0
01:00083D26 7030            	  5941: 	MOVEQ		#'0',d0			* set character = "0"
01:00083D28 7201            	  5942: 	MOVEQ		#1,d1				* set output string index
01:00083D2A 600001A8        	  5943: 	BRA		LAB_2A89			* save last character, [EOT] & exit
                            	  5944: 
