01:00082C4E 48700000        	  2647: 	PEA		(a0,d0.w)			* push vector
                            	  2648: 
01:00082C52 2F2B1ED8        	  2649: 	MOVE.l	FAC1_m(a3),-(sp)		* push FAC1 mantissa
01:00082C56 3F2B1EDC        	  2650: 	MOVE.w	FAC1_e(a3),-(sp)		* push sign and exponent
01:00082C5A 1F2B1F2B        	  2651: 	MOVE.b	comp_f(a3),-(sp)		* push comparison evaluation flag
                            	  2652: 
01:00082C5E 32301000        	  2653: 	MOVE.w	(a0,d1.w),d1		* get precedence value
                            	  2654: LAB_1ACD
