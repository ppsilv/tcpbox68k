                            	  5781: 
                            	  5782: LAB_2828
01:00083C4E 65B8            	  5783: 	BCS.s		LAB_27D0			* if FAC1 > FAC2 return d0=-1,C=1/-ve d0=+1,
                            	  5784: 							* C=0/+ve
