                            	  5766: 							* d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5767: 
01:00083C34 102B1EE6        	  5768: 	MOVE.b	FAC_sc(a3),d0		* get FAC sign compare
01:00083C38 6BCA            	  5769: 	BMI.s		LAB_27CE			* if signs <> do return d0=-1,C=1/-ve
                            	  5770: 							* d0=+1,C=0/+ve & return
                            	  5771: 
01:00083C3A 102B1EDD        	  5772: 	MOVE.b	FAC1_s(a3),d0		* get FAC1 sign
01:00083C3E B22B1EDC        	  5773: 	CMP.b		FAC1_e(a3),d1		* compare FAC1 exponent with FAC2 exponent
01:00083C42 660A            	  5774: 	BNE.s		LAB_2828			* branch if different
                            	  5775: 
01:00083C44 222B1EE0        	  5776: 	MOVE.l	FAC2_m(a3),d1		* get FAC2 mantissa
01:00083C48 B2AB1ED8        	  5777: 	CMP.l		FAC1_m(a3),d1		* compare mantissas
