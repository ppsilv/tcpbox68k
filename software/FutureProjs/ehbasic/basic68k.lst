                            	  7347: *************************************************************************************
                            	  7348: *
                            	  7349: * perform HEX$()
                            	  7350: * # of leading 0s is in d1, the number is in d0
                            	  7351: 
                            	  7352: LAB_HEXS
01:000846B2 B23C0009        	  7353: 	CMP.b		#$09,d1			* max + 1
01:000846B6 6400DA8C        	  7354: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7355: 
01:000846BA 7407            	  7356: 	MOVEQ		#$07,d2			* nibble count-1
01:000846BC 204BD1FC00081F16	  7357: 	LEA		Hexss(a3),a0		* point to string
01:000846C4 7830            	  7358: 	MOVEQ		#$30,d4			* "0" character for ABCD
                            	  7359: NextH1
01:000846C6 1600            	  7360: 	MOVE.b	d0,d3				* copy lowest byte
01:000846C8 E898            	  7361: 	ROR.l		#4,d0				* shift nibble into 0-3
01:000846CA C63C000F        	  7362: 	AND.b		#$0F,d3			* just this nibble
01:000846CE 1A03            	  7363: 	MOVE.b	d3,d5				* copy it
01:000846D0 DA3C00F6        	  7364: 	ADD.b		#$F6,d5			* set extend bit
01:000846D4 C704            	  7365: 	ABCD		d4,d3				* decimal add extend and character to zero
01:000846D6 11832000        	  7366: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:000846DA 51CAFFEA        	  7367: 	DBF		d2,NextH1			* decrement and loop if not done
                            	  7368: 
01:000846DE 609A            	  7369: 	BRA.s		EndBHS			* go process string
                            	  7370: 
