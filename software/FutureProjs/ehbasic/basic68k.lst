Source: "basic68k.asm"
                            	    80: 
                            	    81: * Use this value to run out of ROM
                            	    82: 	ORG		$00082000			* past the vectors in a real system
                            	    83: 
                            	    84: 
01:00082000 6026            	    85:          BRA    code_start       * For convenience, so you can start from first address
                            	    86: 
                            	    87: *************************************************************************************
                            	    88: *
                            	    89: * the following code is simulator specific, change to suit your system
                            	    90: 
                            	    91: * Output character to the console from register d0.b
                            	    92: 
                            	    93: UART_WriteChar          EQU $00000404
                            	    94: UART_ReadChar           EQU $00000408
                            	    95: 
                            	    96: 
                            	    97: VEC_OUT
01:00082002 4EB80404        	    98: 		JSR UART_WriteChar
01:00082006 4E75            	    99: 		RTS
                            	   100: 
                            	   101: * Output character to the second (aux) serial port from register d0.b
                            	   102: 
                            	   103:  ifne   FLASH_SUPPORT
                            	   104: 
                            	   105: VEC_OUT2
                            	   106:         MOVEM.L  A0/D1,-(A7)    * Save working registers
                            	   107:         LEA.L    ACIA_2,A0      * A0 points to console ACIA
                            	   108: TXNOTREADY1
                            	   109:         MOVE.B   (A0),D1        * Read ACIA status
                            	   110:         BTST     #1,D1          * Test TDRE bit
                            	   111:         BEQ.s    TXNOTREADY1    * Until ACIA Tx ready
                            	   112:         MOVE.B   D0,2(A0)       * Write character to send
                            	   113:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
                            	   114:         RTS
                            	   115: 
                            	   116: * Output null terminated string pointed to by A0 to first serial port.
                            	   117: 
                            	   118: PRINTSTRING1
                            	   119:         MOVEM.L  A0/D0,-(A7)    * Save working registers
                            	   120: LP1     CMP.B    #0,(A0)        * Is it null?
                            	   121:         BEQ      RET1           * If so, return
                            	   122:         MOVE.B   (A0)+,D0       * Get character and advance pointer
                            	   123:         JSR      VEC_OUT        * Output it
                            	   124:         BRA      LP1            * Continue for rest of string
                            	   125: 
                            	   126: RET1    MOVEM.L  (A7)+,A0/D0    * Restore working registers
                            	   127:         RTS                     * Return
                            	   128: 
                            	   129: * Output null terminated string pointed to by A0 to second serial port.
                            	   130: 
                            	   131: PRINTSTRING2
                            	   132:         MOVEM.L  A0/D0,-(A7)    * Save working registers
                            	   133: LP2     CMP.B    #0,(A0)        * Is it null?
                            	   134:         BEQ      RET2           * If so, return
                            	   135:         MOVE.B   (A0)+,D0       * Get character and advance pointer
                            	   136:         JSR      VEC_OUT2       * Output it
                            	   137:         BRA      LP2            * Continue for rest of string
                            	   138: 
                            	   139: RET2    MOVEM.L  (A7)+,A0/D0    * Restore working registers
                            	   140:         RTS                     * Return
                            	   141: 
                            	   142:  endc
                            	   143: 
                            	   144: *************************************************************************************
                            	   145: *
                            	   146: * input a character from the console into register d0
                            	   147: * else return Cb=0 if there's no character available
                            	   148: 
                            	   149: VEC_IN
01:00082008 4EB80408        	   150: 		JSR		UART_ReadChar
01:0008200C 003C0001        	   151: 		ORI.B    #1,CCR         * Set the carry, flag we got a byte
01:00082010 4E75            	   152:         RTS                     * Return
                            	   153: RXNOTREADY
01:00082012 4CDF0102        	   154:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
01:00082016 023C00FE        	   155:         ANDI.B   #$FE,CCR       * Clear the carry, flag character not available
01:0008201A 4E75            	   156:         RTS
                            	   157: 
                            	   158: * Input routine used in LOAD mode to read file from USB flash storage.
                            	   159: 
                            	   160:  ifne   FLASH_SUPPORT
                            	   161: 
                            	   162: VEC_IN2
                            	   163:         MOVEM.L  A0/D1,-(A7)    * Save working registers
                            	   164:         LEA.L    VEC_OUT2,A0    * Redirect output to aux. port.
                            	   165:         MOVE.L   A0,V_OUTPv(a3)
                            	   166: 
                            	   167: * The first time, send READ <filename> 1 1
                            	   168: * Subsequent times, send READ <filename> n 1
                            	   169: 
                            	   170:         LEA      LAB_READN,A0 * Send READ command string
                            	   171:         BSR      PRINTSTRING2   * Print null terminated string
                            	   172: 
                            	   173:         LEA      load_filename(A3),A0 * Send filename string
                            	   174:         BSR      PRINTSTRING2   * Print null terminated string
                            	   175: 
                            	   176:         MOVE.B   #' ',D0       * Send space
                            	   177:         JSR      VEC_OUT2
                            	   178: 
                            	   179:         CMP.B    #1,load_first(A3) * First time?
                            	   180:         BNE      NOTFIRST1
                            	   181:         MOVE.B   #'1',D0        * Send '1'
                            	   182:         CLR.B    load_first(A3) * Clear first flag
                            	   183:         BRA      SENDCMD1
                            	   184: NOTFIRST1
                            	   185:         MOVE.B   #'n',D0        * Send 'n'
                            	   186: SENDCMD1
                            	   187:         JSR      VEC_OUT2
                            	   188:         MOVE.B   #' ',D0        * Send space
                            	   189:         JSR      VEC_OUT2
                            	   190:         MOVE.B   #'1',D0        * Send '1'
                            	   191:         JSR      VEC_OUT2
                            	   192:         MOVE.B   #$0D,D0        * Send <Return>
                            	   193:         JSR      VEC_OUT2
                            	   194: 
                            	   195:         LEA.L    VEC_OUT,A0     * Redirect output back to console port.
                            	   196:         MOVE.L   A0,V_OUTPv(a3)
                            	   197: 
                            	   198: * Read one byte from USB host
                            	   199: 
                            	   200:         LEA.L    ACIA_2,A0      * A0 points to console ACIA
                            	   201: RXNOTREADY2
                            	   202:         MOVE.B   (A0),D1        * Read ACIA status
                            	   203:         BTST     #0,D1          * Test RDRF bit
                            	   204:         BEQ.S    RXNOTREADY2    * Branch if ACIA Rx not ready
                            	   205:         MOVE.B   2(A0),D0       * Read character received
                            	   206: 
                            	   207: * Check for end of file character ('~') and if found, redirect
                            	   208: * input back to console port.
                            	   209: 
                            	   210:         CMP.B    #'~',D0        * End of file marker?
                            	   211:         BNE      NOTEOF
                            	   212:         MOVE.B   #$0D,D0        * Convert '~' to a Return
                            	   213:         LEA.L    VEC_IN,A0      * Redirect input back to console port.
                            	   214:         MOVE.L   A0,V_INPTv(a3)
                            	   215: NOTEOF
                            	   216:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
                            	   217:         ORI.b    #1,CCR         * Set the carry, flag we got a byte
                            	   218:         RTS                     * Return
                            	   219: 
                            	   220:  endc
                            	   221: 
                            	   222: *************************************************************************************
                            	   223: *
                            	   224: * LOAD routine for the TS2 computer (not implemented)
                            	   225: 
                            	   226:  ifeq   FLASH_SUPPORT
                            	   227: 
                            	   228: VEC_LD
01:0008201C 7E2E            	   229:        MOVEQ           #$2E,d7                         * error code $2E "Not implemented" error
01:0008201E 60000136        	   230:        BRA             LAB_XERR                        * do error #d7, then warm start
                            	   231: 
                            	   232:  endc
                            	   233: 
                            	   234: * LOAD routine for the TS2 computer. Supports a Hobbytronics USB Flash
                            	   235: * Drive Host Board connected to the auxiliary serial port.
                            	   236: 
                            	   237:  ifne   FLASH_SUPPORT
                            	   238: 
                            	   239: VEC_LD  LEA             LAB_FILENAME(PC),A0             * Prompt for filename.
                            	   240:         BSR             PRINTSTRING1                    * Print null terminated string
                            	   241:         MOVE.L          A3,A2                           * Save pointer to RAM variables
                            	   242: GETFN1  JSR             VEC_IN                          * Get character
                            	   243:         BCC             GETFN1                          * Go back if carry clear, indicating no key pressed
                            	   244:         JSR             VEC_OUT                         * Echo the character
                            	   245:         CMP.B           #$0D,D0                         * Was it <Return>?
                            	   246:         BEQ             ENDLN1                          * If so, branch
                            	   247:         CMP.B           #$7F,D0                         * Was it <Delete>?
                            	   248:         BEQ             DELETE1                         * If so, handle delete
                            	   249:         CMP.B           #$08,D0                         * Was it <Backspace?
                            	   250:         BEQ             DELETE1                         * If so, handle as delete
                            	   251:         MOVE.B          D0,load_filename(A2)            * Save in buffer
                            	   252:         ADDQ.L          #1,A2                           * Advance string pointer
                            	   253:         BRA             GETFN1                          * Go back and get next character
                            	   254: DELETE1 SUBQ.L          #1,A2                           * Delete last character entered
                            	   255:         BRA             GETFN1                          * Go back and get next character
                            	   256: 
                            	   257: ENDLN1  MOVE.B          #0,load_filename(A2)            * Add terminating null to filename
                            	   258:         LEA.L           VEC_IN2,A0                      * Redirect input from aux. port.
                            	   259:         MOVE.L          A0,V_INPTv(a3)
                            	   260:         MOVE.B          #1,load_first(A3)               * Set load_first flag
                            	   261: 
                            	   262: * Input routine will detect end of file and redirect input back to
                            	   263: * console port.
                            	   264: 
                            	   265:         RTS
                            	   266: 
                            	   267:  endc
                            	   268: 
                            	   269: *************************************************************************************
                            	   270: *
                            	   271: * SAVE routine for the TS2 computer (not implemented)
                            	   272: 
                            	   273:  ifeq   FLASH_SUPPORT
                            	   274: VEC_SV
01:00082022 7E2E            	   275:        MOVEQ           #$2E,d7                         * error code $2E "Not implemented" error
01:00082024 60000130        	   276:        BRA             LAB_XERR                        * do error #d7, then warm start
                            	   277:  endc
                            	   278: 
                            	   279:  ifne   FLASH_SUPPORT
                            	   280: 
                            	   281: * SAVE routine for the TS2 computer. Supports a Hobbytronics USB Flash
                            	   282: * Drive Host Board connected to the auxiliary serial port.
                            	   283: 
                            	   284: * TODO: Make configurable at build time
                            	   285: 
                            	   286: VEC_SV  LEA             LAB_FILENAME(PC),A0             * Prompt for filename.
                            	   287:         BSR             PRINTSTRING1                    * Print null terminated string
                            	   288:         MOVE.L          A3,A2                           * Save pointer to RAM variables
                            	   289: GETFN   JSR             VEC_IN                          * Get character
                            	   290:         BCC             GETFN                           * Go back if carry clear, indicating no key pressed
                            	   291:         JSR             VEC_OUT                         * Echo the character
                            	   292:         CMP.B           #$0D,D0                         * Was it <Return>?
                            	   293:         BEQ             ENDLN                           * If so, branch
                            	   294:         CMP.B           #$7F,D0                         * Was it <Delete>?
                            	   295:         BEQ             DELETE                          * If so, handle delete
                            	   296:         CMP.B           #$08,D0                         * Was it <Backspace?
                            	   297:         BEQ             DELETE                          * If so, handle as delete
                            	   298:         MOVE.B          D0,load_filename(A2)            * Save in buffer
                            	   299:         ADDQ.L          #1,A2                           * Advance string pointer
                            	   300:         BRA             GETFN                           * Go back and get next character
                            	   301: DELETE  SUBQ.L          #1,A2                           * Delete last character entered
                            	   302:         BRA             GETFN                           * Go back and get next character
                            	   303: 
                            	   304: ENDLN   MOVE.B          #0,load_filename(A2)            * Add terminating null to filename
                            	   305: 
                            	   306:         LEA.L           VEC_OUT2,A0                     * Redirect output to aux. port.
                            	   307:         MOVE.L          A0,V_OUTPv(a3)
                            	   308: 
                            	   309:         LEA             LAB_WRITE,A0                * Send WRITE command string
                            	   310:         BSR             PRINTSTRING2                    * Print null terminated string
                            	   311: 
                            	   312:         LEA             load_filename(A3),A0            * Send filename string
                            	   313:         BSR             PRINTSTRING2                    * Print null terminated string
                            	   314: 
                            	   315:         MOVE.B          #$0D,D0                         * Send <Return>
                            	   316:         JSR             VEC_OUT2
                            	   317: 
                            	   318:         MOVE.l          #356000,d0                      * Delay approx. 1 second to allow USB to create file
                            	   319: DELAY   SUBQ.l          #1,d0
                            	   320:         BNE             DELAY
                            	   321: 
                            	   322:         MOVEQ           #0,d0                           * Tells LIST no arguments
                            	   323:         ANDI.b          #$FE,CCR                        * Clear carry
                            	   324:         BSR             LAB_LIST                        * Call LIST routine
                            	   325: 
                            	   326:         MOVEQ           #'~',d0                         * Send tilde symbol indicate end of file (used when loading)
                            	   327:         BSR             LAB_PRNA
                            	   328: 
                            	   329:         MOVEQ           #26,d0                          * Send Control-Z to indicate end of file save operation
                            	   330:         BSR             LAB_PRNA
                            	   331: 
                            	   332:         LEA.L           VEC_OUT,A0                      * Redirect output back to console port.
                            	   333:         MOVE.L          A0,V_OUTPv(a3)
                            	   334:         RTS                                             * Return
                            	   335: 
                            	   336: LAB_WRITE
                            	   337:         dc.b            '$WRITE ',$00
                            	   338: 
                            	   339: LAB_READN
                            	   340:         dc.b            '$READ ',$00
                            	   341: 
                            	   342: LAB_FILENAME
                            	   343:         dc.b            'Filename? ',$00
                            	   344: 
                            	   345:  endc
                            	   346:         even
                            	   347: 
                            	   348: *************************************************************************************
                            	   349: 
                            	   350: code_start
                            	   351: 
                            	   352: * to tell EhBASIC where and how much RAM it has pass the address in a0 and the size
                            	   353: * in d0. these values are at the end of the .inc file
                            	   354: 
01:00082028 207C00086000    	   355: 	MOVEA.l	#ram_addr,a0		* tell BASIC where RAM starts
01:0008202E 203C00008000    	   356: 	MOVE.l	#ram_size,d0		* tell BASIC how big RAM is
                            	   357: 
                            	   358: * end of simulator specific code
                            	   359: 
                            	   360: 
                            	   361: ****************************************************************************************
                            	   362: ****************************************************************************************
                            	   363: ****************************************************************************************
                            	   364: ****************************************************************************************
                            	   365: *
                            	   366: * Register use :- (must improve this !!)
                            	   367: *
                            	   368: *	a6 -	temp Bpntr				* temporary BASIC execute pointer
                            	   369: *	a5 -	Bpntr					* BASIC execute (get byte) pointer
                            	   370: *	a4 -	des_sk				        * descriptor stack pointer
                            	   371: *	a3 -	ram_strt				* start of RAM. all RAM references are offsets
                            	   372: *							* from this value
                            	   373: *
                            	   374: 
                            	   375: *************************************************************************************
                            	   376: *
                            	   377: * BASIC cold start entry point. assume entry with RAM address in a0 and RAM length
                            	   378: * in d0
                            	   379: 
                            	   380: LAB_COLD
01:00082034 B0BC00004000    	   381: 	CMP.l		#$4000,d0			* compare size with 16k
01:0008203A 6C08            	   382: 	BGE.s		LAB_sizok			* branch if >= 16k
                            	   383: 
01:0008203C 7005            	   384: 	MOVEQ		#5,d0				* error 5 - not enough RAM
01:0008203E 1E3C00E4        	   385:     move.b      #228,D7                         * Go to TUTOR function
01:00082042 4E40            	   386:     trap        #0                            * Call TRAP0 handler
                            	   387: 
                            	   388: LAB_sizok
01:00082044 2648            	   389: 	MOVEA.l	a0,a3				* copy RAM base to a3
01:00082046 D1C0            	   390: 	ADDA.l	d0,a0				* a0 is top of RAM
01:00082048 2748144A        	   391: 	MOVE.l	a0,Ememl(a3)		* set end of mem
01:0008204C 4FFA3FB2        	   392: 	LEA	    $86000,sp		* set stack to RAM start + 1k
                            	   393: 	;LEA		ram_base(a3),sp		* set stack to RAM start + 1k
                            	   394: 
01:00082050 303C4EF9        	   395: 	MOVE.w	#$4EF9,d0			* JMP opcode
01:00082054 41FA2DEC        	   396: 	LEA	    LAB_CTBL,a0				* point to start of vector table
                            	   397: 
01:00082058 30C0            	   398: 	MOVE.w	d0,(a0)+			* LAB_WARM
01:0008205A 43FAFFD8        	   399: 	LEA		LAB_COLD,a1		* initial warm start vector
01:0008205E 20C9            	   400: 	MOVE.l	a1,(a0)+			* set vector
                            	   401: 
01:00082060 30C0            	   402: 	MOVE.w	d0,(a0)+			* Usrjmp
01:00082062 43FA00E0        	   403: 	LEA		LAB_FCER,a1		* initial user function vector
                            	   404: 								* "Function call" error
01:00082066 20C9            	   405: 	MOVE.l	a1,(a0)+			* set vector
                            	   406: 
01:00082068 30C0            	   407: 	MOVE.w	d0,(a0)+			* V_INPT JMP opcode
01:0008206A 43F80408        	   408: 	LEA		UART_ReadChar,a1		* get byte from input device vector
01:0008206E 20C9            	   409: 	MOVE.l	a1,(a0)+			* set vector
                            	   410: 
01:00082070 30C0            	   411: 	MOVE.w	d0,(a0)+			* V_OUTP JMP opcode
01:00082072 43F80404        	   412: 	LEA		UART_WriteChar,a1		* send byte to output device vector
01:00082076 20C9            	   413: 	MOVE.l	a1,(a0)+			* set vector
                            	   414: 
01:00082078 30C0            	   415: 	MOVE.w	d0,(a0)+			* V_LOAD JMP opcode
01:0008207A 43FAFFA0        	   416: 	LEA		VEC_LD,a1		* load BASIC program vector
01:0008207E 20C9            	   417: 	MOVE.l	a1,(a0)+			* set vector
                            	   418: 
01:00082080 30C0            	   419: 	MOVE.w	d0,(a0)+			* V_SAVE JMP opcode
01:00082082 43FAFF9E        	   420: 	LEA		VEC_SV,a1		* save BASIC program vector
01:00082086 20C9            	   421: 	MOVE.l	a1,(a0)+			* set vector
                            	   422: 
01:00082088 30C0            	   423: 	MOVE.w	d0,(a0)+			* V_CTLC JMP opcode
01:0008208A 43FA2654        	   424: 	LEA		VEC_CC,a1		* save CTRL-C check vector
01:0008208E 20C9            	   425: 	MOVE.l	a1,(a0)+			* set vector
                            	   426: 
