                            	  7541: WExit
01:000847E8 102B1F2E        	  7542: 	MOVE.b	TWidth(a3),d0		* get width
01:000847EC 670A            	  7543: 	BEQ.s		LAB_WDLP			* branch if infinite line
                            	  7544: 
01:000847EE B02B1F2A        	  7545: 	CMP.b		TabSiz(a3),d0		* compare with tab size
01:000847F2 6404            	  7546: 	BCC.s		LAB_WDLP			* branch if >= tab size
                            	  7547: 
01:000847F4 17401F2A        	  7548: 	MOVE.b	d0,TabSiz(a3)		* else make tab size = terminal width
                            	  7549: LAB_WDLP
01:000847F8 902B1F2A        	  7550: 	SUB.b		TabSiz(a3),d0		* subtract tab size
01:000847FC 64FA            	  7551: 	BCC.s		LAB_WDLP			* loop while no borrow
                            	  7552: 
01:000847FE D02B1F2A        	  7553: 	ADD.b		TabSiz(a3),d0		* add tab size back
01:00084802 D02B1F2A        	  7554: 	ADD.b		TabSiz(a3),d0		* add tab size back again
                            	  7555: 
01:00084806 4400            	  7556: 	NEG.b		d0				* make -ve
