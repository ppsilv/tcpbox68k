                            	  5799: 
                            	  5800: LAB_2831
01:00083C5A 202B1ED8        	  5801: 	MOVE.l	FAC1_m(a3),d0		* copy mantissa
01:00083C5E 6730            	  5802: 	BEQ.s		LAB_284J			* branch if mantissa = 0
                            	  5803: 
