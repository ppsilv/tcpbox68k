01:000839F0 6AFA            	  5280: 	BPL.s		LAB_LONE			* loop if not normal
                            	  5281: 
                            	  5282: LAB_LOXO
01:000839F2 27471ED8        	  5283: 	MOVE.l	d7,FAC1_m(a3)		* save original exponent as mantissa
01:000839F6 17451EDC        	  5284: 	MOVE.b	d5,FAC1_e(a3)		* save exponent for this
01:000839FA 277CB17217F81EE0	  5285: 	MOVE.l	#$B17217F8,FAC2_m(a3)	* LOG(2) mantissa
01:00083A02 377C80001EE4    	  5286: 	MOVE.w	#$8000,FAC2_e(a3)		* LOG(2) exponent & sign
01:00083A08 176B1EDD1EE6    	  5287: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* make sign compare = FAC1 sign
01:00083A0E 6118            	  5288: 	BSR.s		LAB_MULTIPLY		* do multiply
01:00083A10 27441EE0        	  5289: 	MOVE.l	d4,FAC2_m(a3)		* save cordic result
01:00083A14 6710            	  5290: 	BEQ.s		LAB_LOWZ			* branch if zero
                            	  5291: 
01:00083A16 377C82001EE4    	  5292: 	MOVE.w	#$8200,FAC2_e(a3)		* set exponent & sign
01:00083A1C 176B1EDD1EE6    	  5293: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* clear sign compare
01:00083A22 6100FE5A        	  5294: 	BSR		LAB_ADD			* and add for final result
                            	  5295: 
                            	  5296: LAB_LOWZ
01:00083A26 4E75            	  5297: 	RTS
                            	  5298: 
                            	  5299: 
                            	  5300: *************************************************************************************
                            	  5301: *
                            	  5302: * multiply FAC1 by FAC2
                            	  5303: 
                            	  5304: LAB_MULTIPLY
01:00083A28 48E7F800        	  5305: 	MOVEM.l	d0-d4,-(sp)			* save registers
01:00083A2C 4A2B1EDC        	  5306: 	TST.b		FAC1_e(a3)			* test FAC1 exponent
01:00083A30 6776            	  5307: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5308: 
01:00083A32 102B1EE4        	  5309: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00083A36 6770            	  5310: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5311: 
01:00083A38 176B1EE61EDD    	  5312: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare becomes sign
                            	  5313: 
01:00083A3E D02B1EDC        	  5314: 	ADD.b		FAC1_e(a3),d0		* multiply exponents by adding
01:00083A42 640A            	  5315: 	BCC.s		LAB_MNOC			* branch if no carry
                            	  5316: 
01:00083A44 903C0080        	  5317: 	SUB.b		#$80,d0			* normalise result
01:00083A48 6400E6F6        	  5318: 	BCC		LAB_OFER			* if no carry do overflow
                            	  5319: 
01:00083A4C 6006            	  5320: 	BRA.s		LAB_MADD			* branch
                            	  5321: 
                            	  5322: 							* no carry for exponent add
                            	  5323: LAB_MNOC
01:00083A4E 903C0080        	  5324: 	SUB.b		#$80,d0			* normalise result
01:00083A52 6554            	  5325: 	BCS.s		LAB_MUUF			* return zero if underflow
                            	  5326: 
                            	  5327: LAB_MADD
01:00083A54 17401EDC        	  5328: 	MOVE.b	d0,FAC1_e(a3)		* save exponent
                            	  5329: 
                            	  5330: 							* d1 (FAC1) x d2 (FAC2)
01:00083A58 222B1ED8        	  5331: 	MOVE.l	FAC1_m(a3),d1		* get FAC1 mantissa
01:00083A5C 242B1EE0        	  5332: 	MOVE.l	FAC2_m(a3),d2		* get FAC2 mantissa
                            	  5333: 
01:00083A60 3801            	  5334: 	MOVE.w	d1,d4				* copy low word FAC1
01:00083A62 2001            	  5335: 	MOVE.l	d1,d0				* copy long word FAC1
01:00083A64 4840            	  5336: 	SWAP		d0				* high word FAC1 to low word FAC1
01:00083A66 3600            	  5337: 	MOVE.w	d0,d3				* copy high word FAC1
                            	  5338: 
01:00083A68 C2C2            	  5339: 	MULU		d2,d1				* low word FAC2 x low word FAC1
01:00083A6A C0C2            	  5340: 	MULU		d2,d0				* low word FAC2 x high word FAC1
01:00083A6C 4842            	  5341: 	SWAP		d2				* high word FAC2 to low word FAC2
01:00083A6E C8C2            	  5342: 	MULU		d2,d4				* high word FAC2 x low word FAC1
01:00083A70 C6C2            	  5343: 	MULU		d2,d3				* high word FAC2 x high word FAC1
                            	  5344: 
                            	  5345: * done multiply, now add partial products
                            	  5346: 
                            	  5347: *			d1 =					aaaa  ----	FAC2_L x FAC1_L
                            	  5348: *			d0 =				bbbb  aaaa		FAC2_L x FAC1_H
                            	  5349: *			d4 =				bbbb  aaaa		FAC2_H x FAC1_L
                            	  5350: *			d3 =			cccc  bbbb			FAC2_H x FAC1_H
                            	  5351: *			product =		mmmm  mmmm
                            	  5352: 
01:00083A72 D2BC00008000    	  5353: 	ADD.L		#$8000,d1			* round up lowest word
01:00083A78 4241            	  5354: 	CLR.w		d1				* clear low word, don't need it
01:00083A7A 4841            	  5355: 	SWAP		d1				* align high word
01:00083A7C D280            	  5356: 	ADD.l		d0,d1				* add FAC2_L x FAC1_H (can't be carry)
                            	  5357: LAB_MUF1
01:00083A7E D284            	  5358: 	ADD.l		d4,d1				* now add intermediate (FAC2_H x FAC1_L)
01:00083A80 6406            	  5359: 	BCC.s		LAB_MUF2			* branch if no carry
                            	  5360: 
01:00083A82 D6BC00010000    	  5361: 	ADD.l		#$10000,d3			* else correct result
                            	  5362: LAB_MUF2
01:00083A88 D2BC00008000    	  5363: 	ADD.l		#$8000,d1			* round up low word
01:00083A8E 4241            	  5364: 	CLR.w		d1				* clear low word
01:00083A90 4841            	  5365: 	SWAP		d1				* align for final add
01:00083A92 D283            	  5366: 	ADD.l		d3,d1				* add FAC2_H x FAC1_H, result
01:00083A94 6B08            	  5367: 	BMI.s		LAB_MUF3			* branch if normalisation not needed
                            	  5368: 
01:00083A96 D281            	  5369: 	ADD.l		d1,d1				* shift mantissa
01:00083A98 532B1EDC        	  5370: 	SUBQ.b	#1,FAC1_e(a3)		* adjust exponent
01:00083A9C 670A            	  5371: 	BEQ.s		LAB_MUUF			* branch if underflow
                            	  5372: 
                            	  5373: LAB_MUF3
01:00083A9E 27411ED8        	  5374: 	MOVE.l	d1,FAC1_m(a3)		* save mantissa
                            	  5375: LAB_MUEX
01:00083AA2 4CDF001F        	  5376: 	MOVEM.l	(sp)+,d0-d4			* restore registers
01:00083AA6 4E75            	  5377: 	RTS
                            	  5378: 							* either zero or underflow result
                            	  5379: LAB_MUUF
01:00083AA8 7000            	  5380: 	MOVEQ		#0,d0				* quick clear
01:00083AAA 27401ED8        	  5381: 	MOVE.l	d0,FAC1_m(a3)		* clear mantissa
01:00083AAE 37401EDC        	  5382: 	MOVE.w	d0,FAC1_e(a3)		* clear sign and exponent
01:00083AB2 60EE            	  5383: 	BRA.s		LAB_MUEX			* restore regs & exit
                            	  5384: 
                            	  5385: 
                            	  5386: *************************************************************************************
                            	  5387: *
                            	  5388: * do FAC2/FAC1, result in FAC1
                            	  5389: * fast hardware divide version
                            	  5390: 
                            	  5391: LAB_DIVIDE
01:00083AB4 2F07            	  5392: 	MOVE.l	d7,-(sp)			* save d7
01:00083AB6 7000            	  5393: 	MOVEQ		#0,d0				* clear FAC2 exponent
01:00083AB8 2400            	  5394: 	MOVE.l	d0,d2				* clear FAC1 exponent
                            	  5395: 
01:00083ABA 142B1EDC        	  5396: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00083ABE 6700E66C        	  5397: 	BEQ		LAB_DZER			* if zero go do /0 error
                            	  5398: 
01:00083AC2 102B1EE4        	  5399: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00083AC6 6766            	  5400: 	BEQ.s		LAB_DIV0			* if zero return zero
                            	  5401: 
01:00083AC8 9042            	  5402: 	SUB.w		d2,d0				* get result exponent by subtracting
01:00083ACA D07C0080        	  5403: 	ADD.w		#$80,d0			* correct 16 bit exponent result
                            	  5404: 
01:00083ACE 176B1EE61EDD    	  5405: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare is result sign
                            	  5406: 
                            	  5407: * now to do 32/32 bit mantissa divide
                            	  5408: 
01:00083AD4 422B1EE7        	  5409: 	CLR.b		flag(a3)			* clear 'flag' byte
01:00083AD8 262B1ED8        	  5410: 	MOVE.l	FAC1_m(a3),d3		* get FAC1 mantissa
01:00083ADC 282B1EE0        	  5411: 	MOVE.l	FAC2_m(a3),d4		* get FAC2 mantissa
01:00083AE0 B883            	  5412: 	CMP.l		d3,d4				* compare FAC2 with FAC1 mantissa
01:00083AE2 6744            	  5413: 	BEQ.s		LAB_MAN1			* set mantissa result = 1 if equal
                            	  5414: 
01:00083AE4 6506            	  5415: 	BCS.s		AC1gtAC2			* branch if FAC1 > FAC2
                            	  5416: 
01:00083AE6 9883            	  5417: 	SUB.l		d3,d4				* subtract FAC1 from FAC2, result now must be <1
01:00083AE8 562B1EE7        	  5418: 	ADDQ.b	#3,flag(a3)			* FAC2>FAC1 so set 'flag' byte
                            	  5419: AC1gtAC2
01:00083AEC 6146            	  5420: 	BSR.s		LAB_32_16			* do 32/16 divide
01:00083AEE 4841            	  5421: 	SWAP		d1				* move 16 bit result to high word
01:00083AF0 2802            	  5422: 	MOVE.l	d2,d4				* copy remainder longword
01:00083AF2 6142            	  5423: 	BSR.s		LAB_3216			* do 32/16 divide again (skip copy d4 to d2)
01:00083AF4 84C5            	  5424: 	DIVU.w	d5,d2				* now divide remainder to make guard word
01:00083AF6 1E2B1EE7        	  5425: 	MOVE.b	flag(a3),d7			* now normalise, get flag byte back
01:00083AFA 6708            	  5426: 	BEQ.s		LAB_DIVX			* skip add if null
                            	  5427: 
                            	  5428: * else result was >1 so we need to add 1 to result mantissa and adjust exponent
                            	  5429: 
01:00083AFC E20F            	  5430: 	LSR.b		#1,d7				* shift 1 into eXtend
01:00083AFE E291            	  5431: 	ROXR.l	#1,d1				* shift extend result >>
01:00083B00 E252            	  5432: 	ROXR.w	#1,d2				* shift extend guard word >>
01:00083B02 5200            	  5433: 	ADDQ.b	#1,d0				* adjust exponent
                            	  5434: 
                            	  5435: * now round result to 32 bits
                            	  5436: 
                            	  5437: LAB_DIVX
01:00083B04 D442            	  5438: 	ADD.w		d2,d2				* guard bit into eXtend bit
01:00083B06 6408            	  5439: 	BCC.s		L_DIVRND			* branch if guard=0
                            	  5440: 
01:00083B08 5281            	  5441: 	ADDQ.l	#1,d1				* add guard to mantissa
01:00083B0A 6404            	  5442: 	BCC.s		L_DIVRND			* branch if no overflow
                            	  5443: 
                            	  5444: LAB_SET1
01:00083B0C E291            	  5445: 	ROXR.l	#1,d1				* shift extend result >>
01:00083B0E 5240            	  5446: 	ADDQ.w	#1,d0				* adjust exponent
                            	  5447: 
                            	  5448: 							* test for over/under flow
                            	  5449: L_DIVRND
01:00083B10 3600            	  5450: 	MOVE.w	d0,d3				* copy exponent
01:00083B12 6B1A            	  5451: 	BMI.s		LAB_DIV0			* if -ve return zero
                            	  5452: 
01:00083B14 0243FF00        	  5453: 	ANDI.w	#$FF00,d3			* mask word high byte
01:00083B18 6600E626        	  5454: 	BNE		LAB_OFER			* branch if overflow
                            	  5455: 
                            	  5456: 							* move result into FAC1
                            	  5457: LAB_XDIV
01:00083B1C 2E1F            	  5458: 	MOVE.l	(sp)+,d7			* restore d7
01:00083B1E 17401EDC        	  5459: 	MOVE.b	d0,FAC1_e(a3)		* save result exponent
01:00083B22 27411ED8        	  5460: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:00083B26 4E75            	  5461: 	RTS
                            	  5462: 
                            	  5463: * FAC1 mantissa = FAC2 mantissa so set result mantissa
                            	  5464: 
                            	  5465: LAB_MAN1
01:00083B28 7201            	  5466: 	MOVEQ		#1,d1				* set bit
01:00083B2A E2A9            	  5467: 	LSR.l		d1,d1				* bit into eXtend
01:00083B2C 60DE            	  5468: 	BRA.s		LAB_SET1			* set mantissa, adjust exponent and exit
                            	  5469: 
                            	  5470: * result is zero
                            	  5471: 
                            	  5472: LAB_DIV0
01:00083B2E 7000            	  5473: 	MOVEQ		#0,d0				* zero exponent & sign
01:00083B30 2200            	  5474: 	MOVE.l	d0,d1				* zero mantissa
01:00083B32 60E8            	  5475: 	BRA		LAB_XDIV			* exit divide
                            	  5476: 
                            	  5477: * divide 16 bits into 32, AB/Ex
                            	  5478: *
                            	  5479: * d4			AAAA	BBBB			* 32 bit numerator
                            	  5480: * d3			EEEE	xxxx			* 16 bit denominator
                            	  5481: *
                            	  5482: * returns -
                            	  5483: *
                            	  5484: * d1			xxxx	DDDD			* 16 bit result
                            	  5485: * d2				HHHH	IIII		* 32 bit remainder
                            	  5486: 
                            	  5487: LAB_32_16
01:00083B34 2404            	  5488: 	MOVE.l	d4,d2				* copy FAC2 mantissa		(AB)
                            	  5489: LAB_3216
01:00083B36 2A03            	  5490: 	MOVE.l	d3,d5				* copy FAC1 mantissa		(EF)
01:00083B38 4245            	  5491: 	CLR.w		d5				* clear low word d1		(Ex)
01:00083B3A 4845            	  5492: 	SWAP		d5				* swap high word to low word	(xE)
                            	  5493: 
                            	  5494: * d3			EEEE	FFFF			* denominator copy
                            	  5495: * d5		0000	EEEE				* denominator high word
                            	  5496: * d2			AAAA	BBBB			* numerator copy
                            	  5497: * d4			AAAA	BBBB			* numerator
                            	  5498: 
01:00083B3C 88C5            	  5499: 	DIVU.w	d5,d4				* do FAC2/FAC1 high word	(AB/E)
01:00083B3E 6802            	  5500: 	BVC.s		LAB_LT_1			* if no overflow DIV was ok
                            	  5501: 
01:00083B40 78FF            	  5502: 	MOVEQ		#-1,d4			* else set default value
                            	  5503: 
                            	  5504: * done the divide, now check the result, we have ...
                            	  5505: 
                            	  5506: * d3			EEEE	FFFF			* denominator copy
                            	  5507: * d5		0000	EEEE				* denominator high word
                            	  5508: * d2			AAAA	BBBB			* numerator copy
                            	  5509: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5510: 
                            	  5511: LAB_LT_1
01:00083B42 3C04            	  5512: 	MOVE.w	d4,d6				* copy 16 bit result
01:00083B44 3204            	  5513: 	MOVE.w	d4,d1				* copy 16 bit result again
                            	  5514: 
                            	  5515: * we now have ..
                            	  5516: * d3			EEEE	FFFF			* denominator copy
                            	  5517: * d5		0000	EEEE				* denominator high word
                            	  5518: * d6			xxxx  DDDD			* result DIV copy
                            	  5519: * d1			xxxx  DDDD			* result DIV copy
                            	  5520: * d2			AAAA	BBBB			* numerator copy
                            	  5521: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5522: 
                            	  5523: * now multiply out 32 bit denominator by 16 bit result
                            	  5524: * QRS = AB*D
                            	  5525: 
01:00083B46 CCC3            	  5526: 	MULU.w	d3,d6				* FFFF * DDDD =       rrrr  SSSS
01:00083B48 C8C5            	  5527: 	MULU.w	d5,d4				* EEEE * DDDD = QQQQ  rrrr
                            	  5528: 
                            	  5529: * we now have ..
                            	  5530: * d3			EEEE	FFFF			* denominator copy
                            	  5531: * d5		0000	EEEE				* denominator high word
                            	  5532: * d6				rrrr  SSSS		* 48 bit result partial low
                            	  5533: * d1			xxxx  DDDD			* result DIV copy
                            	  5534: * d2			AAAA	BBBB			* numerator copy
                            	  5535: * d4			QQQQ	rrrr			* 48 bit result partial
                            	  5536: 
01:00083B4A 3E06            	  5537: 	MOVE.w	d6,d7				* copy low word of low multiply
                            	  5538: 
                            	  5539: * d7				xxxx	SSSS		* 48 bit result partial low
                            	  5540: 
01:00083B4C 4246            	  5541: 	CLR.w		d6				* clear low word of low multiply
01:00083B4E 4846            	  5542: 	SWAP		d6				* high word of low multiply to low word
                            	  5543: 
                            	  5544: * d6			0000	rrrr			* high word of 48 bit result partial low
                            	  5545: 
01:00083B50 D886            	  5546: 	ADD.l		d6,d4
                            	  5547: 
                            	  5548: * d4			QQQQ	RRRR			* 48 bit result partial high longword
                            	  5549: 
01:00083B52 7C00            	  5550: 	MOVEQ		#0,d6				* clear to extend numerator to 48 bits
                            	  5551: 
                            	  5552: * now do GHI = AB0 - QRS (which is the remainder)
                            	  5553: 
01:00083B54 9C47            	  5554: 	SUB.w		d7,d6				* low word subtract
                            	  5555: 
                            	  5556: * d6				xxxx	IIII		* remainder low word
                            	  5557: 
01:00083B56 9584            	  5558: 	SUBX.l	d4,d2				* high longword subtract
                            	  5559: 
                            	  5560: * d2			GGGG	HHHH			* remainder high longword
                            	  5561: 
                            	  5562: * now if we got the divide correct then the remainder high longword will be +ve
                            	  5563: 
01:00083B58 6A08            	  5564: 	BPL.s		L_DDIV			* branch if result is ok (<needed)
                            	  5565: 
                            	  5566: * remainder was -ve so DDDD is too big
                            	  5567: 
                            	  5568: LAB_REMM
01:00083B5A 5341            	  5569: 	SUBQ.w	#1,d1				* adjust DDDD
                            	  5570: 
                            	  5571: * d3				xxxx	FFFF		* denominator copy
                            	  5572: * d6				xxxx	IIII		* remainder low word
                            	  5573: 
01:00083B5C DC43            	  5574: 	ADD.w		d3,d6				* add EF*1 low remainder low word
                            	  5575: 
                            	  5576: * d5			0000	EEEE			* denominator high word
                            	  5577: * d2			GGGG	HHHH			* remainder high longword
                            	  5578: 
01:00083B5E D585            	  5579: 	ADDX.l	d5,d2				* add extend EF*1 to remainder high longword
01:00083B60 6BF8            	  5580: 	BMI.s		LAB_REMM			* loop if result still too big
                            	  5581: 
                            	  5582: * all done and result correct or <
                            	  5583: 
                            	  5584: L_DDIV
01:00083B62 4842            	  5585: 	SWAP		d2				* remainder mid word to high word
                            	  5586: 
                            	  5587: * d2			HHHH	GGGG			* (high word /should/ be $0000)
                            	  5588: 
01:00083B64 3406            	  5589: 	MOVE.w	d6,d2				* remainder in high word
                            	  5590: 
                            	  5591: * d2				HHHH	IIII		* now is 32 bit remainder
                            	  5592: * d1			xxxx	DDDD			* 16 bit result
                            	  5593: 
01:00083B66 4E75            	  5594: 	RTS
                            	  5595: 
                            	  5596: 
                            	  5597: *************************************************************************************
                            	  5598: *
                            	  5599: * unpack memory (a0) into FAC1
                            	  5600: 
                            	  5601: LAB_UFAC
01:00083B68 2010            	  5602: 	MOVE.l	(a0),d0			* get packed value
01:00083B6A 4840            	  5603: 	SWAP		d0				* exponent and sign into least significant word
