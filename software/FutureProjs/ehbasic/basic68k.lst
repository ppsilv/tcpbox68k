                            	  7415: *************************************************************************************
                            	  7416: *
                            	  7417: * perform MAX()
                            	  7418: 
                            	  7419: LAB_MAX
01:00084722 6100E51A        	  7420: 	BSR		LAB_EVEZ			* evaluate expression (no decrement)
01:00084726 4A2B1EFD        	  7421: 	TST.b		Dtypef(a3)			* test data type
01:0008472A 6B00D9F8        	  7422: 	BMI		LAB_TMER			* if string do Type missmatch Error/warm start
                            	  7423: 
                            	  7424: LAB_MAXN
01:0008472E 612C            	  7425: 	BSR.s		LAB_PHFA			* push FAC1, evaluate expression,
                            	  7426: 							* pull FAC2 & compare with FAC1
01:00084730 64FC            	  7427: 	BCC.s		LAB_MAXN			* branch if no swap to do
                            	  7428: 
01:00084732 6100F48E        	  7429: 	BSR		LAB_279B			* copy FAC2 to FAC1
01:00084736 60F6            	  7430: 	BRA.s		LAB_MAXN			* go do next
