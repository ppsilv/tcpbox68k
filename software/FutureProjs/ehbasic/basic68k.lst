01:000847B6 6100E5E6        	  7514: 	BSR		LAB_GBYT			* get BASIC byte back
01:000847BA 672C            	  7515: 	BEQ.s		WExit				* exit if no following
                            	  7516: 
01:000847BC B03C002C        	  7517: 	CMP.b		#',',d0			* else is it ","
01:000847C0 6600D98E        	  7518: 	BNE		LAB_SNER			* if not do syntax error
                            	  7519: 
                            	  7520: LAB_TBSZ
01:000847C4 6100EF3E        	  7521: 	BSR		LAB_SGBY			* increment and get byte, result in d0 and Itemp
01:000847C8 4A00            	  7522: 	TST.b		d0				* test TAB size
