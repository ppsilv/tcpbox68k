01:00082C8C 102B1F2B        	  2676: 	MOVE.b	comp_f(a3),d0		* copy old compare function flag
01:00082C90 B32B1F2B        	  2677: 	EOR.b		d1,comp_f(a3)		* EOR in this compare function bit
01:00082C94 B02B1F2B        	  2678: 	CMP.b		comp_f(a3),d0		* compare old with new compare function flag
