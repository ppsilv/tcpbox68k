01:00083B9C 2F08            	  5639: 	MOVE.l	a0,-(sp)			* save pointer
                            	  5640: LAB_277C
01:00083B9E 6100FD60        	  5641: 	BSR		LAB_24D5			* normalise FAC1
01:00083BA2 612C            	  5642: 	BSR.s		LAB_27BA			* round FAC1
01:00083BA4 202B1ED8        	  5643: 	MOVE.l	FAC1_m(a3),d0		* get FAC1 mantissa
01:00083BA8 E098            	  5644: 	ROR.l		#8,d0				* align 24/32 bit mantissa
01:00083BAA 4840            	  5645: 	SWAP		d0				* exponent/sign into 0-15
01:00083BAC C07C007F        	  5646: 	AND.w		#$7F,d0			* clear exponent and sign bit
01:00083BB0 022B00801EDD    	  5647: 	ANDI.b	#$80,FAC1_s(a3)		* clear non sign bits in sign
01:00083BB6 806B1EDC        	  5648: 	OR.w		FAC1_e(a3),d0		* OR in exponent and sign
01:00083BBA 4840            	  5649: 	SWAP		d0				* move exponent and sign back to 16-31
01:00083BBC 2080            	  5650: 	MOVE.l	d0,(a0)			* store in destination
01:00083BBE 205F            	  5651: 	MOVE.l	(sp)+,a0			* restore pointer
01:00083BC0 4E75            	  5652: 	RTS
