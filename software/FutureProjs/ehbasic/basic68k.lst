01:00083C62 72A0            	  5805: 	MOVEQ		#$A0,d1			* set for no floating bits
01:00083C64 922B1EDC        	  5806: 	SUB.b		FAC1_e(a3),d1		* subtract FAC1 exponent
01:00083C68 6500E4D6        	  5807: 	BCS		LAB_OFER			* do overflow if too big
                            	  5808: 
01:00083C6C 660E            	  5809: 	BNE.s		LAB_284G			* branch if exponent was not $A0
                            	  5810: 
01:00083C6E 4A2B1EDD        	  5811: 	TST.b		FAC1_s(a3)			* test FAC1 sign
01:00083C72 6A1A            	  5812: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5813: 
01:00083C74 4480            	  5814: 	NEG.l		d0
01:00083C76 6916            	  5815: 	BVS.s		LAB_284H			* branch if was $80000000
                            	  5816: 
01:00083C78 6000E4C6        	  5817: 	BRA		LAB_OFER			* do overflow if too big
                            	  5818: 
                            	  5819: LAB_284G
01:00083C7C B23C0020        	  5820: 	CMP.b		#$20,d1			* compare with minimum result for integer
01:00083C80 6502            	  5821: 	BCS.s		LAB_284L			* if < minimum just do shift
                            	  5822: 
01:00083C82 7000            	  5823: 	MOVEQ		#0,d0				* else return zero
                            	  5824: LAB_284L
01:00083C84 E2A8            	  5825: 	LSR.l		d1,d0				* shift integer
                            	  5826: 
01:00083C86 4A2B1EDD        	  5827: 	TST.b		FAC1_s(a3)			* test FAC1 sign (b7)
01:00083C8A 6A02            	  5828: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5829: 
01:00083C8C 4480            	  5830: 	NEG.l		d0				* negate integer value
                            	  5831: LAB_284H
01:00083C8E 221F            	  5832: 	MOVE.l	(sp)+,d1			* restore d1
                            	  5833: LAB_284J
01:00083C90 2740142A        	  5834: 	MOVE.l	d0,Itemp(a3)		* save result to Itemp
01:00083C94 4E75            	  5835: 	RTS
