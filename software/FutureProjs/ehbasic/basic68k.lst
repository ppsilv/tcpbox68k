01:0008492A 6100E470        	  7754: 	BSR		LAB_IGBY			* get next character
01:0008492E 6528            	  7755: 	BCS.s		LAB_2X04			* branch if digit
                            	  7756: 
01:00084930 B03C002D        	  7757: 	CMP.b		#'-',d0			* or is it -ve number
01:00084934 6706            	  7758: 	BEQ.s		LAB_2X01			* branch if so
                            	  7759: 
01:00084936 B03C00B3        	  7760: 	CMP.b		#TK_MINUS,d0		* or is it -ve number
01:0008493A 6608            	  7761: 	BNE.s		LAB_2X02			* branch if not
                            	  7762: 
