00:0008145E 00000000        	   102: Dlinel	ds.l	1			* current DATA line
00:00081462 00000000        	   103: Dptrl		ds.l	1			* DATA pointer
00:00081466 00000000        	   104: Rdptrl	ds.l	1			* read pointer
00:0008146A 00000000        	   105: Varname	ds.l	1			* current var name
00:0008146E 00000000        	   106: Cvaral	ds.l	1			* current var address
