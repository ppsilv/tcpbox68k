                            	  2636: LAB_EVEZ
01:00082C3E 7200            	  2637: 	MOVEQ		#0,d1				* clear precedence word
01:00082C40 17411EFD        	  2638: 	MOVE.b	d1,Dtypef(a3)		* clear the data type, $80=string, $40=integer,
                            	  2639: 							* $00=float
01:00082C44 601C            	  2640: 	BRA.s		LAB_1ACD			* enter loop
                            	  2641: 
                            	  2642: * get vector, set up operator then continue evaluation
                            	  2643: 
