01:00084124 6138            	  6484: 	BSR.s		LAB_SIN			* go do SIN/COS cordic compute
01:00084126 376B1EDC1EE4    	  6485: 	MOVE.w	FAC1_e(a3),FAC2_e(a3)	* copy exponent & sign from FAC1 to FAC2
01:0008412C 276B1ED81EE0    	  6486: 	MOVE.l	FAC1_m(a3),FAC2_m(a3)	* copy FAC1 mantissa to FAC2 mantissa
01:00084132 27411ED8        	  6487: 	MOVE.l	d1,FAC1_m(a3)		* get COS(x) mantissa
01:00084136 17431EDC        	  6488: 	MOVE.b	d3,FAC1_e(a3)		* get COS(x) exponent
01:0008413A 6700E004        	  6489: 	BEQ		LAB_OFER			* do overflow if COS = 0
                            	  6490: 
01:0008413E 6100F7C0        	  6491: 	BSR		LAB_24D5			* normalise FAC1
01:00084142 6000F970        	  6492: 	BRA		LAB_DIVIDE			* do FAC2/FAC1 and return, FAC_sc set by SIN
                            	  6493: 							* COS calculation
                            	  6494: 
                            	  6495: 
                            	  6496: *************************************************************************************
                            	  6497: *
                            	  6498: * cordic SIN(x), COS(x) routine
                            	  6499: * x = angle in radians
                            	  6500: 
                            	  6501: LAB_COS
01:00084146 277CC90FDAA31EE0	  6502: 	MOVE.l	#$C90FDAA3,FAC2_m(a3)	* pi/2 mantissa (LSB is rounded up so
                            	  6503: 							* COS(PI/2)=0)
01:0008414E 377C81001EE4    	  6504: 	MOVE.w	#$8100,FAC2_e(a3)		* pi/2 exponent and sign
01:00084154 176B1EDD1EE6    	  6505: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* sign = FAC1 sign (b7)
01:0008415A 6100F722        	  6506: 	BSR		LAB_ADD			* add FAC2 to FAC1, adjust for COS(x)
                            	  6507: 
