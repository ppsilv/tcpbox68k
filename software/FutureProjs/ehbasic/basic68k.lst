                            	  5707: 
                            	  5708: LAB_27CE
01:00083C04 102B1EDD        	  5709: 	MOVE.b	FAC1_s(a3),d0		* else get FAC1 sign (b7)
                            	  5710: 
                            	  5711: 
                            	  5712: *************************************************************************************
                            	  5713: *
