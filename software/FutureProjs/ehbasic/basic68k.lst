                            	  6509: *************************************************************************************
                            	  6510: *
                            	  6511: * SIN/COS cordic calculator
                            	  6512: 
                            	  6513: LAB_SIN
01:0008415E 177C00001EFC    	  6514: 	MOVE.b	#0,cosout(a3)		* set needed result
                            	  6515: 
01:00084164 277CA2F9836F1EE0	  6516: 	MOVE.l	#$A2F9836F,FAC2_m(a3)	* 1/pi mantissa (LSB is rounded up so SIN(PI)=0)
01:0008416C 377C7F001EE4    	  6517: 	MOVE.w	#$7F00,FAC2_e(a3)		* 1/pi exponent & sign
01:00084172 176B1EDD1EE6    	  6518: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* sign = FAC1 sign (b7)
