01:00083C96 70A0            	  5843: 	MOVEQ		#$A0,d0			* set for no floating bits
01:00083C98 902B1EDC        	  5844: 	SUB.b		FAC1_e(a3),d0		* subtract FAC1 exponent
01:00083C9C 6310            	  5845: 	BLS.s		LAB_IRTS			* exit if exponent >= $A0
                            	  5846: 							* (too big for fraction part!)
                            	  5847: 
01:00083C9E B03C0020        	  5848: 	CMP.b		#$20,d0			* compare with minimum result for integer
01:00083CA2 6400026E        	  5849: 	BCC		LAB_POZE			* if >= minimum go return 0
                            	  5850: 							* (too small for integer part!)
                            	  5851: 
01:00083CA6 72FF            	  5852: 	MOVEQ		#-1,d1			* set integer mask
