                            	  7584: 
01:0008482C 761F            	  7585: 	MOVEQ		#$1F,d3			* $1F for DBF, 64 pairs of bits to
                            	  7586: 							* do for a 32 bit result
01:0008482E 082B00001EDC    	  7587: 	BTST		#0,FAC1_e(a3)		* test exponent odd/even
01:00084834 6606            	  7588: 	BNE.s		LAB_SQE2			* if odd only 1 shift first time
                            	  7589: 
                            	  7590: LAB_SQE1
01:00084836 D080            	  7591: 	ADD.l		d0,d0				* shift highest bit of number ..
01:00084838 D582            	  7592: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
01:0008483A D281            	  7593: 	ADD.l		d1,d1				* root = root * 2 .. never overflows
                            	  7594: LAB_SQE2
01:0008483C D080            	  7595: 	ADD.l		d0,d0				* shift highest bit of number ..
01:0008483E D582            	  7596: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
                            	  7597: 
01:00084840 2801            	  7598: 	MOVE.l	d1,d4				* copy root
