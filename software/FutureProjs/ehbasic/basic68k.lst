                            	  2658: LAB_1ADB
01:00082C6E 6100012E        	  2659: 	BSR		LAB_GBYT			* scan memory
                            	  2660: LAB_1ADE
01:00082C72 903C00BC        	  2661: 	SUB.b		#TK_GT,d0			* subtract token for > (lowest compare function)
01:00082C76 652A            	  2662: 	BCS.s		LAB_1AFA			* branch if < TK_GT
                            	  2663: 
01:00082C78 B03C0003        	  2664: 	CMP.b		#$03,d0			* compare with ">" to "<" tokens
01:00082C7C 650A            	  2665: 	BCS.s		LAB_1AE0			* branch if <= TK_SGN (is compare function)
                            	  2666: 
01:00082C7E 4A2B1F2B        	  2667: 	TST.b		comp_f(a3)			* test compare function flag
01:00082C82 6660            	  2668: 	BNE.s		LAB_1B2A			* branch if compare function
                            	  2669: 
01:00082C84 60000086        	  2670: 	BRA		LAB_1B78			* go do functions
                            	  2671: 
