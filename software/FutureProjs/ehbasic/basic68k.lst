01:00083C08 4880            	  5718: 	EXT.w		d0				* make word
01:00083C0A 48C0            	  5719: 	EXT.l		d0				* make longword
01:00083C0C E080            	  5720: 	ASR.l		#8,d0				* move sign bit through byte to carry
01:00083C0E 65EA            	  5721: 	BCS.s		RTS_017			* exit if carry set
                            	  5722: 
01:00083C10 7001            	  5723: 	MOVEQ		#1,d0				* set result for +ve sign
01:00083C12 4E75            	  5724: 	RTS
