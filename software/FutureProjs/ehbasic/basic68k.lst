01:000847D2 6500D970        	  7526: 	BCS		LAB_FCER			* if <=1 do function call error & exit
                            	  7527: 
01:000847D6 122B1F2E        	  7528: 	MOVE.b	TWidth(a3),d1		* set flags for width
01:000847DA 6708            	  7529: 	BEQ.s		LAB_SVTB			* skip check if infinite line
                            	  7530: 
01:000847DC B02B1F2E        	  7531: 	CMP.b		TWidth(a3),d0		* compare TAB with width
01:000847E0 6E00D962        	  7532: 	BGT		LAB_FCER			* branch if too big
