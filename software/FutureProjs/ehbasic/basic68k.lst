01:0008209A 17401F30        	   433: 	MOVE.b	d0,ccflag(a3)		* allow CTRL-C check
01:0008209E 37401F32        	   434: 	MOVE.w	d0,prg_strt-2(a3)		* clear start word
01:000820A2 37401F1E        	   435: 	MOVE.w	d0,BHsend(a3)		* clear value to string end word
                            	   436: 
01:000820A6 177C00501F2E    	   437: 	MOVE.b	#$50,TWidth(a3)		* default terminal width byte for simulator
01:000820AC 177C000E1F2A    	   438: 	MOVE.b	#$0E,TabSiz(a3)		* save default tab size = 14
