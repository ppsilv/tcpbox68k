01:00082F9A B03C005B        	  3334: 	CMP.b		#$5B,d0			* compare with "Z"+1
                            	  3335: 							* carry set if byte<="Z"
01:00082F9E 4E75            	  3336: 	RTS
                            	  3337: 
                            	  3338: LAB_1D83
01:00082FA0 B03C007B        	  3339: 	CMP.b		#$7B,d0			* compare with "z"+1
