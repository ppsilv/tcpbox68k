                            	   519: * value at the top of this file to some non zero value
                            	   520: 
                            	   521:  ifne	novar
                            	   522: 
                            	   523: 	ADD.l		d0,d0				* .......$ .......& ........ .......0
                            	   524: 	SWAP		d0				* ........ .......0 .......$ .......&
                            	   525: 	ROR.b		#1,d0				* ........ .......0 .......$ &.......
                            	   526: 	LSR.w		#1,d0				* ........ .......0 0....... $&.....­.
                            	   527: 	AND.b		#$C0,d0			* mask the type bits
                            	   528: 	MOVE.b	d0,Dtypef(a3)		* save the data type
