                            	  7667: *************************************************************************************
                            	  7668: *
                            	  7669: * get ASCII string equivalent into FAC1 as integer32 or float
                            	  7670: 
                            	  7671: * entry is with a5 pointing to the first character of the string
                            	  7672: * exit with a5 pointing to the first character after the string
                            	  7673: 
                            	  7674: * d0 is character
                            	  7675: * d1 is mantissa
                            	  7676: * d2 is partial and table mantissa
                            	  7677: * d3 is mantissa exponent (decimal & binary)
                            	  7678: * d4 is decimal exponent
                            	  7679: 
                            	  7680: * get FAC1 from string
                            	  7681: * this routine now handles hex and binary values from strings
                            	  7682: * starting with "$" and "%" respectively
                            	  7683: 
                            	  7684: LAB_2887
01:000848B2 48E77C00        	  7685: 	MOVEM.l	d1-d5,-(sp)			* save registers
01:000848B6 7200            	  7686: 	MOVEQ		#$00,d1			* clear temp accumulator
01:000848B8 2601            	  7687: 	MOVE.l	d1,d3				* set mantissa decimal exponent count
01:000848BA 2801            	  7688: 	MOVE.l	d1,d4				* clear decimal exponent
01:000848BC 17411EDD        	  7689: 	MOVE.b	d1,FAC1_s(a3)		* clear sign byte
01:000848C0 17411EFD        	  7690: 	MOVE.b	d1,Dtypef(a3)		* set float data type
01:000848C4 17411EF7        	  7691: 	MOVE.b	d1,expneg(a3)		* clear exponent sign
01:000848C8 6100E4D4        	  7692: 	BSR		LAB_GBYT			* get first byte back
01:000848CC 653C            	  7693: 	BCS.s		LAB_28FE			* go get floating if 1st character numeric
                            	  7694: 
01:000848CE B03C002D        	  7695: 	CMP.b		#'-',d0			* or is it -ve number
01:000848D2 6608            	  7696: 	BNE.s		LAB_289A			* branch if not
                            	  7697: 
01:000848D4 177C00FF1EDD    	  7698: 	MOVE.b	#$FF,FAC1_s(a3)		* set sign byte
01:000848DA 6006            	  7699: 	BRA.s		LAB_289C			* now go scan & check for hex/bin/int
                            	  7700: 
                            	  7701: LAB_289A
                            	  7702: 							* first character wasn't numeric or -
01:000848DC B03C002B        	  7703: 	CMP.b		#'+',d0			* compare with '+'
01:000848E0 6606            	  7704: 	BNE.s		LAB_289D			* branch if not '+' (go check for '.'/hex/binary
                            	  7705: 							* /integer)
                            	  7706: 	
                            	  7707: LAB_289C
                            	  7708: 							* was "+" or "-" to start, so get next character
01:000848E2 6100E4B8        	  7709: 	BSR		LAB_IGBY			* increment & scan memory
01:000848E6 6522            	  7710: 	BCS.s		LAB_28FE			* branch if numeric character
                            	  7711: 
                            	  7712: LAB_289D
01:000848E8 B03C002E        	  7713: 	CMP.b		#'.',d0			* else compare with '.'
01:000848EC 67000092        	  7714: 	BEQ		LAB_2904			* branch if '.'
                            	  7715: 
                            	  7716: 							* code here for hex/binary/integer numbers
01:000848F0 B03C0024        	  7717: 	CMP.b		#'$',d0			* compare with '$'
01:000848F4 6700010A        	  7718: 	BEQ		LAB_CHEX			* branch if '$'
                            	  7719: 
01:000848F8 B03C0025        	  7720: 	CMP.b		#'%',d0			* else compare with '%'
01:000848FC 67000164        	  7721: 	BEQ		LAB_CBIN			* branch if '%'
                            	  7722: 
01:00084900 6000008C        	  7723: 	BRA		LAB_2Y01			* not #.$%& so return 0
                            	  7724: 
                            	  7725: LAB_28FD
01:00084904 6100E496        	  7726: 	BSR		LAB_IGBY			* get next character
01:00084908 646C            	  7727: 	BCC.s		LAB_2902			* exit loop if not a digit
                            	  7728: 
                            	  7729: LAB_28FE
01:0008490A 610001A8        	  7730: 	BSR		d1x10				* multiply d1 by 10 and add character
01:0008490E 64F4            	  7731: 	BCC.s		LAB_28FD			* loop for more if no overflow
                            	  7732: 
                            	  7733: LAB_28FF
                            	  7734: 							* overflowed mantissa, count 10s exponent
01:00084910 5283            	  7735: 	ADDQ.l	#1,d3				* increment mantissa decimal exponent count
01:00084912 6100E488        	  7736: 	BSR		LAB_IGBY			* get next character
01:00084916 65F8            	  7737: 	BCS.s		LAB_28FF			* loop while numeric character
                            	  7738: 
