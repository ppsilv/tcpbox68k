MEMORY {
    ROM (rx) : ORIGIN = 0x00000000, LENGTH = 8k
    RAM (rwx) : ORIGIN = 0x00080000, LENGTH = 128K
}

SECTIONS {
    .text : {
        *(.text .text.*)
    } > ROM

    .data : AT(ADDR(.text) + SIZEOF(.text)) {  /* LMA após o .text */
        *(.data .data.*)
    } > RAM

    .bss : {
        *(.bss .bss.*)
    } > RAM
}
